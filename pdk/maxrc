# Site-wide MAX startup: PDK import, Magic design import, image-to-layout
# Tcl 8.0 has no [file normalize] (that is 8.4+).
if {[info commands _mmi_file_normalize] == ""} {
  proc _mmi_file_normalize {path} {
    if {$path == ""} { return "" }
    if {![regexp {^/} $path]} {
      set path [file join [pwd] $path]
    }
    set parts {}
    foreach p [file split $path] {
      if {$p == "."} continue
      if {$p == ".."} {
        if {[llength $parts] > 1} {
          set parts [lreplace $parts end end]
        }
        continue
      }
      lappend parts $p
    }
    if {[llength $parts] == 0} { return "/" }
    return [eval file join $parts]
  }
}

proc _mmi_pdk_source {name} {
  global env
  set cands {}
  if {[info exists env(MMI_LOCAL)] && $env(MMI_LOCAL) != ""} {
    lappend cands [file join $env(MMI_LOCAL) max pdk $name]
  }
  lappend cands /mmi-pdk-live/$name
  if {[info exists env(MMI_PDK_DIR)] && $env(MMI_PDK_DIR) != ""} {
    lappend cands [file join $env(MMI_PDK_DIR) $name]
  }
  if {[info exists env(MMI_TOOLS)]} {
    lappend cands [_mmi_file_normalize [file join $env(MMI_TOOLS) .. mmi_local max pdk $name]]
  }
  lappend cands /mmi-bundle/$name
  foreach f $cands {
    if {[file readable $f]} {
      uplevel #0 [list source $f]
      return
    }
  }
}
_mmi_pdk_source pdk_common.tcl
_mmi_pdk_source mag_import.tcl
_mmi_pdk_source image_layout.tcl
_mmi_pdk_source drc_errors.tcl

proc _mmi_wrap_win_title {} {
  global max_win
  if {[info commands _mmi_win_title_real] != ""} { return }
  if {[info commands win_title_update] == ""} {
    after 500 _mmi_wrap_win_title
    return
  }
  rename win_title_update _mmi_win_title_real
  proc win_title_update {} {
    global MN_TECH max_win
    _mmi_win_title_real
    if {![info exists MN_TECH] || $MN_TECH == ""} { return }
    if {![info exists max_win] || $max_win == ""} { return }
    set t [wm title $max_win]
    if {[string first " pdk $MN_TECH" $t] >= 0} { return }
    set t "$t  pdk $MN_TECH"
    wm title $max_win $t
    wm iconname $max_win $t
  }
  catch {win_title_update}
}
after 300 _mmi_wrap_win_title

# MAX LVS runs ext2sim, ext2spice, and gemini by name. Magic VLSI installs
# ext2sim and ext2spice with those same names. Keep Micro Magic's copies first.
if {[info exists env(MMI_TOOLS)] && $env(MMI_TOOLS) != ""} {
  set _mmi_bin [file join $env(MMI_TOOLS) bin]
} else {
  set _mmi_bin /mmi-vendor/mmi/bin
}
if {[file executable [file join $_mmi_bin ext2sim]]} {
  if {![info exists env(PATH)] || $env(PATH) == ""} {
    set env(PATH) $_mmi_bin
  } elseif {[string first $_mmi_bin: $env(PATH)] != 0 && $env(PATH) != $_mmi_bin} {
    set env(PATH) $_mmi_bin:$env(PATH)
  }
}
unset _mmi_bin

# SUE writes ~/.mmi-autolayout just before it starts MAX. A later MAX
# with no file on the command line must stay empty, so the request is
# kept only when this process is that launch.
proc _mmi_autolayout_path {} {
  global env
  set home /mmi-home
  if {[info exists env(HOME)] && $env(HOME) != ""} {
    set home $env(HOME)
  }
  return [file join $home .mmi-autolayout]
}

proc _mmi_argv_has_layout {} {
  global argv
  if {![info exists argv]} { return 0 }
  set skip 0
  foreach a $argv {
    if {$skip} {
      set skip 0
      continue
    }
    if {$a == "--"} continue
    if {[string match -* $a]} {
      switch -exact -- $a {
        -tech -
        -technology -
        -project -
        -set -
        -command -
        -iconify -
        -batch -
        -display -
        -geometry -
        -name -
        -colormap -
        -visual -
        -use { set skip 1 }
      }
      continue
    }
    if {$a != ""} { return 1 }
  }
  return 0
}

proc _mmi_autolayout_claim {} {
  global _mmi_auto_sim _mmi_auto_dir _mmi_auto_cell _mmi_auto_claimed
  if {[info exists _mmi_auto_claimed]} { return }
  set _mmi_auto_claimed 1
  set _mmi_auto_sim ""
  set _mmi_auto_dir ""
  set _mmi_auto_cell ""
  set f [_mmi_autolayout_path]
  if {![file readable $f]} { return }
  set age 999999
  if {![catch {file mtime $f} mtime]} {
    set age [expr {[clock seconds] - $mtime}]
    if {$age < 0} { set age 0 }
  }
  set sim ""
  set dir ""
  set cell ""
  if {[catch {
    set fh [open $f r]
    gets $fh sim
    gets $fh dir
    gets $fh cell
    close $fh
  }]} {
    return
  }
  # One launch consumes the request. The next MAX does not reopen it.
  catch {file delete $f}
  if {[_mmi_argv_has_layout]} { return }
  if {$age > 120} { return }
  if {$sim == "" || $cell == ""} { return }
  set _mmi_auto_sim $sim
  set _mmi_auto_dir $dir
  set _mmi_auto_cell $cell
}

proc _mmi_autolayout_request {} {
  global _mmi_auto_sim _mmi_auto_dir _mmi_auto_cell
  if {![info exists _mmi_auto_sim] || $_mmi_auto_sim == ""} { return {} }
  return [list $_mmi_auto_sim $_mmi_auto_dir $_mmi_auto_cell]
}

proc _mmi_cell_empty {cell} {
  if {![cell_in_memory $cell]} { return 1 }
  if {[catch {lay_editcell} cur] || $cur != $cell} {
    if {[catch {cell_load $cell}]} { return 1 }
  }
  if {[catch {lay_bbox} box] || [llength $box] < 4} { return 1 }
  set x1 [lindex $box 0]
  set y1 [lindex $box 1]
  set x2 [lindex $box 2]
  set y2 [lindex $box 3]
  if {$x1 == "" || $x2 == ""} { return 1 }
  if {[expr {$x2 - $x1}] == 0 && [expr {$y2 - $y1}] == 0} { return 1 }
  return 0
}

proc _mmi_sim_nfets {sim} {
  if {![file readable $sim]} { return 0 }
  set fh [open $sim r]
  set n 0
  while {[gets $fh line] >= 0} {
    set c [string index [string trimleft $line] 0]
    if {$c == "n" || $c == "N" || $c == "p" || $c == "P"} {
      incr n
    }
  }
  close $fh
  return $n
}

proc _mmi_flyline_count {} {
  if {[info commands db_flyline] == ""} { return 0 }
  if {[catch {set fl [db_flyline]}]} { return 0 }
  set n 0
  foreach line [split [string trim $fl] \n] {
    if {$line != ""} { incr n }
  }
  return $n
}

proc _mmi_reveal_flylines {} {
  catch {:see flyLines}
  if {[info commands view_state_change] != ""} {
    catch {view_state_change flylines 1}
  }
  catch {view_cell}
}

# A new cross-probe request can arrive after this MAX is already up.
# Claimed requests stay in memory; a newer file replaces them.
proc _mmi_autolayout_reread {} {
  global _mmi_auto_sim _mmi_auto_dir _mmi_auto_cell _mmi_autolayout_done
  set f [_mmi_autolayout_path]
  if {![file readable $f]} { return }
  set age 999999
  if {![catch {file mtime $f} mtime]} {
    set age [expr {[clock seconds] - $mtime}]
    if {$age < 0} { set age 0 }
  }
  if {$age > 120} { return }
  set sim ""
  set dir ""
  set cell ""
  if {[catch {
    set fh [open $f r]
    gets $fh sim
    gets $fh dir
    gets $fh cell
    close $fh
  }]} {
    return
  }
  catch {file delete $f}
  if {$sim == "" || $cell == ""} { return }
  set _mmi_auto_sim $sim
  set _mmi_auto_dir $dir
  set _mmi_auto_cell $cell
  catch {unset _mmi_autolayout_done}
}

# This build has no license server. The generator still calls license_check.
proc _mmi_ensure_license_check {} {
  if {[info commands license_check] == ""} {
    proc license_check {args} { return 1 }
  }
}
_mmi_ensure_license_check

proc _mmi_prepare_laygen {} {
  _mmi_ensure_license_check
  if {[info commands _stdcell_calculate_stuff] != ""} {
    if {[catch {_stdcell_calculate_stuff ""} err]} {
      msg "Layout generator setup failed: $err\n"
      return 0
    }
  }
  # Poly preroutes call ":paint poly". sg13g2 names that layer GatPoly.
  # Translate canonical names before painting.
  if {[info commands _mmi_stdcell_add_wire_orig] == "" && \
      [info commands _stdcell_add_wire] != ""} {
    rename _stdcell_add_wire _mmi_stdcell_add_wire_orig
    proc _stdcell_add_wire {x1 y1 x2 y2 {layer ""}} {
      if {$layer != ""} {
        set mapped [techinfo2 layer $layer]
        if {$mapped != ""} { set layer $mapped }
      }
      _mmi_stdcell_add_wire_orig $x1 $y1 $x2 $y2 $layer
    }
  }
  global LAYINFO STDCELL
  if {![info exists STDCELL(stdcell_layers)]} {
    set STDCELL(stdcell_layers) 1
  }
  if {![info exists LAYINFO(option:flylines)]} {
    set LAYINFO(option:flylines) 1
  }
  # Well-tie paint uses the canonical names pwc/nwc/prb, which this tech
  # does not define. Leave those boxes off in the Layers window.
  # Transistors and power rails still get drawn.
  foreach _lay {pwc nwc prb_layer} {
    if {[info exists LAYINFO(layers:$_lay)]} {
      set LAYINFO(layers:$_lay) 0
    }
  }
  if {[info commands techinfo2] != ""} {
    foreach _lay {nplus pplus nwell} {
      set _mapped ""
      catch {set _mapped [techinfo2 layer $_lay]}
      if {$_mapped == ""} {
        set LAYINFO(layers:$_lay) 0
      }
    }
  }
  return 1
}

# Layout Generator window: input .sim, output cell, and the buttons for
# Per-Cell Options, Stdcell Options, and Layers. Done draws the cell.
proc _mmi_laygen_dialog {sim dir cell} {
  global STDCELL
  if {[info commands stdcell_setup] == ""} {
    msg "Layout generator is not loaded.\n"
    return -1
  }
  set STDCELL(input_filename) $sim
  if {$dir != ""} {
    set STDCELL(output_filename) $dir/$cell
  } else {
    set STDCELL(output_filename) $cell
  }
  set STDCELL(debug) 0
  if {![stdcell_setup]} {
    return 0
  }
  regsub {\.max$} $STDCELL(output_filename) "" STDCELL(output_filename)
  if {[catch {
    _stdcell_goto_cell $STDCELL(output_filename)
    update
    cursor_busy 1
    set rc [stdcell_load_direct $STDCELL(input_filename)]
    cursor_busy 0
  } err]} {
    catch {cursor_busy 0}
    msg "Layout generator failed: $err\n"
    return -1
  }
  if {$rc == 0} {
    msg "Layout generator did not draw $cell\n"
    return -1
  }
  return 1
}

proc _mmi_autolayout_run {} {
  global _mmi_autolayout_done STDCELL
  _mmi_autolayout_reread
  if {[info exists _mmi_autolayout_done] && $_mmi_autolayout_done} { return }
  set req [_mmi_autolayout_request]
  if {[llength $req] < 3} { return }
  set sim [lindex $req 0]
  set dir [lindex $req 1]
  set cell [lindex $req 2]
  if {![file readable $sim]} {
    msg "No netlist $sim. Save the schematic and run Max Cross Probe Init again.\n"
    set _mmi_autolayout_done 1
    return
  }
  if {[_mmi_sim_nfets $sim] < 1} {
    msg "No transistors in $sim. Schematic \"$cell\" has nothing to draw.\n"
    if {$cell == "no_name"} {
      msg "no_name is the unsaved sheet. Save it, or bring the schematic that contains the transistors forward, then run Max Cross Probe Init again.\n"
    }
    set _mmi_autolayout_done 1
    return
  }
  set save [pwd]
  if {$dir != "" && [file isdirectory $dir]} { cd $dir }
  set empty 1
  if {[cell_in_memory $cell]} {
    set empty [_mmi_cell_empty $cell]
  } elseif {[file readable [file join $dir $cell.max]]} {
    catch {cell_load $cell $dir}
    set empty [_mmi_cell_empty $cell]
  }
  if {!$empty && [_mmi_flyline_count] > 0} {
    _mmi_bind_cell_beside_sue
    _mmi_reveal_flylines
    cd $save
    _mmi_show_layout_folder $dir
    set _mmi_autolayout_done 1
    return
  }
  if {$empty} {
    msg "Generating layout for $cell from $sim\n"
  } else {
    msg "Cell $cell has no flylines. Layout Generator can rebuild it so unfinished nets show as yellow lines. Cancel keeps the current layout.\n"
  }
  if {![_mmi_prepare_laygen]} {
    cd $save
    return
  }
  set drew [_mmi_laygen_dialog $sim $dir $cell]
  if {$drew == 0} {
    msg "Layout generator cancelled\n"
    cd $save
    set _mmi_autolayout_done 1
    return
  }
  if {$drew != 1} {
    cd $save
    set _mmi_autolayout_done 1
    return
  }
  set edit $cell
  catch {set edit [lay_editcell]}
  set outdir $dir
  if {[info exists STDCELL(output_filename)] && $STDCELL(output_filename) != ""} {
    set got [file dirname $STDCELL(output_filename)]
    if {$got != "" && $got != "." && [file isdirectory $got]} {
      set outdir $got
    }
  }
  _mmi_bind_cell_beside_sue
  if {[_mmi_save_open_layout $outdir $edit]} {
    _mmi_show_layout_folder $outdir
  } else {
    _mmi_reveal_flylines
  }
  msg "Flylines in [lay_editcell]: [_mmi_flyline_count]\n"
  set _mmi_autolayout_done 1
  cd $save
}

# Write the generated cell to the schematic directory and load that file
# back, the same sequence the Magic converter uses in mag_save_open.
proc _mmi_save_open_layout {dir cell} {
  if {$dir == "" || $cell == ""} { return 0 }
  if {![file isdirectory $dir]} { return 0 }
  if {[info commands cell_in_memory] == "" || ![cell_in_memory $cell]} {
    msg "No layout in memory to save for $cell\n"
    return 0
  }
  catch {cell_path_add $dir}
  catch {cd $dir}
  set dest $dir/$cell.max
  catch {db_cell_rename $cell $cell $dest}
  catch {cell_load $cell}
  # cell_save asks whether to keep flylines, and the default button drops
  # them. Answer yes so the yellow lines stay in the file and on screen.
  set rc 0
  if {[catch {set rc [_mmi_cell_save_keep_flylines]} err] || $rc == 0} {
    msg "Could not save $dest\n"
    return 0
  }
  if {![file exists $dest]} {
    msg "Save did not write $dest\n"
    return 0
  }
  catch {:flush $cell}
  if {[catch {cell_load $cell $dir} err]} {
    msg "Saved $dest but could not open it: $err\n"
    return 0
  }
  _mmi_reveal_flylines
  msg "Saved and opened $dest\n"
  return 1
}

# Yes on "save the flylines?" is button 0. That keeps the lines.
proc _mmi_cell_save_keep_flylines {} {
  set wrapped 0
  if {[info commands tk_dialog] != "" && \
      [info commands _mmi_tk_dialog_real] == ""} {
    rename tk_dialog _mmi_tk_dialog_real
    proc tk_dialog {w title text bitmap default args} {
      if {[string match *flyline* $text]} {
        return 0
      }
      return [eval _mmi_tk_dialog_real \
          [list $w $title $text $bitmap $default] $args]
    }
    set wrapped 1
  }
  set rc 0
  set failed [catch {set rc [cell_save]} err]
  if {$wrapped} {
    rename tk_dialog ""
    rename _mmi_tk_dialog_real tk_dialog
  }
  if {$failed} {
    return -code error $err
  }
  return $rc
}

proc _mmi_show_layout_folder {dir} {
  if {$dir == "" || ![file isdirectory $dir]} { return }
  if {[info commands _mmi_file_normalize] != ""} {
    set dir [_mmi_file_normalize $dir]
  }
  if {[info commands auto_execok] == ""} { return }
  if {[auto_execok pcmanfm] != ""} {
    if {![catch {exec pcmanfm -n $dir &}]} {
      msg "File manager: $dir\n"
      return
    }
  }
  if {[info commands mag_open_storage_folder] != ""} {
    mag_open_storage_folder $dir
    msg "File manager: $dir\n"
    return
  }
  foreach bin {thunar nautilus nemo caja explorer.exe} {
    if {[auto_execok $bin] == ""} continue
    if {![catch {exec $bin $dir &}]} {
      msg "File manager: $dir\n"
      return
    }
  }
  msg "No file manager on PATH. Layout folder: $dir\n"
}

# .ext, .sim, and .max for a schematic stay in the directory of its .sue file.
proc _mmi_bind_cell_beside_sue {} {
  global CELL LVS_SEARCH_DIRS
  set req [_mmi_autolayout_request]
  if {[llength $req] < 3} { return }
  set dir [lindex $req 1]
  set cell [lindex $req 2]
  if {$dir == "" || ![file isdirectory $dir]} { return }
  if {![cell_in_memory $cell]} { return }
  set suffix .max
  if {[info exists CELL(default_suffix)] && $CELL(default_suffix) != ""} {
    set suffix $CELL(default_suffix)
  }
  set want $dir/$cell$suffix
  set path ""
  catch {set path [lindex [cell_info $cell] 1]}
  set have ""
  if {$path != ""} { set have [file dirname $path] }
  if {$have != $dir} {
    if {[catch {db_cell_rename $cell $cell $want} err]} {
      msg "Could not put $cell next to its schematic ($want): $err\n"
    } else {
      msg "Cell file is $want\n"
    }
  }
  set LVS_SEARCH_DIRS $dir
  cd $dir
}

proc _mmi_autolayout_later {} {
  global _mmi_autolayout_done _mmi_autolayout_tries
  _mmi_autolayout_run
  if {[info exists _mmi_autolayout_done] && $_mmi_autolayout_done} { return }
  if {![info exists _mmi_autolayout_tries]} { set _mmi_autolayout_tries 0 }
  incr _mmi_autolayout_tries
  if {$_mmi_autolayout_tries < 30} {
    after 1000 _mmi_autolayout_later
    return
  }
  set req [_mmi_autolayout_request]
  if {[llength $req] < 3} { return }
  set sim [lindex $req 0]
  set cell [lindex $req 2]
  if {[_mmi_sim_nfets $sim] < 1} {
    msg "No transistors in $sim. Schematic \"$cell\" has nothing to draw.\n"
    if {$cell == "no_name"} {
      msg "no_name is the unsaved sheet. Save it, or bring the schematic that contains the transistors forward, then run Max Cross Probe Init again.\n"
    }
  }
}


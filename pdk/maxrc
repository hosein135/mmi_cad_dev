  if {[info commands _mmi_lvs_it_max_real] != ""} { return }
  if {[info commands lvs_it_max] == ""} { return }
  rename lvs_it_max _mmi_lvs_it_max_real
  proc lvs_it_max {} {
    _mmi_autolayout_run
    _mmi_bind_cell_beside_sue
    _mmi_lvs_it_max_real
  }
}

proc _mmi_autoload_lvs_it {} {
  global auto_index _mmi_lvs_autoload
  if {[info exists auto_index(lvs_it_max)]} {
    unset auto_index(lvs_it_max)
  }
  eval $_mmi_lvs_autoload
  _mmi_wrap_lvs_it
}

proc _mmi_hook_lvs_it {} {
  global auto_index _mmi_lvs_autoload _mmi_lvs_hook_tries
  if {[info commands _mmi_lvs_it_max_real] != ""} { return }
  if {[info commands lvs_it_max] == "" && [info exists auto_index(lvs_it_max)]} {
    set _mmi_lvs_autoload $auto_index(lvs_it_max)
    set auto_index(lvs_it_max) _mmi_autoload_lvs_it
    return
  }
  if {[info commands lvs_it_max] != ""} {
    _mmi_wrap_lvs_it
    return
  }
  if {![info exists _mmi_lvs_hook_tries]} { set _mmi_lvs_hook_tries 0 }
  incr _mmi_lvs_hook_tries
  if {$_mmi_lvs_hook_tries < 40} {
    after 500 _mmi_hook_lvs_it
  }
}

proc _mmi_hook_cross_probe_ext {} {
  global auto_index _mmi_cross_probe_autoload
  if {[info commands _mmi_cross_probe_real] != ""} { return }
  if {[info commands _create_cross_probe_correspondence] == "" && \
      [info exists auto_index(_create_cross_probe_correspondence)]} {
    set _mmi_cross_probe_autoload $auto_index(_create_cross_probe_correspondence)
    set auto_index(_create_cross_probe_correspondence) _mmi_autoload_cross_probe_ext
    return
  }
  if {[info commands _create_cross_probe_correspondence] == ""} { return }
  rename _create_cross_probe_correspondence _mmi_cross_probe_real
  proc _create_cross_probe_correspondence {file} {
    _mmi_bind_cell_beside_sue
    _mmi_cross_probe_real $file
  }
}

proc _mmi_autoload_cross_probe_ext {} {
  global auto_index _mmi_cross_probe_autoload
  if {[info exists auto_index(_create_cross_probe_correspondence)]} {
    unset auto_index(_create_cross_probe_correspondence)
  }
  eval $_mmi_cross_probe_autoload
  if {[info commands _create_cross_probe_correspondence] == ""} { return }
  rename _create_cross_probe_correspondence _mmi_cross_probe_real
  proc _create_cross_probe_correspondence {file} {
    _mmi_bind_cell_beside_sue
    _mmi_cross_probe_real $file
  }
}

# The generator's vdd/gnd labels are a zero-size box. LVS only sees a
# label that db_label put on the power metal, which is how the port
# labels (a, b, y) already get there. Without these two names, Gemini
# matches the rails and then MAX reports that match as a discrepancy.
proc _mmi_has_global {name} {
  if {[catch {
    eval lay_box [lay_bbox]
    sel_labels
  }]} {
    return 0
  }
  set found 0
  foreach label [split [sel_what labels] \n] {
    if {$label == ""} continue
    if {[lindex $label 6] == $name && [lindex $label 9] == "global"} {
      set found 1
    }
  }
  catch {sel_clear}
  return $found
}

proc _mmi_stdcell_power_labels {} {
  global STDCELL LAYINFO
  if {![info exists STDCELL(vdd)] || $STDCELL(vdd) == ""} return
  if {![info exists STDCELL(gnd)] || $STDCELL(gnd) == ""} return
  if {![info exists STDCELL(cell_width)] || $STDCELL(cell_width) == ""} return
  if {$STDCELL(cell_width) <= 0} return
  if {![info exists LAYINFO(stdcell:cell_height)]} return
  if {[info exists LAYINFO(layers:power_strap)] && \
      $LAYINFO(layers:power_strap) == 0} return
  if {[info commands techinfo2] == ""} return
  set m1 [techinfo2 layer m1]
  if {$m1 == ""} return
  set x [expr {$STDCELL(cell_width) / 4.0}]
  set h $LAYINFO(stdcell:cell_height)
  if {![_mmi_has_global $STDCELL(gnd)]} {
    db_label -kind global -pos center $m1 $STDCELL(gnd) $x 0
  }
  if {![_mmi_has_global $STDCELL(vdd)]} {
    db_label -kind global -pos center $m1 $STDCELL(vdd) $x $h
  }
}

proc _mmi_wrap_stdcell_labels {} {
  if {[info commands _mmi_stdcell_load_direct] != ""} return
  if {[info commands stdcell_load_direct] == ""} return
  rename stdcell_load_direct _mmi_stdcell_load_direct
  proc stdcell_load_direct {filename} {
    _mmi_ensure_license_check
    catch {_mmi_prepare_laygen}
    set ret [_mmi_stdcell_load_direct $filename]
    catch {_mmi_stdcell_power_labels}
    return $ret
  }
}


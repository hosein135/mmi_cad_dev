# Nix-pinned Magic startup for sky130A (open_pdks layout).
# Loaded by mag2gds.sh; does not download anything.
puts stdout "Sourcing Nix sky130A.magicrc"

if {[catch {set PDK_ROOT [file nativename $env(PDK_ROOT)]}]} {
  set PDK_ROOT /mmi-pdks
}
set PDKPATH $PDK_ROOT/sky130A
set MAGDIR $PDKPATH/libs.tech/magic

if {[file exists $MAGDIR/sky130A.tech]} {
  tech load $MAGDIR/sky130A
} elseif {[file exists $MAGDIR/sky130.tech]} {
  tech load $MAGDIR/sky130
}

if {[file exists $MAGDIR/sky130A.tcl]} {
  source $MAGDIR/sky130A.tcl
} elseif {[file exists $MAGDIR/sky130.tcl]} {
  source $MAGDIR/sky130.tcl
}

if {[catch {set MAGTYPE $env(MAGTYPE)}]} {
  set MAGTYPE mag
}

foreach d [glob -nocomplain $PDKPATH/libs.ref/*/$MAGTYPE] {
  addpath $d
}

snap lambda
catch {drc euclidean on}
catch {ext2spice scale off}

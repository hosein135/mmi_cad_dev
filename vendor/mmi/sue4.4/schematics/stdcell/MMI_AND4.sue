# Created using mapper from:
#"MMI_AND4 {B {MMI_AND4B {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_AND4B_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} {C {MMI_AND4C {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_AND4C_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} "

proc NAME_MMI_AND4 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set nom MMI_AND4[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_AND4 args {
  icon_generator $args {{Size "B" {radio B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {dpc {}}}


  # MMI_AND4 icon body
  if {$DeMorgan} {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_arc 40 -10 60 10 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc -60 0 -40 20 -start 0 -extent 359
    icon_arc -60 -20 -40 0 -start 0 -extent 359
    icon_arc -60 -40 -40 -20 -start 0 -extent 359
  } else {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line -40 -30 -60 -30
    icon_line -40 -10 -60 -10
    icon_line -40 10 -60 10
    icon_line -40 30 -60 30
    icon_line 40 0 60 0
  }

  # properties
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-37 -22} -size small -label F

  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 -10} -name in1
  icon_term -type input -origin {-60 10} -name in2
  icon_term -type input -origin {-60 30} -name in3

  # outputs
  icon_term -type output -origin {60 0} -name out


  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  switch _$size {
    _B { set fname MMI_AND4B }
    _C { set fname MMI_AND4C }
  }
  set nname [NAME_MMI_AND4 -Size $Size -DeMorgan $DeMorgan]
  switch $size {
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .in3(\$in3), .out(\$out)"
    }
    C {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .in3(\$in3), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
}

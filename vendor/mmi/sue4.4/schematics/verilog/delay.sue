proc ICON_delay args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {delay 0}}
  icon_term -type output -origin {40 0} -name out
  icon_term -type input -origin {-30 0} -name in
  icon_property -origin {-50 40} -type user -name name
  icon_property -origin {-50 57} -type user -name delay -default 0
  icon_property -origin {0 0} -label {$delay} -anchor center
  icon_arc 20 -10 40 10 -start 263 -extent 205
  icon_arc -30 -10 -10 10 -start 81 -extent 200
  icon_line -20 -10 30 -10 30 10 -20 10
  icon_property -origin {-70 90} -type fixed -name verilog \
	-text {not \#$delay [unique_name "" $name inv]\($out, $in\)\;}
}


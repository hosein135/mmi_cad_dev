# Bus combine generator

proc ICON_bus_combine args {
  icon_generator $args {{ninputs 2}}

  icon_setup $args {{origin {0 0}} {orient R0} {ninputs 2} {name ""}}

  set inputs ""

  # Determine whether there is an even or odd number of inputs
  # Position of terminals is slightly different for the two cases
  if {$ninputs == 2*(floor($ninputs/2))} {
    # even
    for {set i 0} {$i < $ninputs} {incr i 1} {
      icon_term -type input \
	  -origin "-10 [expr (20 * ($i - $ninputs/2)) + 10]" -name "in$i"
      set inputs [concat $inputs \$in$i]
    }
    set line_coords "-10 [expr -10 * $ninputs + 10] -10 [expr 10 * $ninputs - 10]"
    icon_property -origin "0 [expr (20 * ($i - $ninputs/2)) + 5]" -label 0
  } else {
    # odd
    for {set i 0} {$i < $ninputs} {incr i 1} {
      icon_term -type input \
	  -origin "-10 [expr 20 * ($i - ($ninputs-1)/2)]" -name "in$i"
      set inputs [concat $inputs \$in$i]
    }
    set line_coords "-10 [expr -10 * $ninputs + 10] -10 [expr 10 * $ninputs - 10]"
    icon_property -origin "0 [expr 20 * ($ninputs - ($ninputs-1)/2) - 5]" \
	-label 0
  }

  icon_term -type output -origin {20 0} -name out

  icon_property -origin {-160 90} -type fixed -name verilog \
    -text "\\tassign \$out = \\\\\{[join $inputs ", "]\\\\\}\\;"

  icon_property -origin {-160 110} -type fixed -name spice \
      -text "\[spice_assign \$out $inputs\]"

  icon_property -origin {-160 130} -type fixed -name primitive -text 1

  eval icon_line $line_coords
  icon_line -10 0 20 0 10 0 3 -1 0 -3 2 0 0 3 3 1 10 0
}


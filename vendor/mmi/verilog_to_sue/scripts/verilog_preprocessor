# NOTE this copy of vpp has been modified to substitute
# a ` constructs and add /*SOURCE:filename*/ /*LINE:number*/
# constructs to create a single source file for the verilog
# translators generated by eli.
#
# to us it with eli... vpp souce1.v source2.v | verilog_parser
# the output is piped directly to the eli translator generated.
#
# Usage:
# Parses the following Verilog command line syntax:
#	+define+var
#	+define+var1+var2+...+varN
#	+define+var1=val1+var2=val2+...+varN=valN
#	+incdir+dir
#	+incdir+dir1+dir2+...+dirN
#	-f <command-file>
# Other Verilog options are accepted but ignored.
# If Verilog files are omitted, reads standard input.

# Notes:
# This program requires perl 5 to run.
require 5;

%lineno = ();			# line number for each open file
@incdirs = (".");		# always include current directory
GetArgs(@ARGV);			# process our argiments
$defines{"timescale"} = "timescale";	# predefine `timescale

# sample output redirect
# open(STDOUT, "| less");

if ($#files >= 0) {
    for (@files) {
		$filename = $_;
		open(FILE,$filename) || die ("$_: $!");
		PrintSource($filename, 1);
		ScanText(*FILE,undef,0,$filename);
		close(FILE);
    }
} else {
    ScanText(*STDIN,undef,0,"<stdin>");
}
# close(STDOUT);

sub PrintSource {
	my $filename = shift;
	my $initial = shift;

	$lineno{$filename} = 0 if ($initial);

	print "/* SOURCE: $filename */\n";
	print "/* LINE: $lineno{$filename} */\n";
}

sub ScanText {
    my $file = shift;		# filehandle to read from
    my $scanTo = shift;		# stop when input matches this (never if undefined)
    my $ignore = shift;		# true if we should ignore what we see
	my $filename = shift;	# filename

    while (<$file>) {
		next if /^`timescale/;
		# ExpandConcat();
		$lineno{$filename}++;
		return $_ if (defined $scanTo && /$scanTo/);
		if (/^\s*\`ifdef\s+([a-zA-z_][A-Za-z0-9_]*)/) {
			my $defined = (defined $defines{$1});
			$_ = ScanText($file,"^\\s*`(endif|else)\\b",$ignore || !$defined,
						  $filename); # `
			PrintSource($filename, 0) if (!$ignore && !$defined);
			next unless (/^\s*`else\b/); # `)
			ScanText($file,"^\\s*`endif\\b",$ignore || $defined,
					 $filename); # `)
			PrintSource($filename, 0) if (!$ignore && $defined);
			next;
		}
		next if $ignore;
		if (/^\s*\`define\s+([a-zA-z_][A-Za-z0-9_]*|\\\S*)\s*(.*)/) {
			my $def = $1;
			my $rest = $2;

			$rest =~ s/\s*\/\/.*//;
			$defines{$def} = $rest;
			print "// $_";
			next;
		}
		if (/^\s*\`undef\s+([a-zA-z_][A-Za-z0-9_]*|\\\S*)/) {
			delete $defines{$1};
			print "// $_";
			next;
		}
		if (/^\s*\`include\s*"(.*)"/) {
			my $dir;
			my $includefile;

			$includefile = $1;
			local *INCLUDE;
			if ($includefile =~ /^\//) {
				-e $includefile || 
					die "$0: $includefile: could not find included file.\n";
				open(INCLUDE,"$includefile") || die "$0: $includefile: $!\n";
			} else {
				($dir) = grep {-e "$_/$includefile"} @incdirs;
				defined $dir ||
					die "$0: $includefile: could not find included file.\n";
				open(INCLUDE,"$dir/$includefile") || die "$0: $includefile: $!\n";
			}
			PrintSource($includefile, 1);
			ScanText(*INCLUDE,undef,0, $includefile);
			close(INCLUDE);
			PrintSource($filename, 0);
			next;
		}
		while (/\`(\w+)/) {
			my $def = $1;
			s/\`$def\b/$defines{$def}/g;
		}
		print;
    }
}

# GetArgs -- read command line arguments.
# files go into @files, include dirs into @incdirs,
# and defines into %defines.
# No check on recursive -f, so watch out!
sub GetArgs {
    while ($_ = shift) {
	if (/^\+define\+(.*)/) {
	    for (split(/\+/,$1)) {
		/([^=]*)(=(.*))?/;
		$defines{$1} = defined $3 ? $3 : "";
	    }
	} elsif (/^\+incdir\+(.*)/) {
	    push(@incdirs,split(/\+/,$1));
	} elsif (/^[^+-]/) {
	    push(@files,$_);
	} elsif (/^-f$/) {	# get options from file
	    local *ARGS;
	    open(ARGS,$_=shift) || die "$0: $_: $!\n";
	    @args = <ARGS>;
	    GetArgs(split(/\s+/,"@args"));
	    close(ARGS);
	} elsif (/^-[iklrvy]$/) { # Verilog options with args
	    shift;		# ignore the argument
	}
    }
}

# this doesn't work for 3{{x}}
sub ExpandConcat {
	while (/^(.*)(\d+)({[^}]+})(.*)$/) {
		local ($a, $b, $c) = ($1, "$3," x $2, $4);
		chop $b;
		$_ = "$a$b$c\n";
	}
}

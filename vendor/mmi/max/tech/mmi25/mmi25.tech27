	mmi25
end

version
	version "mmi25 21:55:00 Jan 10 2000"
	description "mmi25"
end

planes
	nw
	active
	pplus
	nplus
	ct
	m1
	v12
	m2
	v23
	m3
	v34
	m4
	v45
	m5
	prb
end

types
	nw	nw
	active	ndif
	active	pdif
	active	nwc
	active	pwc
	active	poly
	pplus	pplus
	nplus	nplus
	ct	ct
	m1	m1

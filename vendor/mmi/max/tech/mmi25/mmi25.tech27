drc
cifstyle mmi25

	cifwidth GDS_nw 1.2 		"nw minimum width = 1.2 um."

	cifspacing GDS_nw GDS_nw 0.6 touching_ok 		"nw minimum spacing = 0.6 um."

	width ndif,nfet 0.3 		"ndif minimum width = 0.3 um."

	spacing ndif,nfet ndif,nfet 0.4 touching_ok 		"ndif minimum spacing = 0.4 um."

	width pdif,pfet 0.3 		"pdif minimum width = 0.3 um."

	spacing pdif,pfet pdif,pfet 0.4 touching_ok 		"pdif minimum spacing = 0.4 um."

	width nwc 0.3 		"nwc minimum width = 0.3 um."

	spacing nwc nwc 0.4 touching_ok 		"nwc minimum spacing = 0.4 um."

	width pwc 0.3 		"pwc minimum width = 0.3 um."

	spacing pwc pwc 0.4 touching_ok 		"pwc minimum spacing = 0.4 um."

	width poly,nfet,pfet 0.24 		"poly minimum width = 0.24 um."

	spacing poly,nfet,pfet poly,nfet,pfet 0.36 touching_ok 		"poly minimum spacing = 0.36 um."

	cifwidth GDS_pplus 0.44 		"pplus minimum width = 0.44 um."

	cifspacing GDS_pplus GDS_pplus 0.44 touching_ok 		"pplus minimum spacing = 0.44 um."

	cifwidth GDS_nplus 0.44 		"nplus minimum width = 0.44 um."

	cifspacing GDS_nplus GDS_nplus 0.44 touching_ok 		"nplus minimum spacing = 0.44 um."

	width ct 0.3 		"ct minimum width = 0.3 um."

	spacing ct ct 0.3 touching_ok 		"ct minimum spacing = 0.3 um."

	width m1 0.32 		"m1 minimum width = 0.32 um."

	spacing m1 m1 0.32 touching_ok 		"m1 minimum spacing = 0.32 um."

	width v12 0.36 		"v12 minimum width = 0.36 um."

	spacing v12 v12 0.35 touching_ok 		"v12 minimum spacing = 0.35 um."

	width m2 0.4 		"m2 minimum width = 0.4 um."

	spacing m2 m2 0.4 touching_ok 		"m2 minimum spacing = 0.4 um."

	width v23 0.36 		"v23 minimum width = 0.36 um."

	spacing v23 v23 0.35 touching_ok 		"v23 minimum spacing = 0.35 um."

	width m3 0.4 		"m3 minimum width = 0.4 um."

	spacing m3 m3 0.4 touching_ok 		"m3 minimum spacing = 0.4 um."

	width v34 0.36 		"v34 minimum width = 0.36 um."

	spacing v34 v34 0.35 touching_ok 		"v34 minimum spacing = 0.35 um."

	width m4 0.4 		"m4 minimum width = 0.4 um."

	spacing m4 m4 0.4 touching_ok 		"m4 minimum spacing = 0.4 um."

	width v45 0.36 		"v45 minimum width = 0.36 um."

	spacing v45 v45 0.35 touching_ok 		"v45 minimum spacing = 0.35 um."

	width m5 0.44 		"m5 minimum width = 0.44 um."

	spacing m5 m5 0.46 touching_ok 		"m5 minimum spacing = 0.46 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_nwc space       0.16 GDS_nw space 0.16      "nw minimum enclosure of nwc = 0.16 um." GDS_nw

    
    cifedge GDS_nw space       1 space 0 1       "nw minimum enclosure of nwc = 0.16 um." DRC_nwc


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pdif space       0.6 GDS_nw space 0.6      "nw minimum enclosure of pdif = 0.6 um." GDS_nw

    
    cifedge GDS_nw space       1 space 0 1       "nw minimum enclosure of pdif = 0.6 um." DRC_pdif


	cifspacing GDS_nw DRC_ndif 0.6 touching_illegal 		"nw to ndif minimum spacing = 0.6 um."

	cifspacing GDS_nw DRC_pwc 0.16 touching_illegal 		"nw to pwc minimum spacing = 0.16 um."

	spacing nfet nfet 0.5 touching_ok 		"nfet minimum spacing = 0.5 um."

	spacing pfet pfet 0.5 touching_ok 		"pfet minimum spacing = 0.5 um."

	cifspacing poly_not_fet all_diff 0.14 touching_illegal 		"poly_not_fet to all_diff minimum spacing = 0.14 um."

	edge4way nfet/active poly/active 0.36 poly/active 0 0 		"poly minimum extension past nfet = 0.36 um."

	edge4way pfet/active poly/active 0.36 poly/active 0 0 		"poly minimum extension past pfet = 0.36 um."

	edge4way nfet/active ndif/active 0.44 ndif/active 0 0 		"ndif minimum extension past nfet = 0.44 um."

	edge4way pfet/active pdif/active 0.44 pdif/active 0 0 		"pdif minimum extension past pfet = 0.44 um."

	cifspacing GDS_pplus DRC_ndif 0.3 touching_illegal 		"pplus to ndif minimum spacing = 0.3 um."

	cifspacing GDS_pplus DRC_nwc 0.14 touching_illegal 		"pplus to nwc minimum spacing = 0.14 um."

	cifspacing GDS_pplus DRC_nfet 0.33 touching_illegal 		"pplus to nfet minimum spacing = 0.33 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pfet space       0.33 GDS_pplus space 0.33      "pplus minimum enclosure of pfet = 0.33 um." GDS_pplus

    
    cifedge GDS_pplus space       1 space 0 1       "pplus minimum enclosure of pfet = 0.33 um." DRC_pfet


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pdif space       0.26 GDS_pplus space 0.26      "pplus minimum enclosure of pdif = 0.26 um." GDS_pplus

    
    cifedge GDS_pplus space       1 space 0 1       "pplus minimum enclosure of pdif = 0.26 um." DRC_pdif


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pwc space       0.04 GDS_pplus space 0.04      "pplus minimum enclosure of pwc = 0.04 um." GDS_pplus

    
    cifedge GDS_pplus space       1 space 0 1       "pplus minimum enclosure of pwc = 0.04 um." DRC_pwc


	cifspacing GDS_nplus DRC_pdif 0.3 touching_illegal 		"nplus to pdif minimum spacing = 0.3 um."

	cifspacing GDS_nplus DRC_pwc 0.14 touching_illegal 		"nplus to pwc minimum spacing = 0.14 um."

	cifspacing GDS_nplus DRC_pfet 0.33 touching_illegal 		"nplus to pfet minimum spacing = 0.33 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_nfet space       0.33 GDS_nplus space 0.33      "nplus minimum enclosure of nfet = 0.33 um." GDS_nplus

    
    cifedge GDS_nplus space       1 space 0 1       "nplus minimum enclosure of nfet = 0.33 um." DRC_nfet


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_ndif space       0.26 GDS_nplus space 0.26      "nplus minimum enclosure of ndif = 0.26 um." GDS_nplus

    
    cifedge GDS_nplus space       1 space 0 1       "nplus minimum enclosure of ndif = 0.26 um." DRC_ndif


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_nwc space       0.04 GDS_nplus space 0.04      "nplus minimum enclosure of nwc = 0.04 um." GDS_nplus

    
    cifedge GDS_nplus space       1 space 0 1       "nplus minimum enclosure of nwc = 0.04 um." DRC_nwc


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_poly space       0.1 implant space 0.1      "implant minimum enclosure of poly = 0.1 um." implant

    
    cifedge implant space       1 space 0 1       "implant minimum enclosure of poly = 0.1 um." DRC_poly


	cifspacing GDS_nplus GDS_pplus 0.1 touching_illegal 		"nplus to pplus minimum spacing = 0.1 um."

	cifspacing ct_ndif DRC_nfet 0.22 touching_illegal 		"ct_ndif to nfet minimum spacing = 0.22 um."

	cifspacing ct_pdif DRC_pfet 0.22 touching_illegal 		"ct_pdif to pfet minimum spacing = 0.22 um."

	cifspacing ct_poly DRC_pfet 0.28 touching_illegal 		"ct_poly to pfet minimum spacing = 0.28 um."

	cifspacing ct_poly DRC_nfet 0.28 touching_illegal 		"ct_poly to nfet minimum spacing = 0.28 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_ct space       0.14 all_poly_dif space 0.14      "all_poly_dif minimum enclosure of ct = 0.14 um." all_poly_dif

    
    cifedge all_poly_dif space       1 space 0 1       "all_poly_dif minimum enclosure of ct = 0.14 um." DRC_ct


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((ct))/ct ~((ct))/ct       0.09 (m1) ~((ct))/ct 0.09      "m1 minimum enclosure of ct = 0.09 um." m1

    
    edge (m1) ~((m1))/m1       1 ~((ct))/ct 0 1       "m1 minimum enclosure of ct = 0.09 um." ct


	area m1 0.36 0.32 		"m1 minimum area = 0.36 um2."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v12))/v12 ~((v12))/v12       0.09 (m1) ~((v12))/v12 0.09      "m1 minimum enclosure of v12 = 0.09 um." m1

    
    edge (m1) ~((m1))/m1       1 ~((v12))/v12 0 1       "m1 minimum enclosure of v12 = 0.09 um." v12


	spacing v12 nfet,pfet 0.01 touching_illegal 		"v12 to nfet,pfet minimum spacing = 0.01 um."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v12))/v12 ~((v12))/v12       0.09 (m2) ~((v12))/v12 0.09      "m2 minimum enclosure of v12 = 0.09 um." m2

    
    edge (m2) ~((m2))/m2       1 ~((v12))/v12 0 1       "m2 minimum enclosure of v12 = 0.09 um." v12


	area m2 0.36 0.4 		"m2 minimum area = 0.36 um2."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v23))/v23 ~((v23))/v23       0.1 (m2) ~((v23))/v23 0.1      "m2 minimum enclosure of v23 = 0.1 um." m2

    
    edge (m2) ~((m2))/m2       1 ~((v23))/v23 0 1       "m2 minimum enclosure of v23 = 0.1 um." v23


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v23))/v23 ~((v23))/v23       0.09 (m3) ~((v23))/v23 0.09      "m3 minimum enclosure of v23 = 0.09 um." m3

    
    edge (m3) ~((m3))/m3       1 ~((v23))/v23 0 1       "m3 minimum enclosure of v23 = 0.09 um." v23


	area m3 0.36 0.4 		"m3 minimum area = 0.36 um2."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v34))/v34 ~((v34))/v34       0.09 (m3) ~((v34))/v34 0.09      "m3 minimum enclosure of v34 = 0.09 um." m3

    
    edge (m3) ~((m3))/m3       1 ~((v34))/v34 0 1       "m3 minimum enclosure of v34 = 0.09 um." v34


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v34))/v34 ~((v34))/v34       0.09 (m4) ~((v34))/v34 0.09      "m4 minimum enclosure of v34 = 0.09 um." m4

    
    edge (m4) ~((m4))/m4       1 ~((v34))/v34 0 1       "m4 minimum enclosure of v34 = 0.09 um." v34


	area m4 0.36 0.4 		"m4 minimum area = 0.36 um2."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v45))/v45 ~((v45))/v45       0.09 (m4) ~((v45))/v45 0.09      "m4 minimum enclosure of v45 = 0.09 um." m4

    
    edge (m4) ~((m4))/m4       1 ~((v45))/v45 0 1       "m4 minimum enclosure of v45 = 0.09 um." v45


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v45))/v45 ~((v45))/v45       0.09 (m5) ~((v45))/v45 0.09      "m5 minimum enclosure of v45 = 0.09 um." m5

    
    edge (m5) ~((m5))/m5       1 ~((v45))/v45 0 1       "m5 minimum enclosure of v45 = 0.09 um." v45


	no_overlap	nfet,pfet	nfet,pfet

	exact_overlap	ct,v12,v23,v34,v45

end

extract
style	mmi25
	noplaneordering

	cscale	1
	lambda	1
	step	1000
	sidehalo	0

	resist poly 115
	areacap poly 0.0001
	perimc poly space/active 0.1

	resist m1 115
	areacap m1 0.0001
	perimc m1 space/m1 0.1

	resist m2 115
	areacap m2 0.0001
	perimc m2 space/m2 0.1

	resist m3 115
	areacap m3 0.0001
	perimc m3 space/m3 0.1

	resist m4 115
	areacap m4 0.0001
	perimc m4 space/m4 0.1

	resist m5 115
	areacap m5 0.0001
	perimc m5 space/m5 0.1

	fet nfet ndif 2 nfet GND! 0 0
	fet pfet pdif 2 pfet Vdd! 0 0

end


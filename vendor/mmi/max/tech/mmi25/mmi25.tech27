	active	nfet
	active	pfet
end

contact
end

styles
end

compose
	compose	nfet	poly	ndif
	compose	pfet	poly	pdif
end

connect
	nwc	pdif
	pwc	ndif
	nfet	poly
	pfet	poly
	ct	ndif,pdif,nwc,pwc,poly,m1
	v12	m1,m2
	v23	m2,m3
	v34	m3,m4
	v45	m4,m5
end

cifoutput
style mmi25

	units .001 .001 .001 .001
	charset unrestricted

	iname propattr 102
	bbox 62 0

	layer GDS_nw pdif,pfet
		grow 0.44
		or nwc
		grow 0.16
		or nw
		grow 0.3
		shrink 0.3
	polygons nw
	labels nw
	calma 2 0
	port 2 0 comment
	port 2 1 hidden
	port 2 2 local
	port 2 3 global
	port 2 4 input
	port 2 5 output
	port 2 6 inout

	layer GDS_odn ndif,nfet,nwc
	polygons ndif,nfet,nwc
	labels ndif,nfet,nwc
	calma 12 0
	port 12 0 comment
	port 12 1 hidden
	port 12 2 local
	port 12 3 global
	port 12 4 input
	port 12 5 output
	port 12 6 inout

	layer GDS_odp pdif,pfet,pwc
	polygons pdif,pfet,pwc
	labels pdif,pfet,pwc
	calma 11 0
	port 11 0 comment
	port 11 1 hidden
	port 11 2 local
	port 11 3 global
	port 11 4 input
	port 11 5 output
	port 11 6 inout

	layer GDS_poly poly,nfet,pfet
	polygons poly,nfet,pfet
	labels poly,nfet,pfet
	calma 13 0
	port 13 0 comment
	port 13 1 hidden
	port 13 2 local
	port 13 3 global
	port 13 4 input
	port 13 5 output
	port 13 6 inout

	templayer pplus_poly pfet
		grow 0.07
		or pdif,pfet
		grow 0.22
		or pwc
		grow 0.04
		shrink 0.21
		grow 0.43
		shrink 0.22
		and poly,nfet,pfet
		grow 0.63
		shrink 0.3
	templayer nwc_grow nwc
		grow 0.14
	layer GDS_pplus pfet
		grow 0.07
		or pdif,pfet
		grow 0.22
		or pwc
		grow 0.04
		or pplus_poly
		and-not nwc_grow
		or pplus
		shrink 0.21
		grow 0.43
		shrink 0.22
	polygons pplus
	labels pplus
	calma 7 0
	port 7 0 comment
	port 7 1 hidden
	port 7 2 local
	port 7 3 global
	port 7 4 input
	port 7 5 output
	port 7 6 inout

	templayer pplus_grow GDS_pplus
		grow 0.1
	layer GDS_nplus nfet
		grow 0.07
		or ndif,nfet
		grow 0.16
		or poly,nfet,pfet
		grow 0.06
		or nwc
		grow 0.04
		and-not pplus_grow
		or nplus
		shrink 0.21
		grow 0.43
		shrink 0.22
	polygons nplus
	labels nplus
	calma 8 0
	port 8 0 comment
	port 8 1 hidden
	port 8 2 local
	port 8 3 global
	port 8 4 input
	port 8 5 output
	port 8 6 inout

	layer GDS_ct ct
	
	squares 0 0.3 0.3
	polygons ct
	labels ct
	calma 15 0
	port 15 0 comment
	port 15 1 hidden
	port 15 2 local
	port 15 3 global
	port 15 4 input
	port 15 5 output
	port 15 6 inout

	layer GDS_m1 m1
	polygons m1
	calma 16 0

	layer TXT_m1
	labels m1
	calma 40 0
	port 40 0 comment
	port 40 1 hidden
	port 40 2 local
	port 40 3 global
	port 40 4 input
	port 40 5 output
	port 40 6 inout

	layer GDS_v12 v12
	
	squares 0 0.36 0.35
	polygons v12
	labels v12
	calma 17 0
	port 17 0 comment
	port 17 1 hidden
	port 17 2 local
	port 17 3 global
	port 17 4 input
	port 17 5 output
	port 17 6 inout

	layer GDS_m2 m2
	polygons m2
	calma 18 0

	layer TXT_m2
	labels m2
	calma 41 0
	port 41 0 comment
	port 41 1 hidden
	port 41 2 local
	port 41 3 global
	port 41 4 input
	port 41 5 output
	port 41 6 inout

	layer GDS_v23 v23
	
	squares 0 0.36 0.35
	polygons v23
	labels v23
	calma 27 0
	port 27 0 comment
	port 27 1 hidden
	port 27 2 local
	port 27 3 global
	port 27 4 input
	port 27 5 output
	port 27 6 inout

	layer GDS_m3 m3
	polygons m3
	calma 28 0

	layer TXT_m3
	labels m3
	calma 42 0
	port 42 0 comment
	port 42 1 hidden
	port 42 2 local
	port 42 3 global
	port 42 4 input
	port 42 5 output
	port 42 6 inout

	layer GDS_v34 v34
	
	squares 0 0.36 0.35
	polygons v34
	labels v34
	calma 29 0
	port 29 0 comment
	port 29 1 hidden
	port 29 2 local
	port 29 3 global
	port 29 4 input
	port 29 5 output
	port 29 6 inout

	layer GDS_m4 m4
	polygons m4
	calma 31 0

	layer TXT_m4
	labels m4
	calma 43 0
	port 43 0 comment
	port 43 1 hidden
	port 43 2 local
	port 43 3 global
	port 43 4 input
	port 43 5 output
	port 43 6 inout

	layer GDS_v45 v45
	
	squares 0 0.36 0.35
	polygons v45
	labels v45
	calma 32 0
	port 32 0 comment
	port 32 1 hidden
	port 32 2 local
	port 32 3 global
	port 32 4 input
	port 32 5 output
	port 32 6 inout

	layer GDS_m5 m5
	polygons m5
	calma 33 0

	layer TXT_m5
	labels m5
	calma 44 0
	port 44 0 comment
	port 44 1 hidden
	port 44 2 local
	port 44 3 global
	port 44 4 input
	port 44 5 output
	port 44 6 inout

	layer GDS_prb prb
	polygons prb
	labels prb
	calma 65 0
	port 65 0 comment
	port 65 1 hidden
	port 65 2 local
	port 65 3 global
	port 65 4 input
	port 65 5 output
	port 65 6 inout

	templayer DRC_nwc nwc
	templayer ct_pdif ct
		and pdif,pfet,pwc
	templayer DRC_pwc pwc
	templayer tmp1 nfet,pfet
		grow 0.14
	templayer poly_not_fet poly,nfet,pfet
		and-not tmp1
	templayer DRC_poly poly,nfet,pfet
	templayer DRC_nfet nfet
	templayer all_poly_dif ndif,nfet,pdif,pfet,nwc,pwc,poly,nfet,pfet
	templayer DRC_pfet pfet
	templayer DRC_ndif ndif,nfet
	templayer all_diff ndif,nfet,pdif,pfet,nwc,pwc
	templayer ct_poly ct
		and poly,nfet,pfet
	templayer DRC_pdif pdif,pfet
	templayer implant GDS_nplus,GDS_pplus
		grow 0.05
		shrink 0.05
	templayer DRC_ct ct
	templayer ct_ndif ct
		and ndif,nfet,nwc

	layer TXT_text
	labels space
	calma 255 0
	port 255 0 comment
	port 255 1 hidden
	port 255 2 local
	port 255 3 global
	port 255 4 input
	port 255 5 output
	port 255 6 inout
end

cifinput
style	mmi25
	iname propattr 102
	bbox 62 0

	layer nw GDS_nw
	labels GDS_nw

	layer ndif GDS_od
		and-not GDS_pplus
		or GDS_odn
		and-not GDS_nw
	labels GDS_ndif

	layer pdif GDS_od
		and GDS_pplus
		or GDS_odp
		and GDS_nw
	labels GDS_pdif

	layer nwc GDS_od
		and-not GDS_pplus
		or GDS_odn
		and GDS_nw
	labels TXT_nwc

	layer pwc GDS_od
		and GDS_pplus
		or GDS_odp
		and-not GDS_nw
	labels TXT_pwc

	layer poly GDS_poly
	labels GDS_poly

	layer pplus GDS_pplus
	labels GDS_pplus

	layer nplus GDS_nplus

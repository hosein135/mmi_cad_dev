	layer m2 GDS_m2
	labels TXT_m2

	layer v23 GDS_v23
	labels GDS_v23

	layer m3 GDS_m3
	labels TXT_m3

	layer v34 GDS_v34
	labels GDS_v34

	layer m4 GDS_m4
	labels TXT_m4

	layer v45 GDS_v45
	labels GDS_v45

	layer m5 GDS_m5
	labels TXT_m5

	layer prb GDS_prb
	labels GDS_prb

	calma GDS_nw	2 *
	port comment 2 0
	port hidden 2 1

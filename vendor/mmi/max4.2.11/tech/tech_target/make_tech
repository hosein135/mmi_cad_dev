# return the gds layer number and datatype

proc parse_gds {string default {type out}} {

  set return ""
  if {[string first \: $string] != -1} {
    # data types, must separate with ;
    set groups [split $string \;]
  } else {
    # no data types
    set groups [split $string ,]
  }

  foreach group $groups {

    setl {gds dt} [split $group :]

    if {$type == "out"} {
      # can't output to mutiple layers (how to tell)
      # choose first
      set gds [lindex [split $gds ,] 0]
      set dt [lindex [split $dt -,] 0]
    }

    if {$dt == "" || $dt == "*"} {
      # use datatype 0 for output by default
      set dt $default
    } else {
      # replace ranges
      set new ""
      foreach one [split $dt ,] {
	setl {start end} [split $one -]
	if {$end == "" || $end == $start} {
	  # not a range
	  lappend new $start
	} elseif {$end < $start} {
	  puts "ERROR: skipping illegal datatype range \"$one\" in \"$string\"."
	  lappend new $start
	} else {
	  # range
	  for {set i $start} {$i <= $end} {incr i} {
	    lappend new $i
	  }
	}
      }
      set dt [join $new ,]
    }

    if {$type == "out"} {
      return "$gds $dt"
    }

    lappend return "$gds $dt"
  }

  return $return
}


# like call_with_keyword but returns a list of arguments not keyworded AND
# keyworded arguments not in default list.  unlike call_with_keyword,
# doesn't error if arguments aren't in default list.

proc call_keyword {_ARG_LIST _DEFAULT_LIST} {
  
  set _RETURN ""

  upvar default_value default_value
  upvar defaulted defaulted
  foreach _DEFAULT $_DEFAULT_LIST {
    set _ARG_NAME [lindex $_DEFAULT 0] 
    upvar $_ARG_NAME $_ARG_NAME
    if {[llength $_DEFAULT] == 1} {
      set ${_ARG_NAME}_BINARY 1
      set $_ARG_NAME 0
    } else {
      set ${_ARG_NAME}_BINARY 0
      set $_ARG_NAME [lindex $_DEFAULT 1]
    }
    set default_value($_ARG_NAME) [set $_ARG_NAME]
    set defaulted($_ARG_NAME) 1
  }

  for {set _INDEX 0} {$_INDEX < [llength $_ARG_LIST]} {} {
    if {[string index [lindex $_ARG_LIST $_INDEX] 0] == "-"} {
      # is a keyword pair
      set _ARG_NAME [string range [lindex $_ARG_LIST $_INDEX] 1 end]
      set _ARG_VALUE [lindex $_ARG_LIST [expr $_INDEX+1]]
    
      if {[use_first ${_ARG_NAME}_BINARY] == 1} {
	# binary switch
	set $_ARG_NAME 1
	incr _INDEX

      } elseif {[info exists $_ARG_NAME] == 0} {
	lappend _RETURN -$_ARG_NAME $_ARG_VALUE
	incr _INDEX 2

      } else {
	set $_ARG_NAME $_ARG_VALUE
	set defaulted($_ARG_NAME) 0
	incr _INDEX 2
      }

    } else {
      # not a keyword pair
      lappend _RETURN [lindex $_ARG_LIST $_INDEX]

      incr _INDEX
    }
  }
  return $_RETURN
}


proc gds_of {layer {type out}} {

  global LAYERS

  if {$type == "out" && [info exists LAYERS($layer)]} {
    return $layer
  } elseif {[string first GDS_ $layer] == 0} {
    return $layer
  } else {
    return GDS_$layer
  }
}


# removes comments, inluding ones in continuations

proc remove_comments {line} {

  if {[set pos [string first \# $line]] != -1} {
    # remove comment to end of line (but preserve backslash if any)
    if {[string index $line [expr [string length $line] - 1]] == "\\"} {
      if {[string index [string trim $line] 0] == "\#"} {
	# ignore case where entire line is a comment
	set char ""
      } else {
	set char "\\"
      }
    } else {
      set char ""
    }
    set line "[string range $line 0 [expr $pos -1]]$char"
  }

  return $line
}

# returns an rgb color.  If type given, tries to be smart.

proc color_of {layer {type other}} {

  global COLOR_NO COLOR SAMPLE_COLORS RGB SMART_COLORS metal_color_layers

  if {[info exists COLOR($layer)]} {
    set color [string tolower [string trim $COLOR($layer)]]
    if {$color != "" && $color != "-"} {
      # user has actually specified a color
      if {[llength [split $color ,]] == 3} {
	# rgb triple
	return [split $color ,]
      }

      # try to look it up in rgb.txt
      if {[info exists RGB($color)]} {
	return $RGB($color)
      }
    }
  }

  # pick intelligent colors for the layers
  switch $type {
    via {
      return "0 0 0"
    }

    poly - act {
      if {$type == "act" && ![info exists SMART_COLORS(diff_order)]} {
	# special case, want ndif first 
	if {[string first p $layer] != -1} {
	  # pdif first, switch order
	  setl {a b} $SMART_COLORS(act) 
	  set SMART_COLORS(act) [list $b $a]
	}

	# set this so we only do it once
	set SMART_COLORS(diff_order) 1
      }

      if {![info exists SMART_COLORS(${type}_no)]} {
	set SMART_COLORS(${type}_no) 0
      }
      set color [lindex $SMART_COLORS(${type}) $SMART_COLORS(${type}_no)]
      incr SMART_COLORS(${type}_no)

      if {$color != ""} {
	return $color
      }
    }

    metal {
      # always use this approach
      if {1 || [string index $layer 0] == "L" || \
	      [regexp {[0-9][0-9]} $metal_color_layers]} {
	# user has chosen layer name, use from order given
	set index [lsearch $metal_color_layers $layer]
	if {$index != -1} {
	  set color [lindex $SMART_COLORS(metal) [incr index]]
	  if {$color != ""} {
	    return $color
	  }
	}

      } else {
	# get based on metal layer number
	set index ""
	regexp {([0-9])} $layer tmp index
	if {$index != ""} {
	  set color [lindex $SMART_COLORS(metal) $index]
	  if {$color != ""} {
	    return $color
	  }
	}
      }
    }
  }

  set color [lindex $SAMPLE_COLORS $COLOR_NO]
  incr COLOR_NO

  if {$color == ""} {
    # wrap
    set COLOR_NO 0
    set color [lindex $SAMPLE_COLORS $COLOR_NO]
    incr COLOR_NO
  }

  return $color
}


# return a stipple

proc stipple_of {stipple} {

  global STIPPLES NO_STIPPLES

  # there are NO_STIPPLES stipples
  return [lindex $STIPPLES [expr $stipple % $NO_STIPPLES]]
}



#!/bin/csh -f

# The next line will be skipped in TCL because of the backslash \
mmi_wish -f $0 -- $* ; exit $status

# Copyright (c) 1999, Micro Magic, Inc.

# Creates max technology files from a table description of layers
# and templates

# TODO: add xlate_me to add other drc rules

set MAKE_TECH_VERSION 1

set MAX_VERSION max3

set GOLDEN_TECHS "g18 g25 g35" 

# does the work

proc make_tech args {

  global env GOLDEN_TECHS DERIVES COLOR LAYERS XLATE RULES DRC_DATA
  global gds_layers devices MAX_VERSION metal_color_layers ALIAS
  global txt_layers gds_layers MAKE_TECH_VERSION _SPECIAL_

  set default_min 0.4
  set default_overlap 0.04

  if {[llength [lindex $args 0]] < 2} {
    usage_info_exit
  }

  call_keyword [lindex $args 0] {{tech ""} {r} {install} {file ""} {h}}

  if {$h} {
    usage_info_exit
  }

  if {![info exists env(MMI_TOOLS)]} {
    puts "Aborting, must set MMI_TOOLS environment variable."
    exit 1
  }

  if {[lsearch $GOLDEN_TECHS $tech] != -1} {
    puts "Aborting, can't replace any of the GOLDEN TECHNOLOGY files: $GOLDEN_TECHS"
    return
  }

  if {$file == ""} {
    puts "Aborting, must supply layer file name."
    usage_info_exit
  }

  if {![file readable $file]} {
    puts "Aborting, Can't read file $file\n"
    return
  }

  # if tech not set, use suffix from source file
  if {$tech == ""} {
    set tech [file rootname [file tail $file]]
  }

  # figure out the pathname of this script
  set script [info script]

  # track down any links
  while {[file type $script] == "link"} {
    set scriptdir [file dirname $script]
    set script [file readlink $script]
    if {[file dirname $script] == "." || [string index $script 0] == "."} {  
      set script $scriptdir/$script	
    }
  }

  set sourceroot [file dirname $script]

  if {$install} {
    # install into mmi_local
    if {[use_first env(MMI_LOCAL)] != ""} {
      set techroot $env(MMI_LOCAL)
    } else {
      set techroot $env(MMI_TOOLS)/../mmi_local
    }
    if {[file isdir $techroot/$MAX_VERSION]} {
      set techroot $techroot/$MAX_VERSION/tech
    } else {
      set techroot $techroot/max/tech
    }

    # get rid of ~
    set techroot [file nativename $techroot]

    # make directory if needed
    if {![file isdir $techroot]} {
      # make this directory
      catch "exec mkdir $techroot"
    }

  } else {
    # install into mmi_private
    set techroot "~/mmi_private"

    # get rid of ~
    set techroot [file nativename $techroot]

    if {[file isdir $techroot/$MAX_VERSION]} {
      set techroot $techroot/$MAX_VERSION/tech
    } else {
      set techroot $techroot/max/tech
    }
    
    # make the directory if needed
    if {![file isdir $techroot]} {
      set makedir ""
      foreach string [split $techroot /] {
	if {$string == ""} {
	  continue
	}
	append makedir /$string

	if {![file isdir $makedir]} {
	  # make this directory
	  catch "exec mkdir $makedir"
	}
      }
    }
  }

  if {![file isdir $techroot]} {
    puts "Aborting, no directory $techroot"
    exit 1
  }

  if {[catch "open $file r" FILE_ID]} {
    # error
    puts stderr "Aborting, $FILE_ID"
    return
  } 

  setl {tech techvar} [split $tech -]
  if {$techvar != ""} {
    set techvar "${tech}-$techvar"
  } else {
    set techvar $tech
  }

  if {[file readable $techroot/$tech/$techvar.tech27]} {
    if {$r} {
      # remove old technology files of same name
      puts "Removing existing technology files for technology \"$techvar\"."
      if {[catch "exec rm -rf $techroot/$tech/$techvar.*"]} {
	puts "Aborting, can't remove existing technology files \"$techroot/$tech/$techvar.*\".  Change permissions or choose another name."
	exit 1
      }
    } else {
      puts "Aborting, technology file \"$techroot/$tech/$techvar\" already exists."
      puts "Use -r option to replace."
      exit 1
    }
  }

  set planes ""
  set types ""
  set ignores ""
  set bbox ""
  set iname ""
  set act ""
  set poly ""
  set gds_layer ""
  set act_types ""
  set metal_types ""
  set metal_color_layers ""
  set other_types ""
  set parasitics ""
  set DRC_DATA(vias) ""
  set last_metal ""
  set last_via ""
  set drcs ""
  set other_connects ""
  set RULES ""
  set sets ""
  set preserve_ports 0
  set text ""
  set gdsonly ""
  set device_list ""
  set paints ""
  set square 0

  puts "Parsing layer file \"$file\" ..."

  while {[gets $FILE_ID line] >= 0} {

    set line [remove_comments $line]

    set line [string trim $line]

    if {$line == ""} {
      # blank line, ignore
      continue
    }

    # look for a continuation (backslash at end of line)
    while {[string index $line [expr [string length $line] - 1]] == "\\"} {
      # continuation, append next line
      gets $FILE_ID line2

      set line2 [remove_comments $line2]

      set line "[string trimright $line \\] $line2"
    }

    # check for illegal characters
    if {[regexp {\{|\}} $line bogus] && \
	    [string tolower [lindex $line 0]] != "set"} {
      puts "ERROR: line contains {}, skipping\n\t$line"
      continue
    }

    switch [string tolower [lindex $line 0]] {

      preserve_ports {
	# writes different ports to different data types
	set preserve_ports 1
      }

      square_vias {
	# arrays vias larger than minimum
	set square 1
      }

      set {
	# pass through directly to <tech>.tcl file
	lappend sets $line
      }

      drc {
	# drc rule

	# look for special case of enclosure with two different values
	set ruletype [string tolower [lindex $line 2]]
	if {$ruletype == "width"} {
	  # need this value for enclosure
	  set _WIDTHS_([lindex $line 1]) [lindex $line 3]

	} elseif {$ruletype == "enc"} {
	  if {![catch "expr [lindex $line 5]"]} {
	    set value [expr [lindex $line 4] * 1.0]
	    set value2 [expr [lindex $line 5] * 1.0]
	    if {$value != $value2} {
	      # this is it

	      # derive some temporary layers
	      set enc [lindex $line 3]

	      if {![info exists _WIDTHS_($enc)]} {
		# can't do it without enc width
		puts "WARNING: Skipping enclosure rule.  Need to define width for layer $enc first:\n$line"
		continue
	      }

	      set enc_by [lindex $line 1]
	      set max_value [max $value $value2]
	      set min_value [min $value $value2]
	      set del_value [expr $max_value - $min_value]
	      set lname ${enc_by}_${enc}_check

	      set DERIVES(${enc_by}_${enc}_sx) "$enc_by shrinkx $del_value"
	      if {$min_value > 0.0} {
		set shrink " shrink $min_value"

	      } elseif {$min_value < 0.0} {
		# doesn't work because of DRC rule
		set shrink " grow [expr 0 - $min_value]"

	      } else {
		# do nothing
		set shrink ""
	      }

	      set DERIVES($lname) "$enc_by shrinky $del_value or ${enc_by}_${enc}_sx$shrink and $enc"

	      # check width on this puppy
	      lappend drcs [lreplace $line 1 5 $lname width $_WIDTHS_($enc)] 

	      # override normal drc message
	      set _SPECIAL_(width,$lname) "$enc_by enclosure of $enc = $max_value um on at least 2 opposite sides"
	      # for now to make gcells work
#	      set _SPECIAL_(enclose,$enc_by,$enc) $max_value
	      set _SPECIAL_(enclose,$enc_by,$enc) "$value $value2"
	      
	      # still needs an enclosure rule for smallest value
	      set line [lreplace $line 4 5 $min_value]
	    }
	  }
	}

	lappend drcs $line
      }

      derive {
	# derive a new layer
	if {[lindex $line 2] != "from"} {
	  puts "ERROR, no \"from\" keyword in derive command, skipping:\n\t$line"
	  continue
	}

	set DERIVES([lindex $line 1]) [lrange $line 3 end]
      }

      connect {
	# connect two layers
	lappend other_connects [lrange $line 1 2]
      }

      device {
	# define a device, like and nfet
	# example: device nfet from poly ndif
	# assume a fet for now -- generalize later

	# look for bulk connection
	set bulk ""
	if {[set pos [lsearch $line -bulk_terminal]] != -1} {
	  # user defined bulk terminal
	  set bulk [lindex $line [expr $pos + 1]]
	  set line [lreplace $line $pos [expr $pos + 1]]
	}

	setl {bogus device bogus l1 l2 l3} $line
	set devices($device) "$l1 $l2 $l3"

	if {$bulk != ""} {
	  set devices_bulk($device) $bulk
	}

	lappend device_list $device
      }

      default {
	# layer definition
	setl {layer gds txt type width space color} "$line - - - - - -"

	if {[lsearch "annotation flyline label" $layer] != -1} {
	  puts "WARNING, skipping layer \"$layer\":  reserverd word."
	  continue
	}

	if {[info exists PROCESSED(layer,$layer)]} {
	  puts "WARNING, skipping duplicate definition of layer \"$layer\"."
	  continue
	}
	set PROCESSED(layer,$layer) 1

	set COLOR($layer) $color
	set gds_layers($layer) $gds
	set txt_layers($layer) $txt

	if {![catch "expr $width"]} {
	  # valid number, save it
	  lappend drcs "drc $layer width $width"
	  set _WIDTHS_($layer) $width
	}
	if {![catch "expr $space"]} {
	  # valid number, save it
	  lappend drcs "drc $layer space $space"
	}
	
	switch _$type {
	  
	  _gdsonly {
	    # don't make a place or type for this
	    lappend gds_layer $layer
	    lappend gdsonly $layer
	    set DERIVES(GDS_$layer) $layer
	    set XLATE($layer) GDS_$layer
	  }

	  _act - _active {
	    # active
	    lappend act $layer
	    if {[lsearch $planes active] == -1} {
	      lappend planes active
	    }
	    lappend types "active $layer"
	    lappend gds_layer $layer
	    lappend act_types $layer
	  }
	  
	  _poly {
	    lappend poly $layer
	    if {[lsearch $planes active] == -1} {
	      lappend planes active
	    }
	    lappend types "active $layer"
	    lappend gds_layer $layer
	    lappend act_types $layer
	    lappend parasitics $layer
	  }

	  _via {
	    lappend planes $layer
	    lappend types "$layer $layer"
	    lappend gds_layer $layer
	    lappend DRC_DATA(vias) $layer
	    lappend metal_types $layer

	    if {$last_metal == ""} {
	      # must be a contact
	      if {$act_types != ""} {
		foreach a $act_types {
		  lappend connects($layer) $a
		}
		set last_via $layer
	      }
	    } else {
	      # via, metal below
	      set connects($layer) $last_metal
	      set last_via $layer
	      # do we need to do this?
	      set last_metal ""
	    }
	  }
	  
	  _metal {
	    lappend planes $layer
	    lappend types "$layer $layer"
	    lappend gds_layer $layer
	    lappend metal_types $layer
	    lappend metal_color_layers $layer
	    lappend parasitics $layer
	    if {$last_via != ""} {
	      # connect to this via
	      lappend connects($last_via) $layer
	      # do we need to do this?
	      set last_via ""
	    }
	    set last_metal $layer
	  }

	  _ignore {
	    # ignore this on gds input
	    lappend ignores $layer
	  }

	  _bbox {
	    # write out bbox on gds input/output
	    set bbox $layer
	  }

	  _iname {
	    # write out iname on gds input/output
	    set iname $layer

	    if {[string first prop $gds_layers($layer)] == 0} {
	      # special case for propattr
	      set gds_layers($layer) "propattr:$txt_layers($layer)"
	      set txt_layers($layer) -
	    }
	  }

	  _text {
	    # special layer for reading and writing labels (text)
	    if {$text != ""} {
	      puts "WARNING, duplicate text type, skipping layer \"$layer\".  If you want multiple, combine gds with commas on one line."
	      continue
	    }

	    set text $layer

	    if {$gds_layers($layer) != "-" && \
		    ($txt_layers($layer) == "-" || $txt_layers($layer) == "")} {
	      # let them put the layer in the text slot
	      set txt_layers($layer) $gds_layers($layer)
	    }
	  }

	  default {
	    # other layers type
	    if {$type != "" && $type != "-"} {
	      puts "WARNING, unknow type \"$type\" for layer \"$layer\"."
	      continue
	    }

	    lappend planes $layer
	    lappend types "$layer $layer"
	    lappend gds_layer $layer
	    lappend other_types $layer
	    set type other
	  }
	}
      }
    }
  }

  # close the file
  close $FILE_ID

  foreach type $types {
    setl {a b} $type
    set LAYERS($b) 1
    set PLANE_OF($b) $a
  }

  # if no devices defined, define a fet
  if {$act != "" && $poly != "" && [array names devices] == ""} {
    foreach one $act {
      # don't make devices out of derived by something
      if {$txt_layers($one) != "-"} {
	continue
      }

      if {[string first p [string tolower $one]] == 0} {
	set fetname pfet
      } elseif {[string first n [string tolower $one]] == 0} {
	set fetname nfet
      } else {
	set fetname fet
      }

      if {[info exists fetnames($fetname)]} {
	# can't have a duplicate
	set fetname $fetname[incr fetnames($fetname)]
      } else {
	set fetnames($fetname) 1
      }

      set devices($fetname) [list [lindex $poly 0] $one]
      lappend device_list $fetname
    }
  }

  # walk thru devices and set them up
  foreach device $device_list {
    setl {l1 l2 l3} $devices($device)

    set PLANE_OF($device) $PLANE_OF($l1)

    lappend types "$PLANE_OF($l2) $device"
    lappend gds_layer $device
    set gds_layers($device) derived

    set compose 1
    if {$l3 != ""} {
      # special case, third layer determines type
      # find other device without this layer
      foreach _device $device_list {
	if {$device == $_device} {
	  continue
	}

	if {[lrange $devices($device) 0 1] == [lrange $devices($_device) 0 1]} {
	  # this is it
	  set compose 0
	  lappend paints "paint $_device $l3 $device"
	  lappend paints "erase $device $l3 $_device"
	  break
	}
      }
    }
    if {$compose} {
      # just put in the compose section
      lappend paints "compose $device $l1 $l2"
    }

    # add connections
    lappend other_connects "$device $l1"

    # until simple layers
    foreach l "$l1 $l2" {
      if {![info exists XLATE($l)]} {
	set XLATE($l) $l
      }
      set XLATE($l) "$XLATE($l),$device"
    }
  }

  # so far, so good.  Let's build the tech directory
  if {![file isdirectory $techroot/$tech]} {
    puts "Building tech directory $techroot/$tech"

    if {[catch "exec mkdir $techroot/$tech"]} {
      puts "Aborting, can't make directory $techroot/$tech"
      exit 1
    }
  }

  # copy the technology source file into the directory with the appripriate name
  catch "exec cp $file $techroot/$tech/$techvar.source"

  # now make the .tech file
  if {[catch "open $techroot/$tech/$techvar.tech w" FILE_ID]} {
    # error
    puts stderr "Aborting, $FILE_ID"
    exit 1
  } 

  # header stuff
  puts $FILE_ID "/*\tMAX TECHNOLOGY FILE: $techvar"
  puts $FILE_ID "\tAutogenerated by make_tech on [clock format [clock seconds]]"
  puts $FILE_ID "*/\n"

  puts $FILE_ID "/* "
  puts $FILE_ID "* To use this file, need to run through the following:"
  puts $FILE_ID "*	mmi_cpp -P -traditional $techvar.tech | mmi_m4 > $techvar.tech27"
  puts $FILE_ID "*/\n"
  puts $FILE_ID "\#include \"drc_macros.i\"\n"
  puts $FILE_ID "tech"
  puts $FILE_ID "\t$tech"
  puts $FILE_ID "end\n"
  puts $FILE_ID "version"
  puts $FILE_ID "\tversion STRING_CAT($techvar,__TIME__,__DATE__)"
  puts $FILE_ID "\tdescription \"$techvar\""
  puts $FILE_ID "end\n"

  puts $FILE_ID "planes"
  foreach plane $planes {
    puts $FILE_ID "\t$plane"
  }
  puts $FILE_ID "end\n"

  puts $FILE_ID "types"
  foreach type $types {
    setl {a b} $type
    puts $FILE_ID "\t$a\t$b"
  }

  puts $FILE_ID "end\n"

  puts $FILE_ID "contact"
  puts $FILE_ID "end\n"

  puts $FILE_ID "styles"
  puts $FILE_ID "end\n"

  puts $FILE_ID "compose"
#  if {$act != "" && $poly != ""} {
#    foreach device $device_list {
#      setl {tops bots} $devices($device)
#      foreach top $tops {
#	foreach bot $bots {
#	  puts $FILE_ID "\tcompose\t$device\t$top\t$bot"
#	}
#      }
#    }
    foreach paint $paints {
      puts $FILE_ID "\t$paint"
    }
#  }
  puts $FILE_ID "end\n"

  puts $FILE_ID "connect"
  foreach con $other_connects {
    puts $FILE_ID "\t[join $con \t]"
    # TODO: add to DRC_DATA
  }

  foreach con $DRC_DATA(vias) {
    if {[info exists connects($con)]} {
      if {[llength $connects($con)] < 2} {
	# ignore
	unset connects($con)
	continue
      }

      puts $FILE_ID "\t$con\t[join $connects($con) ,]"
      foreach other_con $connects($con) {
	lappend DRC_DATA(connect,$con) $other_con
	lappend DRC_DATA(connect,$other_con) $con
      }
    }
  }
  puts $FILE_ID "end\n"

  # figures out any aliases
  foreach layer [array names DERIVES] {
    if {[string range $layer 0 3] == "GDS_"} {
      # special case, skip
      continue
    }

    if {[use_first gds_layers($layer)] == "derived"} {
      # this is done in the cifinput section
      continue
    }

    if {[lsearch $DERIVES($layer) $layer] == -1} {
      set ALIAS($layer) [split [lindex $DERIVES($layer) 0] ,]
    }
  }

  # go thru drc layers here to derive ciflayers needed and
  # override any space/width rules from the table.
  foreach drc $drcs {
    # remove comments
    set pos [string first \; $drc]
    if {$pos == -1} {
      # no comment
      set comment ""
      set drc [lrange [string trim $drc] 1 end]
    } else {
      set comment "  [string trim [string range $drc [expr $pos + 1] end]]"
      set drc [lrange [string trim [string range $drc 0 [expr $pos - 1]]] 1 end]
    }

    set layer [lindex $drc 0]
    set ruletype [string tolower [lindex $drc 1]]
    switch _$ruletype {
      _width - _space {
	# minimum width or space
	if {$ruletype == "space"} {
	  set ruletype spacing
	}

	addrule $ruletype $layer [lindex $drc 2] $comment
      }
      _area {
	# minimum area
	set value [expr [lindex $drc 2] * 1.0]
	if {[info exists DRC_DATA(width,$layer)]} {
	  set value2 $DRC_DATA(width,$layer)
	} else {
	  puts "WARNING: Skipping area rule for layer \"$layer\".  Need to define width for layer first."
	  continue
	}
	if {[is_derived $layer] || [info exists XLATE($layer)] != ""} {
	  # cif
	  lappend RULES "\tcifarea [ciflayer_of $layer] $value $value2 \\"
	} else {
	  # noncif
	  lappend RULES "\tarea $layer $value $value2 \\"
	}
	lappend RULES "\t\t\"$layer minimum area = $value um2.$comment\"\n"
	set DRC_DATA(area,$layer) $value
      }

      _space_to {
	# spacing between two layers
	set layer2 [lindex $drc 2]
	set value [expr [lindex $drc 3] * 1.0]

	if {$value < 0.0} {
	  # illegal
	  puts "WARNING: negative layer spacing illegal, setting to 0.0 in:\n\tdrc $drc"
	  set value 0.0
	}

	# add drc_data using aliases if present
	add_drc_data space_to $layer $layer2 $value reverse

	set c ""

	# both layers must be cif or not cif for drc.  If only one is cif,
	# make a templayer for the other.
	if {[any_ciflayers "$layer $layer2"]} {
	  # need to use cifspacing
	  set l [ciflayer_of $layer]
	  set l2 [ciflayer_of $layer2]

	  if {$value == 0.0} {
	    lappend RULES "\tCIF_NO_OVERLAP($l, $l2, \\"
	    set c ")"
	  } else {
	    lappend RULES "\tcifspacing $l $l2 $value touching_illegal \\"
	  }


	} else {
	  # both are non-ciflayers
	  if {$value == 0.0} {
	    lappend RULES \
		"\tNO_OVERLAP($layer,$PLANE_OF($layer),$layer2,$PLANE_OF($layer2), \\"
	    set c ")"

	  } else {
	    lappend RULES \
		"\tspacing $layer $layer2 $value touching_illegal \\"
	  }

	}
	lappend RULES \
	    "\t\t\"$layer to $layer2 minimum spacing = $value um.$comment\"$c\n"

      }
      _enc {
	# enclosure (overlaps)
	set enclosed [lindex $drc 2]
	set value [expr [lindex $drc 3] * 1.0]
	set overlap_layers($layer,$enclosed) $value

	if {$value < 0} {
	  puts "WARNING: skipping drc enclose command \"[lindex $drc 1]\" with negative enclosure in line:\n\tdrc $drc"
	  continue
	}

	# both layers must be cif or not cif for drc.  If only one is cif,
	# make a templayer for the other.
	if {[any_ciflayers "$layer $enclosed"]} {
	  # need to use cifenclosure
	  set l [ciflayer_of $layer]
	  set l_enc [ciflayer_of $enclosed]

	  if {$value == 0.0} {
	    lappend RULES "\tCIF_COVER($l_enc,$l, \\"
	  } else {
	    lappend RULES "\tCIF_ENCLOSE($l_enc,$l,$value, \\"
	  }

	} else {
	  # both are non-ciflayers
	  # TODO: should lookup planes instead of assuming same as type.

	  if {$value == 0.0} {
	    lappend RULES \
		"\tCOVER($enclosed,$PLANE_OF($enclosed),$layer,$PLANE_OF($layer), \\"
	  } else {
	    lappend RULES \
	      "\tENCLOSE($enclosed,$PLANE_OF($enclosed),$layer,$PLANE_OF($layer),$value, \\"
	  }
	}
	lappend RULES \
	    "\t\t\"$layer minimum enclosure of $enclosed = $value um.$comment\")\n"
	# add drc_data using aliases if present
	add_drc_data enclose $layer $enclosed $value
      }
      _ext {
	# Note: both layers must be on same place for < max3.0
	set enclosed [lindex $drc 2]
	set value [expr [lindex $drc 3] * 1.0]
	lappend RULES \
	    "\tedge4way $enclosed/active $layer/active $value $layer/active 0 0 \\"
	lappend RULES \
	    "\t\t\"$layer minimum extension past $enclosed = $value um.$comment\"\n"
	set DRC_DATA(extend,$layer,$enclosed) $value
      }
      default {
	puts "WARNING: skipping unknown drc command \"[lindex $drc 1]\" in line:\n\tdrc $drc"
      }
    }
  }

  puts $FILE_ID "cifoutput"
  puts $FILE_ID "style $tech\n"
  puts $FILE_ID "\tunits .001 .001 .001 .001"
  puts $FILE_ID "\tcharset unrestricted\n"

  if {$iname != ""} {
    puts $FILE_ID "\tiname [parse_gds $gds_layers($iname) 0]"
  }

  if {$bbox != ""} {
    puts $FILE_ID "\tbbox [parse_gds $gds_layers($bbox) 0]"
  }

  puts $FILE_ID ""

  set cifout_order ""

  foreach layer $gds_layer {
    if {[lsearch "- derived" $gds_layers($layer)] == -1} {

      lappend cifout_order $layer

      if {[info exists DERIVES($layer)]} {
	# derived on output
	set label_layer [lindex $DERIVES($layer) 0]
#xxx
	lappend cifouts($layer) "\tlayer GDS_$layer [xlate_me $label_layer]"
	eval lappend cif_depend($layer) [split [xlate_me $label_layer] ,]
	set ops [lrange $DERIVES($layer) 1 end]
	while {$ops != ""} {
	  lappend cifouts($layer) \
	      "\t\t[lindex $ops 0] [xlate_me [lindex $ops 1]]"
	  eval lappend cif_depend($layer) [split [xlate_me [lindex $ops 1]] ,]
	  if {[lindex $ops 1] == $layer || $layer == $label_layer} {
	    # special case, use this layer for the label layer
	    set label_layer $layer

	    # this is a rederive of a layer
	    set no_derive_cifouts($layer) \
		[list "\tlayer GDS_$layer [xlate_me $layer]"]
	  }
	  set ops [lrange $ops 2 end]
	}

	# so we don't do this later on
	unset DERIVES($layer)

      } else {
	# just pass straight thru
	if {[lsearch $gdsonly $layer] != -1} {
	  # special case.  gdsonly but not derived.  Ignore on output
	  continue
	}
	lappend cifouts($layer) "\tlayer GDS_$layer [xlate_me $layer]"
	set label_layer $layer
      }

      # square via if we know width and spacing and user specified to
      if {$square && [lsearch $DRC_DATA(vias) $layer] != -1} {
	# this is a via
	if {[info exists DRC_DATA(width,$layer)] && \
		[info exists DRC_DATA(spacing,$layer)]} {
	  # put in squaring
	  lappend cifouts($layer) \
	      "\t/* squares <border> <size> <separation> \[align\] */"
	  lappend cifouts($layer) \
	      "\tsquares 0 $DRC_DATA(width,$layer) $DRC_DATA(spacing,$layer) align"
	}
      }

      # special for nonmanhattan's since they don't get layer ops (for now)
      set _cifouts ""
      lappend _cifouts "\tpolygons [xlate_me $label_layer]"

      # uses first layer for derived layers for labels.  This first
      # layer can be a comma-separated list.  CANNOT do separate text
      # layers for a comma separated list.
      
      # NOTE: not always right.  Special case if layer is in operation
      # use that layer only.  See above.

      if {[info exists txt_layers($label_layer)] && \
	      $txt_layers($label_layer) != "-"} {
	# separate layers, doesn't look for multiple layers
	lappend _cifouts "\tcalma [parse_gds $gds_layers($layer) 0]\n"
	
	lappend _cifouts "\tlayer TXT_$layer"
	lappend _cifouts "\tlabels [xlate_me $label_layer]"

	lappend _cifouts "\tcalma [parse_gds $txt_layers($label_layer) 0]"
	set tmp $txt_layers($label_layer)

      } else {
	# use same as paint
	lappend _cifouts "\tlabels [xlate_me $label_layer]"

	lappend _cifouts "\tcalma [parse_gds $gds_layers($layer) 0]"

	set tmp $gds_layers($layer)
      }

      # special case for preserving ports
      if {$preserve_ports} {
	if {[string first : $tmp] != -1} {
	  puts "WARNING: can't preserve ports on layer \"$layer\" because $tmp includes datatypes"
	} else {
	  # add port types
	  set c 0
	  foreach port_type "comment hidden local global input output inout" {
	    lappend _cifouts "\tport [parse_gds $tmp $c] $port_type"
	    incr c
	  }
	}
      }
      lappend _cifouts ""

      eval lappend cifouts($layer) $_cifouts

      if {[info exists no_derive_cifouts($layer)]} {
	# special no derive case
	eval lappend no_derive_cifouts($layer) $_cifouts
      }
    }
  }

  # add derived layers
  foreach layer [array names DERIVES] {
    if {[string range $layer 0 3] == "GDS_"} {
      # special case, skip
      continue
    }

    if {[use_first gds_layers($layer)] == "derived"} {
      # this is done in the cifinput section
      continue
    }

    lappend cifout_order $layer

    lappend cifouts($layer) \
	"\ttemplayer $layer [xlate_me [lindex $DERIVES($layer) 0]]"
    eval lappend cif_depend($layer) [split [xlate_me [lindex $DERIVES($layer) 0]] ,]

    set ops [lrange $DERIVES($layer) 1 end]
    while {$ops != ""} {
      lappend cifouts($layer) "\t\t[lindex $ops 0] [xlate_me [lindex $ops 1]]"
      eval lappend cif_depend($layer) [split [xlate_me [lindex $ops 1]] ,]
      set ops [lrange $ops 2 end]
    }
  }

  if {$text != ""} {
    # add the text layer
    set layer $text
    lappend cifout_order $layer

    lappend cifouts($layer) ""

    lappend cifouts($layer) "\tlayer [xlate_me TXT_$layer]"
    lappend cifouts($layer) "\tlabels space"
    lappend cifouts($layer) "\tcalma [parse_gds $txt_layers($layer) 0]"

    set tmp $txt_layers($layer)

    # special case for preserving ports
    if {$preserve_ports} {
      if {[string first : $tmp] != -1} {
	puts "WARNING: can't preserve ports on layer \"$layer\" because $tmp includes datatypes"
      } else {
	# add port types
	set c 0
	foreach port_type "comment hidden local global input output inout" {
	  lappend cifouts($layer) "\tport [parse_gds $tmp $c] $port_type"
	  incr c
	}
      }
    }
  }

  set all_types [concat $act_types $metal_types $other_types]

  # now put everything in depend order
  # NOTE: needs to be multiple pass -- sorts three times now
  set depend_order ""
  foreach layer $cifout_order {

    if {[lsearch $depend_order $layer] != -1} {
      # already got this
      continue
    }

    if {[info exists cif_depend($layer)]} {
      # might depend on something
      foreach l $cif_depend($layer) {
	
	if {[lsearch $all_types $l] != -1} {
	  # max layer, not derived
	  continue
	}

	regsub "^GDS_" $l "" l

	if {$l != $layer && [info exists cif_depend($l)]} {
	  # need this layer first
	  if {[lsearch $depend_order $l] == -1} {
	    # not already added, add
	    lappend depend_order $l
	  }
	}
      }
    }

    lappend depend_order $layer
  }

  # do it again
  set cifout_order $depend_order
  set depend_order ""
  foreach layer $cifout_order {

    if {[lsearch $depend_order $layer] != -1} {
      # already got this
      continue
    }

    if {[info exists cif_depend($layer)]} {
      # might depend on something
      foreach l $cif_depend($layer) {
	
	if {[lsearch $all_types $l] != -1} {
	  # max layer, not derived
	  continue
	}

	regsub "^GDS_" $l "" l

	if {$l != $layer && [info exists cif_depend($l)]} {
	  # need this layer first
	  if {[lsearch $depend_order $l] == -1} {
	    # not already added, add
	    lappend depend_order $l
	  }
	}
      }
    }

    lappend depend_order $layer
  }

  # one more time
  set cifout_order $depend_order
  set depend_order ""
  foreach layer $cifout_order {

    if {[lsearch $depend_order $layer] != -1} {
      # already got this
      continue
    }

    if {[info exists cif_depend($layer)]} {
      # might depend on something
      foreach l $cif_depend($layer) {
	
	if {[lsearch $all_types $l] != -1} {
	  # max layer, not derived
	  continue
	}

	regsub "^GDS_" $l "" l

	if {$l != $layer && [info exists cif_depend($l)]} {
	  # need this layer first
	  if {[lsearch $depend_order $l] == -1} {
	    # not already added, add
	    lappend depend_order $l
	  }
	}
      }
    }

    lappend depend_order $layer
  }

  foreach layer $depend_order {
    if {[info exists cifouts($layer)]} {
      puts $FILE_ID [join $cifouts($layer) \n]
    }
  }

  puts $FILE_ID "end\n"

  set calma ""

  puts $FILE_ID "cifinput"
  puts $FILE_ID "style\t$tech"
  # scalefactor not needed, default to cifoutput
#  puts $FILE_ID "\tscalefactor\t1\n"

  if {$iname != ""} {
    puts $FILE_ID "\tiname [parse_gds $gds_layers($iname) 0]"
  }

  if {$bbox != ""} {
    puts $FILE_ID "\tbbox [parse_gds $gds_layers($bbox) 0]"
  }

  foreach layer $ignores {
    if {$gds_layers($layer) != "-"} {
      puts $FILE_ID "\tignore\tGDS_$layer"
      lappend calma "\tcalma GDS_$layer\t[parse_gds $gds_layers($layer) *]"
    }
    if {$txt_layers($layer) != "-"} {
      puts $FILE_ID "\tignore\tTXT_$layer"
      lappend calma "\tcalma TXT_$layer\t[parse_gds $txt_layers($layer) *]"
    }
  }

  puts $FILE_ID ""

  foreach type $types {
    setl {plane layer} $type

    if {[lsearch "-" $gds_layers($layer)] == -1} {
      if {$gds_layers($layer) == "derived"} {
	if {![info exists DERIVES($layer)]} {
	  if {![info exists devices($layer)]} {
	    puts "WARNING: no derivation for derived layer \"$layer\"."
	  }
	  continue
	}
	# derived on input
	set label_layer [lindex $DERIVES($layer) 0]
	if {![info exists txt_layer($label_layer)]} {
	  set label_layer $layer
	}

#xxx
	puts $FILE_ID "\tlayer $layer [gds_of [lindex $DERIVES($layer) 0]]"
	set ops [lrange $DERIVES($layer) 1 end]
	while {$ops != ""} {
	  puts $FILE_ID "\t\t[lindex $ops 0] [gds_of [lindex $ops 1] in]"
	  set ops [lrange $ops 2 end]
	}
      } else {
	# passed directly thru on input
	puts $FILE_ID "\tlayer $layer GDS_$layer"
	set label_layer $layer
      }

      if {$txt_layers($label_layer) != "-" && \
	      ![gds_contains $layer $label_layer]} {
	# use different
	# special case if both same and different
	if {$txt_layers(same,$label_layer)} {
	  puts $FILE_ID "\tlabels GDS_$label_layer"
	}

	if {0 && [info exists txt_layers(save,$label_layer)] && \
		[llength $txt_layers(save,$label_layer)] > 1} {
	  set i 0
	  foreach x $txt_layers(save,$label_layer) {
	    puts $FILE_ID "\tlabels TXT_${label_layer}_[incr i]"
	  }
	  puts $FILE_ID ""

	} else {
	  puts $FILE_ID "\tlabels TXT_$label_layer\n"
	}



      } else {
	# use same as paint
	puts $FILE_ID "\tlabels GDS_$label_layer\n"
      }
    }
  }

  # add gds layer numbers
  foreach layer $gds_layer {
    if {[lsearch "- derived" $gds_layers($layer)] == -1} {
      set tmp ""
      set tmp_layers $gds_layers($layer)

      foreach one [parse_gds $gds_layers($layer) * in] {
	lappend calma "\tcalma GDS_$layer\t$one"
	lappend tmp [lindex $one 0]
      }

      if {[info exists txt_layers(save,$layer)]} {
	set tmp ""
	set tmp_layers $gds_layers($layer)

	set i 0
	foreach one $txt_layers(save,$layer) {
	  if {0 && [llength $txt_layers(save,$layer)] > 1} {
	    lappend calma "\tcalma TXT_${layer}_[incr i]\t$one"
	  } else {
	    lappend calma "\tcalma TXT_$layer\t$one"
	  }
	  lappend tmp [lindex $one 0]
	}
      }

      # special case for preserving ports
      if {$preserve_ports} {
	if {[string first : $tmp_layers] != -1} {
	  # already gave warning on cifoutput
	} else {
	  # add port types
	  foreach TMP $tmp {
	    set c 0
	    foreach port_type "comment hidden local global input output inout" {
	      lappend calma "\tport $port_type $TMP $c"
	      incr c
	    }
	  }
	}
      }
    }
  }

  if {$text != ""} {
    # add the text layer
    set layer $text

    lappend calma "\tlayer space"
    lappend calma "\tlabels TXT_$layer"

    set tmp ""
    foreach one [parse_gds $txt_layers($layer) * in] {
      lappend calma "\tcalma TXT_$layer $one"
      lappend tmp [lindex $one 0]
    }

    # special case for preserving ports
    if {$preserve_ports} {
      if {[string first : $tmp_layers] != -1} {
	# already gave warning on cifoutput
      } else {
	# add port types
	foreach TMP $tmp {
	  set c 0
	  foreach port_type "comment hidden local global input output inout" {
	    lappend calma "\tport $port_type $TMP $c"
	    incr c
	  }
	}
      }
    }
  }

  foreach line $calma {
    puts $FILE_ID $line
  }

  puts $FILE_ID "end\n"

  puts $FILE_ID "mzrouter"
  puts $FILE_ID "end\n"

  puts $FILE_ID "drc"
  puts $FILE_ID "cifstyle $tech\n"

  # add the drc rules
  puts $FILE_ID [join $RULES \n]

  set device [array names devices]
  if {$device != ""} {
    puts $FILE_ID "\tno_overlap\t[join $device ,]\t[join $device ,]\n"
  }

  if {$DRC_DATA(vias) != ""} {
    puts $FILE_ID "\texact_overlap\t[join $DRC_DATA(vias) ,]\n"
  }

  puts $FILE_ID "end\n"

  puts $FILE_ID "extract"
  puts $FILE_ID "style\t$tech"
  puts $FILE_ID "\tnoplaneordering\n"

  # put in some simple extraction stuff
  puts $FILE_ID "\tcscale\t1"
  puts $FILE_ID "\tlambda\t1"
  puts $FILE_ID "\tstep\t1000"
  puts $FILE_ID "\tsidehalo\t0\n"

  # simple default values
  foreach layer $parasitics {
    puts $FILE_ID "\tresist $layer 115"
    puts $FILE_ID "\tareacap $layer 0.0001"
    puts $FILE_ID "\tperimc $layer space/$PLANE_OF($layer) 0.1\n"
  }

  # put in the devices 
  foreach device $device_list {
    if {[info exists devices_bulk($device)]} {
      # use user specified
      set bulk $devices_bulk($device)

    } else {
      if {[string first p [string tolower $device]] == 0} {
	set bulk Vdd!
      } else {
	set bulk GND!
      }
    }

    puts $FILE_ID \
	"\tfet $device [lindex $devices($device) 1] 2 $device $bulk 0 0"
    set DRC_DATA(device,fet,$device) $devices($device)
  }

  puts $FILE_ID "\nend\n"

  # close the file
  close $FILE_ID

  # now make the palette file
  if {[catch "open $techroot/$tech/$techvar.palette w" FILE_ID]} {
    # error
    puts stderr "Aborting, $FILE_ID"
    exit 1
  } 

  puts $FILE_ID "\# Palette setup of layer order, colors, stipples, etc."
  puts $FILE_ID "\# Autogenerated by make_tech.\n"

  set stipple 0

  # determine which layers are solids since max only allows 9
  set solids $poly
  foreach layer $act {
    if {![info exists LAYERS($txt_layers($layer))]} {
      lappend solids $layer
    }
  }
  foreach layer $metal_types {
    if {[lsearch $DRC_DATA(vias) $layer] == -1} {
      lappend solids $layer
    }
  }

  set DRC_DATA(layer_order) ""
  if {$metal_types != ""} {
    puts $FILE_ID "\npal_add_group metal"
  }
  foreach layer [lreverse $metal_types] {
    lappend DRC_DATA(layer_order) $layer
    if {[lsearch $DRC_DATA(vias) $layer] != -1} {
      # via
      puts $FILE_ID "pal_layer $layer \{[color_of $layer via]\} \{stipple outline \n\t[join [stipple_of $stipple] \n\t]\n\}"
      incr stipple
    } else {
      # metal
      if {[lsearch $solids $layer] > 9} {
	# out of solids, use a stipple
	puts $FILE_ID "pal_layer $layer \{[color_of $layer metal]\} \{stipple \n\t[join [stipple_of $stipple] \n\t]\n\}"
	incr stipple

      } else {
	puts $FILE_ID "pal_layer $layer \{[color_of $layer metal]\} solid"
      }
    }
  }

  if {$act != "" || $poly != ""} {
    puts $FILE_ID "\npal_add_group active"

    foreach layer $poly {
      lappend DRC_DATA(layer_order) $layer
      puts $FILE_ID "pal_layer $layer \{[color_of $layer poly]\} solid"
    }

    # until simple layers
    foreach device $device_list {
      lappend DRC_DATA(layer_order) $device
      setl {l1 l2} $devices($device)
      # pal_compose only understands simple layers
      set l1 [lindex $l1 0]
      set l2 [lindex $l2 0]

      puts $FILE_ID "pal_compose $device $l1 $l2"
    }

    set special_stipple "\
	00110011 \
	00110011 \
	11111111 \
	11111111 \
	11001100 \
	11001100 \
	11111111 \
	11111111"

    foreach layer $act {
      lappend DRC_DATA(layer_order) $layer
      if {[info exists LAYERS($txt_layers($layer))]} {
	# special case of nwc, pwc
	puts $FILE_ID "pal_compose $layer $txt_layers($layer) \{stipple\n\t[join $special_stipple \n\t]\n\}"

      } else {
	puts $FILE_ID "pal_layer $layer \{[color_of $layer act]\} solid"
      }
    }
  }

  if {$other_types != ""} {

    puts $FILE_ID "\npal_add_group other"

    foreach layer $other_types {
      lappend DRC_DATA(layer_order) $layer
      puts $FILE_ID "pal_layer $layer \{[color_of $layer]\} \{stipple \n\t[join [stipple_of $stipple] \n\t]\n\}"
      incr stipple
    }
  }

  # close the file
  close $FILE_ID

  # move the drc_macros.i files here
  if {![file readable $techroot/$tech/drc_macros.i]} {
    if {[catch "exec cp $sourceroot/drc_macros.i $techroot/$tech/drc_macros.i"]} {
      puts "ERROR, can't copy $sourceroot/drc_macros.i to $techroot/$tech/drc_macros.i"
    }
  }

  # now make the .tech27 file
  set save_cd [pwd]
  cd $techroot/$tech
 
  if {[catch "exec mmi_cpp -P -traditional $techvar.tech | mmi_m4 > $techvar.tech27" msg]} {
    puts "ERROR, can't make $techvar.tech27: $msg"
    cd $save_cd
    exit 1
  }
  cd $save_cd

  # create a .tcl file
  if {[catch "open $techroot/$tech/$techvar.tcl w" FILE_ID]} {
    # error
    puts stderr "Aborting, $FILE_ID"
    exit 1
  } 

  puts $FILE_ID "\# $techvar.tcl technology file.  Companion to $techvar.tech."
  puts $FILE_ID "\# AUTOGENERATED FROM make_tech.  DO NOT EDIT THIS FILE."

  puts $FILE_ID ""

  puts $FILE_ID "set MAKE_TECH_VERSION $MAKE_TECH_VERSION"
  puts $FILE_ID ""

  # figure out reasonable dimension of layout by looking at widths

  # default
  set typical 0.3
  foreach layer $metal_types {
    if {[lsearch $DRC_DATA(vias) $layer] == -1} {
      # not a via
      if {[info exists DRC_DATA(width,$layer)]} {
	set typical $DRC_DATA(width,$layer)
	break
      }
    }
  }
  puts $FILE_ID "set MN_TYPICAL_WIRE_WIDTH $typical"

  puts $FILE_ID "\n\# DRC Database.  Access with techinfo command.\n"
  foreach rule [lsort [array names DRC_DATA]] {
    puts $FILE_ID [list set DRC_DATA($rule) $DRC_DATA($rule)]
  }

  puts $FILE_ID "\n\# Variables passed directly from technology source file.\n"
  puts $FILE_ID [join $sets \n]

  # close the file
  close $FILE_ID

  # now move the color_map and display_styles files here if needed.
#  if {![file readable $techroot/$tech/$tech.color_map]} {
#    if {[catch "exec cp $sourceroot/template.color_map $techroot/$tech/$tech.color_map"]} {
#      puts "ERROR, can't copy $sourceroot/template.color_map to $techroot/$tech/$tech.color_map"
#    }
#  }

#  if {![file readable $techroot/$tech/$tech.display_styles]} {
#    if {[catch "exec cp $sourceroot/template.display_styles $techroot/$tech/$tech.display_styles"]} {
#      puts "ERROR, can't copy $sourceroot/template.display_styles to $techroot/$tech/$tech.display_styles"
#    }
#  }

  puts "Generated technology \"$techvar\" in \"$techroot/$tech\"."
  puts "done."
}


# add drc_data using aliases if present

proc add_drc_data {ruletype layer layer2 value {type noreverse}} {

  global ALIAS DRC_DATA _SPECIAL_

  foreach l1s [use_first ALIAS($layer) layer] {
    foreach l1 [split $l1s ,] {
      foreach l2s [use_first ALIAS($layer2) layer2] {
	foreach l2 [split $l2s ,] {
	  if {$type == "reverse"} {
	    if {[info exists DRC_DATA($ruletype,$l2,$l1)]} {
	      # switch
	      set DRC_DATA($ruletype,$l1,$l2) $DRC_DATA($ruletype,$l2,$l1)
	      unset DRC_DATA($ruletype,$l2,$l1)
	    }
	  }

	  if {[info exists DRC_DATA($ruletype,$l1,$l2)]} {
	    # duplicate, choose smaller???
	    set DRC_DATA($ruletype,$l1,$l2) \
		[min $value $DRC_DATA($ruletype,$l1,$l2)]
	  } elseif {[info exists _SPECIAL_($ruletype,$layer,$layer2)]} {
	    set DRC_DATA($ruletype,$l1,$l2) $_SPECIAL_($ruletype,$layer,$layer2)
	  } else {
	    set DRC_DATA($ruletype,$l1,$l2) $value
	  }

#	  if {$type == "reverse"} {
#	    set DRC_DATA($ruletype,$l2,$l1) $DRC_DATA($ruletype,$l1,$l2)
#	  }
	}
      }
    }
  }
}


proc addrule {ruletype layer value comment} {

  global RULES DRC_DATA _SPECIAL_

  if {[info exists DRC_DATA($ruletype,$layer)]} {
    puts "WARNING, skipping duplicate drc $ruletype definition for layer $layer."
    return
  }

  # turn value into float
  set value [expr $value * 1.0]

  # check if this layer is a derived layer
  if {[is_derived $layer]} {
    # derived
    set useruletype cif$ruletype
    set l [ciflayer_of $layer]
  } else {
    set useruletype $ruletype
    set l [xlate_me $layer]
  }

  if {$ruletype == "width"} {
    lappend RULES "\t$useruletype $l $value \\"
  } else {
    # different syntax for spacing
    lappend RULES "\t$useruletype $l $l $value touching_ok \\"
  }

  if {[info exists _SPECIAL_($ruletype,$layer)]} {
    # special message for this layer
    lappend RULES "\t\t\"$_SPECIAL_($ruletype,$layer).$comment\"\n"

  } else {
    lappend RULES "\t\t\"$layer minimum $ruletype = $value um.$comment\"\n"
  }

  set DRC_DATA($ruletype,$layer) $value
}


proc any_ciflayers {layers} {

  foreach layer $layers {
    foreach l [split $layer ,] { 
      if {[is_derived $l]} {
	# this guy is a ciflayer
	return 1
      }
    }
  }

  # no ciflyaers
  return 0
}


proc is_derived {l} {

  global LAYERS DERIVES gds_layers devices

  if {(![info exists LAYERS($l)] && ![info exists devices($l)]) || \
	  ([info exists LAYERS($l)] && [info exists DERIVES($l)] && \
	       [lsearch "- derived" $gds_layers($l)] == -1)} {
    # derived
    return 1

  } else {
    # not derived
    return 0
  }
}


# returns the ciflayer corresponding to or, if none, makes one

proc ciflayer_of {l} {

  global DERIVES LAYERS gds_layers
  
  foreach layer [split $l ,] {

    if {[info exists DERIVES(DRC_$layer)]} {
      # ciflayer already derived.  Use it.
      lappend layers DRC_$layer

    } elseif {[info exists DERIVES(GDS_$layer)]} {
      # ciflayer already derived.  Use it.
      lappend layers GDS_$layer

    } elseif {[info exists DERIVES($layer)] && [info exists LAYERS($layer)]} {
      if {[lsearch "- derived" $gds_layers($layer)] == -1} {
	# ciflayer already derived.  Use it.
	lappend layers GDS_$layer
      } else {
	# make a ciflayer for this
	set DERIVES(DRC_$layer) $layer
	lappend layers DRC_$layer
      }

    } elseif {![info exists DERIVES($layer)]} {
      # make a ciflayer for this
      set DERIVES(DRC_$layer) $layer
      lappend layers DRC_$layer

    } else {
      lappend layers $layer
    }
  }

  return [join $layers ,]
}


# returns 1 if the label is in the paint layer

proc gds_contains {paint label} {

  global txt_layers gds_layers

  set same 0

  foreach label_gds [parse_gds $txt_layers($label) * in] {
    set save 1
    foreach paint_gds [parse_gds $gds_layers($paint) * in] {
      if {$paint_gds == $label_gds} {
	set save 0
	set same 1
	break
      }
    }

    if {$save} {
      lappend txt_layers(save,$label) $label_gds
    }
  }

  set txt_layers(same,$label) $same

  if {[info exists txt_layers(save,$label)]} {
    return 0
  } else {
    return 1
  }
}



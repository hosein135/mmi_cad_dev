set NETLIST_CACHE(oai,cells) {{icon nmos {}} {icon pmos {}}}
set netlist_props spice
set netlist_level 1000
set NETLIST_CACHE(oai,globals) {vdd gnd}
set NETLIST_CACHE(oai,version) MMI_SUE4.2.0
set NETLIST_CACHE(oai) {{.SUBCKT oai in_0_0 in_1_0 in_1_1 out WP=2 WN=2} {M_0 out in_0_0 vdd vdd p W='WP*1u' L=lp_min ad='areap(WP,sdd)' } {+ as='areap(WP,sdd)' pd='perip(WP,sdd)' ps='perip(WP,sdd)' } {M_1 out in_0_0 net_1 gnd n W='WN*1u' L=ln_min ad='arean(WN,sdd)' } {+ as='arean(WN,sdd)' pd='perin(WN,sdd)' ps='perin(WN,sdd)' } {M_2 out in_1_0 net_2 vdd p W='WP*1u' L=lp_min ad='areap(WP,sdd)' } {+ as='areap(WP,sdd)' pd='perip(WP,sdd)' ps='perip(WP,sdd)' } {M_3 net_1 in_1_0 gnd gnd n W='WN*1u' L=ln_min ad='arean(WN,sdd)' } {+ as='arean(WN,sdd)' pd='perin(WN,sdd)' ps='perin(WN,sdd)' } {M_4 net_2 in_1_1 vdd vdd p W='WP*1u' L=lp_min ad='areap(WP,sdd)' } {+ as='areap(WP,sdd)' pd='perip(WP,sdd)' ps='perip(WP,sdd)' } {M_5 net_1 in_1_1 gnd gnd n W='WN*1u' L=ln_min ad='arean(WN,sdd)' } {+ as='arean(WN,sdd)' pd='perin(WN,sdd)' ps='perin(WN,sdd)' } {.ENDS	$ oai} {}}
set NETLIST_CACHE(oai,names) {{250 200 {0 gnd}} {0 100 {0 net_1}} {-60 60 {0 in_0_0} {2 in_0_0}} {250 -60 {0 M_2}} {250 120 {0 net_1}} {0 20 {0 out}} {0 200 {0 gnd} {2 gnd}} {250 -160 {0 M_4}} {0 -60 {0 M_0}} {0 120 {0 net_1}} {500 0 {1 out}} {190 -60 {0 in_1_0} {2 in_1_0}} {250 160 {0 M_5}} {0 60 {0 M_1}} {0 -100 {0 vdd} {2 vdd}} {-60 -60 {0 in_0_0} {2 in_0_0}} {0 160 {0 M_3}} {190 160 {0 in_1_1} {2 in_1_1}} {-60 160 {0 in_1_0} {2 in_1_0}} {250 -100 {0 net_2}} {190 -160 {0 in_1_1} {2 in_1_1}} {250 -200 {0 vdd} {2 vdd}} {250 -20 {0 out}} {250 -120 {0 net_2}} {0 -20 {0 out}}}
set NETLIST_CACHE(oai,wires) {{0 -20 0 0 out} {0 0 0 20 out} {0 0 250 0 out} {250 -20 250 0 out} {0 100 0 120 net_1} {250 -120 250 -100 net_2} {250 100 250 120 net_1} {0 200 250 200 gnd} {0 100 250 100 net_1} {250 0 500 0 out}}

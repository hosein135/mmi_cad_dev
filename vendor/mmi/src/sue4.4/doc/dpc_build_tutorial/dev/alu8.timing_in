readtechnology /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/mmi25/library/pearl/pearl.tech
readctlf /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/mmi25/library/tlf/mmi25.ctlf
readverilog /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/alu8.vg
toplevelcell alu8
readspf /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/alu8.est_dspf
setmaxpossibilities 5
waveform -name _WAVE_ -period 3ns -rise_first 0 1.5n
clockwaveform clk _WAVE_
arrival a[7:0] _WAVE_ ^ 600ps 600ps 600ps 600ps
inputslew a[7:0] 200ps 200ps 200ps 200ps
arrival b[7:0] _WAVE_ ^ 600ps 600ps 600ps 600ps
inputslew b[7:0] 200ps 200ps 200ps 200ps
arrival shift_ctrl[2:0] _WAVE_ ^ 600ps 600ps 600ps 600ps
inputslew shift_ctrl[2:0] 200ps 200ps 200ps 200ps
arrival cin _WAVE_ ^ 600ps 600ps 600ps 600ps
inputslew cin 200ps 200ps 200ps 200ps
arrival subtract _WAVE_ ^ 600ps 600ps 600ps 600ps
inputslew subtract 200ps 200ps 200ps 200ps
arrival bypass_sel _WAVE_ ^ 600ps 600ps 600ps 600ps
inputslew bypass_sel 200ps 200ps 200ps 200ps
arrival fctn_sel _WAVE_ ^ 600ps 600ps 600ps 600ps
inputslew fctn_sel 200ps 200ps 200ps 200ps
arrival bypass0[7:0] _WAVE_ ^ 600ps 600ps 600ps 600ps
inputslew bypass0[7:0] 200ps 200ps 200ps 200ps
arrival bypass1[7:0] _WAVE_ ^ 600ps 600ps 600ps 600ps
inputslew bypass1[7:0] 200ps 200ps 200ps 200ps
setnodecapacitance out[7:0] +20fF
departure out[7:0] _WAVE_ ^ 1.8n 1.8n 1.8n 1.8n
setnodecapacitance status +20fF
departure status _WAVE_ ^ 1.8n 1.8n 1.8n 1.8n
setpathfilter -same_path -similar_path -node_suffix [#]
idealclocks yes
timingverify -check setup
setdelaypathformat out_delay delta_delay load_cap fanout out_rise_fall out_node device cell
showpossibility 1 5
# done
# done
findmincycletime
# done
# done
shownodematches * > /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/alu8.tmp_in
system sed -e 's/^ /showdelays/' -e 's/^Found/#/' /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/alu8.tmp_in > /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/alu8.tmp_out
include /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/alu8.tmp_out
system rm -f /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/alu8.tmp_in
system rm -f /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/alu8.tmp_out
findslownodes -limit 0.6ns > /volume/mmi/src/sue4.3/doc/dpc_build_tutorial/dev/alu8.slow_nodes

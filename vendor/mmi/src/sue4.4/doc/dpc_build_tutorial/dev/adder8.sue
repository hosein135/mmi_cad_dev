proc ICON_adder8 args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {pad {}}}
  icon_term -type input -origin {-40 90} -name cin
  icon_term -type output -origin {50 -60} -name cout
  icon_term -type input -origin {-40 -70} -name {a[7:0]}
  icon_term -type output -origin {50 0} -name {sum[7:0]}
  icon_term -type input -origin {-40 60} -name {b[7:0]}
  icon_property -origin {-110 180} -type user -name name
  icon_property -origin {-110 200} -type user -name M
  icon_property -origin {-110 220} -type user -name pad
  icon_line -40 -110 -40 -20 -10 0 -40 20 -40 120 50 80 50 -80 -40 -110
  icon_property -origin {10 0} -anchor center -rotate 1 -label {8-bit CLA}
  icon_property -origin {40 -40} -anchor e -rotate 1 -label cout
  icon_property -origin {-30 90} -label cin
  icon_property -origin {-30 60} -label b
  icon_property -origin {-30 -70} -label a
  icon_property -origin {40 30} -anchor e -rotate 1 -label sum
}


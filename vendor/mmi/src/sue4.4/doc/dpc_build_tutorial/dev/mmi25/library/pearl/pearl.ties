MMI_NAND4A in2 {in0 vdd} {in1 vdd} {in3 vdd}
MMI_NAND4A in3 {in0 vdd} {in1 vdd} {in2 vdd}

MMI_NAND4B = MMI_NAND4A
MMI_NAND4C = MMI_NAND4A

MMI_AND4B = MMI_NAND4A
MMI_AND4C = MMI_NAND4A


# NOR2, OR2

# This file is used by pearl_convert
# Specifies how to ties off inputs

# NAND2, AND2
MMI_NAND2A in0 {in1 vdd}
MMI_NAND2A in1 {in0 vdd}

MMI_NAND2B = MMI_NAND2A
MMI_NAND2C = MMI_NAND2A
MMI_NAND2D = MMI_NAND2A

MMI_AND2B = MMI_NAND2A
MMI_AND2C = MMI_NAND2A


# NAND3, AND3
MMI_NAND3A in0 {in1 vdd} {in2 vdd}
MMI_NAND3A in1 {in0 vdd} {in2 vdd}
MMI_NAND3A in2 {in0 vdd} {in1 vdd}

MMI_NAND3B = MMI_NAND3A
MMI_NAND3C = MMI_NAND3A

MMI_AND3B = MMI_NAND3A
MMI_AND3C = MMI_NAND3A


# NAND4, AND4

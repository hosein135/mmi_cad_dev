MMI_INAND2A in1 {in0 vdd}

MMI_INAND2B = MMI_INAND2A
MMI_INAND2C = MMI_INAND2A


# XOR2
MMI_XOR2A {in0 ^ -> out ^} {in1 gnd}
MMI_XOR2A {in0 v -> out v} {in1 gnd}
MMI_XOR2A {in0 v -> out ^} {in1 vdd}
MMI_XOR2A {in0 ^ -> out v} {in1 vdd}
MMI_XOR2A {in1 ^ -> out ^} {in0 gnd}
MMI_XOR2A {in1 v -> out v} {in0 gnd}
MMI_XOR2A {in1 v -> out ^} {in0 vdd}
MMI_XOR2A {in1 ^ -> out v} {in0 vdd}

MMI_XOR2B = MMI_XOR2A
MMI_XOR2C = MMI_XOR2A


# XNOR2
MMI_XNOR2A {in0 ^ -> out ^} {in1 vdd}
MMI_XNOR2A {in0 v -> out v} {in1 vdd}
MMI_XNOR2A {in0 v -> out ^} {in1 gnd}
MMI_XNOR2A {in0 ^ -> out v} {in1 gnd}
MMI_XNOR2A {in1 ^ -> out ^} {in0 vdd}
MMI_XNOR2A {in1 v -> out v} {in0 vdd}
MMI_XNOR2A {in1 v -> out ^} {in0 gnd}
MMI_XNOR2A {in1 ^ -> out v} {in0 gnd}

MMI_XNOR2B = MMI_XNOR2A
MMI_XNOR2C = MMI_XNOR2A


# MUX2
MMI_MUX2A in1 {in0 gnd} {sel vdd}
MMI_MUX2A in0 {in1 gnd} {sel gnd}
MMI_MUX2A {sel ^ -> out v} {in0 vdd} {in1 gnd}
MMI_MUX2A {sel v -> out v} {in0 gnd} {in1 vdd}
MMI_MUX2A {sel ^ -> out ^} {in0 gnd} {in1 vdd}
MMI_MUX2A {sel v -> out ^} {in0 vdd} {in1 gnd}


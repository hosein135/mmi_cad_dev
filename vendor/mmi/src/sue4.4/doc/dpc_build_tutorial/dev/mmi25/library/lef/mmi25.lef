	CAPACITANCE CPERSQDIST .000320 ;
END M3
LAYER VIA3
	TYPE CUT ;
END VIA3
LAYER M4
	TYPE ROUTING ;
	PITCH 1.0 ;
	WIDTH 0.6 ;

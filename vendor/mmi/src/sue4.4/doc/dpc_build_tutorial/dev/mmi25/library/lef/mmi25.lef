	CAPACITANCE CPERSQDIST .000353 ;
END M2
LAYER VIA2
	TYPE CUT ;
END VIA2
LAYER M3
	TYPE ROUTING ;
	PITCH 1.0 ;
	WIDTH 0.6 ;
	SPACING 0.4 ;
	DIRECTION HORIZONTAL ;

	LAYER M4 ; DIRECTION VERTICAL ; OVERHANG 0.1 ; METALOVERHANG 0.1 ;
	LAYER VIA3 ; RECT  -0.18 -0.18 0.18 0.18 ; SPACING 1.00 BY 1.00 ;
END VIAGEN34
VIARULE VIAGEN45 GENERATE
	LAYER M4 ; DIRECTION VERTICAL ; OVERHANG 0.09 ; METALOVERHANG 0.09 ;
	LAYER M5 ; DIRECTION HORIZONTAL ; OVERHANG 0.09 ; METALOVERHANG 0.09 ;
	LAYER VIA4 ; RECT  -0.18 -0.18 0.18 0.18 ; SPACING 1.00 BY 1.00 ;
END VIAGEN45

	CAPACITANCE CPERSQDIST .000296 ;
END M4
LAYER VIA4
	TYPE CUT ;
END VIA4
LAYER M5
	TYPE ROUTING ;
	PITCH 1.0 ;
	WIDTH 0.54 ;
	SPACING 0.46 ;
	DIRECTION HORIZONTAL ;
	RESISTANCE RPERSQ 0.05 ;
	CAPACITANCE CPERSQDIST .000296 ;
END M5
VIA VIA12 DEFAULT
	RESISTANCE 1.21 ;
	LAYER M1 ; RECT -0.28 -0.28 0.28 0.28 ;
	LAYER VIA1 ; RECT -0.18 -0.18 0.18 0.18 ;
	LAYER M2 ; RECT -0.28 -0.28 0.28 0.28 ;
END VIA12
VIA VIA23 DEFAULT
	RESISTANCE 1.07 ;
	LAYER M2 ; RECT -0.28 -0.28 0.28 0.28 ;
	LAYER VIA2 ; RECT -0.18 -0.18 0.18 0.18 ;
	LAYER M3 ; RECT -0.28 -0.28 0.28 0.28 ;
END VIA23
VIA VIA34 DEFAULT
	RESISTANCE 1.19 ;

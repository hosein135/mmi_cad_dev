NAMESCASESENSITIVE ON ;

UNITS
DATABASE MICRONS 1000 ;
END UNITS

LAYER NWELL
	TYPE MASTERSLICE ;
END NWELL
LAYER PP
	TYPE MASTERSLICE ;
END PP
LAYER NP
	TYPE MASTERSLICE ;
END NP
LAYER OD
	TYPE MASTERSLICE ;
END OD
LAYER POLY
	TYPE MASTERSLICE ;
END POLY
LAYER CO
	TYPE CUT ;
END CO
LAYER M1
	TYPE ROUTING ;
	PITCH 1.0 ;
	WIDTH 0.6 ;
	SPACING 0.32 ;
	DIRECTION HORIZONTAL ;
	RESISTANCE RPERSQ 0.09 ;
	CAPACITANCE CPERSQDIST .000389 ;
END M1
LAYER VIA1 
	TYPE CUT ;
END VIA1
LAYER M2
	TYPE ROUTING ;
	PITCH 1.0 ;
	WIDTH 0.6 ;
	SPACING 0.4 ;

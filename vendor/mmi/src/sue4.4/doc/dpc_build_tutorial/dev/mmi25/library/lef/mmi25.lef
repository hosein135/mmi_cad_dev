	LAYER M4 ; DIRECTION VERTICAL ; WIDTH 0.6 TO 0.9 ;
	VIA VIA34 ;
END ONEVIA34
VIARULE ONEVIA45
	LAYER M4 ; DIRECTION VERTICAL ; WIDTH 0.6 TO 0.9 ;
	LAYER M5 ; DIRECTION HORIZONTAL ; WIDTH 0.6 TO 0.9 ;
	VIA VIA45 ;
END ONEVIA45
VIARULE VIAGEN12 GENERATE
	LAYER M1 ; DIRECTION HORIZONTAL ; OVERHANG 0.1 ; METALOVERHANG 0.1 ;
	LAYER M2 ; DIRECTION VERTICAL ; OVERHANG 0.1 ; METALOVERHANG 0.1 ;
	LAYER VIA1 ; RECT  -0.18 -0.18 0.18 0.18 ; SPACING 1.00 BY 1.00 ;
END VIAGEN12
VIARULE VIAGEN23 GENERATE
	LAYER M2 ; DIRECTION VERTICAL ; OVERHANG 0.1 ; METALOVERHANG 0.1 ;

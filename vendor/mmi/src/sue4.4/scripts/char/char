	    }

	    set repeat 1
	    puts "  hold time less than [pp_number [expr ($pass_value * [parse_pp_number 1$TIMES(units)])]]s.  Extending range downwards."
	
          } else {
	    if {[expr $pass - $fail] > [parse_pp_number $TIMES(setup_tol)]} {
	      # not done
	      set repeat 1
            } else {
              lappend VIOS($name,$type,$clk_var,$in_dir,values) $pass
              if {$x == 0} {
                lappend VIOS($name,$type,$clk_var,$in_dir,index_1) $clk_slew
              }
              if {$y == 0} {
                lappend VIOS($name,$type,$clk_var,$in_dir,index_2) $var_slew

	          set pass_pos $count
	        }
	      }
  
	      # puts stderr "$hold_input ==> $hold_time $value"
	    }
	
	    incr count
          }

          set tol [max $tol [expr $pass - $fail]]

          if {$pass > 1.0e6} {
	    # never passed, extend range upwards

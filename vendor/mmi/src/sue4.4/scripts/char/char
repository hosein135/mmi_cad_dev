# Build the spice input deck from the data in the global vars.

proc assemble_spicedeck {cell} {

  global TIMES PWL DATA MEASURE VARS CAP MULTIPLIER

  set filename $cell$DATA(spice_file)

  if {[catch "open $filename w" FILE_ID]} {
    # error
    puts stderr "Aborting, $FILE_ID"
    exit 1
  } 

  spice_puts $FILE_ID "*** Characterization deck for cell $cell ***\n"

  spice_puts $FILE_ID ".INCLUDE '$DATA(header_file)'\n"

  spice_puts $FILE_ID ".TEMP $DATA(TEMP)"
  spice_puts $FILE_ID ".TRAN $TIMES(tran_step) [expr $TIMES(current) + $TIMES(step)]$TIMES(units)\n"

  spice_puts $FILE_ID ".PARAM vddp=$DATA(vdd)"
  spice_puts $FILE_ID "VDD vdd 0 DC vddp\n"

  spice_puts $FILE_ID ".INCLUDE '$DATA(driver_file)'\n"

  spice_puts $FILE_ID ".INCLUDE '$DATA(filename)'\n"

  # instantiate cell
  set ios [parse_spice_cell $cell $DATA(filename)]
  regsub -all {\{|\}} $ios "" ios

  spice_puts $FILE_ID "X_DOT $ios $cell\n"

  # instantiate input buffers
  spice_puts $FILE_ID "* Input buffers *"
  foreach input [lsort [array names PWL]] {
    if {[info exists MULTIPLIER($input)]} {
      # add a spice multipler to the input driver
      set M " M=$MULTIPLIER($input)"
    } else {
      set M ""
    }

    spice_puts $FILE_ID "XD_$input ${input}! ${input}_ driver$M"
    # for measuring capacitance
    spice_puts $FILE_ID "VD_$input ${input}_ ${input} 0V"
  }
  spice_puts $FILE_ID ""

  # add voltage sources
  spice_puts $FILE_ID "* Input stimulus *"
  set index 0
  foreach input [array names PWL] {
    spice_puts $FILE_ID \
	"VD_[incr index] ${input}! gnd PWL [join $PWL($input) {, }]"
  }

  # add load capacitances on inputs and outputs
  spice_puts $FILE_ID ""
  spice_puts $FILE_ID "* Load capacitances *"
  set index 0
  foreach var [lsort [array names VARS]] {
    if {![info exists CAP($var)]} {
      set CAP($var) 1.0
    }
    if {$VARS($var) == "input"} {
      # place capacitance on driver side of current measuring voltage source
      set name ${var}_
    } else {
      set name $var
    }

    if {[info exists CAP($var)]} {
      spice_puts $FILE_ID \
	  "CL_[incr index] $name gnd '$CAP($var)*$DATA(nominal_cap)'"
    }
  }

  # add measurement statements
  spice_puts $FILE_ID ""
  foreach line [lsort [array names MEASURE]] {
    regsub -all {\{|\}} $MEASURE($line) "" measure
    spice_puts $FILE_ID $measure
  }

  spice_puts $FILE_ID "\n.GLOBAL gnd vdd\n"

  spice_puts $FILE_ID ".END"

  # close the file
  close $FILE_ID
}  


# puts but adds spice continuations

proc spice_puts {FILE_ID line} {

  while {[string length $line] > 70} {

    set pos [string last " " [string range $line 0 70]]
    if {$pos == -1} {
      set pos [string first " " $line]
    }
  
    puts $FILE_ID [string range $line 0 $pos]
    set line "+[string range $line $pos end]"
  }
  puts $FILE_ID $line
}


# puts but breaks long lines

proc verilog_puts {FILE_ID line} {

  while {[string length $line] > 70} {

    set pos [string last " " [string range $line 0 70]]
    if {$pos == -1} {
      set pos [string first " " $line]
    }
  
    puts $FILE_ID [string range $line 0 $pos]
    set line "\t[string range $line $pos end]"
  }
  puts $FILE_ID $line
}


proc parse_spice_cell {cell filename} {

  if {[catch "open $filename r" FILE_ID]} {
    # error
    puts stderr "Aborting, $FILE_ID"
    exit 1
  } 

  while {[gets $FILE_ID line] >= 0} {
    # make everything uppercase
    set line [string toupper $line]

    if {[string first .SUBCKT $line] != -1} {
      if {[lindex $line 1] != [string toupper $cell]} {
	# wrong subcircuit
	continue
      }

      set ios [lrange $line 2 end]
      # look for continuation lines
      while {[gets $FILE_ID line] >= 0} {
	set line [string trim $line]
	if {[string index $line 0] == "+"} {
	  set ios [concat $ios [string trim [string range $line 1 end]]]
	} else {
	  break
	}
      }

      # close the file
      close $FILE_ID

      # successful
      return $ios
    }      
  }
  
  # close the file
  close $FILE_ID

  puts stderr "Aborting, Can't find subckt $cell in file $filename."
  exit 1
}  



# computes function (assumed linear) between load capacitance
# and rise/fall time.

proc compute_rise_vs_capacitance {results1 results2} {

  global VARS SLOPE Y_INT DATA TIMES

  # compute the load capacitance scale factors
  foreach var [array names VARS] {
    set slope_f 0
    set slope_r 0

    set value1 [get_assoc ${var}^! $results1]
    set value2 [get_assoc ${var}^! $results2]
    if {$value1 != "" && $value2 != ""} {
      if {$value1 < 0 || $value2 < 0} {
	# failed
	return failed
      }

      set slope_r [expr ($value2 - $value1) / $DATA(nominal_cap)]
      set y_int_r [expr $value1 - $slope_r * $DATA(nominal_cap)]

      set SLOPE($var) $slope_r
      set Y_INT($var) $y_int_r
    }

    set value1 [get_assoc ${var}v! $results1]
    set value2 [get_assoc ${var}v! $results2]
    if {$value1 != "" && $value2 != ""} {
      if {$value1 < 0 || $value2 < 0} {
	# failed
	return failed
      }

      set slope_f [expr ($value2 - $value1) / $DATA(nominal_cap)]
      set y_int_f [expr $value1 - $slope_f * $DATA(nominal_cap)]

      set SLOPE($var) $slope_f
      set Y_INT($var) $y_int_f
    }

    if {$slope_f != 0 && $slope_r != 0} {
      # average rise and fall slopes
      set SLOPE($var) [expr ($slope_f + $slope_r) / 2.0]
      set Y_INT($var) [expr ($y_int_f + $y_int_r) / 2.0]
    }
  }

  global DEBUG
  if {[use_first DEBUG] == 1} {
    parray SLOPE
    parray Y_INT
  }

  return ""
}


proc set_load_capacitance {var rise} {

  global CAP SLOPE Y_INT DATA VARS

  if {![info exists Y_INT($var)]} {
    return 0
  }

  set CAP($var) [max 0 [expr ($rise - $Y_INT($var)) / \
			    $SLOPE($var) / $DATA(nominal_cap)]]

  if {$CAP($var) == 0} {
    if {$rise < $Y_INT($var)} {
      puts stderr "WARNING, can't drive net \"$var\" as fast as desired [pp_number $rise]s, best possible is [pp_number $Y_INT($var)]s."
      if {$VARS($var) == "input"} {
	puts stderr "Probably need larger driver cell or use the \"driver\" command."
      }
    } elseif {$SLOPE($var) < 0} {
      puts stderr "Aborting, capacitance vs. delay slope ($Y_INT($var)) is negative"
      exit 1
    } else {
      puts stderr "Aborting, error $rise $Y_INT($var) $SLOPE($var) $DATA(nominal_cap)"
      exit 1
    }
  }

  return $CAP($var)
}


# run's spice using the "spice" script from mmi.  Exits on error.

proc run_spice {cell msg} {

  global DATA

  set spicefile $cell$DATA(spice_file)

  puts "\[[clock format [clock seconds] -format %H:%M:%S]\] Running $DATA(simulator) on $spicefile $msg"

  set info "[file root $cell$DATA(spice_file)].info"
### ???
  catch {exec rm -f $output}

  if {$DATA(simulator) == "spice"} {
    exec spice $spicefile > $info
    # figure out if spice exited successfully
    catch {exec grep info $info} result

    set output "[file root $spicefile].out"
    if {[string first info $result] == -1} {
      # must be an error
      puts stderr "Spice failed, see output file $output for more information."
      
      puts stderr [exec cat $info]

      puts stderr "Aborting Characterization."
      exit 1
    }

    global DEBUG
    if {[use_first DEBUG] == 1} {
      set clock [clock seconds]
      catch "file copy -force -- $output $output.$clock"
      set tr "[file root $spicefile].tr0"
      catch "file copy -force -- $tr $tr.$clock"
    }

  } elseif {$DATA(simulator) == "adm"} {
    exec adm_go $spicefile > $info

    # figure out if adm exited successfully
    catch {exec grep aborted $info} result

    if {[string first aborted $result] != -1} {
      # must be an error
      set output "[file root $spicefile].info"
      puts stderr "Spice failed, see output file $output for more information."
      
      puts stderr [exec cat $info]

      puts stderr "Aborting Characterization."
      exit 1
    }
  } else {
    puts stderr "Aborting, unknown simulator $DATA(simulator)"
    exit 1
  }

  # everything is O.K.
  return [parse_mt0_file [file root $spicefile]]
}


# Alert user to error in control file

proc ctl_error {msg} {

  global LINE

  puts stderr "Aborting, $msg"
  puts stderr "in line \#$LINE(line_no): \"$LINE(line)\"."

  exit 1
}


proc parse_mt0_file {filename} {

  global DATA

  if {$DATA(simulator) == "spice"} {
    set filename "$filename.mt0"
  } else {
    set filename "$filename.mt"
  }

  if {[catch "open $filename r" FILE_ID]} {
    # error
    puts stderr "Aborting, $FILE_ID"
    exit 1
  } 

  # first read two bogus lines
  gets $FILE_ID line
  gets $FILE_ID line

  # now read parameters until we find a # character
  set params ""
  while {[gets $FILE_ID line] >= 0} {
    set params [concat $params [string trimright $line \#]]

    if {[string first \# $line] != -1} {
      # this marks the end of the parameters
      break
    }
  }

  set values ""
  while {[gets $FILE_ID line] >= 0} {
    set values [concat $values $line]
  }
  
  # close the file
  close $FILE_ID

  set results ""
  foreach param $params {
    if {$values == ""} {
      puts stderr "Aborting, bad syntax in mt0 file $filename."
      exit 1
    }

    set value [lindex $values 0]
    if {$value <= 0} {
      # check if this is measuring current which can be negative
      if {[string first _c^ $param] == -1 && [string first _cv $param] == -1 \
	      && ![regexp {[0-9]+\!$} $param] \
	      && ![regexp {[\v\^][0-9]+$} $param]} {
	puts stderr "ERROR, parameter $param not found ($value)."
      }
    }

    # translate param if necessary
    if {[info exists DATA(xlate,$param)]} {
      set param $DATA(xlate,$param)
    }

    lappend results "$param $value"
    set values [lrange $values 1 end]
  }

  return $results
}  


# sets the nth variable name to be the nth value

proc setl {names values} {
  set i 0
  foreach name $names {
    uplevel [list set $name [lindex $values $i]]
    incr i
  }
  # returns number of variables set
  return $i
}

# returns maximum of two numbers

proc max {a b} {

  if {$a > $b} {
    return $a

  } else {
    return $b
  }
}

# returns minimum of two numbers

proc min {a b} {

  if {$a < $b} {
    return $a

  } else {
    return $b
  }
}


# Gets the value out of an associative list keyed by arg.  If the optional
# index is given, will get the "index" value out of the list which is
# used for getting the default value.
# NOTE, this is case insensitive

proc get_assoc {name list {nth 1}} {

  set match ""
  regsub -all {\[|\]|\^|\!} $name \\\\& name
  regexp -nocase "\{$name .*" $list match
  return [lindex [lindex $match 0] $nth]
}


proc put_assoc {value name list {index 1}} {

  set new_list ""
  foreach assoc $list {
    if {[lindex $assoc 0] == $name} {
      lappend new_list [lreplace $assoc $index $index $value]
    } else {
      lappend new_list $assoc
    }
  }
  return $new_list
}


# Pretty prints a number using the spice metric suffixes

proc pp_number {num {format %g%s}} {

  set num [parse_pp_number $num]

  if {$num == 0} {
    return 0
  }
  set suffixes {G M K "" m u n p f a}
  set logscale [expr floor(log10(abs($num))/3.0)]
  set mantissa [expr $num/pow(10,3.0*$logscale)]
  set exp [lindex $suffixes [expr round(3 - $logscale)]]
  return [format $format $mantissa $exp]
}


# Parses a string with spice notation into a number.  Trailing units
# are ignored.  Examples: 3.2e-4, 32.4fF, 23 Ohms

proc parse_pp_number {string} {
  regexp -indices -nocase {[a-d]|[f-z]} $string index
  
  if {[info exists index] == 0} {
    return $string
  }

  set mantissa [string range $string 0 [expr [lindex $index 0]-1]]

  set suffixes "GMK munpfa"
  set suffix [string range $string [lindex $index 0] [lindex $index 1]]
  set pos [string first $suffix $suffixes]
  if {$pos == -1} {
    return $mantissa
  }
  set num [expr $mantissa * pow(10,3.0*(3-$pos))]
  return $num
}


# returns a list of all signal names on a bus
# Only understands foo, foo[num], foo[msb:lsb]

proc bus_expand {name} {

  set name_list [split $name "\[:\]"]

  if {[llength $name_list] < 4} {
    # not a bus
    return $name
  }

  setl {root msb lsb} $name_list
  if {$lsb > $msb} {
    # bad form
    return $name
  }

  set list ""
  for {set i $lsb} {$i <= $msb} {incr i} {
    if {$i > 256} {
      # error
      break
    }

    # too bad lappend doesn't work here
    set list [concat $list $root\[$i\]]
  }

  return $list
}


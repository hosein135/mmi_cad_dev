	    set fail_value [lindex $DATA(hold,$name) 0]
	    set dt [expr $fail_value - [lindex $DATA(hold,$name) 1]]
	    set DATA(hold,$name) ""
	
	    for {set i 0} {$i < $points} {incr i} {
	      lappend DATA(hold,$name) \

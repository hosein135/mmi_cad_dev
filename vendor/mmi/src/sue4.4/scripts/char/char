	    measure_delay $name$dir$count $clk_var $clk_dir $name $dir $TIMES(current)

	    # measure q value
	    measure_value $name$dir$count! $out_var [expr $TIMES(current) + $TIMES(step)]

            measure_rise_fall $name$dir${count}_ $clk_var $clk_dir $TIMES(current)

            measure_rise_fall $name$dir${count}% $name $dir $TIMES(current)

	    set TIMES(current) [expr $TIMES(current) + $TIMES(step) + \
				    $TIMES(rise_time)]

	    # restore ourselves for another go (adds another cycle)
	    hspice_stim $cell [list $output] $stims 0

	    set TIMES(current) [expr $TIMES(current) + $TIMES(step) + \
				    $TIMES(rise_time)]

	    if {$dup} {
	      set dup 0
	    } else {
	      incr count
	    }
          }

          # create a spice deck 
          assemble_spicedeck $cell
    
          set results [run_spice $cell "for hold measurement of $hold_input ..."]
#    puts stderr $results

          set count 0
          set pass 1.0e9

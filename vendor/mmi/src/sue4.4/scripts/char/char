# Written by Lee Tavrow, 1998

# Characterize a cell in spice based on input stimulus is <cell>.ctl file.
# Also works with ADM but doesn't compute input capactiances because
# ADM doesn't support .meas INTEG function.

#################### Overridden by char.setup ######################

# Units for numbers without units (eventually all numbers will
# have units).
set TIMES(units) ns

# Rise/fall times of input pulses.  Note that these pulses are always
# buffered by the driver cell before reaching the inputs of the
# device under test so you should never have to change this.
set TIMES(rise_time) 0.2

# static signals will be setup this soon before dynamic signals
set TIMES(setup_time) 2.0

# Cycle time of simulation
set TIMES(step) 5.0

# Makes an nxm matrix for the table driven lookup of delays based on
# the following inputs.  Note that the output slopes are desired and
# converted to capacitances that give approximately the correct slope.
set TIMES(input_slopes) "200ps 400ps"
set TIMES(clock_slopes) "300ps"
set TIMES(output_slew) 400ps
set DATA(output_loads) "0.25 0.5 1.0"

# Used for measuring the rise/fall slopes.  Setup up for 10-90 
# or 20-80, etc.
set TIMES(slope_low_percent) 0.1
set TIMES(slope_high_percent) 0.9

# These are the initial guesses for the setup times.  If none of these
# values is large enough it will expand.  Note that you need to
# have at least three values in this list and more is better.
set TIMES(setup) "0.6 0.5 0.4 0.3 0.2 0.1"
set TIMES(hold) "0.6 0.5 0.4 0.3 0.2 0.1"

# This is the input slope used when calculating the setup times.
set TIMES(setup_slope) 300ps

# The program will continue to iterate until the setup time is found
# to within this tolerance.
#set TIMES(setup_tol) 25ps
set TIMES(setup_tol) 200ps

# Capacitance (and 2x this number) placed on inputs and outputs to compute
# relation between capacitance and slope.  This ratio is then used to
# automatically scale loads for desired slopes.
set DATA(nominal_cap) 100fF

# transient step value used in the ".TRAN" statement.
set TIMES(tran_step) 10p

# This is the driver cell spice netlist used to drive the inputs
# of the device under test
set DATA(driver_file) /home/tavrow/char/driver.sp

# Specifies spice header, voltage, and temperature (C) for all
# corners of interest.  The desired corner is specified from the
# command line.
set DATA(corner,tt) "/home/tavrow/char/header.tt 3.0V 105"
set DATA(corner,ss) "/home/tavrow/char/header.ss 3.0V 105"
set DATA(corner,ff) "/home/tavrow/char/header.ff 3.45V 25"

# Synopsys header information added to output file.
set DATA(synopsys_header_file) /home/tavrow/char/synopsys.header

# This is the name of the spice file that gets created to be run
# through spice/adm to actually measure parameters
set DATA(spice_file) tmp.sp

# Choose your simulator.  Currently either spice or adm.
set DATA(simulator) spice
#set DATA(simulator) adm

######################################################################

if {[catch "source char.setup"]} {
  puts stderr "Can't find file \"char.setup\", using defaults"
} else {
  puts "Using setup file \"char.setup\""
}

# set the starting time of the simulation
set TIMES(current) 0.0

# Used to convert 1's and 0's into voltages
set DATA(0) 0V
set DATA(1) vddp

# used for .meas statements in hspice
set DATA(^) "rise=1"
set DATA(v) "fall=1"

# for translating long names
set DATA(xlate) 0

# user definable offset for delays
set DATA(user,offset) 0


# main procedure

proc characterize {args} {

  global DATA CAP VARS TIMES FUNCTION OUTPUT DELAYS CAPS

  # fix up these numbers
  set DATA(nominal_cap) [parse_pp_number $DATA(nominal_cap)]

  setl {DATA(corner) DATA(filename) cell ctlfile} [lindex $args 0]

  if {![info exists DATA(corner,$DATA(corner))]} {
    puts stderr "Aborting, corner $DATA(corner) not defined."
    exit 1
  }
  setl {DATA(header_file) DATA(vdd) DATA(TEMP)} $DATA(corner,$DATA(corner))

  if {$cell == ""} {
    set cell [file rootname [file tail $DATA(filename)]]
  }

  if {$ctlfile == ""} {
      set ctlfile "$cell.ctl"
  }

  puts "Characterization cell \"$cell\" at corner $DATA(corner) ..."

  parse_ctl_file $cell $ctlfile
  puts "done."

  # trying this three times
  for {set i 0} {$i < 3} {incr i} {

    # first create a spice deck with nominal load capacitances
    assemble_spicedeck $cell

    set results1 [run_spice $cell "with nominal load capacitances ([pp_number $DATA(nominal_cap)]F) ..."]

    # save the input capacitances
    foreach var [array names VARS] {
      if {$VARS($var) == "input" || $VARS($var) == "inout"} {
        set CAPS($var,rise) [get_assoc ${var}_c^ $results1]
        set CAPS($var,fall) [get_assoc ${var}_cv $results1]
      }
    } 

    # now 2x load capacitances
    foreach var [array names CAP] {
      set CAP($var) 2.0
    }

    assemble_spicedeck $cell

    set results2 \
	[run_spice $cell "with 2x nominal load capacitances ..."]

    set return [compute_rise_vs_capacitance $results1 $results2]

    if {$return == "failed"} {
      puts "Trying again to compute capacitance vs. rise_times"
      set DATA(nominal_cap) [expr $DATA(nominal_cap) / 2.0]
      # back to 1x load capacitances
      foreach var [array names CAP] {
	set CAP($var) 1.0
      }

    } else {
      puts "Computed capacitance vs. rise_times."
      break
    }
  }

  if {$return == "failed"} {
    puts "Aborting, failed 3 attempts."
    exit
  }

  # now run the real characterization
  # sweep the input capacitance for each output capacitance
  set count 0
  set total [expr [llength $TIMES(input_slopes)] * \
		 [llength $DATA(output_loads)]]

  set x 0
  set y 0

  # sweep input slopes
  foreach input_slope $TIMES(input_slopes) {
    foreach var [array names VARS] {
      if {$VARS($var) == "input"} {
	set_load_capacitance $var [parse_pp_number $input_slope]
      }
    }

    # sweep output capacitances
    foreach output_load $DATA(output_loads) {
      foreach var [array names VARS] {
	if {$VARS($var) == "output"} {
	  set_load_capacitance $var [parse_pp_number $TIMES(output_slew)]
          set CAP($var) [expr $CAP($var) * $output_load]
	}
      }

#      parray CAP

      assemble_spicedeck $cell
      set results [run_spice $cell "characterization ([incr count]/$total) ..."]
      
#      puts stderr $results

      if {$x == 0} {
	foreach var [array names VARS] {
	  if {$VARS($var) != "output"} {
	    continue
	  }
	  lappend DELAYS(${var},index_1) [expr $CAP($var) * $DATA(nominal_cap)]
	}
      }

      foreach var [array names VARS] {
	if {$VARS($var) != "output"} {
	  continue
	}
	foreach invar [array names VARS] {
	  if {$VARS($invar) != "input"} {
	    continue
	  }

          # check what paths exist, and decide if it's a clk/enable pin
          set rise_path ""
          set fall_path ""
          foreach indir "^ v" {
            foreach outdir "^ v" {
              set value [get_assoc $invar$indir$var$outdir $results]
              if {$value != ""} {
                if {$indir == "^"} {
                   set rise_path "true"
                } else {
                   set fall_path "true"
                }
              }
            }
          }
          if {$rise_path == "true" && $fall_path == "" &&
              ![info exists DATA(preset,$invar)] &&
              ![info exists DATA(clear,$invar)]} {
             set DATA(rising_edge) $invar
          }
          if {$rise_path == "" && $fall_path == "true" &&
              ![info exists DATA(preset,$invar)] &&
              ![info exists DATA(clear,$invar)]} {
             set DATA(falling_edge) $invar
          }

	  if {[info exists DATA(rising_edge)] && $DATA(rising_edge) == $invar} {
	    # for positive edge triggered stuff
	    set groups \
		{{rising_edge ^ ^ rise} {rising_edge ^ v fall}}
	  } elseif {[info exists DATA(falling_edge)] && $DATA(falling_edge) == $invar}  {
	    # for negative edge triggered stuff
	    set groups \
		{{falling_edge v ^ rise} {falling_edge v v fall}}
	  } else {
	    set groups \
		{{positive_unate ^ ^ rise} {positive_unate v v fall} \
		     {negative_unate v ^ rise} {negative_unate ^ v fall}}
	  }

	  foreach group $groups {
	    setl {unate input_dir output_dir dir} $group

	    set value [get_assoc $invar$input_dir$var$output_dir $results]
	    if {$value != ""} {
	      # save the value
	      lappend DELAYS(${var},${unate},$invar,$dir,values) $value
	      lappend DELAYS(${var},${unate},$invar,$dir,tr_values) \
		  [get_assoc $invar$input_dir$var$output_dir! $results]
	    }
	  }
	}
      }

      incr y
    }

    # get the actual input slopes.
    # only have to do this for each row.
    foreach var [array names VARS] {
      if {$VARS($var) != "output"} {
	continue
      }
      foreach invar [array names VARS] {
	if {$VARS($invar) != "input"} {
	  continue
	}

	if {[info exists DATA(rising_edge)] && $DATA(rising_edge) == $invar} {
	  # for positive edge triggered stuff
	  set groups \
	      {{rising_edge ^ ^ rise} {rising_edge ^ v fall}}
	} elseif {[info exists DATA(falling_edge)] && $DATA(falling_edge) == $invar}  {
	  # for negative edge triggered stuff
	  set groups \
	      {{falling_edge v ^ rise} {falling_edge v v fall}}
	} else {
	  set groups \
	      {{positive_unate ^ ^ rise} {positive_unate v v fall} \
		   {negative_unate v ^ rise} {negative_unate ^ v fall}}
	}

	foreach group $groups {
	  setl {unate input_dir output_dir dir} $group

	  set value [get_assoc $invar$input_dir!$var$output_dir $results]
	  if {$value != ""} {
	    lappend DELAYS(${var},${unate},$invar,$dir,index_2) $value
	  }
	}
      }
    }

    incr x
  }

  # do the setup characterization
  setup_char $cell

  hold_char $cell

  make_synopsys_model $cell

  make_verilog_model $cell

  puts "Characterization of cell \"$cell\" completed."
}

# creates a synopsys model for the cell if a functional description is
# given and writes to <cell>.syn

proc make_synopsys_model {cell} {

  global FUNCTION VARS DATA TIMES DELAYS CAPS VIOS OUTPUT 

  set filename $cell.syn

  # open the synopsys output file
  if {[catch "open $filename w" FILE_ID]} {
    # error
    puts stderr "Aborting, $FILE_ID"
    exit 1
  } 

  set size1 [llength $DATA(output_loads)]
  set size2 [llength $TIMES(input_slopes)]
  set size3 [llength $TIMES(clock_slopes)]

  # write the synopsys header
  puts $FILE_ID "library ($cell) \{"
  puts $FILE_ID "date : \"[clock format [clock seconds]]\";"
  puts $FILE_ID "comment : \"Built from MMI char.tcl\";"
  puts $FILE_ID "delay_model : table_lookup;"
  puts $FILE_ID "lu_table_template(li${size1}X${size2}) \{"
  puts $FILE_ID "\tvariable_1 : total_output_net_capacitance;"
  puts $FILE_ID "\tvariable_2 : input_net_transition;"

  set tmp ""
  for {set i 0} {$i < $size1} {incr i} {
    lappend tmp $i
  }
  puts $FILE_ID "\tindex_1 (\"[join $tmp {, }]\");"

  set tmp ""
  for {set i 0} {$i < $size2} {incr i} {
    lappend tmp $i
  }
  puts $FILE_ID "\tindex_2 (\"[join $tmp {, }]\");"
  puts $FILE_ID "\}"

  puts $FILE_ID "lu_table_template(cr${size3}X${size2}) \{"
  puts $FILE_ID "\tvariable_1 : related_pin_transition;"
  puts $FILE_ID "\tvariable_2 : constrained_pin_transition;"
 
  set tmp ""
  for {set i 0} {$i < $size3} {incr i} {
    lappend tmp $i
  }
  puts $FILE_ID "\tindex_1 (\"[join $tmp {, }]\");"
 
  set tmp ""
  for {set i 0} {$i < $size2} {incr i} {
    lappend tmp $i
  }
  puts $FILE_ID "\tindex_2 (\"[join $tmp {, }]\");"
  puts $FILE_ID "\}"


#  lu_table_template(cr2X2){
#    variable_1 : related_pin_transition;
#    variable_2 : constrained_pin_transition;
#    index_1 ("0, 1");
#    index_2 ("0, 1");
#  }

  # puts in synopsys header info
  puts $FILE_ID "nom_process                 : 1.0;"
  puts $FILE_ID "nom_temperature             : [string trim $DATA(TEMP) Cc];"
  puts $FILE_ID "nom_voltage                 : [string trim $DATA(vdd) Vv];"
  puts $FILE_ID "pulling_resistance_unit     : \"1kohm\";"
  puts $FILE_ID "time_unit                   : \"1ns\";"
  puts $FILE_ID "voltage_unit                : \"1V\";"
  puts $FILE_ID "current_unit                : \"1A\";"
  puts $FILE_ID "capacitive_load_unit (1.0,pf);"

  # put in additional user-specified synopsys header info
  if {[catch "exec cat $DATA(synopsys_header_file)" msg]} {
    puts stderr $msg
  } else {
    puts $FILE_ID $msg
  }

  # write out any bus tables

# type (bus5) {
#        base_type : array;
#        data_type : bit;
#        bit_width : 5;
#        bit_from : 4;
#        bit_to : 0;
#        downto : true;
#}

  foreach bit [array names DATA bus,*] {
    setl {toss max min} [split $DATA($bit) "\[:\]"]
    set length [expr $max - $min + 1]

    set DATA(bus_type,[lindex [split $bit ,] 1]) "bus${max}_$min"

    if {[info exists BUSES(${max}_$min)]} {
      continue
    }
    set BUSES(${max}_$min) 1

    puts $FILE_ID "type (bus${max}_$min) \{"
    puts $FILE_ID "\tbase_type : array;"
    puts $FILE_ID "\tdata_type : bit;"
    puts $FILE_ID "\tbit_width : $length;"
    puts $FILE_ID "\tbit_from : $max;"
    puts $FILE_ID "\tbit_to : $min;"
    puts $FILE_ID "\tdownto : true;"
    puts $FILE_ID "\}"
  }

  # write out the timing tables
  puts $FILE_ID "cell ($cell) \{"

  if {[info exists DATA(comment)]} {
    puts $FILE_ID "/*"
    foreach comment $DATA(comment) {
      puts $FILE_ID " *\t$comment"
    }
    puts $FILE_ID " */"
  }

  if {[info exists DATA(header)]} {
    foreach header $DATA(header) {
      puts $FILE_ID "$header"
    }
  }

  foreach var [array names VARS] {
    if {$VARS($var) != "output"} {
      continue
    }

    if {[info exists DATA(bus,$var)]} {
      # this is a bus
      set var_name [lindex [split $var \[] 0]
      puts $FILE_ID "\tbus ($var_name) \{"
      puts $FILE_ID "\t    bus_type : $DATA(bus_type,$var);"
      puts $FILE_ID "\t    direction : output;"

      foreach string [array names OUTPUT] {
	# lookup for this variable name
	set value [get_assoc $var_name $OUTPUT($string)] 
	if {$value == ""} {
	  # no luck, look for default
	  set value [get_assoc __DEFAULT__ $OUTPUT($string)] 
	}
	if {$value == ""} {
	  # no value, skip
	  continue
	}
	# add it
	puts $FILE_ID "\t    $string : $value;"
      }

      puts $FILE_ID "\t    pin ($DATA(bus,$var)) \{"

    } else {
      puts $FILE_ID "\tpin ($var) \{"
      puts $FILE_ID "\t\tdirection : output;"

      foreach string [array names OUTPUT] {
	# lookup for this variable name
	set value [get_assoc $var $OUTPUT($string)] 
	if {$value == ""} {
	  # no luck, look for default
	  set value [get_assoc __DEFAULT__ $OUTPUT($string)] 
	}
	if {$value == ""} {
	  # no value, skip
	  continue
	}
	# add it
	puts $FILE_ID "\t\t$string : $value;"
      }

      puts $FILE_ID "\t\tmax_capacitance : [format "%.4f" [expr [eval set_load_capacitance $var [parse_pp_number $TIMES(max_slew)]] * $DATA(nominal_cap) * 1.0e12]];"
      puts $FILE_ID "\t\tmax_fanout : [format "%.4f" [expr [eval set_load_capacitance $var [parse_pp_number $TIMES(max_slew)]] * $DATA(nominal_cap) / [parse_pp_number $DATA(fanout_load)]]];"
      puts $FILE_ID "\t\tmax_transition : [format "%.4f" [expr [eval parse_pp_number $TIMES(max_slew)] * 1.0e9]];"
      if {[info exists FUNCTION($var)]} {
	puts $FILE_ID "\t\tfunction : \"$FUNCTION($var)\";"
      }
    }

    foreach unate "positive_unate negative_unate rising_edge falling_edge" {

      foreach _invar [array names VARS] {
	if {$VARS($_invar) == "output"} {
	  continue
	}

	# need to quote brackets for this to work
	regsub {\[} $_invar {\[} __invar
	regsub {\]} $__invar {\]} __invar
	set types [array names DELAYS ${var},$unate,$__invar,*,values]
	if {$types == ""} {
	  continue
	}

	puts $FILE_ID "\t\ttiming () \{"

	if {[info exists DATA(clear,$_invar)]} {
	  puts $FILE_ID "\t\t\ttiming_type : clear;"
	}
	if {[info exists DATA(preset,$_invar)]} {
	  puts $FILE_ID "\t\t\ttiming_type : preset;"
	}

	if {[string first edge $unate] != -1} {
	  puts $FILE_ID "\t\t\ttiming_type : ${unate};"
	} else {
	  puts $FILE_ID "\t\t\ttiming_sense : ${unate};"
	}

	puts $FILE_ID "\t\t\trelated_pin  : \"$_invar\"";

	foreach type $types {
	  setl {junk1 junk2 invar dir} [split $type ,]

	  # rise/fall
	  puts $FILE_ID "\t\t\tcell_${dir}(li[llength $DELAYS(${var},index_1)]X[llength $DELAYS(${var},${unate},$invar,$dir,index_2)]) \{"
	  puts $FILE_ID "\t\t\t\tindex_1([scale_print $DELAYS(${var},index_1) $size1 1.0e12]);"
	  puts $FILE_ID "\t\t\t\tindex_2([scale_print $DELAYS(${var},${unate},$invar,$dir,index_2) $size2 1.0e9]);"
	  puts $FILE_ID "\t\t\t\tvalues([scale_print $DELAYS(${var},${unate},$invar,$dir,values) $size1 1.0e9 "\t\t\t\t        " [parse_pp_number $DATA(user,offset)]]);"
	  puts $FILE_ID "\t\t\t\}"

	  # transition
	  puts $FILE_ID "\t\t\t${dir}_transition(li[llength $DELAYS(${var},index_1)]X[llength $DELAYS(${var},${unate},$invar,$dir,index_2)]) \{"
	  puts $FILE_ID "\t\t\t\tindex_1([scale_print $DELAYS(${var},index_1) $size1 1.0e12]);"
	  puts $FILE_ID "\t\t\t\tindex_2([scale_print $DELAYS(${var},${unate},$invar,$dir,index_2) $size2 1.0e9]);"
	  puts $FILE_ID "\t\t\t\tvalues([scale_print $DELAYS(${var},${unate},$invar,$dir,tr_values) $size1 1.0e9]);"
	  puts $FILE_ID "\t\t\t\}"
	}
	
	puts $FILE_ID "\t\t\}"
      }
    }

    if {[info exists DATA(bus,$var)]} {
      puts $FILE_ID "\t    \}"
    }

    puts $FILE_ID "\t\}"
  }

  # now put in input capacitances for inputs and any setup/holds.
  set dv [parse_pp_number $DATA(vdd)]

  foreach var [array names VARS] {
    if {$VARS($var) != "input"} {
      continue
    }

    if {[info exists DATA(bus,$var)]} {
      # this is a bus
      puts $FILE_ID "\tbus ([lindex [split $var \[] 0]) \{"
      puts $FILE_ID "\t    bus_type : $DATA(bus_type,$var);"
      puts $FILE_ID "\t    direction : input;"
      puts $FILE_ID "\t    pin ($DATA(bus,$var)) \{"

    } else {
      puts $FILE_ID "\tpin ($var) \{"
      puts $FILE_ID "\t\tdirection : input;"
    }

    if {[info exists DATA(user,${var}_c^)]} {
      # use the value from the ctl file.
      puts $FILE_ID "\t\tcapacitance : $DATA(user,${var}_c^);"

    } else {

      if {$CAPS($var,rise) != "" || $CAPS($var,fall) != ""} {
	if {$CAPS($var,rise) != "" && $CAPS($var,fall) != ""} {
	  # average them (should we use the maximum???)
	  set value [expr (abs($CAPS($var,rise)) + abs($CAPS($var,fall))) / (2.0 * $dv)]
	} elseif {$CAPS($var,rise)  != ""} {
	  set value [expr abs($CAPS($var,rise)) / $dv]
	} else {
	  set value [expr abs($CAPS($var,fall)) / $dv]
	}

	puts $FILE_ID "\t\tcapacitance : [format "%.4f" [expr $value * 1.0e12]];"
	puts $FILE_ID "\t\tfanout_load : [format "%.4f" [expr $value / [eval parse_pp_number $DATA(fanout_load)]]];"
      }
    }

    if {[info exists DATA(clock_pin)] && $DATA(clock_pin) == $var} {
      puts $FILE_ID "\t\tclock : true;"
    }

    foreach viotype "setup_rising setup_falling hold_rising hold_falling" {

      foreach _invar [array names VARS] {
        if {$VARS($_invar) == "output"} {
          continue
        }

        regsub {\[} $_invar {\[} __invar
        regsub {\]} $__invar {\]} __invar

        regsub -all {\[} $var {\[} _var
        regsub -all {\]} $_var {\]} _var

        set vios [array names VIOS "$_var,$viotype,$__invar,*,values"]
        if {$vios != ""} {
          puts $FILE_ID "\t\ttiming () \{"
          puts $FILE_ID "\t\t\ttiming_type  : $viotype;"
          puts $FILE_ID "\t\t\trelated_pin : \"$invar\";"
    
          foreach vio $vios {
    
	    setl {dir} [lindex [split $vio ,] 3]
    	
            puts $FILE_ID "\t\t\t${dir}_constraint(cr[llength $VIOS($_var,$viotype,$__invar,$dir,index_1)]X[llength $VIOS($_var,$viotype,$__invar,$dir,index_2)]) \{"
	    puts $FILE_ID "\t\t\t\tindex_1([scale_print $VIOS($_var,$viotype,$__invar,$dir,index_1) [llength $VIOS($_var,$viotype,$__invar,$dir,index_1)] 1.0e9]);"
	    puts $FILE_ID "\t\t\t\tindex_2([scale_print $VIOS($_var,$viotype,$__invar,$dir,index_2) [llength $VIOS($_var,$viotype,$__invar,$dir,index_2)] 1.0e9]);"
	    puts $FILE_ID "\t\t\t\tvalues([scale_print $VIOS($_var,$viotype,$__invar,$dir,values) [llength $VIOS($_var,$viotype,$__invar,$dir,index_1)] 1.0e9 "\t\t\t\t        " [parse_pp_number $DATA(user,offset)]]);"
            puts $FILE_ID "\t\t\t\}"
          }
	  puts $FILE_ID "\t\t\}"
        }

        if {[info exists DATA(bus,$var)]} {
          puts $FILE_ID "\t    \}"
        }

      }
    }
    puts $FILE_ID "\t\}"
  }

  # closes the cell
  puts $FILE_ID "\}"
  # closes the library
  puts $FILE_ID "\}"

  # close the file
  close $FILE_ID

  puts "Wrote synopsys model for cell \"$cell\" to file \"$filename\"."
}


# creates a verilog model for the cell if a functional description is
# given and writes to <cell>.v

proc make_verilog_model {cell} {

  global FUNCTION VARS DATA

  if {[array names FUNCTION] == ""} {
    # no functional model, punt
    # Pat added message:
    puts stderr "No function model, aborting verilog generation for $cell"
    return
  }

  set filename $cell.v

  # open the verilog output file
  if {[catch "open $filename w" FILE_ID]} {
    # error
    puts stderr "Aborting, $FILE_ID"
    exit 1
  } 

  # don't want a continuation in this line.
  puts $FILE_ID "// Autogenerated by char on [clock format [clock seconds] -format %D].\n"

  set vars [lsort [array names VARS]]

  verilog_puts $FILE_ID "module $cell ([join $vars ,]);"

  foreach var $vars {
    verilog_puts $FILE_ID "\t$VARS($var)\t$var;"
  }

  verilog_puts $FILE_ID ""

  # put the function in
  if {[info exists DATA(verilog)]} {
      foreach aline $DATA(verilog) {
        verilog_puts $FILE_ID "$aline"
      }
  } else {
      foreach function [array names FUNCTION] {
	verilog_puts $FILE_ID "\tassign $function = $FUNCTION($function);"
      }
  }

  verilog_puts $FILE_ID ""

  verilog_puts $FILE_ID "endmodule"
  verilog_puts $FILE_ID ""

  # close the file
  close $FILE_ID

  puts "Wrote verilog model for cell \"$cell\" to file \"$filename\"."
}


# make the table look nice

proc scale_print {list width scale {prefix "\t\t\t\t        "} {offset 0}} {

  # reorder the table (flip x and y)
  set i 0
  foreach num $list {
    lappend LIST([expr [incr i] % $width]) $num
  }

  set list ""
  for {set i 1} {$i <= $width} {incr i} {
    set list [concat $list $LIST([expr $i % $width])]
  }

  set nums ""
  foreach num $list {
    lappend nums [format "%.4f" [expr ($num + $offset) * $scale]]
  }

  if {[llength $list] > $width} {
    set width [expr [llength $list] / $width]
  }
  set wm1 [expr $width - 1]

  set result "^[join [lrange $nums 0 $wm1] ,]^"
  for {set i $width} {$i < [llength $nums]} {incr i $width} {
    set result "$result,\\\n$prefix^[join [lrange $nums $i [expr $i + $wm1]] ,]^"
  }

  regsub -all {\^} $result \" result

  return $result
}



          set fail_pos -1

          foreach delay $TIMES(hold) {
	    set hold_time [get_assoc $name$dir$count $results]
	    set value [get_assoc $name$dir$count! $results]
            set clk_slew [get_assoc $name$dir${count}_ $results]
            set var_slew [get_assoc $name$dir${count}% $results]
	    if {$value != ""} {
	      if {$value > [eval parse_pp_number $DATA(vdd)] / 2.0 && $dir == "^" ||
                  $value < [eval parse_pp_number $DATA(vdd)] / 2.0 && $dir == "v"} {
	        # failed
	        if {$hold_time > $fail} {
	          set fail $hold_time
	          set fail_pos $count
	        }
	      } else {
	        # passed
	        if {$hold_time < $pass} {

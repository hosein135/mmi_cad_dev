	    }

	    set repeat 1
	    puts "  hold time larger than [pp_number [expr ($fail_value * [parse_pp_number 1$TIMES(units)])]]s.  Extending range upwards."
	
          } elseif {$fail < -1.0e6} {
	    # never failed, extend range downwards
	    set points [llength $TIMES(hold)]

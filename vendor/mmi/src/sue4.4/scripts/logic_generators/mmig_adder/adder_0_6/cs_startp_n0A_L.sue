# SUE version MMI_SUE4.0

proc SCHEMATIC_cs_startp_n0A_L {} {
  make output -orient RY -name Sum_H -origin {1330 650}
  make input -orient RY -name A_H -origin {-20 460}
  make input -orient RY -name B_H -origin {-20 500}
  make output -orient R90Y -name Cout1_H -origin {480 180}
  make output -orient R90Y -name Cout0_H -origin {890 180}
  make input -orient R90Y -name SelCI_H -origin {1270 1240}
  make output -orient R90Y -name SelCO_H -origin {1270 180}
  make output -orient R90Y -name SelS_H -origin {1150 180}
  generate row_spanner row_spanner150 -width 150
  make row_spanner150 -origin {170 1460}
  generate name_net_s name_net -cell name_net
  make name_net -name G_L -origin {340 480}
  make name_net -name K_H -origin {340 550}
  make name_net -name Sum1_H -origin {900 620}
  make name_net -name Sum0_H -origin {900 680}
  make input -name Inject_H -origin {-20 1010}
  make input -name C_H -origin {-20 1130}
  make input -orient R90Y -name Cin1_L -origin {500 1250}
  make input -orient R90Y -name Cin0_L -origin {1000 1240}
  make name_net -name C_L -origin {210 1130}
  generate row_spanner row_spanner240 -width 240
  make row_spanner240 -origin {1090 1460}
  generate MMI_NAND2 MMI_NAND2B -Size B
  make MMI_NAND2B -orient RY -origin {100 480}
  generate MMI_NOR2 MMI_NOR2B_1 -Size B -DeMorgan 1
  make MMI_NOR2B_1 -origin {100 550}
  make MMI_INAND2 -origin {250 620}
  generate MMI_INV MMI_INVA_1 -DeMorgan 1
  make MMI_INVA_1 -origin {560 680}
  generate MMI_INV MMI_INVB_1 -Size B -DeMorgan 1
  make MMI_INVB_1 -orient R270 -origin {480 340}
  make MMI_INVB_1 -orient R270 -origin {890 340}
  generate MMI_BUF MMI_BUFE -Size E
  make MMI_BUFE -orient R270 -origin {220 820}
  generate MMI_MUXI3 MMI_MUXI3C_1 -Size C -DeMorgan 1
  make MMI_MUXI3C_1 -orient R90Y -origin {500 1030}
  make MMI_MUXI3C_1 -orient R90Y -origin {940 1030}
  generate MMI_MUXI2 MMI_MUXI2A_ -DeMorgan 1
  make MMI_MUXI2A_ -orient R90Y -origin {720 1040}
  generate row_spanner row_spanner200 
  make row_spanner200 -origin {600 1460}
  generate MMI_INV MMI_INVA 
  make MMI_INVA -origin {140 1130}
  generate MMI_MUX2 MMI_MUX2A 
  make MMI_MUX2A -orient RY -origin {1150 650}
  make output -orient RY -name Cin_H -origin {1330 850}
  make cs_startp_n0A_L -origin {50 230}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.15 -date 03/09/99 -origin {350 1610}
  make_wire -20 500 10 500
  make_wire 160 640 190 640
  make_wire 410 620 410 680
  make_wire 190 480 190 600
  make_wire 340 550 480 550
  make_wire 30 460 30 530
  make_wire 160 550 340 550
  make_wire 10 570 40 570
  make_wire 10 500 10 570
  make_wire 40 500 10 500
  make_wire 160 480 190 480
  make_wire -20 460 30 460
  make_wire 30 460 40 460
  make_wire 160 550 160 640
  make_wire 30 530 40 530
  make_wire 500 680 410 680
  make_wire 480 180 480 280
  make_wire 480 400 480 550
  make_wire 890 400 890 480
  make_wire 890 180 890 280
  make_wire 220 880 220 910
  make_wire 200 1130 210 1130
  make_wire 80 1130 -20 1130
  make_wire 440 1090 440 1130
  make_wire 500 1090 500 1150
  make_wire 500 1150 500 1250
  make_wire 500 910 500 970
  make_wire 220 910 500 910
  make_wire 1000 1090 1000 1170
  make_wire 1000 1170 1000 1240
  make_wire 880 1090 880 1130
  make_wire 940 1090 940 1150
  make_wire 900 680 1090 680
  make_wire 1150 180 1150 600
  make_wire 1210 650 1330 650
  make_wire 1270 1050 1270 1240
  make_wire 940 910 1270 910
  make_wire 940 910 940 970
  make_wire 310 620 410 620
  make_wire 410 620 900 620
  make_wire 900 620 1090 620
  make_wire 210 1130 440 1130
  make_wire 440 1130 880 1130
  make_wire 220 760 1150 760
  make_wire 190 480 340 480
  make_wire 340 480 890 480
  make_wire -20 1010 430 1010
  make_wire 430 1010 870 1010
  make_wire 560 1090 560 1170
  make_wire 1150 600 1150 760
  make_wire 620 680 900 680
  make_wire 690 1100 690 1150
  make_wire 690 1150 500 1150
  make_wire 690 1150 940 1150
  make_wire 750 1100 750 1170
  make_wire 750 1170 560 1170
  make_wire 750 1170 1000 1170
  make_wire 720 850 720 980
  make_wire 720 850 1330 850
  make_wire 1270 1050 850 1050
  make_wire 670 1040 640 1040
  make_wire 640 1040 640 1050
  make_wire 640 1050 410 1050
  make_wire 640 1050 850 1050
  make_wire 1270 180 1270 910
  make_text -origin {-270 -40} -text {This is the same cell as cs_start_n0A_H, but with the 
inverting muxes to allow for _L carry in's.}
}

proc ICON_cs_startp_n0A_L args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {pad {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type output -origin {-40 -120} -orient R270 -name Cout1_H
  icon_term -type output -origin {-20 -120} -orient R270 -name Cout0_H
  icon_term -type input -origin {140 80} -orient RXY -name SelCI_H
  icon_term -type output -origin {140 -80} -orient RY -name SelCO_H
  icon_term -type output -origin {140 -100} -name SelS_H
  icon_term -type input -origin {-140 70} -name Inject_H
  icon_term -type input -origin {-140 90} -name C_H
  icon_term -type input -origin {-40 120} -orient R270 -name Cin1_L
  icon_term -type input -origin {-20 120} -orient R270 -name Cin0_L
  icon_term -type output -origin {140 20} -name Cin_H
  icon_property -origin {-40 230} -type user -name name
  icon_property -origin {-40 250} -type user -name M
  icon_property -origin {-40 270} -type user -name pad
  icon_property -origin {130 80} -anchor e -label SelCI_H
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin1_L
  icon_property -origin {-20 110} -anchor e -rotate 1 -label Cin0_L
  icon_property -origin {-40 -110} -rotate 1 -label Cout1_H
  icon_property -origin {-20 -110} -rotate 1 -label Cout0_H
  icon_property -origin {130 -80} -anchor e -label SelCO_H
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor e -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label cs_startp_n0A_L
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_property -origin {130 -100} -anchor e -label SelS_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
  icon_property -origin {-130 70} -label Inj_H
  icon_property -origin {-130 90} -label C_H
  icon_property -origin {130 20} -rotate 1 -label Cin_H
}


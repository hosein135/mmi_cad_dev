# SUE version MMI_SUE4.0p2

proc SCHEMATIC_cs_startp_n0C_L {} {
  make output -orient RY -name Sum_H -origin {1420 650}
  make input -orient RY -name A_H -origin {-100 460}
  make input -orient RY -name B_H -origin {-100 500}
  make output -orient R90Y -name Cout1_H -origin {610 180}
  make output -orient R90Y -name Cout0_H -origin {980 180}
  generate row_spanner row_spanner100 -width 100
  make row_spanner100 -origin {990 1820}
  make input -orient R90Y -name SelCI_H -origin {1320 1620}
  make output -orient R90Y -name SelCO_H -origin {1320 180}
  make output -orient R90Y -name SelS_H -origin {1240 180}
  generate name_net_s name_net -cell name_net
  make name_net -name G_L -origin {470 480}
  make name_net -name K_H -origin {470 550}
  make name_net -name Sum1_H -origin {990 620}
  make name_net -name Sum0_H -origin {990 680}
  make input -name Inject_H -origin {-100 1070}
  make input -name C_H -origin {-100 1230}
  make input -orient R90Y -name Cin1_L -origin {610 1630}
  make input -orient R90Y -name Cin0_L -origin {970 1630}
  make name_net -name C_L -origin {190 1230}
  generate MMI_NAND2 MMI_NAND2B -Size B
  make MMI_NAND2B -orient RY -origin {100 480}
  generate MMI_NOR2 MMI_NOR2B_1 -Size B -DeMorgan 1
  make MMI_NOR2B_1 -origin {100 550}
  make MMI_INAND2 -origin {250 620}
  generate MMI_INV MMI_INVA_1 -DeMorgan 1
  make MMI_INVA_1 -origin {630 680}
  generate MMI_INV MMI_INVC_1 -Size C -DeMorgan 1
  make MMI_INVC_1 -orient R270 -origin {610 340}
  make MMI_INVC_1 -orient R270 -origin {980 340}
  generate MMI_INV MMI_INVA 
  make MMI_INVA -origin {90 1230}
  generate MMI_BUF MMI_BUFE -Size E
  make MMI_BUFE -orient R270 -origin {1240 810}
  generate MMI_MUX2 MMI_MUX2C -Size C
  make MMI_MUX2C -orient RY -origin {1240 650}
  generate MMI_MUXI3 MMI_MUXI3C_ -Size C -DeMorgan 1
  make MMI_MUXI3C_ -orient R90Y -origin {610 1090}
  generate MMI_MUXI2 MMI_MUXI2C_ -Size C -DeMorgan 1
  make MMI_MUXI2C_ -orient R90Y -origin {340 1090}
  generate row_spanner row_spanner250 -width 250
  make row_spanner250 -origin {190 1820}
  make output -orient RY -name Cin_H -origin {1420 960}
  make cs_startp_n0C_L -origin {50 230}
  make MMI_ADDMUX3C -orient R90Y -origin {960 1090}
  generate row_spanner row_spanner150 -width 150
  make row_spanner150 -origin {1300 1820}
  generate MMI_NOR2 MMI_NOR2B_ -Size B -DeMorgan 1
  make MMI_NOR2B_ -orient R90Y -origin {1220 1370}
  make row_spanner150 -origin {660 1820}
  make MMI_NOR2B_ -orient R270 -origin {750 1360}
  make name_net_s -name ICin1_H -origin {860 1270}
  make name_net_s -name ICin0_H -origin {1110 1270}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.27 -date 04/30/99 -origin {320 1970}
  make_wire 160 640 190 640
  make_wire 190 480 190 600
  make_wire 30 460 30 530
  make_wire 10 570 40 570
  make_wire 10 500 10 570
  make_wire 160 550 160 640
  make_wire 30 530 40 530
  make_wire 540 680 570 680
  make_wire 540 620 540 680
  make_wire 610 180 610 280
  make_wire 610 400 610 550
  make_wire 980 400 980 480
  make_wire 980 180 980 280
  make_wire 1300 650 1420 650
  make_wire 1240 600 1240 180
  make_wire 960 930 1320 930
  make_wire 160 480 190 480
  make_wire 160 550 470 550
  make_wire 470 550 610 550
  make_wire 150 1230 190 1230
  make_wire 190 1230 550 1230
  make_wire 1240 600 1240 750
  make_wire 1240 870 1240 900
  make_wire 1320 180 1320 930
  make_wire 960 930 960 1030
  make_wire 310 1250 610 1250
  make_wire 420 1090 420 1110
  make_wire 370 1270 670 1270
  make_wire 290 1090 420 1090
  make_wire 1320 1110 1320 1620
  make_wire 310 1250 310 1150
  make_wire 610 1150 610 1250
  make_wire 550 1230 550 1150
  make_wire 670 1150 670 1270
  make_wire 370 1270 370 1150
  make_wire 900 1190 900 1150
  make_wire 10 1230 30 1230
  make_wire -100 1230 10 1230
  make_wire -100 460 30 460
  make_wire 30 460 40 460
  make_wire -100 500 10 500
  make_wire 10 500 40 500
  make_wire -20 1070 -100 1070
  make_wire 670 1560 670 1270
  make_wire 730 1520 730 1420
  make_wire 1240 1560 1240 1430
  make_wire 420 1110 520 1110
  make_wire 520 1110 870 1110
  make_wire 870 1110 1320 1110
  make_wire 340 960 1420 960
  make_wire 340 960 340 1030
  make_wire 190 480 470 480
  make_wire 470 480 980 480
  make_wire 690 680 990 680
  make_wire 990 680 1180 680
  make_wire -20 1070 540 1070
  make_wire 540 1070 890 1070
  make_wire 10 1190 900 1190
  make_wire 10 1190 10 1230
  make_wire 310 620 540 620
  make_wire 540 620 990 620
  make_wire 990 620 1180 620
  make_wire 610 900 1240 900
  make_wire 610 900 610 1030
  make_wire 610 1520 610 1250
  make_wire 610 1520 610 1630
  make_wire -20 1070 -20 1480
  make_wire 1200 1430 1200 1480
  make_wire 970 1560 970 1630
  make_wire 970 1560 1240 1560
  make_wire 670 1560 970 1560
  make_wire 610 1520 730 1520
  make_wire 770 1420 770 1480
  make_wire 770 1480 1200 1480
  make_wire 770 1480 -20 1480
  make_wire 750 1300 750 1270
  make_wire 960 1270 960 1150
  make_wire 1020 1150 1020 1270
  make_wire 1220 1270 1220 1310
  make_wire 1110 1270 1020 1270
  make_wire 1110 1270 1220 1270
  make_wire 860 1270 750 1270
  make_wire 860 1270 960 1270
  make_text -origin {-40 800} -text {This is the same cell as cs_start_n0C_H, but with the 
inverting muxes to allow for _L carry in's.}
}

proc ICON_cs_startp_n0C_L args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {pad {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type output -origin {-40 -120} -orient R270 -name Cout1_H
  icon_term -type output -origin {-20 -120} -orient R270 -name Cout0_H
  icon_term -type input -origin {140 80} -orient RXY -name SelCI_H
  icon_term -type output -origin {140 -80} -orient RY -name SelCO_H
  icon_term -type output -origin {140 -100} -name SelS_H
  icon_term -type input -origin {-140 70} -name Inject_H
  icon_term -type input -origin {-140 90} -name C_H
  icon_term -type input -origin {-40 120} -orient R270 -name Cin1_L
  icon_term -type input -origin {-20 120} -orient R270 -name Cin0_L
  icon_term -type output -origin {140 20} -name Cin_H
  icon_property -origin {-40 230} -type user -name name
  icon_property -origin {-40 250} -type user -name M
  icon_property -origin {-40 270} -type user -name pad
  icon_property -origin {130 80} -anchor e -label SelCI_H
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin1_L
  icon_property -origin {-20 110} -anchor e -rotate 1 -label Cin0_L
  icon_property -origin {-40 -110} -rotate 1 -label Cout1_H
  icon_property -origin {-20 -110} -rotate 1 -label Cout0_H
  icon_property -origin {130 -80} -anchor e -label SelCO_H
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor e -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label cs_startp_n0C_L
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_property -origin {130 -100} -anchor e -label SelS_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
  icon_property -origin {-130 70} -label Inj_H
  icon_property -origin {-130 90} -label C_H
  icon_property -origin {130 20} -rotate 1 -label Cin_H
}


# SUE version MMI_SUE4.0

proc SCHEMATIC_rippleB_H {} {
  make NAND2B -orient RY -origin {80 470}
  make input -orient RY -name A_H -origin {-20 450}
  make input -orient RY -name B_H -origin {-20 490}
  make INVC_ -origin {210 470}
  make NOR2B_ -origin {60 550}
  make output -orient R90Y -name Cout_L -origin {670 170}
  make input -orient R90Y -name Cin_H -origin {670 860}
  make output -name Sum_H -origin {1160 610}
  make name_net -name K_H -origin {340 610}
  make name_net -name G_H -origin {340 470}
  make name_net -name P_H -origin {960 590}
  make name_net -name K_L -origin {340 550}
  make XNOR2B_ -origin {1030 610}
  make INVB -origin {470 700}
  make NOR2B_ -orient RY -origin {440 590}
  generate row_spanner row_spanner300 -width 300
  make row_spanner300 -origin {250 1070}
  make row_spanner300 -origin {900 1070}
  make name_net -name Cin_L -origin {960 630}
  make AOI21C -orient R270 -origin {670 340}
  make INVC -origin {230 550}
  make rippleB_H -origin {30 210}
  make sccs_title_bar -owner emc -version 1.2 -date 01/26/99 -origin {520 1170}
  make_wire -20 490 10 490
  make_wire 60 490 10 490
  make_wire 30 450 -20 450
  make_wire 30 450 60 450
  make_wire 670 170 670 260
  make_wire 640 430 640 470
  make_wire 180 470 150 470
  make_wire 710 430 710 550
  make_wire 380 570 420 570
  make_wire 1100 610 1160 610
  make_wire 340 610 420 610
  make_wire 380 470 380 570
  make_wire 170 610 340 610
  make_wire 170 550 170 610
  make_wire 260 470 340 470
  make_wire 340 470 380 470
  make_wire 380 470 640 470
  make_wire 340 550 280 550
  make_wire 340 550 710 550
  make_wire 510 590 960 590
  make_wire 960 590 990 590
  make_wire 960 630 990 630
  make_wire 30 530 40 530
  make_wire 30 450 30 530
  make_wire 130 550 170 550
  make_wire 170 550 200 550
  make_wire 10 570 40 570
  make_wire 10 490 10 570
  make_wire 520 700 960 700
  make_wire 960 630 960 700
  make_wire 440 700 380 700
  make_wire 380 700 380 760
  make_wire 380 760 670 760
  make_wire 670 760 670 430
  make_wire 670 760 670 860
}

proc ICON_rippleB_H args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type output -origin {-40 -120} -orient R270 -name Cout_L
  icon_term -type input -origin {-40 120} -orient R270 -name Cin_H
  icon_property -origin {-70 240} -type user -name name
  icon_property -origin {-70 260} -type user -name M
  icon_property -origin {-70 280} -type user -name dpc
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin_H
  icon_property -origin {-40 -110} -rotate 1 -label Cout_L
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor center -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label rippleB_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
  icon_property -origin {-20 20} -size large -label {$name}
}


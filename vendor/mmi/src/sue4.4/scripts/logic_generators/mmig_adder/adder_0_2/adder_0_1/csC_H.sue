# SUE version MMI_SUE4.0

proc SCHEMATIC_csC_H {} {
  make NAND2B -orient RY -origin {80 450}
  make output -orient RY -name Sum_H -origin {1470 710}
  make input -orient RY -name A_H -origin {-20 430}
  make input -orient RY -name B_H -origin {-20 470}
  make input -orient R90Y -name Cin1_H -origin {630 860}
  make input -orient R90Y -name Cin0_H -origin {1030 860}
  make output -orient R90Y -name Cout1_L -origin {630 150}
  make output -orient R90Y -name Cout0_L -origin {1030 150}
  generate row_spanner row_spanner100 -width 100
  make row_spanner100 -origin {1450 1070}
  make MUX2C -orient RY -origin {1430 710}
  make INVC -orient RY -origin {230 530}
  make INVA -origin {1080 760}
  make XNOR2A -origin {1190 740}
  make input -orient R90Y -name SelS_H -origin {1430 870}
  generate row_spanner row_spanner250 -width 250
  make row_spanner250 -origin {230 1070}
  generate row_spanner row_spanner150 -width 150
  make row_spanner150 -origin {1130 1070}
  make row_spanner150 -origin {730 1070}
  make INVA -origin {680 700}
  make XNOR2A -origin {790 680}
  make name_net -name G_H -origin {520 450}
  make name_net -name K_L -origin {520 530}
  make name_net -name P_H -origin {520 610}
  make name_net -name Sum1_H -origin {1330 680}
  make name_net -name Sum0_H -origin {1330 740}
  make INOR2B_ -orient RY -origin {380 610}
  make INVC_ -origin {210 450}
  make NOR2B_ -orient RY -origin {60 530}
  make AOI21C -orient R270 -origin {1030 320}
  make AOI21C -orient R270 -origin {630 320}
  make csC_H -origin {80 160}
  make sccs_title_bar -owner emc -version 1.2 -date 01/26/99 -origin {730 1180}
  make_wire -20 470 10 470
  make_wire 60 470 10 470
  make_wire 30 430 -20 430
  make_wire 30 430 60 430
  make_wire 1030 150 1030 240
  make_wire 630 150 630 240
  make_wire 1450 710 1470 710
  make_wire 180 450 150 450
  make_wire 1130 760 1150 760
  make_wire 1000 410 1000 450
  make_wire 600 410 600 450
  make_wire 320 450 260 450
  make_wire 1030 760 1050 760
  make_wire 600 450 1000 450
  make_wire 1150 720 1130 720
  make_wire 290 630 340 630
  make_wire 1130 610 1130 720
  make_wire 630 700 650 700
  make_wire 730 610 730 660
  make_wire 730 700 750 700
  make_wire 730 610 1130 610
  make_wire 730 660 750 660
  make_wire 1330 680 860 680
  make_wire 1330 680 1410 680
  make_wire 1330 740 1260 740
  make_wire 1330 740 1410 740
  make_wire 520 450 320 450
  make_wire 520 450 600 450
  make_wire 520 610 450 610
  make_wire 520 610 730 610
  make_wire 320 590 340 590
  make_wire 1070 410 1070 530
  make_wire 520 530 670 530
  make_wire 670 530 1070 530
  make_wire 670 410 670 530
  make_wire 10 550 40 550
  make_wire 10 470 10 550
  make_wire 30 510 40 510
  make_wire 30 430 30 510
  make_wire 280 530 290 530
  make_wire 290 530 520 530
  make_wire 130 530 200 530
  make_wire 630 410 630 700
  make_wire 630 700 630 860
  make_wire 1030 410 1030 760
  make_wire 1030 760 1030 860
  make_wire 320 450 320 590
  make_wire 290 530 290 630
  make_wire 1430 750 1430 870
}

proc ICON_csC_H args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {pad {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type input -origin {-40 120} -orient R270 -name Cin1_H
  icon_term -type input -origin {-20 120} -orient R270 -name Cin0_H
  icon_term -type output -origin {-40 -120} -orient R270 -name Cout1_L
  icon_term -type output -origin {-20 -120} -orient R270 -name Cout0_L
  icon_term -type input -origin {140 100} -orient RXY -name SelS_H
  icon_property -origin {-70 210} -type user -name name
  icon_property -origin {-70 230} -type user -name M
  icon_property -origin {-70 250} -type user -name pad
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin1_H
  icon_property -origin {-20 110} -anchor e -rotate 1 -label Cin0_H
  icon_property -origin {-40 -110} -rotate 1 -label Cout1_L
  icon_property -origin {-20 -110} -rotate 1 -label Cout0_L
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor center -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label csC_H
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_property -origin {130 100} -anchor e -label SelS_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
}


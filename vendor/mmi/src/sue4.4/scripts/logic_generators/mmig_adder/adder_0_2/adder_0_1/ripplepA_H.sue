# SUE version MMI_SUE4.0

proc SCHEMATIC_ripplepA_H {} {
  make input -orient RY -name A_H -origin {-20 450}
  make input -orient RY -name B_H -origin {-20 490}
  make output -orient R90Y -name Cout_L -origin {670 170}
  make output -name Sum_H -origin {1180 610}
  make name_net -name K_H -origin {340 610}
  make name_net -name G_H -origin {340 470}
  make name_net -name P_H -origin {960 590}
  make name_net -name K_L -origin {340 550}
  generate row_spanner row_spanner300 -width 300
  make row_spanner300 -origin {240 1410}
  make row_spanner300 -origin {890 1410}
  make XNOR2A_ -origin {1030 610}
  make INVA -origin {810 630}
  make NOR2A_ -orient RY -origin {440 590}
  make INVB_ -origin {210 470}
  make NAND2A -origin {80 470}
  make name_net -name Cin_L -origin {960 630}
  make AOI21B -orient R270 -origin {670 340}
  make INVB -origin {230 550}
  make NOR2B_ -origin {60 550}
  make input -orient R90Y -name Cin_H -origin {720 1170}
  make INVA -origin {380 1070}
  make input -orient RY -name Inject_H -origin {-20 1030}
  make name_net -name Inject_L -origin {510 1070}
  make input -orient RY -name C_H -origin {-20 1110}
  make AO22B -orient R90Y -origin {670 890}
  make ripplepA_H -origin {30 210}
  make name_net -orient R90 -name Carry_H -origin {670 750}
  make sccs_title_bar -owner emc -version 1.2 -date 01/26/99 -origin {600 1520}
  make_wire -20 490 10 490
  make_wire 60 490 10 490
  make_wire 30 450 -20 450
  make_wire 30 450 60 450
  make_wire 670 170 670 260
  make_wire 640 430 640 470
  make_wire 180 470 150 470
  make_wire 710 430 710 550
  make_wire 380 570 420 570
  make_wire 340 610 420 610
  make_wire 380 470 380 570
  make_wire 170 610 340 610
  make_wire 170 550 170 610
  make_wire 260 470 340 470
  make_wire 340 470 380 470
  make_wire 380 470 640 470
  make_wire 340 550 280 550
  make_wire 340 550 710 550
  make_wire 510 590 960 590
  make_wire 960 590 990 590
  make_wire 780 630 670 630
  make_wire 670 630 670 430
  make_wire 960 630 860 630
  make_wire 960 630 990 630
  make_wire 30 530 40 530
  make_wire 30 450 30 530
  make_wire 130 550 170 550
  make_wire 170 550 200 550
  make_wire 10 570 40 570
  make_wire 10 490 10 570
  make_wire 660 1030 660 980
  make_wire 300 1030 300 1070
  make_wire 680 980 680 1070
  make_wire 300 1070 350 1070
  make_wire 510 1070 430 1070
  make_wire 510 1070 680 1070
  make_wire 620 980 620 1110
  make_wire -20 1110 620 1110
  make_wire -20 1030 300 1030
  make_wire 300 1030 660 1030
  make_wire 720 1170 720 980
  make_wire 670 630 670 750
  make_wire 670 750 670 830
  make_wire 1100 610 1180 610
  make_text -origin {1050 260} -text {This is the same cell as rippleA_H, with a carry in mux added 
to allow carry injection mid-chain.}
}

proc ICON_ripplepA_H args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type output -origin {-40 -120} -orient R270 -name Cout_L
  icon_term -type input -origin {-40 120} -orient R270 -name Cin_H
  icon_term -type input -origin {-140 70} -name Inject_H
  icon_term -type input -origin {-140 90} -name C_H
  icon_property -origin {-60 230} -type user -name name
  icon_property -origin {-60 250} -type user -name M
  icon_property -origin {-60 270} -type user -name dpc
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin_H
  icon_property -origin {-40 -110} -rotate 1 -label Cout_L
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor center -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label ripplepA_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_property -origin {-130 70} -label Inj_H
  icon_property -origin {-130 90} -label C_H
}


# SUE version MMI_SUE4.0

proc SCHEMATIC_cs_finalpC_H {} {
  make output -orient RY -name Sum_H -origin {1700 720}
  make input -orient RY -name A_H -origin {-230 430}
  make input -orient RY -name B_H -origin {-230 470}
  make input -orient R90Y -name Cin1_H -origin {570 1250}
  make input -orient R90Y -name Cin0_H -origin {1080 1250}
  generate row_spanner row_spanner100 -width 100
  make row_spanner100 -origin {1610 1470}
  make input -orient R90Y -name SelS_H -origin {1640 1250}
  make input -orient R90Y -name SelCI_H -origin {1630 430}
  generate name_net_s name_net -cell name_net
  make name_net -name Cout1_L -origin {540 170}
  make name_net -name Cout0_L -origin {1050 230}
  make name_net -name Cout1_H -origin {1510 170}
  make name_net -name Cout0_H -origin {1510 230}
  make output -orient RY -name Cout_H -origin {1690 200}
  generate row_spanner row_spanner200 
  make row_spanner200 -origin {1180 1470}
  make row_spanner200 -origin {640 1470}
  make name_net -name Sum1_H -origin {1510 690}
  make name_net -name Sum0_H -origin {1510 750}
  make name_net -name G_H -origin {430 450}
  make name_net -name K_L -origin {430 530}
  make name_net -name P_H -origin {270 610}
  generate row_spanner row_spanner300 -width 300
  make row_spanner300 -origin {30 1470}
  make input -name Inject_H -origin {-230 940}
  make input -name C_H -origin {-230 1030}
  make cs_finalpC_H -origin {-130 160}
  make name_net -orient R90 -name C1_H -origin {540 860}
  make name_net -orient R90 -name C0_H -origin {1050 860}
  generate MMI_NAND2 MMI_NAND2B -Size B
  make MMI_NAND2B -orient RY -origin {-110 450}
  generate MMI_NOR2 MMI_NOR2B_1 -Size B -DeMorgan 1
  make MMI_NOR2B_1 -origin {-110 530}
  generate MMI_INV MMI_INVC -Size C
  make MMI_INVC -origin {30 530}
  generate MMI_INV MMI_INVC_1 -Size C -DeMorgan 1
  make MMI_INVC_1 -origin {30 450}
  generate MMI_INOR2 MMI_INOR2B_1 -Size B -DeMorgan 1
  make MMI_INOR2B_1 -origin {190 610}
  make MMI_AOI21 -orient R270 -origin {540 310}
  make MMI_AOI21 -orient R270 -origin {1050 340}
  make MMI_INV -origin {600 710}
  make MMI_INV -origin {1110 770}
  generate MMI_INV MMI_INVB_1 -Size B -DeMorgan 1
  make MMI_INVB_1 -origin {1270 230}
  make MMI_INVB_1 -origin {800 170}
  generate MMI_MUX2 MMI_MUX2C -Size C
  make MMI_MUX2C -orient RY -origin {1630 200}
  make MMI_MUX2C -orient RY -origin {1640 720}
  make MMI_MUX2 -orient R90Y -origin {1050 940}
  make MMI_MUX2 -orient R90Y -origin {540 940}
  make MMI_XNOR2 -orient RY -origin {780 690}
  make MMI_XNOR2 -orient RY -origin {1260 750}
  make MMI_MUX2C -orient RY -origin {1640 1100}
  make output -orient RY -name PrevCout_H -origin {1700 1100}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.8 -date 03/09/99 -origin {680 1610}
  make_wire -230 470 -200 470
  make_wire 510 410 510 450
  make_wire 580 410 580 530
  make_wire 110 590 130 590
  make_wire -180 430 -180 510
  make_wire -200 550 -170 550
  make_wire -200 470 -200 550
  make_wire 1170 610 1170 730
  make_wire 670 610 1170 610
  make_wire 90 630 130 630
  make_wire 110 450 110 590
  make_wire 90 530 430 530
  make_wire 670 610 670 670
  make_wire 270 610 670 610
  make_wire -200 470 -170 470
  make_wire 540 710 540 860
  make_wire 540 710 540 410
  make_wire 670 670 720 670
  make_wire 1170 730 1200 730
  make_wire 1580 690 1510 690
  make_wire 1580 750 1510 750
  make_wire -230 430 -180 430
  make_wire -180 430 -170 430
  make_wire 90 450 110 450
  make_wire 110 450 430 450
  make_wire -50 450 -30 450
  make_wire -180 510 -170 510
  make_wire 90 530 90 630
  make_wire -50 530 -30 530
  make_wire 250 610 270 610
  make_wire 540 170 540 210
  make_wire 840 690 1510 690
  make_wire 660 710 720 710
  make_wire 740 170 540 170
  make_wire 860 170 1510 170
  make_wire 1510 170 1570 170
  make_wire 1090 440 1090 530
  make_wire 430 530 580 530
  make_wire 580 530 1090 530
  make_wire 1050 230 1050 240
  make_wire 1020 440 1020 450
  make_wire 430 450 510 450
  make_wire 510 450 1020 450
  make_wire 1050 440 1050 770
  make_wire 1210 230 1050 230
  make_wire 1330 230 1510 230
  make_wire 1510 230 1570 230
  make_wire 1320 750 1510 750
  make_wire 1170 770 1200 770
  make_wire 1630 150 1630 430
  make_wire 1000 940 580 940
  make_wire 1050 770 1050 860
  make_wire 1050 860 1050 880
  make_wire 1020 1000 1020 1030
  make_wire -230 1030 510 1030
  make_wire 510 1030 1020 1030
  make_wire 540 860 540 880
  make_wire 510 1000 510 1030
  make_wire 490 940 580 940
  make_wire 490 940 -230 940
  make_wire 1640 1050 1640 670
  make_wire 1640 1050 1640 1250
  make_wire 1580 1130 1080 1130
  make_wire 1080 1130 1080 1000
  make_wire 1080 1130 1080 1250
  make_wire 1580 1070 570 1070
  make_wire 570 1070 570 1000
  make_wire 570 1070 570 1250
  make_text -origin {-260 1220} -text {This is the same cell as cs_finalC_H, but with the 
carry in muxes added to allow for carry injection 
at the end of the chain.}
}

proc ICON_cs_finalpC_H args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {pad {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type input -origin {-40 120} -orient R270 -name Cin1_H
  icon_term -type input -origin {-20 120} -orient R270 -name Cin0_H
  icon_term -type input -origin {140 100} -orient RXY -name SelS_H
  icon_term -type output -origin {-40 -120} -orient R90Y -name Cout_H
  icon_term -type input -origin {140 80} -orient RX -name SelCI_H
  icon_term -type input -origin {-140 70} -name Inject_H
  icon_term -type input -origin {-140 90} -name C_H
  icon_term -type output -origin {140 20} -name PrevCout_H
  icon_property -origin {-70 210} -type user -name name
  icon_property -origin {-70 230} -type user -name M
  icon_property -origin {-70 250} -type user -name pad
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin1_H
  icon_property -origin {-20 110} -anchor e -rotate 1 -label Cin0_H
  icon_property -origin {-40 -110} -rotate 1 -label Cout_H
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor e -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label cs_finalpC_H
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_property -origin {130 100} -anchor e -label SelS_H
  icon_property -origin {130 80} -anchor e -label SelCI_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
  icon_property -origin {-130 70} -label Inj_H
  icon_property -origin {-130 90} -label C_H
  icon_property -origin {130 20} -rotate 1 -label PCout_H
}


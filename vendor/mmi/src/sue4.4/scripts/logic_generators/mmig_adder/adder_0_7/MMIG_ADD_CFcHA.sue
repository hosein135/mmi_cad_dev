  make_wire 1050 410 1050 770
  make_wire 1810 870 1810 670
  make_wire 1810 870 1810 1120
  make_wire 540 890 540 710
  make_wire 540 890 540 1120
  make_wire 1050 950 1050 770
  make_wire 1050 950 1050 1120
  make_wire 1750 690 1770 690
  make_wire 1750 750 1770 750
  make_wire 1320 750 1680 750
  make_wire 1680 750 1750 750
  make_wire 840 690 1680 690
  make_wire 1680 690 1750 690
  make_wire 1620 950 1690 950
  make_wire 1690 950 1750 950
  make_wire 1170 950 1190 950

# SUE version MMI_SUE4.0p1

proc SCHEMATIC_MMIG_ADD_CBcHC {} {
  make output -orient RY -name Sum_H -origin {1710 710}
  make input -orient RY -name A_H -origin {-20 430}
  make input -orient RY -name B_H -origin {-20 470}
  make input -orient R90Y -name Cin1_H -origin {630 1160}
  make input -orient R90Y -name Cin0_H -origin {1030 1160}
  make output -orient R90Y -name Cout1_L -origin {630 150}
  make output -orient R90Y -name Cout0_L -origin {1030 150}
  make input -orient R90Y -name SelS_H -origin {1650 1160}
  generate row_spanner row_spanner250 -width 250
  make row_spanner250 -origin {230 1330}
  generate row_spanner row_spanner150 -width 150
  make row_spanner150 -origin {1130 1330}
  make row_spanner150 -origin {730 1330}
  generate name_net_s name_net -cell name_net
  make name_net -name G_H -origin {520 450}
  make name_net -name K_L -origin {520 530}
  make name_net -name P_H -origin {520 610}
  make name_net -name Sum1_H -origin {1530 680}
  make name_net -name Sum0_H -origin {1530 740}
  generate MMI_NAND2 MMI_NAND2B -Size B
  make MMI_NAND2B -orient RY -origin {100 450}
  generate MMI_NOR2 MMI_NOR2B_1 -Size B -DeMorgan 1
  make MMI_NOR2B_1 -origin {100 530}
  generate MMI_INV MMI_INVC -Size C
  make MMI_INVC -origin {220 530}
  generate MMI_INV MMI_INVC_1 -Size C -DeMorgan 1
  make MMI_INVC_1 -origin {220 450}
  generate MMI_INOR2 MMI_INOR2B_1 -Size B -DeMorgan 1
  make MMI_INOR2B_1 -origin {400 610}
  generate MMI_AOI21 MMI_AOI21C -Size C
  make MMI_AOI21C -orient R270 -origin {630 310}
  make MMI_AOI21C -orient R270 -origin {1030 310}
  make MMI_INV -origin {1090 760}
  generate MMI_MUX2 MMI_MUX2C -Size C
  make MMI_MUX2C -orient RY -origin {1650 710}
  make MMI_XNOR2 -orient RY -origin {810 680}
  make MMI_XNOR2 -orient RY -origin {1210 740}
  make MMI_MUX2C -orient RY -origin {1650 940}
  make output -orient RY -name Cin_H -origin {1710 940}
  make name_net -name C1_H -origin {1530 910}
  make name_net -name C0_H -origin {1530 970}
  make MMIG_ADD_CBcHC -origin {80 160}
  make MMI_INV -origin {690 700}
  make MMI_INV -origin {690 910}
  make MMI_INV -origin {1090 970}
  generate MMI_INV MMI_INVA_ -DeMorgan 1
  make MMI_INVA_ -origin {1420 910}
  make MMI_INVA_ -origin {1420 970}
  generate row_spanner row_spanner200 
  make row_spanner200 -origin {1550 1330}
  make name_net -name C1_L -origin {1280 910}
  make name_net -name C0_L -origin {1280 970}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.6 -date 03/25/99 -origin {730 1440}
  make_wire -20 470 10 470
  make_wire 1000 410 1000 450
  make_wire 600 410 600 450
  make_wire 600 450 1000 450
  make_wire 520 450 600 450
  make_wire 1070 410 1070 530
  make_wire 520 530 670 530
  make_wire 670 530 1070 530
  make_wire 670 410 670 530
  make_wire 10 550 40 550
  make_wire 10 470 10 550
  make_wire 30 430 30 510
  make_wire 10 470 40 470
  make_wire -20 430 30 430
  make_wire 30 430 40 430
  make_wire 30 510 40 510
  make_wire 280 450 320 450
  make_wire 320 450 520 450
  make_wire 280 530 290 530
  make_wire 290 530 520 530
  make_wire 290 630 340 630
  make_wire 290 530 290 630
  make_wire 460 610 520 610
  make_wire 320 590 340 590
  make_wire 320 450 320 590
  make_wire 630 150 630 210
  make_wire 1030 150 1030 210
  make_wire 750 610 750 660
  make_wire 1150 610 1150 720
  make_wire 520 610 750 610
  make_wire 750 610 1150 610
  make_wire 1030 410 1030 760
  make_wire 1650 890 1650 660
  make_wire 1650 890 1650 1160
  make_wire 1530 910 1590 910
  make_wire 1530 970 1590 970
  make_wire 630 700 630 410
  make_wire 630 910 630 700
  make_wire 630 910 630 1160
  make_wire 1030 970 1030 760
  make_wire 1030 970 1030 1160
  make_wire 870 680 1530 680
  make_wire 1530 680 1590 680
  make_wire 1270 740 1530 740
  make_wire 1530 740 1590 740
  make_wire 1480 910 1530 910
  make_wire 1480 970 1530 970
  make_wire 1280 910 750 910
  make_wire 1280 910 1360 910
  make_wire 1280 970 1150 970
  make_wire 1280 970 1360 970
  make_text -origin {-60 960} -text {This cell is the same as csC_H,
but with added mux logic to create
Cin_H.}
}

proc ICON_MMIG_ADD_CBcHC args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {pad {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type input -origin {-40 120} -orient R270 -name Cin1_H
  icon_term -type input -origin {-20 120} -orient R270 -name Cin0_H
  icon_term -type output -origin {-40 -120} -orient R270 -name Cout1_L
  icon_term -type output -origin {-20 -120} -orient R270 -name Cout0_L
  icon_term -type input -origin {140 100} -orient RXY -name SelS_H
  icon_term -type output -origin {140 20} -name Cin_H
  icon_property -origin {-70 210} -type user -name name
  icon_property -origin {-70 230} -type user -name M
  icon_property -origin {-70 250} -type user -name pad
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin1_H
  icon_property -origin {-20 110} -anchor e -rotate 1 -label Cin0_H
  icon_property -origin {-40 -110} -rotate 1 -label Cout1_L
  icon_property -origin {-20 -110} -rotate 1 -label Cout0_L
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor e -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label CBcHC
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_property -origin {130 100} -anchor e -label SelS_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
  icon_property -origin {130 20} -rotate 1 -label Cin_H
}


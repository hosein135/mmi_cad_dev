# SUE version MMI_SUE4.0

proc SCHEMATIC_ripplefinalpB_H {} {
  make input -orient RY -name A_H -origin {-20 450}
  make input -orient RY -name B_H -origin {-20 490}
  make output -name Sum_H -origin {1720 610}
  generate name_net_s name_net -cell name_net
  make name_net -name K_H -origin {340 610}
  make name_net -name G_H -origin {340 470}
  make name_net -name P_H -origin {960 590}
  make name_net -name K_L -origin {340 550}
  generate row_spanner row_spanner300 -width 300
  make row_spanner300 -origin {240 1480}
  make row_spanner300 -origin {890 1480}
  make name_net -name Cout_L -origin {550 240}
  make output -orient R90Y -name Cout_H -origin {460 70}
  make name_net -name Cin_L -origin {960 630}
  make ripplefinalpB_H -origin {30 210}
  make input -orient R90Y -name Cin_H -origin {670 1150}
  make input -orient RY -name Inject_H -origin {-20 1010}
  make name_net -name Inject_L -origin {1520 1050}
  make input -orient RY -name C_H -origin {-20 1100}
  make name_net -name Carry_H -origin {1520 740}
  make row_spanner300 -origin {1540 1480}
  generate MMI_NAND2 MMI_NAND2B -Size B
  make MMI_NAND2B -orient RY -origin {90 470}
  generate MMI_NOR2 MMI_NOR2B_1 -Size B -DeMorgan 1
  make MMI_NOR2B_1 -orient RY -origin {90 550}
  generate MMI_INV MMI_INVC -Size C
  make MMI_INVC -origin {230 550}
  generate MMI_INV MMI_INVC_1 -Size C -DeMorgan 1
  make MMI_INVC_1 -origin {230 470}
  generate MMI_INV MMI_INVB -Size B
  make MMI_INVB -origin {470 690}
  generate MMI_INV MMI_INVB_1 -Size B -DeMorgan 1
  make MMI_INVB_1 -orient R270 -origin {460 160}
  make MMI_NOR2B_1 -origin {470 590}
  generate MMI_AOI21 MMI_AOI21C -Size C
  make MMI_AOI21C -orient R270 -origin {670 360}
  generate MMI_XNOR2 MMI_XNOR2B_1 -Size B -DeMorgan 1
  make MMI_XNOR2B_1 -orient RY -origin {1060 610}
  make MMI_INV -origin {1390 1050}
  generate MMI_AO22 MMI_AO22C -Size C
  make MMI_AO22C -orient R90Y -origin {1680 870}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.3 -date 02/19/99 -origin {860 1610}
  make_wire -20 490 10 490
  make_wire 380 470 380 570
  make_wire 170 610 340 610
  make_wire 170 550 170 610
  make_wire 550 240 670 240
  make_wire 550 240 460 240
  make_wire 30 530 40 530
  make_wire 30 450 30 530
  make_wire 10 490 10 570
  make_wire 960 630 960 690
  make_wire 1520 1050 1690 1050
  make_wire 380 740 670 740
  make_wire 670 1140 1730 1140
  make_wire 670 1140 670 1150
  make_wire -20 1100 1630 1100
  make_wire -20 1010 1310 1010
  make_wire 1310 1010 1670 1010
  make_wire 10 490 40 490
  make_wire -20 450 30 450
  make_wire 30 450 40 450
  make_wire 280 470 340 470
  make_wire 180 470 150 470
  make_wire 40 570 10 570
  make_wire 150 550 170 550
  make_wire 170 550 180 550
  make_wire 420 610 340 610
  make_wire 420 570 380 570
  make_wire 530 590 960 590
  make_wire 520 690 960 690
  make_wire 380 690 420 690
  make_wire 380 690 380 740
  make_wire 460 70 460 110
  make_wire 460 210 460 240
  make_wire 710 450 710 550
  make_wire 280 550 340 550
  make_wire 340 550 710 550
  make_wire 640 450 640 470
  make_wire 340 470 380 470
  make_wire 380 470 640 470
  make_wire 670 240 670 260
  make_wire 670 450 670 740
  make_wire 990 590 960 590
  make_wire 990 630 960 630
  make_wire 1120 610 1720 610
  make_wire 1310 1050 1340 1050
  make_wire 1310 1010 1310 1050
  make_wire 1440 1050 1520 1050
  make_wire 1730 960 1730 1140
  make_wire 1680 740 1680 770
  make_wire 670 740 1520 740
  make_wire 1520 740 1680 740
  make_wire 1690 960 1690 1050
  make_wire 1630 960 1630 1100
  make_wire 1670 960 1670 1010
  make_text -origin {1020 180} -text {This is the same cell as ripplefinalB_H, with a carry in mux added 
to allow carry injection mid-chain.}
}

proc ICON_ripplefinalpB_H args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type input -origin {-40 120} -orient R270 -name Cin_H
  icon_term -type output -origin {-40 -120} -orient R270 -name Cout_H
  icon_term -type input -origin {-140 70} -name Inject_H
  icon_term -type input -origin {-140 90} -name C_H
  icon_property -origin {-60 220} -type user -name name
  icon_property -origin {-60 240} -type user -name M
  icon_property -origin {-60 260} -type user -name dpc
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin_H
  icon_property -origin {-40 -110} -rotate 1 -label Cout_H
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor center -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label ripplefinalpB_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_property -origin {-130 70} -label Inj_H
  icon_property -origin {-130 90} -label C_H
}


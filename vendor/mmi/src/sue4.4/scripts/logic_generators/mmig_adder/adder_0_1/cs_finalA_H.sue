  make row_spanner350 -origin {1300 1070}
  make input -orient RX -name SelCI_H -origin {800 -150}
  make name_net -orient R270 -name Cout1_H -origin {540 -50}
  make name_net -orient R270 -name Cout0_H -origin {600 -50}
  make output -orient R90Y -name Cout_H -origin {570 -190}
  make INVB_ -orient R270 -origin {1050 90}
  make INVB_ -orient R270 -origin {540 90}
  make name_net -orient R270 -name Cout1_L -origin {540 170}
  make cs_finalA_H -origin {-130 160}
  make MUX2A -orient RY -origin {1620 720}
  make MUX2A -orient R90Y -origin {570 -150}
  make name_net -orient R270 -name Cout0_L -origin {1050 170}
  make sccs_title_bar -owner emc -version 1.2 -date 01/26/99 -origin {680 1200}
  make_wire -230 470 -200 470
  make_wire -150 470 -200 470
  make_wire -180 430 -230 430
  make_wire -180 430 -150 430
  make_wire -30 450 -60 450
  make_wire 610 -150 800 -150
  make_wire 50 450 110 450
  make_wire 1020 410 1020 450
  make_wire 510 410 510 450
  make_wire 570 -170 570 -190
  make_wire 580 530 1090 530
  make_wire 510 450 1020 450
  make_wire 600 -50 600 -130
  make_wire 1170 770 1220 770
  make_wire 1050 770 1090 770
  make_wire 540 710 590 710
  make_wire 1510 690 850 690
  make_wire 1510 690 1600 690
  make_wire 1510 750 1330 750
  make_wire 1510 750 1600 750
  make_wire 430 450 510 450
  make_wire 540 240 540 170
  make_wire 580 410 580 530
  make_wire 1090 410 1090 530
  make_wire 110 590 130 590
  make_wire -180 510 -170 510
  make_wire -180 430 -180 510
  make_wire -80 530 -10 530
  make_wire -200 550 -170 550
  make_wire -200 470 -200 550
  make_wire 740 710 670 710
  make_wire 1620 760 1620 860
  make_wire 1170 610 1170 730
  make_wire 1170 730 1220 730
  make_wire 740 670 670 670
  make_wire 670 610 1170 610
  make_wire 1050 410 1050 770
  make_wire 1050 770 1050 860
  make_wire 540 410 540 710
  make_wire 540 710 540 860
  make_wire 90 530 90 630
  make_wire 90 630 130 630
  make_wire 110 450 110 590

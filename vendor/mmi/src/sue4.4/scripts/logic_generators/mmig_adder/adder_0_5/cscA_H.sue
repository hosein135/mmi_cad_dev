# SUE version MMI_SUE4.0p1

proc SCHEMATIC_cscA_H {} {
  make output -orient RY -name Sum_H -origin {1510 710}
  make input -orient RY -name A_H -origin {-70 430}
  make input -orient RY -name B_H -origin {-70 470}
  make input -orient R90Y -name Cin1_H -origin {630 1070}
  make input -orient R90Y -name Cin0_H -origin {1030 1070}
  make output -orient R90Y -name Cout1_L -origin {630 150}
  make output -orient R90Y -name Cout0_L -origin {1030 150}
  make input -orient R90Y -name SelS_H -origin {1450 1080}
  generate row_spanner row_spanner250 -width 250
  make row_spanner250 -origin {230 1280}
  generate row_spanner row_spanner150 -width 150
  make row_spanner150 -origin {730 1280}
  generate name_net_s name_net -cell name_net
  make name_net -name G_H -origin {520 450}
  make name_net -name K_L -origin {520 530}
  make name_net -name P_H -origin {520 610}
  make name_net -name Sum1_H -origin {1330 680}
  make name_net -name Sum0_H -origin {1330 740}
  generate MMI_NAND2 MMI_NAND2B -Size B
  make MMI_NAND2B -orient RY -origin {90 450}
  generate MMI_NOR2 MMI_NOR2B_1 -Size B -DeMorgan 1
  make MMI_NOR2B_1 -origin {90 530}
  generate MMI_INV MMI_INVC -Size C
  make MMI_INVC -origin {230 530}
  generate MMI_INV MMI_INVC_1 -Size C -DeMorgan 1
  make MMI_INVC_1 -origin {230 450}
  generate MMI_INOR2 MMI_INOR2B_1 -Size B -DeMorgan 1
  make MMI_INOR2B_1 -origin {400 610}
  generate MMI_AOI21 MMI_AOI21B -Size B
  make MMI_AOI21B -orient R270 -origin {630 320}
  generate MMI_INV MMI_INVA 
  make MMI_INVA -origin {690 700}
  make MMI_INVA -origin {1090 760}
  make MMI_AOI21B -orient R270 -origin {1030 310}
  generate MMI_XNOR2 MMI_XNOR2A_1 -DeMorgan 1
  make MMI_XNOR2A_1 -orient RY -origin {1230 740}
  make MMI_XNOR2A_1 -orient RY -origin {820 680}
  make MMI_MUX2 -orient RY -origin {1450 710}
  make MMI_MUX2 -orient RY -origin {1450 900}
  make MMI_INVA -origin {690 870}
  make MMI_INVA -origin {1090 930}
  generate MMI_INV MMI_INVA_ -DeMorgan 1
  make MMI_INVA_ -origin {1230 930}
  make MMI_INVA_ -origin {830 870}
  make name_net -name C0_H -origin {1340 930}
  make name_net -name C1_H -origin {1340 870}
  make name_net -name C1_L -origin {760 870}
  make name_net -name C0_L -origin {1160 930}
  make output -orient RY -name Cin_H -origin {1510 900}
  make cscA_H -origin {80 160}
  generate row_spanner row_spanner180 -width 180
  make row_spanner180 -origin {1140 1280}
  generate row_spanner row_spanner100 -width 100
  make row_spanner100 -origin {1470 1280}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.3 -date 03/26/99 -origin {690 1410}
  make_wire 600 450 1000 450
  make_wire 730 610 1130 610
  make_wire 520 450 600 450
  make_wire 520 610 730 610
  make_wire 520 530 670 530
  make_wire 670 530 1070 530
  make_wire 320 450 320 590
  make_wire 1070 410 1070 530
  make_wire 1000 410 1000 450
  make_wire -70 430 -20 430
  make_wire -70 470 -40 470
  make_wire 320 590 340 590
  make_wire 290 630 340 630
  make_wire 670 420 670 530
  make_wire 600 420 600 450
  make_wire -40 470 30 470
  make_wire -20 430 30 430
  make_wire 150 450 170 450
  make_wire 290 450 320 450
  make_wire 320 450 520 450
  make_wire -40 550 30 550
  make_wire -40 470 -40 550
  make_wire -20 510 30 510
  make_wire -20 430 -20 510
  make_wire 290 530 520 530
  make_wire 290 530 290 630
  make_wire 150 530 170 530
  make_wire 460 610 520 610
  make_wire 630 150 630 220
  make_wire 1030 150 1030 210
  make_wire 730 660 760 660
  make_wire 730 610 730 660
  make_wire 750 700 760 700
  make_wire 880 680 1330 680
  make_wire 1330 680 1390 680
  make_wire 1150 760 1170 760
  make_wire 1290 740 1330 740
  make_wire 1330 740 1390 740
  make_wire 1130 720 1170 720
  make_wire 1130 610 1130 720
  make_wire 630 420 630 700
  make_wire 1030 410 1030 760
  make_wire 1450 850 1450 660
  make_wire 1450 850 1450 1080
  make_wire 630 870 630 700
  make_wire 630 870 630 1070
  make_wire 1030 930 1030 760
  make_wire 1030 930 1030 1070
  make_wire 1340 870 890 870
  make_wire 1340 870 1390 870
  make_wire 1290 930 1340 930
  make_wire 1340 930 1390 930
  make_wire 760 870 750 870
  make_wire 760 870 770 870
  make_wire 1160 930 1150 930
  make_wire 1160 930 1170 930
}

proc ICON_cscA_H args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {pad {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type input -origin {-40 120} -orient R270 -name Cin1_H
  icon_term -type input -origin {-20 120} -orient R270 -name Cin0_H
  icon_term -type output -origin {-40 -120} -orient R270 -name Cout1_L
  icon_term -type output -origin {-20 -120} -orient R270 -name Cout0_L
  icon_term -type input -origin {140 100} -orient RXY -name SelS_H
  icon_term -type output -origin {140 20} -name Cin_H
  icon_property -origin {-70 210} -type user -name name
  icon_property -origin {-70 230} -type user -name M
  icon_property -origin {-70 250} -type user -name pad
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin1_H
  icon_property -origin {-20 110} -anchor e -rotate 1 -label Cin0_H
  icon_property -origin {-40 -110} -rotate 1 -label Cout1_L
  icon_property -origin {-20 -110} -rotate 1 -label Cout0_L
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor e -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label cscA_H
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_property -origin {130 100} -anchor e -label SelS_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
  icon_property -origin {130 20} -rotate 1 -label Cin_H
}


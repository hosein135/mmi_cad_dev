# SUE version MMI_SUE4.0p1

proc SCHEMATIC_cs_startp_n0C_H {} {
  make output -orient RY -name Sum_H -origin {1150 650}
  make input -orient RY -name A_H -origin {-20 460}
  make input -orient RY -name B_H -origin {-20 500}
  make input -orient R90Y -name Cin1_H -origin {480 1210}
  make input -orient R90Y -name Cin0_H -origin {710 1200}
  make output -orient R90Y -name Cout1_H -origin {480 180}
  make output -orient R90Y -name Cout0_H -origin {710 180}
  generate row_spanner row_spanner100 -width 100
  make row_spanner100 -origin {730 1370}
  make row_spanner100 -origin {480 1370}
  make input -orient R90Y -name SelCI_H -origin {1060 1210}
  make output -orient R90Y -name SelCO_H -origin {1060 170}
  make output -orient R90Y -name SelS_H -origin {910 180}
  generate row_spanner row_spanner150 -width 150
  make row_spanner150 -origin {150 1370}
  make row_spanner100 -origin {980 1370}
  generate name_net_s name_net -cell name_net
  make name_net -name G_L -origin {340 480}
  make name_net -name K_H -origin {340 550}
  make name_net -name Sum1_H -origin {720 620}
  make name_net -name Sum0_H -origin {720 680}
  make input -name Inject_H -origin {-20 980}
  make input -name C_H -origin {-20 1120}
  generate MMI_NAND2 MMI_NAND2B -Size B
  make MMI_NAND2B -orient RY -origin {100 480}
  generate MMI_NOR2 MMI_NOR2B_1 -Size B -DeMorgan 1
  make MMI_NOR2B_1 -origin {100 550}
  make MMI_INAND2 -origin {250 620}
  generate MMI_INV MMI_INVA_1 -DeMorgan 1
  make MMI_INVA_1 -origin {550 680}
  generate MMI_INV MMI_INVC_1 -Size C -DeMorgan 1
  make MMI_INVC_1 -orient R270 -origin {480 340}
  make MMI_INVC_1 -orient R270 -origin {710 340}
  generate MMI_BUF MMI_BUFE -Size E
  make MMI_BUFE -orient R270 -origin {910 790}
  generate MMI_MUX2 MMI_MUX2C -Size C
  make MMI_MUX2C -orient RY -origin {910 650}
  generate MMI_MUX3 MMI_MUX3C -Size C
  make MMI_MUX3C -orient R90Y -origin {480 1000}
  make MMI_MUX3C -orient R90Y -origin {720 1000}
  make MMI_MUX2C -orient R90Y -origin {220 1000}
  make output -orient RY -name Cin_H -origin {1150 910}
  make cs_startp_n0C_H -origin {50 230}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.16 -date 03/26/99 -origin {330 1520}
  make_wire 160 640 190 640
  make_wire 410 620 410 680
  make_wire 190 480 190 600
  make_wire 340 480 710 480
  make_wire 340 550 480 550
  make_wire 30 460 30 530
  make_wire 160 550 340 550
  make_wire 10 570 40 570
  make_wire 10 500 10 570
  make_wire 710 1160 710 1200
  make_wire -20 500 10 500
  make_wire 10 500 40 500
  make_wire 160 480 190 480
  make_wire 190 480 340 480
  make_wire -20 460 30 460
  make_wire 30 460 40 460
  make_wire 160 550 160 640
  make_wire 30 530 40 530
  make_wire 310 620 410 620
  make_wire 410 620 720 620
  make_wire 480 180 480 280
  make_wire 480 400 480 550
  make_wire 710 400 710 480
  make_wire 710 180 710 280
  make_wire 490 680 410 680
  make_wire 610 680 720 680
  make_wire 850 680 720 680
  make_wire 850 620 720 620
  make_wire 970 650 1150 650
  make_wire 910 600 910 180
  make_wire 480 1060 480 1140
  make_wire 480 1140 480 1210
  make_wire 540 1060 540 1160
  make_wire 420 1060 420 1120
  make_wire 780 1060 780 1160
  make_wire 660 1060 660 1120
  make_wire -20 1120 420 1120
  make_wire 420 1120 660 1120
  make_wire 720 1060 720 1140
  make_wire 910 730 910 600
  make_wire -20 980 410 980
  make_wire 410 980 650 980
  make_wire 1060 1020 1060 1210
  make_wire 720 880 1060 880
  make_wire 480 850 480 940
  make_wire 480 850 910 850
  make_wire 710 1160 780 1160
  make_wire 190 1060 190 1140
  make_wire 190 1140 480 1140
  make_wire 480 1140 720 1140
  make_wire 300 1000 300 1020
  make_wire 250 1060 250 1160
  make_wire 250 1160 540 1160
  make_wire 540 1160 710 1160
  make_wire 300 1020 390 1020
  make_wire 390 1020 630 1020
  make_wire 630 1020 1060 1020
  make_wire 170 1000 300 1000
  make_wire 1060 170 1060 880
  make_wire 720 880 720 940
  make_wire 220 910 220 940
  make_wire 220 910 1150 910
  make_text -origin {0 800} -text {This is the same cell as cs_start_n0C_H, but with the 
carry in mux changed from a MUX2D to two MUX3C's
to allow for carry injection mid-chain.}
}

proc ICON_cs_startp_n0C_H args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {pad {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type input -origin {-40 120} -orient R270 -name Cin1_H
  icon_term -type input -origin {-20 120} -orient R270 -name Cin0_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type output -origin {-40 -120} -orient R270 -name Cout1_H
  icon_term -type output -origin {-20 -120} -orient R270 -name Cout0_H
  icon_term -type input -origin {140 80} -orient RXY -name SelCI_H
  icon_term -type output -origin {140 -80} -orient RY -name SelCO_H
  icon_term -type output -origin {140 -100} -name SelS_H
  icon_term -type input -origin {-140 70} -name Inject_H
  icon_term -type input -origin {-140 90} -name C_H
  icon_term -type output -origin {140 20} -name Cin_H
  icon_property -origin {-40 230} -type user -name name
  icon_property -origin {-40 250} -type user -name M
  icon_property -origin {-40 270} -type user -name pad
  icon_property -origin {130 80} -anchor e -label SelCI_H
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin1_H
  icon_property -origin {-20 110} -anchor e -rotate 1 -label Cin0_H
  icon_property -origin {-40 -110} -rotate 1 -label Cout1_H
  icon_property -origin {-20 -110} -rotate 1 -label Cout0_H
  icon_property -origin {130 -80} -anchor e -label SelCO_H
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor e -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label cs_startp_n0C_H
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_property -origin {130 -100} -anchor e -label SelS_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
  icon_property -origin {-130 70} -label Inj_H
  icon_property -origin {-130 90} -label C_H
  icon_property -origin {130 20} -rotate 1 -label Cin_H
}


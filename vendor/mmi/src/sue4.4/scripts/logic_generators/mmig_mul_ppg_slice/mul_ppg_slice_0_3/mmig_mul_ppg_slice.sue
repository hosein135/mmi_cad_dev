# This is a generator for a bitslice of a multiplier tree made up of 4:2 adders.

proc NAME_mmig_mul_ppg_slice args {
  call_use_keyword $args {{NBITS_A 8} {NBITS_B 8} {A "Unsigned"} {B "Unsigned"} {AddExtraCSA 0} {OptimizeMulArray "None"} {HalfHeight 0} {Bit 0}}

  # NBITS_A
  set nom [format "mmig_mul_ppg_slice_%d" $NBITS_A]

  # A
  if {[string toupper $A] == "SIGNED"} {
    set nom [format "%sSx" $nom]
  }
  if {[string toupper $A] == "UNSIGNED"} {
    set nom [format "%sUx" $nom]
  }
  if {[string toupper $A] == "BOTH"} {
    set nom [format "%sBx" $nom]
  }

  # NBITS_B
  set nom [format "%s%d" $nom $NBITS_B]

  # B
  if {[string toupper $B] == "SIGNED"} {
    set nom [format "%sS_" $nom]
  }
  if {[string toupper $B] == "UNSIGNED"} {
    set nom [format "%sU_" $nom]
  }
  if {[string toupper $B] == "BOTH"} {
    set nom [format "%sB_" $nom]
  }

  # AddExtraCSA
  if {$AddExtraCSA == 1} {
    set nom [format "%sY" $nom]
  } else {
    set nom [format "%sN" $nom]
  } 

  # OptimizeMulArray
  if {[string toupper $OptimizeMulArray] == "LSB"} {
    set nom [format "%sL" $nom]
  } else {
    set nom [format "%sN" $nom]
  }

  # HalfHeight
  if {$HalfHeight == 1} {
    set nom [format "%sY" $nom]
  } else {
    set nom [format "%sN" $nom]
  } 

  # Bit
  set nom [format "%s_%d" $nom $Bit]

  return $nom
}


proc SCHEMATIC_mmig_mul_ppg_slice args {
  call_use_keyword $args {{NBITS_A 8} {NBITS_B 8} {A "Unsigned"} {B "Unsigned"} {AddExtraCSA 0} {OptimizeMulArray "None"} {HalfHeight 0} {Bit 0}}

  # make the arguments more digestible
  set A [string toupper $A]
  set B [string toupper $B]
  set OptimizeMulArray [string toupper $OptimizeMulArray]
  

  set debug 0
  if {$debug} {
    puts [format "Bit=%d:" $Bit]
    set out [generators_mul_get_ppg_bitslice "ALG" $Bit]
    puts $out
    set out [generators_mul_get_ppg_bitslice "A" $Bit]
    puts $out
    set out [generators_mul_get_ppg_bitslice "B" $Bit]
    puts $out
    set out [generators_mul_get_ppg_bitslice "ASIGNED" $Bit]
    puts $out
    set out [generators_mul_get_ppg_bitslice "BSIGNED" $Bit]
    puts $out
  }

  global PPGBOXCOUNT
  global PPGTOTBOXCOUNT
  global PPGROWSIZE


  # make inputs more digestible
  if {$OptimizeMulArray == "LSB"} {
    set zeroopt 1
  } else { 
    set zeroopt 0
  }

  # get Algorithm
  set Algorithm [generators_mul_get_ppg_bitslice "ALG" $Bit]

  # compress Algorithm, removing zeros
  set newalg ""
  set algidx ""
  if {$OptimizeMulArray == "LSB"} {
    for {set i 0} {$i < [string length $Algorithm]} {incr i} {
      set algbit [string index $Algorithm $i]
      if {$algbit != 0} {
	set newalg [format "%s%s" $newalg $algbit]
	set algidx [format "%s %s" $algidx $i]
      }
    }
    set Algorithm $newalg
  }


  # which 4:2 adder?
  if {$HalfHeight == 1} {
    set m42a "MMIG_MUL_42ADDT"
  } else {
    set m42a "MMIG_MUL_42ADD"
  }
  setl {icon_x icon_y icon_left icon_bot icon_right icon_top} [generators_get_icon_size $m42a]

  # 4:2 adder icon port info
  setl {count inpins outpins inoutpins} [generators_get_pin_info $m42a]
  setl {port_in_x(1) port_in_y(1)} [generators_get_pin_xy "In1_H" $inpins]
  setl {port_in_x(2) port_in_y(2)} [generators_get_pin_xy "In2_H" $inpins]
  setl {port_in_x(3) port_in_y(3)} [generators_get_pin_xy "In3_H" $inpins]
  setl {port_in_x(4) port_in_y(4)} [generators_get_pin_xy "In4_H" $inpins]
  setl {port_sum_x port_sum_y} [generators_get_pin_xy "Sum_H" $outpins]
  setl {port_carry_x port_carry_y} [generators_get_pin_xy "Carry_H" $outpins]
  setl {port_cin_x port_cin_y} [generators_get_pin_xy "Cin_L" $inpins]
  setl {port_cout_x port_cout_y} [generators_get_pin_xy "Cout_L" $outpins]

  # ppg logic icon port info
  set pname [NAME_mmig_ppg_4bit -NBITS_A $NBITS_A -NBITS_B $NBITS_B -A $A -B $B -Bit $Bit -Chunk "0 1 2 3" -Box 0 -HalfHeight $HalfHeight]
  generate mmig_ppg_4bit $pname -NBITS_A $NBITS_A -NBITS_B $NBITS_B -A $A -B $B -Bit $Bit -Chunk "0 1 2 3" -Box 0 -HalfHeight $HalfHeight
  setl {pcount pinpins poutpins pinoutpins} [generators_get_pin_info $pname]
  setl {ppg_port_pp_x(0) ppg_port_pp_y(0)} [generators_get_pin_xy "PP0_H" $poutpins]
  setl {ppg_port_pp_x(1) ppg_port_pp_y(1)} [generators_get_pin_xy "PP1_H" $poutpins]
  setl {ppg_port_pp_x(2) ppg_port_pp_y(2)} [generators_get_pin_xy "PP2_H" $poutpins]
  setl {ppg_port_pp_x(3) ppg_port_pp_y(3)} [generators_get_pin_xy "PP3_H" $poutpins]


  # drawing origin
  set base_x -500
  set base_y 0

  # spacings between 4:2 adder icons
  set xfudge $icon_x
  set yfudge [expr $icon_y / 4]

  # wire stub lengths
  set ws1 50

  # useful constants
  set maxaidx [expr $NBITS_A - 1]
  set maxbidx [expr $NBITS_B - 1]
  set NRESBITS [expr ($NBITS_A + $NBITS_B)]
  set maxresidx [expr $NRESBITS - 1]
  if {$NBITS_A > $NBITS_B} {
    set NBITS_max $NBITS_A
  } else {
    set NBITS_max $NBITS_B
  }

  # figure out how many rows of 4:2 adders are needed
  # figure out how many boxes are in each row, and how many total boxes, and the max number of boxes in one row
  set ok [generators_mul_compute_boxcount $NBITS_A $Bit $zeroopt rowcount boxcount]

  # first we will figure out the maximum number of boxes per row, and initialize their locations
  # to something bogus.  later the code will place the correct number of boxes in real locations.
  # we will use the bogus location flag to indicate that the box doesn't exist, so its "outputs"
  # will get wired to logic 0 when they are used as inputs elsewhere.
  for {set i 0} {$i < $rowcount} {incr i} {
    set n [expr $rowcount - $i - 1]
    set bc [expr int(pow(2,$n))]
    for {set j 0} {$j < $bc} {incr j} {
      set adderloc($i,$j) "-1000 -1000 -1"
    }
  }

  if {$AddExtraCSA} { 
    set boxcount($rowcount) 1
    incr rowcount
    set adderloc($lastrow,1) "0 0 0"
  }
  set lastrow [expr $rowcount - 1]

  set totboxcount 0
  for {set i 0} {$i < $rowcount} {incr i} {
    set totboxcount [expr $totboxcount + $boxcount($i)]
  }
  set maxboxcount $boxcount(0)


  # figure out carry signal bit ranges
  set c_count [expr $totboxcount - 1]
  set carry_count [expr $c_count - 1]
  if {$c_count == 0} {
    set c_bitrange ""
  } else {
    set c_bitrange [format "\[%d\:0\]" $c_count]
  }
  if {$carry_count == 0} {
    set carry_bitrange ""
  } else {
    set carry_bitrange [format "\[%d\:0\]" $carry_count]
  }

  set x 0
  set inflag_x $base_x
  set top_y [expr $base_y - (($maxboxcount * ($icon_y + $yfudge)) + (2 * $yfudge))]
  set bot_y [expr $base_y + $icon_y + $yfudge]
  set boxnum -1
  set pin_pos 0


  for {set i 0} {$i < $rowcount} {incr i} {
    set bcount $boxcount($i)  
    set y $base_y

    for {set j 0} {$j < $bcount} {incr j} {
      incr boxnum

      # in the first row, place ppg logic before each 4:2 adder
      if {$i == 0} {
	# select the chunk bits
	set chunk($j) ""
	for {set k 0} {$k < 4} {incr k} {
	  set chunkidx [expr ($j * 4) + $k]
	  if {$chunkidx >= [string length $Algorithm]} {
	    break
	  }
	  if {$OptimizeMulArray == "LSB"} {
	    # select only non-zero bits
	    lappend chunk($j) [lindex $algidx $chunkidx]
	  } else {
	    # select sequential bits
	    lappend chunk($j) $chunkidx
	  }
	}
	set ppgname($j) [NAME_mmig_ppg_4bit -NBITS_A $NBITS_A -NBITS_B $NBITS_B -A $A -B $B -Bit $Bit -Chunk $chunk($j) -Box $j -HalfHeight $HalfHeight]
	generate mmig_ppg_4bit $ppgname($j) -NBITS_A $NBITS_A -NBITS_B $NBITS_B -A $A -B $B -Bit $Bit -Chunk $chunk($j) -Box $j -HalfHeight $HalfHeight
	make $ppgname($j) -origin "$x $y"
	set ppgloc($j) "$x $y"
	set x [expr $x + $icon_x + $xfudge]
      }


      # place 4:2 adder
      make $m42a -origin "$x $y" 

      # record placement
      set adderloc($i,$j) "$x $y $boxnum"

      # connect first row of 4:2 adders to ppg cell
      if {$i == 0} {
	for {set k 1} {$k < 5} {incr k} {
	  set apin_x [expr $x + $port_in_x([expr 5 - $k])]
	  set apin_y [expr $y + $port_in_y([expr 5 - $k])]
	  set ppin_x [expr [lindex $ppgloc($j) 0] + $ppg_port_pp_x([expr $k - 1])]
	  set ppin_y [expr [lindex $ppgloc($j) 1] + $ppg_port_pp_y([expr $k - 1])]
	  set nnet_x [expr int(($apin_x - $ppin_x)/2) + $ppin_x]
	  make_wire $apin_x $apin_y $nnet_x $ppin_y
	  set pin_name [format "PP%d_H" $pin_pos]
	  make name_net_s -origin "$nnet_x $ppin_y" -name $pin_name
	  make_wire $nnet_x $ppin_y $ppin_x $ppin_y
	  incr pin_pos
	}

      } else {
	# wire backwards if it's not the first row
	# note that the extra CSA row's in3, in4 inputs come from outside this schematic
	for {set z 1} {$z < 5} {incr z} {
	  set prev_idx_x [expr $i - 1]
	  # in1, in2 connect to the upper box in previous row
	  # in3, in4 connect to the lower box in previous row
	  if {($z < 3)} {
	    set prev_idx_y [expr 2*$j + 1]
	  } else {
	    set prev_idx_y [expr 2*$j]
	  }
	  set prev_origin_x [lindex $adderloc($prev_idx_x,$prev_idx_y) 0]
	  set prev_origin_y [lindex $adderloc($prev_idx_x,$prev_idx_y) 1]
	  set prev_boxnum [lindex $adderloc($prev_idx_x,$prev_idx_y) 2]

	  if {($z == 1) || ($z == 3)} {
	    if {($z == 1) && ($i == $lastrow) && ($AddExtraCSA == 1)} {
	      # wire up in1 to the extra CSA input
	      set curr_x [expr $x + $port_in_x($z)]
	      set curr_y [expr $y + $port_in_y($z)]
	      set bend_x [expr $curr_x - 30]
	      set csa_y [expr $top_y + $yfudge]
	      make_wire $curr_x $curr_y $bend_x $curr_y
	      make_wire $bend_x $curr_y $bend_x $csa_y
	      make_wire $bend_x $csa_y $inflag_x $csa_y
	      make input -origin "$inflag_x $csa_y" -name "CSA_A_H"
	    } else {
	      if {$prev_boxnum != -1} {
		# previous box is present
		# in1, in3 connect to sum ports of previous row
		set wname [format "S_%d_%d_H" $prev_idx_x $prev_idx_y]
		set bend_mul 2
		# hook em up
		set prev_x [expr $prev_origin_x + $port_sum_x]
		set prev_y [expr $prev_origin_y + $port_sum_y]
		set bend_x [expr $prev_x + $ws1]
		set curr_x [expr $x + $port_in_x($z)]
		set curr_y [expr $y + $port_in_y($z)]
		make_wire $prev_x $prev_y $bend_x $prev_y
		make name_net -name $wname -origin "$bend_x $prev_y"
		make_wire $bend_x $prev_y $bend_x $curr_y
		make_wire $bend_x $curr_y $curr_x $curr_y
	      } else {
		# previous box doesn't exist
		set curr_x [expr $x + $port_in_x($z)]
		set curr_y [expr $y + $port_in_y($z)]
		set bend_x [expr $curr_x - $ws1]
		make_wire $curr_x $curr_y $bend_x $curr_y
		make global -origin "$bend_x $curr_y" -name gnd
	      }
	    }
	  } else {
	    if {($z == 2) && ($i == $lastrow) && ($AddExtraCSA == 1)} {
	      # wire up in2 to the extra CSA input
	      set curr_x [expr $x + $port_in_x($z)]
	      set curr_y [expr $y + $port_in_y($z)]
	      set bend_x [expr $curr_x - 50]
	      set csa_y [expr $top_y + $yfudge + $ws1]
	      make_wire $curr_x $curr_y $bend_x $curr_y
	      make_wire $bend_x $curr_y $bend_x $csa_y
	      make_wire $bend_x $csa_y $inflag_x $csa_y
	      make input -origin "$inflag_x $csa_y" -name "CSA_B_H"
	    } else {
	      if {$prev_boxnum != -1} {
		# in2, in4 connect to carry out ports of previous bitslice
		set prev_x [expr $prev_origin_x + $port_carry_x]
		set prev_y [expr $prev_origin_y + $port_carry_y]
		set bend_x [expr $prev_x + $ws1]
		set curr_x [expr $x + $port_in_x($z)]
		set curr_y [expr $y + $port_in_y($z)]
		set wname [format "C0_%d_%d_H" $prev_idx_x $prev_idx_y]
		make_wire $curr_x $curr_y $bend_x $curr_y
		make_wire $bend_x $curr_y $bend_x $bot_y
		if {$carry_count > 0} {
		  make name_net_s -name "\[$prev_boxnum\]" -origin "$bend_x $bot_y"
		}
		make_wire $bend_x $bot_y $bend_x [expr $bot_y + 2*$ws1]
		if {(($i == 1) || (($i == 0) && ($i == $lastrow)))} {
		  if {($j == 0) && ($z == 4)} {
		    make_wire $bend_x [expr $bot_y + 2*$ws1] $bend_x [expr $bot_y + 3*$ws1]
		    make input -origin "$bend_x [expr $bot_y + 3*$ws1]" -name "CarryIn_H$carry_bitrange" -orient R270
		  } else {
		    make_wire $bend_x [expr $bot_y + 2*$ws1] [expr $bend_x - 2*$icon_x - 2*$xfudge] [expr $bot_y + 2*$ws1]
		  }
		} else {
		  make_wire $bend_x [expr $bot_y + 2*$ws1] [expr $bend_x - $icon_x - $xfudge] [expr $bot_y + 2*$ws1]
		}
	      } else {
		# previous box doesn't exist
		set curr_x [expr $x + $port_in_x($z)]
		set curr_y [expr $y + $port_in_y($z)]
		set bend_x [expr $curr_x - $ws1]
		make_wire $curr_x $curr_y $bend_x $curr_y
		make global -origin "$bend_x $curr_y" -name gnd		
	      }
	    }
	  }
	}
      }


      # wire up the cout
      set cout_x [expr $x + $port_cout_x]
      set cout_y [expr $y + $port_cout_y]
      make_wire $cout_x $cout_y $cout_x $top_y
      if {$c_count > 0} {
	make name_net_s -name "\[$boxnum\]" -origin "$cout_x $top_y"
      }
      make_wire $cout_x $top_y $cout_x [expr $top_y - $ws1]
      if {$i == 0} {
	if {$j == 0} {
	  make_wire $cout_x [expr $top_y - $ws1] $cout_x [expr $top_y - 3 * $ws1]
	  make output -origin "$cout_x [expr $top_y - 3 * $ws1]" -name "Cout_L$c_bitrange" -orient R270
	} else {
	  make_wire $cout_x [expr $top_y - $ws1] [expr $cout_x - 2*$icon_x - 2*$xfudge] [expr $top_y - $ws1]
	}
      } else {
	make_wire $cout_x [expr $top_y - $ws1] [expr $cout_x - $icon_x - $xfudge] [expr $top_y - $ws1]
      }

      # wire up the cin 
      set cin_x [expr $x + $port_cin_x]
      set cin_y [expr $y + $port_cin_y]
      make_wire $cin_x $cin_y $cin_x $bot_y
      if {$c_count > 0} {
	make name_net_s -name "\[$boxnum\]" -origin "$cin_x $bot_y"
      }
      make_wire $cin_x $bot_y $cin_x [expr $bot_y + $ws1]
      if {$i == 0} {
	if {$j == 0} {
	  make_wire $cin_x [expr $bot_y + $ws1] $cin_x [expr $bot_y + 3 * $ws1]
	  make input -origin "$cin_x [expr $bot_y + 3 * $ws1]" -name "Cin_L$c_bitrange" -orient R270
	} else {
	  make_wire $cin_x [expr $bot_y + $ws1] [expr $cin_x - 2*$icon_x - 2*$xfudge] [expr $bot_y + $ws1]
	}
      } else {
	make_wire $cin_x [expr $bot_y + $ws1] [expr $cin_x - $icon_x - $xfudge] [expr $bot_y + $ws1]
      }

      # wire up the carry out
      if {$i != $lastrow} {
	set carry_x [expr $x + $port_carry_x]
	set carry_y [expr $y + $port_carry_y]
	set bend_x [expr $carry_x + $ws1]
	make_wire $carry_x $carry_y $bend_x $carry_y
	make_wire $bend_x $carry_y $bend_x $top_y
	if {$carry_count > 0} {
	  make name_net_s -name "\[$boxnum\]" -origin "$bend_x $top_y"
	}
	make_wire $bend_x $top_y $bend_x [expr $top_y - 2*$ws1]
	if {$i == 0} {
	  if {$j == 0} {
	    make_wire $bend_x [expr $top_y - 2*$ws1] $bend_x [expr $top_y - 3 * $ws1]
	    make output -origin "$bend_x [expr $top_y - 3 * $ws1]" -name "CarryOut_H$carry_bitrange" -orient R270
	  } else {
	    make_wire $bend_x [expr $top_y - 2*$ws1] [expr $bend_x - 2*$icon_x - 2*$xfudge] [expr $top_y - 2*$ws1]
	  }
	} else {
	  make_wire $bend_x [expr $top_y - 2*$ws1] [expr $bend_x - $icon_x - $xfudge] [expr $top_y - 2*$ws1]
	}
      }

      # next box placement
      set x [expr $x + $icon_x + $xfudge]
      set y [expr $y - $icon_y - $yfudge]
    }
  }

  # final sum, carry out
  set curr_origin_x [lindex $adderloc($lastrow,0) 0]
  set curr_origin_y [lindex $adderloc($lastrow,0) 1]
  # sum
  set curr_x [expr $curr_origin_x + $port_sum_x]
  set curr_y [expr $curr_origin_y + $port_sum_y]
  set end_x [expr $curr_x + (4 * $ws1)]
  make_wire $curr_x $curr_y $end_x $curr_y
  make output -origin "$end_x $curr_y" -name "Sum_H"
  # carry
  set curr_x [expr $curr_origin_x + $port_carry_x]
  set curr_y [expr $curr_origin_y + $port_carry_y]
  set end_x [expr $curr_x + (4 * $ws1)]
  make_wire $curr_x $curr_y $end_x $curr_y
  make output -origin "$end_x $curr_y" -name "Carry_H"


  # wire up the inputs to the PPG logic
  # get A bit usage info
  set abitslice [generators_mul_get_ppg_bitslice "A" $Bit]
  setl {nabranges abranges} [generators_mul_get_range $abitslice]
  setl {nbits_ab abrange} [lindex $abranges 0]
  # get B bit usage info
  set bbitslice [generators_mul_get_ppg_bitslice "B" $Bit]
  setl {nbbranges bbranges} [generators_mul_get_range $bbitslice]
  setl {nbits_bb bbrange} [lindex $bbranges 0]

  for {set i 0} {$i < $boxcount(0)} {incr i} {
    # get ppg icon info
    set ppg_x [lindex $ppgloc($i) 0]
    set ppg_y [lindex $ppgloc($i) 1]
    setl {pcount pinpins poutpins pinoutpins} [generators_get_pin_info $ppgname($i)]

    # A
    set abits [generators_mul_get_ppg_chunk "A" $Bit $chunk($i)]
    setl {naranges aranges} [generators_mul_get_range $abits]
    set pinnames [generators_mul_get_pinnames $naranges $aranges]
    for {set j 0} {$j < $naranges} {incr j} {
      setl {nbits_a arange} [lindex $aranges $j]
      set pinname [lindex $pinnames $j]
      if {$pinname == "msb"} {
	set aname Amsb_H
      } else {
	set aname A_H$pinname
      }
      # find the pin location on ppg_4bit
      setl {ppg_port_a_x ppg_port_a_y} [generators_get_pin_xy $aname $pinpins]
      set a_x [expr $ppg_x + $ppg_port_a_x]
      set a_y [expr $ppg_y + $ppg_port_a_y]
      make_wire $a_x $a_y $inflag_x $a_y
      # create the pin name at this schematic level
      set uppinname [generators_mul_get_uppinname $nabranges $abranges $arange]
      if {$uppinname == "msb"} {
	make input -origin "$inflag_x $a_y" -name Amsb_H
      } else {
	make input -origin "$inflag_x $a_y" -name A_H$uppinname
      }
    }
    
    # B
    set bbits [generators_mul_get_ppg_chunk "B" $Bit $chunk($i)]
    setl {nbranges branges} [generators_mul_get_range $bbits]
    set pinnames [generators_mul_get_pinnames $nbranges $branges]
    if {$nbranges > 0} {
      setl {nbits_b brange} [lindex $branges 0]
      set pinname [lindex $pinnames 0]
      set bname B_H$pinname
      # find the pin location on ppg_4bit
      setl {ppg_port_b_x ppg_port_b_y} [generators_get_pin_xy $bname $pinpins]
      set b_x [expr $ppg_x + $ppg_port_b_x]
      set b_y [expr $ppg_y + $ppg_port_b_y]
      make_wire $b_x $b_y $inflag_x $b_y
      # create the pin name at this schematic level
      set uppinname [generators_mul_get_uppinname $nbbranges $bbranges $brange]
      make input -origin "$inflag_x $b_y" -name B_H$uppinname
    }

    # ASigned
    set asigned [generators_mul_get_ppg_chunk "ASIGNED" $Bit $chunk($i)]
    if {$asigned != 0} {
      setl {ppg_port_ASigned_x ppg_port_ASigned_y} [generators_get_pin_xy "ASigned_H" $pinpins]
      set ASigned_x [expr $ppg_x + $ppg_port_ASigned_x]
      set ASigned_y [expr $ppg_y + $ppg_port_ASigned_y]
      make_wire $ASigned_x $ASigned_y $inflag_x $ASigned_y
      make input -origin "$inflag_x $ASigned_y" -name ASigned_H
    }

    # BSigned
    set bsigned [generators_mul_get_ppg_chunk "BSIGNED" $Bit $chunk($i)]
    if {$bsigned != 0} {
      setl {ppg_port_BSigned_x ppg_port_BSigned_y} [generators_get_pin_xy "BSigned_H" $pinpins]
      set BSigned_x [expr $ppg_x + $ppg_port_BSigned_x]
      set BSigned_y [expr $ppg_y + $ppg_port_BSigned_y]
      make_wire $BSigned_x $BSigned_y $inflag_x $BSigned_y
      make input -origin "$inflag_x $BSigned_y" -name BSigned_H
    }
  }

  # figure out if we need to add a spacer to match the height of the rest of the array.
  # in the optimized rows, want to push the cells to the right end, so that the inter-row
  # carry signals have the shortest possible length.
  if {$totboxcount < $PPGTOTBOXCOUNT} {
    # number of missing 4:2 adder cells
    set boxdiff [expr $PPGTOTBOXCOUNT - $totboxcount]
    set boxht [generators_get_cell_height $m42a 0]
    set boxrows [expr $boxdiff * $boxht / 10]

    # number of missing PPG cells
    set ppgdiff [expr $PPGBOXCOUNT(0) - $boxcount(0)]
    set ppgrows 0
    for {set i 0} {$i < $ppgdiff} {incr i} {
      set ppgrows [expr $ppgrows + [lindex $PPGROWSIZE $i]]
    }

    # spacer amount
    set rname [format "%dr" [expr $ppgrows + $boxrows]]
    make spacer -origin "[expr $inflag_x - 100] [expr $bot_y - 2 * $icon_y]" -rows $rname
  }


  # title bar
  make sccs_title_bar -origin "0 [expr $bot_y + 2 * $icon_y]" -owner emc -version 0.3 -date 06/13/00
}


proc ICON_mmig_mul_ppg_slice args {
  # This line is needed for all generators
  icon_generator $args {{NBITS_A 8} {NBITS_B 8} {A "Unsigned" {radio Signed Unsigned Both}} {B "Unsigned" {radio Signed Unsigned Both}} {AddExtraCSA 0 binary} {OptimizeMulArray "None" {radio None Lsb}} {HalfHeight 0 binary} {Bit 0}}
  
  # make the arguments more digestible
  set A [string toupper $A]
  set B [string toupper $B]
  set OptimizeMulArray [string toupper $OptimizeMulArray]

  # useful constants
  set maxaidx [expr $NBITS_A - 1]
  set maxbidx [expr $NBITS_B - 1]
  set NRESBITS [expr ($NBITS_A + $NBITS_B)]
  set maxresidx [expr $NRESBITS - 1]
  if {$NBITS_A > $NBITS_B} {
    set NBITS_max $NBITS_A
  } else {
    set NBITS_max $NBITS_B
  }

  # don't let the user get too crazy
  if {$NRESBITS > 128} {
    error "ERROR: NBITS_A + NBITS_B = $NRESBITS not supported"
  }
  
  # check that NBITS_A is > 1
  if {$NBITS_A < 1} {
    error "ERROR: NBITS_A ($NBITS_A) not supported"
  }
  # check that NBITS_B is > 1
  if {$NBITS_B < 1} {
    error "ERROR: NBITS_B ($NBITS_B) not supported"
  }

  # check for acceptable response on A query
  if {($A != "SIGNED") &&
      ($A != "UNSIGNED") &&
      ($A != "BOTH")} {
    error "ERROR: A property ($A) must be Signed or Unsigned or Both"
  }

  # check for acceptable response on B query
  if {($B != "SIGNED") &&
      ($B != "UNSIGNED") &&
      ($B != "BOTH")} {
    error "ERROR: B property ($B) must be Signed or Unsigned or Both"
  }
    
  # check for acceptable response on AddExtraCSA query
  if {($AddExtraCSA != 1) && ($AddExtraCSA != 0)} {
    error "ERROR: AddExtraCSA property ($AddExtraCSA) must be 0 or 1"
  }

  # check for acceptable response on OptimizeMulArray query
  if {($OptimizeMulArray != "NONE") && ($OptimizeMulArray != "LSB")} {
    error "ERROR: OptimizeMulArray property ($OptimizeMulArray) must be NONE or LSB"
  }
  if {$OptimizeMulArray == "LSB"} {
    set zeroopt 1
  } else {
    set zeroopt 0
  }

  # check for acceptable response on HalfHeight query
  if {($HalfHeight != 1) && ($HalfHeight != 0)} {
    error "ERROR: HalfHeight property ($HalfHeight) must be 0 or 1"
  }

  # check for acceptable response on Bit
  if {$Bit < 0} {
    error "ERROR: Bit ($Bit) must be >= 0"
  }
  if {$Bit > $maxresidx} {
    error "ERROR: Bit ($Bit) must be less than (NBITS_A + NBITS_B - 1)"
  }

  
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}

  set debug 0
  if {$debug} {
    set ok [generators_mul_compute_ppg_alg $NBITS_A $NBITS_B $A $B "SIMPLE"]  
  }

  icon_line -200 -150 200 -150 200 150 -200 150 -200 -150
  
  # get A bit usage info
  set abits [generators_mul_get_ppg_bitslice "A" $Bit]
  setl {naranges aranges} [generators_mul_get_range $abits]
  for {set i 0} {$i < $naranges} {incr i} {
    setl {nbits_a arange} [lindex $aranges $i]    
    if {($naranges == 2) && ($i == 0)} {
      # this is the msb bit
      set aname Amsb_H
      icon_term -type input -origin "-200 -60" -name $aname
      icon_property -origin "-190 -60" -size small -label A_H$arange
    } else {
      if {$nbits_a > 1} {
	set aname A_H$arange
      } else {
	set aname A_H
      }
      icon_term -type input -origin "-200 -30" -name $aname
      icon_property -origin "-190 -30" -size small -label A_H$arange
    }
  }

  # get B bit usage info
  set bbits [generators_mul_get_ppg_bitslice "B" $Bit]
  setl {nbranges branges} [generators_mul_get_range $bbits]
  if {$nbranges > 0} {
    setl {nbits_b brange} [lindex $branges 0]
    if {$nbits_b > 1} {
      set bname B_H$brange
    } else {
      set bname B_H
    }
    icon_term -type input -origin "-200 30" -name $bname
    icon_property -origin "-190 30" -size small -label B_H$brange
  }

  if {$AddExtraCSA == 1} {
    icon_term -type input -origin "-200 -110" -name CSA_A_H
    icon_property -origin "-190 -110" -size small -label CSA_A_H
    icon_term -type input -origin "-200 -90" -name CSA_B_H
    icon_property -origin "-190 -90" -size small -label CSA_B_H
  }
  
  icon_term -type output -origin "200 -10" -name Sum_H
  icon_property -origin "190 -20" -size small -label "Sum_H" -anchor e
  icon_term -type output -origin "200 10" -name Carry_H
  icon_property -origin "190 20" -size small -label "Carry_H" -anchor e
  
  # get ASigned usage info
  set asigned_usage [generators_mul_get_ppg_bitslice "ASIGNED" $Bit]
  if {$asigned_usage != 0} {
    icon_term -type input -origin "-200 110" -name ASigned_H
    icon_property -origin "-190 110" -size small -label ASigned_H
  }

  # get BSigned usage info
  set bsigned_usage [generators_mul_get_ppg_bitslice "BSIGNED" $Bit]
  if {$bsigned_usage != 0} {
    icon_term -type input -origin "-200 90" -name BSigned_H
    icon_property -origin "-190 90" -size small -label BSigned_H
  }

  # figure out how many rows of 4:2 adders are needed
  # figure out how many boxes are in each row, and how many total boxes, and the max number of boxes in one row
  set ok [generators_mul_compute_boxcount $NBITS_A $Bit $zeroopt rowcount boxcount]

  if {$AddExtraCSA} {
    set boxcount($rowcount) 1
    incr rowcount
  }

  set totboxcount 0
  for {set i 0} {$i < $rowcount} {incr i} {
    set totboxcount [expr $totboxcount + $boxcount($i)]
  }

  set c_count [expr $totboxcount - 1]
  set carry_count [expr $c_count - 1]
  if {$c_count == 0} {
    set c_bitrange ""
  } else {
    set c_bitrange [format "\[%d\:0\]" $c_count]
  }
  if {$carry_count == 0} {
    set carry_bitrange ""
  } else {
    set carry_bitrange [format "\[%d\:0\]" $carry_count]
  }
  
  icon_term -type input -origin "-40 150" -orient R270 -name "Cin_L$c_bitrange"
  icon_property -origin "-40 130" -size small -label "Cin_L" -anchor center
  icon_property -origin "-40 140" -size small -label $c_bitrange -anchor center
  
  icon_term -type output -origin "-40 -150" -orient R270 -name "Cout_L$c_bitrange"
  icon_property -origin "-40 -140" -size small -label "Cout_L" -anchor center
  icon_property -origin "-40 -130" -size small -label $c_bitrange -anchor center
  
  if {$c_count != 0} {
    icon_term -type output -origin "40 -150" -orient R270 -name "CarryOut_H$carry_bitrange"
    icon_property -origin "40 -140" -size small -label "CarryOut_H" -anchor center
    icon_property -origin "40 -130" -size small -label $carry_bitrange -anchor center
  
    icon_term -type input -origin "40 150" -orient R270 -name "CarryIn_H$carry_bitrange"
    icon_property -origin "40 130" -size small -label "CarryIn_H" -anchor center
    icon_property -origin "40 140" -size small -label $carry_bitrange -anchor center
  }  


  # A
  if {$A == "SIGNED"} {
    set wname [format "%dSx" $NBITS_A]
  }
  if {$A == "UNSIGNED"} {
    set wname [format "%dUx" $NBITS_A]
  }
  if {$A == "BOTH"} {
    set wname [format "%dBx" $NBITS_A]
  }
  # B
  if {$B == "SIGNED"} {
    set wname [format "%s%dS" $wname $NBITS_B]
  }
  if {$B == "UNSIGNED"} {
    set wname [format "%s%dU" $wname $NBITS_B]
  }
  if {$B == "BOTH"} {
    set wname [format "%s%dB" $wname $NBITS_B]
  }

  icon_property -origin "0 -50" -size large -label $wname -anchor center
  icon_property -origin "0 -30" -size large -label "PPG &" -anchor center
  icon_property -origin "0 -10" -size large -label "Multiplier Tree" -anchor center
  icon_property -origin "0 10" -size large -label "Bit $Bit" -anchor center
  icon_property -origin "0 30" -size large -label {$name} -anchor center

  if {$HalfHeight == 1} {
    icon_property -origin "0 50" -size small -label {HH} -anchor center
  }
  
  icon_property -origin "-70 350" -type user -name name
  icon_property -origin "-70 370" -type user -name M
  icon_property -origin "-70 390" -type user -name dpc
  
  icon_special -type sccs_title_bar -origin "-70 440" -owner emc -version 0.3 -date 06/13/00
}


 

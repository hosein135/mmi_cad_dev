# This is a generator for fast queues of small depth.

proc NAME_fastqueue args {
  call_use_keyword $args {{NBITS 32} {Depth 4} {OutputSize "C"}}

  # NBITS
  set nom [format "fastqueue_%d" $NBITS]

  # OutputSize
  if {[string toupper $OutputSize] == "C"} {
    set nom [format "%sC" $nom]
  }
  if {[string toupper $OutputSize] == "D"} {
    set nom [format "%sD" $nom]
  }
  if {[string toupper $OutputSize] == "E"} {
    set nom [format "%sE" $nom]
  }

  # Depth
  set nom [format "%s%d" $nom $Depth]

  return $nom
}


proc SCHEMATIC_fastqueue args {
  call_use_keyword $args {{NBITS 32} {Depth 4} {OutputSize "C"}}

  # make the arguments more digestible
  # NBITS
  set maxidx [expr $NBITS - 1]
  # bitranges
  if {$NBITS == 1} {
    set max_bitrange [format "\[0\]"]
    set vmax_bitrange ""
  } else {
    set max_bitrange [format "\[%d:0\]" $maxidx]
    set vmax_bitrange $max_bitrange
  }


  # figure out how many select bits there are 
  set sel_bitrange [format "\[%d:0\]" [expr $Depth - 1]]


  # select the mux cells
  for {set i 0} {$i < $Depth} {incr i} {
      set muxcell($i) "MMIG_QUE_MUX2B"
  }


  # mux icon properties
  set icon_mux_x 120
  set icon_mux_x 120
  set icon_mux_y 140
  set port_in_x(0) -60
  set port_in_y(0) -30
  set port_in_x(1) $port_in_x(0)
  set port_in_y(1) [expr $port_in_y(0) + 60]
  set maxport 1
  set port_out_x 60
  set port_out_y 0
  set port_sel_x 0
  set port_sel_y 50
  set icon_mux_left [expr -($icon_mux_x / 2)]
  set icon_mux_right [expr ($icon_mux_x / 2)]
  set icon_mux_top [expr -($icon_mux_y / 2)]
  set icon_mux_bot [expr ($icon_mux_y / 2)]

  # buffer icon properties
  set icon_buf_x 120
  set port_buf_in_x -60
  set port_buf_in_y 0
  set port_buf_out_x 60
  set port_buf_out_y 0

  # FF icon properties
  set icon_ff_x 120
  set icon_ff_y 160
  set port_ff_in_x -60
  set port_ff_in_y 0
  set port_ff_out_x 60
  set port_ff_out_y 0
  set port_ff_clk_x -10
  set port_ff_clk_y 80
  set port_ff_reset_x -30
  set port_ff_reset_y 100
  set port_ff_scan_en_x 10
  set port_ff_scan_en_y 80
  set port_ff_scan_in_x 30
  set port_ff_scan_in_y 80
  set icon_ff_bot [expr ($icon_ff_y / 2)]

  # and2 icon properties
  set icon_and2_x 120
  set port_and2_in_x(0) -60
  set port_and2_in_y(0) -20
  set port_and2_in_x(1) -60
  set port_and2_in_y(1)  20
  set port_and2_out_x 60
  set port_and2_out_y 0

  # and3 icon properties
  set icon_and3_x 120
  set port_and3_in_x(0) -60
  set port_and3_in_y(0) -20
  set port_and3_in_x(1) -60
  set port_and3_in_y(1)  0
  set port_and3_in_x(2) -60
  set port_and3_in_y(2)  20
  set port_and3_out_x 60
  set port_and3_out_y 0

  # and4 icon properties
  set icon_and4_x 120
  set port_and4_in_x(0) -60
  set port_and4_in_y(0) -30
  set port_and4_in_x(1) -60
  set port_and4_in_y(1) -10
  set port_and4_in_x(2) -60
  set port_and4_in_y(2) 10
  set port_and4_in_x(3) -60
  set port_and4_in_y(3) 30
  set port_and4_out_x 60
  set port_and4_out_y 0

  # wire stub lengths
  set ws1 40
  set ws2 2*$ws1
  
  # distances
  set xfudge [expr 3 * $ws2]
  set delta_x [expr $icon_mux_x + $xfudge + $icon_ff_x + $xfudge]

  # init drawing location
  set x 0
  set y 0

  # wire tracks
  set inflag_x [expr $x - (6 * $ws1)]
  set outflag_x [expr $x + ($Depth * $delta_x) + ($icon_and2_x + 8*$ws1 + $icon_buf_x)]
  set sel_y [expr $y + $icon_ff_bot + 3*$ws1]
  set reset_y [expr $sel_y + $ws1]
  set clk_y [expr $reset_y + $ws1]
  set fdbk_y [expr $icon_mux_top - 3*$ws1]
  set ao_y [expr $fdbk_y - 3*$ws1]
  set head_y [expr $ao_y - 3*$ws1]
  set rs_y [expr $head_y - 3*$ws1]
  set name_y [expr $sel_y - $ws1]

  # generate devices
  generate MMI_FFC MMI_FFCB -Size B
  generate MMI_NAND2 MMI_NAND2B -Size B

  # draw the shifter
  for {set i 0} {$i < $Depth} {incr i} {

    # place mux cell
    set mux_x $x
    make $muxcell($i) -origin "$mux_x $y" -name "$max_bitrange"

    # place FF
    set ff_x [expr $mux_x + $icon_mux_right + $xfudge + [expr $icon_ff_x / 2]]
    make MMI_FFCB -origin "$ff_x $y" -name "$max_bitrange"

    # hook scan_en to gnd
    set pin_x [expr $ff_x + $port_ff_scan_en_x]
    set pin_y [expr $y + $port_ff_scan_en_y]
    make global -name gnd -origin "$pin_x $pin_y"

    # hook scan_in to gnd
    set pin_x [expr $ff_x + $port_ff_scan_in_x]
    set pin_y [expr $y + $port_ff_scan_in_y]
    make global -name gnd -origin "$pin_x $pin_y"

    # wire between mux & FF
    set muxout_x [expr $mux_x + $port_out_x]
    set muxout_y [expr $y + $port_out_y]
    set nnet_x [expr $muxout_x + 3*$ws1]
    set ffin_x [expr $ff_x + $port_ff_in_x]
    set ffin_y [expr $y + $port_ff_in_y]
    make_wire $muxout_x $muxout_y $nnet_x $muxout_y
    set lname [format "Mux%d_H%s" $i $vmax_bitrange]
    make name_net_s -origin "$nnet_x $muxout_y" -name $lname
    make_wire $nnet_x $muxout_y $ffin_x $ffin_y

    # wire up clk
    set pin_x [expr $ff_x + $port_ff_clk_x]
    set pin_y [expr $y + $port_ff_clk_y]
    set nnet_y $name_y
    make_wire $pin_x $pin_y $pin_x $nnet_y
    set lname [format "\[%d\]" $i]
    make name_net_s -origin "$pin_x $nnet_y" -name $lname -orient R90
    make_wire $pin_x $nnet_y $pin_x $clk_y
    if {$i == 0} {
      make_wire $pin_x $clk_y $inflag_x $clk_y
      set lname [format "Clk\[%d:0\]" [expr $Depth - 1]]
      make input -name $lname -origin "$inflag_x $clk_y"
    } else {
      make_wire $pin_x $clk_y [expr $pin_x - $delta_x] $clk_y
    }

    # wire up reset
    set pin_x [expr $ff_x + $port_ff_reset_x]
    set pin_y [expr $y + $port_ff_reset_y]
    set nnet_y $name_y
    make_wire $pin_x $pin_y $pin_x $nnet_y
    set lname [format "\[%d\]" $i]
    make name_net_s -origin "$pin_x $nnet_y" -name $lname -orient R90X
    make_wire $pin_x $nnet_y $pin_x $reset_y
    if {$i == 0} {
      make_wire $pin_x $reset_y $inflag_x $reset_y
      set lname [format "Reset_L\[%d:0\]" [expr $Depth - 1]]
      make input -name $lname -origin "$inflag_x $reset_y"
    } else {
      make_wire $pin_x $reset_y [expr $pin_x - $delta_x] $reset_y
    }

    # wire up select
    set pin_x [expr $mux_x + $port_sel_x]
    set pin_y [expr $y + $port_sel_y]
    set nnet_y $name_y
    make_wire $pin_x $pin_y $pin_x $nnet_y
    set lname [format "\[%d\]" $i]
    make name_net_s -origin "$pin_x $nnet_y" -name $lname -orient R90
    make_wire $pin_x $nnet_y $pin_x $sel_y
    if {$i == 0} {
      make_wire $pin_x $sel_y $inflag_x $sel_y
      set lname [format "Push_H\[%d:0\]" [expr $Depth - 1]]
      make input -name $lname -origin "$inflag_x $sel_y"
    } else {
      make_wire $pin_x $sel_y [expr $pin_x - $delta_x] $sel_y
    }

    # wire output of FF
    set ffout_x [expr $ff_x + $port_ff_out_x]
    set ffout_y [expr $y + $port_ff_out_y]
    set nnet_x [expr $ffout_x + $ws2]
    make_wire $ffout_x $ffout_y $nnet_x $ffout_y
    set lname [format "R%d_H%s" $i $vmax_bitrange]
    make name_net_s -origin "$nnet_x $ffout_y" -name $lname
    set stub_x [expr $nnet_x + $ws1]
    make_wire $nnet_x $ffout_y $stub_x $ffout_y

    # wire up the inputs
    # in0:  hold
    make_wire $stub_x $ffout_y $stub_x $fdbk_y
    set pin_x [expr $mux_x + $port_in_x(0)]
    set pin_y [expr $y + $port_in_y(0)]
    set hold_x [expr $pin_x - $ws1]
    make_wire $stub_x $fdbk_y $hold_x $fdbk_y
    make_wire $hold_x $fdbk_y $hold_x $pin_y
    make_wire $hold_x $pin_y $pin_x $pin_y

    # in1:  push
    # intermediate inputs
    if {$i == 0} {
      # first stage
      set pin_x [expr $mux_x + $port_in_x(1)]
      set pin_y [expr $y + $port_in_y(1)]
      set lname [format "In_H%s" $vmax_bitrange]
      make_wire $pin_x $pin_y $inflag_x $pin_y
      make input -name $lname -origin "$inflag_x $pin_y"
    } else {
      # not the first stage
      set pin_x [expr $mux_x + $port_in_x($maxport)]
      set pin_y [expr $y + $port_in_y($maxport)]
      set bend_x [expr $pin_x - 3*$ws1]
      set bend_y [expr $y + $port_ff_out_y]
      make_wire $pin_x $pin_y $bend_x $pin_y
      make_wire $bend_x $pin_y $bend_x $bend_y
    }


    # for all stages, add the output NAND2
    # in0:  head[me]
    # in1:  this stage's output
    set ao_x [expr $mux_x + $delta_x]
    set gtype "MMI_NAND2B"

    make $gtype -origin "$ao_x $ao_y" -name $max_bitrange
    set nnet_y [expr $head_y + $ws1]
    # for MMI_NAND2, in1
    set pin_x [expr $ao_x + $port_and2_in_x(1)]
    set pin_y [expr $ao_y + $port_and2_in_y(1)]      
    make_wire $stub_x $fdbk_y $stub_x $pin_y
    make_wire $stub_x $pin_y $pin_x $pin_y
    # for MMI_NAND2, in0
    set pin_x [expr $ao_x + $port_and2_in_x(0)]
    set pin_y [expr $ao_y + $port_and2_in_y(0)]
    make_wire $stub_x $pin_y $pin_x $pin_y
    make_wire $stub_x $pin_y $stub_x $nnet_y
    set lname [format "\[%d\]" $i]
    make name_net_s -origin "$stub_x $nnet_y" -name $lname -orient R90
    make_wire $stub_x $nnet_y $stub_x $head_y
    if {$i == 0} {
      make_wire $stub_x $head_y $inflag_x $head_y
      set lname [format "Head_H\[%d:0\]" [expr $Depth - 1]]
      make input -name $lname -origin "$inflag_x $head_y"
    } else {
      make_wire $stub_x $head_y [expr $stub_x - $delta_x] $head_y
    }

    # label the output
    set olabel [format "Out%d_L%s" $i $vmax_bitrange]
    set pin_x [expr $ao_x + $port_and2_out_x]
    set pin_y [expr $ao_y + $port_and2_out_y]
    set stub_x [expr $pin_x + $ws1]
    make_wire $pin_x $pin_y $stub_x $pin_y
    make name_net_s -origin "$stub_x $pin_y" -name $olabel


    # save this stage's output pin location for the next stage to use
    set prevout_x [expr $ao_x + $port_and2_out_x]
    set out_y $pin_y

    # increment x
    set x [expr $x + $delta_x]
  }

  # add the final gate:  NAND2, 3, or 4
  set prevout_x [expr $prevout_x + 3 * $ws1 + $icon_buf_x]
  if {$Depth == 2} {
    generate MMI_NAND2 MMI_NAND2C_ -Size C -DeMorgan 1
    make MMI_NAND2C_ -origin "$prevout_x $out_y" -name $max_bitrange
  }
  if {$Depth == 3} {
    generate MMI_NAND3 MMI_NAND3C_ -Size C -DeMorgan 1
    make MMI_NAND3C_ -origin "$prevout_x $out_y" -name $max_bitrange
  }
  if {$Depth == 4} {
    generate MMI_NAND4 MMI_NAND4C_ -Size C -DeMorgan 1
    make MMI_NAND4C_ -origin "$prevout_x $out_y" -name $max_bitrange
  }
  # connect the inputs
  for {set pinn 0} {$pinn < $Depth} {incr pinn} {
    if {$Depth == 2} {
      set pin_x $port_and2_in_x($pinn)
      set pin_y $port_and2_in_y($pinn)
    }
    if {$Depth == 3} {
      set pin_x $port_and3_in_x($pinn)
      set pin_y $port_and3_in_y($pinn)
    }
    if {$Depth == 4} {
      set pin_x $port_and4_in_x($pinn)
      set pin_y $port_and4_in_y($pinn)
    }
    set pin_x [expr $prevout_x + $pin_x]
    set pin_y [expr $out_y + $pin_y]
    set stub_x [expr $pin_x - $ws1]
    make_wire $pin_x $pin_y $stub_x $pin_y

    set olabel [format "Out%d_L%s" $pinn $vmax_bitrange]
    make name_net_s -origin "$stub_x $pin_y" -name $olabel
  }

  set prevout_x [expr $prevout_x + $port_and2_out_x]


  # add the output buffer
  if {($OutputSize == "D") || ($OutputSize == "E")}  {
    set buf_x [expr $prevout_x + $icon_buf_x]
    if {$OutputSize == "D"} {
      generate MMI_BUF MMI_BUFD -Size D
      make MMI_BUFD -origin "$buf_x $out_y" -name $max_bitrange
    } else {
      generate MMI_BUF MMI_BUFE -Size E
      make MMI_BUFE -origin "$buf_x $out_y" -name $max_bitrange
    }
    set pin_x [expr $buf_x + $port_buf_in_x]
    make_wire $prevout_x $out_y $pin_x $out_y
    make_wire [expr $buf_x + $port_buf_out_x] $out_y $outflag_x $out_y
    # add row_spanner
    set rswidth [expr $icon_buf_x + $icon_and2_x + ($pin_x - $prevout_x)]
    set rsname [format "row_spanner%d" [expr int($rswidth/2)]]
    generate row_spanner $rsname -width [expr int($rswidth/2)]
    make $rsname -origin "$prevout_x $rs_y"
  } else {
    make_wire $prevout_x $out_y $outflag_x $out_y
  }
  set lname [format "Out_H%s" $vmax_bitrange]
  make output -name $lname -origin "$outflag_x $out_y"


  # title bar
  make sccs_title_bar -origin "[expr int(($outflag_x - $inflag_x)/2)] [expr $clk_y + 150]" -owner emc -version 0.1 -date 12/7/99


}


proc ICON_fastqueue args {
  # This line is needed for all generators
  icon_generator $args {{NBITS 32} {Depth 4} {OutputSize "C" {radio C D E}}}

  # check for acceptable response on NBITS
  if {$NBITS < 1} {
    error "ERROR: NBITS ($NBITS) must be greater than 0"
  }
  # don't let the user get too crazy
  if {$NBITS > 128} {
    error "ERROR: NBITS ($NBITS) not supported"
  }
  set maxidx [expr $NBITS - 1]
  # bitranges
  if {$NBITS == 1} {
    set max_bitrange [format "\[0\]"]
    set vmax_bitrange ""
  } else {
    set max_bitrange [format "\[%d:0\]" $maxidx]
    set vmax_bitrange $max_bitrange
  }

  # check for acceptable response on Depth
  if {$Depth < 2} {
    error "ERROR: Depth ($Depth) must be greater than 1"
  }
  # max 4
  if {$Depth > 4} {
    error "ERROR: Depth ($Depth) not supported"
  }

  # check for acceptable response on OutputSize
  if {([string toupper $OutputSize] != "C") &&
      ([string toupper $OutputSize] != "D") &&
      ([string toupper $OutputSize] != "E")} {
    error "ERROR: OutputSize ($OutputSize) not supported"
  }
      

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}

  # icon body
  set icon_h [expr 20 + (2 * 30)]
  set icon_bot [expr $icon_h / 2]
  set icon_top [expr - ($icon_bot)]
  icon_line -80 $icon_bot -80 $icon_top 80 $icon_top 80 $icon_bot -80 $icon_bot

  # data input
  icon_term -type input -origin {-80 0} -name "In_H$vmax_bitrange"
  icon_property -origin {-70 0} -size small -label In

  # width
  icon_property -origin "-70 [expr $icon_top + 10]" -size small -label $max_bitrange


  # control inputs
  # clock
  set depth_bitrange [format "\[%d:0\]" [expr $Depth - 1]]
  icon_term -type input -origin "0 $icon_bot" -name Clk$depth_bitrange -orient R270
  icon_line -10 $icon_bot 0 [expr $icon_bot - 10] 10 $icon_bot
  # reset
  icon_term -type input -origin "20 $icon_bot" -name Reset_L$depth_bitrange -orient R270
  icon_property -origin "20 [expr $icon_bot - 10]" -size small -anchor center -label R
  # push
  icon_term -type input -origin "-20 $icon_bot" -name Push_H$depth_bitrange -orient R270
  icon_property -origin "-20 [expr $icon_bot -10]" -size small -anchor center -label Push
  # head
  icon_term -type input -origin "40 $icon_bot" -name Head_H$depth_bitrange -orient R270
  icon_property -origin "40 [expr $icon_bot - 10]" -size small -anchor center -label Head

  # outputs
  icon_term -type output -origin {80 0} -name "Out_H$vmax_bitrange"
  icon_property -origin {70 0} -size small -anchor e -label Out_H
  # width
  icon_property -origin "70 [expr $icon_top + 10]" -size small -anchor e -label $max_bitrange

  # text
  set depthlabel [format "%d Deep" $Depth]
  icon_property -origin {0 -20} -anchor center -label "$depthlabel"
  icon_property -origin {0 0} -anchor center -label FastQueue
  icon_property -origin {0 20} -anchor center -label $OutputSize

  # junk
  icon_property -origin {-70 300} -type user -name name
  icon_property -origin {-70 320} -type user -name M
  icon_property -origin {-70 340} -type user -name dpc
  icon_special -type sccs_title_bar -origin {-30 460} -owner emc -version 0.1 -date 12/7/99
  # this property makes a generator pop up in "Schematic" mode rather than "Verilog" mode
  icon_property -origin {-70 360} -type fixed -name netlist_level -text 2000

}

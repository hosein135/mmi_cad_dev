# This is a generator for a bitslice of a multiplier's partial product generation logic.
proc SCHEMATIC_ppg_slice args {
  call_use_keyword $args {{NBITS 8} {Algorithm "Simple"}}

  # drawing origin
  set base_x -500
  set base_y 0

  # wire stub lengths
  set ws1 50

  # icon info
  set nand_x 90
  set nand_y 60
  set nand_in0_x -20
  set nand_in0_y -20
  set nand_in1_x -20
  set nand_in1_y 20
  set nand_out_x 70
  set nand_out_y 0
  set inv_x 80
  set inv_y 60
  set inv_in_x -30
  set inv_in_y 0
  set inv_out_x 50
  set inv_out_y 0

  # spacings between nand-invert icon groups
  # xfudge must be evenly divisible by 2
  set xfudge [expr $nand_x + $inv_x + 3 * $ws1]
  set xfudge2 [expr $xfudge / 2]
  set yfudge $nand_y

  # generate row spanner
  set rsname [format "row_spanner%d" $xfudge2]
  generate row_spanner $rsname -width $xfudge2

  set x 0
  set y $base_y

  set inflag_x $base_x
  set ncolumns [expr int($NBITS / 2) + ($NBITS %2)]
  set outflag_x [expr $base_x + ($ncolumns * $xfudge) + (0 - $base_x)]

  for {set i 0} {$i < $NBITS} {incr i} {

    # place nand
    set nand_origin_x $x
    make NAND2D -origin "$nand_origin_x $y" 

    # place inv
    set inv_origin_x [expr $nand_origin_x + $nand_x + $ws1]
    make INVE_  -origin "$inv_origin_x $y" 

    # hook up inputs
    set pin_x [expr $nand_origin_x + $nand_in0_x]
    set pin_y [expr $y + $nand_in0_y]
    set pin_name [format "A_%d_H" $i]
    make_wire $pin_x $pin_y $inflag_x $pin_y
    make input -origin "$inflag_x $pin_y" -name $pin_name
    set pin_x [expr $nand_origin_x + $nand_in1_x]
    set pin_y [expr $y + $nand_in1_y]
    set pin_name [format "B_%d_H" $i]
    make_wire $pin_x $pin_y $inflag_x $pin_y
    make input -origin "$inflag_x $pin_y" -name $pin_name

    # hook up output
    set pin_x [expr $inv_origin_x + $inv_out_x]
    set pin_y [expr $y + $inv_out_y]
    set pin_name [format "PP%d_H" $i]
    make_wire $pin_x $pin_y $outflag_x $pin_y
    make output -origin "$outflag_x $pin_y" -name $pin_name

    # hook up between nand & invert
    make_wire [expr $nand_origin_x + $nand_out_x] $y [expr $inv_origin_x + $inv_in_x] $y

    # drop row_spanner under bit 3
    if {[expr $i % 4] == 3} {
      make $rsname -origin "[expr $inv_origin_x + $inv_in_x] [expr $base_y + 100]"
    }

    # increment x (for dpc placement control)
    # next bit is bit 2 or 3:  move halfway
    if {([expr $i % 4] == 1) || ([expr $i % 4] == 2)} {
      set x [expr $x + $xfudge2]
    }
    # next bit is 0: full move
    if {[expr $i % 4] == 3} {
      set x [expr $x + $xfudge]
    }
    
    # increment y
    set y [expr $y - $yfudge]
  }

  # title bar
  make sccs_title_bar -origin "0 [expr $base_y + 200]" -owner emc -version 0.1 -date 02/02/99
}


proc ICON_ppg_slice args {
  # This line is needed for all generators
  icon_generator $args {{NBITS 8} {Algorithm "Simple"}}
  
  # don't let the user get too crazy
  if {$NBITS > 64} {
    error "ERROR: NBITS ($NBITS) not supported"
  }
  
  # check for acceptable response on Algorithm query
  if {([string toupper $Algorithm] != "SIMPLE")} {
    error "ERROR: Algorithm property ($Algorithm) must be Simple"
  }
  if {[string toupper $Algorithm] == "SIMPLE"} {
    set alg_name "Simple"
  }
  
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  
  # figure out icon size
  set cs_spacer 70
  set pin_spacer 20
  
  # how many pins?
  set pincount [expr 2 * $NBITS]
  
  set icon_y [expr ($pincount * $pin_spacer) + (2 * $cs_spacer)]
  set icon_x 400
  set icon_left [expr -($icon_x / 2)]
  set icon_right [expr ($icon_x / 2)]
  set icon_top [expr -($icon_y / 2)]
  set icon_bot [expr ($icon_y / 2)]
  set icon_right_label [expr $icon_right - 10]
  set icon_left_label [expr $icon_left + 10]
  icon_line $icon_left $icon_top $icon_right $icon_top $icon_right $icon_bot $icon_left $icon_bot $icon_left $icon_top
  
  set pin_pos [expr $icon_bot - $cs_spacer]
  for {set i 0} {$i < $NBITS} {incr i} {
    set wname [format "B_%d_H" $i]
    icon_term -type input -origin "$icon_left $pin_pos" -name $wname
    icon_property -origin "$icon_left_label $pin_pos" -size small -label $wname 
    set pin_pos [expr $pin_pos - $pin_spacer]
    set wname [format "A_%d_H" $i]
    icon_term -type input -origin "$icon_left $pin_pos" -name $wname
    icon_property -origin "$icon_left_label $pin_pos" -size small -label $wname 
    set wname [format "PP%d_H" $i]
    icon_term -type output -origin "$icon_right $pin_pos" -name $wname
    icon_property -origin "$icon_right_label $pin_pos" -size small -label $wname -anchor e
    set pin_pos [expr $pin_pos - $pin_spacer]
  }
  
  set wname [format "%dbit" $NBITS]
  icon_property -origin "0 -60" -size large -label $wname -anchor center
  icon_property -origin "0 -20" -size large -label "Multiplier" -anchor center
  set wname [format "%s PPG" $alg_name]
  icon_property -origin "0 20" -size large -label $wname -anchor center
  icon_property -origin "0 60" -size large -label "Bitslice" -anchor center
  icon_property -origin "0 100" -size large -label {$name} -anchor center
  
  set prop_y $icon_y
  icon_property -origin "-70 $prop_y" -type user -name name
  icon_property -origin "-70 [expr $prop_y + 20]" -type user -name M
  icon_property -origin "-70 [expr $prop_y + 40]" -type user -name dpc
  
  icon_special -type sccs_title_bar -origin "-70 [expr $prop_y + 140]" -owner emc -version 0.1 -date 02/02/99
}


 

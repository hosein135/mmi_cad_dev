# This is a generator for a bitslice of a multiplier's partial product generation logic.

proc NAME_mmig_ppg_slice args {
  call_use_keyword $args {{NBITS_A 8} {NBITS_B 8} {A "Unsigned"} {B "Unsigned"} {AddExtraCSA 0} {OptimizeMulArray "None"} {PPGAlgorithm "Simple"} {HalfHeight 0} {Bit 0} {OutputSize "C"}}

  # NBITS_A
  set nom [format "mmig_ppg_slice_%d" $NBITS_A]

  # A
  if {[string toupper $A] == "SIGNED"} {
    set nom [format "%sSx" $nom]
  }
  if {[string toupper $A] == "UNSIGNED"} {
    set nom [format "%sUx" $nom]
  }
  if {[string toupper $A] == "BOTH"} {
    set nom [format "%sBx" $nom]
  }

  # NBITS_B
  set nom [format "%s%d" $nom $NBITS_B]

  # B
  if {[string toupper $B] == "SIGNED"} {
    set nom [format "%sS_" $nom]
  }
  if {[string toupper $B] == "UNSIGNED"} {
    set nom [format "%sU_" $nom]
  }
  if {[string toupper $B] == "BOTH"} {
    set nom [format "%sB_" $nom]
  }

  # AddExtraCSA
  if {$AddExtraCSA == 1} {
    set nom [format "%sY" $nom]
  } else {
    set nom [format "%sN" $nom]
  }

  # OptimizeMulArray
  if {[string toupper $OptimizeMulArray] == "LSB"} {
    set nom [format "%sL" $nom]
  } 
  if {[string toupper $OptimizeMulArray] == "MSB"} {
    set nom [format "%sM" $nom]
  } 
  if {[string toupper $OptimizeMulArray] == "BOTH"} {
    set nom [format "%sB" $nom]
  } 
  if {[string toupper $OptimizeMulArray] == "NONE"} {
    set nom [format "%sN" $nom]
  }

  # PPGAlgorithm
  if {[string toupper $PPGAlgorithm] == "SIMPLE"} {
    set nom [format "%sS" $nom]
  } 
  if {[string toupper $PPGAlgorithm] == "BOOTHRADIX4"} {
    set nom [format "%sB4" $nom]
  } 
  if {[string toupper $PPGAlgorithm] == "BOOTHRADIX8"} {
    set nom [format "%sB8" $nom]
  }

  # HalfHeight
  if {$HalfHeight == 1} {
    set nom [format "%sY" $nom]
  } else {
    set nom [format "%sN" $nom]
  } 

  # OutputSize
  set nom [format "%s%s" $nom [string toupper $OutputSize]]

  # Bit
  set nom [format "%s_%d" $nom $Bit]

  return $nom
}


proc SCHEMATIC_mmig_ppg_slice args {
  call_use_keyword $args {{NBITS_A 8} {NBITS_B 8} {A "Unsigned"} {B "Unsigned"} {AddExtraCSA 0} {OptimizeMulArray "None"} {PPGAlgorithm "Simple"} {HalfHeight 0} {Bit 0} {OutputSize "C"}}

  global DPC

  # make arguments more digestible
  set A [string toupper $A]
  set OptimizeMulArray [string toupper $OptimizeMulArray]
  set PPGAlgorithm [string toupper $PPGAlgorithm]
  set OutputSize [string toupper $OutputSize]

  if {($OptimizeMulArray == "LSB") || ($OptimizeMulArray == "BOTH")} {
    set zeroopt 1
  } else { 
    set zeroopt 0
  }

  set ext1 [generators_mul_ppg_name1 $NBITS_A $NBITS_B $A $B $OptimizeMulArray $PPGAlgorithm]

  # useful constants
  set maxaidx [expr $NBITS_A - 1]
  set maxbidx [expr $NBITS_B - 1]
  set NRESBITS [expr ($NBITS_A + $NBITS_B)]
  set maxresidx [expr $NRESBITS - 1]
  if {$NBITS_A > $NBITS_B} {
    set NBITS_max $NBITS_A
  } else {
    set NBITS_max $NBITS_B
  }

  # get Algorithm
  set Algorithm [generators_mul_get_ppg_bitslice "ALG" $ext1 $Bit]
  
  # compress Algorithm, removing zeros
  set newalg ""
  set algidx ""
  if {$zeroopt} {
    for {set i 0} {$i < [string length $Algorithm]} {incr i} {
      set algbit [string index $Algorithm $i]
      if {$algbit != 0} {
	set newalg [format "%s%s" $newalg $algbit]
	set algidx [format "%s %s" $algidx $i]
      }
    }
    set Algorithm $newalg
  }

  set npps [string length $Algorithm]

  # drawing origin
  set base_x -200
  set base_y 0

  # wire stub lengths
  set ws1 60

  # Note that "Simple" and "Booth" PPG's are totally unrelated.

  if {$PPGAlgorithm == "SIMPLE"} {

    set nppsperbox 4

    # figure out how many rows of 4:2 adders are needed
    # figure out how many boxes are in each row, and how many total boxes, and the max number of boxes in one row
    set ok [generators_mul_compute_boxcount $NBITS_A $Bit $zeroopt rowcount boxcount $ext1]
    set totboxcount $boxcount(0)

    # drawing marks
    set x 0
    set y $base_y
    set inflag_x $base_x
    
    # place ppg logic    
    for {set j 0} {$j < $totboxcount} {incr j} {
      # select the chunk bits
      set chunk($j) ""
      for {set k 0} {$k < 4} {incr k} {
	set chunkidx [expr ($j * 4) + $k]
	if {$chunkidx >= [string length $Algorithm]} {
	  break
	}
	if {$zeroopt} {
	  # select only non-zero bits
	  lappend chunk($j) [lindex $algidx $chunkidx]
	} else {
	  # select sequential bits
	  lappend chunk($j) $chunkidx
	}
      }
      set ppgname($j) [NAME_mmig_ppg_4bit -NBITS_A $NBITS_A -NBITS_B $NBITS_B -A $A -B $B -AddExtraCSA $AddExtraCSA -OptimizeMulArray $OptimizeMulArray -PPGAlgorithm $PPGAlgorithm -Bit $Bit -Chunk $chunk($j) -Box $j -HalfHeight $HalfHeight]
      generate mmig_ppg_4bit $ppgname($j) -NBITS_A $NBITS_A -NBITS_B $NBITS_B -A $A -B $B -AddExtraCSA $AddExtraCSA -OptimizeMulArray $OptimizeMulArray -PPGAlgorithm $PPGAlgorithm -Bit $Bit -Chunk $chunk($j) -Box $j -HalfHeight $HalfHeight
      make $ppgname($j) -origin "$x $y"
      set ppgloc($j) "$x $y"
      
      if {$j == 0} {
	# get icon info
	setl {icon_x icon_y icon_left icon_bot icon_right icon_top} [generators_get_icon_size $ppgname(0)]
	set xfudge $icon_x
	set yfudge [expr $icon_y / 4]
      }
      
      # next box placement
      set x [expr $x + $icon_x + $xfudge]
      set y [expr $y - $icon_y - $yfudge]
    }
    
    # wire up the inputs to the PPG logic
    # get A bit usage info
    set abitslice [generators_mul_get_ppg_bitslice "A" $ext1 $Bit]
    setl {nabranges abranges} [generators_mul_get_range $abitslice]
    setl {nbits_ab abrange} [lindex $abranges 0]
    # get B bit usage info
    set bbitslice [generators_mul_get_ppg_bitslice "B" $ext1 $Bit]
    setl {nbbranges bbranges} [generators_mul_get_range $bbitslice]
    setl {nbits_bb bbrange} [lindex $bbranges 0]
    
    for {set i 0} {$i < $totboxcount} {incr i} {
      # get ppg icon info
      set ppg_x [lindex $ppgloc($i) 0]
      set ppg_y [lindex $ppgloc($i) 1]
      setl {pcount pinpins poutpins pinoutpins} [generators_get_pin_info $ppgname($i)]
      
      # A
      set abits [generators_mul_get_ppg_chunk "A" $ext1 $Bit $chunk($i)]
      setl {naranges aranges} [generators_mul_get_range $abits]
      set pinnames [generators_mul_get_pinnames $naranges $aranges]
      for {set j 0} {$j < $naranges} {incr j} {
	setl {nbits_a arange} [lindex $aranges $j]
	set pinname [lindex $pinnames $j]
	if {$pinname == "msb"} {
	  set aname Amsb_H
	} else {
	  set aname A_H$pinname
	}
	# find the pin location on ppg_4bit
	setl {ppg_port_a_x ppg_port_a_y} [generators_get_pin_xy $aname $pinpins]
	set a_x [expr $ppg_x + $ppg_port_a_x]
	set a_y [expr $ppg_y + $ppg_port_a_y]
	make_wire $a_x $a_y $inflag_x $a_y
	# create the pin name at this schematic level
	set uppinname [generators_mul_get_uppinname $nabranges $abranges $arange]
	if {$uppinname == "msb"} {
	  make input -origin "$inflag_x $a_y" -name Amsb_H
	} else {
	  make input -origin "$inflag_x $a_y" -name A_H$uppinname
	}
      }
      
      # B
      set bbits [generators_mul_get_ppg_chunk "B" $ext1 $Bit $chunk($i)]
      setl {nbranges branges} [generators_mul_get_range $bbits]
      set pinnames [generators_mul_get_pinnames $nbranges $branges]
      if {$nbranges > 0} {
	setl {nbits_b brange} [lindex $branges 0]
	set pinname [lindex $pinnames 0]
	set bname B_H$pinname
	# find the pin location on ppg_4bit
	setl {ppg_port_b_x ppg_port_b_y} [generators_get_pin_xy $bname $pinpins]
	set b_x [expr $ppg_x + $ppg_port_b_x]
	set b_y [expr $ppg_y + $ppg_port_b_y]
	make_wire $b_x $b_y $inflag_x $b_y
	# create the pin name at this schematic level
	set uppinname [generators_mul_get_uppinname $nbbranges $bbranges $brange]
	make input -origin "$inflag_x $b_y" -name B_H$uppinname
      }
      
      # ASigned
      set asigned [generators_mul_get_ppg_chunk "ASIGNED" $ext1 $Bit $chunk($i)]
      if {$asigned != 0} {
	setl {ppg_port_ASigned_x ppg_port_ASigned_y} [generators_get_pin_xy "ASigned_H" $pinpins]
	set ASigned_x [expr $ppg_x + $ppg_port_ASigned_x]
	set ASigned_y [expr $ppg_y + $ppg_port_ASigned_y]
	make_wire $ASigned_x $ASigned_y $inflag_x $ASigned_y
	make input -origin "$inflag_x $ASigned_y" -name ASigned_H
      }
      
      # BSigned
      set bsigned [generators_mul_get_ppg_chunk "BSIGNED" $ext1 $Bit $chunk($i)]
      if {$bsigned != 0} {
	setl {ppg_port_BSigned_x ppg_port_BSigned_y} [generators_get_pin_xy "BSigned_H" $pinpins]
	set BSigned_x [expr $ppg_x + $ppg_port_BSigned_x]
	set BSigned_y [expr $ppg_y + $ppg_port_BSigned_y]
	make_wire $BSigned_x $BSigned_y $inflag_x $BSigned_y
	make input -origin "$inflag_x $BSigned_y" -name BSigned_H
      }
    }
    
    # end of PPGAlgorithm=SIMPLE
  } else {
    # PPGAlgorithm = BoothRadix4 or BoothRadix8

    if {$PPGAlgorithm == "BOOTHRADIX4"} {
      set bitmultiple 2
      set maxselidx 3
      set nb 2
      set boothppg "MMIG_MUL_B4PPG"
      # get icon info
      setl {icon_x icon_y icon_left icon_bot icon_right icon_top} [generators_get_icon_size $boothppg]
      # generators_get_icon_size underestimates the height
      set icon_y [expr $icon_y + 100]
      set icon_bot [expr $icon_y / 2]
      set icon_top [expr -($icon_y / 2)]
      # get pin info
      setl {count inpins outpins inoutpins} [generators_get_pin_info $boothppg]
      setl {b_x(2) b_y(2)} [generators_get_pin_xy "B2" $inpins]
      setl {b_x(1) b_y(1)} [generators_get_pin_xy "B1" $inpins]
      set selname [format "sel\[%d:0\]" $maxselidx]
      setl {sel_x sel_y} [generators_get_pin_xy $selname $inpins]
      setl {pp_x pp_y} [generators_get_pin_xy "PP" $outpins]
    } else {
      set bitmultiple 3
      set maxselidx 7
      set nb 4
      set boothppg "MMIG_MUL_B8PPG"
      # get icon info
      setl {icon_x icon_y icon_left icon_bot icon_right icon_top} [generators_get_icon_size $boothppg]
      # generators_get_icon_size underestimates the height
      set icon_y [expr $icon_y + 100]
      set icon_bot [expr $icon_y / 2]
      set icon_top [expr -($icon_y / 2)]
      # get pin info
      setl {count inpins outpins inoutpins} [generators_get_pin_info $boothppg]
      setl {b_x(4) b_y(4)} [generators_get_pin_xy "B4" $inpins]
      setl {b_x(3) b_y(3)} [generators_get_pin_xy "B3" $inpins]
      setl {b_x(2) b_y(2)} [generators_get_pin_xy "B2" $inpins]
      setl {b_x(1) b_y(1)} [generators_get_pin_xy "B1" $inpins]
      set selname [format "sel\[%d:0\]" $maxselidx]
      setl {sel_x sel_y} [generators_get_pin_xy $selname $inpins]
      setl {pp_x pp_y} [generators_get_pin_xy "PP" $outpins]
    }

    # drawing marks
    set inflag_x $base_x
    set x 0
    set y 0

    # how many partial products?
    set totboxcount $npps
    set nppsperbox 1

    for {set i 0} {$i < $npps} {incr i} {
      # place ppg logic
      make $boothppg -origin "$x $y"

      # hook up inputs
      # PPSel
      set psel_x [expr $x + $sel_x]
      set psel_y [expr $y + $sel_y]
      make_wire $psel_x $psel_y $inflag_x $psel_y
      set pname [format "PPSel%d_H\[%d:0\]" [lindex $algidx $i] $maxselidx]
      make input -name $pname -origin "$inflag_x $psel_y"
      # B
      for {set j 1} {$j < [expr $nb + 1]} {incr j} {
	set pb_x [expr $x + $b_x($j)]
	set pb_y [expr $y + $b_y($j)]
	make_wire $pb_x $pb_y $inflag_x $pb_y
	set bname [format "B_%d_H" [expr ([lindex $algidx $i] * $nb) + ($j - 1)]]
	make input -name $bname -origin "$inflag_x $pb_y"
      }

      # mark location & name
      set ppgloc($i) "$x $y"
      set ppgname($i) $boothppg

      set x [expr $x + 1.4*$icon_x]
      set y [expr $y - 1.4*$icon_y]
    }
  }

  # wire up outputs
  set outflag_x [expr [lindex $ppgloc([expr $totboxcount - 1]) 0] + 200]

  if {$OutputSize != "C"} {
    # in this case we will add a buffer of the desired drive strength
    # after the ppg cell.

    # init the cell placement variables
    set x $outflag_x
    set rs_y [expr $base_y + 250]
    set curr_h 0
    if {$HalfHeight == 1} {
      set limit_h [expr int($DPC(PITCH)/2)]
    } else {
      set limit_h $DPC(PITCH)
    }
    set curr_h 0
    set rswidth 0
    set rs_x $x
    set last_origin_x $x
    set row_start $x
    set row_count 0

    # get MMI_BUF info
    setl {bufcount bufinpins bufoutpins bufinoutpins} [generators_get_pin_info "MMI_BUF"]
    # in
    setl {buf_in_x buf_in_y} [generators_get_pin_xy "in" $bufinpins]
    # out
    setl {buf_out_x buf_out_y} [generators_get_pin_xy "out" $bufoutpins]
    # dimensions
    setl {buf_x buf_y junk1 junk2 junk3 junk4} [generators_get_icon_size "MMI_BUF"]
  }

  for {set i 0} {$i < $totboxcount} {incr i} {
    # get ppg icon info
    set ppg_x [lindex $ppgloc($i) 0]
    set ppg_y [lindex $ppgloc($i) 1]
    setl {pcount pinpins poutpins pinoutpins} [generators_get_pin_info $ppgname($i)]
    set noutputs [get_assoc "noutputs" $pcount]
    
    for {set j 0} {$j < $noutputs} {incr j} {
      if {$PPGAlgorithm == "SIMPLE"} {
	set pname [format "PP%d_H" [lindex $chunk($i) $j]]
	set ppname [format "PP%d_H" [lindex $chunk($i) $j]]
      } else {
	set pname "PP"
#	set ppname [format "PP%d_H" [expr ($i * $nppsperbox) + $j]]
	set ppname [format "PP%d_H" [lindex $algidx $i]]
      }
      setl {port_pp_x port_pp_y} [generators_get_pin_xy $pname $poutpins]
      set pp_x [expr $ppg_x + $port_pp_x]
      set pp_y [expr $ppg_y + $port_pp_y]
      if {($OutputSize == "C")} {
	# no need to add buffer
	make_wire $pp_x $pp_y $outflag_x $pp_y
	make output -name $ppname -origin "$outflag_x $pp_y"
      } else {
	# add buffer
	set ok [generators_place_cell "MMI_BUF" $OutputSize 0 x $pp_y curr_h $limit_h rswidth rsx $rs_y $buf_x last_origin_x row_start row_count]
	set in_x [expr $x + $buf_in_x]
	set in_y [expr $pp_y + $buf_in_y]
	make_wire $pp_x $pp_y $in_x $in_y
	set out_x [expr $x + $buf_out_x]
	set out_y [expr $pp_y + $buf_out_y]
	set flag_x [expr $out_x + 200]
	make_wire $out_x $out_y $flag_x $out_y
	make output -name $ppname -origin "$flag_x $out_y"
      }
    }
  }


  # title bar
  make sccs_title_bar -origin "[expr $inflag_x + int(($outflag_x - $inflag_x)/2)] [expr $base_y + 400]" -owner emc -version 1.1 -date 06/23/00
}


proc ICON_mmig_ppg_slice args {
  # This line is needed for all generators
  icon_generator $args {{NBITS_A 8} {NBITS_B 8} {A "Unsigned" {radio Signed Unsigned Both}} {B "Unsigned" {radio Signed Unsigned Both}} {AddExtraCSA 0 binary} {OptimizeMulArray "None" {radio None Lsb Msb Both}} {PPGAlgorithm "Simple" {radio Simple BoothRadix4 BoothRadix8}} {HalfHeight 0 binary} {Bit 0} {OutputSize "C" {radio C D E}}}
  
  # make the arguments more digestible
  set A [string toupper $A]
  set B [string toupper $B]
  set OptimizeMulArray [string toupper $OptimizeMulArray]
  set PPGAlgorithm [string toupper $PPGAlgorithm]
  set OutputSize [string toupper $OutputSize]

  set ext1 [generators_mul_ppg_name1 $NBITS_A $NBITS_B $A $B $OptimizeMulArray $PPGAlgorithm]

  # don't let the user get too crazy
  set NRESBITS [expr $NBITS_A + $NBITS_B]
  if {$NRESBITS > 128} {
    error "ERROR: NBITS_A + NBITS_B = $NRESBITS not supported"
  }
  if {$NBITS_A < 1} {
    error "ERROR: NBITS_A ($NBITS_A) not supported"
  }
  if {$NBITS_B < 1} {
    error "ERROR: NBITS_B ($NBITS_B) not supported"
  }
  # check for acceptable response on A query
  if {($A != "SIGNED") &&
      ($A != "UNSIGNED") &&
      ($A != "BOTH")} {
    error "ERROR: A property ($A) must be Signed or Unsigned or Both"
  }
  # check for acceptable response on B query
  if {($B != "SIGNED") &&
      ($B != "UNSIGNED") &&
      ($B != "BOTH")} {
    error "ERROR: B property ($B) must be Signed or Unsigned or Both"
  }
  # check for acceptable response on AddExtraCSA query
  if {($AddExtraCSA != 1) && ($AddExtraCSA != 0)} {
    error "ERROR: AddExtraCSA property ($AddExtraCSA) must be 0 or 1"
  }
  # check for acceptable response on PPGAlgorithm query
  if {($PPGAlgorithm != "SIMPLE") &&
      ($PPGAlgorithm != "BOOTHRADIX4") &&
      ($PPGAlgorithm != "BOOTHRADIX8")} {
    error "ERROR: PPGAlgorithm property ($PPGAlgorithm) must be Simple or BoothRadix4 or BoothRadix8"
  }
  if {$PPGAlgorithm == "SIMPLE"} {
    set alg_name "Simple"
  }
  if {$PPGAlgorithm == "BOOTHRADIX4"} {
    set alg_name "Booth Radix 4" 
    set maxselidx 3
    set bitmultiple 2
    set nb 2
  }
  if {$PPGAlgorithm == "BOOTHRADIX8"} {
    set alg_name "Booth Radix 8" 
    set maxselidx 7
    set bitmultiple 3
    set nb 4
  }
  # check for acceptable response on OptimizeMulArray query
  if {($OptimizeMulArray != "NONE") && 
      ($OptimizeMulArray != "LSB") &&
      ($OptimizeMulArray != "MSB") &&
      ($OptimizeMulArray != "BOTH")} {
    error "ERROR: OptimizeMulArray property ($OptimizeMulArray) must be None or Lsb or Msb or Both"
  }
  set zeroopt 0
  if {($OptimizeMulArray == "LSB") || ($OptimizeMulArray == "BOTH")} {
    set zeroopt 1
  }
  # check for acceptable response on OutputSize query
  if {($OutputSize != "C") && 
      ($OutputSize != "D") &&
      ($OutputSize != "E")} {
    error "ERROR: OutputSize property ($OutputSize) must be None or Lsb or Msb or Both"
  }
  
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  
  # figure out icon size
  set cs_spacer 70
  set pin_spacer 20
  if {$PPGAlgorithm == "SIMPLE"} {
    set out_spacer [expr 2 * $pin_spacer]
  }
  if {$PPGAlgorithm == "BOOTHRADIX4"} {
    set out_spacer [expr 3 * $pin_spacer]
  }
  if {$PPGAlgorithm == "BOOTHRADIX8"} {
    set out_spacer [expr 5 * $pin_spacer]
  }
  
  # how many outputs? (max)
  set npps [generators_mul_compute_npps $NBITS_A $A $PPGAlgorithm]

  # icon body
  set icon_y [expr ($npps * $out_spacer) + (2 * $cs_spacer)]
  set icon_x 400
  set icon_left [expr -($icon_x / 2)]
  set icon_right [expr ($icon_x / 2)]
  set icon_top [expr -($icon_y / 2)]
  set icon_bot [expr ($icon_y / 2)]
  set icon_right_label [expr $icon_right - 10]
  set icon_left_label [expr $icon_left + 10]
  icon_line $icon_left $icon_top $icon_right $icon_top $icon_right $icon_bot $icon_left $icon_bot $icon_left $icon_top
  

  # get Algorithm
  set Algorithm [generators_mul_get_ppg_bitslice "ALG" $ext1 $Bit]
  
  # PP pins
  set pin_pos [expr $icon_bot - $cs_spacer]
  for {set i 0} {$i < $npps} {incr i} {
    set algbit [string index $Algorithm $i]
    if {$zeroopt && ($algbit == 0)} {
    } else {
      set wname [format "PP%d_H" $i]
      icon_term -type output -origin "$icon_right $pin_pos" -name $wname
      icon_property -origin "$icon_right_label $pin_pos" -size small -label $wname -anchor e
    }
    set pin_pos [expr $pin_pos - $out_spacer]
  }

  # input pins
  if {$PPGAlgorithm == "SIMPLE"} {
    # get A bit usage info
    set abits [generators_mul_get_ppg_bitslice "A" $ext1 $Bit]
    setl {naranges aranges} [generators_mul_get_range $abits]
    for {set i 0} {$i < $naranges} {incr i} {
      setl {nbits_a arange} [lindex $aranges $i]    
      if {($naranges == 2) && ($i == 0)} {
	# this is the msb bit
	set aname Amsb_H
	icon_term -type input -origin "-200 -60" -name $aname
	icon_property -origin "-190 -60" -size small -label A_H$arange
      } else {
	if {$nbits_a > 1} {
	  set aname A_H$arange
	} else {
	  set aname A_H
	}
	icon_term -type input -origin "-200 -30" -name $aname
	icon_property -origin "-190 -30" -size small -label A_H$arange
      }
    }
    
    # get B bit usage info
    set bbits [generators_mul_get_ppg_bitslice "B" $ext1 $Bit]
    setl {nbranges branges} [generators_mul_get_range $bbits]
    if {$nbranges > 0} {
      setl {nbits_b brange} [lindex $branges 0]
      if {$nbits_b > 1} {
	set bname B_H$brange
      } else {
	set bname B_H
      }
      icon_term -type input -origin "-200 30" -name $bname
      icon_property -origin "-190 30" -size small -label B_H$brange
    }

    # get ASigned usage info
    set asigned_usage [generators_mul_get_ppg_bitslice "ASIGNED" $ext1 $Bit]
    if {$asigned_usage != 0} {
      icon_term -type input -origin "-200 110" -name ASigned_H
      icon_property -origin "-190 110" -size small -label ASigned_H
    }
    
    # get BSigned usage info
    set bsigned_usage [generators_mul_get_ppg_bitslice "BSIGNED" $ext1 $Bit]
    if {$bsigned_usage != 0} {
      icon_term -type input -origin "-200 90" -name BSigned_H
      icon_property -origin "-190 90" -size small -label BSigned_H
    }

    # end of Simple PPG
  } else {
    # Booth PPG
    # B, PPSel pins
    set pin_pos [expr $icon_bot - $cs_spacer]
    for {set i 0} {$i < $npps} {incr i} {
      set algbit [string index $Algorithm $i]
      if {$zeroopt && ($algbit == 0)} {
	  set pin_pos [expr $pin_pos - ($nb + 1)*$pin_spacer]
      } else {
	# PPSel 
	set wname [format "PPSel%d_H\[%d:0\]" $i $maxselidx]
	icon_term -type input -origin "$icon_left $pin_pos" -name $wname
	icon_property -origin "$icon_left_label $pin_pos" -size small -label $wname 
	set pin_pos [expr $pin_pos - $pin_spacer]
	# B
	for {set j 0} {$j < $nb} {incr j} {
	  set wname [format "B_%d_H" [expr ($i * $nb) + $j]]
	  icon_term -type input -origin "$icon_left $pin_pos" -name $wname
	  icon_property -origin "$icon_left_label $pin_pos" -size small -label $wname 
	  set pin_pos [expr $pin_pos - $pin_spacer]
	}
      }
    }
  }

  
  # A
  if {$A == "SIGNED"} {
    set wname [format "%dSx" $NBITS_A]
  }
  if {$A == "UNSIGNED"} {
    set wname [format "%dUx" $NBITS_A]
  }
  if {$A == "BOTH"} {
    set wname [format "%dBx" $NBITS_A]
  }
  # B
  if {$B == "SIGNED"} {
    set wname [format "%s%dS" $wname $NBITS_B]
  }
  if {$B == "UNSIGNED"} {
    set wname [format "%s%dU" $wname $NBITS_B]
  }
  if {$B == "BOTH"} {
    set wname [format "%s%dB" $wname $NBITS_B]
  }
  icon_property -origin "0 -80" -size large -label $wname -anchor center
  icon_property -origin "0 -40" -size large -label "Multiplier" -anchor center
  set wname [format "%s PPG" $alg_name]
  icon_property -origin "0 0" -size large -label $wname -anchor center
  icon_property -origin "0 40" -size large -label "Bit $Bit" -anchor center
  if {$HalfHeight == 1} {
    icon_property -origin "0 50" -size small -label {HH} -anchor center
  }
  icon_property -origin "0 120" -size large -label {$name} -anchor center
  
  # junk
  set prop_y $icon_y
  icon_property -origin "-70 $prop_y" -type user -name name
  icon_property -origin "-70 [expr $prop_y + 20]" -type user -name M
  icon_property -origin "-70 [expr $prop_y + 40]" -type user -name dpc
  
  icon_special -type sccs_title_bar -origin "-70 [expr $prop_y + 140]" -owner emc -version 1.1 -date 06/23/00
}


 

# This is a generator for a bitslice of a multiplier's partial product generation logic.

proc NAME_ppg_slice args {
  call_use_keyword $args {{NBITS 8} {Algorithm "Simple"} {A "Unsigned"} {ReduceInputLoad "N"}}

  # NBITS
  set nom [format "ppg_slice_%d" $NBITS]

  # A
  if {[string toupper $A] == "SIGNED"} {
    set nom [format "%sS_" $nom]
  }
  if {[string toupper $A] == "UNSIGNED"} {
    set nom [format "%sU_" $nom]
  }
  if {[string toupper $A] == "BOTH"} {
    set nom [format "%sB_" $nom]
  }

  # Algorithm
  if {[string toupper $Algorithm] == "SIMPLE"} {
    set nom [format "%sS" $nom]
  }

  # ReduceInputLoad
  if {[string toupper $ReduceInputLoad] == "Y"} {
    set nom [format "%sY" $nom]
  } else {
    set nom [format "%sN" $nom]
  }

  return $nom
}



# MMIG_place_cell
#
# This proc places a cell in the current row if its layout will fit in the bit pitch.
# Otherwise it starts a new row, and places the cell there.
#
# Parameters:
# cell             - name of cell, ex. MMIG_NAND2A
# x_in             - desired schematic x coordinate of "cell".  this should be a location in 
#                    the row currently being populated.  if MMIG_place_cell determines that 
#                    there is not enough space in this row for "cell", it will place "cell" 
#                    in a new row, and modify x_in to reflect "cell"'s actual placement.  
#                    otherwise it will place "cell" at x_in.
# curr_h_in        - total (layout) height of the current row.  will be modified to
#                    reflect the total height after placement of "cell".
# limit_h          - maximum total (layout) height of a row
# rswidth_in       - schematic width (x dimension) of the row currently being drawn.
#                    also known as the row spanner width.  will be modified to reflect
#                    the drawn width of this row, after placement of "cell".
# rsx_in           - midpoint (schematic x coordinate) of the row currently being drawn.
#                    also known as the row spanner's x coordinate.  will be modified to
#                    reflect the new midpoint of the row after placement of "cell".
# rsy              - schematic y coordinate of the row spanner.
# cell_width       - width (schematic x dimension) of the "cell" icon.
# last_origin_x_in - origin (schematic x coordinate) of the rightmost cell
#                    placed in the current row.  will be modified to reflect
#                    the placement of "cell".
# row_start_in     - the leftmost schematic x coordinate of this row.  will be
#                    modified to reflect placement of "cell".

proc MMIG_p_place_cell { cell x_in y curr_h_in limit_h rswidth_in rsx_in rsy cell_width last_origin_x_in row_start_in} {
  upvar $x_in x
  upvar $curr_h_in curr_h
  upvar $rswidth_in rswidth
  upvar $rsx_in rsx
  upvar $last_origin_x_in last_origin_x
  upvar $row_start_in row_start

  set ws1 60

  # get the cell height info
  switch $cell {
    MMI_NAND2A  {set cell_h 3}
    MMI_NAND2B -
    MMI_NAND2B_ {set cell_h 3}
    MMI_NAND2C -
    MMI_NAND2C_ {set cell_h 5}
    MMI_NAND2D  {set cell_h 9}

    MMI_NAND3A  {set cell_h 4}
    MMI_NAND3B  {set cell_h 6}

    MMI_INVA    {set cell_h 2}
    MMI_INVB -
    MMI_INVB_   {set cell_h 2}
    MMI_INVC -
    MMI_INVC_   {set cell_h 3}
    MMI_INVD_   {set cell_h 4}
    MMI_INVE_   {set cell_h 7}

    MMI_BUFD    {set cell_h 5}
    MMI_BUFE    {set cell_h 9}

    default     {error "Request to place unknown cell ($cell) in MMIG_p_place_cell"}
  }

  if {(($curr_h + $cell_h) > $limit_h) || ($curr_h == 0)} {
    # won't fit, so start a new row.
    # first drop the row spanner under the previous row, unless there isn't one
    if {$curr_h != 0} {
      set rsname [format "row_spanner%d" [expr int($rswidth/2)]]
      generate row_spanner $rsname -width [expr int($rswidth/2)]
      make $rsname -origin "$rsx $rsy"

      # set start of new row
      set row_start [expr $row_start + $rswidth + $ws1]
     }

    # set new cell origin
    set last_origin_x [expr $row_start + int($cell_width / 2)]
    set x $last_origin_x

    # place cell
    make $cell -origin "$last_origin_x $y"

    # adjust curr_h
    set curr_h $cell_h

    # set new row_spanner info
    set rswidth $cell_width
    set rsx $last_origin_x

    return 0

  } else {
    # will fit, place it in this row
    # place cell
    make $cell -origin "$x $y"

    # adjust curr_h
    set curr_h [expr $curr_h + $cell_h]

    # adjust row_spanner info
    # set new cell origin
    if {$x > $last_origin_x} {
      set last_origin_x $x
      set rswidth [expr $rswidth + $ws1 + $cell_width]
      set rsx [expr $row_start + int($rswidth / 2)]
    }

    return 1
  }

}




proc SCHEMATIC_ppg_slice args {
  call_use_keyword $args {{NBITS 8} {Algorithm "Simple"} {A "Unsigned"} {ReduceInputLoad "N"}}

  # drawing origin
  set base_x -200
  set base_y 0

  # wire stub lengths
  set ws1 60

  # icon info
  # MMI_NAND2
  set nand_x 120
  set nand_y 60
  set nand_in0_x -60
  set nand_in0_y -20
  set nand_in1_x -60
  set nand_in1_y 20
  set nand_out_x 60
  set nand_out_y 0
  # MMI_NAND3
  set nand3_in0_x -60
  set nand3_in0_y -20
  set nand3_in1_x -60
  set nand3_in1_y 0
  set nand3_in2_x -60
  set nand3_in2_y 20
  set nand3_out_x 60
  set nand3_out_y 0
  # MMI_INV
  set inv_x 120
  set inv_y 60
  set inv_in_x -60
  set inv_in_y 0
  set inv_out_x 60
  set inv_out_y 0
  # MMI_BUF
  set buf_x 120
  set buf_y 60
  set buf_in_x -60
  set buf_in_y 0
  set buf_out_x 60
  set buf_out_y 0

  # select the drive strengths
  if {$NBITS <= 12} {
    set small 1
    # buffer
    generate MMI_BUF MMI_BUFD -Size D
    set buf_0 "MMI_BUFD"
    # inverters
    generate MMI_INV MMI_INVA -Size A
    set inv_0 "MMI_INVA"
    if {[string toupper $ReduceInputLoad] == "Y"} {
      generate MMI_INV MMI_INVA -Size A
      set inv_1 "MMI_INVA"
    } else {
      generate MMI_INV MMI_INVB -Size B
      set inv_1 "MMI_INVB"
    }
    generate MMI_INV MMI_INVC -Size C
    set inv_2 "MMI_INVC"
    generate MMI_INV MMI_INVD_ -Size D -DeMorgan 1
    set inv_3 "MMI_INVD_"
    # nand2's
    generate MMI_NAND2 MMI_NAND2B_ -Size B -DeMorgan 1
    set nand2_0 "MMI_NAND2B_"
    if {[string toupper $ReduceInputLoad] == "Y"} {
      generate MMI_NAND2 MMI_NAND2B -Size B
      set nand2_1 "MMI_NAND2B"
    } else {
      generate MMI_NAND2 MMI_NAND2C -Size C
      set nand2_1 "MMI_NAND2C"
    }
    # nand3's
    generate MMI_NAND3 MMI_NAND3A -Size A
    set nand3_0 "MMI_NAND3A"
  } else {
    set small 0
    # buffer
    generate MMI_BUF MMI_BUFE -Size E
    set buf_0 "MMI_BUFE"
    # inverters
    generate MMI_INV MMI_INVB -Size B
    set inv_0 "MMI_INVB"
    if {[string toupper $ReduceInputLoad] == "Y"} {
      generate MMI_INV MMI_INVB -Size B
      set inv_1 "MMI_INVB"
    } else {
      generate MMI_INV MMI_INVC -Size C
      set inv_1 "MMI_INVC"
    }
    generate MMI_INV MMI_INVD -Size D
    set inv_2 "MMI_INVD"
    generate MMI_INV MMI_INVE_ -Size E -DeMorgan 1
    set inv_3 "MMI_INVE_"
    # nand2's
    generate MMI_NAND2 MMI_NAND2C_ -Size C -DeMorgan 1
    set nand2_0 "MMI_NAND2C_"
    if {[string toupper $ReduceInputLoad] == "Y"} {
      generate MMI_NAND2 MMI_NAND2C -Size C
      set nand2_1 "MMI_NAND2C"
    } else {
      generate MMI_NAND2 MMI_NAND2D -Size D
      set nand2_1 "MMI_NAND2D"
    }
    # nand3's
    generate MMI_NAND3 MMI_NAND3B -Size B
    set nand3_0 "MMI_NAND3B"
  }

  # spacings between nand-invert icon groups
  set yfudge $nand_y

  # set inflag, row spanner locations
  set inflag_x $base_x
  set rs_y [expr $base_y + 150]

  # init the cell placement variables
  # bitpitch = 24
  set limit_h 24
  set curr_h 0
  set rswidth 0
  set rs_x 0
  set last_origin_x 0
  set row_start [expr $base_x + 200]
  set y $base_y

  # fake out the placement algorithm for big devices.
  # reorder the devices so that two nands get placed in the same row,
  # with their inverters placed in the next row.  
  # done only for the unsigned bits.
  set fake_out 0
  # figure out the height of 2 nand2_1's
  switch $nand2_1 {
    MMI_NAND2B {set nh [expr 2 * 3]}
    MMI_NAND2C {set nh [expr 2 * 5]}
    MMI_NAND2D {set nh [expr 2 * 9]}
    default {error "Unknown nand2_1 device ($nand2_1)"}
  }
  # now the height of one inv_3
  switch $inv_3 {
    MMI_INVD_ {set ih 4}
    MMI_INVE_ {set ih 7}
    default {error "Unknown inv_3 device ($inv_3)"}
  }
  # if (nand2_1 + inv_3 + nand2_1) won't fit but (nand2_1 + nand2_1) will fit, fake out the placement
  if {([expr $nh + $ih] > $limit_h) && ($nh <= $limit_h)} {
    set fake_out 1
  }


  for {set i 0} {$i < $NBITS} {incr i} {

    if {($i == [expr $NBITS - 1]) && ([string toupper $A] != "UNSIGNED")} {
      if {[string toupper $A] == "SIGNED"} {
	# place B's inverter
	set binv_origin_x [expr $row_start + int($inv_x / 2)]
	set ok [MMIG_p_place_cell $inv_1 binv_origin_x $y curr_h $limit_h rswidth rs_x $rs_y $inv_x last_origin_x row_start]

	# place nand
	set nand_origin_x [expr $binv_origin_x + $inv_x + $ws1]
	set nand_origin_y [expr $y + $nand_in0_y]
	set ok [MMIG_p_place_cell $nand2_1 nand_origin_x $nand_origin_y curr_h $limit_h rswidth rs_x $rs_y $inv_x last_origin_x row_start]

	# place final inv
	set inv_origin_x [expr $nand_origin_x + $nand_x + $ws1]
	set ok [MMIG_p_place_cell $inv_3 inv_origin_x $nand_origin_y curr_h $limit_h rswidth rs_x $rs_y $inv_x last_origin_x row_start]
      
	# hook up inputs
	set pin_x [expr $nand_origin_x + $nand_in0_x]
	set pin_y [expr $nand_origin_y + $nand_in0_y]
	set pin_name [format "A_%d_H" $i]
	make_wire $pin_x $pin_y $inflag_x $pin_y
	make input -origin "$inflag_x $pin_y" -name $pin_name
	set pin_x [expr $binv_origin_x + $inv_in_x]
	set pin_y [expr $y + $inv_in_y]
	set pin_name [format "B_%d_H" $i]
	make_wire $pin_x $pin_y $inflag_x $pin_y
	make input -origin "$inflag_x $pin_y" -name $pin_name
	
	# hook up between binv & nand
	make_wire [expr $binv_origin_x + $inv_out_x] $y [expr $nand_origin_x + $nand_in1_x] [expr $nand_origin_y + $nand_in1_y]

	# hook up between nand & invert
	make_wire [expr $nand_origin_x + $nand_out_x] $nand_origin_y [expr $inv_origin_x + $inv_in_x] $nand_origin_y

	# mark output
	set pin_x [expr $inv_origin_x + $inv_out_x]
	set pin_y [expr $nand_origin_y + $inv_out_y]
	set outpins($i) "$pin_x $pin_y"

      }


      if {[string toupper $A] == "BOTH"} {

	# place B inverter
	set binv_origin_x [expr $row_start + int($inv_x / 2)]
	set ok [MMIG_p_place_cell $inv_0 binv_origin_x $y curr_h $limit_h rswidth rs_x $rs_y $inv_x last_origin_x row_start]
	make_wire [expr $binv_origin_x + $inv_in_x] $y $inflag_x $y
	set pin_name [format "B_%d_H" $i]
	make input -origin "$inflag_x $y" -name $pin_name

	# place ASigned inverter
	set sinv_origin_x $binv_origin_x
	set sinv_origin_y [expr $y - 2 * $nand_y]
	set ok [MMIG_p_place_cell $inv_0 sinv_origin_x $sinv_origin_y curr_h $limit_h rswidth rs_x $rs_y $inv_x last_origin_x row_start]
	make_wire [expr $sinv_origin_x + $inv_in_x] $sinv_origin_y $inflag_x $sinv_origin_y
	make input -origin "$inflag_x $sinv_origin_y" -name "ASigned_H"

	# place nands
	set nand1_origin_x [expr $sinv_origin_x + $inv_x + $ws1]
	set nand1_origin_y [expr $y + $nand3_in0_y]
	set ok [MMIG_p_place_cell $nand3_0 nand1_origin_x $nand1_origin_y curr_h $limit_h rswidth rs_x $rs_y $inv_x last_origin_x row_start]
	make_wire [expr $nand1_origin_x + $nand3_in2_x] [expr $nand1_origin_y + $nand3_in2_y] [expr $binv_origin_x + $inv_out_x] [expr $y + $inv_out_y]

	set nand2_origin_x $nand1_origin_x
	set nand2_origin_y [expr $sinv_origin_y + $nand3_in2_y]
	set ok [MMIG_p_place_cell $nand3_0 nand2_origin_x $nand2_origin_y curr_h $limit_h rswidth rs_x $rs_y $inv_x last_origin_x row_start]
	make_wire [expr $nand2_origin_x + $nand3_in0_x] [expr $nand2_origin_y + $nand3_in0_y] [expr $sinv_origin_x + $inv_out_x] [expr $sinv_origin_y + $inv_out_y]

	# hook up inputs
	# A
	set pin1_x [expr $nand1_origin_x + $nand3_in2_x]
	set pin1_y [expr $nand1_origin_y + $nand3_in0_y]
	set pin2_x [expr $nand2_origin_x + $nand3_in2_x]
	set pin2_y [expr $nand2_origin_y + $nand3_in2_y]
	set bend_x [expr $pin1_x - 20]
	make_wire $pin1_x $pin1_y $bend_x $pin1_y
	make_wire $pin2_x $pin2_y $bend_x $pin2_y
	make_wire $bend_x $pin1_y $bend_x $pin2_y
	set wire_y [expr $y - $nand_y]
	make_wire $bend_x $wire_y $inflag_x $wire_y
	set pin_name [format "A_%d_H" $i]
	make input -origin "$inflag_x $wire_y" -name $pin_name
	# B
	set pin_x [expr $nand2_origin_x + $nand3_in1_x]
	set pin_y [expr $nand2_origin_y + $nand3_in1_y]
	set bend_x [expr $binv_origin_x - $inv_x - $ws1]
	make_wire $pin_x $pin_y $bend_x $pin_y
	make_wire $bend_x $pin_y $bend_x $y
	# ASigned
	set pin_x [expr $nand1_origin_x + $nand3_in1_x]
	set pin_y [expr $nand1_origin_y + $nand3_in1_y]
	set bend_x [expr $sinv_origin_x - $inv_x - $ws1 - 20]
	make_wire $pin_x $pin_y $bend_x $pin_y
	make_wire $bend_x $pin_y $bend_x $sinv_origin_y

	# place final nand
	set nand3_origin_x [expr $nand2_origin_x + $nand_x + $ws1]
	set nand3_origin_y $wire_y
	set ok [MMIG_p_place_cell $nand2_0 nand3_origin_x $nand3_origin_y curr_h $limit_h rswidth rs_x $rs_y $inv_x last_origin_x row_start]
	set pin_x [expr $nand3_origin_x + $nand_in0_x]
	set pin_y [expr $nand3_origin_y + $nand_in0_y]
	set bend_x [expr $pin_x - 20]
	make_wire $pin_x $pin_y $bend_x $pin_y
	set pino_x [expr $nand2_origin_x + $nand3_out_x]
	set pino_y [expr $nand2_origin_y + $nand3_out_y]
	make_wire $bend_x $pin_y $bend_x $pino_y
	make_wire $bend_x $pino_y $pino_x $pino_y
	set pin_x [expr $nand3_origin_x + $nand_in1_x]
	set pin_y [expr $nand3_origin_y + $nand_in1_y]
	set bend_x [expr $pin_x - 20]
	make_wire $pin_x $pin_y $bend_x $pin_y
	set pino_x [expr $nand1_origin_x + $nand3_out_x]
	set pino_y [expr $nand1_origin_y + $nand3_out_y]
	make_wire $bend_x $pin_y $bend_x $pino_y
	make_wire $bend_x $pino_y $pino_x $pino_y

	# place buffer
	set buf_origin_x [expr $nand3_origin_x + $nand_x + $ws1]
	set buf_origin_y $nand3_origin_y
	set ok [MMIG_p_place_cell $buf_0 buf_origin_x $buf_origin_y curr_h $limit_h rswidth rs_x $rs_y $inv_x last_origin_x row_start]
	make_wire [expr $buf_origin_x + $inv_in_x] [expr $buf_origin_y + $inv_in_y] [expr $nand3_origin_x + $nand_out_x] [expr $nand3_origin_y + $nand_out_y]

	# mark output
	set pin_x [expr $buf_origin_x + $inv_out_x] 
	set pin_y [expr $buf_origin_y + $inv_out_y]
	set outpins($i) "$pin_x $pin_y"

	# force full hookup
	show_connects "" clean
      }

    } else {

      # place nand
      set nand_origin_x [expr $row_start + int($nand_x / 2)]
      if {($fake_out == 1) && ([expr $i % 4] == 1)} {
	make $nand2_1 -origin "$nand_origin_x $y"
	# fake the start of a new row, containing the previous inverter
	set curr_h $ih
	set rswidth $inv_x
	set row_start [expr $last_origin_x - int($inv_x / 2)]
	set rs_x $last_origin_x
      } else {
	set ok [MMIG_p_place_cell $nand2_1 nand_origin_x $y curr_h $limit_h rswidth rs_x $rs_y $nand_x last_origin_x row_start]
      }

      # place inv
      set inv_origin_x [expr ($nand_origin_x + $nand_out_x) + $ws1 + ($inv_x + $inv_in_x)]
      set ok [MMIG_p_place_cell $inv_3 inv_origin_x $y curr_h $limit_h rswidth rs_x $rs_y $inv_x last_origin_x row_start]

      # hook up inputs
      set pin_x [expr $nand_origin_x + $nand_in0_x]
      set pin_y [expr $y + $nand_in0_y]
      set pin_name [format "A_%d_H" $i]
      make_wire $pin_x $pin_y $inflag_x $pin_y
      make input -origin "$inflag_x $pin_y" -name $pin_name
      set pin_x [expr $nand_origin_x + $nand_in1_x]
      set pin_y [expr $y + $nand_in1_y]
      set pin_name [format "B_%d_H" $i]
      make_wire $pin_x $pin_y $inflag_x $pin_y
      make input -origin "$inflag_x $pin_y" -name $pin_name
      
      # hook up between nand & invert
      make_wire [expr $nand_origin_x + $nand_out_x] $y [expr $inv_origin_x + $inv_in_x] $y
            
      # mark output
      set pin_x [expr $inv_origin_x + $inv_out_x]
      set pin_y [expr $y + $inv_out_y]
      set outpins($i) "$pin_x $pin_y"
      
      # increment y
      set y [expr $y - $yfudge]

    }
  }

  # hook up the outputs
  set outflag_x [expr $last_origin_x + 200]
  for {set j 0} {$j < $NBITS} {incr j} {
    set pin_x [lindex $outpins($j) 0]
    set pin_y [lindex $outpins($j) 1]
    set pin_name [format "PP%d_H" $j]
    make_wire $pin_x $pin_y $outflag_x $pin_y
    make output -origin "$outflag_x $pin_y" -name $pin_name
  }

  # drop the final row spanner
  set rsname [format "row_spanner%d" [expr int($rswidth/2)]]
  generate row_spanner $rsname -width [expr int($rswidth/2)]
  make $rsname -origin "$rs_x $rs_y"

  # title bar
  make sccs_title_bar -origin "[expr $inflag_x + int(($outflag_x - $inflag_x)/2)] [expr $base_y + 300]" -owner emc -version 0.7 -date 07/16/99
}


proc ICON_ppg_slice args {
  # This line is needed for all generators
  icon_generator $args {{NBITS 8} {Algorithm "Simple"} {A "Unsigned" {radio Signed Unsigned Both}} {ReduceInputLoad "N"}}
  
  # don't let the user get too crazy
  if {$NBITS > 64} {
    error "ERROR: NBITS ($NBITS) not supported"
  }
  
  # check for acceptable response on Algorithm query
  if {([string toupper $Algorithm] != "SIMPLE")} {
    error "ERROR: Algorithm property ($Algorithm) must be Simple"
  }
  if {[string toupper $Algorithm] == "SIMPLE"} {
    set alg_name "Simple"
  }
  # check for acceptable response on A query
  if {([string toupper $A] != "SIGNED") &&
      ([string toupper $A] != "UNSIGNED") &&
      ([string toupper $A] != "BOTH")} {
    error "ERROR: A property ($A) must be Signed or Unsigned or Both"
  }
  # check for acceptable response on ReduceInputLoad query
  if {([string toupper $ReduceInputLoad] != "Y") && ([string toupper $ReduceInputLoad] != "N")} {
    error "ERROR: ReduceInputLoad property ($ReduceInputLoad) must be Y or N"
  }
  
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  
  # figure out icon size
  set cs_spacer 70
  set pin_spacer 20
  
  # how many pins?
  set pincount [expr 2 * $NBITS]
  
  # icon body
  set icon_y [expr ($pincount * $pin_spacer) + (2 * $cs_spacer)]
  set icon_x 400
  set icon_left [expr -($icon_x / 2)]
  set icon_right [expr ($icon_x / 2)]
  set icon_top [expr -($icon_y / 2)]
  set icon_bot [expr ($icon_y / 2)]
  set icon_right_label [expr $icon_right - 10]
  set icon_left_label [expr $icon_left + 10]
  icon_line $icon_left $icon_top $icon_right $icon_top $icon_right $icon_bot $icon_left $icon_bot $icon_left $icon_top
  
  # pins
  set pin_pos [expr $icon_bot - $cs_spacer]
  for {set i 0} {$i < $NBITS} {incr i} {
    set wname [format "B_%d_H" $i]
    icon_term -type input -origin "$icon_left $pin_pos" -name $wname
    icon_property -origin "$icon_left_label $pin_pos" -size small -label $wname 
    set pin_pos [expr $pin_pos - $pin_spacer]
    set wname [format "A_%d_H" $i]
    icon_term -type input -origin "$icon_left $pin_pos" -name $wname
    icon_property -origin "$icon_left_label $pin_pos" -size small -label $wname 
    set wname [format "PP%d_H" $i]
    icon_term -type output -origin "$icon_right $pin_pos" -name $wname
    icon_property -origin "$icon_right_label $pin_pos" -size small -label $wname -anchor e
    set pin_pos [expr $pin_pos - $pin_spacer]
  }

  if {([string toupper $A] == "BOTH")} {
    icon_term -type input -origin "$icon_left [expr $icon_top + $pin_spacer]" -name "ASigned_H"
    icon_property -origin "$icon_left_label [expr $icon_top + $pin_spacer]" -size small -label "ASigned_H"
  }
  
  # text
  if {[string toupper $A] == "UNSIGNED"} {
    set as "U"
  }
  if {[string toupper $A] == "SIGNED"} {
    set as "S"
  }
  if {[string toupper $A] == "BOTH"} {
    set as "U,S"
  }
  set wname [format "%dbit (%s)" $NBITS $as]
  icon_property -origin "0 -80" -size large -label $wname -anchor center
  icon_property -origin "0 -40" -size large -label "Multiplier" -anchor center
  set wname [format "%s PPG" $alg_name]
  icon_property -origin "0 0" -size large -label $wname -anchor center
  icon_property -origin "0 40" -size large -label "Bitslice" -anchor center
  if {[string toupper $ReduceInputLoad] == "Y"} {
    icon_property -origin "0 80" -size large -label "R" -anchor center
  }
  icon_property -origin "0 120" -size large -label {$name} -anchor center
  
  # junk
  set prop_y $icon_y
  icon_property -origin "-70 $prop_y" -type user -name name
  icon_property -origin "-70 [expr $prop_y + 20]" -type user -name M
  icon_property -origin "-70 [expr $prop_y + 40]" -type user -name dpc
  
  icon_special -type sccs_title_bar -origin "-70 [expr $prop_y + 140]" -owner emc -version 0.7 -date 07/16/99
}


 

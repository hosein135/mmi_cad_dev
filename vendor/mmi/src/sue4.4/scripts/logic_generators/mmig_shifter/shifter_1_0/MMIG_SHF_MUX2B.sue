# SUE version MMI_SUE4.0p4

proc SCHEMATIC_MMIG_SHF_MUX2B {} {
  make output -name out -origin {550 180}
  generate row_spanner row_spanner320 -width 320
  make row_spanner320 -origin {230 -90}
  generate MMI_INV MMI_INVA -Size A
  make MMI_INVA -orient RY -origin {-40 170}
  generate MMI_INV MMI_INVA_ -DeMorgan 1
  make MMI_INVA_ -orient RY -origin {110 230}
  make input -orient RY -name sel -origin {-120 170}
  make name_net_s -orient RY -name N1 -origin {270 230}
  make name_net_s -name N2 -origin {270 170}
  generate MMI_AO22 MMI_AO22B -Size B
  make MMI_AO22B -origin {450 180}
  make input -orient RY -name in0 -origin {-120 20}
  make input -name in1 -origin {-120 80}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.2 -date 07/12/99 -origin {180 470}
  make_wire 50 230 40 230
  make_wire 40 230 40 170
  make_wire 40 170 20 170
  make_wire 270 230 170 230
  make_wire 270 170 40 170
  make_wire 350 230 270 230
  make_wire 350 170 270 170
  make_wire -120 20 350 20
  make_wire -120 170 -100 170
  make_wire 350 20 350 130
  make_wire 350 190 320 190
  make_wire 320 190 320 80
  make_wire 320 80 -120 80
  make_text -origin {-220 -260} -text MMIG_SHF_MUX2B -size large
  make_text -origin {-210 -210} -text {Faster for wide datapath applications because it presents less gate loading to the select wire}
}

proc ICON_MMIG_SHF_MUX2B args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type output -origin {60 0} -name out
  icon_term -type input -origin {0 50} -orient R270 -name sel
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 30} -name in1
  icon_property -origin {-50 170} -type user -name name
  icon_property -origin {-50 190} -type user -name M
  icon_property -origin {-50 210} -type user -name dpc
  icon_line -40 -70 40 -30
  icon_line 40 -30 40 30
  icon_line 40 30 -40 70
  icon_line -40 -70 -40 70
  icon_line -40 -30 -60 -30
  icon_line -40 30 -60 30
  icon_property -origin {-30 -30} -size small -label 0
  icon_property -origin {0 0} -anchor center -label SB
  icon_line 40 0 60 0
}


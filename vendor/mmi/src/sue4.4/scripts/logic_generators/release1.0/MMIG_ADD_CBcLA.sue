# SUE version MMI_SUE4.0p1

proc SCHEMATIC_MMIG_ADD_CBcLA {} {
  make output -orient R90Y -name Cout1_H -origin {590 130}
  make output -orient R90Y -name Cout0_H -origin {930 130}
  make output -orient RY -name Sum_H -origin {1460 700}
  make input -orient RY -name A_H -origin {70 410}
  make input -orient RY -name B_H -origin {70 450}
  make input -orient R90Y -name Cin1_L -origin {590 1060}
  make input -orient R90Y -name Cin0_L -origin {930 1060}
  make input -orient R90Y -name SelS_H -origin {1400 1070}
  generate row_spanner row_spanner200 
  make row_spanner200 -origin {280 1230}
  generate row_spanner row_spanner150 -width 150
  make row_spanner150 -origin {680 1230}
  generate name_net_s name_net -cell name_net
  make name_net -name Sum1_H -origin {1260 670}
  make name_net -name Sum0_H -origin {1260 730}
  make name_net -name P_L -origin {490 590}
  make name_net -name K_H -origin {490 510}
  make name_net -name G_L -origin {490 430}
  make MMIG_ADD_CBcLA -origin {170 180}
  generate MMI_NAND2 MMI_NAND2C -Size C
  make MMI_NAND2C -orient RY -origin {240 430}
  generate MMI_NOR2 MMI_NOR2C_ -Size C -DeMorgan 1
  make MMI_NOR2C_ -origin {250 510}
  generate MMI_INAND2 MMI_INAND2B -Size B
  make MMI_INAND2B -origin {410 590}
  generate MMI_OAI21 MMI_OAI21B_ -Size B -DeMorgan 1
  make MMI_OAI21B_ -orient R270 -origin {590 310}
  make MMI_OAI21B_ -orient R270 -origin {930 310}
  generate MMI_INV MMI_INVA_ -DeMorgan 1
  make MMI_INVA_ -origin {650 690}
  make MMI_INVA_ -origin {990 750}
  generate MMI_XNOR2 MMI_XNOR2A -Size A
  make MMI_XNOR2A -orient RY -origin {770 670}
  generate MMI_XNOR2 MMI_XNOR2A -Size A
  make MMI_XNOR2A -orient RY -origin {1110 730}
  generate MMI_MUX2 MMI_MUX2A -Size A
  make MMI_MUX2A -orient RY -origin {1400 700}
  generate MMI_MUX2 MMI_MUX2A -Size A
  make MMI_MUX2A -orient RY -origin {1400 890}
  make MMI_INVA_ -origin {650 860}
  make MMI_INVA_ -origin {990 920}
  make name_net -name C1_H -origin {1260 860}
  make name_net -name C0_H -origin {1260 920}
  generate row_spanner row_spanner180 -width 180
  make row_spanner180 -origin {1060 1230}
  generate row_spanner row_spanner100 -width 100
  make row_spanner100 -origin {1400 1230}
  make output -orient RY -name Cin_H -origin {1460 890}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.3 -date 03/26/99 -origin {720 1350}
  make_wire 70 450 100 450
  make_wire 120 410 70 410
  make_wire 560 410 560 430
  make_wire 900 410 900 430
  make_wire 560 430 900 430
  make_wire 630 410 630 510
  make_wire 970 410 970 510
  make_wire 630 510 970 510
  make_wire 340 570 340 430
  make_wire 490 430 560 430
  make_wire 490 510 630 510
  make_wire 120 410 120 490
  make_wire 100 450 100 530
  make_wire 120 410 180 410
  make_wire 100 450 180 450
  make_wire 310 510 490 510
  make_wire 120 490 190 490
  make_wire 100 530 190 530
  make_wire 310 610 350 610
  make_wire 300 430 340 430
  make_wire 340 430 490 430
  make_wire 310 510 310 610
  make_wire 340 570 350 570
  make_wire 470 590 490 590
  make_wire 590 130 590 210
  make_wire 930 130 930 210
  make_wire 710 590 710 650
  make_wire 1050 590 1050 710
  make_wire 490 590 710 590
  make_wire 710 590 1050 590
  make_wire 830 670 1260 670
  make_wire 1260 670 1340 670
  make_wire 1170 730 1260 730
  make_wire 1260 730 1340 730
  make_wire 930 410 930 750
  make_wire 590 410 590 690
  make_wire 1400 840 1400 650
  make_wire 1400 840 1400 1070
  make_wire 930 920 930 750
  make_wire 930 920 930 1060
  make_wire 590 860 590 690
  make_wire 590 860 590 1060
  make_wire 710 860 1260 860
  make_wire 1260 860 1340 860
  make_wire 1050 920 1260 920
  make_wire 1260 920 1340 920
}

proc ICON_MMIG_ADD_CBcLA args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {pad {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type output -origin {-40 -120} -orient R270 -name Cout1_H
  icon_term -type output -origin {-20 -120} -orient R270 -name Cout0_H
  icon_term -type output -origin {140 0} -name Sum_H
  icon_term -type input -origin {-40 120} -orient R270 -name Cin1_L
  icon_term -type input -origin {-20 120} -orient R270 -name Cin0_L
  icon_term -type input -origin {140 100} -orient RXY -name SelS_H
  icon_term -type output -origin {140 20} -name Cin_H
  icon_property -origin {-130 210} -type user -name name
  icon_property -origin {-130 230} -type user -name M
  icon_property -origin {-130 250} -type user -name pad
  icon_property -origin {-40 110} -anchor e -rotate 1 -label Cin1_L
  icon_property -origin {-20 110} -anchor e -rotate 1 -label Cin0_L
  icon_property -origin {-40 -110} -rotate 1 -label Cout1_H
  icon_property -origin {-20 -110} -rotate 1 -label Cout0_H
  icon_property -origin {-130 -10} -anchor e -rotate 1 -label A_H
  icon_property -origin {-130 10} -rotate 1 -label B_H
  icon_property -origin {130 0} -anchor e -rotate 1 -label Sum_H
  icon_property -origin {0 0} -size large -anchor center -label CBcLA
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_property -origin {130 100} -anchor e -label SelS_H
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
  icon_property -origin {130 20} -rotate 1 -label Cin_H
}


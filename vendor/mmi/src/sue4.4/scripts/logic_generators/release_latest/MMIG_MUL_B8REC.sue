  make_wire 620 -60 470 -60
  make_wire 470 -60 470 -140
  make_wire 470 -60 470 340
  make_text -origin {-250 -480} -text {sel[0] = sel B = (!A3.!A2) . (A1 xor A0)
sel[1] = sel !B = (A3.A2) . (A1 xor A0)
sel[2] = sel 2B = (!A3.!A2) .(A1 . A0) + (!A3.A2).(!A1.!A0)
sel[3] = sel !2B = (A3.!A2).(A1.A0) + (A3.A2) .(!A1.!A0)
sel[4] = sel 3B = (!A3.A2).(A1 xor A0)
sel[5] = sel !3B = (A3.!A2).(A1 xor A0)
sel[6] = sel 4B = (!A3.A2).(A1.A0)
sel[7] = sel !4B = (A3.!A2).(!A1.!A0)}
  make_text -origin {-240 -780} -text MMIG_MUL_B8REC -size large
  make_text -origin {-240 -740} -text {Multiplier Recoder Logic for Booth Multiplier, Radix 8}
}

proc ICON_MMIG_MUL_B8REC args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-120 50} -orient RY -name A0
  icon_term -type input -origin {-120 30} -orient RY -name A1
  icon_term -type input -origin {-120 10} -orient RY -name A2
  icon_term -type input -origin {-120 -10} -name A3
  icon_term -type output -origin {120 80} -name {sel[7:0]}
  icon_term -type output -origin {120 60} -name cin
  icon_property -origin {-50 200} -type user -name name
  icon_property -origin {-50 220} -type user -name M
  icon_property -origin {-50 240} -type user -name dpc
  icon_line -120 -120 -120 120 120 120 120 -120 -120 -120
  icon_property -origin {0 -60} -size large -anchor center -label MMIG_MUL_B8REC
  icon_property -origin {110 80} -anchor e -label {sel[7:0]}
  icon_property -origin {-110 50} -label {A[n-1]}
  icon_property -origin {-110 30} -label {A[n]}
  icon_property -origin {-110 10} -label {A[n+1]}
  icon_property -origin {-110 -10} -label {A[n+2]}
  icon_property -origin {110 60} -anchor e -label cin
}


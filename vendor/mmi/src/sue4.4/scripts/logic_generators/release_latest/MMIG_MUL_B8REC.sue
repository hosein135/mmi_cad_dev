  make MMI_NAND3A -origin {920 800}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.18 -date 06/08/00 -origin {660 970}
  make_wire 200 400 120 400
  make_wire 200 480 120 480
  make_wire 200 560 120 560
  make_wire -80 420 -80 460
  make_wire -80 460 -80 580
  make_wire -120 380 -120 500
  make_wire -200 -20 -200 60
  make_wire -200 -100 -200 -20
  make_wire -200 -100 -200 -180
  make_wire -160 -60 -160 -140
  make_wire -160 20 -160 -60

# SUE version MMI_SUE4.1.12

proc SCHEMATIC_MMIG_MUL_B8REC {} {
  generate row_spanner row_spanner150 -width 150
  make row_spanner150 -origin {790 -370}
  make row_spanner150 -origin {1270 -370}
  make input -name A3 -origin {-240 -180}
  make input -name A2 -origin {-240 100}
  make input -name A1 -origin {-240 380}
  make input -name A0 -origin {-240 580}
  generate MMI_AND2 MMI_AND2B 
  make MMI_AND2B -origin {60 480}
  make name_net_s -name A0xorA1 -origin {200 400}
  make MMI_AND2B -origin {60 -160}
  make name_net_s -name A3andA2 -origin {200 -160}
  make name_net_s -name A3BandA2 -origin {200 -80}
  make name_net_s -name A3andA2B -origin {200 0}
  make name_net_s -name A3BandA2B -origin {200 80}
  make output -name {sel[0]} -origin {1520 -160}
  make output -name {sel[1]} -origin {1520 -80}
  make output -name {sel[2]} -origin {1520 40}
  make name_net_s -name A0andA1 -origin {200 480}
  make name_net_s -name A0BandA1B -origin {200 560}
  make output -name {sel[3]} -origin {1520 200}
  make output -name {sel[4]} -origin {1520 320}
  make output -name {sel[5]} -origin {1520 400}
  make output -name {sel[6]} -origin {1520 480}
  make output -name {sel[7]} -origin {1520 560}
  generate MMI_INOR2 MMI_INOR2B_ -Size B -DeMorgan 1
  make MMI_INOR2B_ -origin {60 -80}
  make MMI_INOR2B_ -orient RY -origin {60 0}
  generate MMI_NOR2 MMI_NOR2B_ -Size B -DeMorgan 1
  make MMI_NOR2B_ -origin {60 80}
  generate MMI_XOR2 MMI_XOR2B -Size B
  make MMI_XOR2B -origin {60 400}
  make MMI_NOR2B_ -origin {60 560}
  make MMI_AND2B -origin {680 -160}
  make MMI_AND2B -origin {680 -80}
  make MMI_AND2B -origin {1160 320}
  make MMI_AND2B -origin {1160 400}
  make MMI_AND2B -origin {1160 480}
  make MMI_AND2B -origin {1160 560}
  generate MMI_BUF MMI_BUFE -Size E
  make MMI_BUFE -origin {1390 560}

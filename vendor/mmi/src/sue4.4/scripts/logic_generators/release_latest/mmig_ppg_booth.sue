# This is a generator for the multiplier recoding logic for Booth multiplication.

proc NAME_mmig_ppg_booth args {
  call_use_keyword $args {{NBITS_A 8} {A "Unsigned"} {PPGAlgorithm "BoothRadix4"} {HalfHeight 0}}

  # NBITS_A
  set nom [format "mmig_ppg_booth_%d" $NBITS_A]

  # A
  if {[string toupper $A] == "SIGNED"} {
    set nom [format "%sS" $nom]
  }
  if {[string toupper $A] == "UNSIGNED"} {
    set nom [format "%sU" $nom]
  }
  if {[string toupper $A] == "BOTH"} {
    set nom [format "%sB" $nom]
  }

  # PPGAlgorithm
  if {[string toupper $PPGAlgorithm] == "BOOTHRADIX4"} {
    set nom [format "%s_B4" $nom]
  }
  if {[string toupper $PPGAlgorithm] == "BOOTHRADIX8"} {
    set nom [format "%s_B8" $nom]
  }
  
  # HalfHeight
  if {$HalfHeight == 1} {
    set nom [format "%sY" $nom]
  } else {
    set nom [format "%sN" $nom]
  }

  return $nom
}


proc SCHEMATIC_mmig_ppg_booth args {
  call_use_keyword $args {{NBITS_A 8} {A "Unsigned"} {PPGAlgorithm "BoothRadix4"} {HalfHeight 0}}

  # make the arguments more digestible
  set A [string toupper $A]
  set PPGAlgorithm [string toupper $PPGAlgorithm]

  # useful constants
  setl {maxaidx maxabitrange vmaxabitrange} [generators_compute_bitrange $NBITS_A]

  # which radix?
  if {$PPGAlgorithm == "BOOTHRADIX4"} {
    set bitmultiple 2
    set maxselidx 3
    set boothrec "MMIG_MUL_B4REC"
    # get icon info
    setl {icon_x icon_y icon_left icon_bot icon_right icon_top} [generators_get_icon_size $boothrec]
    # generators_get_icon_size underestimates the height
    set icon_y [expr $icon_y + 100]
    set icon_bot [expr $icon_y / 2]
    set icon_top [expr -($icon_y / 2)]
    # get pin info
    setl {count inpins outpins inoutpins} [generators_get_pin_info $boothrec]
    setl {a_x(2) a_y(2)} [generators_get_pin_xy "A2" $inpins]
    setl {a_x(1) a_y(1)} [generators_get_pin_xy "A1" $inpins]
    setl {a_x(0) a_y(0)} [generators_get_pin_xy "A0" $inpins]
    set selname [format "sel\[%d:0\]" $maxselidx]
    setl {sel_x sel_y} [generators_get_pin_xy $selname $outpins]
    setl {cin_x cin_y} [generators_get_pin_xy "cin" $outpins]
  } else {
    set bitmultiple 3
    set maxselidx 7
    set boothrec "MMIG_MUL_B8REC"
    # get icon info
    setl {icon_x icon_y icon_left icon_bot icon_right icon_top} [generators_get_icon_size $boothrec]
    # generators_get_icon_size underestimates the height
    set icon_y [expr $icon_y + 100]
    set icon_bot [expr $icon_y / 2]
    set icon_top [expr -($icon_y / 2)]
    # get pin info
    setl {count inpins outpins inoutpins} [generators_get_pin_info $boothrec]
    setl {a_x(3) a_y(3)} [generators_get_pin_xy "A3" $inpins]
    setl {a_x(2) a_y(2)} [generators_get_pin_xy "A2" $inpins]
    setl {a_x(1) a_y(1)} [generators_get_pin_xy "A1" $inpins]
    setl {a_x(0) a_y(0)} [generators_get_pin_xy "A0" $inpins]
    set selname [format "sel\[%d:0\]" $maxselidx]
    setl {sel_x sel_y} [generators_get_pin_xy $selname $outpins]
    setl {cin_x cin_y} [generators_get_pin_xy "cin" $outpins]
  }

  # will need to add some ANDs if A=BOTH
  if {$A == "BOTH"} {
    # get icon info
    set and_icon_dim [generators_get_icon_size "MMI_AND2"]
    set and_x [lindex $and_icon_dim 0]
    set and_y [lindex $and_icon_dim 1]
    # get pin info
    setl {count inpins outpins inoutpins} [generators_get_pin_info "MMI_AND2"]
    setl {and_in_x(0) and_in_y(0)} [generators_get_pin_xy "in0" $inpins]
    setl {and_in_x(1) and_in_y(1)} [generators_get_pin_xy "in1" $inpins]
    setl {and_out_x and_out_y} [generators_get_pin_xy "out" $outpins]
    # generate the gate
    set and2name [NAME_MMI_AND2 -Size C -DeMorgan 0]
    generate MMI_AND2 $and2name -Size C -DeMorgan 0
  }

  # drawing origin
  set base_x -500
  set base_y 0

  # wire stub lengths
  set ws1 50

  if {$HalfHeight == 1} {
    set x2 [expr $icon_x + 100]
  } else {
    set x2 0
  }
  set inflag_x $base_x
  set outflag_x [expr $x2 + 500]

  set x 0
  set y $base_y
  set delta_y [expr $icon_y + 2 * $ws1]


  # compute the number of partial products.  
  set npps [generators_mul_compute_npps $NBITS_A $A $PPGAlgorithm]

  # figure out the multiplier algorithm
  set done 0
  # lsb is always 0
  lappend mr "G"
  set mrbit 0
  set mrmod [expr $NBITS_A % $bitmultiple]
  if {$mrmod == 0} {
    set mrmod $bitmultiple
  }
  set mrmodbit 0
  while {$done == 0} {
    if {$mrbit < $NBITS_A} {
      lappend mr $mrbit
      incr mrbit
    }
    if {($mrbit == $NBITS_A) && ($mrmodbit < $mrmod)} {
      switch $A {
	"UNSIGNED" { lappend mr "G" }
	"SIGNED" {lappend mr $maxaidx}
	"BOTH" {lappend mr "S"}
      }
      incr mrmodbit
    }
    if {($mrbit == $NBITS_A) && ($mrmodbit == $mrmod)} {
      set done 1
    }
  }

  for {set i 0} {$i < $npps} {incr i} {
    # determine location
    if {[expr ($i % 2)] == 0} {
      set x 0
    } else {
      set x $x2
    }   

    # determine bit position
    if {$HalfHeight == 1} {
      if {($i % 2) == 0} {
	set bitpos [expr ((int($i / 2) + 1) * $bitmultiple) - 1]
	set prevbitpos $bitpos
      } else {
	set bitpos $prevbitpos
      }
    } else {
      set bitpos [expr (($i + 1) * $bitmultiple) - 1]
    }
    
    # place icon
    make $boothrec -origin "$x $y" -name "\[$bitpos\]"

    # hook up A inputs
    for {set j 0} {$j <= $bitmultiple} {incr j} {
      set Aval [lindex $mr [expr ($i * $bitmultiple) + $j]]

      set apin_x [expr $x + $a_x($j)]
      set apin_y [expr $y + $a_y($j)]

      switch $Aval {
	"G" {
	  # ground the pin
	  make_wire $apin_x $apin_y [expr $apin_x - $ws1] $apin_y
	  make global -name gnd -origin "[expr $apin_x - $ws1] $apin_y"
	}

	"S" {
	  # conditionally sign extend A

	  # wire stubs to this box
	  make_wire $apin_x $apin_y [expr $apin_x - 2*$ws1] $apin_y
	  set aname [format "AX_H\[%d\]" [expr $maxaidx + $j]]
	  make name_net_s -name $aname -origin "[expr $apin_x - 2*$ws1] $apin_y"

	  # place AND2
	  set and_origin_x $x
	  set and_origin_y [expr $y - $delta_y - ($j * 2 * $and_y)]
	  set apos [format "\[%d\]" [expr $bitpos + 1]]
	  make $and2name -origin "$and_origin_x $and_origin_y" -name $apos
	  
	  # wire up AND2 output
	  set aout_x [expr $and_origin_x + $and_out_x]
	  set aout_y [expr $and_origin_y + $and_out_y]
	  make_wire $aout_x $aout_y [expr $aout_x + $ws1] $aout_y
	  make name_net_s -name $aname -origin "[expr $aout_x + $ws1] $aout_y"

	  # wire up AND2 inputs
	  # in0
	  set ain_x [expr $and_origin_x + $and_in_x(0)]
	  set ain_y [expr $and_origin_y + $and_in_y(0)]
	  make_wire $ain_x $ain_y $inflag_x $ain_y
	  set aname [format "A_H\[%d\]" $maxaidx]
	  make input -name $aname -origin "$inflag_x $ain_y"
	  # in1
	  set ain_x [expr $and_origin_x + $and_in_x(1)]
	  set ain_y [expr $and_origin_y + $and_in_y(1)]
	  make_wire $ain_x $ain_y $inflag_x $ain_y
	  make input -name "ASigned_H" -origin "$inflag_x $ain_y"
	}

	default {
	  # hook pin to A bit
	  make_wire $apin_x $apin_y $inflag_x $apin_y
	  set aname [format "A_H\[%d\]" $Aval]
	  make input -name $aname -origin "$inflag_x $apin_y"
	}
      }
    }

    # hook up sel output
    set out_x [expr $x + $sel_x]
    set out_y [expr $y + $sel_y]
    make_wire $out_x $out_y $outflag_x $out_y
    set pname [format "PPSel%d_H\[%d:0\]" $i $maxselidx]
    make output -name $pname -origin "$outflag_x $out_y"

    # hook up cin output
    set c_x [expr $x + $cin_x]
    set c_y [expr $y + $cin_y]
    make_wire $c_x $c_y $outflag_x $c_y
    set pname [format "PPCin_H\[%d\]" $i]
    make output -name $pname -origin "$outflag_x $c_y"
      
    # next cell
    set y [expr $y - $delta_y]
  }


  # title bar
  make sccs_title_bar -origin "0 [expr (0 + 2 * $delta_y)]" -owner emc -version 0.1 -date 06/13/00
}



proc ICON_mmig_ppg_booth args {
  # This line is needed for all generators
  icon_generator $args {{NBITS_A 8} {A "Unsigned" {radio Signed Unsigned Both}} {PPGAlgorithm "BoothRadix4" {radio BoothRadix4 BoothRadix8}} {HalfHeight 0 binary}}

  # make the arguments more digestible
  set A [string toupper $A]
  set PPGAlgorithm [string toupper $PPGAlgorithm]

  # useful constants
  set maxaidx [expr $NBITS_A - 1]

  # don't let the user get too crazy
  if {($NBITS_A < 1) || ($NBITS_A > 128)} {
    error "ERROR: NBITS_A ($NBITS_A) not supported"
  }

  # check for acceptable response on A query
  if {($A != "SIGNED") &&
      ($A != "UNSIGNED") &&
      ($A != "BOTH")} {
    error "ERROR: A property ($A) must be Signed or Unsigned or Both"
  }

  # check for acceptable response on PPGAlgorithm query
  if {($PPGAlgorithm != "BOOTHRADIX4") &&
      ($PPGAlgorithm != "BOOTHRADIX8")} {
    error "ERROR: PPGAlgorithm property ($PPGAlgorithm) must be BoothRadix4 or BoothRadix8"
  }
  if {$PPGAlgorithm == "BOOTHRADIX4"} {
    set alg_name "Booth Radix 4" 
    set bitmultiple 2
    set maxselidx 3
  }
  if {$PPGAlgorithm == "BOOTHRADIX8"} {
    set alg_name "Booth Radix 8" 
    set bitmultiple 3
    set maxselidx 7
  }

  # check for acceptable response on HalfHeight query
  if {($HalfHeight != 1) && ($HalfHeight != 0)} {
    error "ERROR: HalfHeight property ($HalfHeight) must be 0 or 1"
  }


  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # how many output pins?
  # compute the number of partial products.  if A=SIGNED and NBITS_A is evenly divisible by the bitmultiple,
  # there will be (NBITS_A/bitmultiple) partial products.  all other cases require one additional partial product.
  set npps [generators_mul_compute_npps $NBITS_A $A $PPGAlgorithm]


  # figure out icon size
  set cs_spacer 100
  set pin_spacer 40
  set icon_y [expr ($npps * $pin_spacer) + (2 * $cs_spacer)]
  set icon_x 400
  set icon_left [expr -($icon_x / 2)]
  set icon_right [expr ($icon_x / 2)]
  set icon_top [expr -($icon_y / 2)]
  set icon_bot [expr ($icon_y / 2)]  
  set icon_right_label [expr $icon_right - 10]
  set icon_left_label [expr $icon_left + 10]

  icon_line $icon_left $icon_top $icon_right $icon_top $icon_right $icon_bot $icon_left $icon_bot $icon_left $icon_top

  # inputs
  icon_term -type input -origin "$icon_left -20" -name "A_H\[$maxaidx:0\]"
  icon_property -origin "$icon_left_label -20" -size small -label A_H
  icon_property -origin "$icon_left_label -10" -size small -label "\[$maxaidx:0\]"
  if {$A == "BOTH"} {
    icon_term -type input -origin "$icon_left 20" -orient R270 -name "ASigned_H"
    icon_property -origin "$icon_left_label 20" -size small -label ASigned_H
  }

  # outputs
  set pin_y [expr $icon_bot - $cs_spacer]
  for {set i 0} {$i < $npps} {incr i} {
    set pname [format "PPSel%d_H\[%d:0\]" $i $maxselidx]
    icon_term -type output -origin "$icon_right $pin_y" -name $pname
    icon_property -origin "$icon_right_label $pin_y" -size small -label $pname -anchor e
    set pin_y [expr $pin_y - $pin_spacer]
  }
  set pname [format "PPCin_H\[%d:0\]" [expr $npps - 1]]
  icon_term -type output -origin "$icon_right $pin_y" -name $pname
  icon_property -origin "$icon_right_label $pin_y" -size small -label $pname -anchor e

  # text
  icon_property -origin {0 -80} -size large -anchor center -label $alg_name
  icon_property -origin {0 -40} -size large -anchor center -label Multiplier
  icon_property -origin {0 0} -size large -anchor center -label Recoder
  icon_property -origin {0 40} -size large -anchor center -label Logic
  if {$A == "UNSIGNED"} {
    set as "U"
  }
  if {$A == "SIGNED"} {
    set as "S"
  }
  if {$A == "BOTH"} {
    set as "U,S"
  }
  set lname [format "%dbits %s" $NBITS_A $as]
  icon_property -origin {0 80} -size large -anchor center -label $lname
  set mods ""
  if {$HalfHeight == 1} {
    set mods " HH "
  }
  icon_property -origin {0 120} -anchor center -label $mods


  # junk
  set junk_y [expr $icon_bot + 200]
  icon_property -origin "0 $junk_y" -type user -name name
  icon_property -origin "0 [expr $junk_y + 20]" -type user -name M
  icon_property -origin "0 [expr $junk_y + 40]" -type user -name dpc
  # this property makes a generator pop up in "Schematic" mode rather than "Verilog" mode
  icon_property -origin "0 [expr $junk_y + 60]" -type fixed -name netlist_level -text 2000
  icon_special -type sccs_title_bar -origin "0 [expr $junk_y + 160]" -owner emc -version 0.1 -date 06/13/00


  # generate verilog property
  set fname [NAME_mmig_ppg_booth -NBITS_A $NBITS_A -A $A -PPGAlgorithm $PPGAlgorithm -HalfHeight $HalfHeight]

  set pnames [format ".A_H(\$\{A_H\[%d:0\]\}), " $maxaidx]  
  if {$A == "BOTH"} {
    set pnames [format "%s, .ASigned_H(\$\{ASigned_H\})" $pnames]
  }
  for {set i 0} {$i < $npps} {incr i} {
    set pnames [format "%s, .PPSel%d_H(\$\{PPSel%d_H\[4:0\]\})" $pnames $i $i]
  }
  set vprop [format "%s \[unique_name \"\" \$name %s\] (%s)\\;" $fname $fname $pnames]
  icon_property -origin "0 [expr $junk_y + 80]" -type fixed -name verilog -text $vprop  
}

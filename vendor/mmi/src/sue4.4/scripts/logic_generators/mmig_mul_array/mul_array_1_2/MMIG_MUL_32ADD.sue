# SUE version MMI_SUE4.1.12

proc SCHEMATIC_MMIG_MUL_32ADD {} {
  make output -orient RY -name Sum_H -origin {1040 960}
  make input -orient RY -name A_H -origin {0 490}
  make input -orient RY -name B_H -origin {0 530}
  generate name_net_s name_net -cell name_net
  make name_net -name G_L -origin {360 510}
  make output -orient RY -name Cout_H -origin {1040 540}
  generate MMI_OAI21 MMI_OAI21C_ -Size C -DeMorgan 1
  make MMI_OAI21C_ -origin {880 540}
  make input -name Cin_H -origin {0 950}
  make name_net -name P_L -origin {360 650}
  generate MMI_XNOR2 MMI_XNOR2B -Size B
  make MMI_XNOR2B -origin {220 650}
  generate MMI_AO22 MMI_AO22C -Size C
  make MMI_AO22C -origin {880 960}
  make name_net -name P_H -origin {360 790}
  make name_net -name Cin_L -origin {640 1010}
  generate MMI_XOR2 MMI_XOR2B -Size B
  make MMI_XOR2B -origin {220 790}
  generate row_spanner row_spanner250 -width 250
  make row_spanner250 -origin {720 350}
  generate MMI_INV MMI_INVC -Size C
  make MMI_INVC -origin {510 1010}
  generate MMI_NAND2 MMI_NAND2B -Size B
  make MMI_NAND2B -origin {220 510}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.11 -date 06/06/00 -origin {420 1270}
  make_wire 0 530 30 530
  make_wire 0 490 50 490
  make_wire 30 670 30 530
  make_wire 50 630 50 490
  make_wire 160 630 50 630
  make_wire 160 670 30 670
  make_wire 50 630 50 770
  make_wire 50 770 160 770
  make_wire 30 670 30 810
  make_wire 30 810 160 810
  make_wire 980 960 1040 960
  make_wire 980 540 1040 540
  make_wire 280 650 360 650
  make_wire 680 650 360 650
  make_wire 680 540 780 540
  make_wire 720 580 780 580
  make_wire 360 790 280 790
  make_wire 360 790 640 790
  make_wire 680 910 780 910
  make_wire 680 540 680 650
  make_wire 680 650 680 910
  make_wire 640 970 780 970
  make_wire 640 970 640 790
  make_wire 30 950 30 1010
  make_wire 570 1010 640 1010
  make_wire 30 1010 450 1010
  make_wire 0 950 30 950
  make_wire 720 1010 640 1010
  make_wire 720 1010 780 1010
  make_wire 30 950 780 950
  make_wire 720 580 720 1010
  make_wire 280 510 360 510
  make_wire 360 510 780 510
  make_wire 50 490 160 490
  make_wire 30 530 160 530
  make_text -origin {-80 120} -text MMIG_MUL_32ADD -size large
  make_text -origin {-80 160} -text {3:2 Adder used in Multiplier}
}

proc ICON_MMIG_MUL_32ADD args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {pad {}}}
  icon_term -type input -origin {-140 -10} -name A_H
  icon_term -type input -origin {-140 10} -name B_H
  icon_term -type input -origin {-140 30} -orient RY -name Cin_H
  icon_term -type output -origin {140 20} -orient RY -name Sum_H
  icon_term -type output -origin {140 0} -orient RY -name Cout_H
  icon_property -origin {-40 220} -type user -name name
  icon_property -origin {-40 240} -type user -name M
  icon_property -origin {-40 260} -type user -name pad
  icon_property -origin {-130 30} -label Cin_H
  icon_property -origin {130 0} -anchor e -label Cout_H
  icon_property -origin {-130 -10} -label A_H
  icon_property -origin {-130 10} -label B_H
  icon_property -origin {130 20} -anchor e -label Sum_H
  icon_property -origin {0 -60} -size large -anchor center -label MMIG_MUL_32ADD
  icon_property -origin {0 20} -size large -anchor center -label {$name}
  icon_line -140 -120 -140 120 140 120 140 -120 -140 -120
}


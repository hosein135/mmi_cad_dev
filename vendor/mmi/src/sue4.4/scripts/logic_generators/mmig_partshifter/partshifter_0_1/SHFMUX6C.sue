# SUE version MMI_SUE4.0p1

proc SCHEMATIC_SHFMUX6C {} {
  make name_net_s -name N3 -origin {660 460}
  make name_net_s -name N2 -origin {660 340}
  make name_net_s -name N1 -origin {660 220}
  make output -name out -origin {970 340}
  make input -name in0 -origin {-70 170}
  make input -name in1 -origin {-70 230}
  make input -name in2 -origin {-70 290}
  make name_net_s -name {[0]} -origin {50 210}
  make name_net_s -name {[1]} -origin {50 270}
  make name_net_s -name {[2]} -origin {50 330}
  generate MMI_AOI22 MMI_AOI22B -Size B
  make MMI_AOI22B -origin {220 220}
  make MMI_AOI22B -origin {220 340}
  make input -name in3 -origin {-70 350}
  make input -name in4 -origin {-70 410}
  make name_net_s -name {[3]} -origin {50 390}
  make name_net_s -name {[4]} -origin {50 450}
  generate MMI_NAND3 MMI_NAND3C_ -Size C -DeMorgan 1
  make MMI_NAND3C_ -orient RY -origin {860 340}
  make MMI_AOI22B -origin {510 460}
  make input -name in5 -origin {-70 470}
  make name_net_s -name {[5]} -origin {50 510}
  make input -name {sel[5:0]} -origin {-70 210}
  generate row_spanner row_spanner240 -width 240
  make row_spanner240 -origin {650 70}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.3 -date 04/20/99 -origin {440 650}
  make_wire 120 170 -70 170
  make_wire 120 230 -70 230
  make_wire 120 290 -70 290
  make_wire 920 340 970 340
  make_wire 50 210 120 210
  make_wire 50 270 120 270
  make_wire -30 210 50 210
  make_wire -30 210 -70 210
  make_wire -30 270 50 270
  make_wire -30 330 50 330
  make_wire 50 330 120 330
  make_wire -30 210 -30 270
  make_wire -30 270 -30 330
  make_wire 120 350 -70 350
  make_wire 50 390 -30 390
  make_wire 50 390 120 390
  make_wire 750 220 750 320
  make_wire 750 320 800 320
  make_wire 750 360 750 460
  make_wire 750 360 800 360
  make_wire 610 460 660 460
  make_wire 660 460 750 460
  make_wire -30 330 -30 390
  make_wire 320 220 660 220
  make_wire 660 220 750 220
  make_wire 320 340 660 340
  make_wire 660 340 800 340
  make_wire -30 390 -30 450
  make_wire -30 450 -30 510
  make_wire -30 510 50 510
  make_wire 50 510 410 510
  make_wire -70 470 410 470
  make_wire -30 450 50 450
  make_wire 50 450 410 450
  make_wire -70 410 410 410
  make_text -origin {-80 -30} -text SHFMUX6C -size large
}

proc ICON_SHFMUX6C args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type output -origin {60 0} -name out
  icon_term -type input -origin {-60 -150} -name in0
  icon_term -type input -origin {-60 -90} -name in1
  icon_term -type input -origin {-60 -30} -name in2
  icon_term -type input -origin {-60 30} -name in3
  icon_term -type input -origin {-60 90} -name in4
  icon_term -type input -origin {-60 150} -name in5
  icon_term -type input -origin {0 170} -orient R270 -name {sel[5:0]}
  icon_property -origin {-40 350} -type user -name name
  icon_property -origin {-40 370} -type user -name M
  icon_property -origin {-40 390} -type user -name dpc
  icon_line -60 -90 -40 -90
  icon_line -60 -150 -40 -150
  icon_line -60 -30 -40 -30
  icon_property -origin {-30 -150} -size small -label 0
  icon_property -origin {0 0} -anchor center -label SC
  icon_line 60 0 40 0
  icon_line -60 90 -40 90
  icon_line -60 30 -40 30
  icon_line -60 150 -40 150
  icon_line -40 -190 40 -150 40 150 -40 190 -40 -190
}


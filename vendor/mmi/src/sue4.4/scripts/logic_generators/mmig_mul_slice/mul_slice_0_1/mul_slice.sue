# This is a generator for a bitslice of a multiplier made up of 4:2 adders.

proc SCHEMATIC_mul_slice args {
  call_use_keyword $args {{NBITS 8} {AddExtraCSA "Y"}}

  # 4:2 adder icon info
  # icon box info
  set icon_x 120
  set icon_y 240
  # icon port info
  set port_in_x(1) -60
  set port_in_y(1) -90
  set port_in_x(2) -60
  set port_in_y(2) -30
  set port_in_x(3) -60
  set port_in_y(3) 30
  set port_in_x(4) -60
  set port_in_y(4) 90
  set port_sum_x 60
  set port_sum_y 30
  set port_carry_x 60
  set port_carry_y -30
  set port_cin_x 0
  set port_cin_y 120
  set port_cout_x 0
  set port_cout_y -120

  # drawing origin
  set base_x -500
  set base_y 0

  # spacings between 4:2 adder icons
  set xfudge $icon_x
  set yfudge [expr $icon_y / 4]
  set nandxfudge 300

  # wire stub lengths
  set ws1 50

  # other icon info
  set nand_x 70
  set inv_x 80

  # useful constants
  set maxidx [expr $NBITS - 1]
  set maxresidx [expr (2 * $NBITS) - 1]
  set NRESBITS [expr (2 * $NBITS)]
  set totboxcount 0

  # figure out how many rows of 4:2 adders are needed
  set j 2
  for {set i 4} {$i <= $NBITS} {set i [expr $i * 2]} {
    set log2($i) $j
    incr j
  }
  set rowcount [expr $log2($NBITS) - 1]
  set lastrow [expr $rowcount - 1]

  # figure out how many boxes are in each row, and how many total boxes, and the max number of boxes in one row
  set totboxcount 0
  set maxboxcount 0
  for {set i 0} {$i < $rowcount} {incr i} {
    set n [expr $rowcount - $i - 1]
    set boxcount($i) [expr int(pow(2,$n))]
    set totboxcount [expr $totboxcount + $boxcount($i)]
    if {$boxcount($i) > $maxboxcount} {
      set maxboxcount $boxcount($i)
    }
  }

  # add an extra row if an extra CSA is desired
  if {[string toupper $AddExtraCSA] == "Y"} {
    set boxcount($rowcount) 1
    set adderloc($lastrow,1) "0 0 0"
    incr rowcount
    incr lastrow
    incr totboxcount
  }

  # figure out carry signal bit ranges
  set c_count [expr $totboxcount - 1]
  set carry_count [expr $c_count - 1]
  if {$c_count == 0} {
    set c_bitrange ""
  } else {
    set c_bitrange [format "\[%d\:0\]" $c_count]
  }
  if {$carry_count == 0} {
    set carry_bitrange ""
  } else {
    set carry_bitrange [format "\[%d\:0\]" $carry_count]
  }

  # generate the row spanner for dpc
  generate row_spanner row_spanner120 -width 120

  set x 0
  set top_y [expr $base_y - (($maxboxcount * ($icon_y + $yfudge)) + (2 * $yfudge))]
  set bot_y [expr $base_y + $icon_y + $yfudge]
  set boxnum -1


  for {set i 0} {$i < $rowcount} {incr i} {
    set bcount $boxcount($i)  
    set y $base_y

    for {set j 0} {$j < $bcount} {incr j} {
      incr boxnum

      # place 4:2 adder
      make m42adder -origin "$x $y" 

      # record placement
      set adderloc($i,$j) "$x $y $boxnum"

      # place nand-inverts with the first row
      if {$i == 0} {
	# figure out nand & invert placement
	set nand2_origin_x [expr $base_x - ($nandxfudge * ($maxboxcount - $j) * 2) - $nandxfudge]

	# figure out wire stub placement for nand inputs
	set nand_base_x [expr $base_x - ($nandxfudge * (($maxboxcount * 2) + 1))]

	for {set z 1} {$z < 5} {incr z} {
	  # place row spanners for dpc when we move the nand origin
	  if {($z == 1) || ($z == 3)} {
	    set nand2_origin_x [expr $nand2_origin_x + $nandxfudge]
#	    make row_spanner120 -origin "[expr $nand2_origin_x + 100] 300"
	  }

	  # figure out nand & invert placement
	  set nand2_in_x [expr $nand2_origin_x - 20]
	  set nand2_out_x [expr $nand2_origin_x + 70]
	  set inv_in_x [expr $nand2_out_x + $ws1]
	  set inv_origin_x [expr $inv_in_x + 30]
	  set inv_out_x [expr $inv_in_x + $inv_x]
	  set stub_x [expr $inv_out_x + $ws1]
	  set nand2_h 60

	  set wname [format "In%d_%d_H" $z $j]
	  set nand_inv_y [expr $y + $port_in_y($z)]
	  set nand2_in1_y [expr $nand_inv_y + 20]
	  set nand2_in2_y [expr $nand_inv_y - 20]
	  make NAND2D -origin "$nand2_origin_x $nand_inv_y" 
	  make INVE_  -origin "$inv_origin_x $nand_inv_y" 
	  make_wire $nand2_out_x $nand_inv_y $inv_in_x $nand_inv_y
	  make_wire $inv_out_x $nand_inv_y $stub_x $nand_inv_y
	  make name_net -name $wname -origin "$stub_x $nand_inv_y"
	  make_wire $stub_x $nand_inv_y [expr $x + $port_in_x([expr 5 - $z])] $nand_inv_y
	  make_wire $nand_base_x $nand2_in1_y $nand2_in_x $nand2_in1_y
	  make_wire $nand_base_x $nand2_in2_y $nand2_in_x $nand2_in2_y
	  set wname [format "A_%d_H" [expr (4 * $j) + (4 - $z)]]
	  make input -origin "$nand_base_x $nand2_in2_y" -name $wname
	  set wname [format "B_%d_H" [expr (4 * $j) + (4 - $z)]]
	  make input -origin "$nand_base_x $nand2_in1_y" -name $wname

	  # record first nand input locations
	  if {($j == 0) && ($z == 4)} {
	    set first_nand_in1_y $nand2_in1_y
	    set first_nand_in2_y $nand2_in2_y
	  }
	  
	}

      } else {
	# wire backwards if it's not the first row
	# note that the extra CSA row's in3, in4 inputs come from outside this schematic
	for {set z 1} {$z < 5} {incr z} {
	  set prev_idx_x [expr $i - 1]
	  # in1, in2 connect to the upper box in previous row
	  # in3, in4 connect to the lower box in previous row
	  if {($z < 3)} {
	    set prev_idx_y [expr 2*$j + 1]
	  } else {
	    set prev_idx_y [expr 2*$j]
	  }
	  set prev_origin_x [lindex $adderloc($prev_idx_x,$prev_idx_y) 0]
	  set prev_origin_y [lindex $adderloc($prev_idx_x,$prev_idx_y) 1]
	  set prev_boxnum [lindex $adderloc($prev_idx_x,$prev_idx_y) 2]

	  if {($z == 1) || ($z == 3)} {
	    if {($z == 1) && ($i == $lastrow) && ([string toupper $AddExtraCSA] == "Y")} {
	      # wire up in1 to the extra CSA input
	      set curr_x [expr $x + $port_in_x($z)]
	      set curr_y [expr $y + $port_in_y($z)]
	      set bend_x [expr $curr_x - 30]
	      set csa_y [expr $top_y + $yfudge]
	      make_wire $curr_x $curr_y $bend_x $curr_y
	      make_wire $bend_x $curr_y $bend_x $csa_y
	      make_wire $bend_x $csa_y $nand_base_x $csa_y
	      make input -origin "$nand_base_x $csa_y" -name "CSA_A_H"
	    } else {
	      # in1, in3 connect to sum ports of previous row
	      set wname [format "S_%d_%d_H" $prev_idx_x $prev_idx_y]
	      set bend_mul 2
	      
	      # hook em up
	      set prev_x [expr $prev_origin_x + $port_sum_x]
	      set prev_y [expr $prev_origin_y + $port_sum_y]
	      set bend_x [expr $prev_x + $ws1]
	      set curr_x [expr $x + $port_in_x($z)]
	      set curr_y [expr $y + $port_in_y($z)]
	      make_wire $prev_x $prev_y $bend_x $prev_y
	      make name_net -name $wname -origin "$bend_x $prev_y"
	      make_wire $bend_x $prev_y $bend_x $curr_y
	      make_wire $bend_x $curr_y $curr_x $curr_y
	    }
	  } else {
	    if {($z == 2) && ($i == $lastrow) && ([string toupper $AddExtraCSA] == "Y")} {
	      # wire up in2 to the extra CSA input
	      set curr_x [expr $x + $port_in_x($z)]
	      set curr_y [expr $y + $port_in_y($z)]
	      set bend_x [expr $curr_x - 50]
	      set csa_y [expr $top_y + $yfudge + $ws1]
	      make_wire $curr_x $curr_y $bend_x $curr_y
	      make_wire $bend_x $curr_y $bend_x $csa_y
	      make_wire $bend_x $csa_y $nand_base_x $csa_y
	      make input -origin "$nand_base_x $csa_y" -name "CSA_B_H"
	    } else {
	      # in2, in4 connect to carry out ports of previous bitslice
	      set prev_x [expr $prev_origin_x + $port_carry_x]
	      set prev_y [expr $prev_origin_y + $port_carry_y]
	      set bend_x [expr $prev_x + $ws1]
	      set curr_x [expr $x + $port_in_x($z)]
	      set curr_y [expr $y + $port_in_y($z)]
	      set wname [format "C0_%d_%d_H" $prev_idx_x $prev_idx_y]
	      make_wire $curr_x $curr_y $bend_x $curr_y
	      make_wire $bend_x $curr_y $bend_x $bot_y
	      if {$carry_count > 0} {
		make name_net_s -name "\[$prev_boxnum\]" -origin "$bend_x $bot_y"
	      }
	      make_wire $bend_x $bot_y $bend_x [expr $bot_y + 2*$ws1]
	      if {(($i == 1) || (($i == 0) && ($i == $lastrow))) && ($j == 0) && ($z == 4)} {
		make_wire $bend_x [expr $bot_y + 2*$ws1] $bend_x [expr $bot_y + 3*$ws1]
		make input -origin "$bend_x [expr $bot_y + 3*$ws1]" -name "CarryIn_H$carry_bitrange" -orient R270
	      } else {
		make_wire $bend_x [expr $bot_y + 2*$ws1] [expr $bend_x - $icon_x - $xfudge] [expr $bot_y + 2*$ws1]
	      }
	    }
	  }
	}
      }


      # wire up the cout
      set cout_x [expr $x + $port_cout_x]
      set cout_y [expr $y + $port_cout_y]
      make_wire $cout_x $cout_y $cout_x $top_y
      if {$c_count > 0} {
	make name_net_s -name "\[$boxnum\]" -origin "$cout_x $top_y"
      }
      make_wire $cout_x $top_y $cout_x [expr $top_y - $ws1]
      if {($i == 0) && ($j == 0)} {
	make_wire $cout_x [expr $top_y - $ws1] $cout_x [expr $top_y - 3 * $ws1]
	make output -origin "$cout_x [expr $top_y - 3 * $ws1]" -name "Cout_L$c_bitrange" -orient R270
      } else {
	make_wire $cout_x [expr $top_y - $ws1] [expr $cout_x - $icon_x - $xfudge] [expr $top_y - $ws1]
      }

      # wire up the cin 
      set cin_x [expr $x + $port_cin_x]
      set cin_y [expr $y + $port_cin_y]
      make_wire $cin_x $cin_y $cin_x $bot_y
      if {$c_count > 0} {
	make name_net_s -name "\[$boxnum\]" -origin "$cin_x $bot_y"
      }
      make_wire $cin_x $bot_y $cin_x [expr $bot_y + $ws1]
      if {($i == 0) && ($j == 0)} {
	make_wire $cin_x [expr $bot_y + $ws1] $cin_x [expr $bot_y + 3 * $ws1]
	make input -origin "$cin_x [expr $bot_y + 3 * $ws1]" -name "Cin_L$c_bitrange" -orient R270
      } else {
	make_wire $cin_x [expr $bot_y + $ws1] [expr $cin_x - $icon_x - $xfudge] [expr $bot_y + $ws1]
      }

      # wire up the carry out
      if {$i != $lastrow} {
	set carry_x [expr $x + $port_carry_x]
	set carry_y [expr $y + $port_carry_y]
	set bend_x [expr $carry_x + $ws1]
	make_wire $carry_x $carry_y $bend_x $carry_y
	make_wire $bend_x $carry_y $bend_x $top_y
	if {$carry_count > 0} {
	  make name_net_s -name "\[$boxnum\]" -origin "$bend_x $top_y"
	}
	make_wire $bend_x $top_y $bend_x [expr $top_y - 2*$ws1]
	if {($i == 0) && ($j == 0)} {
	  make_wire $bend_x [expr $top_y - 2*$ws1] $bend_x [expr $top_y - 3 * $ws1]
	  make output -origin "$bend_x [expr $top_y - 3 * $ws1]" -name "CarryOut_H$carry_bitrange" -orient R270
	} else {
	  make_wire $bend_x [expr $top_y - 2*$ws1] [expr $bend_x - $icon_x - $xfudge] [expr $top_y - 2*$ws1]
	}
      }

      # next box placement
      set x [expr $x + $icon_x + $xfudge]
      set y [expr $y - $icon_y - $yfudge]
    }
  }

  # final sum, carry out
  set curr_origin_x [lindex $adderloc($lastrow,0) 0]
  set curr_origin_y [lindex $adderloc($lastrow,0) 1]
  # sum
  set curr_x [expr $curr_origin_x + $port_sum_x]
  set curr_y [expr $curr_origin_y + $port_sum_y]
  set end_x [expr $curr_x + (4 * $ws1)]
  make_wire $curr_x $curr_y $end_x $curr_y
  make output -origin "$end_x $curr_y" -name "Sum_H"
  # carry
  set curr_x [expr $curr_origin_x + $port_carry_x]
  set curr_y [expr $curr_origin_y + $port_carry_y]
  set end_x [expr $curr_x + (4 * $ws1)]
  make_wire $curr_x $curr_y $end_x $curr_y
  make output -origin "$end_x $curr_y" -name "Carry_H"

  # title bar
  make sccs_title_bar -origin "0 [expr $bot_y + 2 * $icon_y]" -owner emc -version 0.1 -date 01/26/99
}


proc ICON_mul_slice args {
  # This line is needed for all generators
  icon_generator $args {{NBITS 8} {AddExtraCSA "Y"}}
  
  # don't let the user get too crazy
  if {$NBITS > 64} {
    error "ERROR: NBITS ($NBITS) not supported"
  }
  
  # check that NBITS is a power of 2, and greater than or equal to 4
  if {$NBITS < 4} {
    error "ERROR: NBITS must be at least 4"
  }
  set foo $NBITS
  while {$foo > 1} {
    set foo [expr $foo / 2]
  }
  if {$foo != 1} {
    error "ERROR: NBITS must be a power of 2"
  }
  
  # check for acceptable response on AddExtraCSA query
  if {([string toupper $AddExtraCSA] != "Y") && ([string toupper $AddExtraCSA] != "N")} {
    error "ERROR: AddExtraCSA property ($AddExtraCSA) must be Y or N"
  }
  
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  
  # figure out icon size
  set cs_spacer 70
  set pin_spacer 20
  
  # how many pins?
  set pincount [expr 2 * $NBITS]
  set addCSA 0
  if {[string toupper $AddExtraCSA] == "Y"} {
    set addCSA 1
  }
  
  set icon_y [expr ($pincount * $pin_spacer) + (2 * $cs_spacer)]
  set icon_x 220
  set icon_left [expr -($icon_x / 2)]
  set icon_right [expr ($icon_x / 2)]
  set icon_top [expr -($icon_y / 2)]
  set icon_bot [expr ($icon_y / 2)]
  set icon_right_label [expr $icon_right - 10]
  set icon_left_label [expr $icon_left + 10]
  icon_line $icon_left $icon_top $icon_right $icon_top $icon_right $icon_bot $icon_left $icon_bot $icon_left $icon_top
  
  set pin_pos [expr $icon_bot - $cs_spacer]
  for {set i 0} {$i < $NBITS} {incr i} {
    set wname [format "B_%d_H" $i]
    icon_term -type input -origin "$icon_left $pin_pos" -name $wname
    icon_property -origin "$icon_left_label $pin_pos" -size small -label $wname 
    set pin_pos [expr $pin_pos - $pin_spacer]
    set wname [format "A_%d_H" $i]
    icon_term -type input -origin "$icon_left $pin_pos" -name $wname
    icon_property -origin "$icon_left_label $pin_pos" -size small -label $wname 
    set pin_pos [expr $pin_pos - $pin_spacer]
  }
  
  if {$addCSA == 1} {
    icon_term -type input -origin "$icon_left [expr $icon_top + 2*$pin_spacer]" -name CSA_A_H
    icon_property -origin "$icon_left_label [expr $icon_top + 2*$pin_spacer]" -size small -label CSA_A_H
    icon_term -type input -origin "$icon_left [expr $icon_top + 3*$pin_spacer]" -name CSA_B_H
    icon_property -origin "$icon_left_label [expr $icon_top + 3*$pin_spacer]" -size small -label CSA_B_H
  }
  
  icon_term -type output -origin "$icon_right -10" -name Sum_H
  icon_property -origin "$icon_right_label -10" -size small -label "Sum_H" -anchor e
  icon_term -type output -origin "$icon_right 10" -name Carry_H
  icon_property -origin "$icon_right_label 10" -size small -label "Carry_H" -anchor e
  
  # figure out how many rows of 4:2 adders are needed
  set j 2
  for {set i 4} {$i <= $NBITS} {set i [expr $i * 2]} {
    set log2($i) $j
    incr j
  }
  set rowcount [expr $log2($NBITS) - 1]
  
  # figure out how many total boxes
  set totboxcount $addCSA
  for {set i 0} {$i < $rowcount} {incr i} {
    set n [expr $rowcount - $i - 1]
    set boxcount($i) [expr int(pow(2,$n))]
    set totboxcount [expr $totboxcount + $boxcount($i)]
  }
  
  set c_count [expr $totboxcount - 1]
  set carry_count [expr $c_count - 1]
  if {$c_count == 0} {
    set c_bitrange ""
  } else {
    set c_bitrange [format "\[%d\:0\]" $c_count]
  }
  if {$carry_count == 0} {
    set carry_bitrange ""
  } else {
    set carry_bitrange [format "\[%d\:0\]" $carry_count]
  }
  
  icon_term -type input -origin "-40 $icon_bot" -orient R270 -name "Cin_L$c_bitrange"
  icon_property -origin "-40 [expr $icon_bot - 20]" -size small -label "Cin_L" -anchor center
  icon_property -origin "-40 [expr $icon_bot - 10]" -size small -label $c_bitrange -anchor center
  
  icon_term -type output -origin "-40 $icon_top" -orient R270 -name "Cout_L$c_bitrange"
  icon_property -origin "-40 [expr $icon_top + 10]" -size small -label "Cout_L" -anchor center
  icon_property -origin "-40 [expr $icon_top + 20]" -size small -label $c_bitrange -anchor center
  
  if {$c_count != 0} {
    icon_term -type output -origin "40 $icon_top" -orient R270 -name "CarryOut_H$carry_bitrange"
    icon_property -origin "40 [expr $icon_top + 10]" -size small -label "CarryOut_H" -anchor center
    icon_property -origin "40 [expr $icon_top + 20]" -size small -label $carry_bitrange -anchor center
  
    icon_term -type input -origin "40 $icon_bot" -orient R270 -name "CarryIn_H$carry_bitrange"
    icon_property -origin "40 [expr $icon_bot - 20]" -size small -label "CarryIn_H" -anchor center
    icon_property -origin "40 [expr $icon_bot - 10]" -size small -label $carry_bitrange -anchor center
  }  

  set wname [format "%dx%dbit" $NBITS $NBITS]
  icon_property -origin "0 -60" -size large -label $wname -anchor center
  icon_property -origin "0 -20" -size large -label "Multiplier" -anchor center
  icon_property -origin "0 20" -size large -label "Bitslice" -anchor center
  icon_property -origin "0 60" -size large -label {$name} -anchor center
  
  set prop_y $icon_y
  icon_property -origin "-70 $prop_y" -type user -name name
  icon_property -origin "-70 [expr $prop_y + 20]" -type user -name M
  icon_property -origin "-70 [expr $prop_y + 40]" -type user -name dpc
  
  icon_special -type sccs_title_bar -origin "-70 [expr $prop_y + 100]" -owner emc -version 0.1 -date 01/26/99
}


 

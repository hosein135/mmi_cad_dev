# SUE version MMI_SUE4.0p3

proc SCHEMATIC_MMIG_STK_MUX5B {} {
  make MMI_AOI22 -origin {440 500}
  make MMI_AOI22 -origin {440 380}
  make output -name out -origin {880 380}
  generate MMI_NAND3 MMI_NAND3B_ -Size B -DeMorgan 1
  make MMI_NAND3B_ -origin {710 380}
  make name_net_s -name N1 -origin {590 290}
  make name_net_s -name N2 -origin {590 380}
  make name_net_s -name N3 -origin {590 500}
  make input -name in0 -origin {160 270}
  make input -name in1 -origin {160 330}
  make input -name in2 -origin {160 390}
  make input -name in3 -origin {160 450}
  make input -name in4 -origin {160 510}
  make input -name {sel[4:0]} -origin {160 550}
  make name_net_s -name {[4]} -origin {280 550}
  make name_net_s -name {[3]} -origin {280 490}
  make name_net_s -name {[2]} -origin {280 430}
  make name_net_s -name {[1]} -origin {280 370}
  make name_net_s -name {[0]} -origin {280 310}
  generate row_spanner row_spanner220 -width 220
  make row_spanner220 -origin {560 650}
  make MMIG_STK_MUX5B -origin {850 120}
  make MMI_NAND2 -origin {400 290}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.2 -date 06/04/99 -origin {400 790}
  make_wire 160 510 340 510
  make_wire 160 450 340 450
  make_wire 160 390 340 390
  make_wire 160 330 340 330
  make_wire 240 370 240 430
  make_wire 240 430 240 490
  make_wire 240 490 240 550
  make_wire 240 550 160 550
  make_wire 280 550 240 550
  make_wire 280 550 340 550
  make_wire 280 490 340 490
  make_wire 280 490 240 490
  make_wire 280 430 340 430
  make_wire 280 430 240 430
  make_wire 280 370 340 370
  make_wire 280 370 240 370
  make_wire 770 380 880 380
  make_wire 630 290 630 360
  make_wire 630 400 650 400
  make_wire 540 500 590 500
  make_wire 590 500 630 500
  make_wire 630 400 630 500
  make_wire 630 360 650 360
  make_wire 540 380 590 380
  make_wire 590 380 650 380
  make_wire 590 290 460 290
  make_wire 590 290 630 290
  make_wire 340 270 160 270
  make_wire 240 310 240 370
  make_wire 280 310 340 310
  make_wire 280 310 240 310
  make_text -origin {120 40} -text MMIG_STK_MUX5B -size large
}

proc ICON_MMIG_STK_MUX5B args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-60 -80} -name in0
  icon_term -type input -origin {-60 -40} -name in1
  icon_term -type input -origin {-60 0} -name in2
  icon_term -type input -origin {-60 40} -name in3
  icon_term -type output -origin {60 0} -name out
  icon_term -type input -origin {-60 80} -name in4
  icon_term -type input -origin {0 100} -orient R270 -name {sel[4:0]}
  icon_property -origin {-60 220} -type user -name name
  icon_property -origin {-60 240} -type user -name M
  icon_property -origin {-60 260} -type user -name dpc
  icon_line -60 0 -40 0
  icon_line -60 -40 -40 -40
  icon_line -60 40 -40 40
  icon_property -origin {-30 -80} -size small -label 0
  icon_property -origin {0 0} -anchor center -label {STK B}
  icon_line -60 80 -40 80
  icon_line 40 0 60 0
  icon_line -40 -120 40 -80
  icon_line 40 -80 40 80 -40 120 -40 -120
  icon_line -60 -80 -40 -80
}


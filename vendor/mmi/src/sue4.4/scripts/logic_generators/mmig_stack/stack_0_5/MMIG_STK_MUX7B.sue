proc ICON_MMIG_STK_MUX7B args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type output -origin {60 0} -name out
  icon_term -type input -origin {-60 -60} -name in0
  icon_term -type input -origin {-60 -40} -name in1
  icon_term -type input -origin {-60 -20} -name in2
  icon_term -type input -origin {-60 0} -name in3
  icon_term -type input -origin {-60 20} -name in4
  icon_term -type input -origin {-60 40} -name in5
  icon_term -type input -origin {0 80} -orient R270 -name {sel[6:0]}
  icon_term -type input -origin {-60 60} -name in6
  icon_property -origin {-60 200} -type user -name name
  icon_property -origin {-60 220} -type user -name M
  icon_property -origin {-60 240} -type user -name dpc
  icon_line -40 -100 -40 80
  icon_line 60 0 40 0
  icon_line -60 -60 -40 -60
  icon_line -60 -40 -40 -40
  icon_line -60 -20 -40 -20
  icon_line -60 0 -40 0
  icon_line -60 20 -40 20
  icon_line -60 40 -40 40
  icon_property -origin {0 0} -anchor center -label {STK B}
  icon_property -origin {-30 -60} -size small -label 0
  icon_line -40 -100 40 -60
  icon_line 40 -60 40 40
  icon_line -60 60 -40 60
  icon_line -40 -100 40 -60 40 60 -40 100 -40 -100
}


  make_wire 580 460 600 460
  make_wire 550 480 600 480
  make_wire 570 520 570 730
  make_wire 580 250 580 460
  make_wire 510 410 460 410
  make_wire 510 410 550 410
  make_wire 510 570 460 570
  make_wire 510 570 550 570
  make_wire 510 730 460 730
  make_wire 510 730 570 730

proc ICON_MMIG_STK_MUX8B args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-60 -70} -name in0
  icon_term -type input -origin {0 90} -orient R270 -name {sel[7:0]}
  icon_term -type input -origin {-60 -50} -name in1
  icon_term -type input -origin {-60 -30} -name in2
  icon_term -type input -origin {-60 -10} -name in3
  icon_term -type input -origin {-60 10} -name in4
  icon_term -type input -origin {-60 30} -name in5
  icon_term -type input -origin {-60 50} -name in6
  icon_term -type input -origin {-60 70} -name in7
  icon_term -type output -origin {60 0} -name out
  icon_property -origin {-60 200} -type user -name name
  icon_property -origin {-60 220} -type user -name M
  icon_property -origin {-60 240} -type user -name dpc
  icon_line -40 -90 -40 90
  icon_line 60 0 40 0
  icon_line -60 -70 -40 -70
  icon_line -60 -50 -40 -50
  icon_line -60 -30 -40 -30
  icon_line -60 -10 -40 -10
  icon_line -60 10 -40 10
  icon_line -60 30 -40 30
  icon_line -60 50 -40 50
  icon_line -60 70 -40 70
  icon_line -40 -90 -40 -110 40 -70
  icon_line 40 -70 40 70 -40 110 -40 90
  icon_property -origin {0 0} -anchor center -label {STK B}
  icon_property -origin {-30 -70} -size small -label 0
}


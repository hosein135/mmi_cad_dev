set NETLIST_CACHE(nand3,cells) {{icon nmos {}} {icon pmos {}}}
set netlist_props spice
set netlist_level 1000
set NETLIST_CACHE(nand3,globals) {vdd gnd}
set NETLIST_CACHE(nand3,version) MMI_SUE4.2.12
set NETLIST_CACHE(nand3) {{.SUBCKT nand3 in0 in1 in2 out WP=2 WN=3 delay=0} {M_0 out in0 vdd vdd p W='WP*1u' L=lp_min ad='areap(WP,sdd)' } {+ as='areap(WP,sdd)' pd='perip(WP,sdd)' ps='perip(WP,sdd)' } {M_1 out in0 net_1 gnd n W='WN*1u' L=ln_min ad='arean(WN,sdd)' } {+ as='arean(WN,sdd)' pd='perin(WN,sdd)' ps='perin(WN,sdd)' } {M_2 out in1 vdd vdd p W='WP*1u' L=lp_min ad='areap(WP,sdd)' } {+ as='areap(WP,sdd)' pd='perip(WP,sdd)' ps='perip(WP,sdd)' } {M_3 net_1 in1 net_2 gnd n W='WN*1u' L=ln_min ad='arean(WN,sdd)' } {+ as='arean(WN,sdd)' pd='perin(WN,sdd)' ps='perin(WN,sdd)' } {M_4 out in2 vdd vdd p W='WP*1u' L=lp_min ad='areap(WP,sdd)' } {+ as='areap(WP,sdd)' pd='perip(WP,sdd)' ps='perip(WP,sdd)' } {M_5 net_2 in2 gnd gnd n W='WN*1u' L=ln_min ad='arean(WN,sdd)' } {+ as='arean(WN,sdd)' pd='perin(WN,sdd)' ps='perin(WN,sdd)' } {.ENDS	$ nand3} {}}
set NETLIST_CACHE(nand3,names) {{0 0 {0 M_1}} {0 100 {0 M_3}} {-60 -100 {0 in0}} {0 -40 {0 out}} {0 200 {0 M_5}} {320 -100 {0 M_4}} {0 -60 {0 out}} {-60 0 {0 in0}} {-60 100 {0 in1}} {0 40 {0 net_1}} {160 -100 {0 M_2}} {-60 200 {0 in2}} {0 140 {0 net_2}} {0 -100 {0 M_0}} {480 -50 {1 out}} {0 240 {0 gnd} {2 gnd}} {0 60 {0 net_1}} {-100 0 {1 in0}} {0 160 {0 net_2}} {320 -140 {1 vdd} {2 vdd}} {-100 100 {1 in1}} {-100 200 {1 in2}} {320 -60 {0 out}} {160 -140 {1 vdd} {2 vdd}} {0 -140 {1 vdd} {2 vdd}} {160 -60 {0 out}} {260 -100 {0 in2}} {100 -100 {0 in1}}}
set NETLIST_CACHE(nand3,wires) {{0 -60 0 -50 out} {0 -50 0 -40 out} {-60 -100 -60 0 in0} {0 -50 160 -50 out} {-100 0 -60 0 in0} {160 -60 160 -50 out} {-60 100 100 100 in1} {0 40 0 60 net_1} {100 -100 100 100 in1} {160 -50 320 -50 out} {-100 100 -60 100 in1} {320 -60 320 -50 out} {-60 200 260 200 in2} {0 140 0 160 net_2} {260 -100 260 200 in2} {320 -50 480 -50 out} {-100 200 -60 200 in2}}

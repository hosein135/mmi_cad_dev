# Specific routines for spice netlisting

proc spice_netlist {schem dir} {

  global cur_c cur_s scale
  global NETLIST GLOBALS DEFAULT_SPICE_HEADER SUFFIX NETLIST_MAX_NAME_LENGTH
  global VERSION CACHE_TYPE SCHEMS SPICE_INCLUDE

  # spice only allows a maximum name length of 13 characters
#  set NETLIST_MAX_NAME_LENGTH 13

  set schematic_name [get_rootname $schem]

  # spice header stuff
  spice_line_to_file "* FILE: $schematic_name$SUFFIX(spice)\n"
  flush $NETLIST(file_id)

  # The type of netlisting for the top cell
  set type main

  if {[use_first NETLIST(no_header)] != "" && $NETLIST(no_header)} {
    # don't put in a header or comment out subckt def.
    set type ""

    if {[info exists SPICE_INCLUDE]} {
      spice_line_to_file $SPICE_INCLUDE
    }

  } elseif {[file isfile $dir$schematic_name$SUFFIX(spice_header)]} {
    # header file exists so just include it
    puts "Including spice header file \"$dir$schematic_name$SUFFIX(spice_header)\"."
    spice_line_to_file ".INCLUDE \'$schematic_name$SUFFIX(spice_header)\'"

  } else {
    # load in the standard header if one exists
    puts "No header file \"$dir$schematic_name$SUFFIX(spice_header)\", including \"$DEFAULT_SPICE_HEADER\" (DEFAULT_SPICE_HEADER) instead."
    catch "exec cat $DEFAULT_SPICE_HEADER >@$NETLIST(file_id)"
  }

  spice_line_to_file "\n* SPICE netlist for \"$schematic_name\" (generated by $VERSION)\n"

  if {$CACHE_TYPE == "disk"} {
    trace_cached_hierarchy $schematic_name $type
  } else {
    trace_hierarchy $schematic_name $type
  }
  # created from trace_*hierarchy
  set schematic_list $SCHEMS(_LIST_)

  # trace hierarchy may have changed the current schematic, so set it back
  goto_schematic $schem
  update

  foreach schematic $schematic_list {

    global SUE_$schematic

    set cur_c [use_first SUE_${schematic}(canvas) cur_c]
    set cur_s $schematic
    set scale [use_first SUE_${schematic}(scale) scale]

    if {$schematic == $schematic_name} {
      # the main cell is slightly different
      spice_netlist_cell $type
    } else {
      spice_netlist_cell
    }
  }

  # put the globals in
  if {[info exists GLOBALS]} {
    spice_line_to_file ".GLOBAL [array names GLOBALS]\n"
  }

  if {[use_first NETLIST(no_header)] != "" && $NETLIST(no_header)} {
    # if no header, no footer either
  } elseif {[file isfile $dir$schematic_name$SUFFIX(spice_footer)]} {
    # footer file exists so include it
    spice_line_to_file ".INCLUDE \'$schematic_name$SUFFIX(spice_footer)\'\n"
  }

  # spice netlist end line
  if {$type == "main"} {
    spice_line_to_file ".END\n"
  }

  goto_schematic $schematic_name
}


# netlists an entire cell, i.e. creates a subckt.

proc spice_netlist_cell {{level ""}} {

  global cur_c cur_s TERM_LIST NETLIST_CACHE GLOBALS NONEWLINE NETLIST SUE
  global SCHEMS
  upvar #0 TERMS_$cur_s TERMS

  puts -nonewline "    $cur_s ... "
  flush stdout
  set NONEWLINE 1

  if {[lindex [use_first SCHEMS($cur_s)] 0] == "from"} {
    # use extracted
    spice_line_to_file ".INCLUDE '[lindex $SCHEMS($cur_s) 1]'\n"

    puts $SCHEMS($cur_s)
    set NONEWLINE 0
    return
  }

  if {[use_first NETLIST_CACHE($cur_s)] != "" } {
    # if any icon in this schematic has changed then we must re-netlist
    # or if the netlist level (either main or "") has changed, re-netlist.
    if {$level != [use_first NETLIST_CACHE($cur_s,level)]} {
      set NETLIST_CACHE($cur_s) ""
      # There is a chance that we didn't load this since we haven't looked
      # at the level until now
      if {![info exists SUE($cur_s)]} {
	goto_schematic $cur_s
      }
    } else {
      # if this icon hasn't been loaded but a subicon/schematic has 
      # changed, we need to invalidate.
      if {![info exists SUE($cur_s)]} {
	foreach pair [use_first NETLIST_CACHE($cur_s,cells)] {
	  setl {type cell} $pair
	  # has this been modified in this session?
	  upvar #0 SUE_$cell data
	  if {[use_first data(ever_modified)] == "M"} {
	    # modified schematic, flush cache
	    set NETLIST_CACHE($cur_s) ""
	  } else {
	    # check the icon
	    upvar #0 SUE_ICON_$cell data
	    if {[use_first data(ever_modified)] == "M"} {
	      # modified icon, flush cache
	      set NETLIST_CACHE($cur_s) ""
	    }
	  }
	}
      }
      if {$NETLIST_CACHE($cur_s) != ""} {
	# just use the cached info
	line_to_file $NETLIST_CACHE($cur_s)
	foreach name [use_first NETLIST_CACHE($cur_s,globals)] {
	  set GLOBALS($name) 1
	}

	# repeat the warnings to the screen if there are any
	if {$NETLIST(warning) && \
		[use_first NETLIST_CACHE($cur_s,warnings)] != ""} {
	  puts "\n[join $NETLIST_CACHE($cur_s,warnings) \n]"
	  puts -nonewline "    $cur_s ... "
	}

	puts $NETLIST_CACHE($cur_s,cache_type)
	set NONEWLINE 0
	return
      } else {
	if {![info exists SUE($cur_s)]} {
	  goto_schematic $cur_s
	}
      }
    }
  }

  # save level (either main or "").
  set NETLIST_CACHE($cur_s,level) $level

  # erase notification of errors in this cell
  set NETLIST_CACHE($cur_s,error) ""
  set NETLIST_CACHE($cur_s,warnings) ""

  # clear so generate regenerates
  upvar #0 TERMS_$cur_s TERMS
  catch {unset TERMS}

  # does all the hard work of generating all the term/net names
  generate_term_names

  check_interrupt

  if {$level == "main"} {
    set prefix "* "
    spice_line_to_file "* start main CELL $cur_s" $cur_s
  } else {
    set prefix ""
  }

  # spice subcircuit opener
  create_spice_subckt_opener $prefix

  # walk through all instances and create a spice line for them
  foreach id [$cur_c find withtag origin] {
    create_spice_line $id [use_first TERM_LIST($id)]
  }

  # add any spice text lines (text beginning with ^ in schematics)
  foreach id [$cur_c find withtag draw_item&scaletext] {
    set text [$cur_c itemcget $id -text]
    if {[string index $text 0] == "^"} {
      spice_line_to_file [string range $text 1 end] $cur_s
    }
  }

  # spice subcircuit end line
  spice_line_to_file "$prefix.ENDS\t\$ $cur_s\n" $cur_s

  set NETLIST_CACHE($cur_s,cache_type) "cached"

  # make the cache subcell list
  make_netlist_cache_cells

  # write out the netlist cache to a file if it is valid
  write_netlist_cache

  if {$NONEWLINE == 1} {
    puts "done"
    set NONEWLINE 0
  } else {
    puts "    $cur_s ... done"
  }

  if {$NETLIST(update_instance_names)} {
    update_instance_names
  }
}

# Generates the line at the beginning of a spice subcircuit definition

proc create_spice_subckt_opener {prefix} {

  global cur_c cur_s NETLIST
  upvar #0 TERMS_$cur_s TERMS

  set term_list ""

  # gather up all of the I/O's
  set ios [concat [$cur_c find withtag icon_input] \
	       [$cur_c find withtag icon_output] \
	       [$cur_c find withtag icon_inout]]

  foreach id $ios {
    # first get the term id out of the icon
    set term_id [get_intersect_tag inst$id term] 
    lappend term_list "$TERMS($term_id,name) $TERMS($term_id)"
  }

  # sort the term list alphabetically
  set terms [sort_terms_expand $term_list]

  # put together the list of passed properties with defaults
  upvar #0 icon_$cur_s g_data

  global _SPICE_PROP_LIST_
  catch {unset _SPICE_PROP_LIST_}

  set prop_list ""
  if {[info exists g_data(prop_names)]} {
    foreach prop_name $g_data(prop_names) {
      if {[lsearch $NETLIST(ignore_spice_properties) $prop_name] != -1} {
	# ignore these properties
	continue
      }

      set default $g_data(_$prop_name,default)
      if {$default != ""} {
	lappend prop_list "$prop_name=$default"
	# save for passing through multiple levels
	set _SPICE_PROP_LIST_($prop_name) $default
      }
    }
  }

  spice_line_to_file "$prefix.SUBCKT $cur_s $terms $prop_list" $cur_s
}

# Writes a spice subckt call
# Note this procedure defines random variables!!!

proc create_spice_line {id term_list} {

  global cur_c cur_s SUE NETLIST NETLIST_PROPS _SPICE_PROP_LIST_
  upvar #0 TERMS_$cur_s TERMS

  upvar #0 ${cur_s}_inst${id} i_data
  # the type is the really the instance name
  set type $i_data(type)
  upvar #0 icon_$type g_data

  # don't allow recursion.  Useful for placing a cell's icon in its schematic
  # for documentation purposes.
  if {$type == $cur_s} {
    return
  }

  if {[info exists g_data(missing_icon)]} {
    # this is a bad icon, make into an error so this won't get cached.
    sue_error "NETLIST ERROR: skipping missing icon \"$type\" in $cur_s" $cur_s
    return
  }

  # if warnings are on, then print out a warning for unconnected nets
  if {$NETLIST(warning) && [string first " uc_" $term_list] != -1} {
    foreach pair $term_list {
      setl {term term_name} $pair

      if {[string range $term_name 0 2] == "uc_" && \
          [regexp "$term \[^u\]\[^c\]\[^_\]" ${term_list}x] == 0} {

	if {[lsearch $NETLIST(ignore_unconnected) $term] != -1} {
	  # user asked not to see these
	  continue
	}

	if {[info exists WARNINGS($cur_s,$id,$term)]} {
	  continue
	}
	set WARNINGS($cur_s,$id,$term) 1

	sue_warning "NETLIST WARNING: Unconnected net on terminal \"$term\" in icon $type \"[use_first i_data(_name)]\" ($id) in schematic \"$cur_s\"."
      }
    }
  }

  # if this icon has a spice property, use it.
  #set spice [eval use_first g_data(_[join $NETLIST_PROPS "\) g_data\(_"])]
  # This next line is what it used to do
  #set spice [use_first g_data(_spice)]
  # This procedure will also look up in the NETLIST_LEVEL array.
  set spice [get_property_info $type $NETLIST_PROPS]

  if {$spice != ""} {
    # spice inline

    # get rid of continuation lines.  We will reformat and put them back
    # in if needed below.
    regsub -all \n\\+ $spice " " spice

    # define a prop name to be a variable with value of property.
    foreach prop_name $g_data(prop_names) {
      set $prop_name $i_data(_$prop_name)
    }

    if {[info exists M] != 1 || $M == "" || $M == 1} {
      set MP ""
    } else {
      set MP "M=$M"
      if {![catch {expr int($M)} msg] && $msg != $M} {
	sue_warning "Warning: non-integer M property (M=$M) on instance \"$type\" in schematic \"$cur_s\""
      }
    }

    set inst_name [use_first i_data(_name)]

    if {[set inst_width [bus_width $inst_name]] > 1} {
      # must duplicate this gate based on inst_name
      # buses will be enumerated into terminals until they run out
      if {[bus_root $inst_name] == ""} {
	# no root name, use type
	set inst_name "$type$inst_name"
      }

      # array signals
      set bus_term_names ""

      foreach term [lsort $term_list] {
	setl {term_name net_name} $term
	spice_array_bus $term_name $net_name $inst_width $id
	set bus_term_names [concat $bus_term_names [bus_expand $term_name]]
      }

      # now make all the separate inst calls
      foreach inst [bus_expand $inst_name] {
	# assumes that the icon name is kept in the variable "name"
	set name $inst

	foreach term_name $bus_term_names {
	  set $term_name [lindex $bus_terms($term_name) 0]
	  if {[llength $bus_terms($term_name)] > 1} {
	    set bus_terms($term_name) [lrange $bus_terms($term_name) 1 end]
	  }
	}
	# write the inst call
	foreach line [split $spice \n] {
	  if {[catch [list eval concat $line] spice_line] != 0} {
	    # error in inline line
	    sue_error "NETLIST ERROR: bad syntax netlisting \"$type\" with \"$line\" in $cur_s" $cur_s
	    puts $spice_line
	    return
	  }
	  spice_line_to_file "$spice_line $MP" $cur_s
	}
      }
      return

    } else {
      # not a bused instance

      # define term to be a variable with value of net name.
      foreach term $term_list {
	set [lindex $term 0] [lindex $term 1]
      }

      # make the spice line and then write it
      set this_name ""
      foreach line [split $spice \n] {
	if {[catch [list eval concat $line] spice_line] != 0} {
	  # error in inline line
	  sue_error "NETLIST ERROR: bad syntax netlisting \"$type\" with \"$line\" in cell \"$cur_s\"" $cur_s
	  puts $spice_line
	  return
	}
	if {$this_name == "" && [string index $spice_line 0] != "."} {
	  # this is the name we are going to attach to the sue icon
	  set this_name [lindex $spice_line 0]
	}
	spice_line_to_file "$spice_line $MP" $cur_s
      }

      # save the name of this instance for probing
      set TERMS($id) $this_name
      return
    }
  }

  # if this icon has a schematic, do a generic spice subckt call
  set genname [lindex [split_filename [use_first g_data(generator)]] 1]
  if {[info exists SUE($type)] || [info commands SCHEMATIC_$type] != "" || \
	  [info commands SCHEMATIC_$genname] != ""} {
    set inst_name [use_first i_data(_name)]

    # put together the list of passed properties with values
    # ignore name and any property name with a null property
    set prop_list ""
    foreach prop_name $g_data(prop_names) {
      if {($prop_name != "M" && $g_data(_$prop_name,default) == "") || \
	      [lsearch $NETLIST(ignore_spice_properties) $prop_name] != -1} {
	# ignore these properties
	continue
      }

      if {$i_data(_$prop_name) != $g_data(_$prop_name,default) || \
	      [info exists _SPICE_PROP_LIST_($prop_name)]} {
	lappend prop_list "$prop_name=$i_data(_$prop_name)"
	if {$prop_name == "M" && \
		![catch {expr int($i_data(_$prop_name))} msg] && \
		$msg != $i_data(_$prop_name)} {
	  sue_warning "Warning: non-integer M property (M=$i_data(_$prop_name)) on instance \"$type\" in schematic \"$cur_s\""
	}
      }
    }

    if {[set inst_width [bus_width $inst_name]] > 1} {
      # must duplicate this gate based on inst_name
      # buses will be enumerated into terminals until they run out

      # array signals
      set bus_term_names ""

      foreach term [lsort $term_list] {
	setl {term_name net_name} $term
	spice_array_bus $term_name $net_name $inst_width $id
	set bus_term_names [concat $bus_term_names [bus_expand $term_name]]
      }

      set root [unique_name X [bus_root $inst_name] $type]
      setl {min max} [lsort -integer [bus_range $inst_name]]

      # now make all the separate inst calls
      for {set index $max} {$index >= $min} {incr index -1} {
	set name "$root\[$index\]"

	set terms ""
	foreach term $bus_term_names {
	  lappend terms [lindex $bus_terms($term) 0]
	  if {[llength $bus_terms($term)] > 1} {
	    set bus_terms($term) [lrange $bus_terms($term) 1 end]
	  }
	}

	# write the inst call
	spice_line_to_file "$name $terms $type $prop_list" $cur_s
      }

      # save the name of this instance for probing
      set TERMS($id) "$root\[$max:$min\]"

    } else {
      # write the inst call
      set name [unique_name X $inst_name $type]

      # sort the term list alphabetically, expand buses
      set terms [sort_terms_expand $term_list $name $type]

      spice_line_to_file "$name $terms $type $prop_list" $cur_s

      # save the name of this instance for probing
      set TERMS($id) $name
    }

    return
  }

  # otherwise, must be a primitive, like a global or I/O, that doesn't
  # netlist explicitly.
}


# Sends a given line to the netlist file.
# Breaks long lines using a spice format (begins continuations with a +).

proc spice_line_to_file {lines {cell ""}} {

  global NETLIST NETLIST_TYPE

  if {$cell != ""} {
    upvar #0 NETLIST_CACHE($cell) cache
  }

  # first get rid of any curly braces that might have wandered in
#  regsub -all \{|\} $lines "" lines

  # first get rid of any curly braces that might have wandered in
  # and which aren't preceded by the backslash quote character
  regsub -all {([^\])(\})} $lines {\1} lines
  regsub -all {([^\])(\{)} $lines {\1} lines
  regsub -all {(\\)(\{|\})} $lines {\2} lines

  # if not spice, then just print the line as is
  if {[lsearch $NETLIST_TYPE *spice*] == -1} {
    puts $NETLIST(file_id) $lines
    lappend cache $lines

    return
  }

  foreach line [split $lines \n] {
    if {$line == ""} {
      # a line feed
      puts $NETLIST(file_id) $line
      lappend cache $line
    }
    # if you break a comment line, the new line should still be a comment
    if {[string index $line 0] == "*"} {
      set cont_char "*+"
    } else {
      set cont_char "+"
    }
    while {$line != ""} {
      if {[string length $line] > 75} {
	set space [string last " " [string range $line 0 75]]
	if {$space == -1} {
	  set space [expr 50 + [string first " " "[string range $line 50 end] "]]
	}

	set subline [string range $line 0 $space]
	puts $NETLIST(file_id) $subline
	lappend cache $subline
	set line "$cont_char [string range $line [incr space] end]"

      } else {
	puts $NETLIST(file_id) $line
	lappend cache $line
	set line ""
      }
    }
  }
}


# used by the bus_combiner to tie spice nets together

proc spice_assign {out args} {

  set out_list [cbus_expand $out]

  set spice ""
  foreach arg [lreverse $args] {
    foreach in $arg {
      foreach bit [cbus_expand $in] {
	lappend spice "[unique_name V assign] [lindex $out_list 0] $bit 0V"
	if {[llength $out_list] > 1} {
	  set out_list [lrange $out_list 1 end]
	}
      }
    }
  }

  return [join $spice \n]
}


# used by the sign_extender to tie spice nets together

proc spice_expand {out in} {

  set spice ""
  foreach out [cbus_expand $out] {
    lappend spice "[unique_name V assign] $out $in 0V"
  }

  return [join $spice \n]
}


# The term list consists of pairs of terms of the form {type name}.
# Sorts the term list alphabetically, expands buses and returns 
# a list of the names (not types).  Note that the order is crucial.

proc sort_terms_expand {term_list {name ""} {type ""}} {

  global cur_s

  # expand buses
  set terms ""
  foreach term $term_list {
    set term_names [bus_expand [lindex $term 0] "%06d"]
    set bus_names [cbus_expand [lindex $term 1]]

    set len [llength $term_names]
    set blen [llength $bus_names]

    if {$blen == 1} {
      # special case of a bit
      for {set i 0} {$i < $len} {incr i} {
	lappend terms "[lindex $term_names $i] $bus_names"
      }

    } elseif {$len != $blen} {
      if {$type == ""} {
	sue_error "NETLIST ERROR: terminal number and io number don't match in cell \"$cur_s\":" $cur_s
      } else {
	sue_error "NETLIST ERROR: terminal number and io number don't match on instance $name ($type) in cell \"$cur_s\":" $cur_s
      }

      sue_error "\t[lindex $term 0] <> [lindex $term 1]" $cur_s
      return ERROR

    } else {
      for {set i 0} {$i < $len} {incr i} {
	lappend terms "[lindex $term_names $i] [lindex $bus_names $i]"
      }
    }
  }

  # now remove duplicates and only save names
  set net_names ""
  set last "don't match to me"
  foreach pair [lsort $terms] {
    set term_name [lindex $pair 0]
    if {$term_name != $last} {
      lappend net_names [lindex $pair 1]
      set last $term_name
    }
  }

  return $net_names
}	    


# like array_bus but expands everything to bits
# writes into array of calling proc

proc spice_array_bus {term bus width id} {

  # stuff it directly into this array in the calling proc
  upvar bus_terms bus_terms

  if {[set bus_width [cbus_width $bus]] == 1} {
    foreach bit [bus_expand $term] {
      set bus_terms($bit) $bus
    }
    return
  }

  set term_width [bus_width $term]

  if {$bus_width != $term_width && \
	  [expr $term_width * $width] != $bus_width} {
    global NETLIST
    if {$NETLIST(warning)} {
      global cur_s
      upvar #0 ${cur_s}_inst$id i_data

      sue_warning "NETLIST WARNING: Illegal bused array size - $bus into pin \"$term\" on instance $i_data(type) \"[use_first i_data(_name)]\" ($id) with an instance width of $width."
    }
  }

  if {[string first , $bus] == -1 && ![regexp {'(b|d|h|o)} $bus]} {
    # not a concatenated bus

    setl {root msb lsb} [split $bus "\[:\]"]
    if {$msb > $lsb} {

      if {$term_width == 1} {
	set bus_terms($term) ""
	for {set i $msb} {$i >= $lsb} {incr i -1} {
	  lappend bus_terms($term) "$root\[$i\]"
	}
      } else {
	foreach bit [lreverse [bus_expand $term]] {
	  set bus_terms($bit) ""
	  for {set i $msb} {$i >= $lsb} {incr i -$term_width} {
	    lappend bus_terms($bit) "$root\[$i\]"
	  }
	  incr msb -1
	}
      }

    } else {
      # reverse bit order

      if {$term_width == 1} {
	set bus_terms($term) ""
	for {set i $msb} {$i <= $lsb} {incr i} {
	  lappend bus_terms($term) "$root\[$i\]"
	}
      } else {
	foreach bit [lreverse [bus_expand $term]] {
	  set bus_terms($bit) ""
	  for {set i $msb} {$i <= $lsb} {incr i $term_width} {
	    lappend bus_terms($bit) "$root\[$i\]"
	  }
	  incr msb
	}
      }
    }

  } else {
    # concatenated bus

    if {$term_width == 1} {
      set bus_terms($term) [lreverse [cbus_expand $bus]]
      return
    }

    setl {root msb lsb} [split $term "\[:\]"]

    if {$lsb == ""} {
      set bus_terms($term) [lreverse [cbus_expand $bus]]
      return
    }

    if {$msb > $lsb} {
      # clear
      for {set i $msb} {$i >= $lsb} {incr i -1} {
	set bus_terms($root\[$i\]) ""
      }

      set expand [cbus_expand $bus]
      for {set j $bus_width} {$j > 0} {} {
	for {set i $msb} {$i >= $lsb} {incr i -1} {
	  lappend bus_terms($root\[$i\]) [lindex $expand [incr j -1]]
	}
      }

    } else {
      # reverse order

      # clear
      for {set i $msb} {$i <= $lsb} {incr i} {
	set bus_terms($root\[$i\]) ""
      }

      set expand [cbus_expand $bus]
      for {set j $bus_width} {$j > 0} {} {
	for {set i $msb} {$i <= $lsb} {incr i} {
	  lappend bus_terms($root\[$i\]) [lindex $expand [incr j -1]]
	}
      }
    }
  }
}

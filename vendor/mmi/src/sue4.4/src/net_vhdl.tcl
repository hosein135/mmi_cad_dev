# Specific routines for vhdl netlisting

# TODO: handle constants (like gnd, vdd)

proc vhdl_netlist {schem dir} {

  global cur_c cur_s scale NETLIST DEFAULT_VHDL_HEADER SUFFIX
  global NETLIST_MAX_NAME_LENGTH VERSION CACHE_TYPE PROBE_TYPE WARNINGS
  global SEPARATOR INTERRUPT NETLIST_TYPE SCHEMS VHDL_TYPE

  # close probe if open
  if {$PROBE_TYPE == "interactive" && [check_probe //]} {
    interactive_close_probe
  }

#  set NETLIST_MAX_NAME_LENGTH 4096

  set SEPARATOR .

  set schematic_name [get_rootname $schem]

  catch {unset WARNINGS}
  catch {unset VHDL_TYPE}

  # vhdl header stuff
  vhdl_line_to_file "-- FILE: $schematic_name$SUFFIX(vhdl)\n" "" --
  flush $NETLIST(file_id)

  if {[use_first NETLIST(no_header)] != "" && $NETLIST(no_header)} {
    # don't put in a header
  } elseif {$NETLIST_TYPE == "dpc"} {
    # don't put in a header
  } elseif {[file isfile $dir$schematic_name$SUFFIX(vhdl_header)]} {
    # header file exists so just include it
    puts "Including vhdl header file \"$dir$schematic_name$SUFFIX(vhdl_header)\"."
    vhdl_line_to_file "\`include \"$schematic_name$SUFFIX(vhdl_header)\""

  } else {
    # load in the standard header (if one exists)
    # make substitutions for filename
    puts "No header file \"$dir$schematic_name$SUFFIX(vhdl_header)\", including \"$DEFAULT_VHDL_HEADER\" (DEFAULT_VHDL_HEADER) instead."
    catch "exec cat $DEFAULT_VHDL_HEADER | sed \"s/&file&/${schematic_name}/g\" >@$NETLIST(file_id)"
  }

  vhdl_line_to_file "\n-- VHDL netlist for \"$schematic_name\" (generated by $VERSION)\n" "" --

  if {$CACHE_TYPE == "disk"} {
    trace_cached_hierarchy $schematic_name top
  } else {
    trace_hierarchy $schematic_name top
  }

  if {!$INTERRUPT} {

    if {$NETLIST_TYPE == "dpc"} {
      # in dpc, need to invalidate if a subcell changed, not just icon
      dpc_subcell_cache_invalidate
    }

    # created from trace_*_hierarchy
    set schematic_list $SCHEMS(_LIST_)

    # trace hierarchy may have changed the current schematic, so set it back
    goto_schematic $schem
    update
  }

  check_interrupt

  # now netlist each schematic
  foreach schematic $schematic_list {
    upvar #0 SUE_$schematic data

    set cur_c [use_first data(canvas) cur_c]
    set cur_s $schematic
    set scale [use_first data(scale) scale]

    vhdl_netlist_cell

    check_interrupt
  }

  return $schematic_list
}


proc vhdl_netlist_cell {} {

  global cur_c cur_s TERM_LIST NETLIST_CACHE GLOBALS NONEWLINE NETLIST SUE
  global NETLIST_TYPE

  puts -nonewline "    $cur_s ... "
  flush stdout
  set NONEWLINE 1

  if {[use_first NETLIST_CACHE($cur_s)] != "" } {
    if {$NETLIST_TYPE == "dpc" && \
	    [use_first NETLIST_CACHE($cur_s,dpc)] == "" } {
      # if dpc netlist and no dpc data, must renetlist (happpens
      # when vhdl netlist without dpc netlist and same suffix).
      set NETLIST_CACHE($cur_s) ""
    } elseif {![info exists SUE($cur_s)]} {
      # if this icon hasn't been loaded but a subicon/schematic has 
      # changed, we need to invalidate.
      foreach pair [use_first NETLIST_CACHE($cur_s,cells)] {
	setl {type cell} $pair
	# has this been modified in this session?
	upvar #0 SUE_$cell data
	if {[use_first data(ever_modified)] == "M"} {
	  # modified schematic, flush cache
	  set NETLIST_CACHE($cur_s) ""
	} else {
	  # check the icon
	  upvar #0 SUE_ICON_$cell data
	  if {[use_first data(ever_modified)] == "M"} {
	    # modified icon, flush cache
	    set NETLIST_CACHE($cur_s) ""
	  }
	}
      }
    }
    if {$NETLIST_CACHE($cur_s) != ""} {
      # just use the cached info
      line_to_file $NETLIST_CACHE($cur_s)
    
      # repeat the warnings to the screen if there are any
      if {$NETLIST(warning) && \
	      [use_first NETLIST_CACHE($cur_s,warnings)] != ""} {
	puts "\n[join $NETLIST_CACHE($cur_s,warnings) \n]"
	puts -nonewline "    $cur_s ... "
      }

      puts $NETLIST_CACHE($cur_s,cache_type)
      set NONEWLINE 0
      return
    }
  }

  if {![info exists SUE($cur_s)]} {
    goto_schematic $cur_s
  }

  # erase notification of errors and warnings in this cell
  set NETLIST_CACHE($cur_s,error) ""
  set NETLIST_CACHE($cur_s,warnings) ""

  # clear so generate regenerates
  upvar #0 TERMS_$cur_s TERMS
  catch {unset TERMS}

  # does all the hard work of generating all the term/net names
  generate_term_names

  check_interrupt

  # vhdl subcircuit opener
  create_vhdl_module_opener

  # walk through all instances and create a vhdl module call
  foreach id [$cur_c find withtag origin] {
    create_vhdl_line $id [use_first TERM_LIST($id)]
  }

  # add any vhdl text lines (text beginning with ! in schematics)
  foreach id [$cur_c find withtag scaletext] {
    set text [$cur_c itemcget $id -text]
    if {[string index $text 0] == "!"} {
      vhdl_line_to_file "\n[string range $text 1 end]" $cur_s
    }
  }

  # vhdl subcircuit end line
  vhdl_line_to_file "\nend architecture struct;\t -- $cur_s\n" $cur_s

  set NETLIST_CACHE($cur_s,cache_type) "cached"

  # erase any dpc cached data
  catch {unset NETLIST_CACHE($cur_s,dpc)}

  # make the cache subcell list
  make_netlist_cache_cells

  # write out the netlist cache to a file if it is valid
  # if dpc, do this after we have the dpc information
  if {$NETLIST_TYPE != "dpc"} {
    write_netlist_cache
  }

  if {$NONEWLINE == 1} {
    puts "done"
    set NONEWLINE 0
  } else {
    puts "    $cur_s ... done"
  }
}


# generates the line at the beginning of a vhdl module definition

proc create_vhdl_module_opener {} {

  global cur_c cur_s GLOBALS GLOBAL_TRANSLATIONS
  upvar #0 TERMS_$cur_s TERMS

  set term_list ""

  # gather up all of the I/O's
  set ios [concat [$cur_c find withtag icon_input] \
	       [$cur_c find withtag icon_output] \
	       [$cur_c find withtag icon_inout]]

  foreach id $ios {
    # first get the term id out of the icon
    set term_id [get_intersect_tag inst$id term] 
    lappend term_list [list $TERMS($term_id,type) $TERMS($term_id,name) \
			   $TERMS($term_id)]
  }

  # Note: all buses must be continuous (doesn't check)
  set term_names ""
  set terms ""

  foreach pair [concat [lsort $term_list] _bogus_] {
    setl {type term net} $pair

    if {[bus_width $term] != [bus_width $net]} {
      sue_error "NETLIST ERROR: terminal width/I/O width mismatch ($term <> $net) in cell $cur_s" $cur_s
    }

    # vhdl likes in, out, inout.  NOT input, output, inout.
    regsub {put} $type "" type

    set busroot [bus_root $term]

    if {![info exists lastroot]} {
      set lastterm $term
      set lastroot $busroot
      set lasttype $type
      set list $term
    }

    if {$lastroot == $busroot} {
      # if same as last, ignore
      if {$term == $lastterm} {
        continue
      }

      # more bits of bus
      lappend list $term

      if {$lasttype != $type} {
	sue_error "NETLIST ERROR: I/O name \"$lastroot\" of different types in cell $cur_s." $cur_s
      }
    } else {
      # a new bus, combine last one and output
      lappend term_names $lastroot

      if {[llength $list] == 1 && ![is_bus [lindex $list 0]]} {
	# scalar
	lappend terms "\t$lastroot : $lasttype bit;"

      } else {

	setl {root num1 num2} [split [bus_extent $list] "\[:\]"]
	if {$num2 == ""} {
          # special case, verilog doesn't allow [<num>] ????
	  set num2 $num1
	}

	if {$num2 > $num1} {
	  set dir to
	} else {
	  set dir downto
	}

	lappend terms "\t$lastroot : $lasttype bint_vertor ($num1 $dir $num2);"
      }

      set lastterm $term
      set lastroot $busroot
      set lasttype $type
      set list $term
    }
  }

  vhdl_line_to_file "entity $cur_s is" $cur_s

  if {$terms != ""} {
    vhdl_line_to_file "    port(" $cur_s
    foreach line $terms {
      vhdl_line_to_file $line $cur_s
    }
    vhdl_line_to_file "    );" $cur_s
  }
  vhdl_line_to_file "end entity $cur_s;" $cur_s

  vhdl_line_to_file " " $cur_s

  vhdl_line_to_file "architecture struct of $cur_s is" $cur_s

  # now define signals (i.e. nets that aren't I/O's) if there are any
  if {[info exists TERMS(internal_nets)]} {
    foreach net $TERMS(internal_nets) {
      if {[is_bus $net]} {
	setl {root num1 num2} [split $net "\[:\]"]
	if {$num2 == ""} {
          # special case, vhdl doesn't allow [<num>]
	  set num2 $num1
	}

	if {$num2 > $num1} {
	  set dir to
	} else {
	  set dir downto
	}

	vhdl_line_to_file "\tsignal\t$root : bit_vector ($num1 $dir $num2);" $cur_s

      } else {
	vhdl_line_to_file "\tsignal\t$net : bit;" $cur_s
      }
    }
    vhdl_line_to_file " " $cur_s
  }

  # add supplies if necessary
#  foreach var [array names GLOBALS] {
#    # convert to upper case
#    set var [string toupper $var]
#    if {[info exists GLOBAL_TRANSLATIONS(vhdl,supply,$var)]} {
#      vhdl_line_to_file "\t$GLOBAL_TRANSLATIONS(vhdl,supply,$var)" $cur_s
#    }
#  }

  vhdl_line_to_file "begin" $cur_s

  # define equivalents if any ???
#  if {[info exists TERMS(equiv)]} {
#    foreach pair $TERMS(equiv) {
#      vhdl_line_to_file "\tassign\t[lindex $pair 1] = [lindex $pair 0];" $cur_s
#    }
#    vhdl_line_to_file " " $cur_s
#  }
}


# Writes a vhdl subckt call.
# Note this procedure defines random variables!!!

proc create_vhdl_line {id term_list} {

  global cur_c cur_s SUE NETLIST NETLIST_PROPS WARNINGS VHDL_TYPE
  upvar #0 TERMS_$cur_s TERMS

  upvar #0 ${cur_s}_inst$id i_data
  # the type is the really the instance name
  set type $i_data(type)
  upvar #0 icon_$type g_data

  # don't allow recursion.  Useful for placing cell icon in cell.
  if {$type == $cur_s} {
    return
  }

  if {[info exists g_data(missing_icon)]} {
    # this is a bad icon, make into an error so this won't get cached.
    sue_error "NETLIST ERROR: skipping missing icon \"$type\" in $cur_s" $cur_s
    return
  }

  # if warnings are on, then print out a warning for unconnected nets
  # Note that this is complicated by multiple input icons like bus_split
  if {$NETLIST(warning) && [string first " uc_" $term_list] != -1} {
    foreach pair $term_list {
      setl {term term_name} $pair

      if {[string range $term_name 0 2] == "uc_" && \
          [regexp "$term \[^u\]\[^c\]\[^_\]" ${term_list}x] == 0} {

	if {[lsearch $NETLIST(ignore_unconnected) $term] != -1} {
	  # user asked not to see these
	  continue
	}

	if {[info exists WARNINGS($cur_s,$id,$term)]} {
	  continue
	}
	set WARNINGS($cur_s,$id,$term) 1

	sue_warning "NETLIST WARNING: Unconnected net on terminal \"$term\" in icon $type \"[use_first i_data(_name)]\" ($id) in schematic \"$cur_s\"."
      }
    }
  }

  # if this icon has a vhdl property, use it.
  #set vhdl [eval use_first g_data(_[join $NETLIST_PROPS "\) g_data\(_"])]
  # This next line is what it used to do
  #set vhdl [use_first g_data(_vhdl)]
  # This procedure will also look up in the NETLIST_LEVEL array.
  set vhdl [get_property_info $type $NETLIST_PROPS]

  if {$vhdl != ""} {
    # vhdl inline

    # get rid of returns
    regsub -all \n $vhdl " " vhdl

    # define a prop name to be a variable with value of property.
    foreach prop_name $g_data(prop_names) {
      set $prop_name $i_data(_$prop_name)
    }

    set inst_name [lookup_name [use_first i_data(_name)]]

    if {[bus_width $inst_name] == 1} {
      # bus widths of one are individual instances.  Change name otherwise
      # vhdl might barf.
      set inst_name [bus_root $inst_name]
    }

    # if inst_name is a bus then make multiple copies of instance
    if {[is_bus $inst_name]} {
      # must duplicate this gate based on inst_name
      # buses will be enumerated into terminals until they run out
      set bus_term_names ""
      set inst_width [bus_width $inst_name]

      # array signals
      foreach term [lsort $term_list] {
	setl {term_name net_name} $term
	set bus_terms($term_name) \
	    [array_bus $term_name $net_name $inst_width $id]
	lappend bus_term_names $term_name
      }

      # make up a unique root name
      set root [unique_name "" [bus_root $inst_name] $type]
      setl {min max} [lsort -integer [bus_range $inst_name]]

      # now make all the separate inst calls
      for {set index $max} {$index >= $min} {incr index -1} {
	# assumes that the icon name is kept in the variable "name"
	set name "$root\$$index\$"
	set TERMS(bus,$id,$index) $name

	foreach term_name $bus_term_names {
	  set $term_name [lindex $bus_terms($term_name) 0]
	  set TERMS(bus,$id,$index,$term_name) [set $term_name]
	  if {[llength $bus_terms($term_name)] > 1} {
	    set bus_terms($term_name) [lrange $bus_terms($term_name) 1 end]
	  }
	}
	# write the inst call
	if {[catch [list eval concat $vhdl] vhdl_line] != 0} {
	  # error in inline line
	  sue_error "NETLIST ERROR: bad syntax netlisting \"$type\" with \"$vhdl\" in $cur_s" $cur_s
	  puts $vhdl_line
	  return
	}
	vhdl_line_to_file "\t$vhdl_line" $cur_s
      }

      # save the name of this instance for probing
      set TERMS($id) "$root\[$max:$min\]"

      return

    } else {
      # Only one copy of instance

      set name $inst_name

      # define term to be a variable with value of net name.
      foreach term $term_list {
	set term_name [lindex $term 0]
	if {[info exists $term_name]} {
	  # OBSOLETE, I THINK
	  # for duplicate I/O's -- old way of doing multi input gates
	  # unconnected nets have the name uc_*.  Don't include them.
	  if {[string range [set $term_name] 0 2] == "uc_"} {
	    set $term_name [lindex $term 1]
	  } elseif {[string range [lindex $term 1] 0 2] != "uc_"} {
	    set $term_name "[set $term_name], [lindex $term 1]"
	  }
	} else {
	  set net_name [lindex $term 1]
	  set $term_name $net_name

	  if {![info exists g_data(_primitive)] && \
		  [bus_width $term_name] != [cbus_width $net_name]} {
	    sue_warning "NETLIST WARNING: Illegal bused wire width - $net_name into pin \"$term_name\" on instance $i_data(type) \"[use_first i_data(_name)]\" ($id)."
	  }
	}
      }

      # make the vhdl line and then write it
      if {[catch [list eval concat $vhdl] vhdl_line] != 0} {
	# error in inline line
	sue_error "NETLIST ERROR: bad syntax netlisting \"$type\" with \"$vhdl\" in $cur_s" $cur_s
	sue_error $vhdl_line
	return
      }
      vhdl_line_to_file "\t$vhdl_line" $cur_s

      # try to figure out the name of this instance assuming the following
      # three possibilities:
      #   type name(io1, io2, ...);
      #   type #delay name(io1, io2, ...);
      #   type #(delay1, delay2, ...) name(io1, io2, ...);

      # if it starts with an assign, save for dpc
      if {[lindex $vhdl_line 0] == "assign"} {
	lappend TERMS(assigns) [list $id $vhdl_line]
	return
      }

      # save the vhdl module type called for this instance
      set VHDL_TYPE($type) [lindex $vhdl_line 0] 

      set tmp [split $vhdl_line "("]
      if {[string first \# [lindex $tmp 0]] == -1} {
	set tmp [lindex $tmp 0]
      } else {
	if {[regexp {(\#)[ \t\n]*(\()} $vhdl_line]} {
	  set tmp [lindex $tmp 1]
	} else {
	  set tmp [lindex $tmp 0]
	}
      }
      set TERMS($id) [lindex $tmp [expr [llength $tmp] - 1]]

      # could be invalid
      if {[catch {lindex $TERMS($id) 0}]} {
	unset TERMS($id)
      }

      return
    }
  }

  # if this has a schematic, do a generic vhdl subckt call
  set genname [lindex [split_filename [use_first g_data(generator)]] 1]
  if {[info exists SUE($type)] || [info commands SCHEMATIC_$type] != "" || \
	  [info commands SCHEMATIC_$genname] != ""} {
    set inst_name [lookup_name [use_first i_data(_name)]]

    if {[bus_width $inst_name] == 1} {
      # bus widths of one are individual instances.  Change name otherwise
      # vhdl might barf.
      set inst_name [bus_root $inst_name]
    }

    if {[is_bus $inst_name]} {
      # must duplicate this gate based on inst_name
      # buses will be enumerated into terminals until they run out
      set bus_term_names ""

      # makeup a unique root name
      set root [unique_name "" [bus_root $inst_name] $type]
      setl {min max} [lsort -integer [bus_range $inst_name]]
      set inst_width [bus_width $inst_name]

      # array signals
      foreach term [lsort $term_list] {
	setl {term_name net_name} $term
	set bus_terms($term_name) \
	    [array_bus $term_name $net_name $inst_width $id]
	lappend bus_term_names $term_name
      }

      # now make all the separate inst calls
      for {set index $max} {$index >= $min} {incr index -1} {
	# assumes that the icon name is kept in the variable "name"
	set name "$root\$$index\$"
	set TERMS(bus,$id,$index) $name

	set terms ""
	foreach term_name $bus_term_names {
	  set term_value [lindex $bus_terms($term_name) 0]
	  set TERMS(bus,$id,$index,$term_name) $term_value
	  lappend terms "[bus_root $term_name] => $term_value"
	  if {[llength $bus_terms($term_name)] > 1} {
	    set bus_terms($term_name) [lrange $bus_terms($term_name) 1 end]
	  }
	}

	# write the inst call
	vhdl_line_to_file \
	    "\t$name: entity work.${type}(basic)\n\tport map \([join $terms {, }]\)\;" $cur_s
      }

      # save the name of this instance for probing
      set TERMS($id) "$root\[$max:$min\]"

    } else {
      # write the inst call
      set name [unique_name "" $inst_name $type]

      # setup for call by name.  If multiple inputs, doesn't
      # merge for now (???).
      set terms ""
      foreach term $term_list {
	setl {term_name net_name} $term
	lappend terms "[bus_root $term_name] => $net_name"

	if {![info exists g_data(_primitive)] && \
		[bus_width $term_name] != [cbus_width $net_name]} {
	  sue_warning "NETLIST WARNING: Illegal bused wire width - $net_name into pin \"$term_name\" on instance $i_data(type) \"[use_first i_data(_name)]\" ($id)."
	}
      }

      vhdl_line_to_file \
	  "\t$name: entity work.${type}(basic)\n\tport map \([join $terms {, }]\)\;" $cur_s

      # save the name of this instance for probing
      set TERMS($id) $name
    }

    return
  }

  # otherwise, must be a primitive, like a global or I/O, that doesn't
  # netlist explicitly.
}


# Sends a given line to the netlist file.
# Breaks long lines at spaces.  Should look for spaces in "" -- but doesn't

proc vhdl_line_to_file {lines {cell ""} {prefix ""}} {

  global NETLIST

  if {$cell != ""} {
    upvar #0 NETLIST_CACHE($cell) cache
  }

  # first get rid of any curly braces that might have wandered in
  # regsub -all \{|\} $lines "" lines

  # first get rid of any curly braces that might have wandered in
  # and which aren't preceded by the backslash quote character
  regsub -all {([^\])(\})} $lines {\1} lines
  regsub -all {([^\])(\{)} $lines {\1} lines
  regsub -all {(\\)(\{|\})} $lines {\2} lines

# TODO: ,<not space> with ,<space>
  # replaces ",." with ", ." so we can break lines (also improves readability)
  regsub -all {(,)(\.)} $lines ", ." lines

  if {[string range $lines 0 4] == "\t!nw!"} {
    # this means don't wrap the lines
    regsub "!nw!" $lines "" line
    puts $NETLIST(file_id) $line
    lappend cache $line
    return
  }

  foreach line [split $lines \n] {
    if {$line == ""} {
      # a line feed
      puts $NETLIST(file_id) $line
      lappend cache $line
    }
    while {$line != ""} {
      if {[string length $line] > 70} {
	set space [string last " " [string range $line 0 70]]
	if {$space == -1} {
	  set space \
	      [expr 50 + [string first " " "[string range $line 50 end] "]]
	}

	set subline [string range $line 0 $space]
	puts $NETLIST(file_id) $subline
	lappend cache $subline
	set line "$prefix\t\t[string range $line [incr space] end]"

      } else {
	puts $NETLIST(file_id) $line
	lappend cache $line
	set line ""
      }
    }
  }
}


# replaces the vhdl property given by the id with a regenerated one.
# called from an "auto" type of property during updating.

proc auto_vhdl {id} {

  global cur_c

  set coords [$cur_c coords $id]
  # delete the old one
  $cur_c delete $id

  # remake and put at same coords.
  return [create_vhdl_property $coords]
}


# creates an icon property that is a guess at what the user wants the
# vhdl property to be.  This is a helper function.

proc create_vhdl_property {{coords ""}} {

  global cur_s cur_c

  modify_setup

  if {![is_icon $cur_s]} {
    sue_error "Aborting, can only create vhdl properties for icons."
    sue_error flush
    return ""
  }

  set name [get_rootname $cur_s]

  set text "-type auto -name vhdl -text \{\[unique_name \"\" \$name $name\]: entity work.${name}(basic)\n\tport map ("

  set ios [concat [$cur_c find withtag icon_input] \
	       [$cur_c find withtag icon_inout] \
	       [$cur_c find withtag icon_output]]
  set separator ""

  set i 4
  foreach id $ios {
    upvar #0 ${cur_s}_inst$id i_data

    incr i -1
    if {$i < 0} {
      set i 3
      set text "$text$separator\n\t\t"
    } else {
      set text "$text$separator"
    }

    set inst_name $i_data(_name)
    if {[is_bus $inst_name]} {
      set ident [bus_root $inst_name]
    } else {
      set ident $inst_name
    }

    # can't mix $ and ` variables in the same I/O
    if {[string first $ $inst_name] != -1} {
      # this is a $ variable that has to be expanded in the global context
      set bracket [string first \[ $inst_name]
      if {$bracket != -1 && $bracket < [string first $ $inst_name]} {
	set ident [bus_root $inst_name]
      } else {
	set ident [lindex [split $inst_name \$] 0]
      }

      set ident [string trimright $ident \\]

      regsub -all {\[} $inst_name {\[} io_name
      regsub -all {\]} $io_name {\]} io_name

      set text \
	  "$text$ident => \[set \[uplevel \#0 \{eval concat \{$io_name\}\}\]\]"

      regsub -all {\\\$} $text {$} text

    } elseif {[string first ` $inst_name] != -1} {
      # this is a ` variable that has to be expanded in the global context
      set bracket [string first \[ $inst_name]
      if {$bracket != -1 && $bracket < [string first ` $inst_name]} {
	set ident [bus_root $inst_name]
      } else {
	set ident [lindex [split $inst_name \`] 0]
      }

      regsub -all {\[} $inst_name {\[} io_name
      regsub -all {\]} $io_name {\]} io_name
      regsub -all {`} $io_name {$__} io_name

      set text \
	  "$text.$ident\(\[set \[uplevel \#0 \{eval concat \{$io_name\}\}\]\]\)"

    } else {
      # no variable expansion
      if {[is_bus $inst_name]} {
	set io_name "\{$inst_name\}"
      } else {
	set io_name $inst_name
      }

      set text "$text$ident => \$$io_name"
    }
	
    set separator ", "
  }

  set text "$text\)\\;\}"
       
  if {$coords == ""} {
    # now make the test and select it
    set id [make_text -text $text -origin [center_bbox [visible_bbox]]]
    select_id $id

    return $id

  } else {
    # add the text at the given coords and return id
    return [make_text -text $text -origin $coords]
  }
}


# Creates an editor window to edit vhdl of either the selected instance
# in a schematic, the schematic itself if no instance is selected, or
# the icon if in an icon.  If no vhdl can be found in the vhdl
# path, then creates a new vhdl file and builds the framework.

proc edit_vhdl {} {

  global cur_c cur_s auto_index VHDL_PATH SUFFIX env SUE_DIR
  global DEFAULT_EDITOR

  set editor [use_first env(EDITOR) DEFAULT_EDITOR]

  # special case for vi, need to put into a window
  if {[regexp -nocase {([a-z/._-]*vi[a-z/._-]*)} $editor match]} {
    set editor "xterm -e $match"
  }

  # if icon then just use this one
  if {[is_icon $cur_s]} {
    set name [get_rootname $cur_s]
    upvar #0 SUE_$cur_s data
    set dir [string trimright $data(dir) /]
  } else {
    # must be a schematic
    set current_id [lindex [$cur_c find withtag selected] 0]
    set id [find_origin $current_id]

    if {[is_tagged $id origin]} {
      upvar #0 ${cur_s}_inst$id i_data
      set type $i_data(type)
      upvar #0 icon_$type g_data
    }

    if {[is_tagged $id origin] != 1 || [use_first g_data(_primitive)] != ""} {
      # not an instance of an icon, use this schematic
      set name $cur_s
      upvar #0 SUE_$cur_s data
      set dir [string trimright $data(dir) /]
    } else {
      # use the icon
      set tags [$cur_c gettags $id]
      set name [string range [lindex $tags [lsearch $tags "icon_*"]] 5 end]
      # get the directory out of the auto_index
      set dir [file dirname [lindex $auto_index(ICON_$name) 1]]
    }
  }

  set dirs $VHDL_PATH
  insert_unique dirs end $dir

  set filename $name$SUFFIX(behavioral_vhdl)

  foreach vdir $dirs {
    if {[file exists $vdir/$filename]} {
      update_vhdl_file $name $vdir/$filename
      puts "running \"$editor\" with $vdir/$filename ..."
      eval exec $editor $vdir/$filename &
      return
    }
  }

  # can't find a vhdl file.  Query the user to make sure they want
  # one and verify the directory for the file to be created.

  puts "Can't find vhdl file $filename in:\n\t[join $dirs \n\t]"

  set winy [expr [winfo rooty $cur_c] + 50]
  set winx [expr [winfo rootx $cur_c] + 50]
  set title "Can't find vhdl file"
  set message "Create new vhdl file for \"$name\" using"
  set prop_list \
      [list [list path "[lindex $VHDL_PATH 0]/$filename"]]

  # create the menu
  set new_prop_list [prop_menu $winx $winy $message $title $prop_list]
  if {$new_prop_list == ""} {
    # empty list means the user hit cancel
    return
  }

  set path [lindex [lindex $new_prop_list 0] 1]

  if {[file exists $path]} {
    # Uh Oh, this file already esists, query user.
    set button [tk_dialog .vhdl_it "Edit Vhdl" \
		    "File $path already exists." \
		    @$SUE_DIR/sue_icon.xbm 0 {Use} {overwrite} {cancel}]

    if {$button == 2} {
      # user hit the cancel key
      return
    }
    if {$button == 0} {
      # use the existing file
      update_vhdl_file $name $path
      puts "running \"$editor\" with $path ..."
      eval exec $editor $path &
      return
    }
  }

  # make the header and write it to a file
  set header [create_vhdl_framework $name]

  # open file
  if {[catch "open $path w" msg] != 0} {
    # error, probably can't write to directory
    sue_error "Aborting. $msg"
    sue_error flush
    ready
    return
  }
  set file_id $msg

  puts $file_id $header

  # close file
  close $file_id

  # now bring up the editor
  puts "running \"$editor\" with $path ..."
  eval exec $editor $path &

  ready
}


# check to see if the user has changed the icon such that the vhdl
# behavioral model is not up-to-date.  If not, ask user whether to update.

proc update_vhdl_file {cell path} {

  global SUE_DIR SUFFIX

  # this is what the header should look like
  set header [create_vhdl_framework $cell header_only]
  set header_list [split $header \n]

  # read the existing file and compare headers
  if {[catch "open $path r" msg] != 0} {
    # can't read, just skip
    sue_warning "SUE can't read \"$path\" to check. $msg"
    return 0
  }
  set file_id $msg

  set body ""
  set preamble ""
  set blank_lines 0

  set match 1
  set in_module 0

  while {[gets $file_id line] >= 0} {
    set test [string trim $line]
    regsub -all \t $test " " test
    set pos [expr [string first " " $test] - 1]
    if {$pos == -2} {
      set pos end
    }
    switch -glob [string range $test 0 $pos] {
      //* {
	# comment
	lappend body $line
      }

      "" {
	# blank line
	if {$blank_lines > 0} {
	  incr blank_lines -1
	} else {
	  lappend body $line
	}
      }

      endmodule {
	lappend body $line
	set in_module 0
      }

      module {
	# module opener
	regsub {\(} $test " \(" test
	set test [string range $test [expr [string first " " $test] + 1] end]
	if {[string range $test 0 [expr [string first " " $test] - 1]] == \
		$cell} {
	  set in_module 1
	} else {
	  lappend body $line
	  continue
	}

	set preamble $body
	set body ""
	
	set opener ""
	# get the rest of the header up to the ;
	while {[string first ";" $line] == -1} {
	  lappend opener $line
	  gets $file_id line
	}
	lappend opener $line

	# check if the header has changed in any way from new.
	foreach part $opener {
	  if {$part != [lindex $header_list 0]} {
	    # no match
	    set match 0
	    break
	  }

	  set header_list [lrange $header_list 1 end]
	}

	# I don't know why this is needed but it is.
	incr blank_lines

	if {$header_list != "" && [lindex $header_list 0] == ""} {
	  incr blank_lines
	  set header_list [lrange $header_list 1 end]
	}
      }

      input -
      output -
      inout {
	if {!$in_module} {
	  # wrong module, ignore
	  lappend body $line
	  continue
	}

	# port declaration
	if {$line == [lindex $header_list 0]} {
	  # matched
	} else {
	  # no match
	  set match 0
	}
	set header_list [lrange $header_list 1 end]
	if {$header_list != "" && [lindex $header_list 0] == ""} {
	  incr blank_lines
	  set header_list [lrange $header_list 1 end]
	}
      }
    
      default {
	# anything else
	lappend body $line
      }
    }
  }

  # close file
  close $file_id

  if {$match} {
    # no changes, we're done.
    return 1
  }

  # query the user to change the file and replace the existing header
  # with an up-to-date one.

  set button [tk_dialog .update_vhdl "Update Vhdl" \
		  "Header for vhdl file $path out of date with icon." \
		  @$SUE_DIR/sue_icon.xbm 0 {update} {use existing}]
      
  if {$button == 1} {
    # use the existing file
    return 1
  }

  # first backup the vhdl file
  catch "exec \"mv\" -f $path $path$SUFFIX(backup)"

  # update the file, i.e. overwrite it
  if {[catch "open $path w" msg] != 0} {
    # error, probably can't write to directory
    sue_error "Aborting update. $msg"
    sue_error flush
    return 1
  }
  set file_id $msg

  puts $file_id [join $preamble \n]
  puts $file_id $header
  puts $file_id [join $body \n]

  # close file
  close $file_id

  # success
  return 1
}


# returns a vhdl framework for an cell.

proc create_vhdl_framework {cell_name {header_only ""}} {

  global cur_s cur_c VERSION

  # Now create the framework for the new vhdl file
  set save_cur_s $cur_s

  goto_schematic ICON_$cell_name

  set ios [concat [$cur_c find withtag icon_input] \
	       [$cur_c find withtag icon_inout] \
	       [$cur_c find withtag icon_output]]
  set separator ""

  if {$header_only == ""} {
    set header "-- Created by $VERSION\n\n"
  }
  set module "module $cell_name ("
  append header $module
  set line_length [string length $module]

  foreach id $ios {
    upvar #0 ${cur_s}_inst$id i_data
    set io_name [bus_root $i_data(_name)]
    # make sure the line doesn't get too long
    incr line_length [string length $separator$io_name]
    if {$line_length > 70} {
      set separator "$separator\n\t"
      set line_length [expr 8 + [string length $io_name]]
    }
    append header "$separator$io_name"
    set separator ", "
  }

  append header ");\n\n"

  foreach id $ios {
    upvar #0 ${cur_s}_inst$id i_data
    append header "\t$i_data(type)\t"
    if {[is_bus $i_data(_name)]} {
      set name $i_data(_name)
      if {[string first \$ $name] != -1} {
	set name_explode [split $name "\[:\]"]
	set explode ""
	foreach part $name_explode {
	  if {[catch {uplevel #0 "eval concat $part"} msg]} {
	    # probably undefined
	    sue_error \
		"NETLIST ERROR: $msg in cell $cur_s.  Set value to 0." $cur_s
	    # set the value to 0
	    set msg 0
	  }
	  lappend explode $msg
	}

	switch [llength $name_explode] {
	  1 { set name $explode }
	  3 { set name "[lindex $explode 0]\[[lindex $explode 1]\]"}
	  4 { set name \
	       "[lindex $explode 0]\[[lindex $explode 1]:[lindex $explode 2]\]"}
	}
      }
      append header "\[[lindex [split $name "\["] 1]\t"
    } else {
      append header "\t"
    }
    set io_name [bus_root $i_data(_name)]
    append header "$io_name;\n"
    }

  if {$header_only == ""} {
    append header "\n\t-- Enter vhdl here\n"
    append header "\nendmodule\t -- $cell_name"
  }

  goto_schematic $save_cur_s

  return $header
}


# menu_add -menu sim -label "add vhdl signals" -command parse_vhdl \
    -help "Prompt for the name of a VHDL file and add signals from it into schematic."

proc parse_vhdl {} {

  global cur_c cur_s scale SUE SUFFIX fsBox SUE_DIR

  set schematic [get_rootname $cur_s]
  global SUE_${schematic}

  # if there is no schematic, then look in the icon
  if {[info exists SUE_${schematic}(canvas)] != 1} {
    set schematic $cur_s
    global SUE_${schematic}
  }

  set dir [set SUE_${schematic}(dir)]
  if {$dir == ""} {
    set dir "[pwd]/"
  }

  # Prompt for a file name
  set save_pattern $fsBox(pattern)
  set filename [FSBox "Enter VHDL File:" "$dir${schematic}.v" "" "" "" \
		   "" *.vhd]
  set fsBox(pattern) $save_pattern

  # if nil, file selector box cancelled -- do nothing
  if {$filename == ""} { 
    return 
  }

  # open the vhdl file to parse
  if {[catch "open $filename r" msg]} {
    # error
    set button [tk_dialog .parse_vhdl "Bad File" \
		    $msg @$SUE_DIR/sue_icon.xbm 0 {ok}]
    return
  } 
  set FILE_ID $msg

  busy

  set ids ""
  
  # place new I/Os on the left side in a column
  $cur_c delete tmp
  $cur_c addtag tmp withtag all
  $cur_c dtag grid tmp
  setl {x y} [round_list_scale [$cur_c bbox all] $scale]
  if {$x == "" || $y == ""} {
    set x 0
    set y 0
  }

  $cur_c dtag tmp

  set x [expr $x -30 * $scale]
  set dy [expr $scale * 4]

  # now read it
  set in_module 0
  set count 0
  while {[gets $FILE_ID line] >= 0} {

    # can't do the obvious because these aren't well formed lists
    # set type [lindex $line 0]

    # toast tab characters and leading spaces
    regsub -all \t $line " " line
    set line [string trimleft $line]

    if {[string first entity $line] == 0} {
      # found the start of a module
      if {[string tolower [lindex $line 1]] == [string tolower $cur_s]} {
	# this is the correct one
	set in_module 1
      } else {
	set in_module 0
      }

      # skip to end of I/O declarations
      while {[gets $FILE_ID line] >= 0} {
	set line [string trimleft $line]
	if {[string first end $line] == 0} {
	  break
	}
      }

      continue
    }

    if {[string first signal $line] == 0} {
      # found a wire declaration
      # strip off -- to end of line if there is one (comment)
      set index [string first -- $line]
      if {$index != -1} {
	set line [string range $line $index end]
      }

      # append lines until an end of line is found
      while {[string last \; $line] == -1} {
	gets $FILE_ID line2
	set line [concat $line $line2]
      }

      set min ""
      regexp {:[a-zA-Z_ ]*\(([0-9]+)[a-zA-Z_ ]*([0-9]+)\)} $line match max min

      if {$min == ""} {
	# must be scalar
	set bus ""
      } else {
	set bus "\[${max}:${min}\]"
      }

      set signals [lindex [split [lrange $line 1 end] :] 0]

      foreach signal [split $signals ,] {
	set name [string trim $signal]$bus

	# add a name_net for this
	lappend ids [make name_net_s -origin "$x $y" -name $name]
	incr count
	set y [expr $y + $dy]
      }
    }
  }
  # close the file
  close $FILE_ID
    
  is_modified

  zoom_to_fit

  select_ids $ids

  # save undo information
  setup_undo $ids ""

  puts "Added $count I/O's."

  ready

  return ""
}


# converts a list of things of the form "foo[3] bar[2:0] eee" into
# "foo(3) bar(2downto0) eee"

proc vhdlize {list} {

  set new ""
  foreach element $list {

    setl {msb lsb} [bus_range $element]

    if {$msb == ""} {
      lappend new $element
      continue
    }

    set root [bus_root $element]

    if {$msb == $lsb} {
      lappend new "${root}($msb)"

    } elseif {$msb > $lsb} {
      lappend new "${root}(${msb}downto$lsb)"

    } else {
      lappend new "${root}(${msb}to$lsb)"
    }
  }
  
  return $new
}

# Specific routines for flat sim/spice netlisting

# M=N is expanded to N calls.

proc flat_spice_netlist {schem dir} {

  global cur_c cur_s NETLIST GLOBALS DEFAULT_SPICE_HEADER SUFFIX
  global NETLIST_MAX_NAME_LENGTH SEPARATOR UNCONNS VERSION TOPCELL
  global FLAT_SPICE_SUBCKT SCHEMS TERM_LIST

  # spice only allows a maximum name length of 13 characters
#  set NETLIST_MAX_NAME_LENGTH 13

  # spice doesn't like the separator to be a .
  set SEPARATOR %

  set schematic_name [get_rootname $schem]

  # spice header stuff
  spice_line_to_file "* FILE: $schematic_name$SUFFIX(flat_spice)\n"
  flush $NETLIST(file_id)

  if {[use_first NETLIST(no_header)] != "" && $NETLIST(no_header)} {
    # don't put in a header

  } elseif {[file isfile $dir$schematic_name$SUFFIX(spice_header)]} {
    # header file exists so just include it
    puts "Including spice header file \"$dir$schematic_name$SUFFIX(spice_header)\"."
    spice_line_to_file ".INCLUDE \'$schematic_name$SUFFIX(spice_header)\'"

  } else {
    # load in the standard header if one exists
    puts "No header file \"$dir$schematic_name$SUFFIX(spice_header)\", including \"$DEFAULT_SPICE_HEADER\" (DEFAULT_SPICE_HEADER) instead."
    catch "exec cat $DEFAULT_SPICE_HEADER >@$NETLIST(file_id)"
  }

  spice_line_to_file "\n* SPICE netlist for \"$schematic_name\" (generated by $VERSION)\n"

  catch {unset UNCONNS}

  trace_hierarchy $schematic_name top

  # trace hierarchy may have changed the current schematic, so set it back
  goto_schematic $schem
  update

  set TOPCELL $schem

  if {[use_first FLAT_SPICE_SUBCKT] == 1} {
    # don't comment out subckt and .ends statement
    set prefix ""
  } else {
    # comment out subckt and .ends statement
    set prefix "*"
  }

  # needed here for create_spice_subckt_opener
  if {![info exists SCHEMS($cur_s,terms)]} {
    set SCHEMS($cur_s,terms) generated

    # insure that generate_term_names is run
    upvar #0 TERMS_$cur_s TERMS
    catch {unset TERMS}

    # does all the hard work of generating all the term/net names
    generate_term_names flat

    check_interrupt

    # now we have to save the info since TERM_LIST will get overwritten
    foreach id [$cur_c find withtag origin] {
      set SCHEMS($cur_s,$id) [use_first TERM_LIST($id)]
    }
  }

  # spice subcircuit opener
  create_spice_subckt_opener $prefix

  flat_spice_netlist_cell $cur_s

  # spice subcircuit end line
  spice_line_to_file "$prefix.ENDS\t\$ $cur_s\n" $cur_s

  # spice netlist end line
  if {[use_first NETLIST(no_header)] != "" && $NETLIST(no_header)} {
    # no .END

  } else {

    if {[file isfile $dir$schematic_name$SUFFIX(spice_footer)]} {
      # footer file exists so include it
      spice_line_to_file ".INCLUDE \'$schematic_name$SUFFIX(spice_footer)\'\n"
    }

    spice_line_to_file ".END\n"
  }
}


# Creates a sim format netlist

proc sim_netlist {schem dir} {

  global cur_c cur_s NETLIST GLOBALS SUFFIX
  global NETLIST_MAX_NAME_LENGTH SEPARATOR SIM_HEADER UNCONNS TOPCELL

#  set NETLIST_MAX_NAME_LENGTH 4096
  set SEPARATOR .

  set schematic_name [get_rootname $schem]

  # sim header stuff
#  spice_line_to_file ";FILE: $schematic_name$SUFFIX(sim)"
  spice_line_to_file $SIM_HEADER

  catch {unset UNCONNS}

  trace_hierarchy $schematic_name top

  # trace hierarchy may have changed the current schematic, so set it back
  goto_schematic $schem
  update

  set TOPCELL $schem

  flat_spice_netlist_cell $cur_s
}


# adds attribute lines for all ios in the top level cell

proc add_sim_io_attributes {} {

  global cur_c cur_s
  upvar #0 TERMS_$cur_s TERMS

  # gather up all of the I/O's connected to this top level cell
  set ios [concat [$cur_c find withtag icon_input] \
	       [$cur_c find withtag icon_output] \
	       [$cur_c find withtag icon_inout]]

  set define_list ""
  foreach id $ios {
    # first get the term id out of the icon
    set term_id [get_intersect_tag inst$id term] 
    if {![info exists names($TERMS($term_id))]} {
      lappend define_list "$TERMS($term_id,type) $TERMS($term_id)"
      set names($TERMS($term_id)) 1
    }
  }

  foreach pair [lsort $define_list] {
    setl {type term} $pair

    foreach bit [bus_expand $term] {
      if {[info exists trace($bit)]} {
	# already got this one
	continue
      }
      set trace($bit) 1

      spice_line_to_file "A $bit $type" $cur_s
    }
  }
}


# netlists an entire cell, i.e. creates a subckt.

proc flat_spice_netlist_cell \
    {schematic {prefix ""} {hier_terms ""} {prop_list ""} {hier_M 1}} {

  global cur_c cur_s scale TERM_LIST GLOBALS SCHEMS NETLIST_TYPE TOPCELL
  global SUE_$schematic

  set M [get_assoc M $prop_list]
  if {$M != "" && ([catch {expr int($M)} msg] || $msg != $M)} {
    sue_error "NETLIST ERROR: Multiplier on instance $schematic in schematic $cur_s of $M is not an integer.  Can't flat netlist it."
    set prop_list [put_assoc 1 M $prop_list]
  }

  set cur_c [set SUE_${schematic}(canvas)]
  set cur_s $schematic
  set scale [set SUE_${schematic}(scale)]

  if {![info exists SCHEMS($cur_s,terms)]} {
    set SCHEMS($cur_s,terms) generated

    # insure that generate_term_names is run
    upvar #0 TERMS_$cur_s TERMS
    catch {unset TERMS}

    # does all the hard work of generating all the term/net names
    generate_term_names flat

    check_interrupt

    # now we have to save the info since TERM_LIST will get overwritten
    foreach id [$cur_c find withtag origin] {
      set SCHEMS($cur_s,$id) [use_first TERM_LIST($id)]
    }
  }

  if {$NETLIST_TYPE == "sim" && $TOPCELL == $schematic} {
    add_sim_io_attributes
  }

  # walk through all instances and create a spice line for them
  foreach id [$cur_c find withtag origin] {
    # need to know if the name makes this a bused instance
    upvar #0 ${cur_s}_inst${id} i_data
    
    if {[lsearch "input output input global name_net name_net_s name_net_sw" $i_data(type)] != -1} {
      # ignore these
      continue
    }

    set inst_name [use_first i_data(_name)]

    # save the current canvas, schematic, and scale
    set save_cur_c $cur_c
    set save_cur_s $cur_s
    set save_scale $scale

    if {[set inst_width [bus_width $inst_name]] > 1} {

      # must duplicate this gate based on inst_name
      # buses will be enumerated into terminals until they run out
      set bus_term_names ""

      foreach term $SCHEMS($cur_s,$id) {
	setl {term_name net_name} $term
	spice_array_bus $term_name $net_name $inst_width $id
	set bus_term_names [concat $bus_term_names [bus_expand $term_name]]
      }

      # now make all the separate inst calls
      foreach inst [bus_expand $inst_name] {
	set terms ""
	foreach term $bus_term_names {
	  set term_name [lindex $term 0]
	  lappend terms [translate_term $term_name \
			     [lindex $bus_terms($term_name) 0] $prefix]

	  if {[llength $bus_terms($term_name)] > 1} {
	    set bus_terms($term_name) [lrange $bus_terms($term_name) 1 end]
	  }
	}

#puts "XX $schematic $i_data(type) $terms"
	create_flat_spice_line $id $prefix $terms $prop_list $hier_M

	# restore the current canvas, schematic, and scale
	set cur_c $save_cur_c
	set cur_s $save_cur_s
	set scale $save_scale
      }

    } else {
      # not a bused instance
      # push terminal names from cell above into this cell
      set terms ""
      foreach term [expand_term_list $SCHEMS($cur_s,$id)] {
	lappend terms [translate_term [lindex $term 0] [lindex $term 1] $prefix]
      }

# puts "$schematic $i_data(type) $terms"
      create_flat_spice_line $id $prefix $terms $prop_list $hier_M

      # restore the current canvas, schematic, and scale
      set cur_c $save_cur_c
      set cur_s $save_cur_s
      set scale $save_scale
    }
  }

  # add any spice text lines (text beginning with ^ in schematics)
  if {$NETLIST_TYPE != "sim"} {
    foreach id [$cur_c find withtag draw_item&scaletext] {
      set text [$cur_c itemcget $id -text]
      if {[string index $text 0] == "^"} {
	spice_line_to_file [string range $text 1 end] $cur_s
      }
    }
  }
}


proc translate_term {name hier_name prefix} {

  global GLOBALS
  # this is how you do dynamic (?) scoping
  upvar 1 hier_terms hier_terms

  if {[info exists GLOBALS([string tolower $hier_name])]} {
    return "$name $hier_name"
  }
  set value [get_assoc $hier_name $hier_terms]
  if {$value != ""} {
    return "$name $value"
  } else {
    return "$name [unique_net $prefix $hier_name]"
  }
}


# Writes a spice subckt call
# Note this procedure defines random variables!!!

proc create_flat_spice_line {id prefix term_list {prop_list ""} {hier_M 1}} {

  global cur_c cur_s SUE NETLIST NETLIST_PROPS NETLIST_TYPE UNCONNS
  upvar #0 TERMS_$cur_s TERMS

  if {$NETLIST_TYPE == "sim"} {
    # pat added: determine x,y coords of this icon in current schematic.
    global scale
    set scalefactor [expr 10.0 / $scale]
    setl {coordx coordy} [$cur_c coords $id]
    set coordx [expr round($scalefactor * $coordx)]
    set coordy [expr round($scalefactor * $coordy)]
  }

  upvar #0 ${cur_s}_inst${id} i_data
  # the type is the really the instance name
  set type $i_data(type)
  upvar #0 icon_$type g_data

  # don't allow recursion.  Useful for placing a cell's icon in its schematic
  # for documentation purposes.
  if {$type == $cur_s} {
    return
  }

  if {[info exists g_data(missing_icon)]} {
    # this is a bad icon, make into an error so this won't get cached.
    sue_error "NETLIST ERROR: skipping missing icon \"$type\" in $cur_s" $cur_s
    return
  }

  # if warnings are on, then print out a warning for unconnected nets
  if {$NETLIST(warning) && [string first " uc_" $term_list] != -1} {
    foreach pair $term_list {
      setl {term term_name} $pair

      if {[string range $term_name 0 2] == "uc_" && \
          [regexp "$term \[^u\]\[^c\]\[^_\]" ${term_list}x] == 0} {

	if {[info exists UNCONNS($term_name)]} {
	  continue
	}
	set UNCONNS($term_name) 1

	if {[lsearch $NETLIST(ignore_unconnected) $term] != -1} {
	  # user asked not to see these
	  continue
	}

	if {[info exists WARNINGS($cur_s,$id,$term)]} {
	  continue
	}
	set WARNINGS($cur_s,$id,$term) 1

	sue_warning "NETLIST WARNING: Unconnected net on terminal \"$term\" in icon $type \"[use_first i_data(_name)]\" ($id) in schematic \"$cur_s\"."
      }
    }
  }

  if {$NETLIST(warning) && [string first "uc_" $term_list] != -1} {
    # see if we've reported this one before
    foreach pair $term_list {
      if {[lsearch $pair "*uc_*"] == 1 &&
	  ![info exists UNCONNS([lindex $pair 1])]} {
	sue_warning "NETLIST WARNING: Unconnected net on terminal \"[lindex $pair 0]\" of ICON \"$type\" ([use_first i_data(_name) id]) in cell \"$cur_s\"."
	set UNCONNS([lindex $pair 1]) 1
      }
    }
  }

  # if this icon has a spice property, use it.
  #set spice [eval use_first g_data(_[join $NETLIST_PROPS "\) g_data\(_"])]
  # This next line is what it used to do
  #set spice [use_first g_data(_spice)]
  # This procedure will also look up in the NETLIST_LEVEL array.
  set spice [get_property_info $type $NETLIST_PROPS]

  if {$spice != ""} {
    # spice or sim inline

    # get rid of continuation lines.  We will reformat and put them back
    # in if needed below.
    regsub -all \n\\+ $spice " " spice

    # define a prop name to be a variable with value of property.
    foreach prop_name $g_data(prop_names) {
      set prop_exp $i_data(_$prop_name)

# What was this for???
#      foreach prop $prop_list {
#	regsub -all [lindex $prop 0] $prop_exp [lindex $prop 1] prop_exp
#      }

      set tmp [get_assoc $prop_exp $prop_list]
      if {$tmp != ""} {
	set prop_exp $tmp
      }

      # evaluate numerical expressions if possible (might be quoted)
      regsub -all ' $prop_exp "" unquoted_prop_exp
      if {[catch "expr $unquoted_prop_exp" value] != 0} {
	# must be a name or something
	set value $prop_exp
      }
      set $prop_name $value
    }

    if {![info exists M] || $M == ""} {
      set MP $hier_M
    } else {
      if {[catch {expr int($M)} msg] || $msg != $M} {
	sue_error "NETLIST ERROR: Multiplier on instance $i_data(type) \#$id in schematic $cur_s of $M is not an integer.   Can't flat netlist it."
	set M 1
      }
      set MP [expr $M * $hier_M]
    }

    set inst_name [use_first i_data(_name)]

    # define term to be a variable with value of net name.
    foreach term $term_list {
      set [lindex $term 0] [lindex $term 1]
    }

    # make the spice line and then write it
    set inst_name ""
    foreach line [split $spice \n] {
      if {[catch [list eval concat $line] spice_lines] != 0} {
	# error in inline line
	sue_error "NETLIST ERROR: bad syntax netlisting \"$type\" with \"$line\" in cell \"$cur_s\"" $cur_s
	puts $spice_lines
	return
      }

      foreach spice_line [split $spice_lines \n] {

	# if this is a spice comment line, just write it out and move on
	if {[string index $spice_line 0] == "*"} {
	  spice_line_to_file $spice_line
	  continue
	}

	set this_name [lindex $spice_line 0]
	set first [string index $this_name 0]
	if {$inst_name == "" && $first != "."} {
	  # this is the name we are going to attach to the sue icon
	  set inst_name $this_name
	}

	if {$first == "."} {
	  # special spice directive, don't change name
	  set full_name $this_name
	} else {
	  if {$NETLIST_TYPE != "sim"} {
	    set full_name [unique_name [string index $this_name 0] \
			       "$prefix[string range $inst_name 1 end]"]
	  } else {
	    # pat: Generate a nice hierachical name for pats .sim comment.
	    set full_name [unique_name $prefix [bus_root [use_first name]] $type]
	  }
	}

	# sim files are weird cause objects (e.g. pfets, nfets) don't have names
	if {$NETLIST_TYPE == "sim"} {
	  if {$MP == 1} {
	    spice_line_to_file "| device $full_name $coordx $coordy"
	    spice_line_to_file $spice_line
	  } else {
	    for {set multiple 1} {$multiple <= $MP} {incr multiple} {
	      spice_line_to_file \
		  "| device $full_name.$multiple $coordx $coordy"
	      spice_line_to_file $spice_line
	    }
	  }
	} else {
	  if {$MP == 1} {
	    spice_line_to_file "$full_name [lrange $spice_line 1 end]"
	  } else {
	    for {set multiple 1} {$multiple <= $MP} {incr multiple} {
	      set m_name [unique_name [string index $full_name 0] \
			      [string range $full_name 1 end]]
	      spice_line_to_file "$m_name [lrange $spice_line 1 end]"
	    }
	  }
	}
      }
    }

    # save the name of this instance for probing
    set TERMS($id) $inst_name
    return
  }

  # if this icon has a schematic, recurse with properties
  if {[info exists SUE($type)] || [info commands SCHEMATIC_$type] != ""} {
    set inst_name [use_first i_data(_name)]

    # put together the list of passed properties with values
    # ignore name and any property name with a null property
    set pass_prop_list ""
    foreach prop_name $g_data(prop_names) {
      if {$prop_name == "name"} {
	continue
      }
      if {$i_data(_$prop_name) != ""} {
	set prop_exp $i_data(_$prop_name)
	foreach prop $prop_list {
	  regsub -all [lindex $prop 0] $prop_exp [lindex $prop 1] prop_exp
	}
	# evaluate numerical expressions if possible (might be quoted)
	regsub -all ' $prop_exp "" unquoted_prop_exp
	if {[catch "expr $unquoted_prop_exp" value] != 0} {
	  # must be a name or something
	  set value $prop_exp
	}
	lappend pass_prop_list "$prop_name $value"
      }
    }

    set value [get_assoc M $pass_prop_list]

    if {$value != ""} {
      if {[catch {expr int($value)} msg] || $msg != $value} {
	sue_error "NETLIST ERROR: Multiplier on instance $i_data(type) \#$id in schematic $cur_s of $value is not an integer.   Can't flat netlist it."
      } else {
	set hier_M [expr $value * $hier_M]
      }
    }

    # write the inst call
    set name [unique_name $prefix [bus_root $inst_name] $type]

    # pat: add hierarchical comments to sim format.
    if {$NETLIST_TYPE == "sim"} {
      spice_line_to_file "| begin $name $coordx $coordy"
    }

    flat_spice_netlist_cell $type "$name." $term_list $pass_prop_list $hier_M

    # pat: add hierarchical comments to sim format.
    if {$NETLIST_TYPE == "sim"} {
      spice_line_to_file "| end $name"
    }
    
    # save the name of this instance for probing
    set TERMS($id) $name

    return
  }
  # otherwise, must be a primitive, like a global or I/O, that doesn't
  # netlist explicitly.
}


proc unique_net {prefix name} {

  global SEPARATOR NAMES NETLIST_MAX_NAME_LENGTH

  # spice doesn't allow "." in the net names
  regsub -all {\.} $prefix$name $SEPARATOR new_name

  # if a spice net starts with a numeric then later alpha characters are
  # ignored.  A serious bug in spice.
  if {[regexp {[0-9]} [string index $new_name 0]] == 1} {
    set new_name Z$new_name
  }

  if {[string length $new_name] <= $NETLIST_MAX_NAME_LENGTH} {
    return $new_name
  }

  # have we been here before
  if {[info exists NAMES($new_name)]} {
    return $NAMES($new_name)
  }

  # Name too long or already used.  Generated new one.  Forget the prefix
  set short_name "n[incr NAMES(_unique)]_$name"

  # Even this name could be too long.
  if {[string length $short_name] > $NETLIST_MAX_NAME_LENGTH} {
    set short_name "n[incr NAMES(_unique)]"
  }

  # Remember this name
  set NAMES($new_name) $short_name

  return $short_name
}


proc expand_term_list {term_list} {

  global cur_s

  # first expand busses
  set terms ""
  foreach term $term_list {
    set term_names [bus_expand [lindex $term 0]]
    # special case for flags
    if {$term_names == "flag"} {
      continue
    }

    set bus_names [cbus_expand [lindex $term 1]]

    set len [llength $term_names]
    set blen [llength $bus_names]

    if {$blen == 1} {
      # special case of a bit
      for {set i 0} {$i < $len} {incr i} {
	lappend terms "[lindex $term_names $i] $bus_names"
      }

    } elseif {$len != $blen} {
      sue_error "NETLIST ERROR: terminal number and io number don't match in cell \"$cur_s\":" $cur_s
      sue_error "\t$term_names <> $bus_names" $cur_s
      return ERROR

    } else {
      for {set i 0} {$i < $len} {incr i} {
	lappend terms "[lindex $term_names $i] [lindex $bus_names $i]"
      }
    }
  }

  return $terms
}


# Used in icons to compute the scaled nfet and pfet widths and lengths
# Also translates spice-type syntax like '2*ln_min' into a number

proc sim_size {string {scale 1}} {

  global SIM_SCALE SIM_PARAMS

  # add a $ before known variables and define
set before $string
  foreach var [array names SIM_PARAMS] {
    regsub -all "$var\$" $string $SIM_PARAMS($var) string
    regsub -all "$var\(\[\$+/*'`\" \n\t-\])" $string "$SIM_PARAMS($var)\\1" string
  }

  # remove single quotes
  regsub -all ' $string "" string
  regsub -all {`} $string "" string

  # simple stupid way to solve um problem for now
  regsub -all {([0-9.])(u)([m]?)} $string {\1e-6} string
  regsub -all {([0-9.])(n)([m]?)} $string {\1e-9} string
  eval set value [expr round($SIM_SCALE * $scale * ( $string ))]
 
  return $value
}



# This is the top level include file to get the "main" config
# for MMI products.  Include this file in your makefile
# to compile MMI products.
#
# ------------------------------------------------------------------------
#       Using this file
#
# This file is included from a makefile to set up the compile environment
# for mmi tools.
#
# You should include it in your makefile like this:
# -include $(MMI_UTILS)/config/main.config
#
# Note: You must gmake, not ccs make, to use this include file!!!
#
# ------------------------------------------------------------------------
#       Configuration
#
# Please do NOT proliferate config files.  They are hard to maintain.
#
# Required inputs: variable MMI_UTILS is the home directory for
# utilities source code, must point to the directory that this
# config directory lives in.  It should be:
# at juniper:    /volume/mmi/utils
# at micromagic: /mmi-cad/utils
#
# The purpose of this file is to define the following variables, then
# call the common include file.  If you want a special configuration,
# define these variables yourself, then include the common include file.
#
# TARGET - controls which set of libraries are used in the makefile.
# TARGET_OS - base name of OS, either LINUX or SOLARIS
# TARGET2 - name of target directory used in release;
#           currently one of: sparc-solaris2 or i486-linux
#           (added by pat 12/13/00)
# CONFIG - used for additional variations,
# 	eg, to have debug and non-debug versions.
# 	You can create multiple CONFIGs for the same TARGET, if needed.
#
# This file: "main.config" file is for a normal configuration.
# Additional configuration files should be named, eg, "debug.config",
# debug.i486-linux, debug.sparc-solaris2, etc, and can be distinguished
# by setting the CONFIG variable to, eg, sparc-solaris2-debug.
# ------------------------------------------------------------------------



_UNAME_TMP = $(shell uname)

# Note do not use the HOSTTYPE variable to get the machine type!
# HOSTTYPE is peculiar to the csh, so if the makefile was called
# from a sh, eg, for nested makesfiles, it didnt work.
ifeq "$(_UNAME_TMP)" "Linux"
    TARGET_OS := LINUX
    # This sets OS_VERSION to the major and minor operating system version,
    # by chopping off everything after the second period.
    # The versions we are interested in are:
    # OS_VERSION == 2.0   implies Linux version 5
    # OS_VERSION == 2.2  implies Linux version 6
    OS_VERSION := $(shell uname -r | sed 's/\([0-9]*\.[0-9]*\).*/\1/')
    TARGET := i486-linux$(OS_VERSION)
    TARGET2 := i486-linux

    # Special case for backward compatibility
    # We started out calling this target i486-linux, without a version
    # number tacked on, so we have kept it that way.  Yuck.
    ifeq "$(TARGET)" "i486-linux2.0"
	TARGET := i486-linux
    endif
else
ifeq "$(_UNAME_TMP)" "HP-UX"
    TARGET_OS := HPUX
    TARGET := hppa
    TARGET2 := hppa
else
ifeq "$(_UNAME_TMP)" "SunOS"
    TARGET_OS := SOLARIS
    TARGET := sparc-solaris2
    TARGET2 := sparc-solaris2
else
    ERROR unrecognized return value from uname system call
endif
endif
endif

# Default CONFIG is same name as TARGET
CONFIG := $(TARGET)

# ------------------------------------------------------------------------
#       MMI Utilities (shared compile time resources for MMI tools)
# ------------------------------------------------------------------------

-include $(MMI_UTILS)/config/main.common

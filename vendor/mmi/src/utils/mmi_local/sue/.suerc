  set SPEEDY_PATH [use_first env(SPEEDY_PATH) '/volume/mmi/build/speedy/bin.$arch]
  if {[info commands speedy_cmd] == ""} {
    # speedy not loaded, load it
    puts "Loading speedy shared object from $SPEEDY_PATH ... (override with unix environment variable SPEEDY_PATH)"
    if {[catch {load $SPEEDY_PATH/speedy_package.so} msg]} {
      puts $msg
      return
    }
  }

  # load speedy_procs.... first look in the place for release versions....
  set SPEEDY_TCL_PATH "$SPEEDY_PATH/../src"
  if {[catch "source $SPEEDY_TCL_PATH/speedy_procs.tcl" rv] != 0} {
    puts "source speedy_procs 1st try... $rv"
    
    # ... if not found, look in the place for source versions...
    set SPEEDY_TCL_PATH "$SPEEDY_PATH/src"
    if {[catch "source $SPEEDY_TCL_PATH/speedy_procs.tcl" rv] != 0} {
      puts "source speedy_procs 2nd try... $rv"
      # if not found, speedy won't run
      puts "ERROR: speedy_procs.tcl not found"
      return
    }
  }

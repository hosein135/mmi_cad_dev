#!/bin/csh -f

# Runs calibre remotely (called by drc_it.tcl.calibre)

##################################################################
##################################################################
#           SITE CUSTOMIZATION

# This is where the node locked license lives.
# set calibrehost=mmics6.micromagic.com
#set calibrehost=mmifs3.micromagic.com
# for the local host, use
set calibrehost = `uname -n`

# Set this variable to point to calibre drc deck
if ($3 == "mmi25") then
  set calibre_deck = $TECH_ROOT/mmi25/decks/tsmc25.calibre
else if ($3 == "g25") then
  set calibre_deck = $TECH_ROOT/mmi25/decks/tsmc25.calibre
else if ($3 == "mmi18") then
  set calibre_deck = $TECH_ROOT/mmi18/decks/tsmc18.calibre
else if ($3 == "mmi15") then
  set calibre_deck = $TECH_ROOT/mmi15/decks/tsmc15.calibre
else
  echo "Aborting, don't know what calibre deck to use with tech = $3."
  exit 1
endif

# NOTE: you must remove any lines in your calibre deck of that start with
#
#        LAYOUT PRIMARY
#        LAYOUT PATH
#        DRC RESULTS DATABASE
#        DRC SUMMARY REPORT
#        DRC CHECK TEXT ALL

# Set the variable "setup" to contain any setup required to run calibre
#set setup="source ~cad/cad_cshrc"
set setup="module add calibre"

##################################################################
##################################################################

if ($1 == "" || $1 == "-h" || $1 == "-help") then
  echo ""
  echo "Usage: drc <filename> [<cell>] [<tech>]"
  echo "" 
  echo "<filename> must include extension."
  echo "<cell> is top level cell if different from the filename minus extension"
  echo "<tech> is the max technology name"
  echo "To view results in max, use: drc_it view"
  echo ""
  exit
endif

if (! -e $1) then
  echo "Aborting, can't find file $1"
  exit 1
endif

date

set cellname = $2
if ($2 == "") then
  set cellname = `basename $1:r`
endif

set filename = $1:r

# Hack to get "" in the next file
set q = '"'

# create header file for this run.
echo "INCLUDE $calibre_deck\
LAYOUT PRIMARY $q$cellname$q\
LAYOUT PATH $q$1$q\
DRC RESULTS DATABASE $q$filename.drc_maskdb$q ASCII\
DRC SUMMARY REPORT $q$filename.drc_sum$q REPLACE" \
> $filename.calibre

# Remove the old drc results file
rm -f $cellname.drc_maskdb >& /dev/null

# now run calibre
set host = `uname -n`
# If already on host, do not use rsh
#if ( "$host" == "$calibrehost" ) then
#    $setup ; calibre -drc $filename.calibre >! $filename.calibre_log
#else
#    rsh $calibrehost "cd `pwd`; $setup ; calibre -drc $filename.calibre >! $filename.calibre_log"
    rsh $calibrehost "cd `pwd`; $setup ; calibre -drc -hier -nowait $filename.calibre >! $filename.calibre_log"
#endif

# get the error count
# looking for:
#   TOTAL DRC Results Generated:     0

grep "TOTAL Original Layer Geometries" $filename.drc_sum
grep "TOTAL DRC Results" $filename.drc_sum

date

exit

# prints out the pad label and pad coords for each pad in design

proc what_pads {} {

  foreach paint [split [eval db_search paint -any_cell -area [lay_bbox] pad] \n] {

    foreach label [split [eval db_search labels -area [lrange $paint 1 4]] \n] {
      if {[lindex $label 7] == ""} {
	puts "[lindex $label 6] [lrange $paint 1 4]"
	break
      }
    }
  }
}


proc screen_dump {printer} {
    global max_win
    set ori landscape
    set prop_list [list \
      [list "Print to printer" printer -entry] \
      [list "Orientation" ori -choice {landscape portrait}] \
      ]
    if {[prop_menu2 -title "Dump screen to printer" $prop_list] == 0} {return}
    set id [winfo id $max_win.layout]
    exec xwd -id $id | xpr -$ori -device ps | lpr -P $printer
}

# TODO: get the list of printers from /etc/printers.conf
menu_local_cmd "Screen print" "screen_dump fatbrain"


menu_local_cmd "flatten cells w/prefix" flatten_cells_prefix

proc flatten_cells_prefix {{delimiter \{FS\}}} -desc {
  flattens all selected cell instances (only one level of hierarchy), prefixing instances and labels (except globals).
} -doc {
  
  Prefixes all instances and labels by <cell_name><delimeter>
  where <delimiter> defaults to {FS}

  global labels do not get the prefix

  Ignores flylines
} {

  warning {This function still works, but has been superceded by flatten\
  in the max "Misc" menu - please try that and let me know if it works (pat).}

  # Temporary: flatten is not working with edit-in-place,
  # and since the code is frozen before the 12/00 release,
  # just print a message and quit.  Fix it later.
  # Check show_menu just in the remote chance that Lee is
  # calling flatten_cells while in edit-in-place and it works somehow?
  if { [lay_rootcell] != [lay_editcell]} {
    max_error "Aborting, Can not flatten while in edit-in-place. \
      First use Control-e to pop edit stack."
    return
  }

  # remove the selection of everything but instances on the toplevel
  set cells ""
  foreach cellinfo [split [sel_what cells] \n] {
    struct max_cell cell $cellinfo

    if {${cell.path} != ""} {
      puts "WARNING: ignoring cell ${cell.path}/${cell.id} (${cell.def}) -- not on top level."
    } else {
      lappend cells $cellinfo
    }
  }

  if {[llength $cells] == 0} {
    max_error "Aborting, No instances on the top level to flatten."
    return ""
  }

  # first delete all instances to be flattened
  foreach cellinfo $cells {
    struct max_cell cell $cellinfo

    # toast old instance
    sel_cell2 ${cell.id}
    :delete
  }

  # now go through each, flattening
  foreach cellinfo $cells {
    struct max_cell cell $cellinfo

    sel_clear
    :dump -instance_prefix ${cell.id}$delimiter \
	-label_prefix ${cell.id}$delimiter \
	${cell.def} parent ${cell.x1} ${cell.y1}

    # orient it
    set orient [orientation ${cell.transform}]
    switch $orient {
      "r90" {
	:clockwise
      }
      "r180" {
	:clockwise 180
      }
      "r270" {
	:clockwise 270
      }
      "fx" {
	:sideways
      }
      "fy" {
	:upsidedown
      }
      "fx_r90" {
	:sideways
	:clockwise
      }
      "fy_r90" {
	:upsidedown
	:clockwise
      }
    }

    # compute where to strip from
    set pos [string length ${cell.id}$delimiter]

    # now we have to fix up the global labels -- i.e. lose the prefix.
    foreach labelinfo [split [sel_what labels] \n] {
      struct max_label label $labelinfo

      if {${label.kind} == "global" && ${label.path} == ""} {
	# found a global, remove its prefix
	sel_labels -kind ${label.kind} \
	    -rect ${label.x1} ${label.y1} ${label.x2} ${label.y2} \
	    -text ${label.text} -pos ${label.pos} -layer ${label.layer}
	:delete

	# strip prefix
	set text [string range ${label.text} $pos end]

	puts "${label.text} --> $text"


	db_label -kind ${label.kind} -pos ${label.pos} \
	    ${label.layer} $text \
	    ${label.x1} ${label.y1} ${label.x2} ${label.y2}
      }
    }
  }

  return ""
}

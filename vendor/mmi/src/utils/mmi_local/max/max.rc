# only works on selected nets

proc invert_selection {} {

  foreach paint [split [sel_what paint] \n] {
    set array($paint) 1
  }

  sel_clear

  eval lay_box [lay_bbox]
  lay_internals -area
  :select area *
  set paints [split [sel_what paint] \n]

  sel_clear

  foreach paint $paints {
    if {![info exists array($paint)]} {
      sel_net -more -point [lindex $paint 1] [lindex $paint 2] [lindex $paint 0]
    }
  }
}
 
    
proc make_gds_all {{dir ""}} {

  if {$dir != ""} {
    cd $dir
  }

  foreach cell [lsort [glob *.max]] {

    cell_load_files $cell
    eval lay_box [lay_bbox]
    lay_internals -area
    update
    write_gds
  }
}


set SPACING(h) 28
set SPACING(v) 32
set SPACING(row_width) [expr $SPACING(h) * 10]

set SPACING(GRID) 1.4


proc make_composite_cell {{cell_name all} {convert ""}} -desc {
  creates a cell with all of the cells in the directory loaded and
placed in it.  Will also convert bbox labels to layers if desired.
} {

  global SPACING

  puts "Making cell \"$cell_name\" and filling with cells from [pwd] ..."

  # make the composite cell and go to it
  db_cell_new $cell_name
  :load $cell_name	

  set x 0
  set y 0
	
  foreach instance [lsort [glob *.max]] {

    set inst_name [file root $instance]

    # now place cell
    lay_box $x $y $x $y
    if {[msg_catch ":getcell $inst_name child 0 0"]} {
      # error
      puts "Warning, can't find cell \"$inst_name\"."
      continue
    }

    setl {name type x1 y1 x2 y2} [sel_what cells]

    # get size of cell
    :load $inst_name

    eval lay_box [lay_bbox]
    lay_internals -area
    setl {x1 y1 x2 y2} [lay_bbox]

    if {$convert != ""} {
      convert_bbox
    }

    :load $cell_name

    if {[expr $x2 - $x1 - 4] > $SPACING(h)} {
      # make double wide for big cells
      set x [expr $x + $SPACING(h)]
    }
    set x [expr $x + $SPACING(h)]

    if {$x >= $SPACING(row_width)} {
      set x 0
      set y [expr $y - $SPACING(v)]
    }
  }

  sel_clear

  # zoom to fit
  :view

  # expand all subcells
  eval lay_box [lay_bbox]
  lay_internals -area

  update

  puts "Writing stream file \"$cell_name.strm\" ..."
  :calma write $cell_name.strm

  puts "done."
}


proc convert_bbox {} -desc {
  converts bbox labels to layer
} {

  foreach layer "prb res fdrc xxx" {
    if {![catch "lay_layer_styles $layer"]} {
      # this is a good layer
      break
    }
  }

  if {$layer == "xxx"} {
    puts "Skipping convert_bbox, can't find a layer to convert to"
    return
  }

  sel_labels -text bbox
  set labels [sel_what labels]
  :delete

  foreach label [split $labels \n] {
    eval db_paint $layer [lrange $label 1 4]
  }
}


menu_local_cmd "cut box" cut

proc cut {{filename ""}} -desc {
  cut out visible paint in box and copy to new buffer
} {

  if {$filename == ""} {
    # ask user for a cell name

    setl {dir cell ext} [_cell_file_box "New File:"]

    # if nil, file selector box cancelled -- do nothing
    if {$cell == ""} { 
      return 
    }

  } else {
    # use the one given
    setl {dir cell ext} [split_file_name $filename]
  }

  if {$cell == [lay_rootcell]} {
    puts "Aborting, must choose different cell than current one."
    return
  }

  if {[cell_info $cell] != "__NO_SUCH_BUFFER__"} {
    # remove it
    db_cell_delete $cell
  }

  db_cell_new $cell $dir/$cell$ext

  eval sel_area -any_cell -layers [join [dbt_visible_layers] ,] [dbt_frame]

  # copy selection in here
  db_cell_copy -source __SELECT__ $cell

  :load $cell
}



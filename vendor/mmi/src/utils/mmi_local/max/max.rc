    # Give'm parasitics
    set MC(parasitics) 1
 
    # do it
    extract_spice
}



# For debugging

menu_local_cmd "time redisplay" time_redisplay

proc time_redisplay {{zoom_factor 0.5}} -desc {
  times the redisplay speed of the current cell and various magnifications
} {

  puts "Timing redisplay:"

  :zoom 0.00001
  update

  # zoom out
  :view
  set count 1

  while {1} {

    puts "$count: [pp_number [expr [lindex [time update] 0] / 1.0e6]]s"

    setl {x1 y1 x2 y2} [dbt_frame]
    if {$x2 < [expr $x1 + 1.0]} {
      # zoomed in enough
      break
    }

    :zoom $zoom_factor
    incr count
  }
}



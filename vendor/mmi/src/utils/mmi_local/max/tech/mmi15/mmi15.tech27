



























































































































































 






 








tech
	mmi15
end

version
	version "mmi15 15:21:46 Apr 25 2001"
	description "mmi15"
end

planes
	nw
	active
	od2
	n3v
	pplus
	nplus
	ct
	m1
	v12
	m2
	v23
	m3
	v34
	m4
	v45
	m5
	v56
	m6
	pad
	sd
	esd
	rpo
	prb
end

types
	nw	nw
	active	ndif
	active	pdif
	active	nwc
	active	pwc
	od2	od2
	active	poly
	n3v	n3v
	pplus	pplus
	nplus	nplus
	ct	ct
	m1	m1
	v12	v12
	m2	m2
	v23	v23
	m3	m3
	v34	v34
	m4	m4
	v45	v45
	m5	m5
	v56	v56
	m6	m6
	pad	pad
	sd	sd
	esd	esd
	rpo	rpo
	prb	prb
	active	nfet
	active	pfet
end

contact
end

styles
end

compose
	compose nfet poly ndif
	compose pfet poly pdif
end

connect
	nwc	pdif
	pwc	ndif
	nfet	poly
	pfet	poly
	ct	ndif,pdif,nwc,pwc,poly,m1
	v12	m1,m2
	v23	m2,m3
	v34	m3,m4
	v45	m4,m5
	v56	m5,m6
end

cifoutput
style mmi15

	units .001 .001 .001 .001
	charset unrestricted

	iname propattr 102
	bbox 62 0

	layer GDS_nw pdif,pfet
		grow .12
		or nwc
		grow 0.24
		or nw
		grow 0.36
		shrink 0.36
	polygons nw
	labels nw
	calma 3 0

	layer GDS_od ndif,nfet,pdif,pfet,nwc,pwc
	polygons ndif,nfet,pdif,pfet,nwc,pwc
	labels ndif,nfet,pdif,pfet,nwc,pwc
	calma 6 0

	layer GDS_odp pdif,pfet,pwc
	polygons pdif,pfet,pwc
	labels pdif,pfet,pwc
	calma 7 0

	layer GDS_odn ndif,nfet,nwc
	polygons ndif,nfet,nwc
	labels ndif,nfet,nwc
	calma 8 0

	layer GDS_od2 od2
	polygons od2
	labels od2
	calma 15 0

	layer GDS_poly poly,nfet,pfet
	polygons poly,nfet,pfet
	labels poly,nfet,pfet
	calma 17 0

	layer GDS_n3v n3v
	polygons n3v
	labels n3v
	calma 21 0

	templayer ppoly GDS_nw
		grow 0.2
		and poly,nfet,pfet
		grow 0.2
	templayer npoly poly,nfet,pfet
		grow 0.2
		and-not ppoly
	layer GDS_nplus nfet
		grow 0.15
		or ndif,nfet
		grow 0.16
		or nwc
		grow 0.04
		and-not pdif,pfet
		or npoly
		and-not pplus
		or nplus
		shrink 0.16
		grow 0.32
		shrink 0.16
	polygons nplus
	labels nplus
	calma 26 0

	layer GDS_pplus pfet
		grow 0.15
		or pdif,pfet
		grow 0.16
		or pwc
		grow 0.04
		or ppoly
		and-not ndif,nfet
		and-not GDS_nplus
		or pplus
		shrink 0.16
		grow 0.32
		shrink 0.16
	polygons pplus
	labels pplus
	calma 25 0

	layer GDS_ct ct
	polygons ct
	labels ct
	calma 30 0

	layer GDS_m1 m1
	polygons m1
	calma 31 0

	layer TXT_m1
	labels m1
	calma 131 0

	layer GDS_v12 v12
	polygons v12
	labels v12
	calma 51 0

	layer GDS_m2 m2
	polygons m2
	calma 32 0

	layer TXT_m2
	labels m2
	calma 132 0

	layer GDS_v23 v23
	polygons v23
	labels v23
	calma 52 0

	layer GDS_m3 m3
	polygons m3
	calma 33 0

	layer TXT_m3
	labels m3
	calma 133 0

	layer GDS_v34 v34
	polygons v34
	labels v34
	calma 53 0

	layer GDS_m4 m4
	polygons m4
	calma 34 0

	layer TXT_m4
	labels m4
	calma 134 0

	layer GDS_v45 v45
	polygons v45
	labels v45
	calma 54 0

	layer GDS_m5 m5
	polygons m5
	calma 35 0

	layer TXT_m5
	labels m5
	calma 135 0

	layer GDS_v56 v56
	polygons v56
	labels v56
	calma 55 0

	layer GDS_m6 m6
	polygons m6
	calma 36 0

	layer TXT_m6
	labels m6
	calma 136 0

	layer GDS_pad pad
	polygons pad
	labels pad
	calma 43 0

	layer GDS_sd sd
	polygons sd
	labels sd
	calma 58 0

	layer GDS_esd esd
	polygons esd
	labels esd
	calma 27 0

	layer GDS_rpo rpo
	polygons rpo
	labels rpo
	calma 29 0

	layer GDS_prb prb
	polygons prb
	labels prb
	calma 68 0

	templayer m5_v45_sx m5
		shrinkx 0.04
	templayer m1_ct_sx m1
		shrinkx 0.045
	templayer DRC_pfet pfet
	templayer all_diff ndif,nfet,pdif,pfet,nwc,pwc
	templayer m4_v45_sx m4
		shrinkx 0.04
	templayer DRC_ndif ndif,nfet
	templayer m4_v34_sx m4
		shrinkx 0.04
	templayer m1_ct_check m1
		shrinky 0.045
		or m1_ct_sx
		shrink 0.005
		and ct
	templayer tmp1 nfet,pfet
		grow 0.085
	templayer poly_not_fet poly,nfet,pfet
		and-not tmp1
	templayer DRC_pwc pwc
	templayer DRC_nfet nfet
	templayer m3_v34_sx m3
		shrinkx 0.04
	templayer m5_v56_sx m5
		shrinkx 0.04
	templayer m5_v56_check m5
		shrinky 0.04
		or m5_v56_sx
		shrink 0.01
		and v56
	templayer ct_poly ct
		and poly,nfet,pfet
	templayer m3_v23_sx m3
		shrinkx 0.04
	templayer m4_v45_check m4
		shrinky 0.04
		or m4_v45_sx
		shrink 0.01
		and v45
	templayer m3_v34_check m3
		shrinky 0.04
		or m3_v34_sx
		shrink 0.01
		and v34
	templayer m2_v23_sx m2
		shrinkx 0.04
	templayer all_poly_dif ndif,nfet,pdif,pfet,nwc,pwc,poly,nfet,pfet
	templayer m2_v23_check m2
		shrinky 0.04
		or m2_v23_sx
		shrink 0.01
		and v23
	templayer m6_v56_sx m6
		shrinkx 0.08
	templayer m6_v56_check m6
		shrinky 0.08
		or m6_v56_sx
		shrink 0.01
		and v56
	templayer m2_v12_sx m2
		shrinkx 0.04
	templayer m1_v12_sx m1
		shrinkx 0.04
	templayer m1_v12_check m1
		shrinky 0.04
		or m1_v12_sx
		shrink 0.01
		and v12
	templayer m5_v45_check m5
		shrinky 0.04
		or m5_v45_sx
		shrink 0.01
		and v45
	templayer DRC_nwc nwc
	templayer ct_pdif ct
		and pdif,pfet,pwc
	templayer m4_v34_check m4
		shrinky 0.04
		or m4_v34_sx
		shrink 0.01
		and v34
	templayer m3_v23_check m3
		shrinky 0.04
		or m3_v23_sx
		shrink 0.01
		and v23
	templayer DRC_pdif pdif,pfet
	templayer m2_v12_check m2
		shrinky 0.04
		or m2_v12_sx
		shrink 0.01
		and v12
	templayer DRC_ct ct
	templayer ct_ndif ct
		and ndif,nfet,nwc

	layer TXT_text
	labels space
	calma 255 0
end

cifinput
style	mmi15
	iname propattr 102
	bbox 62 0

	layer nw GDS_nw
	labels GDS_nw

	layer ndif GDS_od
		and-not GDS_pplus
		or GDS_odn
		and-not GDS_nw
	labels GDS_ndif

	layer pdif GDS_od
		and GDS_pplus
		or GDS_odp
		and GDS_nw
	labels GDS_pdif

	layer nwc GDS_od
		and-not GDS_pplus
		or GDS_odn
		and GDS_nw
	labels TXT_nwc

	layer pwc GDS_od
		and GDS_pplus
		or GDS_odp
		and-not GDS_nw
	labels TXT_pwc

	layer od2 GDS_od2
	labels GDS_od2

	layer poly GDS_poly
	labels GDS_poly

	layer n3v GDS_n3v
	labels GDS_n3v

	layer pplus GDS_pplus
	labels GDS_pplus

	layer nplus GDS_nplus
	labels GDS_nplus

	layer ct GDS_ct
	labels GDS_ct

	layer m1 GDS_m1
	labels TXT_m1

	layer v12 GDS_v12
	labels GDS_v12

	layer m2 GDS_m2
	labels TXT_m2

	layer v23 GDS_v23
	labels GDS_v23

	layer m3 GDS_m3
	labels TXT_m3

	layer v34 GDS_v34
	labels GDS_v34

	layer m4 GDS_m4
	labels TXT_m4

	layer v45 GDS_v45
	labels GDS_v45

	layer m5 GDS_m5
	labels TXT_m5

	layer v56 GDS_v56
	labels GDS_v56

	layer m6 GDS_m6
	labels TXT_m6

	layer pad GDS_pad
	labels GDS_pad

	layer sd GDS_sd
	labels GDS_sd

	layer esd GDS_esd
	labels GDS_esd

	layer rpo GDS_rpo
	labels GDS_rpo

	layer prb GDS_prb
	labels GDS_prb

	calma GDS_nw	3 *
	calma GDS_od	6 *
	calma GDS_odp	7 *
	calma GDS_odn	8 *
	calma GDS_od2	15 *
	calma GDS_poly	17 *
	calma GDS_n3v	21 *
	calma GDS_pplus	25 *
	calma GDS_nplus	26 *
	calma GDS_ct	30 *
	calma GDS_m1	31 *
	calma TXT_m1	131 *
	calma GDS_v12	51 *
	calma GDS_m2	32 *
	calma TXT_m2	132 *
	calma GDS_v23	52 *
	calma GDS_m3	33 *
	calma TXT_m3	133 *
	calma GDS_v34	53 *
	calma GDS_m4	34 *
	calma TXT_m4	134 *
	calma GDS_v45	54 *
	calma GDS_m5	35 *
	calma TXT_m5	135 *
	calma GDS_v56	55 *
	calma GDS_m6	36 *
	calma TXT_m6	136 *
	calma GDS_pad	43 *
	calma GDS_sd	58 *
	calma GDS_esd	27 *
	calma GDS_rpo	29 *
	calma GDS_prb	68 *
	layer space
	labels TXT_text
	calma TXT_text 255 *
end

mzrouter
end

drc
cifstyle mmi15

	cifwidth GDS_nw 0.73 		"nw minimum width = 0.73 um."

	cifspacing GDS_nw GDS_nw 0.73 touching_ok 		"nw minimum spacing = 0.73 um."

	width ndif,nfet 0.18 		"ndif minimum width = 0.18 um."

	spacing ndif,nfet ndif,nfet 0.24 touching_ok 		"ndif minimum spacing = 0.24 um."

	width pdif,pfet 0.18 		"pdif minimum width = 0.18 um."

	spacing pdif,pfet pdif,pfet 0.24 touching_ok 		"pdif minimum spacing = 0.24 um."

	width nwc 0.18 		"nwc minimum width = 0.18 um."

	spacing nwc nwc 0.24 touching_ok 		"nwc minimum spacing = 0.24 um."

	width pwc 0.18 		"pwc minimum width = 0.18 um."

	spacing pwc pwc 0.24 touching_ok 		"pwc minimum spacing = 0.24 um."

	width poly,nfet,pfet 0.15 		"poly minimum width = 0.15 um."

	spacing poly,nfet,pfet poly,nfet,pfet 0.22 touching_ok 		"poly minimum spacing = 0.22 um."

	cifwidth GDS_pplus 0.38 		"pplus minimum width = 0.38 um."

	cifspacing GDS_pplus GDS_pplus 0.38 touching_ok 		"pplus minimum spacing = 0.38 um."

	cifwidth GDS_nplus 0.38 		"nplus minimum width = 0.38 um."

	cifspacing GDS_nplus GDS_nplus 0.38 touching_ok 		"nplus minimum spacing = 0.38 um."

	width ct 0.18 		"ct minimum width = 0.18 um."

	spacing ct ct 0.21 touching_ok 		"ct minimum spacing = 0.21 um."

	width m1 0.19 		"m1 minimum width = 0.19 um."

	spacing m1 m1 0.2 touching_ok 		"m1 minimum spacing = 0.2 um."

	width v12 0.22 		"v12 minimum width = 0.22 um."

	spacing v12 v12 0.22 touching_ok 		"v12 minimum spacing = 0.22 um."

	width m2 0.24 		"m2 minimum width = 0.24 um."

	spacing m2 m2 0.24 touching_ok 		"m2 minimum spacing = 0.24 um."

	width v23 0.22 		"v23 minimum width = 0.22 um."

	spacing v23 v23 0.22 touching_ok 		"v23 minimum spacing = 0.22 um."

	width m3 0.24 		"m3 minimum width = 0.24 um."

	spacing m3 m3 0.24 touching_ok 		"m3 minimum spacing = 0.24 um."

	width v34 0.22 		"v34 minimum width = 0.22 um."

	spacing v34 v34 0.22 touching_ok 		"v34 minimum spacing = 0.22 um."

	width m4 0.24 		"m4 minimum width = 0.24 um."

	spacing m4 m4 0.24 touching_ok 		"m4 minimum spacing = 0.24 um."

	width v45 0.22 		"v45 minimum width = 0.22 um."

	spacing v45 v45 0.22 touching_ok 		"v45 minimum spacing = 0.22 um."

	width m5 0.24 		"m5 minimum width = 0.24 um."

	spacing m5 m5 0.24 touching_ok 		"m5 minimum spacing = 0.24 um."

	width v56 0.36 		"v56 minimum width = 0.36 um."

	spacing v56 v56 0.35 touching_ok 		"v56 minimum spacing = 0.35 um."

	width m6 0.44 		"m6 minimum width = 0.44 um."

	spacing m6 m6 0.46 touching_ok 		"m6 minimum spacing = 0.46 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pdif space       0.36 GDS_nw space 0.36      "nw minimum enclosure of pdif = 0.36 um." GDS_nw

    
    cifedge GDS_nw space       1 space 0 1       "nw minimum enclosure of pdif = 0.36 um." DRC_pdif


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_nwc space       0.24 GDS_nw space 0.24      "nw minimum enclosure of nwc = 0.24 um." GDS_nw

    
    cifedge GDS_nw space       1 space 0 1       "nw minimum enclosure of nwc = 0.24 um." DRC_nwc


	cifspacing GDS_nw DRC_ndif 0.36 touching_illegal 		"nw to ndif minimum spacing = 0.36 um."

	cifspacing GDS_nw DRC_pwc 0.24 touching_illegal 		"nw to pwc minimum spacing = 0.24 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pfet space       0.35 GDS_pplus space 0.35      "pplus minimum enclosure of pfet = 0.35 um." GDS_pplus

    
    cifedge GDS_pplus space       1 space 0 1       "pplus minimum enclosure of pfet = 0.35 um." DRC_pfet


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pdif space       0.2 GDS_pplus space 0.2      "pplus minimum enclosure of pdif = 0.2 um." GDS_pplus

    
    cifedge GDS_pplus space       1 space 0 1       "pplus minimum enclosure of pdif = 0.2 um." DRC_pdif


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pwc space       0.04 GDS_pplus space 0.04      "pplus minimum enclosure of pwc = 0.04 um." GDS_pplus

    
    cifedge GDS_pplus space       1 space 0 1       "pplus minimum enclosure of pwc = 0.04 um." DRC_pwc


	
    
    
    
    
    
    
    
    
    
  


    


    cifedge space GDS_pplus       1 space 0 1       "pplus to nplus minimum spacing = 0.0 um." GDS_nplus

    
    cifedge space GDS_nplus       1 space 0 1       "pplus to nplus minimum spacing = 0.0 um." GDS_pplus


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_nfet space       0.35 GDS_nplus space 0.35      "nplus minimum enclosure of nfet = 0.35 um." GDS_nplus

    
    cifedge GDS_nplus space       1 space 0 1       "nplus minimum enclosure of nfet = 0.35 um." DRC_nfet


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_ndif space       0.2 GDS_nplus space 0.2      "nplus minimum enclosure of ndif = 0.2 um." GDS_nplus

    
    cifedge GDS_nplus space       1 space 0 1       "nplus minimum enclosure of ndif = 0.2 um." DRC_ndif


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_nwc space       0.04 GDS_nplus space 0.04      "nplus minimum enclosure of nwc = 0.04 um." GDS_nplus

    
    cifedge GDS_nplus space       1 space 0 1       "nplus minimum enclosure of nwc = 0.04 um." DRC_nwc


	spacing nfet nfet 0.22 touching_ok 		"nfet minimum spacing = 0.22 um."

	spacing pfet pfet 0.22 touching_ok 		"pfet minimum spacing = 0.22 um."

	cifspacing poly_not_fet all_diff 0.085 touching_illegal 		"poly_not_fet to all_diff minimum spacing = 0.085 um."

	edge4way nfet/active poly/active 0.22 poly/active 0 0 		"poly minimum extension past nfet = 0.22 um."

	edge4way pfet/active poly/active 0.22 poly/active 0 0 		"poly minimum extension past pfet = 0.22 um."

	edge4way nfet/active ndif/active 0.22 ndif/active 0 0 		"ndif minimum extension past nfet = 0.22 um."

	edge4way pfet/active pdif/active 0.22 pdif/active 0 0 		"pdif minimum extension past pfet = 0.22 um."

	area pwc 0.144 0.18 		"pwc minimum area = 0.144 um2."

	area nwc 0.144 0.18 		"nwc minimum area = 0.144 um2."

	cifspacing ct_ndif DRC_nfet 0.13 touching_illegal 		"ct_ndif to nfet minimum spacing = 0.13 um."

	cifspacing ct_pdif DRC_pfet 0.13 touching_illegal 		"ct_pdif to pfet minimum spacing = 0.13 um."

	cifspacing ct_poly DRC_pfet 0.17 touching_illegal 		"ct_poly to pfet minimum spacing = 0.17 um."

	cifspacing ct_poly DRC_nfet 0.17 touching_illegal 		"ct_poly to nfet minimum spacing = 0.17 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_ct space       0.085 all_poly_dif space 0.085      "all_poly_dif minimum enclosure of ct = 0.085 um." all_poly_dif

    
    cifedge all_poly_dif space       1 space 0 1       "all_poly_dif minimum enclosure of ct = 0.085 um." DRC_ct


	cifwidth m1_ct_check 0.18 		"m1 enclosure of ct = 0.05 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((ct))/ct ~((ct))/ct       0.005 (m1) ~((ct))/ct 0.005      "m1 minimum enclosure of ct = 0.005 um." m1

    
    edge (m1) ~((m1))/m1       1 ~((ct))/ct 0 1       "m1 minimum enclosure of ct = 0.005 um." ct


	cifwidth m1_v12_check 0.22 		"m1 enclosure of v12 = 0.05 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v12))/v12 ~((v12))/v12       0.01 (m1) ~((v12))/v12 0.01      "m1 minimum enclosure of v12 = 0.01 um." m1

    
    edge (m1) ~((m1))/m1       1 ~((v12))/v12 0 1       "m1 minimum enclosure of v12 = 0.01 um." v12


	cifwidth m2_v12_check 0.22 		"m2 enclosure of v12 = 0.05 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v12))/v12 ~((v12))/v12       0.01 (m2) ~((v12))/v12 0.01      "m2 minimum enclosure of v12 = 0.01 um." m2

    
    edge (m2) ~((m2))/m2       1 ~((v12))/v12 0 1       "m2 minimum enclosure of v12 = 0.01 um." v12


	cifwidth m2_v23_check 0.22 		"m2 enclosure of v23 = 0.05 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v23))/v23 ~((v23))/v23       0.01 (m2) ~((v23))/v23 0.01      "m2 minimum enclosure of v23 = 0.01 um." m2

    
    edge (m2) ~((m2))/m2       1 ~((v23))/v23 0 1       "m2 minimum enclosure of v23 = 0.01 um." v23


	cifwidth m3_v23_check 0.22 		"m3 enclosure of v23 = 0.05 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v23))/v23 ~((v23))/v23       0.01 (m3) ~((v23))/v23 0.01      "m3 minimum enclosure of v23 = 0.01 um." m3

    
    edge (m3) ~((m3))/m3       1 ~((v23))/v23 0 1       "m3 minimum enclosure of v23 = 0.01 um." v23


	cifwidth m3_v34_check 0.22 		"m3 enclosure of v34 = 0.05 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v34))/v34 ~((v34))/v34       0.01 (m3) ~((v34))/v34 0.01      "m3 minimum enclosure of v34 = 0.01 um." m3

    
    edge (m3) ~((m3))/m3       1 ~((v34))/v34 0 1       "m3 minimum enclosure of v34 = 0.01 um." v34


	cifwidth m4_v34_check 0.22 		"m4 enclosure of v34 = 0.05 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v34))/v34 ~((v34))/v34       0.01 (m4) ~((v34))/v34 0.01      "m4 minimum enclosure of v34 = 0.01 um." m4

    
    edge (m4) ~((m4))/m4       1 ~((v34))/v34 0 1       "m4 minimum enclosure of v34 = 0.01 um." v34


	cifwidth m4_v45_check 0.22 		"m4 enclosure of v45 = 0.05 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v45))/v45 ~((v45))/v45       0.01 (m4) ~((v45))/v45 0.01      "m4 minimum enclosure of v45 = 0.01 um." m4

    
    edge (m4) ~((m4))/m4       1 ~((v45))/v45 0 1       "m4 minimum enclosure of v45 = 0.01 um." v45


	cifwidth m5_v45_check 0.22 		"m5 enclosure of v45 = 0.05 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v45))/v45 ~((v45))/v45       0.01 (m5) ~((v45))/v45 0.01      "m5 minimum enclosure of v45 = 0.01 um." m5

    
    edge (m5) ~((m5))/m5       1 ~((v45))/v45 0 1       "m5 minimum enclosure of v45 = 0.01 um." v45


	cifwidth m5_v56_check 0.36 		"m5 enclosure of v56 = 0.05 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v56))/v56 ~((v56))/v56       0.01 (m5) ~((v56))/v56 0.01      "m5 minimum enclosure of v56 = 0.01 um." m5

    
    edge (m5) ~((m5))/m5       1 ~((v56))/v56 0 1       "m5 minimum enclosure of v56 = 0.01 um." v56


	cifwidth m6_v56_check 0.36 		"m6 enclosure of v56 = 0.09 um on at least 2 opposite sides."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v56))/v56 ~((v56))/v56       0.01 (m6) ~((v56))/v56 0.01      "m6 minimum enclosure of v56 = 0.01 um." m6

    
    edge (m6) ~((m6))/m6       1 ~((v56))/v56 0 1       "m6 minimum enclosure of v56 = 0.01 um." v56


	area m1 0.144 0.19 		"m1 minimum area = 0.144 um2."

	area m2 0.144 0.24 		"m2 minimum area = 0.144 um2."

	area m3 0.144 0.24 		"m3 minimum area = 0.144 um2."

	area m4 0.144 0.24 		"m4 minimum area = 0.144 um2."

	area m5 0.144 0.24 		"m5 minimum area = 0.144 um2."

	area m6 0.562 0.44 		"m6 minimum area = 0.562 um2."

	no_overlap	nfet,pfet	nfet,pfet

	exact_overlap	ct,v12,v23,v34,v45,v56

end

extract
style	mmi15
	noplaneordering

	cscale	1
	lambda	1
	step	1000
	sidehalo	0

	resist poly 115
	areacap poly 0.0001
	perimc poly space/active 0.1

	resist m1 115
	areacap m1 0.0001
	perimc m1 space/m1 0.1

	resist m2 115
	areacap m2 0.0001
	perimc m2 space/m2 0.1

	resist m3 115
	areacap m3 0.0001
	perimc m3 space/m3 0.1

	resist m4 115
	areacap m4 0.0001
	perimc m4 space/m4 0.1

	resist m5 115
	areacap m5 0.0001
	perimc m5 space/m5 0.1

	resist m6 115
	areacap m6 0.0001
	perimc m6 space/m6 0.1

	fet nfet ndif 2 nfet GND! 0 0
	fet pfet pdif 2 pfet Vdd! 0 0

end


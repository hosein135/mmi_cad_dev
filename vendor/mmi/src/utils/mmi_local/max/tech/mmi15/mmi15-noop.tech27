		or m6_v56_sx
		shrink 0.01
		and v56
	templayer m4_v45_sx m4
		shrinkx 0.04
	templayer m2_v12_sx m2
		shrinkx 0.04
	templayer m1_v12_check m1
		shrinky 0.04
		or m1_v12_sx
		shrink 0.01
		and v12
	templayer m4_v45_check m4
		shrinky 0.04
		or m4_v45_sx
		shrink 0.01
		and v45
	templayer m2_v12_check m2
		shrinky 0.04
		or m2_v12_sx
		shrink 0.01
		and v12
	templayer m5_v45_check m5
		shrinky 0.04

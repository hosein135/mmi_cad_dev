drc
cifstyle mmi15

	cifwidth GDS_nw 0.73 		"nw minimum width = 0.73 um."

	cifspacing GDS_nw GDS_nw 0.73 touching_ok 		"nw minimum spacing = 0.73 um."

	width ndif,nfet 0.18 		"ndif minimum width = 0.18 um."

	spacing ndif,nfet ndif,nfet 0.24 touching_ok 		"ndif minimum spacing = 0.24 um."

	width pdif,pfet 0.18 		"pdif minimum width = 0.18 um."

	spacing pdif,pfet pdif,pfet 0.24 touching_ok 		"pdif minimum spacing = 0.24 um."

	width nwc 0.18 		"nwc minimum width = 0.18 um."

	spacing nwc nwc 0.24 touching_ok 		"nwc minimum spacing = 0.24 um."

	width pwc 0.18 		"pwc minimum width = 0.18 um."

	spacing pwc pwc 0.24 touching_ok 		"pwc minimum spacing = 0.24 um."

	width poly,nfet,pfet 0.15 		"poly minimum width = 0.15 um."

	spacing poly,nfet,pfet poly,nfet,pfet 0.22 touching_ok 		"poly minimum spacing = 0.22 um."

	cifwidth GDS_pplus 0.38 		"pplus minimum width = 0.38 um."

	cifspacing GDS_pplus GDS_pplus 0.38 touching_ok 		"pplus minimum spacing = 0.38 um."

	cifwidth GDS_nplus 0.38 		"nplus minimum width = 0.38 um."

	cifspacing GDS_nplus GDS_nplus 0.38 touching_ok 		"nplus minimum spacing = 0.38 um."

	width ct 0.18 		"ct minimum width = 0.18 um."

	spacing ct ct 0.21 touching_ok 		"ct minimum spacing = 0.21 um."

	width m1 0.19 		"m1 minimum width = 0.19 um."

	spacing m1 m1 0.2 touching_ok 		"m1 minimum spacing = 0.2 um."

	width v12 0.22 		"v12 minimum width = 0.22 um."

	spacing v12 v12 0.22 touching_ok 		"v12 minimum spacing = 0.22 um."

	width m2 0.24 		"m2 minimum width = 0.24 um."

	spacing m2 m2 0.24 touching_ok 		"m2 minimum spacing = 0.24 um."

	width v23 0.22 		"v23 minimum width = 0.22 um."

	spacing v23 v23 0.22 touching_ok 		"v23 minimum spacing = 0.22 um."

	width m3 0.24 		"m3 minimum width = 0.24 um."

	spacing m3 m3 0.24 touching_ok 		"m3 minimum spacing = 0.24 um."

	width v34 0.22 		"v34 minimum width = 0.22 um."

	spacing v34 v34 0.22 touching_ok 		"v34 minimum spacing = 0.22 um."

	width m4 0.24 		"m4 minimum width = 0.24 um."

	spacing m4 m4 0.24 touching_ok 		"m4 minimum spacing = 0.24 um."

	width v45 0.22 		"v45 minimum width = 0.22 um."

	spacing v45 v45 0.22 touching_ok 		"v45 minimum spacing = 0.22 um."

	width m5 0.24 		"m5 minimum width = 0.24 um."

	spacing m5 m5 0.24 touching_ok 		"m5 minimum spacing = 0.24 um."

	width v56 0.36 		"v56 minimum width = 0.36 um."

	spacing v56 v56 0.35 touching_ok 		"v56 minimum spacing = 0.35 um."

	width m6 0.44 		"m6 minimum width = 0.44 um."

	spacing m6 m6 0.46 touching_ok 		"m6 minimum spacing = 0.46 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pdif space       0.36 GDS_nw space 0.36      "nw minimum enclosure of pdif = 0.36 um." GDS_nw

    
    cifedge GDS_nw space       1 space 0 1       "nw minimum enclosure of pdif = 0.36 um." DRC_pdif


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_nwc space       0.24 GDS_nw space 0.24      "nw minimum enclosure of nwc = 0.24 um." GDS_nw

    
    cifedge GDS_nw space       1 space 0 1       "nw minimum enclosure of nwc = 0.24 um." DRC_nwc


	cifspacing GDS_nw DRC_ndif 0.36 touching_illegal 		"nw to ndif minimum spacing = 0.36 um."

	cifspacing GDS_nw DRC_pwc 0.24 touching_illegal 		"nw to pwc minimum spacing = 0.24 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pfet space       0.32 GDS_pplus space 0.32      "pplus minimum enclosure of pfet = 0.32 um." GDS_pplus

    
    cifedge GDS_pplus space       1 space 0 1       "pplus minimum enclosure of pfet = 0.32 um." DRC_pfet


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pdif space       0.2 GDS_pplus space 0.2      "pplus minimum enclosure of pdif = 0.2 um." GDS_pplus

    
    cifedge GDS_pplus space       1 space 0 1       "pplus minimum enclosure of pdif = 0.2 um." DRC_pdif


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_pwc space       0.04 GDS_pplus space 0.04      "pplus minimum enclosure of pwc = 0.04 um." GDS_pplus

    
    cifedge GDS_pplus space       1 space 0 1       "pplus minimum enclosure of pwc = 0.04 um." DRC_pwc


	cifspacing GDS_pplus GDS_nplus 0.04 touching_illegal 		"pplus to nplus minimum spacing = 0.04 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_nfet space       0.32 GDS_nplus space 0.32      "nplus minimum enclosure of nfet = 0.32 um." GDS_nplus

    
    cifedge GDS_nplus space       1 space 0 1       "nplus minimum enclosure of nfet = 0.32 um." DRC_nfet


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_ndif space       0.2 GDS_nplus space 0.2      "nplus minimum enclosure of ndif = 0.2 um." GDS_nplus

    
    cifedge GDS_nplus space       1 space 0 1       "nplus minimum enclosure of ndif = 0.2 um." DRC_ndif


	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_nwc space       0.04 GDS_nplus space 0.04      "nplus minimum enclosure of nwc = 0.04 um." GDS_nplus

    
    cifedge GDS_nplus space       1 space 0 1       "nplus minimum enclosure of nwc = 0.04 um." DRC_nwc


	spacing nfet nfet 0.22 touching_ok 		"nfet minimum spacing = 0.22 um."

	spacing pfet pfet 0.22 touching_ok 		"pfet minimum spacing = 0.22 um."

	cifspacing poly_not_fet all_diff 0.085 touching_illegal 		"poly_not_fet to all_diff minimum spacing = 0.085 um."

	edge4way nfet/active poly/active 0.185 poly/active 0 0 		"poly minimum extension past nfet = 0.185 um."

	edge4way pfet/active poly/active 0.185 poly/active 0 0 		"poly minimum extension past pfet = 0.185 um."

	edge4way nfet/active ndif/active 0.22 ndif/active 0 0 		"ndif minimum extension past nfet = 0.22 um."

	edge4way pfet/active pdif/active 0.22 pdif/active 0 0 		"pdif minimum extension past pfet = 0.22 um."

	area pwc 0.144 0.18 		"pwc minimum area = 0.144 um2."

	area nwc 0.144 0.18 		"nwc minimum area = 0.144 um2."

	cifspacing ct_ndif DRC_nfet 0.13 touching_illegal 		"ct_ndif to nfet minimum spacing = 0.13 um."

	cifspacing ct_pdif DRC_pfet 0.13 touching_illegal 		"ct_pdif to pfet minimum spacing = 0.13 um."

	cifspacing ct_poly DRC_pfet 0.17 touching_illegal 		"ct_poly to pfet minimum spacing = 0.17 um."

	cifspacing ct_poly DRC_nfet 0.17 touching_illegal 		"ct_poly to nfet minimum spacing = 0.17 um."

	
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_ct space       0.085 all_poly_dif space 0.085      "all_poly_dif minimum enclosure of ct = 0.085 um." all_poly_dif

    
    cifedge all_poly_dif space       1 space 0 1       "all_poly_dif minimum enclosure of ct = 0.085 um." DRC_ct


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((ct))/ct ~((ct))/ct       0.05 (m1) ~((ct))/ct 0.05      "m1 minimum enclosure of ct = 0.05 um." m1

    
    edge (m1) ~((m1))/m1       1 ~((ct))/ct 0 1       "m1 minimum enclosure of ct = 0.05 um." ct


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v12))/v12 ~((v12))/v12       0.05 (m1) ~((v12))/v12 0.05      "m1 minimum enclosure of v12 = 0.05 um." m1

    
    edge (m1) ~((m1))/m1       1 ~((v12))/v12 0 1       "m1 minimum enclosure of v12 = 0.05 um." v12


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v12))/v12 ~((v12))/v12       0.05 (m2) ~((v12))/v12 0.05      "m2 minimum enclosure of v12 = 0.05 um." m2

    
    edge (m2) ~((m2))/m2       1 ~((v12))/v12 0 1       "m2 minimum enclosure of v12 = 0.05 um." v12


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v23))/v23 ~((v23))/v23       0.05 (m2) ~((v23))/v23 0.05      "m2 minimum enclosure of v23 = 0.05 um." m2

    
    edge (m2) ~((m2))/m2       1 ~((v23))/v23 0 1       "m2 minimum enclosure of v23 = 0.05 um." v23


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v23))/v23 ~((v23))/v23       0.05 (m3) ~((v23))/v23 0.05      "m3 minimum enclosure of v23 = 0.05 um." m3

    
    edge (m3) ~((m3))/m3       1 ~((v23))/v23 0 1       "m3 minimum enclosure of v23 = 0.05 um." v23


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v34))/v34 ~((v34))/v34       0.05 (m3) ~((v34))/v34 0.05      "m3 minimum enclosure of v34 = 0.05 um." m3

    
    edge (m3) ~((m3))/m3       1 ~((v34))/v34 0 1       "m3 minimum enclosure of v34 = 0.05 um." v34


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v34))/v34 ~((v34))/v34       0.05 (m4) ~((v34))/v34 0.05      "m4 minimum enclosure of v34 = 0.05 um." m4

    
    edge (m4) ~((m4))/m4       1 ~((v34))/v34 0 1       "m4 minimum enclosure of v34 = 0.05 um." v34


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v45))/v45 ~((v45))/v45       0.05 (m4) ~((v45))/v45 0.05      "m4 minimum enclosure of v45 = 0.05 um." m4

    
    edge (m4) ~((m4))/m4       1 ~((v45))/v45 0 1       "m4 minimum enclosure of v45 = 0.05 um." v45


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v45))/v45 ~((v45))/v45       0.05 (m5) ~((v45))/v45 0.05      "m5 minimum enclosure of v45 = 0.05 um." m5

    
    edge (m5) ~((m5))/m5       1 ~((v45))/v45 0 1       "m5 minimum enclosure of v45 = 0.05 um." v45


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v56))/v56 ~((v56))/v56       0.05 (m5) ~((v56))/v56 0.05      "m5 minimum enclosure of v56 = 0.05 um." m5

    
    edge (m5) ~((m5))/m5       1 ~((v56))/v56 0 1       "m5 minimum enclosure of v56 = 0.05 um." v56


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v56))/v56 ~((v56))/v56       0.09 (m6) ~((v56))/v56 0.09      "m6 minimum enclosure of v56 = 0.09 um." m6

    
    edge (m6) ~((m6))/m6       1 ~((v56))/v56 0 1       "m6 minimum enclosure of v56 = 0.09 um." v56


	area m1 0.144 0.19 		"m1 minimum area = 0.144 um2."

	area m2 0.144 0.24 		"m2 minimum area = 0.144 um2."

	area m3 0.144 0.24 		"m3 minimum area = 0.144 um2."

	area m4 0.144 0.24 		"m4 minimum area = 0.144 um2."

	area m5 0.144 0.24 		"m5 minimum area = 0.144 um2."

	area m6 0.562 0.44 		"m6 minimum area = 0.562 um2."

	no_overlap	nfet,pfet	nfet,pfet

	exact_overlap	ct,v12,v23,v34,v45,v56

end

extract
style	mmi15
	noplaneordering

	cscale	1
	lambda	1
	step	1000
	sidehalo	0

	resist poly 115
	areacap poly 0.0001
	perimc poly space/active 0.1

	resist m1 115
	areacap m1 0.0001
	perimc m1 space/m1 0.1

	resist m2 115
	areacap m2 0.0001
	perimc m2 space/m2 0.1

	resist m3 115
	areacap m3 0.0001
	perimc m3 space/m3 0.1

	resist m4 115
	areacap m4 0.0001
	perimc m4 space/m4 0.1

	resist m5 115
	areacap m5 0.0001
	perimc m5 space/m5 0.1

	resist m6 115
	areacap m6 0.0001
	perimc m6 space/m6 0.1

	fet nfet ndif 2 nfet GND! 0 0
	fet pfet pdif 2 pfet Vdd! 0 0

end


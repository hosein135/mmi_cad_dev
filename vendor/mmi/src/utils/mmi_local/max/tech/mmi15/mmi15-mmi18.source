# This is the technology source file for mmi15 (0.15 um CMOS)

# This command will preserve MAX port types by writing them out to
# different datatypes.  Only valid if no datatypes are specified.
preserve_ports


#layer	gds:dt	txt:dt	type	width	space	color
#======	=======	=======	=======	=======	=======	=======
nw  	2	-	-	0.73	0.73	              
#hotwl 	51	-	-	-	-	              
od    	3	-	gdsonly	-	-
odp  	11	-	gdsonly	-	-
odn  	12	-	gdsonly	-	-
ndif	derived	-	act	0.18	0.24	66,213,66
pdif	derived	-	act	0.18	0.24	202,160,115
nwc	derived	ndif	act	0.18	0.24	-
pwc	derived	pdif	act	0.18	0.24	-
od2   	4	-	-	-	-
poly  	13	-	poly	0.15    0.22
n3v   	5	-	-	-	-
pplus  	7	-	-	0.38    0.38
nplus  	8	-	-	0.38    0.38
ct    	15	-	via	0.18    0.21
m1    	16	40	metal	0.19    0.20
v12  	17	-	via	0.22    0.22
m2    	18	41	metal	0.24    0.24
v23  	27	-	via	0.22    0.22
m3    	28	42	metal	0.24    0.24
v34  	29	-	via	0.22    0.22
m4    	31	43	metal	0.24    0.24
v45  	32	-	via	0.22    0.22
m5    	33	44	metal	0.24    0.24
v56  	39	-	via	0.36    0.35
m6    	38	45	metal	0.44    0.46
pad   	19	-	-	-	-             
#ph   	35	-	-	-	-
sd   	58	-	-	-	-             
psub2	50	-	-	-	-
esd   	30	-	-	-	-
rpdummy	54	-	-	-	
#tsmc1	60	-	-	-	-
#tsmc2	66	-	-	-	-	
#esd1dmy	136	-	-	-	-
#esd2dmy	137	-	-	-	-
dpdmy	65	-	-	-	-
rpo   	34	-	-	-	-
#n2v   	61	-	-	-	-
prb	68	-	-	-	-	
text	-	255	text
bbox	62	-	bbox
iname	propattr 102	iname



device nfet from poly ndif
device pfet from poly pdif

# for butting contacts
connect nwc pdif
connect pwc ndif

# on output
# if you want to write out all diffusions on the same layer, use od
derive od from ndif,pdif,nwc,pwc
derive odn from ndif,nwc
derive odp from pdif,pwc

# in input
derive ndif from od and-not pplus or odn and-not nw
derive pdif from od and pplus or odp and nw
derive nwc from od and-not pplus or odn and nw
derive pwc from od and pplus or odp and-not nw

# automatic generation of pplus, nplus, nw
# NOTE: no generation for nplus/pplus on poly away from fet
derive pplus from pfet grow 0.12 or pdif grow 0.16 or pwc grow 0.04 \
	and-not ndif and-not nplus \
	or pplus shrink 0.16 grow 0.32 shrink 0.16
	
derive nplus from nfet grow 0.12 or ndif grow 0.16 or nwc grow 0.04 \
	and-not pdif and-not pplus \
	or nplus shrink 0.16 grow 0.32 shrink 0.16

# To remove nwell generation
#derive block from pplus and-not nw
#derive nw from pdif grow .12 or nwc grow 0.24 or nw \
#	and-not block shrink 0.30 grow 0.60 shrink 0.30

derive nw from pdif grow .12 or nwc grow 0.24 or nw \
	grow 0.36 shrink 0.36

drc nw enc pdif 0.36
drc nw enc nwc 0.24
drc nw space_to ndif 0.36
drc nw space_to pwc 0.24

drc pplus enc pfet 0.32
drc pplus enc pdif 0.20
drc pplus enc pwc 0.04

# to get the layout generator to work correctly
#drc pplus space_to nplus 0.0
drc pplus space_to nplus 0.04

drc nplus enc nfet 0.32
drc nplus enc ndif 0.20
drc nplus enc nwc 0.04

# recommended 0.29
drc nfet space 0.22
drc pfet space 0.22

derive tmp1 from nfet,pfet grow 0.085
derive poly_not_fet from poly and-not tmp1
derive all_diff from ndif,pdif,nwc,pwc
drc poly_not_fet space_to all_diff 0.085

# for < max3.0 must be on same plane
drc poly ext nfet 0.185
drc poly ext pfet 0.185

#drc ndif ext nfet 0.27
#drc pdif ext pfet 0.27
# Since this conflicts with the nfet, pfet space rules
drc ndif ext nfet 0.22
drc pdif ext pfet 0.22
set DRC_DATA(extend,ndif,nfet) 0.27
set DRC_DATA(extend,pdif,pfet) 0.27

drc pwc area 0.144
drc nwc area 0.144

derive ct_ndif from ct and ndif,nwc
derive ct_pdif from ct and pdif,pwc
drc ct_ndif space_to nfet 0.13
drc ct_pdif space_to pfet 0.13

derive ct_poly from ct and poly
drc ct_poly space_to pfet 0.17
drc ct_poly space_to nfet 0.17

derive all_poly_dif from ndif,pdif,nwc,pwc,poly
drc all_poly_dif enc ct 0.085


DRC m1 ENC ct 0.05
DRC m1 ENC v12 0.05
DRC m2 ENC v12 0.05
DRC m2 ENC v23 0.05
DRC m3 ENC v23 0.05
DRC m3 ENC v34 0.05
DRC m4 ENC v34 0.05
DRC m4 ENC v45 0.05
DRC m5 ENC v45 0.05
DRC m5 ENC v56 0.05
DRC m6 ENC v56 0.09


drc m1 area 0.144
drc m2 area 0.144
drc m3 area 0.144
drc m4 area 0.144
drc m5 area 0.144
drc m6 area 0.562


# add other tcl variable definitions with the set statement

################################################################
# USER DESIGN GRID
# This is the initial value shown in the Grid menu.
################################################################
set GRID(resolution) 0.005
set GRID(mask) 0.005


################################################################
# LAYER NAMES
# Mapping from mmi layer names to customer tech names.
# Change the name on the right to be the name of the specified
# layer in this technology file.
# Note that contact and poly could be derived from info above.
################################################################

set LAYER_NAME(pdiff) pdif
set LAYER_NAME(ndiff) ndif
set LAYER_NAME(nplus) nplus
set LAYER_NAME(pplus) pplus
set LAYER_NAME(nwell) nw
set LAYER_NAME(poly) poly
set LAYER_NAME(contact) ct


set DRC_DATA(enclose,diff,ct) 0.085
set DRC_DATA(spacing,diff) 0.24
set DRC_DATA(space_to,poly,diff) 0.085
set DRC_DATA(space_to,ct,gate) 0.13

################################################################
# LAYOUT GENERATOR RULES
# Additional Rules for Layout Generator used
# when generating standard cells.
################################################################

set LAYINFO(stdcell:cell_height) 6.2
set LAYINFO(stdcell:dpc_router_pitch) 0.62  ;# Router pitch for m1, m2, m3, etc.
set LAYINFO(stdcell:power_strap_width) 0.84
# You can optionally use a smaller cell_router_pitch than
# dpc_router_pitch.  The min poly contact pitch is .67, but in order
# to put a .45 router landing pad in the track, it must be .68.
set LAYINFO(stdcell:cell_router_pitch) 0.58  ;# Router pitch for poly/metal.


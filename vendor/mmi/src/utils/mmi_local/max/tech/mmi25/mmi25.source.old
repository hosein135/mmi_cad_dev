# The is the technology source file for mmi25 (0.25 um CMOS)

# This command will preserve MAX port types by writing them out to
# different datatypes.  Only valid if no datatypes are specified.
preserve_ports

# layer	gds:dt  txt:dt	type	width	space	color
#======	======= =======	=======	=======	=======	======
nw	2	-	-	1.2	0.6	-
# gds layer 4 for compatilibity with previous mmi25 source file
od	3,4	-	gdsonly	-	-	-
odn	12	-	gdsonly	-	-	-
odp	11	-	gdsonly	-	-	-
ndif	derived	-	act	0.3	0.4	66,213,66
pdif	derived	-	act	0.3	0.4	202,160,115
nwc	derived	ndif	act	0.3	0.4	-
pwc	derived	pdif	act	0.3	0.4	-
poly	13	-	poly	0.24    0.36	236,67,0
#n2v	61	-	-	0.44    0.44	-
#n3v	5	-	-	0.44    0.44	-
pplus	7	-	-	0.44    0.44	-
nplus	8	-	-	0.44    0.44	-
ct	15	-	via	0.30    0.30	-
m1	16	40	metal	0.32    0.32	8,139,255
v12	17	-	via	0.36    0.35	-
m2	18	41	metal	0.40    0.40	182,134,222
v23	27	-	via	0.36    0.35	-
m3	28	42	metal	0.40    0.40	255,160,65
v34	29	-	via	0.36    0.35	-
m4	31	43	metal	0.40    0.40	61,122,188
v45	32	-	via	0.36    0.35	-
m5	33	44	metal	0.44    0.46	gold
prb	65	-	-	-	-
text	-	255	text
bbox	62	-	bbox
#iname	63	-	iname
iname	propattr 102	iname

device nfet from poly ndif
device pfet from poly pdif

# for butting contacts
connect nwc pdif
connect pwc ndif

# on output
# if you want to write out all diffusions on the same layer, use od
#derive od from ndif,pdif,nwc,pwc
derive odn from ndif,nwc
derive odp from pdif,pwc

# in input
derive ndif from od and-not pplus or odn and-not nw
derive pdif from od and pplus or odp and nw
derive nwc from od and-not pplus or odn and nw
derive pwc from od and pplus or odp and-not nw

# automatic generation of pplus, nplus, nw
derive pplus_poly from pfet grow 0.07 or pdif grow 0.22 or pwc grow 0.04 \
	shrink 0.21 grow 0.43 shrink 0.22 and poly grow 0.63 shrink 0.3

derive nwc_grow from nwc grow 0.14

derive pplus from pfet grow 0.07 or pdif grow 0.22 or pwc grow 0.04 \
	or pplus_poly and-not nwc_grow or pplus \
	shrink 0.21 grow 0.43 shrink 0.22

derive pplus_grow from GDS_pplus grow 0.1
	
derive nplus from nfet grow 0.07 or ndif grow 0.16 or poly grow 0.06 \
	or nwc grow 0.04 and-not pplus_grow \
	or nplus shrink 0.21 grow 0.43 shrink 0.22

derive nw from pdif grow 0.44 or nwc grow 0.16 or nw grow 0.3 shrink 0.3

drc nw enc nwc 0.16
drc nw enc pdif 0.6
drc nw space_to ndif 0.6
drc nw space_to pwc 0.16

drc nfet space 0.5
drc pfet space 0.5

derive tmp1 from nfet,pfet grow 0.14
derive poly_not_fet from poly and-not tmp1
derive all_diff from ndif,pdif,nwc,pwc
drc poly_not_fet space_to all_diff 0.14

# for < max3.0 must be on same plane
drc poly ext nfet 0.36
drc poly ext pfet 0.36
drc ndif ext nfet 0.44
drc pdif ext pfet 0.44

drc pplus space_to ndif 0.3
drc pplus space_to nwc 0.14
drc pplus space_to nfet 0.33

drc pplus enc pfet 0.33
drc pplus enc pdif 0.26
drc pplus enc pwc 0.04

drc nplus space_to pdif 0.3
drc nplus space_to pwc 0.14
drc nplus space_to pfet 0.33

drc nplus enc nfet 0.33
drc nplus enc ndif 0.26
drc nplus enc nwc 0.04

derive implant from GDS_nplus,GDS_pplus grow 0.05 shrink 0.05
drc implant enc poly 0.1
drc nplus space_to pplus 0.1

derive ct_ndif from ct and ndif,nwc
derive ct_pdif from ct and pdif,pwc
drc ct_ndif space_to nfet 0.22
drc ct_pdif space_to pfet 0.22

derive ct_poly from ct and poly
drc ct_poly space_to pfet 0.28
drc ct_poly space_to nfet 0.28

derive all_poly_dif from ndif,pdif,nwc,pwc,poly
drc all_poly_dif enc ct 0.14

# redundant
#drc nplus enc ct_ndif 0.18
#drc pplus enc ct_pdif 0.18

drc m1 enc ct 0.09

drc m1 area 0.36

drc m1 enc v12 0.09

drc v12 space_to nfet,pfet 0.01

drc m2 enc v12 0.09
drc m2 area 0.36

drc m2 enc v23 0.1
drc m3 enc v23 0.09

drc m3 area 0.36

drc m3 enc v34 0.09
drc m4 enc v34 0.09

drc m4 area 0.36

drc m4 enc v45 0.09

# no m5 area rule

drc m5 enc v45 0.09


# add other tcl variable definitions with the set statement

################################################################
# USER DESIGN GRID
# This is the initial value shown in the Grid menu.
################################################################
set GRID(resolution) 0.01

################################################################
# LAYOUT GENERATOR DRC RULES
# These are DRC rules that are not generated by make_tech.
# TODO: These need to be folded into the additional DRC rules section, above.
################################################################

set LAYINFO(poly,diff,sep) 0.14		;# PO.C.1
set LAYINFO(poly,nwc,sep) 0.34		;# OD.C.6
set LAYINFO(poly,pwc,sep) 0.34		;# OD.C.6

set LAYINFO(diff,ct,overlap) 0.14	;# CO.E.1
# diff_diff sep is the max of pdif_pdif, pdif_ndif, ndif_ndif sep.
set LAYINFO(diff,diff,sep) 0.40		;# OD.S.1
set LAYINFO(pdif,min_width) 0.3  	;# OD.W.2
set LAYINFO(ndif,min_width) 0.3  	;# OD.W.2
set LAYINFO(ndif,ndif,sep) 0.40	
set LAYINFO(pdif,pdif,sep) 0.40		

# I think the new rule is ct_ndif,nfet or ct_pdif,pfet
set LAYINFO(ct,gate,sep) 0.22  		;# CO.C.1

set LAYINFO(nw_contact,width) 0.3	;# CO.W.1
set LAYINFO(pw_contact,width) 0.3	;# CO.W.1
# techinfo needs to check for inverted spacing rules.
# Until it does, need this rule:
set DRC_DATA(space_to,pplus,nplus) $DRC_DATA(space_to,nplus,pplus)



################################################################
# LAYER NAMES
# Mapping from mmi layer names to customer tech names.
# Change the name on the right to be the name of the specified
# layer in this technology file.
# Note that contact and poly could be derived from info above.
################################################################

set LAYER_NAME(pdiff) pdif
set LAYER_NAME(ndiff) ndif
set LAYER_NAME(nplus) nplus
set LAYER_NAME(pplus) pplus
set LAYER_NAME(nwell) nw
set LAYER_NAME(poly) poly
set LAYER_NAME(contact) ct


################################################################
# WIRING TOOL RULES 
# Additional routing rules, used by wiring tool.
################################################################

# These are the layers for which the user can configure the width,
# grid, etc.  This entry will be dynamically expanded if user tries to route
# in an unknown layer.  Note that ct, v1, etc are NOT in this list.
# TODO: This can probably be eliminated.
set ROUTE(config_layers) "m5 m4 m3 m2 m1 poly ndif pdif pwc nwc"

# And these two layers need to be initialized here because
# the wiring tool is not smart enough to figure out what size
# they should start out as.
# TODO: FIX THIS!!!
#set ROUTE(pwc,width) \
#	[expr $DRC_DATA(width,ct) + 2.0 * $LAYINFO(diff,ct,overlap)]
#set ROUTE(nwc,width) \
#	[expr $LAYINFO(ct,width) + 2.0 * $LAYINFO(diff,ct,overlap)]

# These ROUTE entries are used by the wiring tool to draw
# composite layers.  Composite layers cause the wiring tool to draw
# multiple layers simultaneously.  The name of the composite layer
# (eg: via1) is what the user selected to draw the layer.
# The layers that are actually drawn could
# be anything, possibly totally unrelated to a via1.

# TODO: This can probably be auto-generated.
set ROUTE(composite_layers) "pwc nwc ct v12 v23 v34 v45"

# The contact composite layer could be used over p1, pdif, ndif,
# whatever, so it includes only contact and m1.
# TODO: This can probably be auto-generated.
set ROUTE(v0,layers) "v0 m1"
set ROUTE(v1,layers) "v1 m1 m2"
set ROUTE(v2,layers) "v2 m2 m3"
set ROUTE(v3,layers) "v3 m3 m4"
set ROUTE(v4,layers) "v4 m4 m5"
set ROUTE(nwc,layers) "v0 m1 nwc"
set ROUTE(pwc,layers) "v0 m1 pwc"


################################################################
# FET GENERATOR RULES
# These are the default parameters for the fet.maxg.
# They may not be used any more.
################################################################
set LAYINFO(default_nfet_width) 1.0
set LAYINFO(default_pfet_width) 2.0


################################################################
# LAYOUT GENERATOR RULES
# Additional Rules for Layout Generator used
# when generating standard cells.
################################################################

# These are the default parameters for the Layout Generator.
set LAYINFO(m1,router_pad_size) "0.6 x 0.6" ;# Size of landing pad for router.
set LAYINFO(stdcell:cell_height) 10.0
set LAYINFO_HELP(stdcell:cell_height) {-number -incr 1}
set LAYINFO(stdcell:cell_width_pitch)  1.0   ;# Width is a multiple of this
set LAYINFO(stdcell:power_strap_width) 1.40
set LAYINFO(stdcell:well_v0_pitch) 1.0
set LAYINFO(stdcell:router_pitch) 1.0  ;# Router pitch for poly/metal.
set LAYINFO(stdcell:router_offset_x,y) "0.5,0.5" 
set LAYINFO(stdcell:N/P_boundary) 5.0  ;# Height of cell devoted to N vs P
set LAYINFO_HELP(stdcell:N/P_boundary) {-number -incr 0.5}
# Well Ties.
# nwc,width should be calculated by:
# nwc,width = well_v0,width + 2*diff,v0,overlap = .62
# But it must be centered at the top/bottom of cell, and .62 / 2 = .31,
# which is currently off max grid, so round up to .64
set LAYINFO(stdcell:nwc,width) 0.64
set LAYINFO(stdcell:pwc,width) 0.64






























































































































































 






 








tech
	mmi25
end

version
	version "mmi25-noop 12:30:35 Oct 26 2000"
	description "mmi25-noop"
end

planes
	nw
	active
	n2v
	n3v
	pplus
	nplus
	ct
	m1
	v12
	m2
	v23
	m3
	v34
	m4
	v45
	m5
	prb
	pass
	sram
	esd
	rpo
	cap
	psub2
	res
	resid
	excl
	diodeid
	compass
	io
	vtd
	drcdum
	mbound
end

types
	nw	nw
	active	ndif
	active	pdif
	active	nwc
	active	pwc
	active	poly
	n2v	n2v
	n3v	n3v
	pplus	pplus
	nplus	nplus
	ct	ct
	m1	m1
	v12	v12
	m2	m2
	v23	v23
	m3	m3
	v34	v34
	m4	m4
	v45	v45
	m5	m5
	prb	prb
	pass	pass
	sram	sram
	esd	esd
	rpo	rpo
	cap	cap
	psub2	psub2
	res	res
	resid	resid
	excl	excl
	diodeid	diodeid
	compass	compass
	io	io
	vtd	vtd
	drcdum	drcdum
	mbound	mbound
	active	nfet
	active	pfet
end

contact
end

styles
end

compose
	compose nfet poly ndif
	compose pfet poly pdif
end

connect
	nfet	poly
	pfet	poly
	ct	ndif,pdif,nwc,pwc,poly,m1
	v12	m1,m2
	v23	m2,m3
	v34	m3,m4
	v45	m4,m5
end

cifoutput
style mmi25

	units .001 .001 .001 .001
	charset unrestricted

	iname propattr 102
	bbox 62 0

	layer GDS_nw nw
	polygons nw
	labels nw
	calma 2 0

	layer GDS_odn ndif,nfet,nwc
	polygons ndif,nfet,nwc
	labels ndif,nfet,nwc
	calma 12 0

	layer GDS_odp pdif,pfet,pwc
	polygons pdif,pfet,pwc
	labels pdif,pfet,pwc
	calma 11 0

	layer GDS_poly poly,nfet,pfet
	polygons poly,nfet,pfet
	labels poly,nfet,pfet
	calma 13 0

	layer GDS_n2v n2v
	polygons n2v
	labels n2v
	calma 61 0

	layer GDS_n3v n3v
	polygons n3v
	labels n3v
	calma 5 0

	layer GDS_pplus pplus
	polygons pplus
	labels pplus
	calma 7 0

	layer GDS_nplus nplus
	polygons nplus
	labels nplus
	calma 8 0

	layer GDS_ct ct
	
	squares 0 0.3 0.3 align
	polygons ct
	labels ct
	calma 15 0

	layer GDS_m1 m1
	polygons m1
	calma 16 0

	layer TXT_m1
	labels m1
	calma 40 0

	layer GDS_v12 v12
	
	squares 0 0.36 0.35 align
	polygons v12
	labels v12
	calma 17 0

	layer GDS_m2 m2
	polygons m2
	calma 18 0

	layer TXT_m2
	labels m2
	calma 41 0

	layer GDS_v23 v23
	
	squares 0 0.36 0.35 align
	polygons v23
	labels v23
	calma 27 0

	layer GDS_m3 m3
	polygons m3
	calma 28 0

	layer TXT_m3
	labels m3
	calma 42 0

	layer GDS_v34 v34
	
	squares 0 0.36 0.35 align
	polygons v34
	labels v34
	calma 29 0

	layer GDS_m4 m4
	polygons m4
	calma 31 0

	layer TXT_m4
	labels m4
	calma 43 0

	layer GDS_v45 v45
	
	squares 0 0.36 0.35 align
	polygons v45
	labels v45
	calma 32 0

	layer GDS_m5 m5
	polygons m5
	calma 33 0

	layer TXT_m5
	labels m5
	calma 44 0

	layer GDS_prb prb
	polygons prb
	labels prb
	calma 65 0

	layer GDS_pass pass
	polygons pass
	labels pass
	calma 19 0

	layer GDS_sram sram
	polygons sram
	labels sram
	calma 20 0

	layer GDS_esd esd
	polygons esd
	labels esd
	calma 30 0

	layer GDS_rpo rpo
	polygons rpo
	labels rpo
	calma 34 0

	layer GDS_cap cap
	polygons cap
	labels cap
	calma 47 0

	layer GDS_psub2 psub2
	polygons psub2
	labels psub2
	calma 50 0

	layer GDS_res res
	polygons res
	labels res
	calma 52 0

	layer GDS_resid resid
	polygons resid
	labels resid
	calma 54 0

	layer GDS_excl excl
	polygons excl
	labels excl
	calma 55 0

	layer GDS_diodeid diodeid
	polygons diodeid
	labels diodeid
	calma 56 0

	layer GDS_compass compass
	polygons compass
	labels compass
	calma 57 0

	layer GDS_io io
	polygons io
	labels io
	calma 58 0

	layer GDS_vtd vtd
	polygons vtd
	labels vtd
	calma 59 0

	layer GDS_drcdum drcdum
	polygons drcdum
	labels drcdum
	calma 60 0

	layer GDS_mbound mbound
	polygons mbound
	labels mbound
	calma 66 0


	layer TXT_text
	labels space
	calma 255 0
end

cifinput
style	mmi25
	iname propattr 102
	bbox 62 0

	layer nw GDS_nw
	labels GDS_nw

	layer ndif GDS_od
		and-not GDS_pplus
		or GDS_odn
	labels GDS_ndif

	layer pdif GDS_od
		and GDS_pplus
		or GDS_odp
	labels GDS_pdif

	layer poly GDS_poly
	labels GDS_poly

	layer n2v GDS_n2v
	labels GDS_n2v

	layer n3v GDS_n3v
	labels GDS_n3v

	layer pplus GDS_pplus
	labels GDS_pplus

	layer nplus GDS_nplus
	labels GDS_nplus

	layer ct GDS_ct
	labels GDS_ct

	layer m1 GDS_m1
	labels TXT_m1

	layer v12 GDS_v12
	labels GDS_v12

	layer m2 GDS_m2
	labels TXT_m2

	layer v23 GDS_v23
	labels GDS_v23

	layer m3 GDS_m3
	labels TXT_m3

	layer v34 GDS_v34
	labels GDS_v34

	layer m4 GDS_m4
	labels TXT_m4

	layer v45 GDS_v45
	labels GDS_v45

	layer m5 GDS_m5
	labels TXT_m5

	layer prb GDS_prb
	labels GDS_prb

	layer pass GDS_pass
	labels GDS_pass

	layer sram GDS_sram
	labels GDS_sram

	layer esd GDS_esd
	labels GDS_esd

	layer rpo GDS_rpo
	labels GDS_rpo

	layer cap GDS_cap
	labels GDS_cap

	layer psub2 GDS_psub2
	labels GDS_psub2

	layer res GDS_res
	labels GDS_res

	layer resid GDS_resid
	labels GDS_resid

	layer excl GDS_excl
	labels GDS_excl

	layer diodeid GDS_diodeid
	labels GDS_diodeid

	layer compass GDS_compass
	labels GDS_compass

	layer io GDS_io
	labels GDS_io

	layer vtd GDS_vtd
	labels GDS_vtd

	layer drcdum GDS_drcdum
	labels GDS_drcdum

	layer mbound GDS_mbound
	labels GDS_mbound

	calma GDS_nw	2 *
	calma GDS_od	3 *
	calma GDS_odn	12 *
	calma GDS_odp	11 *
	calma GDS_poly	13 *
	calma GDS_n2v	61 *
	calma GDS_n3v	5 *
	calma GDS_pplus	7 *
	calma GDS_nplus	8 *
	calma GDS_ct	15 *
	calma GDS_m1	16 *
	calma TXT_m1	40 *
	calma GDS_v12	17 *
	calma GDS_m2	18 *
	calma TXT_m2	41 *
	calma GDS_v23	27 *
	calma GDS_m3	28 *
	calma TXT_m3	42 *
	calma GDS_v34	29 *
	calma GDS_m4	31 *
	calma TXT_m4	43 *
	calma GDS_v45	32 *
	calma GDS_m5	33 *
	calma TXT_m5	44 *
	calma GDS_prb	65 *
	calma GDS_pass	19 *
	calma GDS_sram	20 *
	calma GDS_esd	30 *
	calma GDS_rpo	34 *
	calma GDS_cap	47 *
	calma GDS_psub2	50 *
	calma GDS_res	52 *
	calma GDS_resid	54 *
	calma GDS_excl	55 *
	calma GDS_diodeid	56 *
	calma GDS_compass	57 *
	calma GDS_io	58 *
	calma GDS_vtd	59 *
	calma GDS_drcdum	60 *
	calma GDS_mbound	66 *
	layer space
	labels TXT_text
	calma TXT_text 255 *
end

mzrouter
end

drc
cifstyle mmi25

	width nw 1.2 		"nw minimum width = 1.2 um."

	spacing nw nw 0.6 touching_ok 		"nw minimum spacing = 0.6 um."

	width ndif,nfet 0.3 		"ndif minimum width = 0.3 um."

	spacing ndif,nfet ndif,nfet 0.4 touching_ok 		"ndif minimum spacing = 0.4 um."

	width pdif,pfet 0.3 		"pdif minimum width = 0.3 um."

	spacing pdif,pfet pdif,pfet 0.4 touching_ok 		"pdif minimum spacing = 0.4 um."

	width nwc 0.3 		"nwc minimum width = 0.3 um."

	spacing nwc nwc 0.4 touching_ok 		"nwc minimum spacing = 0.4 um."

	width pwc 0.3 		"pwc minimum width = 0.3 um."

	spacing pwc pwc 0.4 touching_ok 		"pwc minimum spacing = 0.4 um."

	width poly,nfet,pfet 0.24 		"poly minimum width = 0.24 um."

	spacing poly,nfet,pfet poly,nfet,pfet 0.36 touching_ok 		"poly minimum spacing = 0.36 um."

	width n2v 0.44 		"n2v minimum width = 0.44 um."

	spacing n2v n2v 0.44 touching_ok 		"n2v minimum spacing = 0.44 um."

	width n3v 0.44 		"n3v minimum width = 0.44 um."

	spacing n3v n3v 0.44 touching_ok 		"n3v minimum spacing = 0.44 um."

	width pplus 0.44 		"pplus minimum width = 0.44 um."

	spacing pplus pplus 0.44 touching_ok 		"pplus minimum spacing = 0.44 um."

	width nplus 0.44 		"nplus minimum width = 0.44 um."

	spacing nplus nplus 0.44 touching_ok 		"nplus minimum spacing = 0.44 um."

	width ct 0.3 		"ct minimum width = 0.3 um."

	spacing ct ct 0.3 touching_ok 		"ct minimum spacing = 0.3 um."

	width m1 0.32 		"m1 minimum width = 0.32 um."

	spacing m1 m1 0.32 touching_ok 		"m1 minimum spacing = 0.32 um."

	width v12 0.36 		"v12 minimum width = 0.36 um."

	spacing v12 v12 0.35 touching_ok 		"v12 minimum spacing = 0.35 um."

	width m2 0.4 		"m2 minimum width = 0.4 um."

	spacing m2 m2 0.4 touching_ok 		"m2 minimum spacing = 0.4 um."

	width v23 0.36 		"v23 minimum width = 0.36 um."

	spacing v23 v23 0.35 touching_ok 		"v23 minimum spacing = 0.35 um."

	width m3 0.4 		"m3 minimum width = 0.4 um."

	spacing m3 m3 0.4 touching_ok 		"m3 minimum spacing = 0.4 um."

	width v34 0.36 		"v34 minimum width = 0.36 um."

	spacing v34 v34 0.35 touching_ok 		"v34 minimum spacing = 0.35 um."

	width m4 0.4 		"m4 minimum width = 0.4 um."

	spacing m4 m4 0.4 touching_ok 		"m4 minimum spacing = 0.4 um."

	width v45 0.36 		"v45 minimum width = 0.36 um."

	spacing v45 v45 0.35 touching_ok 		"v45 minimum spacing = 0.35 um."

	width m5 0.44 		"m5 minimum width = 0.44 um."

	spacing m5 m5 0.46 touching_ok 		"m5 minimum spacing = 0.46 um."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((ct))/ct ~((ct))/ct       0.09 (m1) ~((ct))/ct 0.09      "m1 minimum enclosure of ct = 0.09 um." m1

    
    edge (m1) ~((m1))/m1       1 ~((ct))/ct 0 1       "m1 minimum enclosure of ct = 0.09 um." ct


	area m1 0.36 0.32 		"m1 minimum area = 0.36 um2."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v12))/v12 ~((v12))/v12       0.09 (m1) ~((v12))/v12 0.09      "m1 minimum enclosure of v12 = 0.09 um." m1

    
    edge (m1) ~((m1))/m1       1 ~((v12))/v12 0 1       "m1 minimum enclosure of v12 = 0.09 um." v12


	spacing v12 nfet,pfet 0.01 touching_illegal 		"v12 to nfet,pfet minimum spacing = 0.01 um."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v12))/v12 ~((v12))/v12       0.09 (m2) ~((v12))/v12 0.09      "m2 minimum enclosure of v12 = 0.09 um." m2

    
    edge (m2) ~((m2))/m2       1 ~((v12))/v12 0 1       "m2 minimum enclosure of v12 = 0.09 um." v12


	area m2 0.36 0.4 		"m2 minimum area = 0.36 um2."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v23))/v23 ~((v23))/v23       0.09 (m2) ~((v23))/v23 0.09      "m2 minimum enclosure of v23 = 0.09 um." m2

    
    edge (m2) ~((m2))/m2       1 ~((v23))/v23 0 1       "m2 minimum enclosure of v23 = 0.09 um." v23


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v23))/v23 ~((v23))/v23       0.09 (m3) ~((v23))/v23 0.09      "m3 minimum enclosure of v23 = 0.09 um." m3

    
    edge (m3) ~((m3))/m3       1 ~((v23))/v23 0 1       "m3 minimum enclosure of v23 = 0.09 um." v23


	area m3 0.36 0.4 		"m3 minimum area = 0.36 um2."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v34))/v34 ~((v34))/v34       0.09 (m3) ~((v34))/v34 0.09      "m3 minimum enclosure of v34 = 0.09 um." m3

    
    edge (m3) ~((m3))/m3       1 ~((v34))/v34 0 1       "m3 minimum enclosure of v34 = 0.09 um." v34


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v34))/v34 ~((v34))/v34       0.09 (m4) ~((v34))/v34 0.09      "m4 minimum enclosure of v34 = 0.09 um." m4

    
    edge (m4) ~((m4))/m4       1 ~((v34))/v34 0 1       "m4 minimum enclosure of v34 = 0.09 um." v34


	area m4 0.36 0.4 		"m4 minimum area = 0.36 um2."

	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v45))/v45 ~((v45))/v45       0.09 (m4) ~((v45))/v45 0.09      "m4 minimum enclosure of v45 = 0.09 um." m4

    
    edge (m4) ~((m4))/m4       1 ~((v45))/v45 0 1       "m4 minimum enclosure of v45 = 0.09 um." v45


	
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v45))/v45 ~((v45))/v45       0.09 (m5) ~((v45))/v45 0.09      "m5 minimum enclosure of v45 = 0.09 um." m5

    
    edge (m5) ~((m5))/m5       1 ~((v45))/v45 0 1       "m5 minimum enclosure of v45 = 0.09 um." v45


	no_overlap	nfet,pfet	nfet,pfet

	exact_overlap	ct,v12,v23,v34,v45

end

extract
style	mmi25
	noplaneordering

	cscale	1
	lambda	1
	step	1000
	sidehalo	0

	resist poly 115
	areacap poly 0.0001
	perimc poly space/active 0.1

	resist m1 115
	areacap m1 0.0001
	perimc m1 space/m1 0.1

	resist m2 115
	areacap m2 0.0001
	perimc m2 space/m2 0.1

	resist m3 115
	areacap m3 0.0001
	perimc m3 space/m3 0.1

	resist m4 115
	areacap m4 0.0001
	perimc m4 space/m4 0.1

	resist m5 115
	areacap m5 0.0001
	perimc m5 space/m5 0.1

	fet nfet ndif 2 nfet GND! 0 0
	fet pfet pdif 2 pfet Vdd! 0 0

end


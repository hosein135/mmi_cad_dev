









































































































































































 






 



























tech
  g18
end

version

	version "g18 13:52:24 Jun 10 1999"
	description "g18 - 5 layer metal 0.18um CMOS process"

end




planes
  ppls		
  npls          
  nw	        
  act           
  v0     	
  m1	        
  v1	        
  m2	        
  v2	        
  m3	        
  v3	        
  m4
  v4	        
  m5
  fdrc           
  pw
  pad


  res
  n2v	
end

types
  ppls	pplus,ppls	        
  npls  nplus,npls	        
  nw	nwell,nw	        

  act	ndiffusion,ndif
  act	pdiffusion,pdif
  act	ntransistor,nfet
  act	ptransistor,pfet
  act	nsubstratencontact,nwc	        
  act	psubstratepcontact,pwc	         
  act	polysilicon,p1

  v0	contact,v0	                

  m1	metal1,m1

  v1	m2contact,v1

  m2	metal2,m2

  v2	m3contact,v2

  m3	metal3,m3

  v3	m4contact,v3

  m4	metal4,m4

  v4	m5contact,v4

  m5	metal5,m5

  fdrc	fdrc

  pw    pwell,pw
  pad   pad


  res   resistor,res
  n2v   n2v	
end




contact
end

styles
    
    n2v         22	
    ppls	27
    npls	28
    nw		26

    
    ndif	3
    pdif	5
    nfet	7
    nfet	8
    pfet	9
    pfet	10
    nwc		4
    pwc		6

    
    p1	2
    	
    
    v0	32	

    
    v1	33
    v1	32	 

    v2	37
    v2	32	 

    v3	38
    v3	32	 

    v4	39
    v4	32	 

    
    m1	12
    m2	13
    m3	17
    m4	16
    m4  20 
    m5  15
    m5  21

    
    error_p	42
    error_s	42
    error_ps	42

    
    fdrc 43

    
    pwel 27
    pad   3


    res  27
end

compose
    
    compose	nfet	p1	ndif
    compose	pfet	p1	pdif
    

    


    paint	ndif	nw	pdif
    paint	nfet	nw	pfet
    paint	pwc	nw	nwc


end






















connect
    ndif,nwc,pdif,pwc		ndif,nwc,pdif,pwc
    p1,nfet,pfet		p1,nfet,pfet

    v0		ndif,nwc,pdif,pwc,nfet,pfet,p1,m1			
    v1		m1,m2
    v2		m2,m3
    v3		m3,m4
    v4		m4,m5
end

cifoutput
























style gen


 


  units .01 .001 .001 .001      	

  charset unrestricted
  iname propattr 102  

  
  templayer NW_DIF pdif,pfet

  layer NW nw


    calma 2 0

  

  layer V0 v0

    
    squares 0 .24 .32  

    calma 15 0

   
  templayer V0_NDIF V0
	and nwc,ndif
  templayer V0_PDIF V0
	and pwc,pdif
  templayer V0_NDIF_G V0_NDIF
    grow .20                      

  

  layer PPLS ppls


    calma 7 0

  

  layer NPLS npls


    calma 8 0






  
  layer PDIF pdif,pfet,pwc
     calma 11 0

  layer NDIF ndif,nfet,nwc
     calma 12 0

  
  layer P1 p1,nfet,pfet
    calma 13 0

  
  layer M1 m1
    calma 16 0

  layer V1 v1

    
    
    squares 0 .28 .28 

    calma 17 0

  layer M2 m2
    calma 18 0

  layer V2 v2

    
    squares 0 .28 .28

    calma 27 0

  layer M3 m3
    calma 28 0

  layer V3 v3

    
    squares 0 .28 .28

    calma 29 0

  layer M4 m4
    calma 31 0

  layer V4 v4

    
    squares 0 .28 .56

    calma 32 0

  layer M5 m5
    calma 33 0

  layer PAD pad
    calma 62 0

   layer M1TXT
	labels m1
	calma 40 0	

   layer M2TXT
	labels m2
	calma 41 0	

   layer M3TXT
	labels m3
	calma 42 0	

   layer M4TXT
	labels m4
	calma 43 0	

   layer M5TXT
	labels m5
	calma 44 0	

  

  
  templayer DRC_NWC nwc

  
  templayer DRC_ALL_PDIF pdif,pwc
  templayer DRC_ALL_PDIF_NO_WC pdif
  templayer DRC_PWC pwc
  templayer DRC_ALL_NDIF ndif,nwc
  templayer DRC_ALL_NDIF_NO_WC ndif
  templayer DRC_NWC nwc
  templayer DRC_ALL_DIF ndif,nwc,pdif,pwc

  	
  templayer DRC_PPOLY p1
     and PPLS
  templayer DRC_NPOLY p1
     and NPLS

  	
  templayer DRC_NFET nfet
  templayer DRC_PFET pfet

  
  templayer DRC_ALL_PLUS_GS PPLS,NPLS
	  grow .05
	  shrink .05

  

  templayer DRC_V0_P1 V0
    and p1
  templayer DRC_V0_ORPHAN V0
    and-not V0_NDIF
    and-not V0_PDIF
    and-not DRC_V0_P1










style direct

 


  units .01 .01 .01 .001      	

  charset unrestricted		
  bbox 	62 0			
  iname 63 0			

  
  layer NW nwel
    labels nwel
    calma 2 0

  
  layer PPLS ppls
     labels ppls	
     calma 3 0

  
  layer NPLS npls
     labels npls	
     calma 6 0

  
  layer NDIF ndif
    labels ndif
    calma 1 0
  layer PDIF pdif
    labels pdif
    calma 2 1
  layer NFET nfet
    labels nfet
    calma 3 1
  layer PFET pfet
    labels pfet
    calma 4 1
  layer NWC nwc
    labels nwc
    calma 5 1
  layer PWC pwc
    labels pwc
    calma 6 1

  
  layer P1 p1
    labels p1
    calma 5 0

  
  layer V0 v0
    calma 7 0

  
  layer M1 m1
    labels m1
    calma 8 0
  layer V1 v1
    calma 9 0
  layer M2 m2
    labels m2
    calma 11 0
  layer V2 v2
    calma 12 0
  layer M3 m3
    labels m3
    calma 14 0
  layer V3 v3
    calma 15 0
  layer M4 m4
    labels m4
    calma 17 0

end





cifinput












style direct
  scalefactor 1

  iname 63 0 		
  ignore BBOX			    

  
  layer nw NW
    labels NW

  
  layer ppls PPLS
     labels PPLS	

  
  layer npls NPLS
     labels NPLS	

  
  layer ndif NDIF
    labels NDIF

  layer pdif PDIF
    labels PDIF

  layer nfet NFET
    labels NFET

  layer pfet PFET
    labels PFET

  layer nwc NWC
    labels NWC

  layer pwc PWC
    labels PWC

  
  layer p1 P1
    labels P1

  
  layer v0 V0

  
  layer m1 M1
    labels M1

  layer v1 V1

  layer m2 M2
    labels M2

  layer v2 V2

  layer m3 M3
    labels M3

  layer v3 V3

  layer m4 M4
    labels M4

  


  calma	NDIF	 1	0
  calma	PDIF	 2	1
  calma	NFET	 3	1
  calma	PFET	 4	1
  calma	NWC	 5	1
  calma	PWC	 6	1


  calma	NW	 2	0
  calma P1	 5	0	
  calma PPLS     3	0
  calma NPLS     6	0
  calma V0       7	*
  calma M1       8	*
  calma V1       9	*
  calma M2      11	*
  calma V2      12	*
  calma M3      14	*
  calma V3      15	*
  calma M4      17	*
  calma BBOX    62      * 










style import_tsmc
  scalefactor 1

  iname propattr 102     















  layer n2v N2V

  layer ppls PPLS
    labels PPLS

  layer npls NPLS
    labels NPLS

  layer nw NW  
    labels NW

  layer p1 P1
    labels P1

  layer ndif NDIF
    and-not NW	
    labels NDIF

  layer pdif PDIF
    and NW	
    labels PDIF

  layer nfet ndif
    and p1

  layer pfet pdif
    and p1

  layer nwc NDIF
    and NW

  layer pwc PDIF
    and-not NW

  layer v0 V0
    labels V0

  layer m1 M1
    labels M1,M1TXT

  layer v1 V1
    labels V1

  layer m2 M2
    labels M2,M2TXT

  layer v2 V2
    labels V2

  layer m3 M3
    labels M3,M3TXT

  layer v3 V3
     labels V3

  layer m4 M4
    labels M4,M4TXT

  layer v4 V4
     labels V4

  layer m5 M5
    labels M5,M5TXT

  layer fdrc FDRC
    labels FDRC	

  layer fdrc FDRC2
    labels FDRC2

  layer pad PAD
    labels PAD 	

  












































  calma N2V      1      *
  calma	NW	 2	*
  calma PPLS     7	*
  calma	NPLS	 8	*
  calma PDIF     11	*
  calma	NDIF	 12	*

  calma P1	 13	*	

  calma V0       15	*
  calma M1       16	*
  calma V1       17	*
  calma M2       18	*
  calma V2       27	*
  calma M3       28	*
  calma V3       29	*
  calma M4       31	*
  calma V4       32	*
  calma M5       33	*

  calma M1TXT    40   	*
  calma M2TXT    41   	*
  calma M3TXT    42   	*
  calma M4TXT    43   	*
  calma M5TXT    44   	*



















  calma PAD    62      * 










style import_ibm
  scalefactor 1

  iname 63 0 		
  ignore BBOX			    

  

  layer ppls PPLS
    labels PPLS

  ignore NPLS






  layer nwel NW  
    labels NW

  layer p1 P1
    labels P1

  layer pdif ACT
    labels ACT
    and PPLS
    and NW

  layer ndif ACT
    labels ACT
    and-not PPLS
    and-not NW

  layer nfet ndif
    and p1

  layer pfet pdif
    and p1

  layer nwc ACT
    labels ACT
    and-not PPLS
    and NW

  layer pwc ACT
    labels ACT
    and PPLS
    and-not NW

  layer v0 V0
    labels CT

  layer m1 M1
    labels M1

  layer v1 V1
    labels V1

  layer m2 M2
    labels M2

  layer v2 V2
    labels V2

  layer m3 M3
    labels M3

  layer v3 V3
     labels V3

  layer m4 M4
    labels M4

  layer pad PAD
    labels PAD

  layer fdrc FDRC
    labels FDRC	

  layer fdrc FDRC2
    labels FDRC2

  
  calma FDRC	 55     *
  calma FDRC2	 56     *
  calma	ACT	 2	*
  calma	NW	 4	*
  calma P1	 7	*	

  calma PPLS    10	*

  calma NPLS     8	*

  calma V0      14	*
  calma M1      15	*
  calma V1      16	*
  calma M2      17	*
  calma V2      18	*
  calma M3      19	*
  calma V3      20	*
  calma M4      25	*
  calma PAD     28	*
  calma BBOX    62      * 
end

drc








cifstyle gen




  




  edge4way p1 ~(p1,pfet,nfet)/act 1 ~(ndif,nwc,pdif,pwc,nfet,pfet)/act ~(nfet,pfet)/act 1     "Non-intersecting poly and DIF may not touch"



  



  
    
    
    
    
    
    
    
    
    
  


  	
  edge4way (((nfet,pfet)))/act ~(((nfet,pfet)))/act 1     ~(((nfet,pfet)))/act ((nfet,pfet)) 1     "FETs must be rectangular"

  edge4way (nfet,pfet)/act ~(nfet,pfet,ndif,pdif,p1)/act 1 0 0 1     "Missing FET overlap"
  edge4way poly (nfet,pfet)/act 1 (ndif,pdif,nfet,pfet)/act     (ndif,nwc,pdif,pwc,nfet,pfet,p1,space)/act 1     "FETs must be formed by crossing poly and dif"
  edge4way ndif,pdif (nfet,pfet)/act 1 (p1,nfet,pfet)/act     (ndif,nwc,pdif,pwc,nfet,pfet,p1,space)/act 1     "FETs must be formed by crossing poly and dif"







  cifwidth NW 1.20     "N-well min width = 1.00 um"

  cifspacing NW NW 1.0 touching_ok     "nwell min spacing = 1.00 um"




  width ndif,nwc,pdif,pwc,nfet,pfet .26     "Diffusion min width = .26 um"

  spacing ndif,nwc,pdif,pwc,nfet,pfet ndif,nwc,pdif,pwc,nfet,pfet .28 touching_ok     "Diffusion minimum spacing = .28 um"

  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_NWC space       .26 NW space .26      "NW minimum enclosure of nwc = 0.26 um" NW

    
    cifedge NW space       1 space 0 1       "NW minimum enclosure of nwc = 0.26 um" DRC_NWC

  
  cifspacing DRC_ALL_NDIF_NO_WC NW .46 touching_illegal     "NW to n-diffusion minimum spacing = .46 um" 

  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way NW_DIF space       .46 NW space .46      "NW minimum enclosure of p-diffusion = 0.46 um" NW

    
    cifedge NW space       1 space 0 1       "NW minimum enclosure of p-diffusion = 0.46 um" NW_DIF


  cifspacing DRC_PWC NW .26 touching_illegal     "NW to pwc minimum spacing = 0.26 um"

  spacing ndif,nwc pdif,pwc .30 touching_illegal     "NDIF/PDIF min spacing = .30 um"









  



  width p1,nfet,pfet .18     "poly min width = .18 um"

  spacing p1,nfet,pfet p1,nfet,pfet .28 touching_ok     "poly min spacing = .28 um"

  edge4way (p1)/act space/act .12 ~(ndif,nwc,pdif,pwc,nfet,pfet)/act     space/act .12     "poly to dif min spacing (when not intersecting) = .12 um"

  edge4way (nfet,pfet)/act (ndif,pdif)/act .30 (ndif,nwc,pdif,pwc,nfet,pfet)/act 0 0     "dif min extension in fet = .30 um"

  edge4way (nfet,pfet)/act p1/act .22 (p1)/act 0 0     "poly min extension in fet = .22 um"


  
    
    
    
    
    
    
    
    
    
  


    

    cifedge space P1       1 DRC_ALL_PLUS_GS 0 1      "poly must be covered by  npls or ppls (except for .1 um gap)" DRC_ALL_PLUS_GS

    
    cifedge DRC_ALL_PLUS_GS space       1 space 0 1       "poly must be covered by  npls or ppls (except for .1 um gap)" P1


  cifspacing DRC_PPOLY DRC_NPOLY .10 touching_illegal     "min spacing between NPLS poly (NPOLY) and PPLS poly (PPOLY) = .1 um"





  cifwidth PPLS .44     "p+ min width = .44 um"

  cifspacing PPLS PPLS .44 touching_ok     "p+ min spacing = .44 um)"
  
  cifspacing PPLS DRC_ALL_NDIF_NO_WC .26 touching_illegal     "p+/ndif min spacing = .26 um"

  cifspacing PPLS DRC_NWC .10 touching_illegal     "p+/nwc min spacing = .10 um"


  cifspacing PPLS DRC_NFET .32 touching_illegal     "p+ to nfet min spacing = .32 um"
  

  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_PFET space       .32 PPLS space .32      "p+ min enclosure of pfet = .32 um" PPLS

    
    cifedge PPLS space       1 space 0 1       "p+ min enclosure of pfet = .32 um" DRC_PFET


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_ALL_PDIF_NO_WC space       .32 PPLS space .32      "p+ min enclosure of pdif = .32 um" PPLS

    
    cifedge PPLS space       1 space 0 1       "p+ min enclosure of pdif = .32 um" DRC_ALL_PDIF_NO_WC


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_PWC space       .08 PPLS space .08      "p+ min enclosure of pwc = .08 um" PPLS

    
    cifedge PPLS space       1 space 0 1       "p+ min enclosure of pwc = .08 um" DRC_PWC




  cifwidth NPLS .44     "n+ min width = .44 um"

  cifspacing NPLS NPLS .44 touching_ok     "n+ min spacing = .44 um)"

  cifspacing NPLS DRC_ALL_PDIF_NO_WC .26 touching_illegal     "n+/pdif min spacing = .26 um"

  cifspacing NPLS DRC_PWC .10 touching_illegal     "n+/pwc min spacing = .10 um"


  cifspacing NPLS DRC_PFET .32 touching_illegal     "n+ to pfet min spacing = .32 um"
  

  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_NFET space       .32 NPLS space .32      "n+ min enclosure of nfet = .32 um" NPLS

    
    cifedge NPLS space       1 space 0 1       "n+ min enclosure of nfet = .32 um" DRC_NFET


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_ALL_NDIF_NO_WC space       .32 NPLS space .32      "n+ min enclosure of ndif = .32 um" NPLS

    
    cifedge NPLS space       1 space 0 1       "n+ min enclosure of ndif = .32 um" DRC_ALL_NDIF_NO_WC


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_NWC space       .08 NPLS space .08      "n+ min enclosure of nwc = .08 um" NPLS

    
    cifedge NPLS space       1 space 0 1       "n+ min enclosure of nwc = .08 um" DRC_NWC


	


  

  width v0 .24     "v0 min width = .24 um"

  spacing v0 v0 .32 touching_ok     "v0 minimum spacing = .32 um"

  cifspacing V0 V0 .32 touching_ok     "V0 minimum spacing = .32 um"

  cifspacing V0_NDIF DRC_NFET .16 touching_illegal     "V0 on dif / fet minimum spacing = .16 um"
  cifspacing V0_PDIF DRC_PFET .16 touching_illegal     "V0 on dif / fet minimum spacing = .16 um"

  cifspacing DRC_V0_P1 DRC_ALL_DIF .18 touching_illegal     "V0 on poly / diffusion minimum spacing = .18 um"

  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way V0_NDIF space       .10 DRC_ALL_DIF space .10      "dif min enclosure of V0 on dif = .10 um" DRC_ALL_DIF

    
    cifedge DRC_ALL_DIF space       1 space 0 1       "dif min enclosure of V0 on dif = .10 um" V0_NDIF


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way V0_PDIF space       .10 DRC_ALL_DIF space .10      "dif min enclosure of V0 on dif = .10 um" DRC_ALL_DIF

    
    cifedge DRC_ALL_DIF space       1 space 0 1       "dif min enclosure of V0 on dif = .10 um" V0_PDIF


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_V0_P1 space       .10 P1 space .10      "poly min enclosure of V0 on poly = .10 um" P1

    
    cifedge P1 space       1 space 0 1       "poly min enclosure of V0 on poly = .10 um" DRC_V0_P1


  
    
    
    
    
    
    
    
    
    
  


  cifedge4way DRC_V0_ORPHAN space 1     0 0 1     "V0 must be over dif or (non-gate) poly"


	



  width m1 .28     "Metal1 min width = .28 um"

  spacing m1 m1 .28 touching_ok     "Metal1 min spacing = .28 um"



  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v0))/v0 ~((v0))/v0       .08 (m1) ~((v0))/v0 .08      "m1 min enclosure of v0 = .08 um" m1

    
    edge (m1) ~((m1))/m1       1 ~((v0))/v0 0 1       "m1 min enclosure of v0 = .08 um" v0





  








  width v1 .28     "v1 min width = .28 um"

  spacing v1 v1 .28 touching_ok     "v1 minimum spacing = .28 um"

  cifspacing V1 V1 .28 touching_ok     "V1 minimum spacing = .28 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v1))/v1 ~((v1))/v1       .08 (m1) ~((v1))/v1 .08      "m1 min enclosure of v1 = .08 um" m1

    
    edge (m1) ~((m1))/m1       1 ~((v1))/v1 0 1       "m1 min enclosure of v1 = .08 um" v1




  width m2 .28     "M2 min width = .28 um" 

  spacing m2 m2 .28 touching_ok     "M2 min spacing = .28 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v1))/v1 ~((v1))/v1       .08 (m2) ~((v1))/v1 .08      "m2 min enclosure of v1 = .08 um" m2

    
    edge (m2) ~((m2))/m2       1 ~((v1))/v1 0 1       "m2 min enclosure of v1 = .08 um" v1






  width v2 .28     "v2 min width = .28 um"

  spacing v2 v2 .28 touching_ok     "v2 minimum spacing = .28 um"

  cifspacing V2 V2 .28 touching_ok     "V2 minimum spacing = .28 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v2))/v2 ~((v2))/v2       .08 (m2) ~((v2))/v2 .08      "m2 min enclosure of v2 = .08 um" m2

    
    edge (m2) ~((m2))/m2       1 ~((v2))/v2 0 1       "m2 min enclosure of v2 = .08 um" v2




  width m3 .28     "m3 min width = .28 um"

  spacing m3 m3 .28 touching_ok     "m3 min spacing = .28 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v2))/v2 ~((v2))/v2       .08 (m3) ~((v2))/v2 .08      "m3 min enclosure of v2 = .08 um" m3

    
    edge (m3) ~((m3))/m3       1 ~((v2))/v2 0 1       "m3 min enclosure of v2 = .08 um" v2






  width v3 .28     "v3 min width = .28 um"

  spacing v3 v3 .28 touching_ok     "v3 minimum spacing = .28 um"

  cifspacing V3 V3 .28 touching_ok     "V3 minimum spacing = .28 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v3))/v3 ~((v3))/v3       .08 (m3) ~((v3))/v3 .08      "m3 min enclosure of v3 = .08 um" m3

    
    edge (m3) ~((m3))/m3       1 ~((v3))/v3 0 1       "m3 min enclosure of v3 = .08 um" v3




  width m4 .28     "m4 min width = .28 um"

  spacing m4 m4 .28 touching_ok     "m4 min spacing = .28 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v3))/v3 ~((v3))/v3       .08 (m4) ~((v3))/v3 .08      "m4 min enclosure of v3 = .08 um" m4

    
    edge (m4) ~((m4))/m4       1 ~((v3))/v3 0 1       "m4 min enclosure of v3 = .08 um" v3







  width v4 .28     "v4 min width = .28 um"

  spacing v4 v4 .56 touching_ok     "v4 minimum spacing = .56 um"

  cifspacing V4 V4 .56 touching_ok     "V4 minimum spacing = .56 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v4))/v4 ~((v4))/v4       .08 (m4) ~((v4))/v4 .08      "m4 min enclosure of v4 = .08 um" m4

    
    edge (m4) ~((m4))/m4       1 ~((v4))/v4 0 1       "m4 min enclosure of v4 = .08 um" v4




  width m5 .56     "m5 min width = .56 um"

  spacing m5 m5 .56 touching_ok     "m5 min spacing = .56 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v4))/v4 ~((v4))/v4       .12 (m5) ~((v4))/v4 .12      "m5 min enclosure of v4 = .12 um" m5

    
    edge (m5) ~((m5))/m5       1 ~((v4))/v4 0 1       "m5 min enclosure of v4 = .12 um" v4










no_overlap	pfet,nfet	pfet,nfet 




exact_overlap v0,v1,v2,v3,v4

end


extract
style lumped
  cscale	10		
  lambda	2	
  step		500
  sidehalo	0	

  noplaneordering

  
  resist ndif,pwc 5659 
  resist pdif,nwc 4505 
  resist poly 5712 
  resist m1 113 
  resist m2 113 
  resist m3 114 
  resist m4 114 
  resist m5 112 

  

  
  fetresist nfet linear  7500  
  fetresist pfet linear 15000 

  





	
  areacap poly 0.059
  perimc poly space,ndif,nwc,pdif,pwc,nfet,pfet 1.234

  areacap m1 0.037
  perimc m1 space/m1 1.4

  areacap m2 0.031
  perimc m2 space/m2 1.4

  areacap m3 0.030
  perimc m3 space/m3 1.4

  areacap m4 0.030
  perimc m4 space/m4 1.4

  areacap m5 0.029
  perimc m5 space/m5 1.4

  


  fet pfet pdif 2 pfet Vdd! nwell 50 7
  fet nfet ndif 2 nfet GND! 50 7
end






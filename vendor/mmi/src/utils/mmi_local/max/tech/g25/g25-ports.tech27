





































































































































































 






 



































tech
  g25
end

version

	version "g25 17:30:34 Sep 13 1999"
	description "g25 = 5 layer metal 0.25um CMOS process"

end




planes
  ppls		
  npls          
  nw	        
  act           
  v0     	
  m1	        
  v1	        
  m2	        
  v2	        
  m3	        
  v3	        
  m4
  v4	        
  m5
  fdrc          
  pw
  pad
  prb	        
  res	
  n2v	
end

types
  ppls	pplus,ppls	        
  npls  nplus,npls	        
  nw	nwell,nw	        

  act	ndiffusion,ndif
  act	pdiffusion,pdif
  act	ntransistor,nfet
  act	ptransistor,pfet
  act	nsubstratencontact,nwc	        
  act	psubstratepcontact,pwc	         
  act	polysilicon,p1

  v0	contact,v0	                

  m1	metal1,m1

  v1	m2contact,v1

  m2	metal2,m2

  v2	m3contact,v2

  m3	metal3,m3

  v3	m4contact,v3

  m4	metal4,m4

  v4	m5contact,v4

  m5	metal5,m5

  fdrc	fdrc

  pw    pwell,pw
  pad   pad
  prb   prb
  res   resistor,res
  n2v   n2v	
end




contact
end

styles
    
    n2v         22	
    ppls	27
    npls	28
    nw		26

    
    ndif	3
    pdif	5
    nfet	7
    nfet	8
    pfet	9
    pfet	10
    nwc		4
    pwc		6

    
    p1	2
    	
    
    v0	32	

    
    v1	33
    v1	32	 

    v2	37
    v2	32	 

    v3	38
    v3	32	 

    v4	39
    v4	32	 

    
    m1	12
    m2	13
    m3	17
    m4	16
    m4  20 
    m5  15
    m5  21

    
    error_p	42
    error_s	42
    error_ps	42

    
    fdrc 43

    
    pwel 27
    pad   3
    prb  27
    res  27
end

compose
    
    compose	nfet	p1	ndif
    compose	pfet	p1	pdif
    

    


    paint	ndif	nw	pdif
    paint	nfet	nw	pfet
    paint	pwc	nw	nwc


end






















connect
    ndif,nwc,pdif,pwc		ndif,nwc,pdif,pwc
    p1,nfet,pfet		p1,nfet,pfet

    v0		ndif,nwc,pdif,pwc,nfet,pfet,p1,m1			
    v1		m1,m2
    v2		m2,m3
    v3		m3,m4
    v4		m4,m5
end

cifoutput










style tsmc
 



  units .02 .001 .001 .001      	


  charset unrestricted
  iname propattr 102  

  
  templayer NW_DIF pdif,pfet

  templayer NWC_G nwc
    grow .16    
  layer NW NW_DIF
    grow .60	  
    or NWC_G      
    or nw	  
    grow .74	  
    shrink .74

    calma 2 0

  

  layer V0 v0

    grow .01	
    
    
    squares 0 .30 .30  

    calma 15 0

   
  templayer V0_NDIF V0
	and nwc,ndif
  templayer V0_PDIF V0
	and pwc,pdif
  templayer V0_NDIF_G V0_NDIF
    grow .20                      

  

  templayer PPLS_V0_G V0_PDIF  
    grow .16
    or pwc
    grow .04		 
  templayer PPLS_NWC_G nwc     
    grow .14                      		
  layer PPLS NW
    or PPLS_V0_G       	
    and-not PPLS_NWC_G 
    or ppls	        	 
    shrink .21	       
    grow .43	       
    shrink .22

    calma 7 0

  

  templayer NPLS_V0_G V0_NDIF  
    grow .16
    or nwc
    grow .04	 
  templayer NPLS_PWC_G pwc     
    grow .14  
  templayer NPLS_PPLS_G PPLS   
    grow .10	
  templayer NPLS_POLY_G p1
	grow .10               
  layer NPLS ndif,nfet
    grow .60	
    or NPLS_POLY_G
    grow .74
    shrink .74	         
    and-not NPLS_PPLS_G  
    or NPLS_V0_G         	
    and-not NPLS_PWC_G   
    and-not PPLS	
    or npls	           	
    grow .22	         
    shrink .22

    calma 8 0






  
  layer PDIF pdif,pfet,pwc
     calma 11 0

  layer NDIF ndif,nfet,nwc
     calma 12 0

  
  layer P1 p1,nfet,pfet
    calma 13 0

  
  layer M1 m1
    calma 16 0

  layer V1 v1

    
    
    squares 0 .36 .36 

    calma 17 0

  layer M2 m2
    calma 18 0

  layer V2 v2

    
    
    squares 0 .36 .36

    calma 27 0

  layer M3 m3
    calma 28 0

  layer V3 v3

    
    
    squares 0 .36 .36

    calma 29 0

  layer M4 m4
    calma 31 0

  layer V4 v4

    
    
    squares 0 .36 .36

    calma 32 0

  layer M5 m5
    calma 33 0

  layer PAD pad
    calma 62 0

  layer PRB prb
    calma 61 0

   layer M1TXT
	labels m1
	calma 40 0	

   layer M2TXT
	labels m2
	calma 41 0	

   layer M3TXT
	labels m3
	calma 42 0	

   layer M4TXT
	labels m4
	calma 43 0	

   layer M5TXT
	labels m5
	calma 44 0	








style mmi25
  units .02 .001 .001 .001      	

  charset unrestricted
  iname propattr 102 

  
  templayer NW_DIF pdif,pfet

  templayer NWC_G nwc
    grow .16    
  layer NW NW_DIF
    grow .60	  
    or NWC_G      
    or nw	  
    grow .74	  
    shrink .74

    calma 2 0

  

  layer V0 v0

    grow .01	
    
    
    squares 0 .30 .30  

    calma 15 0

   
  templayer V0_NDIF V0
	and nwc,ndif
  templayer V0_PDIF V0
	and pwc,pdif
  templayer V0_NDIF_G V0_NDIF
    grow .20                      

  

  templayer PPLS_V0_G V0_PDIF  
    grow .16
    or pwc
    grow .04		 
  templayer PPLS_NWC_G nwc     
    grow .14                      		
  layer PPLS NW
    or PPLS_V0_G       	
    and-not PPLS_NWC_G 
    or ppls	        	 
    shrink .21	       
    grow .43	       
    shrink .22

    calma 7 0

  

  templayer NPLS_V0_G V0_NDIF  
    grow .16
    or nwc
    grow .04	 
  templayer NPLS_PWC_G pwc     
    grow .14  
  templayer NPLS_PPLS_G PPLS   
    grow .10	
  templayer NPLS_POLY_G p1
	grow .10               
  layer NPLS ndif,nfet
    grow .60	
    or NPLS_POLY_G
    grow .74
    shrink .74	         
    and-not NPLS_PPLS_G  
    or NPLS_V0_G         	
    and-not NPLS_PWC_G   
    and-not PPLS	
    or npls	           	
    grow .22	         
    shrink .22

    calma 8 0






  
  layer ACT pdif,pfet,pwc,ndif,nfet,nwc
     calma 4 0

  
  layer P1 p1,nfet,pfet
    calma 13 0

  
  layer M1 m1
    calma 16 0

  layer V1 v1

    
    
    squares 0 .36 .36 

    calma 17 0

  layer M2 m2
    calma 18 0

  layer V2 v2

    
    
    squares 0 .36 .36

    calma 27 0

  layer M3 m3
    calma 28 0

  layer V3 v3

    
    
    squares 0 .36 .36

    calma 29 0

  layer M4 m4
    calma 31 0

  layer V4 v4

    
    
    squares 0 .36 .36

    calma 32 0

  layer M5 m5
    calma 33 0

  layer PAD pad
    calma 62 0


  layer PRB prb,res
    calma 65 0

   layer M1TXT
	labels m1
	calma 40 0	
	port 40 0 comment
	port 40 1 hidden
	port 40 2 local
	port 40 3 global
	port 40 4 input
	port 40 5 output
	port 40 6 inout

   layer M2TXT
	labels m2
	calma 41 0	
	port 41 0 comment
	port 41 1 hidden
	port 41 2 local
	port 41 3 global
	port 41 4 input
	port 41 5 output
	port 41 6 inout

   layer M3TXT
	labels m3
	calma 42 0	
	port 42 0 comment
	port 42 1 hidden
	port 42 2 local
	port 42 3 global
	port 42 4 input
	port 42 5 output
	port 42 6 inout

   layer M4TXT
	labels m4
	calma 43 0	
	port 43 0 comment
	port 43 1 hidden
	port 43 2 local
	port 43 3 global
	port 43 4 input
	port 43 5 output
	port 43 6 inout

   layer M5TXT
	labels m5
	calma 44 0	
	port 44 0 comment
	port 44 1 hidden
	port 44 2 local
	port 44 3 global
	port 44 4 input
	port 44 5 output
	port 44 6 inout

























style gen


 



  units .02 .001 .001 .001      	


  
  templayer NW_DIF pdif,pfet

  templayer NWC_G nwc
    grow .16    
  layer NW NW_DIF
    grow .60	  
    or NWC_G      
    or nw	  
    grow .74	  
    shrink .74

    labels nwel
    calma 2 1


  
  layer V0 v0

    grow .01	
    
    
    squares 0 .30 .30  

    calma 7 1

   
  templayer V0_NDIF V0
	and nwc,ndif
  templayer V0_PDIF V0
	and pwc,pdif
  templayer V0_NDIF_G V0_NDIF
    grow .20                      

  

  templayer PPLS_V0_G V0_PDIF  
    grow .16
    or pwc
    grow .04		 
  templayer PPLS_NWC_G nwc     
    grow .14                      		
  layer PPLS NW
    or PPLS_V0_G       	
    and-not PPLS_NWC_G 
    or ppls	        	 
    shrink .21	       
    grow .43	       
    shrink .22

    labels ppls
    calma 3 1

  

  templayer NPLS_V0_G V0_NDIF  
    grow .16
    or nwc
    grow .04	 
  templayer NPLS_PWC_G pwc     
    grow .14  
  templayer NPLS_PPLS_G PPLS   
    grow .10	
  templayer NPLS_POLY_G p1
	grow .10               
  layer NPLS ndif,nfet
    grow .60	
    or NPLS_POLY_G
    grow .74
    shrink .74	         
    and-not NPLS_PPLS_G  
    or NPLS_V0_G         	
    and-not NPLS_PWC_G   
    and-not PPLS	
    or npls	           	
    grow .22	         
    shrink .22

    labels npls
    calma 6 1

  
  layer ACT ndif,nwc,pdif,pwc,nfet,pfet
    labels ndif,nwc,pdif,pwc,nfet,pfet
     calma 1 1

  
  layer P1 p1,nfet,pfet
    labels p1,nfet,pfet
    calma 5 1

  
  layer M1 m1
    labels m1
    calma 8 1

  layer V1 v1

    
    
    squares 0 .36 .36 

    calma 9 1

  layer M2 m2
    labels m2
    calma 11 1

  layer V2 v2

    
    
    squares 0 .36 .36

    calma 12 1

  layer M3 m3
    labels m3
    calma 14 1

  layer V3 v3

    
    
    squares 0 .36 .36

    calma 15 1

  layer M4 m4
    labels m4
    calma 17 1

  layer V4 v4

    
    
    squares 0 .36 .36

    calma 32 0

  
  layer M5 m5
    labels m5
    calma 33 0

  

  
  templayer DRC_NWC nwc

  
  templayer DRC_ALL_PDIF pdif,pwc
  templayer DRC_ALL_PDIF_NO_WC pdif
  templayer DRC_PWC pwc
  templayer DRC_ALL_NDIF ndif,nwc
  templayer DRC_ALL_NDIF_NO_WC ndif
  templayer DRC_NWC nwc
  templayer DRC_ALL_DIF ndif,nwc,pdif,pwc

  	
  templayer DRC_PPOLY p1
     and PPLS
  templayer DRC_NPOLY p1
     and NPLS

  	
  templayer DRC_NFET nfet
  templayer DRC_PFET pfet

  
  templayer DRC_ALL_PLUS_GS PPLS,NPLS
	  grow .05
	  shrink .05

  

  templayer DRC_V0_P1 V0
    and p1
  templayer DRC_V0_ORPHAN V0
    and-not V0_NDIF
    and-not V0_PDIF
    and-not DRC_V0_P1











style direct

 



  units .02 .01 .01 .001      	


  charset unrestricted		
  bbox 	62 0			
  iname 63 0			

  
  layer NW nwel
    labels nwel
    calma 2 0

  
  layer PPLS ppls
     labels ppls	
     calma 3 0

  
  layer NPLS npls
     labels npls	
     calma 6 0

  
  layer NDIF ndif
    labels ndif
    calma 1 0
  layer PDIF pdif
    labels pdif
    calma 2 1
  layer NFET nfet
    labels nfet
    calma 3 1
  layer PFET pfet
    labels pfet
    calma 4 1
  layer NWC nwc
    labels nwc
    calma 5 1
  layer PWC pwc
    labels pwc
    calma 6 1

  
  layer P1 p1
    labels p1
    calma 5 0

  
  layer V0 v0
    calma 7 0

  
  layer M1 m1
    labels m1
    calma 8 0
  layer V1 v1
    calma 9 0
  layer M2 m2
    labels m2
    calma 11 0
  layer V2 v2
    calma 12 0
  layer M3 m3
    labels m3
    calma 14 0
  layer V3 v3
    calma 15 0
  layer M4 m4
    labels m4
    calma 17 0

end





cifinput









style import_tsmc

  scalefactor 2

  iname propattr 102     



  layer n2v N2V

  layer ppls PPLS
    labels PPLS

  layer npls NPLS
    labels NPLS

  layer nw NW  
    labels NW

  layer p1 P1
    labels P1

  layer ndif NDIF
    and-not NW	
    labels NDIF

  layer pdif PDIF
    and NW	
    labels PDIF

  layer nfet ndif
    and p1

  layer pfet pdif
    and p1

  layer nwc NDIF
    and NW

  layer pwc PDIF
    and-not NW

  layer v0 V0
    labels V0

  layer m1 M1
    labels M1,M1TXT

  layer v1 V1
    labels V1

  layer m2 M2
    labels M2,M2TXT

  layer v2 V2
    labels V2

  layer m3 M3
    labels M3,M3TXT

  layer v3 V3
     labels V3

  layer m4 M4
    labels M4,M4TXT

  layer v4 V4
     labels V4

  layer m5 M5
    labels M5,M5TXT

  layer fdrc FDRC
    labels FDRC	

  layer fdrc FDRC2
    labels FDRC2

  layer pad PAD
    labels PAD 	

  layer prb PRB
    labels PRB

  

  calma N2V      1      *
  calma	NW	 2	*
  calma PPLS     7	*
  calma	NPLS	 8	*
  calma PDIF     11	*
  calma	NDIF	 12	*

  calma P1	 13	*	

  calma V0       15	*
  calma M1       16	*
  calma V1       17	*
  calma M2       18	*
  calma V2       27	*
  calma M3       28	*
  calma V3       29	*
  calma M4       31	*
  calma V4       32	*
  calma M5       33	*

  calma M1TXT    40   	*
  calma M2TXT    41   	*
  calma M3TXT    42   	*
  calma M4TXT    43   	*
  calma M5TXT    44   	*

  calma PAD      62     * 
  calma PRB      61     * 












style direct

  scalefactor 2

  iname 63 0 		
  ignore BBOX			    

  
  layer nw NW
    labels NW

  
  layer ppls PPLS
     labels PPLS	

  
  layer npls NPLS
     labels NPLS	

  
  layer ndif NDIF
    labels NDIF

  layer pdif PDIF
    labels PDIF

  layer nfet NFET
    labels NFET

  layer pfet PFET
    labels PFET

  layer nwc NWC
    labels NWC

  layer pwc PWC
    labels PWC

  
  layer p1 P1
    labels P1

  
  layer v0 V0

  
  layer m1 M1
    labels M1

  layer v1 V1

  layer m2 M2
    labels M2

  layer v2 V2

  layer m3 M3
    labels M3

  layer v3 V3

  layer m4 M4
    labels M4

  


  calma	NDIF	 1	0
  calma	PDIF	 2	1
  calma	NFET	 3	1
  calma	PFET	 4	1
  calma	NWC	 5	1
  calma	PWC	 6	1


  calma	NW	 2	0
  calma P1	 5	0	
  calma PPLS     3	0
  calma NPLS     6	0
  calma V0       7	*
  calma M1       8	*
  calma V1       9	*
  calma M2      11	*
  calma V2      12	*
  calma M3      14	*
  calma V3      15	*
  calma M4      17	*
  calma BBOX    62      * 
end

mzrouter
end

drc








cifstyle gen




  




  edge4way p1 ~(p1,pfet,nfet)/act 1 ~(ndif,nwc,pdif,pwc,nfet,pfet)/act ~(nfet,pfet)/act 1     "Non-intersecting poly and DIF may not touch"



  



  
    
    
    
    
    
    
    
    
    
  


  	
  edge4way (((nfet,pfet)))/act ~(((nfet,pfet)))/act 1     ~(((nfet,pfet)))/act ((nfet,pfet)) 1     "FETs must be rectangular"

  edge4way (nfet,pfet)/act ~(nfet,pfet,ndif,pdif,p1)/act 1 0 0 1     "Missing FET overlap"
  edge4way poly (nfet,pfet)/act 1 (ndif,pdif,nfet,pfet)/act     (ndif,nwc,pdif,pwc,nfet,pfet,p1,space)/act 1     "FETs must be formed by crossing poly and dif"
  edge4way ndif,pdif (nfet,pfet)/act 1 (p1,nfet,pfet)/act     (ndif,nwc,pdif,pwc,nfet,pfet,p1,space)/act 1     "FETs must be formed by crossing poly and dif"







  cifwidth NW 1.20     "N-well min width = 1.20 um"

  cifspacing NW NW .60 touching_ok     "nwell min spacing = .60 um"




  width ndif,nwc,pdif,pwc,nfet,pfet .30     "Diffusion min width = .30 um"

  spacing ndif,nwc,pdif,pwc,nfet,pfet ndif,nwc,pdif,pwc,nfet,pfet .40 touching_ok     "Diffusion minimum spacing = .40 um"

  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_NWC space       .16 NW space .16      "NW minimum enclosure of nwc = 0.16 um" NW

    
    cifedge NW space       1 space 0 1       "NW minimum enclosure of nwc = 0.16 um" DRC_NWC

  
  cifspacing DRC_ALL_NDIF_NO_WC NW .60 touching_illegal     "NW to n-diffusion minimum spacing = .60 um" 

  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way NW_DIF space       .60 NW space .60      "NW minimum enclosure of p-diffusion = 0.60 um" NW

    
    cifedge NW space       1 space 0 1       "NW minimum enclosure of p-diffusion = 0.60 um" NW_DIF


  cifspacing DRC_PWC NW .16 touching_illegal     "NW to pwc minimum spacing = 0.16 um"

  cifspacing DRC_NPOLY DRC_ALL_PDIF .33 touching_illegal     "npoly to pdif min spacing = .33 um"

  cifspacing DRC_PPOLY DRC_ALL_NDIF .33 touching_illegal     "ppoly to ndif min spacing = .33 um"

  

  spacing ndif,nwc pdif,pwc .40 touching_illegal     "NDIF/PDIF min spacing = .40 um"



  width p1,nfet,pfet .24     "poly min width = .24 um"

  spacing nfet,pfet nfet,pfet .40 touching_ok     "gate/gate min spacing = .40 um"

  spacing p1,nfet,pfet p1,nfet,pfet .36 touching_ok     "poly min spacing = .36 um"

  edge4way (p1)/act space/act .14 ~(ndif,nwc,pdif,pwc,nfet,pfet)/act     space/act .14     "poly to dif min spacing (when not intersecting) = .14 um"

  edge4way (nfet,pfet)/act (ndif,pdif)/act .44 (ndif,nwc,pdif,pwc,nfet,pfet)/act 0 0     "dif min extension in fet = .44 um"

  edge4way (nfet,pfet)/act p1/act .36 (p1)/act 0 0     "poly min extension in fet = .36 um"

  
    
    
    
    
    
    
    
    
    
  


    

    cifedge space P1       1 DRC_ALL_PLUS_GS 0 1      "poly must be covered by  npls or ppls (except for .1 um gap)" DRC_ALL_PLUS_GS

    
    cifedge DRC_ALL_PLUS_GS space       1 space 0 1       "poly must be covered by  npls or ppls (except for .1 um gap)" P1


  cifspacing DRC_PPOLY DRC_NPOLY .10 touching_illegal     "min spacing between NPLS poly (NPOLY) and PPLS poly (PPOLY) = .1 um"
  





  cifwidth PPLS .44     "p+ min width = .44 um"

  cifspacing PPLS PPLS .44 touching_ok     "p+ min spacing = .44 um)"
  
  cifspacing PPLS DRC_ALL_NDIF_NO_WC .30 touching_illegal     "p+/ndif min spacing = .30 um"

  cifspacing PPLS DRC_NWC .14 touching_illegal     "p+/nwc min spacing = .14 um"

  cifspacing PPLS DRC_NFET .33 touching_illegal     "p+ to nfet min spacing = .33 um"
  
  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_PFET space       .33 PPLS space .33      "p+ min enclosure of pfet = .33 um" PPLS

    
    cifedge PPLS space       1 space 0 1       "p+ min enclosure of pfet = .33 um" DRC_PFET


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_ALL_PDIF_NO_WC space       .26 PPLS space .26      "p+ min enclosure of pdif = .26 um" PPLS

    
    cifedge PPLS space       1 space 0 1       "p+ min enclosure of pdif = .26 um" DRC_ALL_PDIF_NO_WC


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_PWC space       .04 PPLS space .04      "p+ min enclosure of pwc = .04 um" PPLS

    
    cifedge PPLS space       1 space 0 1       "p+ min enclosure of pwc = .04 um" DRC_PWC




  cifwidth NPLS .44     "n+ min width = .44 um"

  cifspacing NPLS NPLS .44 touching_ok     "n+ min spacing = .44 um)"

  cifspacing NPLS DRC_ALL_PDIF_NO_WC .30 touching_illegal     "n+/pdif min spacing = .30 um"

  cifspacing NPLS DRC_PWC .14 touching_illegal     "n+/pwc min spacing = .14 um"

  cifspacing NPLS DRC_PFET .33 touching_illegal     "n+ to pfet min spacing = .33 um"
  
  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_NFET space       .33 NPLS space .33      "n+ min enclosure of nfet = .33 um" NPLS

    
    cifedge NPLS space       1 space 0 1       "n+ min enclosure of nfet = .33 um" DRC_NFET


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_ALL_NDIF_NO_WC space       .26 NPLS space .26      "n+ min enclosure of ndif = .26 um" NPLS

    
    cifedge NPLS space       1 space 0 1       "n+ min enclosure of ndif = .26 um" DRC_ALL_NDIF_NO_WC


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_NWC space       .04 NPLS space .04      "n+ min enclosure of nwc = .04 um" NPLS

    
    cifedge NPLS space       1 space 0 1       "n+ min enclosure of nwc = .04 um" DRC_NWC


	


  

  width v0 .28     "v0 min width = .28 um"

  spacing v0 v0 .32 touching_ok     "v0 minimum spacing = .30 um"

  cifspacing V0 V0 .30 touching_ok     "V0 minimum spacing = .30 um"

  cifspacing V0_NDIF DRC_NFET .22 touching_illegal     "V0 on dif / fet minimum spacing = .22 um"
  cifspacing V0_PDIF DRC_PFET .22 touching_illegal     "V0 on dif / fet minimum spacing = .22 um"

  cifspacing DRC_V0_P1 DRC_ALL_DIF .30 touching_illegal     "V0 on poly / diffusion minimum spacing = .30 um"

  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way V0_NDIF space       .14 DRC_ALL_DIF space .14      "dif min enclosure of V0 on dif = .14 um" DRC_ALL_DIF

    
    cifedge DRC_ALL_DIF space       1 space 0 1       "dif min enclosure of V0 on dif = .14 um" V0_NDIF


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way V0_PDIF space       .14 DRC_ALL_DIF space .14      "dif min enclosure of V0 on dif = .14 um" DRC_ALL_DIF

    
    cifedge DRC_ALL_DIF space       1 space 0 1       "dif min enclosure of V0 on dif = .14 um" V0_PDIF


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way DRC_V0_P1 space       .14 P1 space .14      "poly min enclosure of V0 on poly = .14 um" P1

    
    cifedge P1 space       1 space 0 1       "poly min enclosure of V0 on poly = .14 um" DRC_V0_P1


  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way V0_PDIF space       .20 PPLS space .20      "min enclosure of p-diffusion contact by PPLS = .20 um" PPLS

    
    cifedge PPLS space       1 space 0 1       "min enclosure of p-diffusion contact by PPLS = .20 um" V0_PDIF

  
    
    
    
    
    
    
    
    
    
  


    
    cifedge4way V0_NDIF space       .20 NPLS space .20      "min enclosure of n-diffusion contact by NPLS = .20 um" NPLS

    
    cifedge NPLS space       1 space 0 1       "min enclosure of n-diffusion contact by NPLS = .20 um" V0_NDIF


  
    
    
    
    
    
    
    
    
    
  


  cifedge4way DRC_V0_ORPHAN space 1     0 0 1     "V0 must be over dif or (non-gate) poly"


	



  width m1 .32     "Metal1 min width = .32 um"

  spacing m1 m1 .32 touching_ok     "Metal1 min spacing = .32 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v0))/v0 ~((v0))/v0       .10 (m1) ~((v0))/v0 .10      "m1 min enclosure of v0 = .10 um" m1

    
    edge (m1) ~((m1))/m1       1 ~((v0))/v0 0 1       "m1 min enclosure of v0 = .10 um" v0



  
  area m1 .36 .32 "Metal1 min area = .36 um2."


  








  width v1 .36     "v1 min width = .36 um"

  spacing v1 v1 .36 touching_ok     "v1 minimum spacing = .35 um"

  cifspacing V1 V1 .35 touching_ok     "V1 minimum spacing = .35 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v1))/v1 ~((v1))/v1       .10 (m1) ~((v1))/v1 .10      "m1 min enclosure of v1 = .10 um" m1

    
    edge (m1) ~((m1))/m1       1 ~((v1))/v1 0 1       "m1 min enclosure of v1 = .10 um" v1




  width m2 .40     "M2 min width = .40 um" 

  spacing m2 m2 .40 touching_ok     "M2 min spacing = .40 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v1))/v1 ~((v1))/v1       .10 (m2) ~((v1))/v1 .10      "m2 min enclosure of v1 = .10 um" m2

    
    edge (m2) ~((m2))/m2       1 ~((v1))/v1 0 1       "m2 min enclosure of v1 = .10 um" v1



  
 area m2 .36 .40  "Metal2 min area = .36 um2."




  width v2 .36     "v2 min width = .36 um"

  spacing v2 v2 .36 touching_ok     "v2 minimum spacing = .35 um"

  cifspacing V2 V2 .35 touching_ok     "V2 minimum spacing = .35 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v2))/v2 ~((v2))/v2       .10 (m2) ~((v2))/v2 .10      "m2 min enclosure of v2 = .10 um" m2

    
    edge (m2) ~((m2))/m2       1 ~((v2))/v2 0 1       "m2 min enclosure of v2 = .10 um" v2




  width m3 .40     "m3 min width = .40 um"

  spacing m3 m3 .40 touching_ok     "m3 min spacing = .40 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v2))/v2 ~((v2))/v2       .10 (m3) ~((v2))/v2 .10      "m3 min enclosure of v2 = .10 um" m3

    
    edge (m3) ~((m3))/m3       1 ~((v2))/v2 0 1       "m3 min enclosure of v2 = .10 um" v2



  
  area m3 .36 .40  "m3 min area = .36 um2."




  width v3 .36     "v3 min width = .36 um"

  spacing v3 v3 .36 touching_ok     "v3 minimum spacing = .35 um"

  cifspacing V3 V3 .35 touching_ok     "V3 minimum spacing = .35 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v3))/v3 ~((v3))/v3       .10 (m3) ~((v3))/v3 .10      "m3 min enclosure of v3 = .10 um" m3

    
    edge (m3) ~((m3))/m3       1 ~((v3))/v3 0 1       "m3 min enclosure of v3 = .10 um" v3




  width m4 .40     "m4 min width = .40 um"

  spacing m4 m4 .40 touching_ok     "m4 min spacing = .40 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v3))/v3 ~((v3))/v3       .10 (m4) ~((v3))/v3 .10      "m4 min enclosure of v3 = .10 um" m4

    
    edge (m4) ~((m4))/m4       1 ~((v3))/v3 0 1       "m4 min enclosure of v3 = .10 um" v3



  
  area m4 .36 .40  "Metal4 min area = .36 um2."





  width v4 .36     "v4 min width = .36 um"

  spacing v4 v4 .36 touching_ok     "v4 minimum spacing = .35 um"

  cifspacing V4 V4 .35 touching_ok     "V4 minimum spacing = .35 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v4))/v4 ~((v4))/v4       .10 (m4) ~((v4))/v4 .10      "m4 min enclosure of v4 = .10 um" m4

    
    edge (m4) ~((m4))/m4       1 ~((v4))/v4 0 1       "m4 min enclosure of v4 = .10 um" v4




  width m5 .44     "m5 min width = .44 um"

  spacing m5 m5 .46 touching_ok     "m5 min spacing = .46 um"

  
    
    
    
    
    
    
    
    
    
  


    
    edge4way ((v4))/v4 ~((v4))/v4       .10 (m5) ~((v4))/v4 .10      "m5 min enclosure of v4 = .10 um" m5

    
    edge (m5) ~((m5))/m5       1 ~((v4))/v4 0 1       "m5 min enclosure of v4 = .10 um" v4







no_overlap	pfet,nfet	pfet,nfet 




exact_overlap v0,v1,v2,v3,v4

end

extract
style lumped
  cscale	10		
  lambda	2	
  step		500
  sidehalo	0	

  noplaneordering

  
  resist ndif,pwc 5659 
  resist pdif,nwc 4505 
  resist poly 5712 
  resist m1 113 
  resist m2 113 
  resist m3 114 
  resist m4 114 
  resist m5 112 

  

  
  fetresist nfet linear  7500  
  fetresist pfet linear 15000 

  





	
  areacap poly 0.059
  perimc poly space,ndif,nwc,pdif,pwc,nfet,pfet 1.234

  areacap m1 0.037
  perimc m1 space/m1 1.4

  areacap m2 0.031
  perimc m2 space/m2 1.4

  areacap m3 0.030
  perimc m3 space/m3 1.4

  areacap m4 0.030
  perimc m4 space/m4 1.4

  areacap m5 0.029
  perimc m5 space/m5 1.4

  


  fet pfet pdif 2 pfet Vdd! nwell 50 7
  fet nfet ndif 2 nfet GND! 50 7
end






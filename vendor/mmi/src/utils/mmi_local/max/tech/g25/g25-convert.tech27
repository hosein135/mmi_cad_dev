




































































































































































 






 








tech
  g25
end

version
	version "g25-convert 13:10:10 Oct  6 1999"
	description "g25-convert"
end




planes
  ppls		
  npls          
  nw	        
  act           
  v0     	
  m1	        
  v1	        
  m2	        
  v2	        
  m3	        
  v3	        
  m4
  v4	        
  m5
  fdrc          
  pw
  pad
  prb	        
  res	
  n2v	
end

types
  ppls	pplus,ppls	        
  npls  nplus,npls	        
  nw	nwell,nw	        

  act	ndiffusion,ndif
  act	pdiffusion,pdif
  act	ntransistor,nfet
  act	ptransistor,pfet
  act	nsubstratencontact,nwc	        
  act	psubstratepcontact,pwc	         
  act	polysilicon,p1

  v0	contact,v0	                

  m1	metal1,m1

  v1	m2contact,v1

  m2	metal2,m2

  v2	m3contact,v2

  m3	metal3,m3

  v3	m4contact,v3

  m4	metal4,m4

  v4	m5contact,v4

  m5	metal5,m5

  fdrc	fdrc

  pw    pwell,pw
  pad   pad
  prb   prb
  res   resistor,res
  n2v   n2v	
end




contact
end

styles
    
    n2v         22	
    ppls	27
    npls	28
    nw		26

    
    ndif	3
    pdif	5
    nfet	7
    nfet	8
    pfet	9
    pfet	10
    nwc		4
    pwc		6

    
    p1	2
    	
    
    v0	32	

    
    v1	33
    v1	32	 

    v2	37
    v2	32	 

    v3	38
    v3	32	 

    v4	39
    v4	32	 

    
    m1	12
    m2	13
    m3	17
    m4	16
    m4  20 
    m5  15
    m5  21

    
    error_p	42
    error_s	42
    error_ps	42

    
    fdrc 43

    
    pwel 27
    pad   3
    prb  27
    res  27
end

compose
    
    compose	nfet	p1	ndif
    compose	pfet	p1	pdif
    

    


    paint	ndif	nw	pdif
    paint	nfet	nw	pfet
    paint	pwc	nw	nwc


end






















connect
    ndif,nwc,pdif,pwc		ndif,nwc,pdif,pwc
    p1,nfet,pfet		p1,nfet,pfet

    v0		ndif,nwc,pdif,pwc,nfet,pfet,p1,m1			
    v1		m1,m2
    v2		m2,m3
    v3		m3,m4
    v4		m4,m5
end

cifoutput
style to_mmi25
  units .02 .001 .001 .001      	

  charset unrestricted
  iname propattr 102  

  

  layer NW nw
    polygons nw
    calma 2 0

  

  layer V0 v0
    grow .01	
    
    
    squares 0 .30 .30  
    calma 15 0

  
  layer PPLS ppls
    polygons ppls
    calma 7 0

  
  layer NPLS npls
    polygons npls
    calma 8 0

  
  layer NDIF ndif,nfet
     polygons ndif,nfet
     calma 11 0

  layer PDIF pdif,pfet
     polygons pdif,pfet
     calma 12 0

  layer NWC nwc
     polygons nwc
     calma 90 0

  layer PWC pwc
     polygons pwc
     calma 91 0

  
  layer P1 p1,nfet,pfet
    polygons p1,nfet,pfet
    calma 13 0
	port 13 0 comment
	port 13 1 hidden
	port 13 2 local
	port 13 3 global
	port 13 4 input
	port 13 5 output
	port 13 6 inout



  
  layer M1 m1
    polygons m1
    calma 16 0

  layer V1 v1
    
    
    squares 0 .36 .36 
    calma 17 0

  layer M2 m2
    polygons m2
    calma 18 0

  layer V2 v2
    
    
    squares 0 .36 .36
    calma 27 0

  layer M3 m3
    polygons m3
    calma 28 0

  layer V3 v3
    
    
    squares 0 .36 .36
    calma 29 0

  layer M4 m4
    polygons m4
    calma 31 0

  layer V4 v4
    
    
    squares 0 .36 .36
    calma 32 0

  layer M5 m5
    polygons m5
    calma 33 0

  layer PAD pad
    polygons pad
    calma 62 0

  layer PRB prb,res
    calma 65 0

   layer M1TXT
	labels m1
	calma 40 0	
	port 40 0 comment
	port 40 1 hidden
	port 40 2 local
	port 40 3 global
	port 40 4 input
	port 40 5 output
	port 40 6 inout

   layer M2TXT
	labels m2
	calma 41 0	
	port 41 0 comment
	port 41 1 hidden
	port 41 2 local
	port 41 3 global
	port 41 4 input
	port 41 5 output
	port 41 6 inout


   layer M3TXT
	labels m3
	calma 42 0	
	port 42 0 comment
	port 42 1 hidden
	port 42 2 local
	port 42 3 global
	port 42 4 input
	port 42 5 output
	port 42 6 inout

   layer M4TXT
	labels m4
	calma 43 0	
	port 43 0 comment
	port 43 1 hidden
	port 43 2 local
	port 43 3 global
	port 43 4 input
	port 43 5 output
	port 43 6 inout


   layer M5TXT
	labels m5
	calma 44 0	
	port 44 0 comment
	port 44 1 hidden
	port 44 2 local
	port 44 3 global
	port 44 4 input
	port 44 5 output
	port 44 6 inout

   layer SPACE
	labels space
	calma 255 0


end





cifinput









style import_tsmc

  scalefactor 2

  iname propattr 102     



  layer n2v N2V

  layer ppls PPLS
    labels PPLS

  layer npls NPLS
    labels NPLS

  layer nw NW  
    labels NW

  layer p1 P1
    labels P1

  layer ndif NDIF
    and-not NW	
    labels NDIF

  layer pdif PDIF
    and NW	
    labels PDIF

  layer nfet ndif
    and p1

  layer pfet pdif
    and p1

  layer nwc NDIF
    and NW

  layer pwc PDIF
    and-not NW

  layer v0 V0
    labels V0

  layer m1 M1
    labels M1,M1TXT

  layer v1 V1
    labels V1

  layer m2 M2
    labels M2,M2TXT

  layer v2 V2
    labels V2

  layer m3 M3
    labels M3,M3TXT

  layer v3 V3
     labels V3

  layer m4 M4
    labels M4,M4TXT

  layer v4 V4
     labels V4

  layer m5 M5
    labels M5,M5TXT

  layer fdrc FDRC
    labels FDRC	

  layer fdrc FDRC2
    labels FDRC2

  layer pad PAD
    labels PAD 	

  layer prb PRB
    labels PRB

  

  calma N2V      1      *
  calma	NW	 2	*
  calma PPLS     7	*
  calma	NPLS	 8	*
  calma PDIF     11	*
  calma	NDIF	 12	*

  calma P1	 13	*	

  calma V0       15	*
  calma M1       16	*
  calma V1       17	*
  calma M2       18	*
  calma V2       27	*
  calma M3       28	*
  calma V3       29	*
  calma M4       31	*
  calma V4       32	*
  calma M5       33	*

  calma M1TXT    40   	*
  calma M2TXT    41   	*
  calma M3TXT    42   	*
  calma M4TXT    43   	*
  calma M5TXT    44   	*

  calma PAD      62     * 
  calma PRB      61     * 












style direct

  scalefactor 2

  iname 63 0 		
  ignore BBOX			    

  
  layer nw NW
    labels NW

  
  layer ppls PPLS
     labels PPLS	

  
  layer npls NPLS
     labels NPLS	

  
  layer ndif NDIF
    labels NDIF

  layer pdif PDIF
    labels PDIF

  layer nfet NFET
    labels NFET

  layer pfet PFET
    labels PFET

  layer nwc NWC
    labels NWC

  layer pwc PWC
    labels PWC

  
  layer p1 P1
    labels P1

  
  layer v0 V0

  
  layer m1 M1
    labels M1

  layer v1 V1

  layer m2 M2
    labels M2

  layer v2 V2

  layer m3 M3
    labels M3

  layer v3 V3

  layer m4 M4
    labels M4

  


  calma	NDIF	 1	0
  calma	PDIF	 2	1
  calma	NFET	 3	1
  calma	PFET	 4	1
  calma	NWC	 5	1
  calma	PWC	 6	1


  calma	NW	 2	0
  calma P1	 5	0	
  calma PPLS     3	0
  calma NPLS     6	0
  calma V0       7	*
  calma M1       8	*
  calma V1       9	*
  calma M2      11	*
  calma V2      12	*
  calma M3      14	*
  calma V3      15	*
  calma M4      17	*
  calma BBOX    62      * 
end

mzrouter
end

drc


cifstyle to_mmi25

  width m1 .32     "Metal1 min width = .32 um"

  spacing m1 m1 .32 touching_ok     "Metal1 min spacing = .32 um"






no_overlap	pfet,nfet	pfet,nfet 




exact_overlap v0,v1,v2,v3,v4

end

extract
style lumped
  cscale	10		
  lambda	2	
  step		500
  sidehalo	0	

  noplaneordering

  
  resist ndif,pwc 5659 
  resist pdif,nwc 4505 
  resist poly 5712 
  resist m1 113 
  resist m2 113 
  resist m3 114 
  resist m4 114 
  resist m5 112 

  

  
  fetresist nfet linear  7500  
  fetresist pfet linear 15000 

  





	
  areacap poly 0.059
  perimc poly space,ndif,nwc,pdif,pwc,nfet,pfet 1.234

  areacap m1 0.037
  perimc m1 space/m1 1.4

  areacap m2 0.031
  perimc m2 space/m2 1.4

  areacap m3 0.030
  perimc m3 space/m3 1.4

  areacap m4 0.030
  perimc m4 space/m4 1.4

  areacap m5 0.029
  perimc m5 space/m5 1.4

  


  fet pfet pdif 2 pfet Vdd! nwell 50 7
  fet nfet ndif 2 nfet GND! 50 7
end






/* -------------------------------------------------------------------
 * g25-convert.tech - 
 *
 * THIS is solely for translating from g25 to mmi25 technologies
 *
 *  ------------------------------------------------------------------- 
 */

/* 
 * Include m4 drc_macros.
 *
 * NOTE:  the drc macros expect to be run through m4 (after cpp).
 * Thus to proerly compile this tech file, the :techinstall 
 * script must contain a line like this:
 *	cpp -P $technology | m4 - > $tmpfile
 */
#include "drc_macros.i"

tech
  g25
end

version
	version STRING_CAT(g25-convert,__TIME__,__DATE__)
	description "g25-convert"
end

/* NOTE:  poly on active plane so fet compose rules work. 
 *	  fet types needed to be explicit for extractor.
 */
planes
  ppls		/* pplus */
  npls          /* nplus */
  nw	        /* n-well */
  act           /* active (and poly) */
  v0     	/* contacts (active to m1) */
  m1	        
  v1	        /* via from m1 to m2 */
  m2	        
  v2	        /* via from m2 to m3 */
  m3	        
  v3	        /* via from m3 to m4 */
  m4
  v4	        /* via from m4 to m5 */
  m5
  fdrc          /* feedback foreign drc errors */
  pw
  pad
  prb	        /* place and route boundary */
  res	
  n2v	
end

types
  ppls	pplus,ppls	        /* mostly auto gened at cif output time */
  npls  nplus,npls	        /* mostly auto gened at cif output time */
  nw	nwell,nw	        /* mostly auto gened at cif output time */

  act	ndiffusion,ndif
  act	pdiffusion,pdif
  act	ntransistor,nfet
  act	ptransistor,pfet
  act	nsubstratencontact,nwc	        /* nwell tie */
  act	psubstratepcontact,pwc	        /* substrate tie */ 
  act	polysilicon,p1

  v0	contact,v0	                /* poly/active to m1 contact */

  m1	metal1,m1

  v1	m2contact,v1

  m2	metal2,m2

  v2	m3contact,v2

  m3	metal3,m3

  v3	m4contact,v3

  m4	metal4,m4

  v4	m5contact,v4

  m5	metal5,m5

  fdrc	fdrc

  pw    pwell,pw
  pad   pad
  prb   prb
  res   resistor,res
  n2v   n2v	
end

/* Not using Max contacts.  Using separate via planes instead,
 * to allow unaligned and stacked contacts.
 */
contact
end

styles
    /* wells */
    n2v         22	
    ppls	27
    npls	28
    nw		26

    /* active */
    ndif	3
    pdif	5
    nfet	7
    nfet	8
    pfet	9
    pfet	10
    nwc		4
    pwc		6

    /* poly */
    p1	2
    	
    /* contacts (active to m1 ) */
    v0	32	/* contact X */

    /* vias */
    v1	33
    v1	32	 /* contact X */

    v2	37
    v2	32	 /* contact X */

    v3	38
    v3	32	 /* contact X */

    v4	39
    v4	32	 /* contact X */

    /* metals */
    m1	12
    m2	13
    m3	17
    m4	16
    m4  20 
    m5  15
    m5  21

    /* drc errors */
    error_p	42
    error_s	42
    error_ps	42

    /* foreign drc error feedback */
    fdrc 43

    /* special layers */
    pwel 27
    pad   3
    prb  27
    res  27
end

compose
    /* MOSFET composition rules */
    compose	nfet	p1	ndif
    compose	pfet	p1	pdif
    
#ifndef POSTGEN
    /* These rules allow nwell to be painted over an area to
     * flip all the pwell types to nwell types.  (used during cif read)
     */
    paint	ndif	nw	pdif
    paint	nfet	nw	pfet
    paint	pwc	nw	nwc

#endif POSTGEN
end

/*---- Definitions of macros grouping types together in "layer lists" follow.
 *     These are used throughout the rest of the tech file.
 *     NOTE:  BE CAREFUL NOT TO INTRODUCE SPACES INTO LAYER-LISTS - a
 *     space terminates a layer list.
 */

/* The types in the following lists connect, i.e. these defs
 * are used to define "conductors".
 */
#define all_p1 p1,nfet,pfet
#define all_ndif ndif,nwc
#define all_pdif pdif,pwc

/* Not all types in lists below connect to each other */
#define all_dif all_ndif,all_pdif
#define all_dif_litho all_ndif,all_pdif,nfet,pfet
#define all_p1_no_fet p1
#define all_active_plane all_dif_litho,all_p1_no_fet
#define all_ndif_no_wc ndif
#define all_pdif_no_wc pdif

connect
    all_dif		all_dif
    all_p1		all_p1

    v0		all_active_plane,m1			
    v1		m1,m2
    v2		m2,m3
    v3		m3,m4
    v4		m4,m5
end

cifoutput
style to_mmi25
  units .02 .001 .001 .001      	

  charset unrestricted
  iname propattr 102  /* output instance names as property attribute 102 */

  /***** NWELL (NW) *****/

  layer NW nw
    polygons nw
    calma 2 0

  /***** CONTACT (V0) *****/

  layer V0 v0
    grow .01	
    /* squares <border> <size> <separation> [align] */
    /* all dims divisible by .02 so result of centering will be on .01 grid */
    squares 0 .30 .30  
    calma 15 0

  /***** P+ (PPLS) ****/
  layer PPLS ppls
    polygons ppls
    calma 7 0

  /***** N+ (NPLS) ****/
  layer NPLS npls
    polygons npls
    calma 8 0

  /***** DIFUSION (ACT) *****/
  layer NDIF ndif,nfet
     polygons ndif,nfet
     calma 11 0

  layer PDIF pdif,pfet
     polygons pdif,pfet
     calma 12 0

  layer NWC nwc
     polygons nwc
     calma 90 0

  layer PWC pwc
     polygons pwc
     calma 91 0

  /***** POLYSILICON (P1) *****/
  layer P1 all_p1
    polygons all_p1
    calma 13 0
	port 13 0 comment
	port 13 1 hidden
	port 13 2 local
	port 13 3 global
	port 13 4 input
	port 13 5 output
	port 13 6 inout



  /***** METAL SYSTEM *****/
  layer M1 m1
    polygons m1
    calma 16 0

  layer V1 v1
    /* squares <border> <size> <separation> [align] */
    /* all dims divisible by .02 so result of centering will be on .01 grid */
    squares 0 .36 .36 
    calma 17 0

  layer M2 m2
    polygons m2
    calma 18 0

  layer V2 v2
    /* squares <border> <size> <separation> [align] */
    /* all dims divisible by .02 so result of centering will be on .01 grid */
    squares 0 .36 .36
    calma 27 0

  layer M3 m3
    polygons m3
    calma 28 0

  layer V3 v3
    /* squares <border> <size> <separation> [align] */
    /* all dims divisible by .02 so result of centering will be on .01 grid */
    squares 0 .36 .36
    calma 29 0

  layer M4 m4
    polygons m4
    calma 31 0

  layer V4 v4
    /* squares <border> <size> <separation> [align] */
    /* all dims divisible by .02 so result of centering will be on .01 grid */
    squares 0 .36 .36
    calma 32 0

  layer M5 m5
    polygons m5
    calma 33 0

  layer PAD pad
    polygons pad
    calma 62 0

  layer PRB prb,res
    calma 65 0

   layer M1TXT
	labels m1
	calma 40 0	
	port 40 0 comment
	port 40 1 hidden
	port 40 2 local
	port 40 3 global
	port 40 4 input
	port 40 5 output
	port 40 6 inout

   layer M2TXT
	labels m2
	calma 41 0	
	port 41 0 comment
	port 41 1 hidden
	port 41 2 local
	port 41 3 global
	port 41 4 input
	port 41 5 output
	port 41 6 inout


   layer M3TXT
	labels m3
	calma 42 0	
	port 42 0 comment
	port 42 1 hidden
	port 42 2 local
	port 42 3 global
	port 42 4 input
	port 42 5 output
	port 42 6 inout

   layer M4TXT
	labels m4
	calma 43 0	
	port 43 0 comment
	port 43 1 hidden
	port 43 2 local
	port 43 3 global
	port 43 4 input
	port 43 5 output
	port 43 6 inout


   layer M5TXT
	labels m5
	calma 44 0	
	port 44 0 comment
	port 44 1 hidden
	port 44 2 local
	port 44 3 global
	port 44 4 input
	port 44 5 output
	port 44 6 inout

   layer SPACE
	labels space
	calma 255 0


end

/* -------------------------------------------------------------------- *
 * In the CIFinput section, the order of layer specifications is        *
 * important.  The layers are painted in the order they appear.         *
 * ---------------------------------------------------------------------*/
cifinput
/* 
 * CIF INPUT STYLE:  import_tsmc
 *
 *
 * 1 max unit = .02 microns
 *
 * For importing layout from tsmc.
 *
 */
style import_tsmc
#ifdef RES01
  scalefactor 1
#else
  scalefactor 2
#endif
  iname propattr 102     /* instance names given on property attribute 102 
	                 * (in gds SREF's)
	                 */

  layer n2v N2V

  layer ppls PPLS
    labels PPLS

  layer npls NPLS
    labels NPLS

  layer nw NW  
    labels NW

  layer p1 P1
    labels P1

  layer ndif NDIF
    and-not NW	
    labels NDIF

  layer pdif PDIF
    and NW	
    labels PDIF

  layer nfet ndif
    and p1

  layer pfet pdif
    and p1

  layer nwc NDIF
    and NW

  layer pwc PDIF
    and-not NW

  layer v0 V0
    labels V0

  layer m1 M1
    labels M1,M1TXT

  layer v1 V1
    labels V1

  layer m2 M2
    labels M2,M2TXT

  layer v2 V2
    labels V2

  layer m3 M3
    labels M3,M3TXT

  layer v3 V3
     labels V3

  layer m4 M4
    labels M4,M4TXT

  layer v4 V4
     labels V4

  layer m5 M5
    labels M5,M5TXT

  layer fdrc FDRC
    labels FDRC	

  layer fdrc FDRC2
    labels FDRC2

  layer pad PAD
    labels PAD 	

  layer prb PRB
    labels PRB

  /* define correspondence between names and gds numbers */

  calma N2V      1      *
  calma	NW	 2	*
  calma PPLS     7	*
  calma	NPLS	 8	*
  calma PDIF     11	*
  calma	NDIF	 12	*

  calma P1	 13	*	

  calma V0       15	*
  calma M1       16	*
  calma V1       17	*
  calma M2       18	*
  calma V2       27	*
  calma M3       28	*
  calma V3       29	*
  calma M4       31	*
  calma V4       32	*
  calma M5       33	*

  calma M1TXT    40   	*
  calma M2TXT    41   	*
  calma M3TXT    42   	*
  calma M4TXT    43   	*
  calma M5TXT    44   	*

  calma PAD      62     * 
  calma PRB      61     * 
/* 
 * CIF INPUT STYLE:  direct
 *
 * gdsII input
 * 1 max DB unit = .02 microns
 *
 * NOTE:  "labels" statements define direct mapping from gds layers to max
 *        layers not just for labels but also for polygons (used for 
 *        (non-manhattan geometries).  
 * 
 */

style direct
#ifdef RES01
  scalefactor 1
#else	
  scalefactor 2
#endif
  iname 63 0 		/* instance names here (CALMA only) */
  ignore BBOX		/* bounding box here */	    

  /***** NWELL (NW) *****/
  layer nw NW
    labels NW

  /***** PPLS *****/
  layer ppls PPLS
     labels PPLS	

  /***** NPLS *****/
  layer npls NPLS
     labels NPLS	

  /***** DIFUSION (ACT) *****/
  layer ndif NDIF
    labels NDIF

  layer pdif PDIF
    labels PDIF

  layer nfet NFET
    labels NFET

  layer pfet PFET
    labels PFET

  layer nwc NWC
    labels NWC

  layer pwc PWC
    labels PWC

  /***** POLY *****/
  layer p1 P1
    labels P1

  /***** CONTACT (V0) *****/
  layer v0 V0

  /***** METAL SYSTEM *****/
  layer m1 M1
    labels M1

  layer v1 V1

  layer m2 M2
    labels M2

  layer v2 V2

  layer m3 M3
    labels M3

  layer v3 V3

  layer m4 M4
    labels M4

  /* define correspondence between cif names and calma numbers */
/*  calma FDRC	 0      *  */

  calma	NDIF	 1	0
  calma	PDIF	 2	1
  calma	NFET	 3	1
  calma	PFET	 4	1
  calma	NWC	 5	1
  calma	PWC	 6	1

/*   calma	ACT	 1	0  */
  calma	NW	 2	0
  calma P1	 5	0	
  calma PPLS     3	0
  calma NPLS     6	0
  calma V0       7	*
  calma M1       8	*
  calma V1       9	*
  calma M2      11	*
  calma V2      12	*
  calma M3      14	*
  calma V3      15	*
  calma M4      17	*
  calma BBOX    62      * /* instance bounding boxes */
end

mzrouter
end

drc
/* === METAL1 RULES === */

cifstyle to_mmi25

  width m1 .32 \
    "Metal1 min width = .32 um"

  spacing m1 m1 .32 touching_ok \
    "Metal1 min spacing = .32 um"

/* === HIERARCHY RULES === /

/* For extraction: 
 *   don't allow fets to be created/destroyed by cell overlap.  
 */
no_overlap	pfet,nfet	pfet,nfet 

/* For via generation at cifoutput time:
 *   don't allow partial overlap between vias
 */
exact_overlap v0,v1,v2,v3,v4

end

extract
style lumped
  cscale	10	/* use units of 10 attoFarads in .ext files */	
  lambda	2	/* .02 centimicron grid */
  step		500
  sidehalo	0	/* no parallel coupling cap */

  noplaneordering

  /* resistance in milli-ohms/square */
  resist ndif,pwc 5659 /* at 105 Celsius */
  resist pdif,nwc 4505 /* at 105 Celsius */
  resist poly 5712 /* at 105 Celsius (npoly value, ppoly = 5141) */
  resist m1 113 /* at 105 Celsius */
  resist m2 113 /* at 105 Celsius */
  resist m3 114 /* at 105 Celsius */
  resist m4 114 /* at 105 Celsius */
  resist m5 112 /* at 105 Celsius */

  /* INGORING via resistance! */

  /* fet resistances in ohms/square (used in resistive extraction) */
  fetresist nfet linear  7500  /*  on-resistance in ohms - guess */
  fetresist pfet linear 15000 /* on-resistance in ohms - guess */

  /* cap values correct for "dense" wiring = minimum spacing with
   * layer above and below populated.
   * pessimistic for other cases.
   *
   * Miller effect ignored :-)
   *
   */	
  areacap poly 0.059
  perimc poly space,all_dif_litho 1.234

  areacap m1 0.037
  perimc m1 space/m1 1.4

  areacap m2 0.031
  perimc m2 space/m2 1.4

  areacap m3 0.030
  perimc m3 space/m3 1.4

  areacap m4 0.030
  perimc m4 space/m4 1.4

  areacap m5 0.029
  perimc m5 space/m5 1.4

  /* TODO last two parms: gscap gccap - values are (bad) guesses
   * not sure what they are used for?
   */
  fet pfet all_pdif_no_wc 2 pfet Vdd! nwell 50 7
  fet nfet all_ndif_no_wc 2 nfet GND! 50 7
end






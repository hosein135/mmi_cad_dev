# This file is a shell script that caches the results of configure
# tests run on this system so they can be shared between configure
# scripts and configure runs.  It is not useful on other systems.
# If it contains results you don't want to keep, you may remove or edit it.
#
# By default, configure uses ./config.cache as the cache file,
# creating it if it does not exist already.  You can give configure
# the --cache-file=FILE option to use a different cache file; that is
# what configure does when it calls configure scripts in
# subdirectories, so they share the cache.
# Giving --cache-file=/dev/null disables caching, for debugging configure.
# config.status only pays attention to the cache file if you give it the
# --recheck option to rerun configure.
#
ac_cv_c_bigendian=${ac_cv_c_bigendian=no}
ac_cv_func_drand48=${ac_cv_func_drand48=yes}
ac_cv_func_srand48=${ac_cv_func_srand48=yes}
ac_cv_func_strdup=${ac_cv_func_strdup=yes}
ac_cv_have_x=${ac_cv_have_x='have_x=yes 		ac_x_includes=/usr/X11R6/include ac_x_libraries=/usr/X11R6/lib'}
ac_cv_header_errno_h=${ac_cv_header_errno_h=yes}
ac_cv_header_float_h=${ac_cv_header_float_h=yes}
ac_cv_header_itcl_h=${ac_cv_header_itcl_h=no}
ac_cv_header_itk_h=${ac_cv_header_itk_h=no}
ac_cv_header_limits_h=${ac_cv_header_limits_h=yes}
ac_cv_header_malloc_h=${ac_cv_header_malloc_h=yes}
ac_cv_header_math_h=${ac_cv_header_math_h=yes}
ac_cv_header_memory_h=${ac_cv_header_memory_h=yes}
ac_cv_header_setjmp_h=${ac_cv_header_setjmp_h=yes}
ac_cv_header_stdc=${ac_cv_header_stdc=yes}
ac_cv_header_stdlib_h=${ac_cv_header_stdlib_h=yes}
ac_cv_header_string_h=${ac_cv_header_string_h=yes}
ac_cv_header_sys_param_h=${ac_cv_header_sys_param_h=yes}
ac_cv_header_sys_time_h=${ac_cv_header_sys_time_h=yes}
ac_cv_header_sys_wait_h=${ac_cv_header_sys_wait_h=yes}
ac_cv_header_time=${ac_cv_header_time=yes}
ac_cv_header_unistd_h=${ac_cv_header_unistd_h=yes}
ac_cv_header_waitflags_h=${ac_cv_header_waitflags_h=no}
ac_cv_lib_m_main=${ac_cv_lib_m_main=yes}
ac_cv_lib_nsl_main=${ac_cv_lib_nsl_main=yes}
ac_cv_lib_socket_main=${ac_cv_lib_socket_main=no}
ac_cv_path_install=${ac_cv_path_install='/usr/bin/install -c'}
ac_cv_prog_CPP=${ac_cv_prog_CPP='gcc -E'}
ac_cv_prog_LN_S=${ac_cv_prog_LN_S='ln -s'}
ac_cv_prog_RANLIB=${ac_cv_prog_RANLIB=ranlib}
ac_cv_type_pid_t=${ac_cv_type_pid_t=yes}
ac_cv_type_size_t=${ac_cv_type_size_t=yes}
blt_cv_decl_drand48=${blt_cv_decl_drand48=yes}
blt_cv_decl_strdup=${blt_cv_decl_strdup=yes}
blt_cv_found_dbl_epsilon=${blt_cv_found_dbl_epsilon=yes}
blt_cv_major_version=${blt_cv_major_version=2}
blt_cv_minor_version=${blt_cv_minor_version=4}
blt_cv_prog_cc=${blt_cv_prog_cc=gcc}
blt_cv_prog_cflags=${blt_cv_prog_cflags=}
blt_cv_struct_wait_works=${blt_cv_struct_wait_works=yes}

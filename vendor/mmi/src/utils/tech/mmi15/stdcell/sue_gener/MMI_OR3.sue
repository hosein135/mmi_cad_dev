# Created using mapper from:
#"MMI_OR3 {B {MMI_OR3B {in0 in0} {in1 in1} {in2 in2} {out out}} {MMI_OR3B_ {in0 in0} {in1 in1} {in2 in2} {out out}}} {C {MMI_OR3C {in0 in0} {in1 in1} {in2 in2} {out out}} {MMI_OR3C_ {in0 in0} {in1 in1} {in2 in2} {out out}}} "

proc SCHEMATIC_MMI_OR3 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    B {

  make global -name gnd -origin {0 140}
  make global -name gnd -origin {140 140}
  make input -name in1 -origin {-100 -100}
  make global -name gnd -origin {280 140}
  make global -orient RY -name vdd -origin {0 -240}
  make output -name out -origin {510 50}
  make input -name in2 -origin {-100 -200}
  make input -name in0 -origin {-100 0}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {340 50}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP 1.54 -WN 0.77 -origin {440 50}
  make nmos -W 0.385 -origin {280 100}
  make nmos -W 0.385 -origin {140 100}
  make nmos -W 0.385 -origin {0 100}
  make pmos -W 2.31 -origin {0 0}
  make pmos -W 2.31 -origin {0 -100}
  make pmos -W 2.31 -origin {0 -200}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {70 370}
  make_wire 0 60 0 50
  make_wire 0 40 0 50
  make_wire -60 100 -60 0
  make_wire -100 0 -60 0
  make_wire 0 -40 0 -60
  make_wire 80 100 80 -100
  make_wire 280 60 280 50
  make_wire 0 -140 0 -160
  make_wire 220 100 220 -200
  make_wire -100 -200 -60 -200
  make_wire -100 -100 -60 -100
  make_wire 140 50 140 60
  make_wire 140 50 280 50
  make_wire 490 50 510 50
  make_wire -60 -100 80 -100
  make_wire 0 50 140 50
  make_wire -60 -200 220 -200
  make_wire 340 50 280 50
  make_wire 340 50 410 50
  make_text -origin {-190 -340} -text {3 Input OR}
  make_text -origin {-190 -320} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_OR3 MMI_OR3B -Size B -DeMorgan 0
        make MMI_OR3B -origin "$urx $ury"
      } else {
        generate MMI_OR3 MMI_OR3B_ -Size B -DeMorgan 1
        make MMI_OR3B_ -origin "$urx $ury"
      }
    }

    C {

  make global -name gnd -origin {0 140}
  make global -name gnd -origin {270 140}
  make input -name in1 -origin {-100 -100}
  make global -name gnd -origin {410 140}
  make global -orient RY -name vdd -origin {0 -240}
  make output -name out -origin {680 50}
  make global -orient RY -name vdd -origin {100 -240}
  make input -name in2 -origin {-100 -200}
  make input -name in0 -origin {-100 0}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {480 50}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP 3.08 -WN 1.54 -origin {610 50}
  make nmos -W 0.52 -origin {410 100}
  make nmos -W 0.52 -origin {270 100}
  make nmos -W 0.52 -origin {0 100}
  make pmos -W 1.56 -origin {0 0}
  make pmos -W 1.56 -origin {100 0}
  make pmos -W 1.56 -origin {100 -100}
  make pmos -W 1.56 -origin {0 -100}
  make pmos -W 1.56 -origin {0 -200}
  make pmos -W 1.56 -origin {100 -200}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {170 350}
  make_wire 0 60 0 50
  make_wire 0 40 0 50
  make_wire -60 100 -60 0
  make_wire -100 0 -60 0
  make_wire 0 -40 0 -60
  make_wire 210 100 210 -100
  make_wire 410 60 410 50
  make_wire 0 -140 0 -160
  make_wire 350 100 350 -200
  make_wire -100 -200 -60 -200
  make_wire -100 -100 -60 -100
  make_wire 100 40 100 50
  make_wire 100 -40 100 -60
  make_wire 100 -140 100 -160
  make_wire 270 50 270 60
  make_wire 40 0 -60 0
  make_wire 0 50 100 50
  make_wire 100 50 270 50
  make_wire 270 50 410 50
  make_wire -60 -200 40 -200
  make_wire 40 -200 350 -200
  make_wire -60 -100 40 -100
  make_wire 40 -100 210 -100
  make_wire 660 50 680 50
  make_wire 480 50 410 50
  make_wire 480 50 580 50
  make_text -origin {-190 -340} -text {3 Input OR}
  make_text -origin {-190 -320} -text {C Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_OR3 MMI_OR3C -Size C -DeMorgan 0
        make MMI_OR3C -origin "$urx $ury"
      } else {
        generate MMI_OR3 MMI_OR3C_ -Size C -DeMorgan 1
        make MMI_OR3C_ -origin "$urx $ury"
      }
    }

  }
}


proc NAME_MMI_OR3 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set nom MMI_OR3[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_OR3 args {
  icon_generator $args {{Size "B" {radio B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_OR3 icon body
  if {$DeMorgan} {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_arc 40 -10 60 10 -start 0 -extent 359
    icon_arc -60 10 -40 30 -start 0 -extent 359
    icon_arc -60 -10 -40 10 -start 0 -extent 359
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_line -40 -20 -60 -20
    icon_line -38 0 -60 0
    icon_line -40 20 -60 20
    icon_line 40 0 60 0
  }

  # properties
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-37 -22} -size small -label F

  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 0} -name in1
  icon_term -type input -origin {-60 20} -name in2

  # outputs
  icon_term -type output -origin {60 0} -name out


  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_OR3 -Size $Size]
  set nname [NAME_MMI_OR3 -Size $Size -DeMorgan $DeMorgan]
  switch $size {
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .out(\$out)"
    }
    C {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
}

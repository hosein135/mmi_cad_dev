# Created using mapper from:
#"MMI_AND4 {B {MMI_AND4B {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_AND4B_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} {C {MMI_AND4C {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_AND4C_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} "

proc SCHEMATIC_MMI_AND4 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    B {

  make global -orient RY -name vdd -origin {-90 -140}
  make input -name in0 -origin {-190 0}
  make global -orient RY -name vdd -origin {40 -140}
  make input -name in1 -origin {-190 100}
  make global -orient RY -name vdd -origin {160 -140}
  make input -name in2 -origin {-190 200}
  make global -orient RY -name vdd -origin {290 -140}
  make input -name in3 -origin {-190 300}
  make global -name gnd -origin {-90 340}
  make output -name out -origin {540 -50}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {360 -50}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP 1.54 -WN 0.77 -origin {440 -50}
  make pmos -W 0.77 -origin {290 -100}
  make pmos -W 0.77 -origin {160 -100}
  make pmos -W 0.77 -origin {40 -100}
  make pmos -W 0.77 -origin {-90 -100}
  make nmos -W 1.54 -origin {-90 0}
  make nmos -W 1.54 -origin {-90 100}
  make nmos -W 1.54 -origin {-90 200}
  make nmos -W 1.54 -origin {-90 300}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {60 490}
  make_wire -90 -60 -90 -50
  make_wire -90 -40 -90 -50
  make_wire -150 -100 -150 0
  make_wire -190 0 -150 0
  make_wire 40 -60 40 -50
  make_wire -90 40 -90 60
  make_wire 160 -60 160 -50
  make_wire -90 140 -90 160
  make_wire 290 -60 290 -50
  make_wire -90 240 -90 260
  make_wire 100 -100 100 200
  make_wire 230 -100 230 300
  make_wire -20 -100 -20 100
  make_wire 40 -50 160 -50
  make_wire -190 100 -150 100
  make_wire -150 100 -20 100
  make_wire -190 200 -150 200
  make_wire -150 200 100 200
  make_wire -90 -50 40 -50
  make_wire -190 300 -150 300
  make_wire -150 300 230 300
  make_wire 490 -50 540 -50
  make_wire 160 -50 290 -50
  make_wire 360 -50 290 -50
  make_wire 360 -50 410 -50
  make_text -origin {-250 -240} -text {4 Input AND}
  make_text -origin {-250 -220} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_AND4 MMI_AND4B -Size B -DeMorgan 0
        make MMI_AND4B -origin "$urx $ury"
      } else {
        generate MMI_AND4 MMI_AND4B_ -Size B -DeMorgan 1
        make MMI_AND4B_ -origin "$urx $ury"
      }
    }

    C {

  make global -orient RY -name vdd -origin {-90 -140}
  make input -name in0 -origin {-190 0}
  make global -orient RY -name vdd -origin {120 -140}
  make input -name in1 -origin {-190 100}
  make global -orient RY -name vdd -origin {240 -140}
  make input -name in2 -origin {-190 200}
  make global -orient RY -name vdd -origin {370 -140}
  make input -name in3 -origin {-190 300}
  make global -name gnd -origin {-90 340}
  make output -name out -origin {600 -50}
  make global -name gnd -origin {10 340}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {440 -50}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP 3.08 -WN 1.54 -origin {540 -50}
  make pmos -W 1.04 -origin {370 -100}
  make pmos -W 1.04 -origin {240 -100}
  make pmos -W 1.04 -origin {120 -100}
  make pmos -W 1.04 -origin {-90 -100}
  make nmos -W 1.04 -origin {10 0}
  make nmos -W 1.04 -origin {-90 0}
  make nmos -W 1.04 -origin {-90 100}
  make nmos -W 1.04 -origin {10 100}
  make nmos -W 1.04 -origin {-90 200}
  make nmos -W 1.04 -origin {10 200}
  make nmos -W 1.04 -origin {-90 300}
  make nmos -W 1.04 -origin {10 300}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {90 550}
  make_wire -150 -100 -150 0
  make_wire -190 0 -150 0
  make_wire 120 -60 120 -50
  make_wire -90 40 -90 60
  make_wire 240 -60 240 -50
  make_wire -90 140 -90 160
  make_wire 370 -60 370 -50
  make_wire -90 240 -90 260
  make_wire 180 -100 180 200
  make_wire 310 -100 310 300
  make_wire 60 -100 60 100
  make_wire -90 -60 -90 -50
  make_wire -90 -50 -90 -40
  make_wire 120 -50 240 -50
  make_wire 590 -50 600 -50
  make_wire -190 100 -150 100
  make_wire -190 300 -150 300
  make_wire -190 200 -150 200
  make_wire -50 300 -150 300
  make_wire -50 300 310 300
  make_wire 10 240 10 260
  make_wire -50 200 -150 200
  make_wire -50 200 180 200
  make_wire 10 140 10 160
  make_wire -50 100 -150 100
  make_wire -50 100 60 100
  make_wire 10 -50 -90 -50
  make_wire 10 -50 120 -50
  make_wire 10 -50 10 -40
  make_wire 10 40 10 60
  make_wire -150 0 -50 0
  make_wire 240 -50 370 -50
  make_wire 440 -50 370 -50
  make_wire 440 -50 510 -50
  make_text -origin {-250 -240} -text {4 Input AND}
  make_text -origin {-250 -220} -text {C Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_AND4 MMI_AND4C -Size C -DeMorgan 0
        make MMI_AND4C -origin "$urx $ury"
      } else {
        generate MMI_AND4 MMI_AND4C_ -Size C -DeMorgan 1
        make MMI_AND4C_ -origin "$urx $ury"
      }
    }

  }
}


proc NAME_MMI_AND4 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set nom MMI_AND4[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_AND4 args {
  icon_generator $args {{Size "B" {radio B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_AND4 icon body
  if {$DeMorgan} {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_arc 40 -10 60 10 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc -60 0 -40 20 -start 0 -extent 359
    icon_arc -60 -20 -40 0 -start 0 -extent 359
    icon_arc -60 -40 -40 -20 -start 0 -extent 359
  } else {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line -40 -30 -60 -30
    icon_line -40 -10 -60 -10
    icon_line -40 10 -60 10
    icon_line -40 30 -60 30
    icon_line 40 0 60 0
  }

  # properties
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-37 -22} -size small -label F

  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 -10} -name in1
  icon_term -type input -origin {-60 10} -name in2
  icon_term -type input -origin {-60 30} -name in3

  # outputs
  icon_term -type output -origin {60 0} -name out


  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_AND4 -Size $Size]
  set nname [NAME_MMI_AND4 -Size $Size -DeMorgan $DeMorgan]
  switch $size {
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .in3(\$in3), .out(\$out)"
    }
    C {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .in3(\$in3), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
}

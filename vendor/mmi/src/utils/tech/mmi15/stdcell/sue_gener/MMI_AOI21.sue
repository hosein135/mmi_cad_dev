# Created using mapper from:
#"MMI_AOI21 {A {MMI_AOI21A {in0 in0} {in1 in1} {in2 in2} {out out}} {MMI_AOI21A_ {in0 in0} {in1 in1} {in2 in2} {out out}}} {B {MMI_AOI21B {in0 in0} {in1 in1} {in2 in2} {out out}} {MMI_AOI21B_ {in0 in0} {in1 in1} {in2 in2} {out out}}} {C {MMI_AOI21C {in0 in0} {in1 in1} {in2 in2} {out out}} {MMI_AOI21C_ {in0 in0} {in1 in1} {in2 in2} {out out}}} "

proc SCHEMATIC_MMI_AOI21 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    A {

  make global -name gnd -origin {220 480}
  make global -name gnd -origin {470 580}
  make global -orient RY -name vdd -origin {220 180}
  make output -name out -origin {530 380}
  make input -name in0 -origin {90 440}
  make input -name in1 -origin {370 440}
  make input -name in2 -origin {90 540}
  make global -orient RY -name vdd -origin {470 180}
  make nmos -W 0.385 -origin {220 440}
  make nmos -W 0.77 -origin {470 440}
  make nmos -W 0.77 -origin {470 540}
  make pmos -W 1.54 -origin {220 320}
  make pmos -W 1.54 -origin {220 220}
  make pmos -W 1.54 -origin {470 220}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {220 760}
  make_wire 220 400 220 380
  make_wire 220 360 220 380
  make_wire 220 380 470 380
  make_wire 220 260 220 280
  make_wire 470 500 470 480
  make_wire 470 260 470 280
  make_wire 220 280 470 280
  make_wire 470 380 530 380
  make_wire 130 320 160 320
  make_wire 130 440 160 440
  make_wire 130 440 90 440
  make_wire 390 440 390 220
  make_wire 390 220 410 220
  make_wire 390 440 410 440
  make_wire 390 440 370 440
  make_wire 130 320 130 440
  make_wire 110 220 160 220
  make_wire 110 540 410 540
  make_wire 110 540 90 540
  make_wire 110 220 110 540
  make_wire 470 380 470 400
  make_text -origin {60 120} -text {Inverting AND-OR 2,1 Gate}
  make_text -origin {60 140} -text {A Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_AOI21 MMI_AOI21A -Size A -DeMorgan 0
        make MMI_AOI21A -origin "$urx $ury"
      } else {
        generate MMI_AOI21 MMI_AOI21A_ -Size A -DeMorgan 1
        make MMI_AOI21A_ -origin "$urx $ury"
      }
    }

    B {

  make global -name gnd -origin {220 480}
  make global -name gnd -origin {470 580}
  make global -orient RY -name vdd -origin {220 180}
  make output -name out -origin {530 380}
  make input -name in0 -origin {90 440}
  make input -name in1 -origin {370 440}
  make input -name in2 -origin {90 540}
  make global -orient RY -name vdd -origin {470 180}
  make nmos -W 0.77 -origin {220 440}
  make nmos -W 1.54 -origin {470 440}
  make nmos -W 1.54 -origin {470 540}
  make pmos -W 3.08 -origin {220 320}
  make pmos -W 3.08 -origin {220 220}
  make pmos -W 3.08 -origin {470 220}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {250 750}
  make_wire 220 400 220 380
  make_wire 220 360 220 380
  make_wire 220 380 470 380
  make_wire 220 260 220 280
  make_wire 470 500 470 480
  make_wire 470 260 470 280
  make_wire 220 280 470 280
  make_wire 470 380 530 380
  make_wire 130 320 160 320
  make_wire 130 440 160 440
  make_wire 130 440 90 440
  make_wire 390 440 390 220
  make_wire 390 220 410 220
  make_wire 390 440 410 440
  make_wire 390 440 370 440
  make_wire 130 320 130 440
  make_wire 110 220 160 220
  make_wire 110 540 410 540
  make_wire 110 540 90 540
  make_wire 110 220 110 540
  make_wire 470 380 470 400
  make_text -origin {60 120} -text {Inverting AND-OR 2,1 Gate}
  make_text -origin {60 140} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_AOI21 MMI_AOI21B -Size B -DeMorgan 0
        make MMI_AOI21B -origin "$urx $ury"
      } else {
        generate MMI_AOI21 MMI_AOI21B_ -Size B -DeMorgan 1
        make MMI_AOI21B_ -origin "$urx $ury"
      }
    }

    C {

  make global -name gnd -origin {220 480}
  make global -name gnd -origin {470 580}
  make output -name out -origin {530 380}
  make global -orient RY -name vdd -origin {220 180}
  make global -orient RY -name vdd -origin {470 180}
  make input -name in0 -origin {90 440}
  make input -name in1 -origin {370 440}
  make input -name in2 -origin {90 540}
  make nmos -W 1.54 -origin {220 440}
  make nmos -W 3.08 -origin {470 440}
  make nmos -W 3.08 -origin {470 540}
  make pmos -W 6.16 -origin {220 320}
  make pmos -W 6.16 -origin {220 220}
  make pmos -W 6.16 -origin {470 220}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 12/06/99 -origin {270 750}
  make_wire 220 400 220 380
  make_wire 220 360 220 380
  make_wire 220 380 470 380
  make_wire 220 260 220 280
  make_wire 470 500 470 480
  make_wire 470 260 470 280
  make_wire 220 280 470 280
  make_wire 470 380 530 380
  make_wire 130 320 160 320
  make_wire 130 440 160 440
  make_wire 130 440 90 440
  make_wire 390 440 390 220
  make_wire 390 220 410 220
  make_wire 390 440 410 440
  make_wire 390 440 370 440
  make_wire 130 320 130 440
  make_wire 110 220 160 220
  make_wire 110 540 410 540
  make_wire 110 540 90 540
  make_wire 110 220 110 540
  make_wire 470 380 470 400
  make_text -origin {60 120} -text {Inverting AND-OR 2,1 Gate}
  make_text -origin {60 140} -text {C Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_AOI21 MMI_AOI21C -Size C -DeMorgan 0
        make MMI_AOI21C -origin "$urx $ury"
      } else {
        generate MMI_AOI21 MMI_AOI21C_ -Size C -DeMorgan 1
        make MMI_AOI21C_ -origin "$urx $ury"
      }
    }

  }
}


proc NAME_MMI_AOI21 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set nom MMI_AOI21[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_AOI21 args {
  icon_generator $args {{Size "A" {radio A B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "A") && ($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_AOI21 icon body
  if {$DeMorgan} {
    # or
    icon_line -88 -10 -40 -10
    icon_line -88 50 -40 50
    icon_arc -100 -10 10 130 -start 35 -extent 50
    icon_arc -100 -90 10 50 -start 275 -extent 50
    icon_arc -98 -10 -78 50 -start 270 -extent 180
    # and
    icon_line 50 -30 0 -30 0 30 50 30
    icon_arc 10 -30 80 30 -start 277 -extent 166
    # bubbles and stubs
    icon_line -100 -30 -20 -30
    icon_arc -100 30 -80 50 -start 0 -extent 359
    icon_arc -100 -10 -80 10 -start 0 -extent 359
    icon_line 80 0 100 0
    icon_arc -20 -40 0 -20 -start 0 -extent 359
    # properties
    icon_property -origin {3 -22} -size small -label F
    icon_property -origin {-77 -2} -size small -label F
    icon_property -origin {30 0} -size large -anchor center -label $size
  } else {
    # or
    icon_line -10 -30 40 -30
    icon_line -10 30 40 30
    icon_arc -20 -30 90 110 -start 35 -extent 50
    icon_arc -20 -110 90 30 -start 275 -extent 50
    icon_arc -20 -30 0 30 -start 270 -extent 180
    # and
    icon_line -40 -10 -80 -10 -80 50 -40 50
    icon_arc -80 -10 -10 50 -start 277 -extent 166
    # stubs
    icon_line -100 -30 -10 -30
    icon_line -100 0 -80 0
    icon_line -100 40 -80 40
    icon_arc 80 -10 100 10 -start 0 -extent 359
    # properties
    icon_property -origin {-77 -2} -size small -label F
    icon_property -origin {0 -22} -size small -label F
    icon_property -origin {30 0} -size large -anchor center -label $size
  }

  # inputs
  icon_term -type input -origin {-100 -30} -name in0
  icon_term -type input -origin {-100 0} -name in1
  icon_term -type input -origin {-100 40} -name in2

  # outputs
  icon_term -type output -origin {100 0} -name out



  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_AOI21 -Size $Size]
  set nname [NAME_MMI_AOI21 -Size $Size -DeMorgan $DeMorgan]
  switch $size {
    A {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .out(\$out)"
    }
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .out(\$out)"
    }
    C {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
}

  make_wire 170 260 -20 260
  make_wire 250 470 320 470
  make_wire 380 470 460 470
  make_wire 170 470 -20 470
  make_wire 350 370 350 300
  make_wire 350 370 350 440
  make_wire 30 370 30 590
  make_wire 30 590 70 590
  make_wire 30 370 -10 370

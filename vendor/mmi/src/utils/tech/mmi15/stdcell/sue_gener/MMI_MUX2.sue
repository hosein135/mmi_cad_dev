# Created using mapper from:
#"MMI_MUX2 {A {MMI_MUX2A {in0 in0} {in1 in1} {sel sel} {out out}} {MMI_MUX2A_ {in0 in0} {in1 in1} {sel sel} {out out}}} {B {MMI_MUX2B {in0 in0} {in1 in1} {sel sel} {out out}} {MMI_MUX2B_ {in0 in0} {in1 in1} {sel sel} {out out}}} {C {MMI_MUX2C {in0 in0} {in1 in1} {sel sel} {out out}} {MMI_MUX2C_ {in0 in0} {in1 in1} {sel sel} {out out}}} {D {MMI_MUX2D {in0 in0} {in1 in1} {sel sel} {out out}} {MMI_MUX2D_ {in0 in0} {in1 in1} {sel sel} {out out}}} "

proc SCHEMATIC_MMI_MUX2 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    A {

  make xgate -WP 1.54 -WN 0.77 -origin {500 430}
  make inverter -WP 0.77 -WN 0.385 -origin {250 550}
  make input -name sel -origin {140 330}
  make input -name in0 -origin {130 220}
  make input -name in1 -origin {130 430}
  make output -name out -origin {830 320}
  make inverter -WP 0.77 -WN 0.385 -origin {720 320}
  make inverter -WP 0.77 -WN 0.385 -origin {350 430}
  make inverter -WP 0.77 -WN 0.385 -origin {350 220}
  make xgate -WP 0.77 -WN 0.385 -origin {500 220}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 12/08/99 -origin {350 700}
  make_wire 400 220 470 220
  make_wire 530 220 610 220
  make_wire 610 220 610 320
  make_wire 610 320 690 320
  make_wire 320 220 130 220
  make_wire 400 430 470 430
  make_wire 530 430 610 430
  make_wire 320 430 130 430
  make_wire 610 430 610 320
  make_wire 500 330 500 260
  make_wire 500 330 500 400
  make_wire 180 330 180 550
  make_wire 180 550 220 550
  make_wire 180 330 140 330
  make_wire 180 330 500 330
  make_wire 500 550 500 470
  make_wire 440 170 500 170
  make_wire 440 550 300 550
  make_wire 440 550 500 550
  make_wire 440 170 440 550
  make_wire 500 170 500 190
  make_wire 770 320 830 320
  make_text -origin {0 60} -text {2:1 Mux}
  make_text -origin {0 80} -text {A Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_MUX2 MMI_MUX2A -Size A -DeMorgan 0
        make MMI_MUX2A -origin "$urx $ury"
      } else {
        generate MMI_MUX2 MMI_MUX2A_ -Size A -DeMorgan 1
        make MMI_MUX2A_ -origin "$urx $ury"
      }
    }

    B {

  make inverter -WP 1.54 -WN 0.77 -origin {680 310}
  make xgate -WP 1.54 -WN 0.77 -origin {460 210}
  make inverter -WP 1.54 -WN 0.77 -origin {310 210}
  make xgate -WP 1.54 -WN 0.77 -origin {460 420}

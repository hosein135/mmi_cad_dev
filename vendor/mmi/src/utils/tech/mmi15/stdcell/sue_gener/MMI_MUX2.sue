        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_MUX2 MMI_MUX2C -Size C -DeMorgan 0
        make MMI_MUX2C -origin "$urx $ury"
      } else {
        generate MMI_MUX2 MMI_MUX2C_ -Size C -DeMorgan 1
        make MMI_MUX2C_ -origin "$urx $ury"
      }
    }

    D {

  make input -name sel -origin {-10 370}
  make input -name in0 -origin {-20 260}
  make input -name in1 -origin {-20 470}
  make output -name out -origin {720 360}
  make xgate -WP 3.08 -WN 1.54 -origin {350 260}
  make inverter -WP 3.08 -WN 1.54 -origin {200 260}
  make inverter -WP 3.08 -WN 1.54 -origin {200 470}
  make xgate -WP 3.08 -WN 1.54 -origin {350 470}

  make_wire 570 210 570 310
  make_wire 570 310 650 310
  make_wire 280 210 90 210
  make_wire 360 420 430 420
  make_wire 490 420 570 420
  make_wire 280 420 90 420
  make_wire 570 420 570 310
  make_wire 460 320 460 250
  make_wire 460 320 460 390
  make_wire 140 320 140 540
  make_wire 140 540 180 540
  make_wire 140 320 100 320
  make_wire 140 320 460 320
  make_wire 460 540 460 460
  make_wire 400 160 460 160
  make_wire 400 540 260 540
  make_wire 400 540 460 540
  make_wire 400 160 400 540
  make_wire 460 160 460 180
  make_wire 730 310 760 310
  make_text -origin {0 80} -text {B Size}
  make_text -origin {0 60} -text {2:1 Mux}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_MUX2 MMI_MUX2B -Size B -DeMorgan 0
        make MMI_MUX2B -origin "$urx $ury"
      } else {
        generate MMI_MUX2 MMI_MUX2B_ -Size B -DeMorgan 1
        make MMI_MUX2B_ -origin "$urx $ury"
      }
    }

    C {

  make inverter -WP 0.77 -WN 0.385 -origin {230 530}
  make input -name sel -origin {120 310}
  make input -name in0 -origin {110 200}
  make input -name in1 -origin {110 410}
  make output -name out -origin {890 300}
  make xgate -WP 1.54 -WN 0.77 -origin {480 200}
  make inverter -WP 1.54 -WN 0.77 -origin {330 200}

  make xgate -WP 1.54 -WN 0.77 -origin {480 410}
  make inverter -WP 3.08 -WN 1.54 -origin {750 300}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.6 -date 04/28/00 -origin {350 680}
  make_wire 380 200 450 200
  make_wire 510 200 590 200
  make_wire 300 200 110 200
  make_wire 380 410 450 410

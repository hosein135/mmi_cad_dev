# SUE version MMI_SUE4.1.11

proc SCHEMATIC_MMI_MUX4C {} {
  make MMI_MUX4C -origin {1840 -480}
  make output -name out -origin {1750 -60}
  make input -name sel1 -origin {1140 480}
  generate name_net_s name_net -cell name_net
  make name_net -name sel1_L -origin {1430 480}
  make name_net -name N1 -origin {1310 -280}
  make name_net -name N2 -origin {1530 -280}
  make xgate -orient RY -WP 1.54 -WN 0.77 -origin {1430 -280}
  make xgate -orient RY -WP 1.54 -WN 0.77 -origin {1430 170}
  make inverter -WP 0.77 -WN 0.385 -origin {1330 480}
  make xgate -WP 1.54 -WN 0.77 -origin {1030 -380}
  make inverter -WP 1.54 -WN 0.77 -origin {880 -380}
  make xgate -WP 1.54 -WN 0.77 -origin {1030 -170}
  make inverter -WP 1.54 -WN 0.77 -origin {880 -170}
  make input -name in0 -origin {660 -380}
  make input -name sel0 -origin {670 -270}
  make input -name in1 -origin {660 -170}
  make xgate -WP 1.54 -WN 0.77 -origin {1030 80}
  make inverter -WP 1.54 -WN 0.77 -origin {880 80}
  make xgate -WP 1.54 -WN 0.77 -origin {1030 290}
  make inverter -WP 1.54 -WN 0.77 -origin {880 290}
  make input -name in2 -origin {660 80}
  make input -name in3 -origin {660 290}
  make inverter -WP 1.04 -WN 0.52 -origin {780 -50}
  make inverter -WP 3.08 -WN 1.54 -origin {1670 -60}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 05/01/00 -origin {1120 620}
  make_wire 1720 -60 1750 -60
  make_wire 1430 -350 1430 -320
  make_wire 1590 -60 1640 -60
  make_wire 1430 230 1430 200
  make_wire 930 -380 1000 -380
  make_wire 1060 -380 1140 -380
  make_wire 1140 -380 1140 -280
  make_wire 850 -380 660 -380
  make_wire 930 -170 1000 -170
  make_wire 1060 -170 1140 -170
  make_wire 850 -170 660 -170
  make_wire 1140 -170 1140 -280
  make_wire 1030 -270 1030 -340
  make_wire 1030 -270 1030 -200
  make_wire 710 -270 710 -50
  make_wire 710 -50 750 -50
  make_wire 710 -270 670 -270
  make_wire 710 -270 1030 -270
  make_wire 1030 -50 1030 -130
  make_wire 970 -430 1030 -430
  make_wire 970 -50 830 -50
  make_wire 970 -50 1030 -50
  make_wire 970 -430 970 -50
  make_wire 1030 -430 1030 -410
  make_wire 1140 -280 1310 -280
  make_wire 1400 -280 1310 -280
  make_wire 930 80 1000 80
  make_wire 1060 80 1140 80
  make_wire 850 80 660 80
  make_wire 930 290 1000 290
  make_wire 1060 290 1140 290
  make_wire 850 290 660 290
  make_wire 1030 190 1030 120
  make_wire 1030 190 1030 260
  make_wire 710 190 1030 190
  make_wire 1030 410 1030 330
  make_wire 970 30 1030 30
  make_wire 970 410 1030 410
  make_wire 970 30 970 410
  make_wire 1370 230 1430 230
  make_wire 1430 -20 1490 -20
  make_wire 1250 400 1250 480
  make_wire 1430 -20 1430 130
  make_wire 1370 -350 1430 -350
  make_wire 1250 400 1370 400
  make_wire 1370 -350 1370 230
  make_wire 1370 230 1370 400
  make_wire 1430 -250 1430 -20
  make_wire 1490 -20 1490 480
  make_wire 1140 170 1400 170
  make_wire 1140 170 1140 290
  make_wire 1140 170 1140 80
  make_wire 1590 -280 1590 -60
  make_wire 1590 -60 1590 170
  make_wire 1460 -280 1530 -280
  make_wire 1530 -280 1590 -280
  make_wire 1460 170 1590 170
  make_wire 1380 480 1430 480
  make_wire 1430 480 1490 480
  make_wire 1140 480 1250 480
  make_wire 1250 480 1300 480
  make_wire 710 -50 710 190
  make_wire 1030 -50 1030 30
  make_wire 1030 30 1030 50
  make_text -origin {500 -460} -text {C Size}
  make_text -origin {500 -480} -text {4:1 Mux}
  make_text -origin {500 -500} -text MMI_MUX4C -size large
}

proc ICON_MMI_MUX4C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_MUX4 icon body
  icon_line -40 -130 -40 130 40 90 40 -90 -40 -130
  if {$DeMorgan} {
    icon_arc -60 -80 -40 -100 -start 0 -extent 359
    icon_arc -60 -20 -40 -40 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc -60 80 -40 100 -start 0 -extent 359
    icon_arc 60 -10 40 10 -start 0 -extent 359
  } else {
    icon_line -60 -90 -40 -90
    icon_line -60 -30 -40 -30
    icon_line -60 30 -40 30
    icon_line -60 90 -40 90
    icon_line 60 0 40 0
  }
  # properties
  icon_property -origin {-37 -90} -size small -label 0
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-20 112} -size small -label 0 -anchor center
  # inputs
  icon_term -type input -origin {-60 -90} -name in0
  icon_term -type input -origin {-60 -30} -name in1
  icon_term -type input -origin {-60 30} -name in2
  icon_term -type input -origin {-60 90} -name in3
  icon_term -type input -origin {-20 120} -orient R270 -name sel0
  icon_term -type input -origin {20 100} -orient R270 -name sel1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_MUX4C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .in3(\$\{in3\}), .sel0(\$\{sel0\}), .sel1(\$\{sel1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


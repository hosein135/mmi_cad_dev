# SUE version MMI_SUE4.1.11

proc SCHEMATIC_MMI_LLCB {} {
  make input -name d -origin {180 250}
  make input -name clk -origin {180 400}
  generate name_net_s name_net -cell name_net
  make name_net -name clk_L -origin {410 400}
  make global -name gnd -origin {780 110}
  make global -orient RY -name vdd -origin {780 -210}
  make name_net -name N5 -origin {870 -170}
  make inverter -WP 1.54 -WN 0.77 -origin {330 250}
  make nmos -orient RX -W 0.35 -origin {780 70}
  make pmos -orient RX -W 0.35 -origin {780 -90}
  make pmos -orient RX -W 0.35 -origin {780 -170}
  make nmos -orient RX -W 0.35 -origin {780 -10}
  make name_net -name N1 -origin {460 250}
  make name_net -name N2 -origin {700 -50}
  make name_net -name clk -origin {530 140}
  make inverter -WP 0.77 -WN 0.385 -origin {290 400}
  make xgate -orient RY -WP 1.54 -WN 0.77 -origin {550 250}
  make name_net -orient RX -name clk -origin {840 -10}
  make name_net -orient RX -name clk_L -origin {840 -90}
  make title_bar -owner dweisner -origin {530 700}
  make inverter -WP 1.54 -WN 0.77 -origin {1250 250}
  make output -name q -origin {1390 250}
  make inverter -WP 0.77 -WN 0.385 -origin {1060 250}
  make nor2 -orient RY -WP 1.54 -WN 0.385 -origin {800 270}
  make inverter -WP 0.77 -WN 0.385 -origin {290 500}
  make input -name clrb -origin {180 500}
  make MMI_LLCB -origin {1290 -100}
  make_wire 260 400 180 400
  make_wire 840 70 880 70
  make_wire 700 -50 680 -50
  make_wire 700 -50 780 -50
  make_wire 870 -170 840 -170
  make_wire 870 -170 880 -170
  make_wire 180 250 300 250
  make_wire 680 -50 680 250
  make_wire 680 250 780 250
  make_wire 880 -50 960 -50
  make_wire 960 -50 960 250
  make_wire 880 -50 880 -170
  make_wire 880 -50 880 70
  make_wire 460 250 380 250
  make_wire 460 250 520 250
  make_wire 530 140 550 140
  make_wire 530 140 500 140
  make_wire 550 140 550 210
  make_wire 550 280 550 400
  make_wire 340 400 410 400
  make_wire 410 400 550 400
  make_wire 580 250 680 250
  make_wire 1300 250 1390 250
  make_wire 1110 250 1220 250
  make_wire 960 250 960 270
  make_wire 180 500 260 500
  make_wire 340 500 690 500
  make_wire 690 290 690 500
  make_wire 690 290 780 290
  make_wire 870 270 960 270
  make_wire 960 250 1030 250
  make_text -origin {100 -110} -text {Latch with negative enable and clear (for mmi25 compatability)}
  make_text -origin {100 -90} -text {B Size}
  make_text -origin {100 -130} -text MMI_LLCB -size large
}

proc ICON_MMI_LLCB args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-10 100} -orient R270 -name clk
  icon_term -type input -origin {-30 100} -orient R270 -name clrb
  icon_term -type input -origin {-60 0} -name d
  icon_term -type output -origin {60 0} -name q
  icon_property -origin {-50 210} -type user -name name
  icon_property -origin {-50 230} -type user -name M
  icon_property -origin {-50 250} -type user -name dpc
  icon_line -60 80 -60 -80 60 -80 60 80 -60 80
  icon_arc -40 80 -20 100 -start 0 -extent 359
  icon_arc -20 80 0 100 -start 0 -extent 359
  icon_property -origin {0 -50} -size large -anchor center -label LLC
  icon_property -origin {0 -30} -size large -anchor center -label B
  icon_property -origin {-50 0} -label d
  icon_property -origin {50 0} -anchor e -label q
  icon_property -origin {-30 70} -anchor e -rotate 1 -label clrb
  icon_property -origin {-10 70} -anchor e -rotate 1 -label clk
  icon_property -origin {-290 290} -type fixed -name verilog -text {MMI_LLCB [unique_name "" $name MMI_LLCB] (.d(${d}), .clk(${clk}), .clrb(${clrb}), .q(${q}))\;}
}


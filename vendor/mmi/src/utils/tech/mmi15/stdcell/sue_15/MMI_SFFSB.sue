# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_SFFSB {} {
  make input -name clk -origin {-100 630}
  generate name_net_s name_net -cell name_net
  make name_net -name clk_L -origin {130 630}
  make name_net -orient RX -name clk -origin {390 160}
  make name_net -orient RX -name clk_L -origin {390 80}
  make global -name gnd -origin {330 280}
  make global -orient RY -name vdd -origin {330 -40}
  make global -name gnd -origin {780 290}
  make global -orient RY -name vdd -origin {780 -30}
  make name_net -orient RX -name clk -origin {840 90}
  make name_net -orient RX -name clk_L -origin {840 170}
  make name_net -orient RXY -name clk_L -origin {150 370}
  make name_net -orient RX -name clk -origin {150 300}
  make name_net -name clk_L -origin {560 300}
  make name_net -orient RY -name clk -origin {560 390}
  make global -name gnd -origin {-680 540}
  make inverter -WP 1.04 -WN 0.52 -origin {-990 500}
  make global -name gnd -origin {-280 540}
  make global -orient RY -name vdd -origin {-680 140}
  make global -orient RY -name vdd -origin {-280 140}
  make name_net -name scan_en_L -origin {-860 500}
  make name_net -name N1 -origin {-90 340}
  make name_net -name N2 -origin {250 120}
  make name_net -name N3 -origin {480 340}
  make name_net -name N4 -origin {700 130}
  make name_net -name N5 -origin {870 10}
  make inverter -WP 1.54 -WN 0.77 -origin {950 340}
  make pmos -W 1.54 -origin {-680 280}
  make pmos -W 1.54 -origin {-680 180}
  make nmos -W 0.77 -origin {-680 500}
  make nmos -W 0.77 -origin {-680 400}
  make inverter -WP 0.77 -WN 0.385 -origin {10 630}
  make pmos -W 0.77 -origin {-280 280}
  make nmos -W 0.385 -origin {-280 400}
  make nmos -W 0.385 -origin {-280 500}
  make pmos -W 0.77 -origin {-280 180}
  make nmos -orient RX -W 0.35 -origin {780 250}
  make pmos -orient RX -W 0.35 -origin {780 90}
  make nmos -orient RX -W 0.35 -origin {780 170}
  make pmos -orient RX -W 0.35 -origin {780 10}
  make pmos -orient RX -W 0.35 -origin {330 0}
  make pmos -orient RX -W 0.35 -origin {330 80}
  make nmos -orient RX -W 0.35 -origin {330 160}
  make nmos -orient RX -W 0.35 -origin {330 240}
  make xgate -orient RY -WP 0.77 -WN 0.35 -origin {560 340}
  make xgate -orient RXY -WP 0.77 -WN 0.35 -origin {150 340}
  make input -name s_en -origin {-1090 500}
  make input -name s_in -origin {-480 500}
  make output -name s_out -origin {1030 490}
  make nand2 -WP 0.70 -WN 0.70 -origin {940 490}
  make name_net_s -name s_en -origin {850 510}
  make input -name setb -origin {-100 510}
  make nor2 -orient RY -WP 1.54 -WN 0.52 -origin {750 380}
  make nand2 -WP 0.77 -WN 0.77 -origin {310 380}
  make inverter -WP 1.04 -WN 0.52 -origin {400 510}
  make name_net -name set -origin {550 510}
  make input -name d -origin {-790 280}
  make output -name q -origin {1020 340}
  make MMI_SFFSB -origin {1240 -140}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 01/05/00 -origin {-300 870}
  make_wire -20 630 -100 630
  make_wire 380 380 430 380
  make_wire 60 630 130 630
  make_wire 390 240 430 240
  make_wire 430 240 430 340
  make_wire 430 0 430 240
  make_wire 390 0 430 0
  make_wire 840 250 880 250
  make_wire 880 10 880 250
  make_wire 560 370 560 390
  make_wire 590 340 680 340
  make_wire 180 340 230 340
  make_wire 880 340 920 340
  make_wire 1000 340 1020 340
  make_wire -680 320 -680 340
  make_wire -680 220 -680 240
  make_wire -390 180 -390 500
  make_wire -280 460 -280 440
  make_wire -280 220 -280 240
  make_wire -280 340 -280 360
  make_wire -280 320 -280 340
  make_wire -1090 500 -1060 500
  make_wire -1060 500 -1020 500
  make_wire -560 180 -480 400
  make_wire -600 400 -480 280
  make_wire -860 500 -940 500
  make_wire -90 340 -280 340
  make_wire -90 340 120 340
  make_wire 250 120 230 120
  make_wire 250 120 330 120
  make_wire 480 340 530 340
  make_wire 480 340 430 340
  make_wire 700 130 680 130
  make_wire 700 130 780 130
  make_wire 870 10 840 10
  make_wire 870 10 880 10
  make_wire -480 280 -340 280
  make_wire -340 400 -480 400
  make_wire -680 340 -280 340
  make_wire -680 340 -680 360
  make_wire -1060 180 -1060 500
  make_wire -1060 180 -740 180
  make_wire -740 180 -560 180
  make_wire -680 440 -680 460
  make_wire -600 500 -600 400
  make_wire -860 500 -740 500
  make_wire -740 500 -600 500
  make_wire -770 280 -770 400
  make_wire -770 400 -740 400
  make_wire -770 280 -740 280
  make_wire -770 280 -790 280
  make_wire -390 180 -340 180
  make_wire -390 500 -480 500
  make_wire -390 500 -340 500
  make_wire 820 380 880 380
  make_wire 880 250 880 340
  make_wire 880 340 880 380
  make_wire 680 360 730 360
  make_wire 680 130 680 340
  make_wire 680 340 680 360
  make_wire 230 360 290 360
  make_wire 230 120 230 340
  make_wire 230 340 230 360
  make_wire 430 340 430 380
  make_wire 670 510 670 400
  make_wire 670 400 730 400
  make_wire 220 400 290 400
  make_wire 220 400 220 510
  make_wire 1010 490 1030 490
  make_wire 880 380 880 470
  make_wire 880 470 920 470
  make_wire 850 510 920 510
  make_wire 850 510 780 510
  make_wire -100 510 220 510
  make_wire 220 510 370 510
  make_wire 550 510 450 510
  make_wire 550 510 670 510
  make_text -origin {-1310 -110} -text {Flipflop with asynchronous set (active low)}
  make_text -origin {-1310 -90} -text {B Size}
  make_text -origin {-1310 -130} -text MMI_SFFSB -size large
  make_text -origin {-600 70} -text {inverting 2:1 mux} -size large
  make_text -origin {640 600} -text {^.ic N4=0V}
}

proc ICON_MMI_SFFSB args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-10 80} -orient R270 -name clk
  icon_term -type input -origin {-30 100} -orient R270 -name setb
  icon_term -type input -origin {10 80} -orient R270 -name s_en
  icon_term -type input -origin {30 80} -orient R270 -name s_in
  icon_term -type output -origin {60 20} -name s_out
  icon_term -type input -origin {-60 0} -name d
  icon_term -type output -origin {60 0} -name q
  icon_line -60 80 -60 -80 60 -80 60 80 -60 80
  icon_arc -40 80 -20 100 -start 0 -extent 359
  icon_property -origin {0 -50} -size large -anchor center -label SFFS
  icon_property -origin {0 -30} -size large -anchor center -label B
  icon_property -origin {-50 0} -label d
  icon_property -origin {50 0} -anchor e -label q
  icon_property -origin {-30 70} -anchor e -rotate 1 -label setb
  icon_property -origin {-10 70} -anchor e -rotate 1 -label clk
  icon_property -origin {10 70} -anchor e -rotate 1 -label s_en
  icon_property -origin {30 70} -anchor e -rotate 1 -label s_in
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  icon_property -origin {50 20} -anchor e -label s_out
  icon_property -origin {-40 360} -type auto -name verilog -text {MMI_SFFSB [unique_name "" $name MMI_SFFSB]
(.clk($clk), .setb($setb), .s_en($s_en), .s_in($s_in), 
.d($d), .s_out($s_out), .q($q))\;}
}


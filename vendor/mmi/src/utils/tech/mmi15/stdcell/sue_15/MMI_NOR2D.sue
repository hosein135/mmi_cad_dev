# SUE version MMI_SUE4.2.2

proc SCHEMATIC_MMI_NOR2D {} {
  make global -name gnd -origin {0 140}
  make global -orient RY -name vdd -origin {0 -140}
  make output -name out -origin {570 50}
  make global -name gnd -origin {500 140}
  make input -name in1 -origin {-100 -100}
  make input -name in0 -origin {-100 0}
  make MMI_NOR2D -origin {700 -230}
  make nmos -W 3.08 -origin {500 100}
  make nmos -W 3.08 -origin {0 100}
  make pmos -W 4.105 -origin {0 -100}
  make pmos -W 4.105 -origin {150 -100}
  make pmos -W 4.105 -origin {0 0}
  make pmos -W 4.105 -origin {150 0}
  make pmos -W 4.105 -origin {280 0}
  make pmos -W 4.105 -origin {280 -100}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 08/21/00 -origin {200 370}
  make_wire 0 60 0 50
  make_wire 0 40 0 50
  make_wire 0 -40 0 -60
  make_wire -60 0 -100 0
  make_wire -60 -100 -100 -100
  make_wire 500 60 500 50
  make_wire -60 0 -60 100
  make_wire 90 -100 -60 -100
  make_wire 0 -140 150 -140
  make_wire 150 40 150 50
  make_wire 150 50 0 50
  make_wire 150 -60 150 -40
  make_wire -60 0 90 0
  make_wire 440 -100 440 100
  make_wire 500 50 570 50
  make_wire 280 40 280 50
  make_wire 280 -60 280 -40
  make_wire 220 -100 440 -100
  make_wire 220 -100 90 -100
  make_wire 280 50 500 50
  make_wire 280 50 150 50
  make_wire 150 -140 280 -140
  make_wire 90 0 220 0
  make_text -origin {-180 -200} -text {2 Input NOR}
  make_text -origin {-180 -180} -text {D Size}
  make_text -origin {-180 -220} -text MMI_NOR2D -size large
}

proc ICON_MMI_NOR2D args {
  set size D
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "D")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_NOR2 icon body
  if {$DeMorgan} {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line 40 0 60 0
    icon_arc -60 10 -40 30 -start 0 -extent 359
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_line -40 -20 -60 -20
    icon_line -40 20 -60 20
    icon_arc 40 -10 60 10 -start 0 -extent 359
  }
  # properties
  icon_property -origin {-37 -22} -size small -label F
  icon_property -origin {0 0} -size large -anchor center -label $size
  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_NOR2D
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


# SUE version MMI_SUE4.2.2

proc SCHEMATIC_MMI_TSBUFE {} {
  make MMI_TSBUFE -origin {1060 -90}
  make global -name gnd -origin {580 430}
  make global -orient RY -name vdd -origin {580 70}
  make global -name gnd -origin {990 370}
  make global -orient RY -name vdd -origin {990 130}
  make output -name out -origin {1030 250}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {890 330}
  make global -name gnd -origin {760 430}
  make global -orient RY -name vdd -origin {760 70}
  make input -name in -origin {460 110}
  make input -name enb -origin {460 320}
  make input -name en -origin {470 10}
  make input -orient RX -name in -origin {820 390}
  make name_net -name N2 -origin {890 170}
  make pmos -W 12.32 -origin {990 170}
  make nmos -W 6.16 -origin {990 330}
  make nmos -orient RX -W 2.08 -origin {760 390}
  make nmos -W 1.04 -origin {580 390}
  make nmos -orient RX -W 1.04 -origin {760 250}
  make pmos -W 3.36 -origin {580 110}
  make pmos -W 1.68 -origin {580 250}
  make pmos -orient RX -W 1.68 -origin {760 110}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 08/21/00 -origin {590 540}
  make_wire 990 250 990 210
  make_wire 990 250 990 290
  make_wire 580 330 580 350
  make_wire 580 290 580 330
  make_wire 500 390 520 390
  make_wire 500 250 520 250
  make_wire 580 170 580 150
  make_wire 580 170 580 210
  make_wire 760 350 760 330
  make_wire 760 330 580 330
  make_wire 760 150 760 170
  make_wire 580 170 760 170
  make_wire 760 170 760 210
  make_wire 760 290 760 330
  make_wire 520 110 460 110
  make_wire 460 320 500 320
  make_wire 500 320 500 250
  make_wire 500 320 500 390
  make_wire 820 250 860 250
  make_wire 860 250 860 110
  make_wire 860 110 820 110
  make_wire 470 10 860 10
  make_wire 860 10 860 110
  make_wire 990 250 1030 250
  make_wire 890 170 760 170
  make_wire 890 170 930 170
  make_wire 760 330 890 330
  make_wire 890 330 930 330
  make_text -origin {350 -100} -text {Tristate Buffer}
  make_text -origin {350 -80} -text {E Size}
  make_text -origin {350 -120} -text MMI_TSBUFE -size large
}

proc ICON_MMI_TSBUFE args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-60 0} -name in
  icon_term -type output -origin {60 0} -name out
  icon_term -type input -origin {-60 -70} -name enb
  icon_term -type input -origin {-60 60} -name en
  icon_line 30 0 60 0
  icon_line -30 0 -60 0
  icon_property -origin {-10 0} -size large -anchor center -label E
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  icon_line -60 60 -10 60 0 60 0 20
  icon_arc -10 -40 10 -20 -start 0 -extent 359
  icon_line -60 -70 0 -70 0 -40
  icon_line 30 0 -30 40 -30 -30 -30 -40 30 0
  icon_property -origin {-40 360} -type auto -name verilog -text {MMI_TSBUFE [unique_name "" $name MMI_TSBUFE]
(.in($in), .enb($enb), .en($en), .out($out))\;}
}


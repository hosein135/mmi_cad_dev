# SUE version MMI_SUE4.1.11

proc SCHEMATIC_MMI_MUXI4C {} {
  make MMI_MUXI4C -origin {1900 -550}
  make output -name out -origin {1880 -50}
  make input -name sel1 -origin {1270 490}
  generate name_net_s name_net -cell name_net
  make name_net -name sel1_L -origin {1560 490}
  make name_net -name N1 -origin {1440 -300}
  make name_net -name N2 -origin {1660 -300}
  make xgate -orient RY -WP 1.54 -WN 0.77 -origin {1560 -300}
  make xgate -orient RY -WP 1.54 -WN 0.77 -origin {1560 170}
  make inverter -WP 0.77 -WN 0.385 -origin {1460 490}
  make xgate -WP 1.54 -WN 0.77 -origin {1160 -400}
  make inverter -WP 1.54 -WN 0.77 -origin {1010 -400}
  make xgate -WP 1.54 -WN 0.77 -origin {1160 -190}
  make inverter -WP 1.54 -WN 0.77 -origin {1010 -190}
  make input -name in0 -origin {790 -400}
  make input -name sel0 -origin {800 -290}
  make input -name in1 -origin {790 -190}
  make inverter -WP 1.54 -WN 0.77 -origin {1350 -300}
  make xgate -WP 1.54 -WN 0.77 -origin {1150 70}
  make inverter -WP 1.54 -WN 0.77 -origin {1000 70}
  make xgate -WP 1.54 -WN 0.77 -origin {1150 280}
  make inverter -WP 1.54 -WN 0.77 -origin {1000 280}
  make inverter -WP 1.54 -WN 0.77 -origin {1340 170}
  make input -name in2 -origin {780 70}
  make input -name in3 -origin {780 280}
  make name_net -name N3 -origin {1450 170}
  make name_net -name sel0_L -origin {1050 -30}
  make inverter -WP 1.54 -WN 0.77 -origin {950 -30}
  make inverter -WP 3.08 -WN 1.54 -origin {1800 -50}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 05/01/00 -origin {1160 610}
  make_wire 1850 -50 1880 -50
  make_wire 1560 -370 1560 -340
  make_wire 1720 -50 1770 -50
  make_wire 1560 230 1560 200
  make_wire 1500 230 1560 230
  make_wire 1380 230 1500 230
  make_wire 1450 170 1530 170
  make_wire 1060 -400 1130 -400
  make_wire 1190 -400 1270 -400
  make_wire 980 -400 790 -400
  make_wire 1060 -190 1130 -190
  make_wire 1190 -190 1270 -190
  make_wire 980 -190 790 -190
  make_wire 1160 -290 1160 -360
  make_wire 1160 -290 1160 -220
  make_wire 840 -290 800 -290
  make_wire 840 -290 1160 -290
  make_wire 1160 -70 1160 -150
  make_wire 1100 -450 1160 -450
  make_wire 1100 -70 1160 -70
  make_wire 1160 -450 1160 -430
  make_wire 1530 -300 1440 -300
  make_wire 1400 -300 1440 -300
  make_wire 1320 -300 1270 -300
  make_wire 1270 -300 1270 -190
  make_wire 1270 -300 1270 -400
  make_wire 1560 -60 1620 -60
  make_wire 1050 70 1120 70
  make_wire 1180 70 1260 70
  make_wire 970 70 780 70
  make_wire 1050 280 1120 280
  make_wire 1180 280 1260 280
  make_wire 970 280 780 280
  make_wire 1150 180 1150 110
  make_wire 1150 180 1150 250
  make_wire 1150 400 1150 320
  make_wire 1100 20 1100 400
  make_wire 1310 170 1260 170
  make_wire 1260 170 1260 280
  make_wire 1260 170 1260 70
  make_wire 1500 -370 1500 230
  make_wire 1500 -370 1560 -370
  make_wire 1380 230 1380 490
  make_wire 1270 490 1380 490
  make_wire 1380 490 1430 490
  make_wire 1390 170 1450 170
  make_wire 1720 -300 1720 -50
  make_wire 1720 -50 1720 170
  make_wire 1590 -300 1660 -300
  make_wire 1660 -300 1720 -300
  make_wire 1590 170 1720 170
  make_wire 1620 -60 1620 490
  make_wire 1510 490 1560 490
  make_wire 1560 490 1620 490
  make_wire 1560 -270 1560 -60
  make_wire 1560 -60 1560 130
  make_wire 840 180 1150 180
  make_wire 840 -30 920 -30
  make_wire 840 -30 840 180
  make_wire 840 -30 840 -290
  make_wire 1100 -450 1100 -70
  make_wire 1100 -70 1100 -30
  make_wire 1100 400 1150 400
  make_wire 1100 20 1150 20
  make_wire 1150 20 1150 40
  make_wire 1100 20 1100 -30
  make_wire 1050 -30 1000 -30
  make_wire 1050 -30 1100 -30
  make_text -origin {710 -560} -text {Inverting 4:1 Mux }
  make_text -origin {710 -540} -text {C Size}
  make_text -origin {710 -580} -text MMI_MUXI4C -size large
}

proc ICON_MMI_MUXI4C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_MUXI4 icon body
  icon_line -40 -130 -40 130 40 90 40 -90 -40 -130
  if {$DeMorgan} {
    icon_arc -60 -80 -40 -100 -start 0 -extent 359
    icon_arc -60 -20 -40 -40 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc -60 80 -40 100 -start 0 -extent 359
    icon_line 60 0 40 0
  } else {
    icon_line -60 -90 -40 -90
    icon_line -60 -30 -40 -30
    icon_line -60 30 -40 30
    icon_line -60 90 -40 90
    icon_arc 60 -10 40 10 -start 0 -extent 359
  }
  # properties
  icon_property -origin {-37 -90} -size small -label 0
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-20 112} -size small -label 0 -anchor center
  # inputs
  icon_term -type input -origin {-60 -90} -name in0
  icon_term -type input -origin {-60 -30} -name in1
  icon_term -type input -origin {-60 30} -name in2
  icon_term -type input -origin {-60 90} -name in3
  icon_term -type input -origin {-20 120} -orient R270 -name sel0
  icon_term -type input -origin {20 100} -orient R270 -name sel1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_MUXI4C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .in3(\$\{in3\}), .sel0(\$\{sel0\}), .sel1(\$\{sel1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


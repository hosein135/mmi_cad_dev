# SUE version MMI_SUE4.1.11

proc SCHEMATIC_MMI_MUX2D {} {
  make MMI_MUX2D -origin {780 90}
  make input -name sel -origin {-10 370}
  make input -name in0 -origin {-20 260}
  make input -name in1 -origin {-20 470}
  make output -name out -origin {720 360}
  make xgate -WP 3.08 -WN 1.54 -origin {350 260}
  make inverter -WP 3.08 -WN 1.54 -origin {200 260}
  make inverter -WP 3.08 -WN 1.54 -origin {200 470}
  make xgate -WP 3.08 -WN 1.54 -origin {350 470}
  make inverter -WP 1.04 -WN 0.52 -origin {100 590}
  make inverter -WP 6.16 -WN 3.08 -origin {600 360}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 04/28/00 -origin {270 780}
  make_wire 250 260 320 260
  make_wire 380 260 460 260
  make_wire 170 260 -20 260
  make_wire 250 470 320 470
  make_wire 380 470 460 470
  make_wire 170 470 -20 470
  make_wire 350 370 350 300
  make_wire 350 370 350 440
  make_wire 30 370 30 590
  make_wire 30 590 70 590
  make_wire 30 370 -10 370
  make_wire 30 370 350 370
  make_wire 350 590 350 510
  make_wire 290 210 350 210
  make_wire 290 590 150 590
  make_wire 290 590 350 590
  make_wire 290 210 290 590
  make_wire 350 210 350 230
  make_wire 460 360 460 470
  make_wire 460 360 460 260
  make_wire 460 360 570 360
  make_wire 650 360 720 360
  make_text -origin {-140 100} -text {D Size}
  make_text -origin {-140 80} -text {2:1 Mux}
  make_text -origin {-140 60} -text MMI_MUX2D -size large
}

proc ICON_MMI_MUX2D args {
  set size D
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "D")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_MUX2 icon body
  icon_line -40 -70 -40 70 40 30 40 -30 -40 -70
  if {$DeMorgan} {
    icon_arc -60 -20 -40 -40 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc 60 -10 40 10 -start 0 -extent 359
  } else {
    icon_line -60 -30 -40 -30
    icon_line -60 30 -40 30
    icon_line 60 0 40 0
  }
  # properties
  icon_property -origin {-37 -30} -size small -label 0 
  icon_property -origin {0 0} -size large -anchor center -label $size
  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 30} -name in1
  icon_term -type input -origin {0 50} -orient R270 -name sel
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_MUX2D
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .sel(\$\{sel\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_OAI22B {} {
  make global -orient RY -name vdd -origin {0 -200}
  make global -orient RY -name vdd -origin {340 -200}
  make global -name gnd -origin {0 200}
  make output -name out -origin {590 0}
  make global -orient RY -name vdd -origin {70 -200}
  make global -orient RY -name vdd -origin {410 -200}
  make global -name gnd -origin {70 200}
  make global -name gnd -origin {340 200}
  make global -name gnd -origin {410 200}
  make input -name in0 -origin {-60 60}
  make input -name in1 -origin {-60 -160}
  make input -name in2 -origin {-60 160}
  make input -name in3 -origin {250 160}
  make MMI_OAI22B -origin {670 -350}
  make nmos -W 0.77 -origin {0 60}
  make nmos -W 0.77 -origin {70 60}
  make nmos -W 0.77 -origin {0 160}
  make nmos -W 0.77 -origin {70 160}
  make nmos -W 0.77 -origin {340 60}
  make nmos -W 0.77 -origin {410 60}
  make nmos -W 0.77 -origin {410 160}
  make nmos -W 0.77 -origin {340 160}
  make pmos -W 1.54 -origin {0 -60}
  make pmos -W 1.54 -origin {70 -60}
  make pmos -W 1.54 -origin {0 -160}
  make pmos -W 1.54 -origin {70 -160}
  make pmos -W 1.54 -origin {340 -160}
  make pmos -W 1.54 -origin {410 -160}
  make pmos -W 1.54 -origin {410 -60}
  make pmos -W 1.54 -origin {340 -60}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {170 330}
  make_wire 0 -20 0 0
  make_wire 0 20 0 0
  make_wire 340 20 340 0
  make_wire 340 -20 340 0
  make_wire 0 120 0 100
  make_wire 340 120 340 100
  make_wire -60 60 -60 -60
  make_wire 140 -160 140 60
  make_wire 140 60 280 60
  make_wire 170 160 170 -60
  make_wire 250 160 250 -160
  make_wire 250 -160 280 -160
  make_wire 70 0 340 0
  make_wire 70 0 0 0
  make_wire 70 100 70 120
  make_wire 70 100 340 100
  make_wire 70 100 0 100
  make_wire 70 0 70 20
  make_wire -60 60 10 60
  make_wire 70 -20 70 0
  make_wire 10 -160 -60 -160
  make_wire 10 -160 140 -160
  make_wire -60 -60 10 -60
  make_wire 410 0 340 0
  make_wire 410 0 590 0
  make_wire 410 -20 410 0
  make_wire 280 -160 350 -160
  make_wire 410 0 410 20
  make_wire 280 60 350 60
  make_wire 170 -60 280 -60
  make_wire 280 -60 350 -60
  make_wire -60 160 10 160
  make_wire 10 160 170 160
  make_wire 410 100 410 120
  make_wire 250 160 280 160
  make_wire 280 160 350 160
  make_wire 340 100 410 100
  make_wire 340 -100 340 -120
  make_wire 410 -100 410 -120
  make_wire 70 -100 70 -120
  make_wire 0 -100 0 -120
  make_text -origin {-130 -300} -text {B Size}
  make_text -origin {-130 -340} -text MMI_OAI22B -size large
  make_text -origin {-130 -320} -text {Inverting OR-AND 2,2 Gate}
}

proc ICON_MMI_OAI22B args {
  set size B
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "B")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_OAI22 icon body
  if {$DeMorgan} {
    # or
    icon_line -10 -30 40 -30
    icon_line -10 30 40 30
    icon_arc -20 -30 90 110 -start 35 -extent 50
    icon_arc -20 -110 90 30 -start 275 -extent 50
    icon_arc -20 -30 0 30 -start 270 -extent 180
    # ands
    icon_line -40 0 -80 0 -80 60 -40 60
    icon_line -40 -60 -80 -60 -80 0 -40 0
    icon_arc -80 0 -10 60 -start 277 -extent 166
    icon_arc -80 -60 -10 0 -start 277 -extent 166
    # bubbles
    icon_arc -100 40 -80 60 -start 0 -extent 359
    icon_arc -100 0 -80 20 -start 0 -extent 359
    icon_arc -100 -20 -80 0 -start 0 -extent 359
    icon_arc -100 -60 -80 -40 -start 0 -extent 359
    icon_line 80 0 100 0
    # properties
    icon_property -origin {-77 -52} -size small -label F
    icon_property -origin {-77 8} -size small -label F
    icon_property -origin {3 -22} -size small -label F
    icon_property -origin {30 0} -size large -anchor center -label $size
  } else {
    # ors
    icon_line -88 -60 -40 -60
    icon_line -88 0 -40 0
    icon_arc -100 -140 10 0 -start 275 -extent 50
    icon_arc -100 0 10 140 -start 35 -extent 50
    icon_arc -98 -60 -78 0 -start 270 -extent 180
    icon_line -88 0 -40 0
    icon_line -88 60 -40 60
    icon_arc -100 -80 10 60 -start 275 -extent 50
    icon_arc -100 -60 10 80 -start 35 -extent 50
    icon_arc -98 0 -78 60 -start 270 -extent 180
    # and
    icon_line 50 -30 0 -30 0 30 50 30
    icon_arc 10 -30 80 30 -start 277 -extent 166
    # stubs
    icon_line -100 -50 -80 -50
    icon_line -100 -10 -80 -10
    icon_line -100 10 -80 10
    icon_line -100 50 -80 50
    icon_arc 80 -10 100 10 -start 0 -extent 359
    # properties
    icon_property -origin {30 0} -size large -anchor center -label $size
    icon_property -origin {-77 -52} -size small -label F
    icon_property -origin {-77 8} -size small -label F
    icon_property -origin {3 -22} -size small -label F
  }
  # inputs
  icon_term -type input -origin {-100 -50} -name in0
  icon_term -type input -origin {-100 -10} -name in1
  icon_term -type input -origin {-100 10} -name in2
  icon_term -type input -origin {-100 50} -name in3
  # outputs
  icon_term -type output -origin {100 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_OAI22B
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .in3(\$\{in3\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


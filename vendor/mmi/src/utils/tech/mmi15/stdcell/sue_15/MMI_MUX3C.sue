# SUE version MMI_SUE4.1.11

proc SCHEMATIC_MMI_MUX3C {} {
  make MMI_MUX3C -origin {1710 -260}
  make output -name out -origin {1690 50}
  make input -name in2 -origin {1130 300}
  make input -name sel1 -origin {1130 490}
  generate name_net_s name_net -cell name_net
  make name_net -name sel1_L -origin {1420 490}
  make name_net -name in2_L -origin {1310 300}
  make name_net -name N1 -origin {1300 -30}
  make name_net -name N2 -origin {1520 -30}
  make xgate -orient RY -WP 1.54 -WN 0.77 -origin {1420 -30}
  make xgate -orient RY -WP 1.54 -WN 0.77 -origin {1420 300}
  make inverter -WP 1.54 -WN 0.77 -origin {1210 300}
  make inverter -WP 0.77 -WN 0.385 -origin {1290 490}
  make xgate -WP 1.54 -WN 0.77 -origin {1020 -130}
  make inverter -WP 1.54 -WN 0.77 -origin {870 -130}
  make xgate -WP 1.54 -WN 0.77 -origin {1020 80}
  make inverter -WP 1.54 -WN 0.77 -origin {870 80}
  make inverter -WP 0.77 -WN 0.385 -origin {770 200}
  make input -name in0 -origin {650 -130}
  make input -name sel0 -origin {660 -20}
  make input -name in1 -origin {650 80}
  make inverter -WP 3.08 -WN 1.54 -origin {1610 50}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.5 -date 05/01/00 -origin {980 640}
  make_wire 1660 50 1690 50
  make_wire 1420 -100 1420 -70
  make_wire 1530 50 1580 50
  make_wire 1450 300 1530 300
  make_wire 1420 360 1420 330
  make_wire 1360 360 1420 360
  make_wire 1240 360 1360 360
  make_wire 1240 360 1240 490
  make_wire 1420 490 1340 490
  make_wire 1420 490 1480 490
  make_wire 1310 300 1260 300
  make_wire 1310 300 1390 300
  make_wire 1520 -30 1450 -30
  make_wire 1520 -30 1530 -30
  make_wire 1420 0 1420 110
  make_wire 1420 110 1420 260
  make_wire 1530 -30 1530 50
  make_wire 1530 50 1530 300
  make_wire 1360 -100 1360 360
  make_wire 1360 -100 1420 -100
  make_wire 1480 110 1480 490
  make_wire 1420 110 1480 110
  make_wire 920 -130 990 -130
  make_wire 1050 -130 1130 -130
  make_wire 1130 -130 1130 -30
  make_wire 840 -130 650 -130
  make_wire 920 80 990 80
  make_wire 1050 80 1130 80
  make_wire 840 80 650 80
  make_wire 1130 80 1130 -30
  make_wire 1020 -20 1020 -90
  make_wire 1020 -20 1020 50
  make_wire 700 -20 700 200
  make_wire 700 200 740 200
  make_wire 700 -20 660 -20
  make_wire 700 -20 1020 -20
  make_wire 1020 200 1020 120
  make_wire 960 -180 1020 -180
  make_wire 960 200 820 200
  make_wire 960 200 1020 200
  make_wire 960 -180 960 200
  make_wire 1020 -180 1020 -160
  make_wire 1130 -30 1300 -30
  make_wire 1390 -30 1300 -30
  make_wire 1180 300 1130 300
  make_wire 1130 490 1240 490
  make_wire 1240 490 1260 490
  make_text -origin {540 -260} -text {C Size}
  make_text -origin {540 -290} -text {3:1 Mux}
  make_text -origin {540 -320} -text MMI_MUX3C -size large
}

proc ICON_MMI_MUX3C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_MUX3 icon body
  icon_line -40 -100 -40 100 40 60 40 -60 -40 -100
  if {$DeMorgan} {
    icon_arc -60 -50 -40 -70 -start 0 -extent 359
    icon_arc -60 -10 -40 10 -start 0 -extent 359
    icon_arc -60 50 -40 70 -start 0 -extent 359
    icon_arc 60 -10 40 10 -start 0 -extent 359
  } else {
    icon_line -60 -60 -40 -60
    icon_line -60 0 -40 0
    icon_line -60 60 -40 60
    icon_line 60 0 40 0
  }
  # properties
  icon_property -origin {-37 -60} -size small -label 0
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-20 82} -size small -label 0 -anchor center
  # inputs
  icon_term -type input -origin {-60 -60} -name in0
  icon_term -type input -origin {-60 0} -name in1
  icon_term -type input -origin {-60 60} -name in2
  icon_term -type input -origin {-20 90} -orient R270 -name sel0
  icon_term -type input -origin {20 70} -orient R270 -name sel1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_MUX3C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .sel0(\$\{sel0\}), .sel1(\$\{sel1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


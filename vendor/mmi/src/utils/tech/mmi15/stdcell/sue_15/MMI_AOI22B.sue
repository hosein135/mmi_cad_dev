# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_AOI22B {} {
  make global -name gnd -origin {540 580}
  make global -orient RY -name vdd -origin {220 180}
  make output -name out -origin {660 380}
  make global -name gnd -origin {220 580}
  make global -name gnd -origin {300 580}
  make global -name gnd -origin {610 580}
  make input -name in0 -origin {90 440}
  make input -name in1 -origin {90 540}
  make input -name in2 -origin {440 440}
  make input -name in3 -origin {440 540}
  make global -orient RY -name vdd -origin {300 180}
  make global -orient RY -name vdd -origin {540 180}
  make global -orient RY -name vdd -origin {610 180}
  make MMI_AOI22B -origin {770 80}
  make nmos -W 0.77 -origin {220 440}
  make nmos -W 0.77 -origin {300 440}
  make nmos -W 0.77 -origin {300 540}
  make nmos -W 0.77 -origin {220 540}
  make nmos -W 0.77 -origin {540 540}
  make nmos -W 0.77 -origin {610 540}
  make nmos -W 0.77 -origin {610 440}
  make nmos -W 0.77 -origin {540 440}
  make pmos -W 1.54 -origin {220 320}
  make pmos -W 1.54 -origin {300 320}
  make pmos -orient RX -W 1.54 -origin {220 220}
  make pmos -orient RX -W 1.54 -origin {300 220}
  make pmos -W 1.54 -origin {540 320}
  make pmos -W 1.54 -origin {610 320}
  make pmos -W 1.54 -origin {610 220}
  make pmos -W 1.54 -origin {540 220}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {270 770}
  make_wire 220 400 220 380
  make_wire 220 360 220 380
  make_wire 540 260 540 280
  make_wire 130 320 160 320
  make_wire 130 440 90 440
  make_wire 130 320 130 440
  make_wire 540 380 540 400
  make_wire 540 360 540 380
  make_wire 480 320 340 320
  make_wire 340 320 340 540
  make_wire 160 540 90 540
  make_wire 440 440 480 440
  make_wire 480 220 460 220
  make_wire 460 220 460 540
  make_wire 460 540 480 540
  make_wire 460 540 440 540
  make_wire 240 540 160 540
  make_wire 240 540 340 540
  make_wire 300 380 300 400
  make_wire 300 380 540 380
  make_wire 220 380 300 380
  make_wire 160 440 130 440
  make_wire 160 440 240 440
  make_wire 300 360 300 380
  make_wire 300 280 220 280
  make_wire 300 280 540 280
  make_wire 220 260 220 280
  make_wire 440 220 440 440
  make_wire 300 260 300 280
  make_wire 240 320 160 320
  make_wire 610 380 540 380
  make_wire 610 380 660 380
  make_wire 610 360 610 380
  make_wire 610 260 610 280
  make_wire 480 220 550 220
  make_wire 480 320 550 320
  make_wire 540 280 610 280
  make_wire 610 380 610 400
  make_wire 480 440 550 440
  make_wire 480 540 550 540
  make_wire 610 500 610 480
  make_wire 540 480 540 500
  make_wire 300 500 300 480
  make_wire 220 480 220 500
  make_wire 360 220 440 220
  make_wire 280 220 360 220
  make_text -origin {60 110} -text {Inverting AND-OR 2,2 Gate}
  make_text -origin {60 130} -text {B Size}
  make_text -origin {60 90} -text MMI_AOI22B -size large
}

proc ICON_MMI_AOI22B args {
  set size B
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "B")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_AOI22 icon body
  if {$DeMorgan} {
    # ors
    icon_line -88 -60 -40 -60
    icon_line -88 0 -40 0
    icon_arc -100 -140 10 0 -start 275 -extent 50
    icon_arc -100 0 10 140 -start 35 -extent 50
    icon_arc -98 -60 -78 0 -start 270 -extent 180
    icon_line -88 0 -40 0
    icon_line -88 60 -40 60
    icon_arc -100 -80 10 60 -start 275 -extent 50
    icon_arc -100 -60 10 80 -start 35 -extent 50
    icon_arc -98 0 -78 60 -start 270 -extent 180
    # and
    icon_line 50 -30 0 -30 0 30 50 30
    icon_arc 10 -30 80 30 -start 277 -extent 166
    # bubbles
    icon_arc -100 40 -80 60 -start 0 -extent 359
    icon_arc -100 0 -80 20 -start 0 -extent 359
    icon_arc -100 -20 -80 0 -start 0 -extent 359
    icon_arc -100 -60 -80 -40 -start 0 -extent 359
    icon_line 80 0 100 0
    # properties
    icon_property -origin {30 0} -size large -anchor center -label $size
    icon_property -origin {-77 -52} -size small -label F
    icon_property -origin {-77 8} -size small -label F
    icon_property -origin {3 -22} -size small -label F
  } else {
    # or
    icon_line -10 -30 40 -30
    icon_line -10 30 40 30
    icon_arc -20 -30 90 110 -start 35 -extent 50
    icon_arc -20 -110 90 30 -start 275 -extent 50
    icon_arc -20 -30 0 30 -start 270 -extent 180
    # ands
    icon_line -40 0 -80 0 -80 60 -40 60
    icon_line -40 -60 -80 -60 -80 0 -40 0
    icon_arc -80 0 -10 60 -start 277 -extent 166
    icon_arc -80 -60 -10 0 -start 277 -extent 166
    # stubs
    icon_line -100 -50 -80 -50
    icon_line -100 -10 -80 -10
    icon_line -100 10 -80 10
    icon_line -100 50 -80 50
    icon_arc 80 -10 100 10 -start 0 -extent 359
    # properties
    icon_property -origin {-77 -52} -size small -label F
    icon_property -origin {-77 8} -size small -label F
    icon_property -origin {3 -22} -size small -label F
    icon_property -origin {30 0} -size large -anchor center -label $size
  }
  # inputs
  icon_term -type input -origin {-100 -50} -name in0
  icon_term -type input -origin {-100 -10} -name in1
  icon_term -type input -origin {-100 10} -name in2
  icon_term -type input -origin {-100 50} -name in3
  # outputs
  icon_term -type output -origin {100 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_AOI22B
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .in3(\$\{in3\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


  make input -name s_en -origin {-1200 -900}
  make input -name s_in -origin {-590 -900}
  make inverter -WP 1.04 -WN 0.52 -origin {-100 -890}
  make name_net -name clear -origin {20 -890}
  make nand2 -WP 0.77 -WN 1.04 -origin {640 -1020}
  make nor2 -orient RY -WP 1.54 -WN 0.385 -origin {200 -1020}
  make input -name clrb -origin {-210 -890}
  make output -name s_out -origin {920 -910}
  make nand2 -WP 0.70 -WN 0.70 -origin {830 -910}
  make name_net_s -name s_en -origin {740 -890}
  make input -name d -origin {-900 -1120}
  make output -name q -origin {910 -1060}
  make MMI_SFFCB -origin {970 -1560}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 01/05/00 -origin {-390 -490}
  make_wire -130 -770 -210 -770

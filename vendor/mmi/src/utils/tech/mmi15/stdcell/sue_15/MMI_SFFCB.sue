# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_SFFCB {} {
  make input -name clk -origin {-210 -770}
  generate name_net_s name_net -cell name_net
  make name_net -name clk_L -origin {20 -770}
  make name_net -orient RX -name clk -origin {280 -1240}
  make name_net -orient RX -name clk_L -origin {280 -1320}
  make global -name gnd -origin {220 -1120}
  make global -orient RY -name vdd -origin {220 -1440}

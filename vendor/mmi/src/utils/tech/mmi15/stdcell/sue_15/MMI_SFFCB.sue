  make name_net -name N5 -origin {760 -1390}
  make inverter -WP 1.54 -WN 0.77 -origin {840 -1060}
  make pmos -W 1.54 -origin {-790 -1120}
  make pmos -W 1.54 -origin {-790 -1220}
  make nmos -W 0.77 -origin {-790 -900}
  make nmos -W 0.77 -origin {-790 -1000}
  make inverter -WP 0.77 -WN 0.385 -origin {-100 -770}
  make pmos -W 0.77 -origin {-390 -1120}
  make nmos -W 0.385 -origin {-390 -1000}
  make nmos -W 0.385 -origin {-390 -900}
  make pmos -W 0.77 -origin {-390 -1220}
  make nmos -orient RX -W 0.35 -origin {670 -1150}

# Created using mapper from:
#"MMI_XOR2 {A {MMI_XOR2A {in0 in0} {in1 in1} {out out}} {MMI_XOR2A_ {in0 in0} {in1 in1} {out out}}} {B {MMI_XOR2B {in0 in0} {in1 in1} {out out}} {MMI_XOR2B_ {in0 in0} {in1 in1} {out out}}} {C {MMI_XOR2C {in0 in0} {in1 in1} {out out}} {MMI_XOR2C_ {in0 in0} {in1 in1} {out out}}} "

proc SCHEMATIC_MMI_XOR2 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    A {

  make input -name in1 -origin {170 370}
  make input -name in0 -origin {170 330}
  make output -name out -origin {740 430}
  make MMI_NOR2A -origin {340 350}
  make MMI_AOI21A -origin {600 430}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 12/06/99 -origin {350 740}
  make_wire 400 350 500 350
  make_wire 500 350 500 400
  make_wire 250 370 250 430
  make_wire 250 430 500 430
  make_wire 250 370 170 370
  make_wire 250 370 280 370
  make_wire 210 330 210 470
  make_wire 210 470 500 470
  make_wire 210 330 280 330
  make_wire 210 330 170 330
  make_wire 700 430 740 430
  make_text -origin {20 90} -text {Exclusive OR}
  make_text -origin {20 110} -text {A Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_XOR2 MMI_XOR2A -Size A -DeMorgan 0
        make MMI_XOR2A -origin "$urx $ury"
      } else {
        generate MMI_XOR2 MMI_XOR2A_ -Size A -DeMorgan 1
        make MMI_XOR2A_ -origin "$urx $ury"
      }
    }

    B {

  make input -name in1 -origin {230 360}
  make input -name in0 -origin {230 320}
  make output -name out -origin {800 420}
  make MMI_NOR2A -origin {400 340}
  make MMI_AOI21B -origin {660 420}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 12/06/99 -origin {410 730}
  make_wire 460 340 560 340
  make_wire 560 340 560 390
  make_wire 310 360 310 420
  make_wire 310 420 560 420
  make_wire 310 360 230 360
  make_wire 310 360 340 360
  make_wire 270 320 270 460
  make_wire 270 460 560 460
  make_wire 270 320 340 320
  make_wire 270 320 230 320
  make_wire 760 420 800 420
  make_text -origin {70 90} -text {Exclusive OR}
  make_text -origin {70 110} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_XOR2 MMI_XOR2B -Size B -DeMorgan 0
        make MMI_XOR2B -origin "$urx $ury"
      } else {
        generate MMI_XOR2 MMI_XOR2B_ -Size B -DeMorgan 1
        make MMI_XOR2B_ -origin "$urx $ury"
      }
    }

    C {

  make input -name in1 -origin {130 380}
  make input -name in0 -origin {130 340}
  make output -name out -origin {700 440}
  make MMI_AOI21C -origin {560 440}
  make MMI_NOR2B -origin {300 360}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 12/06/99 -origin {320 740}
  make_wire 360 360 460 360
  make_wire 460 360 460 410
  make_wire 210 380 210 440
  make_wire 210 440 460 440
  make_wire 210 380 130 380
  make_wire 210 380 240 380
  make_wire 170 340 170 480
  make_wire 170 480 460 480
  make_wire 170 340 240 340
  make_wire 170 340 130 340
  make_wire 660 440 700 440
  make_text -origin {-20 100} -text {Exclusive OR}
  make_text -origin {-20 120} -text {C Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_XOR2 MMI_XOR2C -Size C -DeMorgan 0
        make MMI_XOR2C -origin "$urx $ury"
      } else {
        generate MMI_XOR2 MMI_XOR2C_ -Size C -DeMorgan 1
        make MMI_XOR2C_ -origin "$urx $ury"
      }
    }

  }
}


proc NAME_MMI_XOR2 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set nom MMI_XOR2[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_XOR2 args {
  icon_generator $args {{Size "A" {radio A B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "A") && ($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_XOR2 icon body
  icon_arc -60 -30 50 110 -start 35 -extent 50
  icon_arc -48 -30 -28 30 -start 270 -extent 180
  icon_line -38 -30 0 -30
  icon_line -38 30 0 30
  icon_arc -60 -110 50 30 -start 275 -extent 50
  icon_arc -58 -30 -38 30 -start 270 -extent 180
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-27 -20} -size small -label F

  if {$DeMorgan} {
    icon_line 40 0 60 0
    icon_arc -60 30 -40 10 -start 0 -extent 359
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_line 40 0 60 0
    icon_line -60 20 -40 20
    icon_line -60 -20 -40 -20
  }

  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1

  # outputs
  icon_term -type output -origin {60 0} -name out




  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_XOR2 -Size $Size]
  set nname [NAME_MMI_XOR2 -Size $Size -DeMorgan $DeMorgan]
  switch $size {
    A {
    set pnames ".in0(\$in0), .in1(\$in1), .out(\$out)"
    }
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .out(\$out)"
    }
    C {
    set pnames ".in0(\$in0), .in1(\$in1), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
}

# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_INOR2A {} {
  make output -name out -origin {220 -20}
  generate name_net_s name_net -cell name_net
  make name_net -name in1_L -origin {10 -40}
  make input -name in1 -origin {-190 -40}
  make input -name in0 -origin {-190 0}
  make MMI_INOR2A -origin {530 -230}
  make nor2 -orient RY -WP 1.84 -WN 0.46 -origin {120 -20}
  make inverter -WP .92 -WN 0.46 -origin {-120 -40}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {30 150}
  make_wire -190 -40 -150 -40
  make_wire 190 -20 220 -20
  make_wire -190 0 100 0
  make_wire 10 -40 -70 -40
  make_wire 10 -40 100 -40
  make_text -origin {-180 -200} -text {2 Input NOR with one inverted input}
  make_text -origin {-180 -180} -text {A Size}
  make_text -origin {-180 -220} -text MMI_INOR2A -size large
}

proc ICON_MMI_INOR2A args {
  set size A
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "A")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_INOR2 icon body
  if {$DeMorgan} {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line -60 20 -40 20
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
    icon_line 40 0 60 0
  } else {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_arc -60 30 -40 10 -start 0 -extent 359
    icon_line -40 -20 -60 -20
    icon_arc 40 -10 60 10 -start 0 -extent 359
  }
  # properties
  icon_property -origin {-37 -22} -size small -label F
  icon_property -origin {0 0} -size large -anchor center -label $size
  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_INOR2A
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


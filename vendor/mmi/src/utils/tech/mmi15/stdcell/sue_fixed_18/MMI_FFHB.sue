  make_text -origin {-590 -1640} -text {Flipflop (with hold mux on input)}
  make_text -origin {-590 -1610} -text {B Size}
  make_text -origin {-590 -1670} -text MMI_FFHB -size large
  make_text -origin {270 -700} -text {^.ic N4=0V}

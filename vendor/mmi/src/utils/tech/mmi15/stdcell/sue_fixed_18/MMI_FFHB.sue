  make global -orient RY -name vdd -origin {670 -1430}
  make name_net -orient RX -name clk -origin {730 -1310}
  make name_net -orient RX -name clk_L -origin {730 -1230}
  make name_net -orient RXY -name clk_L -origin {40 -1030}
  make name_net -orient RX -name clk -origin {40 -1100}
  make name_net -name clk_L -origin {450 -1100}
  make name_net -orient RY -name clk -origin {450 -1010}

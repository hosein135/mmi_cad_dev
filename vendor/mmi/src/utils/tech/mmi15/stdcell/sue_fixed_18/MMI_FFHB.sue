  make_wire -390 -1040 -390 -1060
  make_wire -390 -1060 -500 -1060
  make_wire -500 -870 -390 -870
  make_wire -390 -870 -390 -880
  make_wire -590 -1200 -560 -1200
  make_wire -620 -1200 -590 -1200
  make_wire -300 -920 -270 -920
  make_wire -330 -920 -300 -920
  make_wire -290 -1120 -260 -1120

# Created using mapper from:
#"MMI_NOR3 {A {MMI_NOR3A {in0 in0} {in1 in1} {in2 in2} {out out}} {MMI_NOR3A_ {in0 in0} {in1 in1} {in2 in2} {out out}}} {B {MMI_NOR3B {in0 in0} {in1 in1} {in2 in2} {out out}} {MMI_NOR3B_ {in0 in0} {in1 in1} {in2 in2} {out out}}} "

proc SCHEMATIC_MMI_NOR3 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    A {

  make global -name gnd -origin {0 140}
  make global -name gnd -origin {150 140}
  make input -name in1 -origin {-100 -100}
  make global -name gnd -origin {290 140}
  make global -orient RY -name vdd -origin {0 -240}
  make output -name out -origin {340 50}
  make input -name in2 -origin {-100 -200}
  make input -name in0 -origin {-100 0}
  make nmos -W 0.385 -origin {0 100}
  make nmos -W 0.385 -origin {150 100}
  make nmos -W 0.385 -origin {290 100}
  make pmos -W 2.31 -origin {0 0}
  make pmos -W 2.31 -origin {0 -100}
  make pmos -W 2.31 -origin {0 -200}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {20 300}
  make_wire 0 -40 0 -60
  make_wire 90 100 90 -100
  make_wire 290 60 290 50
  make_wire 0 -140 0 -160
  make_wire 230 100 230 -200
  make_wire 340 50 290 50
  make_wire 150 50 150 60
  make_wire 0 40 0 50
  make_wire 0 50 0 60
  make_wire -100 0 -60 0
  make_wire -60 0 -60 100
  make_wire 0 50 150 50
  make_wire 150 50 290 50
  make_wire -100 -100 -60 -100
  make_wire -60 -100 90 -100
  make_wire -100 -200 -60 -200
  make_wire -60 -200 230 -200
  make_text -origin {-190 -350} -text {3 Input NOR}
  make_text -origin {-190 -330} -text {A Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_NOR3 MMI_NOR3A -Size A -DeMorgan 0
        make MMI_NOR3A -origin "$urx $ury"
      } else {
        generate MMI_NOR3 MMI_NOR3A_ -Size A -DeMorgan 1
        make MMI_NOR3A_ -origin "$urx $ury"
      }
    }

    B {

  make global -name gnd -origin {0 140}
  make global -name gnd -origin {320 140}
  make input -name in1 -origin {-100 -100}
  make global -name gnd -origin {460 140}
  make global -orient RY -name vdd -origin {0 -240}
  make output -name out -origin {510 50}
  make global -orient RY -name vdd -origin {100 -240}
  make global -orient RY -name vdd -origin {200 -240}
  make input -name in0 -origin {-100 0}
  make input -name in2 -origin {-100 -200}
  make nmos -W 0.77 -origin {0 100}
  make nmos -W 0.77 -origin {320 100}
  make nmos -W 0.77 -origin {460 100}
  make pmos -W 1.54 -origin {0 0}
  make pmos -W 1.54 -origin {100 0}
  make pmos -W 1.54 -origin {200 0}
  make pmos -W 1.54 -origin {0 -100}
  make pmos -W 1.54 -origin {100 -100}
  make pmos -W 1.54 -origin {200 -100}
  make pmos -W 1.54 -origin {0 -200}
  make pmos -W 1.54 -origin {100 -200}
  make pmos -W 1.54 -origin {200 -200}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {110 330}
  make_wire 0 60 0 50
  make_wire 0 40 0 50
  make_wire -60 100 -60 0
  make_wire -100 0 -60 0
  make_wire 0 -40 0 -60
  make_wire 260 100 260 -100
  make_wire 460 60 460 50
  make_wire 0 -140 0 -160
  make_wire 400 100 400 -200
  make_wire -100 -200 -60 -200
  make_wire -100 -100 -60 -100
  make_wire 510 50 460 50
  make_wire 100 40 100 50
  make_wire 100 -40 100 -60
  make_wire 100 -140 100 -160
  make_wire 40 -100 -60 -100
  make_wire 40 -200 -60 -200
  make_wire 100 50 0 50
  make_wire 200 40 200 50
  make_wire 200 -40 200 -60
  make_wire 200 -140 200 -160
  make_wire 140 -200 40 -200
  make_wire 140 -200 400 -200
  make_wire 200 50 100 50
  make_wire 320 50 320 60
  make_wire 320 50 460 50
  make_wire 320 50 200 50
  make_wire 40 -100 140 -100
  make_wire 140 -100 260 -100
  make_wire 40 0 -60 0
  make_wire 40 0 140 0
  make_text -origin {-190 -340} -text {3 Input NOR}
  make_text -origin {-190 -320} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
      if {!$DeMorgan} {
        generate MMI_NOR3 MMI_NOR3B -Size B -DeMorgan 0
        make MMI_NOR3B -origin "$urx $ury"
      } else {
        generate MMI_NOR3 MMI_NOR3B_ -Size B -DeMorgan 1
        make MMI_NOR3B_ -origin "$urx $ury"
      }
    }

  }
}


proc NAME_MMI_NOR3 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set nom MMI_NOR3[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_NOR3 args {
  icon_generator $args {{Size "A" {radio A B}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "A") && ($size != "B")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_NOR3 icon body
  if {$DeMorgan} {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line 40 0 60 0
    icon_arc -60 10 -40 30 -start 0 -extent 359
    icon_arc -60 -10 -40 10 -start 0 -extent 359
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_line -40 -20 -60 -20
    icon_line -38 0 -60 0
    icon_line -40 20 -60 20
    icon_arc 40 -10 60 10 -start 0 -extent 359
  }

  # properties
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-37 -22} -size small -label F

  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 0} -name in1
  icon_term -type input -origin {-60 20} -name in2

  # outputs
  icon_term -type output -origin {60 0} -name out


  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_NOR3 -Size $Size]
  set nname [NAME_MMI_NOR3 -Size $Size -DeMorgan $DeMorgan]
  switch $size {
    A {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .out(\$out)"
    }
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
}

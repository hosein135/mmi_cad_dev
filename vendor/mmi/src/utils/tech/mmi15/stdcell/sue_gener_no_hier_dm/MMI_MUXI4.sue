# Created using mapper from:
#"MMI_MUXI4 {B {MMI_MUXI4B {in0 in0} {in1 in1} {in2 in2} {in3 in3} {sel0 sel0} {sel1 sel1} {out out}} {MMI_MUXI4B_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {sel0 sel0} {sel1 sel1} {out out}}} {C {MMI_MUXI4C {in0 in0} {in1 in1} {in2 in2} {in3 in3} {sel0 sel0} {sel1 sel1} {out out}} {MMI_MUXI4C_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {sel0 sel0} {sel1 sel1} {out out}}} "

proc SCHEMATIC_MMI_MUXI4 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    B {

  make output -name out -origin {1900 -100}
  make input -name sel1 -origin {1290 440}
  generate name_net_s name_net -cell name_net
  make name_net -name sel1_L -origin {1580 440}
  make name_net -name N1 -origin {1460 -350}
  make name_net -name N2 -origin {1680 -350}
  make xgate -orient RY -WP 1.54 -WN 0.77 -origin {1580 -350}
  make xgate -orient RY -WP 1.54 -WN 0.77 -origin {1580 120}
  make inverter -WP 0.77 -WN 0.385 -origin {1480 440}
  make xgate -WP 1.54 -WN 0.77 -origin {1180 -450}
  make inverter -WP 1.54 -WN 0.77 -origin {1030 -450}
  make xgate -WP 1.54 -WN 0.77 -origin {1180 -240}
  make inverter -WP 1.54 -WN 0.77 -origin {1030 -240}
  make input -name in0 -origin {810 -450}
  make input -name sel0 -origin {820 -340}
  make input -name in1 -origin {810 -240}
  make inverter -WP 1.54 -WN 0.77 -origin {1820 -100}
  make inverter -WP 1.54 -WN 0.77 -origin {1370 -350}
  make xgate -WP 1.54 -WN 0.77 -origin {1170 20}
  make inverter -WP 1.54 -WN 0.77 -origin {1020 20}
  make xgate -WP 1.54 -WN 0.77 -origin {1170 230}
  make inverter -WP 1.54 -WN 0.77 -origin {1020 230}
  make inverter -WP 1.54 -WN 0.77 -origin {1360 120}
  make input -name in2 -origin {800 20}
  make input -name in3 -origin {800 230}
  make name_net -name N3 -origin {1470 120}
  make name_net -name sel0_L -origin {1070 -80}
  make inverter -WP 1.54 -WN 0.77 -origin {970 -80}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 12/09/99 -origin {1240 620}
  make_wire 1870 -100 1900 -100
  make_wire 1580 -420 1580 -390
  make_wire 1740 -100 1790 -100
  make_wire 1580 180 1580 150
  make_wire 1520 180 1580 180
  make_wire 1400 180 1520 180
  make_wire 1470 120 1550 120
  make_wire 1080 -450 1150 -450

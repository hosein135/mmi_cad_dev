# Created using mapper from:
#"MMI_OA22 {B {MMI_OA22B {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_OA22B_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} {C {MMI_OA22C {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_OA22C_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} "

proc SCHEMATIC_MMI_OA22 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    B {
      if {!$DeMorgan} {

  make global -name gnd -origin {470 580}
  make global -orient RY -name vdd -origin {220 180}
  make output -name out -origin {720 380}
  make global -name gnd -origin {220 580}
  make global -orient RY -name vdd -origin {470 180}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {540 380}
  make input -name in0 -origin {90 440}
  make input -name in1 -origin {370 440}
  make input -name in2 -origin {90 540}
  make input -name in3 -origin {370 540}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP 1.54 -WN 0.77 -origin {630 380}
  make nmos -W 0.77 -origin {470 440}
  make nmos -W 0.77 -origin {470 540}
  make nmos -W 0.77 -origin {220 540}
  make nmos -W 0.77 -origin {220 440}
  make pmos -W 1.54 -origin {470 320}
  make pmos -W 1.54 -origin {470 220}
  make pmos -orient RX -W 1.54 -origin {220 220}
  make pmos -W 1.54 -origin {220 320}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {290 790}
  make_wire 220 400 220 380
  make_wire 220 360 220 380
  make_wire 220 380 470 380
  make_wire 220 260 220 280
  make_wire 470 500 470 480
  make_wire 470 260 470 280
  make_wire 130 320 160 320
  make_wire 130 440 160 440
  make_wire 130 440 90 440
  make_wire 370 440 370 220
  make_wire 130 320 130 440
  make_wire 470 380 470 400
  make_wire 680 380 720 380
  make_wire 220 500 220 480
  make_wire 470 360 470 380
  make_wire 410 320 270 320
  make_wire 270 320 270 540
  make_wire 270 540 160 540
  make_wire 160 540 90 540
  make_wire 370 440 410 440
  make_wire 410 220 390 220
  make_wire 390 220 390 540
  make_wire 390 540 410 540
  make_wire 390 540 370 540
  make_wire 220 500 470 500
  make_wire 280 220 370 220
  make_wire 540 380 470 380
  make_wire 540 380 600 380
  make_text -origin {40 150} -text {B Size}
  make_text -origin {40 130} -text {OR-AND 2,2 Gate}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_OA22 MMI_OA22B -Size B -DeMorgan 0
        make MMI_OA22B -origin "$urx $ury"
      } else {
        generate MMI_OA22 MMI_OA22B -Size B -DeMorgan 0
        make MMI_OA22B -origin {0 0}
        set terms [api_terminal_data MMI_OA22B]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_OA22B"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {in2} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in2} -orient $orient
        } else {
          make $type -origin $origin -name {in2}
        }
        set data [get_assoc {in3} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in3} -orient $orient
        } else {
          make $type -origin $origin -name {in3}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_OA22 MMI_OA22B_ -Size B -DeMorgan 1
        make MMI_OA22B_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    C {
      if {!$DeMorgan} {

  make global -name gnd -origin {470 580}
  make global -orient RY -name vdd -origin {220 180}
  make output -name out -origin {740 380}
  make global -name gnd -origin {220 580}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {550 380}
  make global -orient RY -name vdd -origin {470 180}
  make input -name in0 -origin {90 440}
  make input -name in2 -origin {90 540}
  make input -name in1 -origin {370 440}
  make input -name in3 -origin {370 540}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP 3.08 -WN 1.54 -origin {650 380}
  make nmos -W 1.04 -origin {220 440}
  make nmos -W 1.04 -origin {220 540}
  make nmos -W 1.04 -origin {470 540}
  make nmos -W 1.04 -origin {470 440}
  make pmos -W 2.08 -origin {220 320}
  make pmos -orient RX -W 2.08 -origin {220 220}
  make pmos -W 2.08 -origin {470 220}
  make pmos -W 2.08 -origin {470 320}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.2 -date 12/02/99 -origin {360 750}
  make_wire 220 400 220 380
  make_wire 220 360 220 380
  make_wire 220 380 470 380
  make_wire 220 260 220 280
  make_wire 470 500 470 480
  make_wire 470 260 470 280
  make_wire 130 320 160 320
  make_wire 130 440 160 440
  make_wire 130 440 90 440
  make_wire 370 440 370 220
  make_wire 130 320 130 440
  make_wire 470 380 470 400
  make_wire 700 380 740 380
  make_wire 220 500 220 480
  make_wire 470 360 470 380
  make_wire 410 320 270 320
  make_wire 270 320 270 540
  make_wire 270 540 160 540
  make_wire 160 540 90 540
  make_wire 370 440 410 440
  make_wire 410 220 390 220
  make_wire 390 220 390 540
  make_wire 390 540 410 540
  make_wire 390 540 370 540
  make_wire 220 500 470 500
  make_wire 550 380 470 380
  make_wire 550 380 620 380
  make_wire 280 220 370 220
  make_text -origin {60 140} -text {C Size}
  make_text -origin {60 120} -text {OR-AND 2,2 Gate}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_OA22 MMI_OA22C -Size C -DeMorgan 0
        make MMI_OA22C -origin "$urx $ury"
      } else {
        generate MMI_OA22 MMI_OA22C -Size C -DeMorgan 0
        make MMI_OA22C -origin {0 0}
        set terms [api_terminal_data MMI_OA22C]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_OA22C"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {in2} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in2} -orient $orient
        } else {
          make $type -origin $origin -name {in2}
        }
        set data [get_assoc {in3} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in3} -orient $orient
        } else {
          make $type -origin $origin -name {in3}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_OA22 MMI_OA22C_ -Size C -DeMorgan 1
        make MMI_OA22C_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

  }
}


proc NAME_MMI_OA22 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set nom MMI_OA22[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_OA22 args {
  icon_generator $args {{Size "B" {radio B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_OA22 icon body
  if {$DeMorgan} {
    # or
    icon_line -10 -30 40 -30
    icon_line -10 30 40 30
    icon_arc -20 -30 90 110 -start 35 -extent 50
    icon_arc -20 -110 90 30 -start 275 -extent 50
    icon_arc -20 -30 0 30 -start 270 -extent 180
    # ands
    icon_line -40 0 -80 0 -80 60 -40 60
    icon_line -40 -60 -80 -60 -80 0 -40 0
    icon_arc -80 0 -10 60 -start 277 -extent 166
    icon_arc -80 -60 -10 0 -start 277 -extent 166
    # bubbles
    icon_arc -100 40 -80 60 -start 0 -extent 359
    icon_arc -100 0 -80 20 -start 0 -extent 359
    icon_arc -100 -20 -80 0 -start 0 -extent 359
    icon_arc -100 -60 -80 -40 -start 0 -extent 359
    icon_arc 80 -10 100 10 -start 0 -extent 359
    # properties
    icon_property -origin {-77 -52} -size small -label F
    icon_property -origin {-77 8} -size small -label F
    icon_property -origin {3 -22} -size small -label F
    icon_property -origin {30 0} -size large -anchor center -label $size
  } else {
    # ors
    icon_line -88 -60 -40 -60
    icon_line -88 0 -40 0
    icon_arc -100 -140 10 0 -start 275 -extent 50
    icon_arc -100 0 10 140 -start 35 -extent 50
    icon_arc -98 -60 -78 0 -start 270 -extent 180
    icon_line -88 0 -40 0
    icon_line -88 60 -40 60
    icon_arc -100 -80 10 60 -start 275 -extent 50
    icon_arc -100 -60 10 80 -start 35 -extent 50
    icon_arc -98 0 -78 60 -start 270 -extent 180
    # and
    icon_line 50 -30 0 -30 0 30 50 30
    icon_arc 10 -30 80 30 -start 277 -extent 166
    # stubs
    icon_line -100 -50 -80 -50
    icon_line -100 -10 -80 -10
    icon_line -100 10 -80 10
    icon_line -100 50 -80 50
    icon_line 80 0 100 0
    # properties
    icon_property -origin {30 0} -size large -anchor center -label $size
    icon_property -origin {-77 -52} -size small -label F
    icon_property -origin {-77 8} -size small -label F
    icon_property -origin {3 -22} -size small -label F
  }

  # inputs
  icon_term -type input -origin {-100 -50} -name in0
  icon_term -type input -origin {-100 -10} -name in1
  icon_term -type input -origin {-100 10} -name in2
  icon_term -type input -origin {-100 50} -name in3

  # outputs
  icon_term -type output -origin {100 0} -name out



  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_OA22 -Size $Size]
  set nname [NAME_MMI_OA22 -Size $Size -DeMorgan $DeMorgan]
  if {!$DeMorgan} {
  switch $size {
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .in3(\$in3), .out(\$out)"
    }
    C {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .in3(\$in3), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

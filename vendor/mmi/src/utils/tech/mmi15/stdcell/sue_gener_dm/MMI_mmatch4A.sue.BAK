proc ICON_MMI_mmatch4A args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-160 -140} -name in0
  icon_term -type input -origin {-160 -100} -name in1
  icon_term -type input -origin {-160 -60} -name in2
  icon_term -type input -origin {-160 -20} -name in3
  icon_term -type output -origin {160 -80} -name mm_out
  icon_property -origin {-50 70} -type user -name name
  icon_property -origin {-50 90} -type user -name M
  icon_property -origin {-50 110} -type user -name dpc
  icon_property -origin {0 -120} -size large -anchor center -label MMI_mmatch4
  icon_property -origin {150 -80} -anchor e -label mm_out
  icon_property -origin {-150 -140} -label in0
  icon_property -origin {-150 -100} -label in1
  icon_property -origin {-150 -60} -label in2
  icon_property -origin {-150 -20} -label in3
  icon_property -origin {0 -80} -size large -anchor center -label A
  icon_line -160 -160 -160 0 160 0 160 -160 -160 -160
  icon_property -origin {-530 180} -type fixed -name verilog -text {MMI_mmatch4A [unique_name "" $name MMI_mmatch4A] (.in0($in0), .in1($in1), .in2($in2), .in3($in3), .mm_out($mm_out))\;}
}


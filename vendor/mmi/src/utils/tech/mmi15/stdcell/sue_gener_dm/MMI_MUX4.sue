        make MMI_MUX4B_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    C {
      if {!$DeMorgan} {

  make output -name out -origin {1750 -60}
  make input -name sel1 -origin {1140 480}
  generate name_net_s name_net -cell name_net
  make name_net -name sel1_L -origin {1430 480}

  make_wire 970 410 1030 410
  make_wire 970 30 970 410
  make_wire 1370 230 1430 230
  make_wire 1430 -20 1490 -20
  make_wire 1250 400 1250 480
  make_wire 1430 -20 1430 130
  make_wire 1370 -350 1430 -350
  make_wire 1250 400 1370 400
  make_wire 1370 -350 1370 230
  make_wire 1370 230 1370 400
  make_wire 1430 -250 1430 -20
  make_wire 1490 -20 1490 480
  make_wire 1140 170 1400 170
  make_wire 1140 170 1140 290
  make_wire 1140 170 1140 80
  make_wire 1590 -280 1590 -60
  make_wire 1590 -60 1590 170
  make_wire 1460 -280 1530 -280
  make_wire 1530 -280 1590 -280
  make_wire 1460 170 1590 170
  make_wire 1380 480 1430 480
  make_wire 1430 480 1490 480
  make_wire 1140 480 1250 480
  make_wire 1250 480 1300 480
  make_wire 710 -50 710 190
  make_wire 1030 -50 1030 30
  make_wire 1030 30 1030 50
  make_text -origin {500 -460} -text {C Size}
  make_text -origin {500 -480} -text {4:1 Mux}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_MUX4 MMI_MUX4C -Size C -DeMorgan 0
        make MMI_MUX4C -origin "$urx $ury"
      } else {
        generate MMI_MUX4 MMI_MUX4C -Size C -DeMorgan 0
        make MMI_MUX4C -origin {0 0}
        set terms [api_terminal_data MMI_MUX4C]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_MUX4C"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {in2} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in2} -orient $orient
        } else {
          make $type -origin $origin -name {in2}
        }
        set data [get_assoc {in3} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in3} -orient $orient
        } else {
          make $type -origin $origin -name {in3}
        }
        set data [get_assoc {sel0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {sel0} -orient $orient

proc NAME_MMI_SFF args {
  call_use_keyword $args {{Size "B"}}

  set nom MMI_SFF[string toupper $Size]

  return $nom
}


proc ICON_MMI_SFF args {
  icon_generator $args {{Size "B" {radio B CB SB HB MB}} }

  set size [string toupper $Size]
  set DeMorgan 0

  # check for acceptable response on Size
  if {($size != "B") && ($size != "CB") && ($size != "SB") && ($size != "HB") && ($size != "MB")} {
    error "ERROR: Size ($size) not supported"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  switch $size {
    B {

  icon_term -type input -origin {-10 80} -orient R270 -name clk
  icon_term -type input -origin {30 80} -orient R270 -name s_in
  icon_term -type input -origin {10 80} -orient R270 -name s_en
  icon_term -type output -origin {60 20} -name s_out
  icon_term -type output -origin {60 0} -name q
  icon_term -type input -origin {-60 0} -name d
  icon_line -60 80 -60 -80 60 -80 60 80 -60 80
  icon_property -origin {0 -50} -size large -anchor center -label SFF
  icon_property -origin {0 -30} -size large -anchor center -label B
  icon_property -origin {-50 0} -label d
  icon_property -origin {50 0} -anchor e -label q
  icon_property -origin {-10 70} -anchor e -rotate 1 -label clk
  icon_property -origin {10 70} -anchor e -rotate 1 -label s_en
  icon_property -origin {30 70} -anchor e -rotate 1 -label s_in
  icon_property -origin {50 20} -anchor e -label s_out

    }
    CB {

  icon_term -type input -origin {-10 80} -orient R270 -name clk
  icon_term -type input -origin {-30 100} -orient R270 -name clrb
  icon_term -type input -origin {30 80} -orient R270 -name s_in
  icon_term -type input -origin {10 80} -orient R270 -name s_en
  icon_term -type output -origin {60 20} -name s_out
  icon_term -type input -origin {-60 0} -name d
  icon_term -type output -origin {60 0} -name q
  icon_line -60 80 -60 -80 60 -80 60 80 -60 80
  icon_arc -40 80 -20 100 -start 0 -extent 359
  icon_property -origin {0 -50} -size large -anchor center -label SFFC
  icon_property -origin {0 -30} -size large -anchor center -label B
  icon_property -origin {-50 0} -label d
  icon_property -origin {50 0} -anchor e -label q
  icon_property -origin {-30 70} -anchor e -rotate 1 -label clrb
  icon_property -origin {-10 70} -anchor e -rotate 1 -label clk
  icon_property -origin {10 70} -anchor e -rotate 1 -label s_en
  icon_property -origin {30 70} -anchor e -rotate 1 -label s_in
  icon_property -origin {50 20} -anchor e -label s_out

    }
    SB {

  icon_term -type input -origin {-10 80} -orient R270 -name clk
  icon_term -type input -origin {-30 100} -orient R270 -name setb
  icon_term -type input -origin {10 80} -orient R270 -name s_en
  icon_term -type input -origin {30 80} -orient R270 -name s_in
  icon_term -type output -origin {60 20} -name s_out
  icon_term -type input -origin {-60 0} -name d
  icon_term -type output -origin {60 0} -name q
  icon_line -60 80 -60 -80 60 -80 60 80 -60 80
  icon_arc -40 80 -20 100 -start 0 -extent 359
  icon_property -origin {0 -50} -size large -anchor center -label SFFS
  icon_property -origin {0 -30} -size large -anchor center -label B
  icon_property -origin {-50 0} -label d
  icon_property -origin {50 0} -anchor e -label q
  icon_property -origin {-30 70} -anchor e -rotate 1 -label setb
  icon_property -origin {-10 70} -anchor e -rotate 1 -label clk
  icon_property -origin {10 70} -anchor e -rotate 1 -label s_en
  icon_property -origin {30 70} -anchor e -rotate 1 -label s_in
  icon_property -origin {50 20} -anchor e -label s_out

    }
    HB {

  icon_term -type input -origin {-10 80} -orient R270 -name clk
  icon_term -type input -origin {30 80} -orient R270 -name s_in
  icon_term -type input -origin {10 80} -orient R270 -name s_en
  icon_term -type output -origin {60 20} -name s_out
  icon_term -type input -origin {-60 30} -name hold
  icon_term -type input -origin {-60 0} -name d
  icon_term -type output -origin {60 0} -name q
  icon_line -60 80 -60 -80 60 -80 60 80 -60 80
  icon_property -origin {0 -50} -size large -anchor center -label SFFH
  icon_property -origin {0 -30} -size large -anchor center -label B
  icon_property -origin {-50 0} -label d
  icon_property -origin {50 0} -anchor e -label q
  icon_property -origin {-10 70} -anchor e -rotate 1 -label clk
  icon_property -origin {10 70} -anchor e -rotate 1 -label s_en
  icon_property -origin {30 70} -anchor e -rotate 1 -label s_in
  icon_property -origin {50 20} -anchor e -label s_out
  icon_property -origin {-50 30} -label hold

    }
    MB {

  icon_term -type input -origin {-10 80} -orient R270 -name clk
  icon_term -type input -origin {30 80} -orient R270 -name s_in
  icon_term -type input -origin {10 80} -orient R270 -name s_en
  icon_term -type output -origin {60 20} -name s_out
  icon_term -type output -origin {60 0} -name q
  icon_term -type input -origin {-60 30} -name sel
  icon_term -type input -origin {-60 -20} -name d0
  icon_term -type input -origin {-60 0} -name d1
  icon_line -60 80 -60 -80 60 -80 60 80 -60 80
  icon_property -origin {0 -50} -size large -anchor center -label SFFM
  icon_property -origin {0 -30} -size large -anchor center -label B
  icon_property -origin {-50 0} -label d1
  icon_property -origin {50 0} -anchor e -label q
  icon_property -origin {-10 70} -anchor e -rotate 1 -label clk
  icon_property -origin {10 70} -anchor e -rotate 1 -label s_en
  icon_property -origin {30 70} -anchor e -rotate 1 -label s_in
  icon_property -origin {50 20} -anchor e -label s_out
  icon_property -origin {-50 30} -label sel
  icon_property -origin {-50 -20} -label d0

    }
  }

  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_SFF -Size $Size]
  set nname [NAME_MMI_SFF -Size $Size -DeMorgan $DeMorgan]
  if {!$DeMorgan} {
  switch $size {
    B {
    set pnames ".d(\$d), .clk(\$clk), .s_en(\$s_en), .s_in(\$s_in), .q(\$q), .s_out(\$s_out)"
    }
    CB {
    set pnames ".d(\$d), .clk(\$clk), .clrb(\$clrb), .s_en(\$s_en), .s_in(\$s_in), .q(\$q), .s_out(\$s_out)"
    }
    SB {
    set pnames ".d(\$d), .clk(\$clk), .setb(\$setb), .s_en(\$s_en), .s_in(\$s_in), .q(\$q), .s_out(\$s_out)"
    }
    HB {
    set pnames ".d(\$d), .clk(\$clk), .hold(\$hold), .s_en(\$s_en), .s_in(\$s_in), .q(\$q), .s_out(\$s_out)"
    }
    MB {
    set pnames ".d0(\$d0), .d1(\$d1), .sel(\$sel), .clk(\$clk), .s_en(\$s_en), .s_in(\$s_in), .q(\$q), .s_out(\$s_out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

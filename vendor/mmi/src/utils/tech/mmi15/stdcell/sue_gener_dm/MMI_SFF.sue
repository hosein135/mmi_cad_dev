#"MMI_SFF {B {MMI_SFFB {d d} {clk clk} {s_en s_en} {s_in s_in} {q q} {s_out s_out}}} {CB {MMI_SFFCB {d d} {clk clk} {clrb clrb} {s_en s_en} {s_in s_in} {q q} {s_out s_out}}} {SB {MMI_SFFSB {d d} {clk clk} {setb setb} {s_en s_en} {s_in s_in} {q q} {s_out s_out}}} {HB {MMI_SFFHB {d d} {clk clk} {hold hold} {s_en s_en} {s_in s_in} {q q} {s_out s_out}}} {MB {MMI_SFFMB {d0 d0} {d1 d1} {sel sel} {clk clk} {s_en s_en} {s_in s_in} {q q} {s_out s_out}}} "

proc SCHEMATIC_MMI_SFF args {

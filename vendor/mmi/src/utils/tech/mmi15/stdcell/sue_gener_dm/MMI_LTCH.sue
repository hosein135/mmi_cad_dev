# Created using mapper from:
#"MMI_LTCH {NB {MMI_LTCHNB {d d} {clk clk} {q q}}} {PB {MMI_LTCHPB {d d} {clk clk} {q q}}} "

proc SCHEMATIC_MMI_LTCH args {
  call_use_keyword $args {{Size "NB"}}

  set size [string toupper $Size]

  switch $size {
    NB {

  make input -name d -origin {180 250}
  make input -name clk -origin {180 400}
  generate name_net_s name_net -cell name_net
  make name_net -name clk_L -origin {410 400}
  make global -name gnd -origin {780 110}
  make global -orient RY -name vdd -origin {780 -210}
  make name_net -name N5 -origin {870 -170}
  make inverter -WP 1.54 -WN 0.77 -origin {330 250}
  make nmos -orient RX -W 0.35 -origin {780 70}
  make pmos -orient RX -W 0.35 -origin {780 -90}
  make pmos -orient RX -W 0.35 -origin {780 -170}
  make nmos -orient RX -W 0.35 -origin {780 -10}
  make name_net -name N1 -origin {460 250}
  make name_net -name N2 -origin {700 -50}
  make name_net -name clk -origin {530 140}
  make inverter -WP 0.77 -WN 0.385 -origin {290 400}
  make inverter -WP 1.54 -WN 0.77 -origin {810 410}
  make output -name q -origin {950 410}
  make inverter -WP 0.77 -WN 0.385 -origin {810 250}
  make title_bar -owner dweisner -origin {510 580}
  make xgate -orient RY -WP 1.54 -WN 0.77 -origin {550 250}
  make name_net -orient RX -name clk -origin {840 -10}
  make name_net -orient RX -name clk_L -origin {840 -90}
  make_wire 260 400 180 400
  make_wire 840 70 880 70
  make_wire 700 -50 680 -50
  make_wire 700 -50 780 -50
  make_wire 870 -170 840 -170
  make_wire 870 -170 880 -170
  make_wire 180 250 300 250
  make_wire 680 -50 680 250
  make_wire 680 250 780 250
  make_wire 880 -50 960 -50
  make_wire 960 -50 960 250
  make_wire 960 250 860 250
  make_wire 880 -50 880 -170
  make_wire 880 -50 880 70
  make_wire 460 250 380 250
  make_wire 460 250 520 250
  make_wire 530 140 550 140
  make_wire 530 140 500 140
  make_wire 860 410 950 410
  make_wire 660 250 660 410
  make_wire 660 410 780 410
  make_wire 660 250 680 250
  make_wire 660 250 580 250
  make_wire 550 140 550 210
  make_wire 550 280 550 400
  make_wire 340 400 410 400
  make_wire 410 400 550 400
  make_text -origin {100 -110} -text {Latch with negative enable}
  make_text -origin {100 -90} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_LTCH MMI_LTCHNB -Size NB -DeMorgan 0
        make MMI_LTCHNB -origin "$urx $ury"
    }

    PB {

  make input -name d -origin {180 250}
  make input -name clk -origin {180 400}
  generate name_net_s name_net -cell name_net
  make name_net -name clk_L -origin {410 400}
  make global -name gnd -origin {780 110}
  make global -orient RY -name vdd -origin {780 -210}
  make name_net -orient RX -name clk -origin {840 -90}
  make name_net -orient RX -name clk_L -origin {840 -10}
  make name_net -name N5 -origin {870 -170}
  make xgate -WP 1.54 -WN 0.77 -origin {550 250}
  make inverter -WP 1.54 -WN 0.77 -origin {330 250}
  make nmos -orient RX -W 0.35 -origin {780 70}
  make pmos -orient RX -W 0.35 -origin {780 -90}
  make pmos -orient RX -W 0.35 -origin {780 -170}
  make nmos -orient RX -W 0.35 -origin {780 -10}
  make name_net -name N1 -origin {460 250}
  make name_net -name N2 -origin {700 -50}
  make name_net -name clk -origin {530 140}
  make inverter -WP 0.77 -WN 0.385 -origin {290 400}
  make inverter -WP 1.54 -WN 0.77 -origin {810 410}
  make output -name q -origin {950 410}
  make inverter -WP 0.77 -WN 0.385 -origin {810 250}
  make title_bar -owner dweisner -origin {510 580}
  make_wire 260 400 180 400
  make_wire 340 400 410 400
  make_wire 840 70 880 70
  make_wire 700 -50 680 -50
  make_wire 700 -50 780 -50
  make_wire 870 -170 840 -170
  make_wire 870 -170 880 -170
  make_wire 180 250 300 250
  make_wire 410 400 550 400
  make_wire 550 400 550 290
  make_wire 680 -50 680 250
  make_wire 680 250 780 250
  make_wire 880 -50 960 -50
  make_wire 960 -50 960 250
  make_wire 960 250 860 250
  make_wire 880 -50 880 -170
  make_wire 880 -50 880 70
  make_wire 460 250 380 250
  make_wire 460 250 520 250
  make_wire 550 140 550 220
  make_wire 530 140 550 140
  make_wire 530 140 500 140
  make_wire 860 410 950 410
  make_wire 660 250 660 410
  make_wire 660 410 780 410
  make_wire 660 250 680 250
  make_wire 660 250 580 250
  make_text -origin {100 -110} -text {Latch with posative enable}
  make_text -origin {100 -90} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_LTCH MMI_LTCHPB -Size PB -DeMorgan 0
        make MMI_LTCHPB -origin "$urx $ury"
    }

  }
}


proc NAME_MMI_LTCH args {
  call_use_keyword $args {{Size "NB"}}

  set nom MMI_LTCH[string toupper $Size]

  return $nom
}


proc ICON_MMI_LTCH args {
  icon_generator $args {{Size "NB" {radio NB PB}} }

  set size [string toupper $Size]
  set DeMorgan 0

  # check for acceptable response on Size
  if {($size != "NB") && ($size != "PB")} {
    error "ERROR: Size ($size) not supported"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  switch $size {
    NB {

  icon_term -type input -origin {-100 -80} -name d
  icon_term -type output -origin {100 -80} -name q
  icon_term -type input -origin {-60 20} -orient R270 -name clk
  icon_line -100 -120 -100 0 100 0 100 -120 -100 -120
  icon_property -origin {-20 -90} -label LTCHN
  icon_property -origin {-10 -60} -label B
  icon_property -origin {-90 -80} -label d
  icon_property -origin {-70 -10} -label clk
  icon_property -origin {90 -80} -anchor e -label q
  icon_arc -70 0 -50 20 -start 251 -extent 359

    }
    PB {

  icon_term -type input -origin {-100 -80} -name d
  icon_term -type output -origin {100 -80} -name q
  icon_term -type input -origin {-60 0} -orient R270 -name clk
  icon_line -100 -120 -100 0 100 0 100 -120 -100 -120
  icon_property -origin {-20 -90} -label LTCHP
  icon_property -origin {-10 -60} -label B
  icon_property -origin {-90 -80} -label d
  icon_property -origin {-70 -10} -label clk
  icon_property -origin {90 -80} -anchor e -label q

    }
  }

  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_LTCH -Size $Size]
  set nname [NAME_MMI_LTCH -Size $Size -DeMorgan $DeMorgan]
  if {!$DeMorgan} {
  switch $size {
    NB {
    set pnames ".d(\$d), .clk(\$clk), .q(\$q)"
    }
    PB {
    set pnames ".d(\$d), .clk(\$clk), .q(\$q)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

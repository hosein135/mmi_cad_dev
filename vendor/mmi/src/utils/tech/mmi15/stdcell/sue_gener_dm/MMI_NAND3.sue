# Created using mapper from:
#"MMI_NAND3 {A {MMI_NAND3A {in0 in0} {in1 in1} {in2 in2} {out out}} {MMI_NAND3A_ {in0 in0} {in1 in1} {in2 in2} {out out}}} {B {MMI_NAND3B {in0 in0} {in1 in1} {in2 in2} {out out}} {MMI_NAND3B_ {in0 in0} {in1 in1} {in2 in2} {out out}}} {C {MMI_NAND3C {in0 in0} {in1 in1} {in2 in2} {out out}} {MMI_NAND3C_ {in0 in0} {in1 in1} {in2 in2} {out out}}} "

proc SCHEMATIC_MMI_NAND3 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    A {
      if {!$DeMorgan} {

  make global -orient RY -name vdd -origin {0 -140}
  make input -name in0 -origin {-100 0}
  make global -orient RY -name vdd -origin {160 -140}
  make input -name in1 -origin {-100 100}
  make global -orient RY -name vdd -origin {320 -140}
  make input -name in2 -origin {-100 200}
  make global -name gnd -origin {0 240}
  make output -name out -origin {480 -50}
  make nmos -W 1.155 -origin {0 0}
  make nmos -W 1.155 -origin {0 100}
  make nmos -W 1.155 -origin {0 200}
  make pmos -W 0.77 -origin {0 -100}
  make pmos -W 0.77 -origin {160 -100}
  make pmos -W 0.77 -origin {320 -100}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {130 390}
  make_wire 0 -60 0 -50
  make_wire 0 -40 0 -50
  make_wire -60 -100 -60 0
  make_wire 0 -50 160 -50
  make_wire -100 0 -60 0
  make_wire 160 -60 160 -50
  make_wire -60 100 100 100
  make_wire 0 40 0 60
  make_wire 100 -100 100 100
  make_wire 160 -50 320 -50
  make_wire -100 100 -60 100
  make_wire 320 -60 320 -50
  make_wire -60 200 260 200
  make_wire 0 140 0 160
  make_wire 260 -100 260 200
  make_wire 320 -50 480 -50
  make_wire -100 200 -60 200
  make_text -origin {-150 -220} -text {3 Input NAND}
  make_text -origin {-150 -200} -text {A Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_NAND3 MMI_NAND3A -Size A -DeMorgan 0
        make MMI_NAND3A -origin "$urx $ury"
      } else {
        generate MMI_NAND3 MMI_NAND3A -Size A -DeMorgan 0
        make MMI_NAND3A -origin {0 0}
        set terms [api_terminal_data MMI_NAND3A]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_NAND3A"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {in2} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in2} -orient $orient
        } else {
          make $type -origin $origin -name {in2}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_NAND3 MMI_NAND3A_ -Size A -DeMorgan 1
        make MMI_NAND3A_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    B {
      if {!$DeMorgan} {

  make global -orient RY -name vdd -origin {0 -140}
  make input -name in0 -origin {-100 0}
  make global -orient RY -name vdd -origin {200 -140}
  make input -name in1 -origin {-100 100}
  make global -orient RY -name vdd -origin {360 -140}
  make input -name in2 -origin {-100 200}
  make global -name gnd -origin {0 240}
  make output -name out -origin {480 -50}
  make pmos -W 1.54 -origin {0 -100}
  make pmos -W 1.54 -origin {200 -100}
  make pmos -W 1.54 -origin {360 -100}
  make nmos -W 2.31 -origin {0 0}
  make nmos -W 2.31 -origin {0 100}
  make nmos -W 2.31 -origin {0 200}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {120 390}
  make_wire 0 -60 0 -50
  make_wire 0 -40 0 -50
  make_wire -60 -100 -60 0
  make_wire -100 0 -60 0
  make_wire 200 -60 200 -50
  make_wire 0 40 0 60
  make_wire 140 -100 140 100
  make_wire 360 -60 360 -50
  make_wire 0 140 0 160
  make_wire 300 -100 300 200
  make_wire -100 100 -60 100
  make_wire -100 200 -60 200
  make_wire 200 -50 360 -50
  make_wire 360 -50 480 -50
  make_wire 300 200 -60 200
  make_wire 140 100 -60 100
  make_wire 200 -50 0 -50
  make_text -origin {-160 -210} -text {3 Input NAND}
  make_text -origin {-160 -190} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_NAND3 MMI_NAND3B -Size B -DeMorgan 0
        make MMI_NAND3B -origin "$urx $ury"
      } else {
        generate MMI_NAND3 MMI_NAND3B -Size B -DeMorgan 0
        make MMI_NAND3B -origin {0 0}
        set terms [api_terminal_data MMI_NAND3B]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_NAND3B"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {in2} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in2} -orient $orient
        } else {
          make $type -origin $origin -name {in2}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_NAND3 MMI_NAND3B_ -Size B -DeMorgan 1
        make MMI_NAND3B_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    C {
      if {!$DeMorgan} {

  make global -orient RY -name vdd -origin {-90 -140}
  make input -name in0 -origin {-190 0}
  make global -orient RY -name vdd -origin {100 -140}
  make input -name in1 -origin {-190 100}
  make global -orient RY -name vdd -origin {260 -140}
  make input -name in2 -origin {-190 200}
  make output -name out -origin {350 -50}
  make global -name gnd -origin {-90 260}
  make pmos -W 3.08 -origin {-90 -100}
  make pmos -W 3.08 -origin {100 -100}
  make pmos -W 3.08 -origin {260 -100}
  make nmos -W 4.62 -origin {-90 0}
  make nmos -W 4.62 -origin {-90 100}
  make nmos -W 4.62 -origin {-90 200}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {-20 410}
  make_wire -90 40 -90 60
  make_wire -90 140 -90 160
  make_wire -90 240 -90 260
  make_wire -150 -100 -150 0
  make_wire 100 -60 100 -50
  make_wire 260 -60 260 -50
  make_wire -90 -60 -90 -50
  make_wire -90 -50 -90 -40
  make_wire -190 0 -150 0
  make_wire -190 200 -150 200
  make_wire -190 100 -150 100
  make_wire 200 -100 200 200
  make_wire 40 -100 40 100
  make_wire 350 -50 260 -50
  make_wire -150 200 200 200
  make_wire -90 -50 100 -50
  make_wire 100 -50 260 -50
  make_wire -150 100 40 100
  make_text -origin {-250 -240} -text {3 Input NAND}
  make_text -origin {-250 -220} -text {C Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_NAND3 MMI_NAND3C -Size C -DeMorgan 0
        make MMI_NAND3C -origin "$urx $ury"
      } else {
        generate MMI_NAND3 MMI_NAND3C -Size C -DeMorgan 0
        make MMI_NAND3C -origin {0 0}
        set terms [api_terminal_data MMI_NAND3C]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_NAND3C"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {in2} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in2} -orient $orient
        } else {
          make $type -origin $origin -name {in2}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_NAND3 MMI_NAND3C_ -Size C -DeMorgan 1
        make MMI_NAND3C_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

  }
}


proc NAME_MMI_NAND3 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set nom MMI_NAND3[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_NAND3 args {
  icon_generator $args {{Size "A" {radio A B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "A") && ($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_NAND3 icon body
  if {$DeMorgan} {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_line 40 0 60 0
    icon_arc -60 10 -40 30 -start 0 -extent 359
    icon_arc -60 -10 -40 10 -start 0 -extent 359
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line -40 -20 -60 -20
    icon_line -40 0 -60 0
    icon_line -40 20 -60 20
    icon_arc 40 -10 60 10 -start 0 -extent 359
  }

  # properties
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-37 -22} -size small -label F

  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 0} -name in1
  icon_term -type input -origin {-60 20} -name in2

  # outputs
  icon_term -type output -origin {60 0} -name out


  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_NAND3 -Size $Size]
  set nname [NAME_MMI_NAND3 -Size $Size -DeMorgan $DeMorgan]
  if {!$DeMorgan} {
  switch $size {
    A {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .out(\$out)"
    }
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .out(\$out)"
    }
    C {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

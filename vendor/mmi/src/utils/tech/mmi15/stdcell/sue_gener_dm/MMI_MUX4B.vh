// VERILOG netlist for "MMI_MUX4B" (generated by MMI_SUE4.2.7)

module xgate (in, in_L, t1, t2);
	inout		t1;
	inout		t2;
	input		in;
	input		in_L;
 
	pmos p(t2,t1,in_L);
	nmos n(t2,t1,in);

endmodule		// xgate

module MMI_MUX4B (in0, in1, in2, in3, out, sel0, sel1);
	input		in0;
	input		in1;
	input		in2;
	input		in3;
	input		sel0;
	input		sel1;
	output		out;
 
	wire		sel1_L;
	wire		N2;
	wire		net_1;
	wire		net_2;
	wire		net_3;
	wire		net_4;
	wire		net_5;
	wire		net_6;
	wire		N1;
 
	xgate xgate(.in(sel1_L), .t2(N2), .in_L(sel1), .t1(N1));
	xgate xgate_1(.t1(net_5), .in_L(sel1_L), .t2(N2), .in(sel1));
	assign sel1_L = !(sel1);
	xgate xgate_2(.in(net_3), .t1(net_4), .in_L(sel0), .t2(N1));
	assign net_4 = !(in0);
	xgate xgate_3(.t1(net_1), .in_L(net_3), .in(sel0), .t2(N1));
	assign net_1 = !(in1);
	xgate xgate_4(.t1(net_2), .in(net_3), .t2(net_5), .in_L(sel0));
	assign net_2 = !(in2);
	xgate xgate_5(.in_L(net_3), .t2(net_5), .t1(net_6), .in(sel0));
	assign net_6 = !(in3);
	assign net_3 = !(sel0);
	assign out = !(N2);

endmodule		// MMI_MUX4B


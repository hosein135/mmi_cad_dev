			LAYER M1 ;
			RECT 0.925 2.885 1.205 2.93 ;
			LAYER M1 ;
			RECT 1.98 2.885 2.57 2.93 ;
			LAYER M1 ;
			RECT 0.925 2.695 2.57 2.885 ;
			LAYER M1 ;
			RECT 0.925 2.65 1.205 2.695 ;
			LAYER M1 ;
			RECT 1.98 2.65 2.57 2.695 ;
			LAYER M1 ;
			RECT 1.98 2.6 2.36 2.65 ;
		END

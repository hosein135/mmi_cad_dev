	END in0
	OBS
		LAYER M1 ;
		RECT 0.75 3.7 1.03 4.98 ;
		LAYER M1 ;
		RECT 1.93 3.7 2.21 4.98 ;
		LAYER M1 ;
		RECT 0.75 3.505 2.21 3.7 ;
		LAYER M1 ;
		RECT 2.52 3.51 2.8 4.98 ;
		LAYER M1 ;
		RECT 0.705 2.915 0.985 2.92 ;
		LAYER M1 ;
		RECT 2.52 2.915 2.71 3.51 ;
		LAYER M1 ;
		RECT 0.705 2.725 2.71 2.915 ;
		LAYER M1 ;
		RECT 0.705 2.64 0.985 2.725 ;
		LAYER M1 ;
		RECT 2.385 1.78 2.575 2.725 ;
		LAYER M1 ;
		RECT 2.385 1.465 2.665 1.78 ;
	END
END MMI_XOR2A

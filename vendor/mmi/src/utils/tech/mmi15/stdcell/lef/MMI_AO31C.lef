MACRO MMI_AO31C
	CLASS CORE ;
	FOREIGN MMI_AO31C 0 0 ;
	SIZE 4.34 BY 6.2 ;
	SYMMETRY X Y ;
	SITE CORE1 ;
	PIN out
		DIRECTION output ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 3.195 3.505 3.475 4.975 ;
			LAYER M1 ;
			RECT 3.285 3.03 3.475 3.505 ;
			LAYER M1 ;
			RECT 3.285 2.835 4.125 3.03 ;

		RECT 0.16 3.505 0.44 5.515 ;
		LAYER M1 ;
		RECT 0.75 3.695 1.03 5.515 ;
		LAYER M1 ;
		RECT 1.955 3.695 2.235 5.515 ;
		LAYER M1 ;
		RECT 0.75 3.505 2.235 3.695 ;
		LAYER M1 ;
		RECT 0.195 2.325 0.39 3.505 ;
		LAYER M1 ;
		RECT 3.235 2.33 3.515 2.61 ;
		LAYER M1 ;
		RECT 3.235 2.325 3.425 2.33 ;
		LAYER M1 ;
		RECT 0.195 2.135 3.425 2.325 ;
		LAYER M1 ;

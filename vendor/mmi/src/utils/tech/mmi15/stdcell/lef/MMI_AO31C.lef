			LAYER M1 ;
			RECT 0 5.78 4.34 6.62 ;
			LAYER M1 ;
			RECT 1.365 4.065 1.645 5.78 ;
			LAYER M1 ;
			RECT 2.56 3.505 2.84 5.78 ;
			LAYER M1 ;
			RECT 3.8 3.505 4.08 5.78 ;
		END
	END VDD

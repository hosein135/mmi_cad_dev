MACRO MMI_NAND4C
	CLASS CORE ;
	FOREIGN MMI_NAND4C 0 0 ;
	SIZE 8.06 BY 6.2 ;
	SYMMETRY X Y ;
	SITE CORE1 ;
	PIN out
		DIRECTION output ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 0.755 3.995 1.04 5.285 ;
			LAYER M1 ;
			RECT 1.96 3.995 2.245 5.285 ;
			LAYER M1 ;
			RECT 3.84 3.995 4.22 4.23 ;
			LAYER M1 ;

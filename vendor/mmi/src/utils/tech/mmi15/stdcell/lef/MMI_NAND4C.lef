		PORT
			LAYER M1 ;
			RECT 6.94 3.22 7.32 3.6 ;
			LAYER M1 ;
			RECT 6.99 2.89 7.27 3.22 ;
		END
		AntennaGateArea 1.392 ;
	END in2
	PIN VDD
		DIRECTION inout ;
		USE POWER ;
		PORT
			LAYER M1 ;
			RECT 0 5.78 8.06 6.62 ;
			LAYER M1 ;
			RECT 0.15 3.81 0.43 5.78 ;
			LAYER M1 ;

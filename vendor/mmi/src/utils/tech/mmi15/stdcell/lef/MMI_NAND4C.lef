	PIN in0
		DIRECTION input ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 0.74 3.22 1.12 3.6 ;
			LAYER M1 ;
			RECT 0.79 2.895 1.07 3.22 ;

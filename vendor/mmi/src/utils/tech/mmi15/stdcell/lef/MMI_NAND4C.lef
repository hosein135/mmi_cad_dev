			LAYER M1 ;
			RECT 0.755 0.655 6.915 0.855 ;
			LAYER M1 ;
			RECT 0.755 0.42 6.855 0.655 ;
			LAYER M1 ;
			RECT 0 -0.42 8.06 0.42 ;

# SUE version MMI_SUE4.0p3

proc SCHEMATIC_MMIG_STK_MUX3B {} {
  make name_net_s -name N3 -origin {580 430}
  make name_net_s -name N2 -origin {580 370}
  make name_net_s -name N1 -origin {580 310}
  generate MMI_NAND2 MMI_NAND2A -Size A
  make MMI_NAND2A -origin {470 310}
  generate MMI_NAND2 MMI_NAND2A -Size A
  make MMI_NAND2A -origin {470 370}
  generate MMI_NAND2 MMI_NAND2A -Size A
  make MMI_NAND2A -origin {470 430}
  generate MMI_NAND3 MMI_NAND3B_ -Size B -DeMorgan 1
  make MMI_NAND3B_ -origin {730 370}
  generate row_spanner row_spanner200 
  make row_spanner200 -origin {590 570}
  make output -name out -origin {1010 370}
  make input -name in0 -origin {220 290}
  make input -name in1 -origin {220 350}
  make input -name in2 -origin {220 410}
  make input -name {sel[2:0]} -origin {220 450}
  make MMIG_STK_MUX3B -origin {880 90}
  make name_net_s -name {[2]} -origin {350 450}
  make name_net_s -name {[1]} -origin {350 390}
  make name_net_s -name {[0]} -origin {350 330}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner emc -version 1.2 -date 06/04/99 -origin {600 720}
  make_wire 640 430 640 390
  make_wire 640 390 670 390
  make_wire 640 310 640 350
  make_wire 640 350 670 350
  make_wire 580 310 530 310
  make_wire 580 310 640 310
  make_wire 580 370 530 370
  make_wire 580 370 670 370
  make_wire 580 430 530 430
  make_wire 580 430 640 430
  make_wire 410 290 220 290
  make_wire 410 350 220 350
  make_wire 410 410 220 410
  make_wire 1010 370 790 370
  make_wire 280 450 220 450
  make_wire 350 450 280 450
  make_wire 350 450 410 450
  make_wire 350 390 410 390
  make_wire 350 330 280 330
  make_wire 350 330 410 330
  make_wire 350 390 280 390
  make_wire 280 390 280 450
  make_wire 280 390 280 330
  make_text -origin {210 50} -text MMIG_STK_MUX3B -size large
}

proc ICON_MMIG_STK_MUX3B args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type output -origin {60 0} -name out
  icon_term -type input -origin {-60 -60} -name in0
  icon_term -type input -origin {-60 0} -name in1
  icon_term -type input -origin {-60 60} -name in2
  icon_term -type input -origin {0 80} -orient R270 -name {sel[2:0]}
  icon_property -origin {-50 210} -type user -name name
  icon_property -origin {-50 230} -type user -name M
  icon_property -origin {-50 250} -type user -name dpc
  icon_line -40 -100 40 -60 40 60 -40 100 -40 -100
  icon_line -60 0 -40 0
  icon_line -60 -60 -40 -60
  icon_line -60 60 -40 60
  icon_property -origin {-30 -60} -size small -label 0
  icon_property -origin {0 0} -anchor center -label {STK B}
  icon_line 40 0 60 0
}


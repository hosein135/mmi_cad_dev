* Header file for TSMC 1.5V 0.15 um logic process

* used in source/drain area/perimeter calculation
.param sdd        =  0.68

.param  arean(w,sdd) = '(w*sdd*1p)'
.param  areap(w,sdd) = '(w*sdd*1p)'
.param  perin(w,sdd) = '(2u*(w+sdd))'
.param  perip(w,sdd) = '(2u*(w+sdd))'

.param ln_min   =  0.15u
.param lp_min   =  0.15u

*** Low voltage, High temperature ***

.param gnd	  =  0.0
.param vdd	  =  1.35

VDD vdd 0 vdd
.TEMP 105

.GLOBAL vdd gnd

**################################################
* Corners are TT, SS, FF, SF, FS
.lib '/volume/mmi_proj/proj/tech/mmi15/spice/tsmc15.mod' TT
**################################################

*** end header ***

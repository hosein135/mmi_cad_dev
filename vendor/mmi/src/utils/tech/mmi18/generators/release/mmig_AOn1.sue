# This is a generator for an A0n1 or AOIn1.  This generator can produce circuits
# with more "AND" inputs and/or larger final drive sizes than are available
# in the standard cell library.


proc NAME_mmig_AOn1 args {
  call_use_keyword $args {{NAndInputs 4} {OutputAssertion "H"} {OutputSize "B"} {BitSlice "N"} {ReduceInputLoad "N"}}

  # OutputAssertion
  if {[string toupper $OutputAssertion] == "L"} {
    set nom "mmig_AOI"
  } else {
    set nom "mmig_AO"
  }

  # NAndInputs
  set nom [format "%s%d1" $nom $NAndInputs]

  # OutputSize
  set size [string toupper $OutputSize]
  set nom [format "%s%s" $nom $size]

  # other options
  if {([string toupper $BitSlice] == "Y") || ([string toupper $ReduceInputLoad] == "Y")} {
    set nom [format "%s_" $nom]
  }

  # BitSlice
  if {[string toupper $BitSlice] == "Y"} {
    set nom [format "%sB" $nom]
  }

  # ReduceInputLoad
  if {[string toupper $ReduceInputLoad] == "Y"} {
    set nom [format "%sR" $nom]
  }

  return $nom
}


proc SCHEMATIC_mmig_AOn1 args {
  call_use_keyword $args {{NAndInputs 4} {OutputAssertion "H"} {OutputSize "B"} {BitSlice "N"} {ReduceInputLoad "N"}}

  set debug 0
  
  # make the arguments more digestible
  # NAndInputs
  set maxidx [expr $NAndInputs - 1]
  # bitranges
  if {$NAndInputs == 1} {
    set max_bitrange [format "\[0\]"]
    set vmax_bitrange ""
  } else {
    set max_bitrange [format "\[%d:0\]" $maxidx]
    set vmax_bitrange $max_bitrange
  }

  set xfudge 300
  set yfudge 150


  # figure out how many rows there will be, and mark the gate types
  set done 0
  set rowcount 0
  set gcount $NAndInputs
  
  while {$done == 0} {

    # select the gate type
    if {[expr $rowcount % 2] == 0} {
      # row with high-asserted inputs:  the gate is a NAND
      # algorithm:
      #  the preferred gate is a NAND3.  use NAND3s until there
      #  are 2, 3, or 4 inputs remaining; then use a NAND2, NAND3, or NAND4.
      set nNAND2 0
      set nNAND4 0
      set nNAND3 [expr $gcount / 3]
      set nrem [expr $gcount % 3]
      # last group has 1 input:  replace final NAND3 with a NAND4
      if {$nrem == 1} {
	set nNAND3 [expr $nNAND3 - 1]
	set nNAND4 1
      }
      # last group has 2 inputs:  add a NAND2
      if {$nrem == 2} {
	set nNAND2 1
      }
      # place the NAND3s first
      for {set i 0} {$i < $nNAND3} {incr i} {
	set gate_type($rowcount,$i) "MMI_NAND3"
	set gate_size($rowcount,$i) "B"
	set gate_demorgan($rowcount,$i) 0
      }
      # place the NAND2, if it exists
      if {$nNAND2 == 1} {
	set gate_type($rowcount,$nNAND3) "MMI_NAND2"
	set gate_size($rowcount,$nNAND3) "B"
	set gate_demorgan($rowcount,$nNAND3) 0
      }
      # place the NAND4, if it exists
      if {$nNAND4 == 1} {
	set gate_type($rowcount,$nNAND3) "MMI_NAND4"
	set gate_size($rowcount,$nNAND3) "B"
	set gate_demorgan($rowcount,$nNAND3) 0
      }

      if {$debug} {puts [format "Row %d, %d inputs: %d NAND3s, %d NAND2s, %d NAND4s" $rowcount $gcount $nNAND3 $nNAND2 $nNAND4]}
      set gcount [expr $nNAND2 + $nNAND3 + $nNAND4]

    }  else {
      # row with low-asserted inputs:  the gate is a demorganned NOR
      # algorithm: 
      #  the preferred gate is a NOR2.  use NOR2s until there
      #  are 3 inputs remaining; then use a NOR3.
      set nNOR2 [expr $gcount / 2]
      set nNOR3 [expr $gcount % 2]
      for {set i 0} {$i < $nNOR2} {incr i} {
	set gate_type($rowcount,$i) "MMI_NOR2"
	set gate_size($rowcount,$i) "B"
	set gate_demorgan($rowcount,$i) 1
      }
      # last group has 1 input:  replace final NOR2 with a NOR3
      if {$nNOR3 == 1} {
	set gate_type($rowcount,[expr $nNOR2 - 1]) "MMI_NOR3"
	set gate_size($rowcount,[expr $nNOR2 - 1]) "B"
	set gate_demorgan($rowcount,[expr $nNOR2 - 1]) 1
      }

      if {$debug} {puts [format "Row %d, %d inputs: %d NOR2s, %d NOR3s" $rowcount $gcount $nNOR2 $nNOR3]}
      set gcount $nNOR2
    }

    set ngates($rowcount) $gcount
    incr rowcount
    
    if {$gcount == 1} {
      set done 1
    }
  }

  # figure out the drawing placement -- center each gate with respect to its inputs
  set ninputs(MMI_NAND2) 2
  set ninputs(MMI_NAND3) 3
  set ninputs(MMI_NAND4) 4
  set ninputs(MMI_NOR2) 2
  set ninputs(MMI_NOR3) 3
  set ninputs(MMI_AND2) 2
  set ninputs(MMI_AND3) 3
  set ninputs(MMI_AND4) 4
  set ninputs(MMI_OR2) 2
  set ninputs(MMI_OR3) 3
  set ninputs(MMI_INV) 1
  set ninputs(MMI_BUF) 1
  set ninputs(MMI_OAI21) 3
  set ninputs(MMI_OA21) 3
  set ninputs(MMI_OAI31) 4
  set ninputs(MMI_OA31) 4
  set ninputs(MMI_AOI21) 3
  set ninputs(MMI_AO21) 3
  set ninputs(MMI_AOI31) 4
  set ninputs(MMI_AO31) 4

  for {set i 0} {$i < $rowcount} {incr i} {
    if {$i == 0} {
      # row 0
      set y 0
      for {set j 0} {$j < $ngates($i)} {incr j} {
	set place($i,$j) $y
	set y [expr $y - $yfudge]
	if {$debug} {puts [format "Row %d, gate %d:  y = %d" $i $j $place($i,$j)]}
      }
    } else {
      set jprev 0
      for {set j 0} {$j < $ngates($i)} {incr j} {
	set nin $ninputs($gate_type($i,$j))
	set start $place([expr $i - 1],$jprev)
	set end $place([expr $i - 1],[expr $jprev + $nin - 1])
	set place($i,$j) [expr int(($end - $start)/2) + $start]
	set jprev [expr $jprev + $nin]
	if {$debug} {puts [format "Row %d, gate %d:  y = %d" $i $j $place($i,$j)]}
      }

    }
  }

  # modify the last gate to incorporate the "or" function:
  # - change NAND2/NAND3 to AOI21/AOI31
  # - change NOR2/NOR3 to OAI21/OAI31, and add inverter for "or" input
  # - for AOI22/NAND4, add a new row containing NAND2, and add inverter for "or" input
  set lastrow [expr $rowcount - 1]
  set extra_inv 0
  set extra_inv_y [expr $place(0,[expr $ngates(0) - 1]) - $yfudge]
  switch $gate_type($lastrow,0) {
    MMI_NAND2 {set gate_type($lastrow,0) "MMI_AOI21"}
    MMI_NAND3 {set gate_type($lastrow,0) "MMI_AOI31"}
    MMI_NOR2  {
      set gate_type($lastrow,0) "MMI_OAI21"
      set extra_inv 1
      set gate_type(0,$ngates(0)) "MMI_INV"
      set gate_size(0,$ngates(0)) "B"
      set gate_demorgan(0,$ngates(0)) 0
      set place(0,$ngates(0)) $extra_inv_y
      incr ngates(0)
    }
    MMI_NOR3  {
      set gate_type($lastrow,0) "MMI_OAI31"
      set extra_inv 1
      set gate_type(0,$ngates(0)) "MMI_INV"
      set gate_size(0,$ngates(0)) "B"
      set gate_demorgan(0,$ngates(0)) 0
      set place(0,$ngates(0)) $extra_inv_y
      incr ngates(0)
    }
    MMI_AOI22 -
    MMI_NAND4 {
      incr rowcount
      set lastrow [expr $rowcount - 1]
      set gate_type($lastrow,0) "MMI_NAND2"
      set gate_size($lastrow,0) "B"
      set gate_demorgan($lastrow,0) 1
      set place($lastrow,0) [expr $place([expr $lastrow - 1],0) - 50]
      set ngates($lastrow) 1
      set extra_inv 1
      set gate_type(0,$ngates(0)) "MMI_INV"
      set gate_size(0,$ngates(0)) "B"
      set gate_demorgan(0,$ngates(0)) 0
      set place(0,$ngates(0)) $extra_inv_y
      incr ngates(0)
    }
    default   {error "ERROR, Unknown gate type $gate_type($lastrow,0) in row $lastrow, position 0"}
  }

  # create the desired output assertion
  # the assertion level is already correct if:
  #  - there are an even number of rows, and OutputAssertion = H
  #  - there are an odd number of rows, and OutputAssertion = L
  if {(([expr $rowcount % 2] == 0) && ([string toupper $OutputAssertion] == "L")) ||
      (([expr $rowcount % 2] == 1) && ([string toupper $OutputAssertion] == "H"))} {
    set lastrow [expr $rowcount - 1]
    switch $gate_type($lastrow,0) {
      MMI_AOI21  {set gate_type($lastrow,0) "MMI_AO21"}
      MMI_AOI31  {set gate_type($lastrow,0) "MMI_AO31"}
      MMI_OAI21  {set gate_type($lastrow,0) "MMI_OA21"}
      MMI_OAI31  {set gate_type($lastrow,0) "MMI_OA31"}
      MMI_NAND2  {set gate_type($lastrow,0) "MMI_AND2"}
      default    {error "ERROR, Unknown gate type $gate_type($lastrow,0) in row $lastrow, position 0"}
    }
  }
      
  # reduce the input loading
  # this reduces the size of the first row's gates from B to A, if possible.
  # (only possible if the gates are MMI_NAND2's, MMI_NAND3's, MMI_NAND4's, or INV's)
  # this slows down the logic, but the reduced input loading may make it worthwhile.
  if {[string toupper $ReduceInputLoad] == "Y"} {
    for {set j 0} {$j < $ngates(0)} {incr j} {
      if {($gate_type(0,$j) == "MMI_NAND2") || ($gate_type(0,$j) == "MMI_NAND3") ||
	  ($gate_type(0,$j) == "MMI_NAND4") || ($gate_type(0,$j) == "MMI_INV")} {
	set gate_size(0,$j) "A"
      }
    }
  }
  
  # create the desired OutputSize
  set lastrow [expr $rowcount - 1]
  # OutputSize = B
  # the only way we could need a correction here is if there is only one row (= one gate)
  # and ReduceInputLoad=Y
  if {[string toupper $OutputSize] == "B"} {
    if {$lastrow == 0} {
      set gate_size($lastrow,0) "B"
    }
  }
    
  # OutputSize = C:  upsize the final gate, if possible; else add BUFC  
  if {[string toupper $OutputSize] == "C"} {
    switch $gate_type($lastrow,0) {
      MMI_AO21 -
      MMI_AOI21 -
      MMI_AO31 -
      MMI_OA21 -
      MMI_OAI21 -
      MMI_OA31 -
      MMI_NAND2 -
      MMI_AND2 {
	set gate_size($lastrow,0) "C"
      }
      MMI_AOI31 -
      MMI_OAI21 -
      MMI_OAI31 {
	set gate_type($rowcount,0) "MMI_BUF"
	set gate_size($rowcount,0) "C"
	if {[string toupper $OutputAssertion] == "H"} {
	  set buf_demorgan 0
	} else {
	  set buf_demorgan 1
	}
	set gate_demorgan($rowcount,0) $buf_demorgan
	set place($rowcount,0) $place($lastrow,0)
	set ngates($rowcount) 1
	incr rowcount
      }
      default     {error "ERROR, Unknown gate type $gate_type($lastrow,0) in row $lastrow, position 0"}
    }
  }

  # OutputSize = D or E
  # algorithm:
  #  - upsize final gate if possible (only possible for MMI_NAND2, with OutputSize=D)
  #    - for final gates which have 1 level of inversion:  add BUFD or BUFE
  #    - for final gates which have 2 levels of inversion:  replace gate with inverted C gate + INVD/INVE
  #      - exception:  there are no C versions of MMI_AOI31/MMI_OAI21/MMI_OAI31, so:
  #        - for OutputSize=D, replace gate with inverted B gate + INVD
  #        - for OutputSize=E, stick with MMI_AO31/MMI_OA21/MMI_OA31 and add BUFE
  if {([string toupper $OutputSize] == "D") || ([string toupper $OutputSize] == "E")} {
    if {([string toupper $OutputSize] == "D") && ($gate_type($lastrow,0) == "MMI_NAND2")} {
        set gate_size($lastrow,0) "D"
    } else {
    
      if {[string toupper $OutputAssertion] == "H"} {
	set buf_demorgan 0
	set inv_demorgan 1
      } else {
	set buf_demorgan 1
	set inv_demorgan 0
      }
      
      switch $gate_type($lastrow,0) {
	MMI_AOI21 -
	MMI_AOI31 -
	MMI_OAI21 -
	MMI_OAI31 -
	MMI_NAND2 {
	  set gate_type($rowcount,0) "MMI_BUF"
	  set gate_size($rowcount,0) [string toupper $OutputSize]
	  set gate_demorgan($rowcount,0) $buf_demorgan
	  set place($rowcount,0) $place($lastrow,0)
	  set ngates($rowcount) 1
	  incr rowcount
	}
	
	MMI_AO21 -
	MMI_AND2 {
	  # change this gate to C size inverting version
	  switch $gate_type($lastrow,0) {
	    MMI_AO21  {set gate_type($lastrow,0) "MMI_AOI21"}
	    MMI_AND2  {set gate_type($lastrow,0) "MMI_NAND2"}
	  }
	  set gate_size($lastrow,0) "C"
	  # add inverter
	  set gate_type($rowcount,0) "MMI_INV"
	  set gate_size($rowcount,0) [string toupper $OutputSize]
	  set gate_demorgan($rowcount,0) $inv_demorgan
	  set place($rowcount,0) $place($lastrow,0)
	  set ngates($rowcount) 1
	  incr rowcount
	}
	
	MMI_AO31 -
	MMI_OA21 -
	MMI_OA31 {
	  if {[string toupper $OutputSize] == "E"} {
	    set gate_type($rowcount,0) "MMI_BUF"
	    set gate_size($rowcount,0) [string toupper $OutputSize]
	    set gate_demorgan($rowcount,0) $buf_demorgan
	    set place($rowcount,0) $place($lastrow,0)
	    set ngates($rowcount) 1
	    incr rowcount
	  } else {
	    # change this gate to B size inverting version
	    switch $gate_type($lastrow,0) {
	      MMI_AO31  {set gate_type($lastrow,0) "MMI_AOI31"}
	      MMI_OA21  {set gate_type($lastrow,0) "MMI_OAI21"}
	      MMI_OA31  {set gate_type($lastrow,0) "MMI_OAI31"}
	    }
	    set gate_size($lastrow,0) "B"
	    # add inverter
	    set gate_type($rowcount,0) "MMI_INV"
	    set gate_size($rowcount,0) [string toupper $OutputSize]
	    set gate_demorgan($rowcount,0) $inv_demorgan
	    set place($rowcount,0) $place($lastrow,0)
	    set ngates($rowcount) 1
	    incr rowcount
	  }
	}
	
	default     {error "ERROR, Unknown gate type $gate_type($lastrow,0) in row $lastrow, position 0"}
      }
    }
  }


  # draw the gates
  set x 0
  for {set i 0} {$i < $rowcount} {incr i} {
    for {set j 0} {$j < $ngates($i)} {incr j} {
      set gate_name($i,$j) [NAME_$gate_type($i,$j) -Size $gate_size($i,$j) -DeMorgan $gate_demorgan($i,$j)]
      generate $gate_type($i,$j) $gate_name($i,$j) -Size $gate_size($i,$j) -DeMorgan $gate_demorgan($i,$j)
      if {[string toupper $BitSlice] == "Y"} {
	make $gate_name($i,$j) -origin "$x $place($i,$j)" -name {[0]}
      } else {
	make $gate_name($i,$j) -origin "$x $place($i,$j)"
      }
    }
    set x [expr $x + $xfudge]
  }

  set dont 0



  #  wire up the gates
  for {set i 0} {$i < $rowcount} {incr i} {
    if {$i == 0} {
      # first row:  inputs

      set inflag_x [expr -1 * $xfudge]
      set wt1_x [expr $inflag_x + 100]
      set label_x [expr $wt1_x + 50]
      set label_num $NAndInputs

      for {set j 0} {$j < $ngates($i)} {incr j} {
	set nin $ninputs($gate_type($i,$j))
	set terms [api_terminal_data $gate_name($i,$j)]
	
	for {set k [expr $nin - 1]} {$k >= 0} {set k [expr $k - 1]} {
	  if {$nin == 1} {
	    set data [get_assoc "in" $terms]
	  } else {
	    set data [get_assoc "in$k" $terms]
	  }
	  set origin [get_assoc origin $data]
	  set pin_x [expr ($i * $xfudge) + [lindex $origin 0]]
	  set pin_y [expr $place($i,$j) + [lindex $origin 1]]
	  make_wire $pin_x $pin_y $inflag_x $pin_y
	  make input -origin "$inflag_x $pin_y" -name in$label_num
	  set label_num [expr $label_num - 1]
	}
      }

      # in0 wire doesn't connect to a gate in this row; place the label only
      if {(!$extra_inv) && ($rowcount > 1) && ($ngates(0) > 1)} {
	make input -origin "$inflag_x $extra_inv_y" -name in0
      }

    } else {
      # last and intermediate rows
      set jprev 0
      set wt0_x [expr ($i * $xfudge) - ($xfudge/2) - 20]
      set wt1_x [expr $wt0_x + 20]
      set wt2_x [expr $wt1_x + 20]
      
      for {set j 0} {$j < $ngates($i)} {incr j} {
	
	set nin $ninputs($gate_type($i,$j))
	set terms [api_terminal_data $gate_name($i,$j)]
	
	for {set k [expr $nin - 1]} {$k >= 0} {set k [expr $k - 1]} {
	  # find the input pin location
	  switch $gate_type($i,$j) {
	    MMI_INV -
	    MMI_BUF { set pin_name "in"}
	    default {set pin_name "in$k"}
	  }
	  set data [get_assoc $pin_name $terms]
	  set origin [get_assoc origin $data]
	  set pin_x [expr ($i * $xfudge) + [lindex $origin 0]]
	  set pin_y [expr $place($i,$j) + [lindex $origin 1]]
	  
	  # find the connecting pin in the previous row
	  if {[info exists gate_name([expr $i - 1],$jprev)]} {
	    set pterms [api_terminal_data $gate_name([expr $i - 1],$jprev)]
	    set pdata [get_assoc {out} $pterms]
	    set porigin [get_assoc origin $pdata]
	    set ppin_x [expr (($i - 1) * $xfudge) + [lindex $porigin 0]]
	    set ppin_y [expr $place([expr $i - 1],$jprev) + [lindex $porigin 1]]
	  } else {
	    # must be the extra inverter or pin
	    if {$extra_inv} {
	      set pterms [api_terminal_data $gate_name(0,[expr $ngates(0) - 1])]
	      set pdata [get_assoc {out} $pterms]
	      set porigin [get_assoc origin $pdata]
	      set ppin_x [lindex $porigin 0]
	      set ppin_y $extra_inv_y
	    } else {
	      set ppin_x $inflag_x
	      set ppin_y $extra_inv_y
	    }
	  }
	      
	  # hook them up
	  switch $k {
	    0 {set wt_x $wt2_x}
	    1 {set wt_x $wt1_x}
	    2 {set wt_x $wt0_x}
	    3 {set wt_x $wt2_x}
	    default     {error "ERROR, Invalid number of pins ($k) on gate $gate_name($i,$j)"}
	  }
	  if {$k == [expr $nin - 1]} {
	    set wt_x $wt2_x
	  }
	  
	  make_wire $pin_x $pin_y $wt_x $pin_y
	  if {$pin_y != $ppin_y} {
	    make_wire $wt_x $pin_y $wt_x $ppin_y
	  }
	  make_wire $wt_x $ppin_y $ppin_x $ppin_y
	  
	  # next gate
	  incr jprev
	}
      }
    }
  }


    # last row:  wire up the output pin
  # last row:  output
  set j 0
  set i [expr $rowcount - 1]
  set outflag_x [expr $rowcount * $xfudge]
  
  # out:  output
  set terms [api_terminal_data $gate_name($i,$j)]
  set data [get_assoc {out} $terms]
  set origin [get_assoc origin $data]
  set pin_x [expr ($i * $xfudge) + [lindex $origin 0]]
  set pin_y [expr $place($i,$j) + [lindex $origin 1]]
  make_wire $pin_x $pin_y $outflag_x $pin_y
  make output -origin "$outflag_x $pin_y" -name out

  
  # place the row_spanner 
  set rswidth [expr int(($rowcount * $xfudge)/2)]
  set rsname [format "row_spanner%d" $rswidth]
  generate row_spanner $rsname -width $rswidth
  make $rsname -origin "[expr $rswidth - 100] 200"
  
  # place the dpc control block
  if {[string toupper $BitSlice] == "Y"} {
    make dpc_control -mode bit_slice -origin "[expr $rowcount * $xfudge] 230"
  }

  # place the title bar
  make sccs_title_bar -origin "[expr $rswidth - 100] 300" -owner emc -version 0.1 -date 02/10/00
}


proc ICON_mmig_AOn1 args {
  # This line is needed for all generators
  icon_generator $args {{NAndInputs 4} {OutputAssertion "H" {H L}} {OutputSize "B" {B C D E}} {BitSlice "N" {Y N}} {ReduceInputLoad "N" {Y N}}}

  # check for acceptable response on NAndInputs
  if {$NAndInputs < 2} {
    error "ERROR: NAndInputs ($NAndInputs) must be greater than 1"
  }
  # don't let the user get too crazy
  if {$NAndInputs > 128} {
    error "ERROR: NAndInputs ($NAndInputs) not supported"
  }

  # bitranges
  set maxidx [expr $NAndInputs - 1]
  set max_bitrange [format "\[%d:0\]" $maxidx]
  set vmax_bitrange $max_bitrange

  # check for acceptable response on OutputAssertion
  if {([string toupper $OutputAssertion] != "H") &&
      ([string toupper $OutputAssertion] != "L")} {
    error "ERROR: OutputAssertion ($OutputAssertion) must be H or L"
  }

  # check for acceptable response on OutputSize
  if {([string toupper $OutputSize] != "B") &&
      ([string toupper $OutputSize] != "C") &&
      ([string toupper $OutputSize] != "D") &&
      ([string toupper $OutputSize] != "E")} {
    error "ERROR: OutputSize ($OutputSize) must be B, C, D, or E"
  }
    
  # check for acceptable response on BitSlice
  if {([string toupper $BitSlice] != "Y") &&
      ([string toupper $BitSlice] != "N")} {
    error "ERROR: BitSlice ($BitSlice) must be Y or N"
  }
  
  # check for acceptable response on ReduceInputLoad
  if {([string toupper $ReduceInputLoad] != "Y") &&
      ([string toupper $ReduceInputLoad] != "N")} {
    error "ERROR: ReduceInputLoad ($ReduceInputLoad) must be Y or N"
  }
  

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}

  # icon body
  # or
  icon_line -10 -30 40 -30
  icon_line -10 30 40 30
  icon_arc -20 -30 90 110 -start 35 -extent 50
  icon_arc -20 -110 90 30 -start 275 -extent 50
  icon_arc -20 -30 0 30 -start 270 -extent 180
  # and
  icon_line -40 -10 -80 -10 -80 50 -40 50
  icon_arc -80 -10 -10 50 -start 277 -extent 166

  # output
  if {[string toupper $OutputAssertion] == "L"} {
    icon_arc 80 -10 100 10 -start 0 -extent 359
  } else {
    icon_line 80 0 100 0
  }
  icon_term -type output -origin {100 0} -name out

  # inputs
  # or
  icon_line -100 -30 -10 -30
  icon_term -type input -origin {-100 -30} -name in0
  # and
  if {$NAndInputs == 2} {
    icon_line -100 0 -80 0
    icon_line -100 40 -80 40
    icon_term -type input -origin {-100 0} -name in1
    icon_term -type input -origin {-100 40} -name in2
  } elseif {$NAndInputs == 3} {
    icon_line -100 0 -80 0
    icon_line -100 20 -80 20
    icon_line -100 40 -80 40
    icon_term -type input -origin {-100 0} -name in1
    icon_term -type input -origin {-100 20} -name in2
    icon_term -type input -origin {-100 40} -name in3
  } else {
    set start -10
    for {set i 1} {$i < [expr $NAndInputs + 1]} {incr i} {
      icon_line -100 $start -80 $start
      icon_term -type input -origin "-100 $start" -name in$i
      if {$i > 3} {
	icon_line -80 $start -80 [expr $start - 20]
      }
      set start [expr $start + 20]
    }
  }

  # properties
  icon_property -origin {-77 -2} -size small -label F
  icon_property -origin {0 -22} -size small -label F
  icon_property -origin {30 0} -size large -anchor center -label $OutputSize

  # junk
  icon_property -origin {-70 300} -type user -name name
  icon_property -origin {-70 320} -type user -name M
  icon_property -origin {-70 340} -type user -name dpc
  icon_special -type sccs_title_bar -origin {-30 460} -owner emc -version 0.1 -date 02/10/00
  # this property makes a generator pop up in "Schematic" mode rather than "Verilog" mode
  icon_property -origin {-70 360} -type fixed -name netlist_level -text 2000

  # generate verilog property
  set fname [NAME_mmig_AOn1 -NAndInputs $NAndInputs -OutputAssertion $OutputAssertion -OutputSize $OutputSize -BitSlice $BitSlice -ReduceInputLoad $ReduceInputLoad]

  set pnames [format "in0(\$in0)"]
  for {set i 1} {$i < [expr $NAndInputs + 1]} {incr i} {
    set pnames [format "%s, in%d(\$in%d)" $pnames $i $i]
  }
  set pnames [format "%s, out(\$out)" $pnames ]

  set vprop [format "%s \[unique_name \"\" \$name %s\] (%s)\\;" $fname $fname $pnames]
  icon_property -origin {-70 380} -type fixed -name verilog -text $vprop  

}

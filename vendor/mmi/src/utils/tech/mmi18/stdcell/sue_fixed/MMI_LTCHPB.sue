# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_LTCHPB {} {
  make input -name d -origin {180 250}
  make input -name clk -origin {180 400}
  generate name_net_s name_net -cell name_net
  make name_net -name clk_L -origin {410 400}
  make global -name gnd -origin {780 110}
  make global -orient RY -name vdd -origin {780 -210}
  make name_net -orient RX -name clk -origin {840 -90}
  make name_net -orient RX -name clk_L -origin {840 -10}
  make name_net -name N5 -origin {870 -170}
  make xgate -WP 1.84 -WN 0.92 -origin {550 250}
  make inverter -WP 1.84 -WN 0.92 -origin {330 250}
  make nmos -orient RX -W 0.42 -origin {780 70}
  make pmos -orient RX -W 0.42 -origin {780 -90}
  make pmos -orient RX -W 0.42 -origin {780 -170}
  make nmos -orient RX -W 0.42 -origin {780 -10}
  make name_net -name N1 -origin {460 250}
  make name_net -name N2 -origin {700 -50}
  make name_net -name clk -origin {530 140}
  make inverter -WP 0.92 -WN 0.46 -origin {290 400}
  make inverter -WP 1.84 -WN 0.92 -origin {810 410}
  make output -name q -origin {950 410}
  make inverter -WP 0.92 -WN 0.46 -origin {810 250}
  make title_bar -owner dweisner -origin {510 580}
  make MMI_LTCHPB -origin {1120 -90}
  make_wire 260 400 180 400
  make_wire 340 400 410 400
  make_wire 840 70 880 70
  make_wire 700 -50 680 -50
  make_wire 700 -50 780 -50
  make_wire 870 -170 840 -170
  make_wire 870 -170 880 -170
  make_wire 180 250 300 250
  make_wire 410 400 550 400
  make_wire 550 400 550 290
  make_wire 680 -50 680 250
  make_wire 680 250 780 250
  make_wire 880 -50 960 -50
  make_wire 960 -50 960 250
  make_wire 960 250 860 250
  make_wire 880 -50 880 -170
  make_wire 880 -50 880 70
  make_wire 460 250 380 250
  make_wire 460 250 520 250
  make_wire 550 140 550 220
  make_wire 530 140 550 140
  make_wire 530 140 500 140
  make_wire 860 410 950 410
  make_wire 660 250 660 410
  make_wire 660 410 780 410
  make_wire 660 250 680 250
  make_wire 660 250 580 250
  make_text -origin {100 -110} -text {Latch with posative enable}
  make_text -origin {100 -90} -text {B Size}
  make_text -origin {100 -130} -text MMI_LTCHPB -size large
}

proc ICON_MMI_LTCHPB args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-100 -80} -name d
  icon_term -type output -origin {100 -80} -name q
  icon_term -type input -origin {-60 0} -orient R270 -name clk
  icon_property -origin {-50 70} -type user -name name
  icon_property -origin {-50 90} -type user -name M
  icon_property -origin {-50 110} -type user -name dpc
  icon_line -100 -120 -100 0 100 0 100 -120 -100 -120
  icon_property -origin {-20 -90} -label LTCHP
  icon_property -origin {-10 -60} -label B
  icon_property -origin {-90 -80} -label d
  icon_property -origin {-70 -10} -label clk
  icon_property -origin {90 -80} -anchor e -label q
}


proc ICON_MMI_SFFHB args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-10 80} -orient R270 -name clk
  icon_term -type input -origin {30 80} -orient R270 -name s_in
  icon_term -type input -origin {10 80} -orient R270 -name s_en
  icon_term -type output -origin {60 20} -name s_out
  icon_term -type input -origin {-60 30} -name hold
  icon_term -type input -origin {-60 0} -name d
  icon_term -type output -origin {60 0} -name q
  icon_line -60 80 -60 -80 60 -80 60 80 -60 80
  icon_property -origin {0 -50} -size large -anchor center -label SFFH
  icon_property -origin {0 -30} -size large -anchor center -label B
  icon_property -origin {-50 0} -label d
  icon_property -origin {50 0} -anchor e -label q
  icon_property -origin {-10 70} -anchor e -rotate 1 -label clk
  icon_property -origin {10 70} -anchor e -rotate 1 -label s_en
  icon_property -origin {30 70} -anchor e -rotate 1 -label s_in
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  icon_property -origin {50 20} -anchor e -label s_out
  icon_property -origin {-50 30} -label hold
  icon_property -origin {-40 360} -type auto -name verilog -text {MMI_SFFHB [unique_name "" $name MMI_SFFHB]
(.clk($clk), .s_in($s_in), .s_en($s_en), .hold($hold), 
.d($d), .s_out($s_out), .q($q))\;}
}


# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_MUX2A {} {
  make MMI_MUX2A -origin {870 30}
  make xgate -WP 1.84 -WN 0.92 -origin {500 430}
  make inverter -WP 0.92 -WN 0.46 -origin {250 550}
  make input -name sel -origin {140 330}
  make input -name in0 -origin {130 220}
  make input -name in1 -origin {130 430}
  make output -name out -origin {830 320}
  make inverter -WP 0.92 -WN 0.46 -origin {720 320}
  make inverter -WP 0.92 -WN 0.46 -origin {350 430}
  make inverter -WP 0.92 -WN 0.46 -origin {350 220}
  make xgate -WP 0.92 -WN 0.46 -origin {500 220}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 12/08/99 -origin {350 700}
  make_wire 400 220 470 220
  make_wire 530 220 610 220
  make_wire 610 220 610 320
  make_wire 610 320 690 320
  make_wire 320 220 130 220
  make_wire 400 430 470 430
  make_wire 530 430 610 430
  make_wire 320 430 130 430
  make_wire 610 430 610 320
  make_wire 500 330 500 260
  make_wire 500 330 500 400
  make_wire 180 330 180 550
  make_wire 180 550 220 550
  make_wire 180 330 140 330
  make_wire 180 330 500 330
  make_wire 500 550 500 470
  make_wire 440 170 500 170
  make_wire 440 550 300 550
  make_wire 440 550 500 550
  make_wire 440 170 440 550
  make_wire 500 170 500 190
  make_wire 770 320 830 320
  make_text -origin {0 60} -text {2:1 Mux}
  make_text -origin {0 80} -text {A Size}
  make_text -origin {0 40} -text MMI_MUX2A -size large
}

proc ICON_MMI_MUX2A args {
  set size A
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "A")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_MUX2 icon body
  icon_line -40 -70 -40 70 40 30 40 -30 -40 -70
  if {$DeMorgan} {
    icon_arc -60 -20 -40 -40 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc 60 -10 40 10 -start 0 -extent 359
  } else {
    icon_line -60 -30 -40 -30
    icon_line -60 30 -40 30
    icon_line 60 0 40 0
  }
  # properties
  icon_property -origin {-37 -30} -size small -label 0 
  icon_property -origin {0 0} -size large -anchor center -label $size
  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 30} -name in1
  icon_term -type input -origin {0 50} -orient R270 -name sel
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_MUX2A
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .sel(\$\{sel\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


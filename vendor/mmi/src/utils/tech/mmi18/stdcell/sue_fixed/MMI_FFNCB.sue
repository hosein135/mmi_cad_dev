proc ICON_MMI_FFNCB args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-10 100} -orient R270 -name clk
  icon_term -type input -origin {-30 100} -orient R270 -name clrb
  icon_term -type input -origin {-60 0} -name d
  icon_term -type output -origin {60 0} -name q
  icon_line -60 80 -60 -80 60 -80 60 80 -60 80
  icon_arc -40 80 -20 100 -start 0 -extent 359
  icon_property -origin {0 -50} -size large -anchor center -label FFNC
  icon_property -origin {0 -30} -size large -anchor center -label B
  icon_property -origin {-50 0} -label d
  icon_property -origin {50 0} -anchor e -label q
  icon_property -origin {-30 70} -anchor e -rotate 1 -label clrb
  icon_property -origin {-10 70} -anchor e -rotate 1 -label clk
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  icon_arc -20 80 0 100 -start 0 -extent 359
  icon_property -origin {-40 360} -type auto -name verilog -text {MMI_FFNCB [unique_name "" $name MMI_FFNCB]
(.clk($clk), .clrb($clrb), .d($d), .q($q))\;}
}


# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_MUX2B {} {
  make MMI_MUX2B -origin {870 30}
  make inverter -WP 1.84 -WN 0.92 -origin {680 310}
  make xgate -WP 1.84 -WN 0.92 -origin {460 210}
  make inverter -WP 1.84 -WN 0.92 -origin {310 210}
  make xgate -WP 1.84 -WN 0.92 -origin {460 420}
  make inverter -WP 1.84 -WN 0.92 -origin {310 420}
  make inverter -WP 0.92 -WN 0.46 -origin {210 540}
  make output -name out -origin {760 310}
  make input -name sel -origin {100 320}
  make input -name in0 -origin {90 210}
  make input -name in1 -origin {90 420}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 12/08/99 -origin {330 700}
  make_wire 360 210 430 210
  make_wire 490 210 570 210
  make_wire 570 210 570 310
  make_wire 570 310 650 310
  make_wire 280 210 90 210
  make_wire 360 420 430 420
  make_wire 490 420 570 420
  make_wire 280 420 90 420
  make_wire 570 420 570 310
  make_wire 460 320 460 250
  make_wire 460 320 460 390
  make_wire 140 320 140 540
  make_wire 140 540 180 540
  make_wire 140 320 100 320
  make_wire 140 320 460 320
  make_wire 460 540 460 460
  make_wire 400 160 460 160
  make_wire 400 540 260 540
  make_wire 400 540 460 540
  make_wire 400 160 400 540
  make_wire 460 160 460 180
  make_wire 730 310 760 310
  make_text -origin {0 80} -text {B Size}
  make_text -origin {0 60} -text {2:1 Mux}
  make_text -origin {0 40} -text MMI_MUX2B -size large
}

proc ICON_MMI_MUX2B args {
  set size B
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "B")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_MUX2 icon body
  icon_line -40 -70 -40 70 40 30 40 -30 -40 -70
  if {$DeMorgan} {
    icon_arc -60 -20 -40 -40 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc 60 -10 40 10 -start 0 -extent 359
  } else {
    icon_line -60 -30 -40 -30
    icon_line -60 30 -40 30
    icon_line 60 0 40 0
  }
  # properties
  icon_property -origin {-37 -30} -size small -label 0 
  icon_property -origin {0 0} -size large -anchor center -label $size
  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 30} -name in1
  icon_term -type input -origin {0 50} -orient R270 -name sel
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_MUX2B
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .sel(\$\{sel\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


# SUE version MMI_SUE4.0p5

proc SCHEMATIC_MMI_AND2C {} {
  make global -orient RY -name vdd -origin {0 -140}
  make input -name in0 -origin {-100 0}
  make global -orient RY -name vdd -origin {160 -140}
  make input -name in1 -origin {-100 100}
  make global -name gnd -origin {0 140}
  make output -name out -origin {380 -50}
  make pmos -W 1.6 -origin {0 -100}
  make pmos -W 1.6 -origin {160 -100}
  make nmos -W 1.6 -origin {0 0}
  make nmos -W 1.6 -origin {0 100}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP 4.8 -WN 2.4 -origin {260 -50}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {70 -50}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.6 -date 07/19/99 -origin {150 250}
  make_wire 0 -60 0 -50
  make_wire 0 -40 0 -50
  make_wire -60 -100 -60 0
  make_wire -100 0 -60 0
  make_wire 160 -60 160 -50
  make_wire -60 100 100 100
  make_wire 0 40 0 60
  make_wire 100 -100 100 100
  make_wire -100 100 -60 100
  make_wire 230 -50 160 -50
  make_wire 310 -50 380 -50
  make_wire 70 -50 0 -50
  make_wire 70 -50 160 -50
  make_text -origin {-140 -230} -text MMI_AND2C -size large
  make_text -origin {-140 -190} -text {C Size}
  make_text -origin {-140 -210} -text {2 Input AND}
}


# Created using mapper from:
#"MMI_FFC {B {MMI_FFC {D D} {clk clk} {scan_en scan_en} {scan_in scan_in} {clearn clearn} {Q Q}}} "

proc NAME_MMI_FFC args {
  call_use_keyword $args {{Size "B"}}

  set nom [format "MMI_FFC%s" [string toupper $Size]]

  return $nom
}


proc ICON_MMI_FFC args {
  icon_generator $args {{Size "B" {radio B}} }

  set size [string toupper $Size]
  set DeMorgan 0

  # check for acceptable response on Size
  if {($size != "B")} {
    error "ERROR: Size ($size) not supported"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_FFC icon body
  icon_line -60 80 -60 -80 60 -80 60 80 -60 80
  icon_arc -40 100 -20 80 -start 0 -extent 359

  # properties
  icon_property -origin {0 -50} -size large -anchor center -label FFC
  icon_property -origin {0 -30} -size large -anchor center -label $size
  icon_property -origin {-50 0} -label D
  icon_property -origin {50 0} -anchor e -label Q
  icon_property -origin {-30 70} -anchor e -rotate 1 -label clearn
  icon_property -origin {-10 70} -anchor e -rotate 1 -label clk
  icon_property -origin {10 70} -anchor e -rotate 1 -label scan_en
  icon_property -origin {30 70} -anchor e -rotate 1 -label scan_in

  # inputs
  icon_term -type input -origin {-60 0} -name D
  icon_term -type input -origin {-30 100} -orient R270 -name clearn
  icon_term -type input -origin {-10 80} -orient R270 -name clk
  icon_term -type input -origin {10 80} -orient R270 -name scan_en
  icon_term -type input -origin {30 80} -orient R270 -name scan_in

  # outputs
  icon_term -type output -origin {60 0} -name Q




  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  if {!$DeMorgan} {
    set fname [NAME_MMI_FFC -Size $Size]
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.D(\$\{D\}), .clk(\$\{clk\}), .scan_en(\$\{scan_en\}), .scan_in(\$\{scan_in\}), .clearn(\$\{clearn\}), .Q(\$\{Q\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

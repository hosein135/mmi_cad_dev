# SUE version MMI_SUE4.0p5

proc SCHEMATIC_MMI_CLKBUFD {} {
  make output -name scan_en -origin {110 -1070}
  make output -name clk -origin {110 -1190}
  make input -name g_clk -origin {-310 -1190}
  make input -orient RX -name scan_in -origin {110 -930}
  make input -name g_scan_en -origin {-300 -1070}
  make output -orient RX -name scan_out -origin {-300 -930}
  make inverter -WP 1.6 -WN 0.8 -origin {-220 -1070}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP 4.8 -WN 2.4 -origin {-20 -1070}
  make inverter -orient RX -WP 1.6 -WN 0.8 -origin {0 -930}
  make inverter1 -orient RX -WP 4.8 -WN 2.4 -origin {-200 -930}
  generate name_net_s name_net -cell name_net
  make name_net -name scan_in_L -origin {-100 -930}
  make name_net -name g_scan_en_L -origin {-120 -1070}
  make inverter -WP 3.2 -WN 1.6 -origin {-220 -1190}
  make inverter1 -WP 9.6 -WN 4.8 -origin {-20 -1190}
  make name_net -name g_clk_L -origin {-120 -1190}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 07/19/99 -origin {-210 -730}
  make_wire 30 -1070 110 -1070
  make_wire 30 -1190 110 -1190
  make_wire -120 -1070 -170 -1070
  make_wire -50 -1070 -120 -1070
  make_wire -250 -1070 -300 -1070
  make_wire -100 -930 -50 -930
  make_wire -170 -930 -100 -930
  make_wire -300 -930 -250 -930
  make_wire 30 -930 110 -930
  make_wire -120 -1190 -170 -1190
  make_wire -50 -1190 -120 -1190
  make_wire -310 -1190 -250 -1190
  make_text -origin {-550 -1490} -text {Clock buffer to drive a row of FlipFlops from one end}
  make_text -origin {-550 -1470} -text {D Size: for driving ~8-16 FF's}
  make_text -origin {-510 -1300} -text {could eventually include a lock-up latch on scan_in}
  make_text -origin {60 -1140} -text {local to a row of flipflops}
  make_text -origin {-500 -1140} -text {global to all CLKBUFs}
  make_text -origin {70 -980} -text {from q output of nearest FF}
  make_text -origin {-530 -990} -text {to scan_in input of farthest
FF on next row or block output}
  make_text -origin {-550 -1420} -text {Note: User should not place this cell.  Autosizing will substitute this for a MMI_CLKBUFE}
  make_text -origin {-550 -1510} -text MMI_CLKBUFD -size large
}


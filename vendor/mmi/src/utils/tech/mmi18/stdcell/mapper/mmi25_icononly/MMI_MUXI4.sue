# Created using mapper from:
#"MMI_MUXI4 {B {MMI_MUXI4B {in0 in0} {in1 in1} {in2 in2} {in3 in3} {sel0 sel0} {sel1 sel1} {out out}} {MMI_MUXI4B_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {sel0 sel0} {sel1 sel1} {out out}}} {C {MMI_MUXI4C {in0 in0} {in1 in1} {in2 in2} {in3 in3} {sel0 sel0} {sel1 sel1} {out out}} {MMI_MUXI4C_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {sel0 sel0} {sel1 sel1} {out out}}} "

proc SCHEMATIC_MMI_MUXI4 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    "B" {
      if {$DeMorgan} {
        generate MMI_MUXI4 MMI_MUXI4B -Size B -DeMorgan 0
        make MMI_MUXI4B -origin {0 0}
        set terms [api_terminal_data MMI_MUXI4B]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_MUXI4B"
        }
        set data [get_assoc in0 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in0 -orient $orient
        } else {
          make $type -origin $origin -name in0
        }
        set data [get_assoc in1 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in1 -orient $orient
        } else {
          make $type -origin $origin -name in1
        }
        set data [get_assoc in2 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in2 -orient $orient
        } else {
          make $type -origin $origin -name in2
        }
        set data [get_assoc in3 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in3 -orient $orient
        } else {
          make $type -origin $origin -name in3
        }
        set data [get_assoc sel0 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name sel0 -orient $orient
        } else {
          make $type -origin $origin -name sel0
        }
        set data [get_assoc sel1 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name sel1 -orient $orient
        } else {
          make $type -origin $origin -name sel1
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_MUXI4 MMI_MUXI4B_ -Size B -DeMorgan 1
        make MMI_MUXI4B_ -origin {300 200}
      }
    }

    "C" {
      if {$DeMorgan} {
        generate MMI_MUXI4 MMI_MUXI4C -Size C -DeMorgan 0
        make MMI_MUXI4C -origin {0 0}
        set terms [api_terminal_data MMI_MUXI4C]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_MUXI4C"
        }
        set data [get_assoc in0 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in0 -orient $orient
        } else {
          make $type -origin $origin -name in0
        }
        set data [get_assoc in1 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in1 -orient $orient
        } else {
          make $type -origin $origin -name in1
        }
        set data [get_assoc in2 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in2 -orient $orient
        } else {
          make $type -origin $origin -name in2
        }
        set data [get_assoc in3 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in3 -orient $orient
        } else {
          make $type -origin $origin -name in3
        }
        set data [get_assoc sel0 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name sel0 -orient $orient
        } else {
          make $type -origin $origin -name sel0
        }
        set data [get_assoc sel1 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name sel1 -orient $orient
        } else {
          make $type -origin $origin -name sel1
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_MUXI4 MMI_MUXI4C_ -Size C -DeMorgan 1
        make MMI_MUXI4C_ -origin {300 200}
      }
    }

  }
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
}


proc NAME_MMI_MUXI4 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set nom [format "MMI_MUXI4%s" [string toupper $Size]]

  if {$DeMorgan == 1} {
    set nom [format "%s_" $nom]
  }

  return $nom
}


proc ICON_MMI_MUXI4 args {
  icon_generator $args {{Size "B" {radio B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_MUXI4 icon body
  icon_line -40 -130 -40 130 40 90 40 -90 -40 -130

  if {$DeMorgan} {
    icon_arc -60 -80 -40 -100 -start 0 -extent 359
    icon_arc -60 -20 -40 -40 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc -60 80 -40 100 -start 0 -extent 359
    icon_line 60 0 40 0
  } else {
    icon_line -60 -90 -40 -90
    icon_line -60 -30 -40 -30
    icon_line -60 30 -40 30
    icon_line -60 90 -40 90
    icon_arc 60 -10 40 10 -start 0 -extent 359
  }

  # properties
  icon_property -origin {-37 -90} -size small -label 0
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-20 112} -size small -label 0 -anchor center

  # inputs
  icon_term -type input -origin {-60 -90} -name in0
  icon_term -type input -origin {-60 -30} -name in1
  icon_term -type input -origin {-60 30} -name in2
  icon_term -type input -origin {-60 90} -name in3
  icon_term -type input -origin {-20 120} -orient R270 -name sel0
  icon_term -type input -origin {20 100} -orient R270 -name sel1

  # outputs
  icon_term -type output -origin {60 0} -name out


  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  if {!$DeMorgan} {
    set fname [NAME_MMI_MUXI4 -Size $Size]
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .in3(\$\{in3\}), .sel0(\$\{sel0\}), .sel1(\$\{sel1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

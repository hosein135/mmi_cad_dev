# SUE version MMI_SUE4.0p5

proc SCHEMATIC_MMI_OA21B {} {
  make global -orient RY -name vdd -origin {0 -100}
  make global -orient RY -name vdd -origin {250 -200}
  make global -name gnd -origin {0 200}
  make output -name out -origin {470 0}
  make nmos -W 1.2 -origin {250 160}
  make nmos -W 1.2 -origin {0 160}
  make nmos -W 1.2 -origin {0 60}
  make pmos -W 1.2 -origin {0 -60}
  make pmos -W 2.4 -origin {250 -160}
  make pmos -W 2.4 -origin {250 -60}
  make input -name in0 -origin {-100 60}
  make input -name in1 -origin {-100 160}
  make input -name in2 -origin {150 160}
  make global -name gnd -origin {250 200}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {300 0}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP 2.4 -WN 1.2 -origin {370 0}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 07/19/99 -origin {120 330}
  make_wire 0 -20 0 0
  make_wire 0 20 0 0
  make_wire 0 0 250 0
  make_wire 0 120 0 100
  make_wire 250 -120 250 -100
  make_wire 250 120 250 100
  make_wire 0 100 250 100
  make_wire 420 0 470 0
  make_wire 250 -20 250 0
  make_wire -80 60 -80 -60
  make_wire -80 -60 -60 -60
  make_wire -80 60 -60 60
  make_wire -80 60 -100 60
  make_wire -60 160 -100 160
  make_wire -60 160 50 160
  make_wire 50 160 50 -60
  make_wire 50 -60 190 -60
  make_wire 170 160 170 -160
  make_wire 170 -160 190 -160
  make_wire 170 160 190 160
  make_wire 170 160 150 160
  make_wire 300 0 340 0
  make_wire 300 0 250 0
  make_text -origin {-140 -240} -text {B Size}
  make_text -origin {-140 -280} -text MMI_OA21B -size large
  make_text -origin {-140 -260} -text {OR-AND 2,1 Gate}
}


# Created using mapper from:
#"MMI_AO22 {B {MMI_AO22B {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_AO22B_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} {C {MMI_AO22C {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_AO22C_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} "

proc SCHEMATIC_MMI_AO22 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    "B" {
      if {$DeMorgan} {
        generate MMI_AO22 MMI_AO22B -Size B -DeMorgan 0
        make MMI_AO22B -origin {0 0}
        set terms [api_terminal_data MMI_AO22B]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_AO22B"
        }
        set data [get_assoc in0 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in0 -orient $orient
        } else {
          make $type -origin $origin -name in0
        }
        set data [get_assoc in1 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in1 -orient $orient
        } else {
          make $type -origin $origin -name in1
        }
        set data [get_assoc in2 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in2 -orient $orient
        } else {
          make $type -origin $origin -name in2
        }
        set data [get_assoc in3 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in3 -orient $orient
        } else {
          make $type -origin $origin -name in3
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_AO22 MMI_AO22B_ -Size B -DeMorgan 1
        make MMI_AO22B_ -origin {300 200}
      }
    }

    "C" {
      if {$DeMorgan} {
        generate MMI_AO22 MMI_AO22C -Size C -DeMorgan 0
        make MMI_AO22C -origin {0 0}
        set terms [api_terminal_data MMI_AO22C]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_AO22C"
        }
        set data [get_assoc in0 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in0 -orient $orient
        } else {
          make $type -origin $origin -name in0
        }
        set data [get_assoc in1 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in1 -orient $orient
        } else {
          make $type -origin $origin -name in1
        }
        set data [get_assoc in2 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in2 -orient $orient
        } else {
          make $type -origin $origin -name in2
        }
        set data [get_assoc in3 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in3 -orient $orient
        } else {
          make $type -origin $origin -name in3
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_AO22 MMI_AO22C_ -Size C -DeMorgan 1
        make MMI_AO22C_ -origin {300 200}
      }
    }

  }
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
}


proc NAME_MMI_AO22 args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set nom [format "MMI_AO22%s" [string toupper $Size]]

  if {$DeMorgan == 1} {
    set nom [format "%s_" $nom]
  }

  return $nom
}


proc ICON_MMI_AO22 args {
  icon_generator $args {{Size "B" {radio B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_AO22 icon body
  if {$DeMorgan} {
    # ors
    icon_line -88 -60 -40 -60
    icon_line -88 0 -40 0
    icon_arc -100 -140 10 0 -start 275 -extent 50
    icon_arc -100 0 10 140 -start 35 -extent 50
    icon_arc -98 -60 -78 0 -start 270 -extent 180
    icon_line -88 0 -40 0
    icon_line -88 60 -40 60
    icon_arc -100 -80 10 60 -start 275 -extent 50
    icon_arc -100 -60 10 80 -start 35 -extent 50
    icon_arc -98 0 -78 60 -start 270 -extent 180
    # and
    icon_line 50 -30 0 -30 0 30 50 30
    icon_arc 10 -30 80 30 -start 277 -extent 166
    # bubbles
    icon_arc -100 40 -80 60 -start 0 -extent 359
    icon_arc -100 0 -80 20 -start 0 -extent 359
    icon_arc -100 -20 -80 0 -start 0 -extent 359
    icon_arc -100 -60 -80 -40 -start 0 -extent 359
    icon_arc 80 -10 100 10 -start 0 -extent 359
    # properties
    icon_property -origin {30 0} -size large -anchor center -label $size
    icon_property -origin {-77 -52} -size small -label F
    icon_property -origin {-77 8} -size small -label F
    icon_property -origin {3 -22} -size small -label F
  } else {
    # or
    icon_line -10 -30 40 -30
    icon_line -10 30 40 30
    icon_arc -20 -30 90 110 -start 35 -extent 50
    icon_arc -20 -110 90 30 -start 275 -extent 50
    icon_arc -20 -30 0 30 -start 270 -extent 180
    # ands
    icon_line -40 0 -80 0 -80 60 -40 60
    icon_line -40 -60 -80 -60 -80 0 -40 0
    icon_arc -80 0 -10 60 -start 277 -extent 166
    icon_arc -80 -60 -10 0 -start 277 -extent 166
    # stubs
    icon_line -100 -50 -80 -50
    icon_line -100 -10 -80 -10
    icon_line -100 10 -80 10
    icon_line -100 50 -80 50
    icon_line 80 0 100 0
    # properties
    icon_property -origin {-77 -52} -size small -label F
    icon_property -origin {-77 8} -size small -label F
    icon_property -origin {3 -22} -size small -label F
    icon_property -origin {30 0} -size large -anchor center -label $size
  }

  # inputs
  icon_term -type input -origin {-100 -50} -name in0
  icon_term -type input -origin {-100 -10} -name in1
  icon_term -type input -origin {-100 10} -name in2
  icon_term -type input -origin {-100 50} -name in3

  # outputs
  icon_term -type output -origin {100 0} -name out



  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  if {!$DeMorgan} {
    set fname [NAME_MMI_AO22 -Size $Size]
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .in3(\$\{in3\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

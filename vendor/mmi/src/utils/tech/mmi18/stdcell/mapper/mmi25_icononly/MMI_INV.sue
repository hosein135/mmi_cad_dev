# Created using mapper from:
#"MMI_INV {A {MMI_INVA {in in} {out out}} {MMI_INVA_ {in in} {out out}}} {B {MMI_INVB {in in} {out out}} {MMI_INVB_ {in in} {out out}}} {C {MMI_INVC {in in} {out out}} {MMI_INVC_ {in in} {out out}}} {D {MMI_INVD {in in} {out out}} {MMI_INVD_ {in in} {out out}}} {E {MMI_INVE {in in} {out out}} {MMI_INVE_ {in in} {out out}}} "

proc SCHEMATIC_MMI_INV args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    "A" {
      if {$DeMorgan} {
        generate MMI_INV MMI_INVA -Size A -DeMorgan 0
        make MMI_INVA -origin {0 0}
        set terms [api_terminal_data MMI_INVA]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_INVA"
        }
        set data [get_assoc in $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in -orient $orient
        } else {
          make $type -origin $origin -name in
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_INV MMI_INVA_ -Size A -DeMorgan 1
        make MMI_INVA_ -origin {300 200}
      }
    }

    "B" {
      if {$DeMorgan} {
        generate MMI_INV MMI_INVB -Size B -DeMorgan 0
        make MMI_INVB -origin {0 0}
        set terms [api_terminal_data MMI_INVB]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_INVB"
        }
        set data [get_assoc in $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in -orient $orient
        } else {
          make $type -origin $origin -name in
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_INV MMI_INVB_ -Size B -DeMorgan 1
        make MMI_INVB_ -origin {300 200}
      }
    }

    "C" {
      if {$DeMorgan} {
        generate MMI_INV MMI_INVC -Size C -DeMorgan 0
        make MMI_INVC -origin {0 0}
        set terms [api_terminal_data MMI_INVC]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_INVC"
        }
        set data [get_assoc in $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in -orient $orient
        } else {
          make $type -origin $origin -name in
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_INV MMI_INVC_ -Size C -DeMorgan 1
        make MMI_INVC_ -origin {300 200}
      }
    }

    "D" {
      if {$DeMorgan} {
        generate MMI_INV MMI_INVD -Size D -DeMorgan 0
        make MMI_INVD -origin {0 0}
        set terms [api_terminal_data MMI_INVD]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_INVD"
        }
        set data [get_assoc in $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in -orient $orient
        } else {
          make $type -origin $origin -name in
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_INV MMI_INVD_ -Size D -DeMorgan 1
        make MMI_INVD_ -origin {300 200}
      }
    }

    "E" {
      if {$DeMorgan} {
        generate MMI_INV MMI_INVE -Size E -DeMorgan 0
        make MMI_INVE -origin {0 0}
        set terms [api_terminal_data MMI_INVE]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_INVE"
        }
        set data [get_assoc in $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in -orient $orient
        } else {
          make $type -origin $origin -name in
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_INV MMI_INVE_ -Size E -DeMorgan 1
        make MMI_INVE_ -origin {300 200}
      }
    }

  }
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
}


proc NAME_MMI_INV args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set nom [format "MMI_INV%s" [string toupper $Size]]

  if {$DeMorgan == 1} {
    set nom [format "%s_" $nom]
  }

  return $nom
}


proc ICON_MMI_INV args {
  icon_generator $args {{Size "A" {radio A B C D E}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "A") && ($size != "B") && ($size != "C") && ($size != "D") && ($size != "E")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_INV icon body
  icon_line -30 -30 -30 30 30 0 -30 -30

  if {$DeMorgan} {
    icon_arc -30 -10 -50 10 -start 0 -extent 359
    icon_line -50 0 -60 0
    icon_line 30 0 60 0
  } else {
    icon_arc 30 -10 50 10 -start 0 -extent 359
    icon_line 50 0 60 0
    icon_line -30 0 -60 0
  }

  # properties
  icon_property -origin {-10 0} -size large -anchor center -label $size

  # inputs
  icon_term -type input -origin {-60 0} -name in

  # outputs
  icon_term -type output -origin {60 0} -name out



  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  if {!$DeMorgan} {
    set fname [NAME_MMI_INV -Size $Size]
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in(\$\{in\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

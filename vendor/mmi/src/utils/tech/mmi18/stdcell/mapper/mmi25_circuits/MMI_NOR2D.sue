# SUE version MMI_SUE4.0p5

proc SCHEMATIC_MMI_NOR2D {} {
  make global -name gnd -origin {0 140}
  make global -orient RY -name vdd -origin {0 -140}
  make output -name out -origin {570 50}
  make global -name gnd -origin {500 140}
  make input -name in1 -origin {-100 -100}
  make input -name in0 -origin {-100 0}
  make nmos -W 4.8 -origin {0 100}
  make nmos -W 4.8 -origin {500 100}
  make pmos -W 6.4 -origin {310 0}
  make pmos -W 6.4 -origin {310 -100}
  make pmos -W 6.4 -origin {150 -100}
  make pmos -W 6.4 -origin {150 0}
  make pmos -W 6.4 -origin {0 0}
  make pmos -W 6.4 -origin {0 -100}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.7 -date 07/19/99 -origin {200 370}
  make_wire 0 60 0 50
  make_wire 0 40 0 50
  make_wire 0 -40 0 -60
  make_wire -60 0 -100 0
  make_wire -60 -100 -100 -100
  make_wire 500 60 500 50
  make_wire -60 0 -60 100
  make_wire 90 -100 -60 -100
  make_wire 0 -140 150 -140
  make_wire 150 -140 310 -140
  make_wire 310 -60 310 -40
  make_wire 310 40 310 50
  make_wire 150 40 150 50
  make_wire 150 50 310 50
  make_wire 150 50 0 50
  make_wire 150 -60 150 -40
  make_wire -60 0 90 0
  make_wire 90 0 250 0
  make_wire 440 -100 440 100
  make_wire 90 -100 250 -100
  make_wire 250 -100 440 -100
  make_wire 310 50 500 50
  make_wire 500 50 570 50
  make_text -origin {-180 -200} -text {2 Input NOR}
  make_text -origin {-180 -180} -text {D Size}
  make_text -origin {-180 -220} -text MMI_NOR2D -size large
}


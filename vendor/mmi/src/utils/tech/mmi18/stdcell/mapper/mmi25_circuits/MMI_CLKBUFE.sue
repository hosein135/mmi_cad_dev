# SUE version MMI_SUE4.0p5

proc SCHEMATIC_MMI_CLKBUFE {} {
  make output -name scan_en -origin {110 -1070}
  make output -name clk -origin {110 -1190}
  make input -name g_clk -origin {-320 -1190}
  make input -orient RX -name scan_in -origin {110 -930}
  make input -name g_scan_en -origin {-310 -1070}
  make output -orient RX -name scan_out -origin {-310 -930}
  make inverter -orient RX -WP 1.6 -WN 0.8 -origin {-10 -930}
  generate inverter inverter1 -demorgan 1
  make inverter1 -orient RX -WP 4.8 -WN 2.4 -origin {-210 -930}
  generate name_net_s name_net -cell name_net
  make name_net -name scan_in_L -origin {-110 -930}
  make inverter -WP 1.6 -WN 0.8 -origin {-220 -1070}
  make inverter1 -WP 4.8 -WN 2.4 -origin {-20 -1070}
  make name_net -name g_scan_en_L -origin {-120 -1070}
  make inverter -WP 6.4 -WN 3.2 -origin {-220 -1190}
  make inverter1 -WP 19.2 -WN 9.6 -origin {-20 -1190}
  make name_net -name g_clk_L -origin {-120 -1190}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 07/19/99 -origin {-200 -690}
  make_wire 30 -1070 110 -1070
  make_wire 30 -1190 110 -1190
  make_wire -120 -1070 -170 -1070
  make_wire -50 -1070 -120 -1070
  make_wire -250 -1070 -310 -1070
  make_wire -110 -930 -60 -930
  make_wire -180 -930 -110 -930
  make_wire -310 -930 -260 -930
  make_wire 20 -930 110 -930
  make_wire -120 -1190 -170 -1190
  make_wire -50 -1190 -120 -1190
  make_wire -250 -1190 -320 -1190
  make_text -origin {-540 -1480} -text {Clock buffer to drive a row of FlipFlops from one end}
  make_text -origin {-540 -1460} -text {E Size: for driving ~16-32 FFs}
  make_text -origin {-510 -1300} -text {could eventually include a lock-up latch on scan_in}
  make_text -origin {60 -1140} -text {local to a row of flipflops}
  make_text -origin {-510 -1140} -text {global to all CLKBUFs}
  make_text -origin {70 -980} -text {from q output of nearest FF}
  make_text -origin {-540 -990} -text {to scan_in input of farthest
FF on next row or block output}
  make_text -origin {-540 -1410} -text {Note: User should place ONLY this size of MMI_CLKBUF.}
  make_text -origin {-540 -1500} -text MMI_CLKBUFE -size large
}


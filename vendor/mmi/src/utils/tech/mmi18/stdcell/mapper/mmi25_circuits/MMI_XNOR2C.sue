  make name_net -name in1_L -origin {540 520}
  make name_net -name N1 -origin {720 360}
  make inverter -WP 4.8 -WN 2.4 -origin {790 360}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 07/19/99 -origin {340 750}
  make_wire 840 360 870 360
  make_wire 350 380 350 360
  make_wire 350 340 350 360
  make_wire 350 240 350 260
  make_wire 660 480 660 460
  make_wire 660 240 660 260
  make_wire 660 360 660 380
  make_wire 350 480 350 460
  make_wire 660 340 660 360
  make_wire 560 420 600 420
  make_wire 600 200 580 200
  make_wire 580 200 580 520
  make_wire 580 520 600 520
  make_wire 290 200 240 200
  make_wire 240 200 240 520
  make_wire 20 300 20 420
  make_wire 420 520 290 520
  make_wire 70 300 20 300
  make_wire 10 420 20 420
  make_wire 290 300 410 300
  make_wire 20 420 290 420
  make_wire 10 520 240 520
  make_wire 240 520 290 520
  make_wire 200 300 150 300
  make_wire 200 300 290 300
  make_wire 350 360 660 360
  make_wire 540 520 500 520
  make_wire 540 520 580 520
  make_wire 410 300 560 420
  make_wire 560 300 410 420
  make_wire 560 300 600 300
  make_wire 410 420 290 420
  make_wire 720 360 660 360

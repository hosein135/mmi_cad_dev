  make nmos -W 1.2 -origin {350 520}
  make pmos -W 2.4 -origin {660 300}
  make nmos -W 1.2 -origin {350 420}
  make input -name in1 -origin {10 520}
  make inverter -WP 1.2 -WN 0.6 -origin {450 520}
  make inverter -WP 1.2 -WN 0.6 -origin {100 300}
  make input -name in0 -origin {10 420}
  make global -orient RY -name vdd -origin {660 160}
  generate name_net_s name_net -cell name_net

# Created using mapper from:
#"MMI_BUF {B {MMI_BUFB {in in} {out out}} {MMI_BUFB_ {in in} {out out}}} {C {MMI_BUFC {in in} {out out}} {MMI_BUFC_ {in in} {out out}}} {D {MMI_BUFD {in in} {out out}} {MMI_BUFD_ {in in} {out out}}} {E {MMI_BUFE {in in} {out out}} {MMI_BUFE_ {in in} {out out}}} "

proc SCHEMATIC_MMI_BUF args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    "B" {
      if {$DeMorgan} {
        generate MMI_BUF MMI_BUFB -Size B -DeMorgan 0
        make MMI_BUFB -origin {0 0}
        set terms [api_terminal_data MMI_BUFB]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_BUFB"
        }
        set data [get_assoc in $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in -orient $orient
        } else {
          make $type -origin $origin -name in
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_BUF MMI_BUFB_ -Size B -DeMorgan 1
        make MMI_BUFB_ -origin {300 200}
      }
    }

    "C" {
      if {$DeMorgan} {
        generate MMI_BUF MMI_BUFC -Size C -DeMorgan 0
        make MMI_BUFC -origin {0 0}
        set terms [api_terminal_data MMI_BUFC]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_BUFC"
        }
        set data [get_assoc in $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in -orient $orient
        } else {
          make $type -origin $origin -name in
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_BUF MMI_BUFC_ -Size C -DeMorgan 1
        make MMI_BUFC_ -origin {300 200}
      }
    }

    "D" {
      if {$DeMorgan} {
        generate MMI_BUF MMI_BUFD -Size D -DeMorgan 0
        make MMI_BUFD -origin {0 0}
        set terms [api_terminal_data MMI_BUFD]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_BUFD"
        }
        set data [get_assoc in $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in -orient $orient
        } else {
          make $type -origin $origin -name in
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_BUF MMI_BUFD_ -Size D -DeMorgan 1
        make MMI_BUFD_ -origin {300 200}
      }
    }

    "E" {
      if {$DeMorgan} {
        generate MMI_BUF MMI_BUFE -Size E -DeMorgan 0
        make MMI_BUFE -origin {0 0}
        set terms [api_terminal_data MMI_BUFE]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_BUFE"
        }
        set data [get_assoc in $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in -orient $orient
        } else {
          make $type -origin $origin -name in
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_BUF MMI_BUFE_ -Size E -DeMorgan 1
        make MMI_BUFE_ -origin {300 200}
      }
    }

  }
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
}


proc NAME_MMI_BUF args {
  call_use_keyword $args {{Size "B"} {DeMorgan 0}}

  set nom [format "MMI_BUF%s" [string toupper $Size]]

  if {$DeMorgan == 1} {
    set nom [format "%s_" $nom]
  }

  return $nom
}


proc ICON_MMI_BUF args {
  icon_generator $args {{Size "B" {radio B C D E}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "B") && ($size != "C") && ($size != "D") && ($size != "E")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_BUF icon body
    icon_line -30 -30 -30 30 30 0 -30 -30

  if {$DeMorgan} {
    icon_arc -30 -10 -50 10 -start 0 -extent 359
    icon_line -50 0 -60 0
    icon_arc 30 -10 50 10 -start 0 -extent 359
    icon_line 50 0 60 0
  } else {
    icon_line 30 0 60 0
    icon_line -30 0 -60 0
  }

  # properties
  icon_property -origin {-10 0} -size large -anchor center -label $size

  # inputs
  icon_term -type input -origin {-60 0} -name in

  # outputs
  icon_term -type output -origin {60 0} -name out



  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  if {!$DeMorgan} {
    set fname [NAME_MMI_BUF -Size $Size]
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in(\$\{in\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

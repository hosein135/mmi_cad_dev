# Created using mapper from:
#"MMI_MUX2 {A {MMI_MUX2A {in0 in0} {in1 in1} {sel sel} {out out}} {MMI_MUX2A_ {in0 in0} {in1 in1} {sel sel} {out out}}} {B {MMI_MUX2B {in0 in0} {in1 in1} {sel sel} {out out}} {MMI_MUX2B_ {in0 in0} {in1 in1} {sel sel} {out out}}} {C {MMI_MUX2C {in0 in0} {in1 in1} {sel sel} {out out}} {MMI_MUX2C_ {in0 in0} {in1 in1} {sel sel} {out out}}} {D {MMI_MUX2D {in0 in0} {in1 in1} {sel sel} {out out}} {MMI_MUX2D_ {in0 in0} {in1 in1} {sel sel} {out out}}} "

proc SCHEMATIC_MMI_MUX2 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    "A" {
      if {$DeMorgan} {
        generate MMI_MUX2 MMI_MUX2A -Size A -DeMorgan 0
        make MMI_MUX2A -origin {0 0}
        set terms [api_terminal_data MMI_MUX2A]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_MUX2A"
        }
        set data [get_assoc in0 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in0 -orient $orient
        } else {
          make $type -origin $origin -name in0
        }
        set data [get_assoc in1 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in1 -orient $orient
        } else {
          make $type -origin $origin -name in1
        }
        set data [get_assoc sel $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name sel -orient $orient
        } else {
          make $type -origin $origin -name sel
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_MUX2 MMI_MUX2A_ -Size A -DeMorgan 1
        make MMI_MUX2A_ -origin {300 200}
      }
    }

    "B" {
      if {$DeMorgan} {
        generate MMI_MUX2 MMI_MUX2B -Size B -DeMorgan 0
        make MMI_MUX2B -origin {0 0}
        set terms [api_terminal_data MMI_MUX2B]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_MUX2B"
        }
        set data [get_assoc in0 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in0 -orient $orient
        } else {
          make $type -origin $origin -name in0
        }
        set data [get_assoc in1 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in1 -orient $orient
        } else {
          make $type -origin $origin -name in1
        }
        set data [get_assoc sel $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name sel -orient $orient
        } else {
          make $type -origin $origin -name sel
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_MUX2 MMI_MUX2B_ -Size B -DeMorgan 1
        make MMI_MUX2B_ -origin {300 200}
      }
    }

    "C" {
      if {$DeMorgan} {
        generate MMI_MUX2 MMI_MUX2C -Size C -DeMorgan 0
        make MMI_MUX2C -origin {0 0}
        set terms [api_terminal_data MMI_MUX2C]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_MUX2C"
        }
        set data [get_assoc in0 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in0 -orient $orient
        } else {
          make $type -origin $origin -name in0
        }
        set data [get_assoc in1 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in1 -orient $orient
        } else {
          make $type -origin $origin -name in1
        }
        set data [get_assoc sel $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name sel -orient $orient
        } else {
          make $type -origin $origin -name sel
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_MUX2 MMI_MUX2C_ -Size C -DeMorgan 1
        make MMI_MUX2C_ -origin {300 200}
      }
    }

    "D" {
      if {$DeMorgan} {
        generate MMI_MUX2 MMI_MUX2D -Size D -DeMorgan 0
        make MMI_MUX2D -origin {0 0}
        set terms [api_terminal_data MMI_MUX2D]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_MUX2D"
        }
        set data [get_assoc in0 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in0 -orient $orient
        } else {
          make $type -origin $origin -name in0
        }
        set data [get_assoc in1 $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name in1 -orient $orient
        } else {
          make $type -origin $origin -name in1
        }
        set data [get_assoc sel $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name sel -orient $orient
        } else {
          make $type -origin $origin -name sel
        }
        set data [get_assoc out $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name out -orient $orient
        } else {
          make $type -origin $origin -name out
        }
        generate MMI_MUX2 MMI_MUX2D_ -Size D -DeMorgan 1
        make MMI_MUX2D_ -origin {300 200}
      }
    }

  }
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
}


proc NAME_MMI_MUX2 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set nom [format "MMI_MUX2%s" [string toupper $Size]]

  if {$DeMorgan == 1} {
    set nom [format "%s_" $nom]
  }

  return $nom
}


proc ICON_MMI_MUX2 args {
  icon_generator $args {{Size "A" {radio A B C D}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "A") && ($size != "B") && ($size != "C") && ($size != "D")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_MUX2 icon body
  icon_line -40 -70 -40 70 40 30 40 -30 -40 -70

  if {$DeMorgan} {
    icon_arc -60 -20 -40 -40 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc 60 -10 40 10 -start 0 -extent 359
  } else {
    icon_line -60 -30 -40 -30
    icon_line -60 30 -40 30
    icon_line 60 0 40 0
  }

  # properties
  icon_property -origin {-37 -30} -size small -label 0 
  icon_property -origin {0 0} -size large -anchor center -label $size

  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 30} -name in1
  icon_term -type input -origin {0 50} -orient R270 -name sel

  # outputs
  icon_term -type output -origin {60 0} -name out



  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  if {!$DeMorgan} {
    set fname [NAME_MMI_MUX2 -Size $Size]
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .sel(\$\{sel\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

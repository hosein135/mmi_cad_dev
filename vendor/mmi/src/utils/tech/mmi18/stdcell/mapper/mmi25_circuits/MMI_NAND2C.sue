# SUE version MMI_SUE4.0p5

proc SCHEMATIC_MMI_NAND2C {} {
  make global -orient RY -name vdd -origin {0 -140}
  make input -name in0 -origin {-100 0}
  make global -orient RY -name vdd -origin {250 -140}
  make input -name in1 -origin {-100 100}
  make global -name gnd -origin {0 140}
  make output -name out -origin {320 -50}
  make pmos -W 4.8 -origin {0 -100}
  make pmos -W 4.8 -origin {250 -100}
  make global -name gnd -origin {110 140}
  make nmos -W 2.4 -origin {110 0}
  make nmos -W 2.4 -origin {110 100}
  make nmos -W 2.4 -origin {0 0}
  make nmos -W 2.4 -origin {0 100}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 07/19/99 -origin {50 340}
  make_wire 0 -60 0 -50
  make_wire 0 -40 0 -50
  make_wire -60 -100 -60 0
  make_wire -100 0 -60 0
  make_wire 250 -60 250 -50
  make_wire 0 40 0 60
  make_wire 190 -100 190 100
  make_wire -100 100 -60 100
  make_wire 250 -50 320 -50
  make_wire 110 -40 110 -50
  make_wire 110 40 110 60
  make_wire 50 100 -60 100
  make_wire 50 100 190 100
  make_wire 110 -50 0 -50
  make_wire 110 -50 250 -50
  make_wire 50 0 -60 0
  make_text -origin {-140 -230} -text {2 Input NAND}
  make_text -origin {-140 -210} -text {C Size}
  make_text -origin {-140 -250} -text MMI_NAND2C -size large
}


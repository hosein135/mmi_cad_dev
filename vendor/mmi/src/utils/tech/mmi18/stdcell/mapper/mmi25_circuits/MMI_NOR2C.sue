# SUE version MMI_SUE4.0p5

proc SCHEMATIC_MMI_NOR2C {} {
  make global -name gnd -origin {0 140}
  make global -name gnd -origin {370 140}
  make global -orient RY -name vdd -origin {30 -140}
  make output -name out -origin {390 50}
  make pmos -W 2.4 -origin {70 0}
  make pmos -W 2.4 -origin {0 0}
  make pmos -W 2.4 -origin {0 -100}
  make pmos -W 2.4 -origin {70 -100}
  make nmos -W 2.4 -origin {370 100}
  make nmos -W 2.4 -origin {0 100}
  make global -orient RY -name vdd -origin {170 -140}
  make pmos -W 2.4 -origin {210 0}
  make pmos -W 2.4 -origin {140 0}
  make pmos -W 2.4 -origin {140 -100}
  make pmos -W 2.4 -origin {210 -100}
  make input -name in0 -origin {-100 0}
  make input -name in1 -origin {-100 -100}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 07/19/99 -origin {40 350}
  make_wire 0 60 0 50
  make_wire 0 40 0 50
  make_wire -60 100 -60 0
  make_wire -100 0 -60 0
  make_wire 370 60 370 50
  make_wire 0 -40 0 -60
  make_wire 310 100 310 -100
  make_wire 370 50 390 50
  make_wire -100 -100 -60 -100
  make_wire 70 -40 70 -60
  make_wire 70 50 0 50
  make_wire 0 -140 30 -140
  make_wire 30 -140 70 -140
  make_wire -60 -100 10 -100
  make_wire 70 40 70 50
  make_wire 140 40 140 50
  make_wire 140 -40 140 -60
  make_wire 210 -40 210 -60
  make_wire 150 0 80 0
  make_wire 140 -140 170 -140
  make_wire 170 -140 210 -140
  make_wire 210 40 210 50
  make_wire 10 -100 80 -100
  make_wire 80 -100 150 -100
  make_wire 150 -100 310 -100
  make_wire 70 50 140 50
  make_wire 140 50 210 50
  make_wire 210 50 370 50
  make_wire 10 0 -60 0
  make_wire 10 0 80 0
  make_text -origin {-180 -200} -text {2 Input NOR}
  make_text -origin {-180 -180} -text {C Size}
  make_text -origin {-180 -220} -text MMI_NOR2C -size large
}


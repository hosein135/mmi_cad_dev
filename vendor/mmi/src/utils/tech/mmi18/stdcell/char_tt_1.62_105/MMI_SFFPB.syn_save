library (MMI_SFFPB) {
date : "Mon May 01 14:45:05 PDT 2000";
comment : "Built from MMI char.tcl";
delay_model : table_lookup;
lu_table_template(li5X4) {
	variable_1 : total_output_net_capacitance;
	variable_2 : input_net_transition;
	index_1 ("0, 1, 2, 3, 4");
	index_2 ("0, 1, 2, 3");
}
lu_table_template(cr2X4) {
	variable_1 : related_pin_transition;
	variable_2 : constrained_pin_transition;
	index_1 ("0, 1");
	index_2 ("0, 1, 2, 3");
}
nom_process                 : 1.0;
nom_temperature             : 105;
nom_voltage                 : 1.62;
pulling_resistance_unit     : "1kohm";
time_unit                   : "1ns";
voltage_unit                : "1V";
current_unit                : "1A";
capacitive_load_unit (1.0,pf);
default_max_fanout             : 64;
default_max_transition         : 2.00;
default_max_capacitance        : 1.00;
default_cell_leakage_power     : 100;
default_fanout_load            : 1.0;
default_inout_pin_cap          : 0.0;
default_input_pin_cap          : 0.0;
default_output_pin_cap         : 0.0;
 
slew_lower_threshold_pct_rise   : 20.00
slew_upper_threshold_pct_rise   : 80.00
slew_lower_threshold_pct_fall   : 20.00
slew_upper_threshold_pct_fall   : 80.00
 
input_threshold_pct_fall        : 50.00
input_threshold_pct_rise        : 50.00
output_threshold_pct_fall       : 50.00
output_threshold_pct_rise       : 50.00
 
slew_derate_from_library        :  1.00

operating_conditions("typ_105_1.62") {
        process : 1.0 ;
        temperature : 105 ;
        voltage : 1.62 ;
        tree_type : "balanced_tree" ;
}
operating_conditions("slow_125_1.62") {
        process : 1.3 ;
        temperature : 125 ;
        voltage : 1.62 ;
        tree_type : "balanced_tree" ;
}
cell (MMI_SFFPB) {
/*
 *	Scan Flip Flop with asynchronous set
 */
	ff (IQ,IQN){
		clocked_on : "clk";
		next_state : "d";
		clear : "!setb";
	}
	pin (q) {
		direction : output;
		max_capacitance : 0.3239;
		max_fanout : 32.3853;
		max_transition : 1.0000;
		function : "IQ";
		timing () {
			timing_type : preset;
			timing_sense : negative_unate;
			related_pin  : "setb"
			cell_rise(li5X4) {
				index_1("0.0098,0.0195,0.0391,0.0782,0.1563");
				index_2("0.0496,0.1031,0.2181,0.4556");
				values("0.2224,0.2433,0.2783,0.3317",\
				        "0.2484,0.2696,0.3044,0.3581",\
				        "0.2983,0.3192,0.3540,0.4078",\
				        "0.3969,0.4179,0.4526,0.5064",\
				        "0.5938,0.6148,0.6495,0.7032");
			}
			rise_transition(li5X4) {
				index_1("0.0098,0.0195,0.0391,0.0782,0.1563");
				index_2("0.0496,0.1031,0.2181,0.4556");
				values("0.0685,0.0685,0.0688,0.0692",\
				        "0.1003,0.1002,0.1007,0.1001",\
				        "0.1681,0.1682,0.1680,0.1683",\
				        "0.3094,0.3094,0.3092,0.3094",\
				        "0.5943,0.5943,0.5942,0.5943");
			}
		}
		timing () {
			timing_type : rising_edge;
			related_pin  : "clk"
			cell_fall(li5X4) {
				index_1("0.0098,0.0195,0.0391,0.0782,0.1563");
				index_2("0.0507,0.1002,0.2062,0.4226");
				values("0.2564,0.2718,0.2923,0.3121",\
				        "0.2823,0.2977,0.3185,0.3381",\
				        "0.3270,0.3423,0.3631,0.3828",\
				        "0.4060,0.4213,0.4421,0.4619",\
				        "0.5549,0.5702,0.5910,0.6109");
			}
			fall_transition(li5X4) {
				index_1("0.0098,0.0195,0.0391,0.0782,0.1563");
				index_2("0.0507,0.1002,0.2062,0.4226");
				values("0.0651,0.0655,0.0651,0.0659",\
				        "0.0884,0.0883,0.0885,0.0889",\
				        "0.1330,0.1329,0.1330,0.1332",\
				        "0.2232,0.2231,0.2230,0.2235",\
				        "0.4107,0.4106,0.4107,0.4107");
			}
			cell_rise(li5X4) {
				index_1("0.0098,0.0195,0.0391,0.0782,0.1563");
				index_2("0.0505,0.0998,0.2055,0.4216");
				values("0.3110,0.3319,0.3642,0.3985",\
				        "0.3378,0.3587,0.3907,0.4250",\
				        "0.3874,0.4083,0.4402,0.4747",\
				        "0.4856,0.5065,0.5384,0.5728",\
				        "0.6818,0.7027,0.7347,0.7690");
			}
			rise_transition(li5X4) {
				index_1("0.0098,0.0195,0.0391,0.0782,0.1563");
				index_2("0.0505,0.0998,0.2055,0.4216");
				values("0.0711,0.0710,0.0712,0.0713",\
				        "0.1017,0.1016,0.1023,0.1023",\
				        "0.1687,0.1687,0.1685,0.1685",\
				        "0.3089,0.3088,0.3087,0.3087",\
				        "0.5936,0.5936,0.5935,0.5935");
			}
		}
	}
	pin (d) {
		direction : input;
		capacitance : 0.0067;
		fanout_load : 0.6654;
		timing () {
			timing_type  : setup_rising;
			related_pin : "clk";
			rise_constraint(cr2X4) {

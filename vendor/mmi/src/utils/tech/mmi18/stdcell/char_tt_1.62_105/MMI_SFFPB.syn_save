			}
			rise_constraint(cr2X4) {
				index_1("0.1102,0.2279");
				index_2("0.0513,0.1110,0.2363,0.4907");
				values("-0.2123,-0.2337,-0.2681,-0.3265",\
				        "-0.2158,-0.2272,-0.2724,-0.3307");
			}
		}
	}
	pin (s_in) {
		direction : input;
		capacitance : 0.0039;
		fanout_load : 0.3893;
		timing () {
			timing_type  : setup_rising;
			related_pin : "clk";
			rise_constraint(cr2X4) {
				index_1("0.1101,0.2278");
				index_2("0.0517,0.1100,0.2344,0.4862");
				values("0.2889,0.3001,0.3355,0.3733",\
				        "0.2818,0.2935,0.3177,0.3555");
			}
			fall_constraint(cr2X4) {
				index_1("0.1102,0.2276");
				index_2("0.0485,0.0916,0.1861,0.3819");
				values("0.4147,0.4282,0.4526,0.4927",\
				        "0.4297,0.4432,0.4677,0.5190");
			}
		}
		timing () {
			timing_type  : hold_rising;
			related_pin : "clk";
			rise_constraint(cr2X4) {
				index_1("0.1102,0.2278");
				index_2("0.0517,0.1107,0.2344,0.4862");
				values("-0.2341,-0.2446,-0.2692,-0.2959",\
				        "-0.2268,-0.2495,-0.2735,-0.3113");
			}
			fall_constraint(cr2X4) {

set LIST_BOXES 0

cell_path_add /home/pat/mmi_private
#cell_path_add /home/pat/work/cells
cell_path_add /proj/tech/mmi18/stdcell/sue_param

#set MENU_FONT "*-helvetica-Bold-R-Normal-*-180-*"
#set DIALOG_FONT "*-helvetica-Bold-R-Normal-*-180-*"


# MAX TCL FILE

set WORKDIR /proj/tech/mmi18/stdcell/sue_param


# Procedure lays out and routes all .max files in current directory,
# or in specified list.
proc max_all {{list ""}} {
    global WORKDIR
    global PAT_ROUTE LAYINFO

    set save_cd [pwd]

    # make sure we are in the right place
    # cd $EXTRACTDIR

    # first remove all old .max files, need sh to expand *.max
    #catch {exec sh -c "rm -f *.max"}

    if { $list == "" } {
      foreach cell [lsort [glob ${WORKDIR}/*.sim]] {

	set cell_name [file root [file tail $cell]]
	lappend list $cell_name
      }
    }

    foreach cell $list {
	stdcell_load_sim $WORKDIR/$cell no
	stdcell_route_direct
	:save
    }

    cd $save_cd
    puts "sim_all done."
    set BATCH 0
}


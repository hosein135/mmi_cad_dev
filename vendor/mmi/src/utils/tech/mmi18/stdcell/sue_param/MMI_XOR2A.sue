# SUE version MMI_SUE4.1.7

proc SCHEMATIC_MMI_XOR2A {} {
  make MMI_XOR2A -origin {740 90}
  make input -name in1 -origin {170 370}
  make input -name in0 -origin {170 330}
  make output -name out -origin {750 500}
  make MMI_NOR2A -origin {640 350}
  make MMI_AOI21A -origin {610 500}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 02/10/00 -origin {350 740}
  make_wire 510 420 510 470
  make_wire 710 500 750 500
  make_wire 250 500 510 500
  make_wire 250 370 250 500
  make_wire 210 540 510 540
  make_wire 210 330 210 540
  make_wire 170 370 250 370
  make_wire 250 370 580 370
  make_wire 700 350 700 420
  make_wire 510 420 700 420
  make_wire 170 330 210 330
  make_wire 210 330 580 330
  make_text -origin {20 90} -text {Exclusive OR}
  make_text -origin {20 110} -text {A Size}
  make_text -origin {20 70} -text MMI_XOR2A -size large
}

proc ICON_MMI_XOR2A args {
  set size A
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "A")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_XOR2 icon body
  icon_arc -60 -30 50 110 -start 35 -extent 50
  icon_arc -48 -30 -28 30 -start 270 -extent 180
  icon_line -38 -30 0 -30
  icon_line -38 30 0 30
  icon_arc -60 -110 50 30 -start 275 -extent 50
  icon_arc -58 -30 -38 30 -start 270 -extent 180
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-27 -20} -size small -label F
  if {$DeMorgan} {
    icon_line 40 0 60 0
    icon_arc -60 30 -40 10 -start 0 -extent 359
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_line 40 0 60 0
    icon_line -60 20 -40 20
    icon_line -60 -20 -40 -20
  }
  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_XOR2A
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


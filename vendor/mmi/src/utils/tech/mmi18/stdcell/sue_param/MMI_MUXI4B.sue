# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_MUXI4B {} {
  make output -name out -origin {1900 -100}
  make input -name sel1 -origin {1290 440}
  generate name_net_s name_net -cell name_net
  make name_net -name sel1_L -origin {1580 440}
  make name_net -name N1 -origin {1460 -350}
  make name_net -name N2 -origin {1680 -350}
  make xgate -orient RY -WP '4*WNA' -WN '2*WNA' -origin {1580 -350}
  make xgate -orient RY -WP '4*WNA' -WN '2*WNA' -origin {1580 120}
  make inverter -WP '2*WNA' -WN '1*WNA' -origin {1480 440}
  make xgate -WP '4*WNA' -WN '2*WNA' -origin {1180 -450}
  make inverter -WP '4*WNA' -WN '2*WNA' -origin {1030 -450}
  make xgate -WP '4*WNA' -WN '2*WNA' -origin {1180 -240}
  make inverter -WP '4*WNA' -WN '2*WNA' -origin {1030 -240}
  make input -name in0 -origin {810 -450}
  make input -name sel0 -origin {820 -340}
  make input -name in1 -origin {810 -240}
  make inverter -WP '4*WNA' -WN '2*WNA' -origin {1820 -100}
  make inverter -WP '4*WNA' -WN '2*WNA' -origin {1370 -350}
  make xgate -WP '4*WNA' -WN '2*WNA' -origin {1170 20}
  make inverter -WP '4*WNA' -WN '2*WNA' -origin {1020 20}
  make xgate -WP '4*WNA' -WN '2*WNA' -origin {1170 230}
  make inverter -WP '4*WNA' -WN '2*WNA' -origin {1020 230}
  make inverter -WP '4*WNA' -WN '2*WNA' -origin {1360 120}
  make input -name in2 -origin {800 20}
  make input -name in3 -origin {800 230}
  make MMI_MUXI4B -origin {1980 -590}
  make name_net -name N3 -origin {1470 120}
  make name_net -name sel0_L -origin {1070 -80}
  make inverter -WP '4*WNA' -WN '2*WNA' -origin {970 -80}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 12/09/99 -origin {1240 620}
  make_wire 1870 -100 1900 -100
  make_wire 1580 -420 1580 -390
  make_wire 1740 -100 1790 -100
  make_wire 1580 180 1580 150
  make_wire 1520 180 1580 180
  make_wire 1400 180 1520 180
  make_wire 1470 120 1550 120
  make_wire 1080 -450 1150 -450
  make_wire 1210 -450 1290 -450
  make_wire 1000 -450 810 -450
  make_wire 1080 -240 1150 -240
  make_wire 1210 -240 1290 -240
  make_wire 1000 -240 810 -240
  make_wire 1180 -340 1180 -410
  make_wire 1180 -340 1180 -270
  make_wire 860 -340 820 -340
  make_wire 860 -340 1180 -340
  make_wire 1180 -120 1180 -200
  make_wire 1120 -500 1180 -500
  make_wire 1120 -120 1180 -120
  make_wire 1180 -500 1180 -480
  make_wire 1550 -350 1460 -350
  make_wire 1420 -350 1460 -350
  make_wire 1340 -350 1290 -350
  make_wire 1290 -350 1290 -240
  make_wire 1290 -350 1290 -450
  make_wire 1580 -110 1640 -110
  make_wire 1070 20 1140 20
  make_wire 1200 20 1280 20
  make_wire 990 20 800 20
  make_wire 1070 230 1140 230
  make_wire 1200 230 1280 230
  make_wire 990 230 800 230
  make_wire 1170 130 1170 60
  make_wire 1170 130 1170 200
  make_wire 1170 350 1170 270
  make_wire 1120 -30 1120 350
  make_wire 1330 120 1280 120
  make_wire 1280 120 1280 230
  make_wire 1280 120 1280 20
  make_wire 1520 -420 1520 180
  make_wire 1520 -420 1580 -420
  make_wire 1400 180 1400 440
  make_wire 1290 440 1400 440
  make_wire 1400 440 1450 440
  make_wire 1410 120 1470 120
  make_wire 1740 -350 1740 -100
  make_wire 1740 -100 1740 120
  make_wire 1610 -350 1680 -350
  make_wire 1680 -350 1740 -350
  make_wire 1610 120 1740 120
  make_wire 1640 -110 1640 440
  make_wire 1530 440 1580 440
  make_wire 1580 440 1640 440
  make_wire 1580 -320 1580 -110
  make_wire 1580 -110 1580 80
  make_wire 860 130 1170 130
  make_wire 860 -80 940 -80
  make_wire 860 -80 860 130
  make_wire 860 -80 860 -340
  make_wire 1120 -500 1120 -120
  make_wire 1120 -120 1120 -80
  make_wire 1120 350 1170 350
  make_wire 1120 -30 1170 -30
  make_wire 1170 -30 1170 -10
  make_wire 1120 -30 1120 -80
  make_wire 1070 -80 1020 -80
  make_wire 1070 -80 1120 -80
  make_text -origin {670 -620} -text {Inverting 4:1 Mux }
  make_text -origin {670 -600} -text {B Size}
  make_text -origin {670 -640} -text MMI_MUXI4B -size large
}

proc ICON_MMI_MUXI4B args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-60 -90} -name in0
  icon_term -type input -origin {-60 -30} -name in1
  icon_term -type input -origin {-60 30} -name in2
  icon_term -type input -origin {-60 90} -name in3
  icon_term -type input -origin {-20 120} -orient R270 -name sel0
  icon_term -type input -origin {20 100} -orient R270 -name sel1
  icon_term -type output -origin {60 0} -name out
  icon_line -40 -130 -40 130 40 90 40 -90 -40 -130
  icon_line -60 -90 -40 -90
  icon_line -60 -30 -40 -30
  icon_line -60 30 -40 30
  icon_line -60 90 -40 90
  icon_arc 40 -10 60 10 -start 0 -extent 359
  icon_property -origin {-37 -90} -size small -label 0
  icon_property -origin {0 0} -size large -anchor center -label B
  icon_property -origin {-20 112} -size small -anchor center -label 0
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  icon_property -origin {-40 360} -type auto -name verilog -text {MMI_MUXI4B [unique_name "" $name MMI_MUXI4B]
(.in0($in0), .in1($in1), .in2($in2), .in3($in3), 
.sel0($sel0), .sel1($sel1), .out($out))\;}
}


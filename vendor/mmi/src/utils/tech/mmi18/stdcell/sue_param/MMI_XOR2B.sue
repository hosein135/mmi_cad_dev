# SUE version MMI_SUE4.1.7

proc SCHEMATIC_MMI_XOR2B {} {
  make input -name in1 -origin {230 360}
  make input -name in0 -origin {230 320}
  make MMI_XOR2B -origin {800 90}
  make output -name out -origin {800 490}
  make MMI_NOR2A -origin {720 340}
  make MMI_AOI21B -origin {660 490}
  make LayGen -routing_tracks_above_center 0 -origin {120 600}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 02/10/00 -origin {410 730}
  make_wire 760 490 800 490
  make_wire 310 490 560 490
  make_wire 310 360 310 490
  make_wire 270 530 560 530
  make_wire 270 320 270 530
  make_wire 560 400 780 400
  make_wire 230 320 270 320
  make_wire 270 320 660 320
  make_wire 230 360 310 360
  make_wire 310 360 660 360
  make_wire 560 400 560 460
  make_wire 780 340 780 400
  make_text -origin {70 90} -text {Exclusive OR}
  make_text -origin {70 110} -text {B Size}
  make_text -origin {70 70} -text MMI_XOR2B -size large
}

proc ICON_MMI_XOR2B args {
  set size B
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "B")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_XOR2 icon body
  icon_arc -60 -30 50 110 -start 35 -extent 50
  icon_arc -48 -30 -28 30 -start 270 -extent 180
  icon_line -38 -30 0 -30
  icon_line -38 30 0 30
  icon_arc -60 -110 50 30 -start 275 -extent 50
  icon_arc -58 -30 -38 30 -start 270 -extent 180
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-27 -20} -size small -label F
  if {$DeMorgan} {
    icon_line 40 0 60 0
    icon_arc -60 30 -40 10 -start 0 -extent 359
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_line 40 0 60 0
    icon_line -60 20 -40 20
    icon_line -60 -20 -40 -20
  }
  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_XOR2B
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


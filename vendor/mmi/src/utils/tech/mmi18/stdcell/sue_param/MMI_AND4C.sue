# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_AND4C {} {
  make global -orient RY -name vdd -origin {-90 -140}
  make input -name in0 -origin {-190 0}
  make global -orient RY -name vdd -origin {120 -140}
  make input -name in1 -origin {-190 100}
  make global -orient RY -name vdd -origin {240 -140}
  make input -name in2 -origin {-190 200}
  make global -orient RY -name vdd -origin {370 -140}
  make input -name in3 -origin {-190 300}
  make global -name gnd -origin {-90 340}
  make output -name out -origin {600 -50}
  make global -name gnd -origin {10 340}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {440 -50}
  make MMI_AND4C -origin {650 -270}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP '8*WNA' -WN '4*WNA' -origin {540 -50}
  make pmos -W '2*WMN2' -origin {370 -100}
  make pmos -W '2*WMN2' -origin {240 -100}
  make pmos -W '2*WMN2' -origin {120 -100}
  make pmos -W '2*WMN2' -origin {-90 -100}
  make nmos -W '2*WMN2' -origin {10 0}
  make nmos -W '2*WMN2' -origin {-90 0}
  make nmos -W '2*WMN2' -origin {-100 100}
  make nmos -W '2*WMN2' -origin {10 100}
  make nmos -W '2*WMN2' -origin {-110 200}
  make nmos -W '2*WMN2' -origin {10 200}
  make nmos -W '2*WMN2' -origin {-120 300}
  make nmos -W '2*WMN2' -origin {10 300}
  make LayGen -routing_tracks_below_center 0 -origin {-230 420}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 01/11/00 -origin {90 550}
  make_wire -150 -100 -150 0
  make_wire -190 0 -150 0
  make_wire 120 -60 120 -50
  make_wire 240 -60 240 -50
  make_wire 370 -60 370 -50
  make_wire 180 -100 180 200
  make_wire 310 -100 310 300
  make_wire 60 -100 60 100
  make_wire -90 -60 -90 -50
  make_wire -90 -50 -90 -40
  make_wire 120 -50 240 -50
  make_wire 590 -50 600 -50
  make_wire -50 300 310 300
  make_wire 10 240 10 260
  make_wire -50 200 180 200
  make_wire 10 140 10 160
  make_wire -50 100 60 100
  make_wire 10 -50 -90 -50
  make_wire 10 -50 120 -50
  make_wire 10 -50 10 -40
  make_wire 10 40 10 60
  make_wire -150 0 -50 0
  make_wire 240 -50 370 -50
  make_wire 440 -50 370 -50
  make_wire 440 -50 510 -50
  make_wire -190 100 -160 100
  make_wire -160 100 -50 100
  make_wire -100 40 -100 60
  make_wire -100 40 -90 40
  make_wire -110 140 -110 160
  make_wire -110 140 -100 140
  make_wire -190 200 -170 200
  make_wire -170 200 -50 200
  make_wire -190 300 -180 300
  make_wire -180 300 -50 300
  make_wire -120 340 -90 340
  make_wire -120 240 -120 260
  make_wire -120 240 -110 240
  make_text -origin {-250 -240} -text {4 Input AND}
  make_text -origin {-250 -220} -text {C Size}
  make_text -origin {-250 -260} -text MMI_AND4C -size large
}

proc ICON_MMI_AND4C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_AND4 icon body
  if {$DeMorgan} {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_arc 40 -10 60 10 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc -60 0 -40 20 -start 0 -extent 359
    icon_arc -60 -20 -40 0 -start 0 -extent 359
    icon_arc -60 -40 -40 -20 -start 0 -extent 359
  } else {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line -40 -30 -60 -30
    icon_line -40 -10 -60 -10
    icon_line -40 10 -60 10
    icon_line -40 30 -60 30
    icon_line 40 0 60 0
  }
  # properties
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-37 -22} -size small -label F
  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 -10} -name in1
  icon_term -type input -origin {-60 10} -name in2
  icon_term -type input -origin {-60 30} -name in3
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_AND4C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .in3(\$\{in3\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


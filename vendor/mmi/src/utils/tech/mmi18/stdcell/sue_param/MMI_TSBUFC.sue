# SUE version MMI_SUE4.1.7

proc SCHEMATIC_MMI_TSBUFC {} {
  make MMI_TSBUFC -origin {1060 -90}
  make global -name gnd -origin {560 430}
  make global -orient RY -name vdd -origin {570 70}
  make global -name gnd -origin {970 370}
  make global -orient RY -name vdd -origin {970 130}
  make output -name out -origin {1010 250}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {870 330}
  make pmos -W '8*WNA' -origin {970 170}
  make nmos -W '4*WNA' -origin {970 330}
  make global -name gnd -origin {720 430}
  make global -orient RY -name vdd -origin {740 70}
  make input -name in -origin {440 110}
  make input -name enb -origin {440 320}
  make input -name en -origin {450 10}
  make input -orient RX -name in -origin {780 390}
  make name_net -name N2 -origin {870 170}
  make pmos -orient RX -W '2*WMIN' -origin {740 110}
  make pmos -W '2*WMIN' -origin {560 250}
  make nmos -orient RX -W '1*WMIN' -origin {740 250}
  make nmos -W '1*WMIN' -origin {560 390}
  make pmos -W 1.68 -origin {570 110}
  make nmos -orient RX -W '2*WMIN' -origin {720 390}
  make LayGen -routing_tracks_above_center 0 -origin {340 500}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 02/10/00 -origin {590 600}
  make_wire 970 250 970 210
  make_wire 970 250 970 290
  make_wire 560 330 560 350
  make_wire 560 290 560 330
  make_wire 480 390 500 390
  make_wire 480 250 500 250
  make_wire 560 170 560 210
  make_wire 740 150 740 170
  make_wire 740 170 740 210
  make_wire 740 290 740 330
  make_wire 440 320 480 320
  make_wire 480 320 480 250
  make_wire 480 320 480 390
  make_wire 800 250 840 250
  make_wire 840 250 840 110
  make_wire 840 110 800 110
  make_wire 450 10 840 10
  make_wire 840 10 840 110
  make_wire 970 250 1010 250
  make_wire 870 170 740 170
  make_wire 870 170 910 170
  make_wire 740 330 870 330
  make_wire 870 330 910 330
  make_wire 440 110 510 110
  make_wire 570 150 570 170
  make_wire 570 170 740 170
  make_wire 560 170 570 170
  make_wire 570 70 570 70
  make_wire 570 70 570 70
  make_wire 720 330 720 350
  make_wire 720 330 560 330
  make_wire 720 330 740 330
  make_text -origin {350 -100} -text {Tristate Buffer}
  make_text -origin {350 -80} -text {C Size}
  make_text -origin {350 -120} -text MMI_TSBUFC -size large
}

proc ICON_MMI_TSBUFC args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-60 0} -name in
  icon_term -type output -origin {60 0} -name out
  icon_term -type input -origin {-60 -70} -name enb
  icon_term -type input -origin {-60 60} -name en
  icon_line 30 0 60 0
  icon_line -30 0 -60 0
  icon_property -origin {-10 0} -size large -anchor center -label C
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  icon_line -60 60 -10 60 0 60 0 20
  icon_arc -10 -40 10 -20 -start 0 -extent 359
  icon_line -60 -70 0 -70 0 -40
  icon_line 30 0 -30 40 -30 -30 -30 -40 30 0
  icon_property -origin {-40 360} -type auto -name verilog -text {MMI_TSBUFC [unique_name "" $name MMI_TSBUFC]
(.in($in), .enb($enb), .en($en), .out($out))\;}
}


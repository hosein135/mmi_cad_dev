# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_MUX2D {} {
  make MMI_MUX2D -origin {780 90}
  make output -name out -origin {760 360}
  make input -name sel -origin {90 370}
  make input -name in1 -origin {80 470}
  make input -name in0 -origin {80 260}
  make inverter -WP '16*WNA' -WN '8*WNA' -origin {670 360}
  make inverter -WP '16*WNA' -WN '8*WNA' -origin {300 470}
  make inverter -WP '16*WNA' -WN '8*WNA' -origin {300 260}
  make xgate -WP '16*WNA' -WN '8*WNA' -origin {450 260}
  make xgate -WP '16*WNA' -WN '8*WNA' -origin {450 470}
  make inverter -WP 2.48 -WN '2*WMN2' -origin {200 590}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 12/08/99 -origin {270 780}
  make_wire 350 260 420 260
  make_wire 480 260 560 260
  make_wire 560 260 560 360
  make_wire 560 360 640 360
  make_wire 270 260 80 260
  make_wire 350 470 420 470
  make_wire 480 470 560 470
  make_wire 270 470 80 470
  make_wire 560 470 560 360
  make_wire 450 370 450 300
  make_wire 450 370 450 440
  make_wire 130 370 130 590
  make_wire 130 590 170 590
  make_wire 130 370 90 370
  make_wire 130 370 450 370
  make_wire 450 590 450 510
  make_wire 390 210 450 210
  make_wire 390 590 250 590
  make_wire 390 590 450 590
  make_wire 390 210 390 590
  make_wire 450 210 450 230
  make_wire 720 360 760 360
  make_text -origin {-140 100} -text {D Size}
  make_text -origin {-140 80} -text {2:1 Mux}
  make_text -origin {-140 60} -text MMI_MUX2D -size large
}

proc ICON_MMI_MUX2D args {
  set size D
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "D")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_MUX2 icon body
  icon_line -40 -70 -40 70 40 30 40 -30 -40 -70
  if {$DeMorgan} {
    icon_arc -60 -20 -40 -40 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc 60 -10 40 10 -start 0 -extent 359
  } else {
    icon_line -60 -30 -40 -30
    icon_line -60 30 -40 30
    icon_line 60 0 40 0
  }
  # properties
  icon_property -origin {-37 -30} -size small -label 0 
  icon_property -origin {0 0} -size large -anchor center -label $size
  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 30} -name in1
  icon_term -type input -origin {0 50} -orient R270 -name sel
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_MUX2D
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .sel(\$\{sel\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_MUX2C {} {
  make MMI_MUX2C -origin {870 50}
  make output -name out -origin {520 580}
  make input -name in0 -origin {90 350}
  make input -name sel -origin {90 490}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {440 580}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {180 350}
  make xgate -WP '8*WNA' -WN '4*WNA' -origin {310 350}
  make input -orient RXY -name in1 -origin {740 350}
  make inverter -orient RXY -WP '8*WNA' -WN '4*WNA' -origin {600 350}
  make xgate -orient RXY -WP '8*WNA' -WN '4*WNA' -origin {480 350}
  make inverter -WP '2*WNA' -WN '1*WNA' -origin {160 180}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.5 -date 12/09/99 -origin {350 680}
  make_wire 490 580 520 580
  make_wire 340 350 380 350
  make_wire 380 350 450 350
  make_wire 510 350 550 350
  make_wire 630 350 740 350
  make_wire 310 390 310 490
  make_wire 480 380 480 490
  make_wire 480 180 480 310
  make_wire 310 180 310 320
  make_wire 310 490 480 490
  make_wire 380 580 410 580
  make_wire 380 350 380 580
  make_wire 100 490 90 490
  make_wire 100 490 310 490
  make_wire 230 350 280 350
  make_wire 90 350 150 350
  make_wire 100 180 130 180
  make_wire 100 180 100 490
  make_wire 210 180 310 180
  make_wire 310 180 480 180
  make_text -origin {40 100} -text {C Size}
  make_text -origin {40 80} -text {2:1 Mux}
  make_text -origin {40 60} -text MMI_MUX2C -size large
}

proc ICON_MMI_MUX2C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_MUX2 icon body
  icon_line -40 -70 -40 70 40 30 40 -30 -40 -70
  if {$DeMorgan} {
    icon_arc -60 -20 -40 -40 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc 60 -10 40 10 -start 0 -extent 359
  } else {
    icon_line -60 -30 -40 -30
    icon_line -60 30 -40 30
    icon_line 60 0 40 0
  }
  # properties
  icon_property -origin {-37 -30} -size small -label 0 
  icon_property -origin {0 0} -size large -anchor center -label $size
  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 30} -name in1
  icon_term -type input -origin {0 50} -orient R270 -name sel
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_MUX2C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .sel(\$\{sel\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


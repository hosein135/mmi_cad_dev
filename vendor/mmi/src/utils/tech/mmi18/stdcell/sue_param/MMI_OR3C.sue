# SUE version MMI_SUE4.1.7

proc SCHEMATIC_MMI_OR3C {} {
  make global -name gnd -origin {0 140}
  make global -name gnd -origin {270 140}
  make input -name in1 -origin {-100 -100}
  make global -name gnd -origin {410 140}
  make global -orient RY -name vdd -origin {20 -240}
  make output -name out -origin {680 50}
  make global -orient RY -name vdd -origin {160 -240}
  make input -name in2 -origin {-100 -200}
  make input -name in0 -origin {-100 0}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {480 50}
  make MMI_OR3C -origin {730 -370}
  generate inverter inverter1 -demorgan 1
  make inverter1 -WP '8*WNA' -WN '4*WNA' -origin {610 50}
  make nmos -W '1*WMN2' -origin {410 100}
  make nmos -W '1*WMN2' -origin {270 100}
  make nmos -W '1*WMN2' -origin {0 100}
  make pmos -W '3*WMN2' -origin {0 0}
  make pmos -W '3*WMN2' -origin {160 0}
  make pmos -W '3*WMN2' -origin {160 -100}
  make pmos -W '3*WMN2' -origin {10 -100}
  make pmos -W '3*WMN2' -origin {20 -200}
  make pmos -W '3*WMN2' -origin {160 -200}
  make LayGen -routing_tracks_above_center 0 -origin {-80 240}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 02/10/00 -origin {170 350}
  make_wire 0 60 0 50
  make_wire 0 40 0 50
  make_wire -60 100 -60 0
  make_wire -100 0 -60 0
  make_wire 410 60 410 50
  make_wire 160 40 160 50
  make_wire 160 -40 160 -60
  make_wire 160 -140 160 -160
  make_wire 270 50 270 60
  make_wire 270 50 410 50
  make_wire 660 50 680 50
  make_wire 480 50 410 50
  make_wire 480 50 580 50
  make_wire 0 50 160 50
  make_wire 160 50 270 50
  make_wire 100 -200 350 -200
  make_wire 350 -200 350 100
  make_wire -60 0 100 0
  make_wire 100 -100 210 -100
  make_wire 210 -100 210 100
  make_wire 10 -60 10 -40
  make_wire 0 -40 10 -40
  make_wire -50 -100 -100 -100
  make_wire -50 -100 100 -100
  make_wire 10 -160 20 -160
  make_wire 10 -160 10 -140
  make_wire -40 -200 -100 -200
  make_wire -40 -200 100 -200
  make_text -origin {-190 -340} -text {3 Input OR}
  make_text -origin {-190 -320} -text {C Size}
  make_text -origin {-190 -360} -text MMI_OR3C -size large
}

proc ICON_MMI_OR3C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_OR3 icon body
  if {$DeMorgan} {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_arc 40 -10 60 10 -start 0 -extent 359
    icon_arc -60 10 -40 30 -start 0 -extent 359
    icon_arc -60 -10 -40 10 -start 0 -extent 359
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_line -40 -20 -60 -20
    icon_line -38 0 -60 0
    icon_line -40 20 -60 20
    icon_line 40 0 60 0
  }
  # properties
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-37 -22} -size small -label F
  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 0} -name in1
  icon_term -type input -origin {-60 20} -name in2
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_OR3C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


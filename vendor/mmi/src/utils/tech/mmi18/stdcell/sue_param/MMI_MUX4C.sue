# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_MUX4C {} {
  make MMI_MUX4C -origin {1840 -480}
  make output -name out -origin {1810 -50}
  make input -name sel1 -origin {1200 490}
  generate name_net_s name_net -cell name_net
  make name_net -name sel1_L -origin {1490 490}
  make name_net -name N1 -origin {1370 -270}
  make name_net -name N2 -origin {1590 -270}
  make input -name in0 -origin {720 -370}
  make input -name sel0 -origin {730 -260}
  make input -name in1 -origin {720 -160}
  make input -name in2 -origin {720 90}
  make input -name in3 -origin {720 300}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {1730 -50}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {940 300}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {940 90}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {940 -160}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {940 -370}
  make xgate -WP '8*WNA' -WN '4*WNA' -origin {1090 -160}
  make xgate -WP '8*WNA' -WN '4*WNA' -origin {1090 -370}
  make xgate -WP '8*WNA' -WN '4*WNA' -origin {1090 90}
  make xgate -WP '8*WNA' -WN '4*WNA' -origin {1090 300}
  make inverter -WP 2.4 -WN 1.2 -origin {840 -40}
  make xgate -orient RY -WP '4*WNA' -WN '2*WNA' -origin {1490 -270}
  make xgate -orient RY -WP '4*WNA' -WN '2*WNA' -origin {1490 180}
  make inverter -WP '2*WNA' -WN '1*WNA' -origin {1390 490}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 12/08/99 -origin {1120 620}
  make_wire 1780 -50 1810 -50
  make_wire 1490 -340 1490 -310
  make_wire 1650 -50 1700 -50
  make_wire 1490 240 1490 210
  make_wire 990 -370 1060 -370
  make_wire 1120 -370 1200 -370
  make_wire 1200 -370 1200 -270
  make_wire 910 -370 720 -370
  make_wire 990 -160 1060 -160
  make_wire 1120 -160 1200 -160
  make_wire 910 -160 720 -160
  make_wire 1200 -160 1200 -270
  make_wire 1090 -260 1090 -330
  make_wire 1090 -260 1090 -190
  make_wire 770 -260 770 -40
  make_wire 770 -40 810 -40
  make_wire 770 -260 730 -260
  make_wire 770 -260 1090 -260
  make_wire 1090 -40 1090 -120
  make_wire 1030 -420 1090 -420
  make_wire 1030 -40 890 -40
  make_wire 1030 -40 1090 -40
  make_wire 1030 -420 1030 -40
  make_wire 1090 -420 1090 -400
  make_wire 1200 -270 1370 -270
  make_wire 1460 -270 1370 -270
  make_wire 990 90 1060 90
  make_wire 1120 90 1200 90
  make_wire 910 90 720 90
  make_wire 990 300 1060 300
  make_wire 1120 300 1200 300
  make_wire 910 300 720 300
  make_wire 1090 200 1090 130
  make_wire 1090 200 1090 270
  make_wire 770 200 1090 200
  make_wire 1090 420 1090 340
  make_wire 1030 40 1090 40
  make_wire 1030 420 1090 420
  make_wire 1030 40 1030 420
  make_wire 1430 240 1490 240
  make_wire 1490 -10 1550 -10
  make_wire 1310 410 1310 490
  make_wire 1490 -10 1490 140
  make_wire 1430 -340 1490 -340
  make_wire 1310 410 1430 410
  make_wire 1430 -340 1430 240
  make_wire 1430 240 1430 410
  make_wire 1490 -240 1490 -10
  make_wire 1550 -10 1550 490
  make_wire 1200 180 1460 180
  make_wire 1200 180 1200 300
  make_wire 1200 180 1200 90
  make_wire 1650 -270 1650 -50
  make_wire 1650 -50 1650 180
  make_wire 1520 -270 1590 -270
  make_wire 1590 -270 1650 -270
  make_wire 1520 180 1650 180
  make_wire 1440 490 1490 490
  make_wire 1490 490 1550 490
  make_wire 1200 490 1310 490
  make_wire 1310 490 1360 490
  make_wire 770 -40 770 200
  make_wire 1090 -40 1090 40
  make_wire 1090 40 1090 60
  make_text -origin {500 -460} -text {C Size}
  make_text -origin {500 -480} -text {4:1 Mux}
  make_text -origin {500 -500} -text MMI_MUX4C -size large
}

proc ICON_MMI_MUX4C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_MUX4 icon body
  icon_line -40 -130 -40 130 40 90 40 -90 -40 -130
  if {$DeMorgan} {
    icon_arc -60 -80 -40 -100 -start 0 -extent 359
    icon_arc -60 -20 -40 -40 -start 0 -extent 359
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc -60 80 -40 100 -start 0 -extent 359
    icon_arc 60 -10 40 10 -start 0 -extent 359
  } else {
    icon_line -60 -90 -40 -90
    icon_line -60 -30 -40 -30
    icon_line -60 30 -40 30
    icon_line -60 90 -40 90
    icon_line 60 0 40 0
  }
  # properties
  icon_property -origin {-37 -90} -size small -label 0
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-20 112} -size small -label 0 -anchor center
  # inputs
  icon_term -type input -origin {-60 -90} -name in0
  icon_term -type input -origin {-60 -30} -name in1
  icon_term -type input -origin {-60 30} -name in2
  icon_term -type input -origin {-60 90} -name in3
  icon_term -type input -origin {-20 120} -orient R270 -name sel0
  icon_term -type input -origin {20 100} -orient R270 -name sel1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_MUX4C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .in3(\$\{in3\}), .sel0(\$\{sel0\}), .sel1(\$\{sel1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


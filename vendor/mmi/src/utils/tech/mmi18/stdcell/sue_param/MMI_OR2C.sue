# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_OR2C {} {
  make global -name gnd -origin {0 140}
  make global -name gnd -origin {270 140}
  make global -orient RY -name vdd -origin {10 -140}
  make output -name out -origin {580 50}
  make global -orient RY -name vdd -origin {110 -140}
  make input -name in1 -origin {-100 -100}
  make input -name in0 -origin {-100 0}
  generate name_net_s name_net -cell name_net
  make name_net -name N1 -origin {340 50}
  make MMI_OR2C -origin {630 -250}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 01/12/00 -origin {90 340}
  make LayGen -routing_tracks_below_center 0 -order_devices_by device_name -routing_tracks_above_center 0 -origin {-100 230}
  make pmos -name 1 -W '2*WMN2' -origin {0 -100}
  make pmos -name 2 -W '2*WMN2' -origin {0 0}
  make pmos -name 3 -W '2*WMN2' -origin {110 0}
  make pmos -name 4 -W '2*WMN2' -origin {120 -100}
  make nmos -name 1 -W '1*WMN2' -origin {270 100}
  make nmos -name 2 -W '1*WMN2' -origin {0 100}
  generate inverter inverter1 -demorgan 1
  make inverter1 -name 5 -WP '8*WNA' -WN '4*WNA' -origin {470 50}
  make_wire 0 60 0 50
  make_wire 0 40 0 50
  make_wire -60 100 -60 0
  make_wire 270 60 270 50
  make_wire 520 50 580 50
  make_wire 110 40 110 50
  make_wire 0 50 110 50
  make_wire -100 0 -60 0
  make_wire -60 0 50 0
  make_wire 210 -100 210 100
  make_wire 110 50 270 50
  make_wire 340 50 270 50
  make_wire 340 50 440 50
  make_wire 10 -140 0 -140
  make_wire 0 -60 0 -40
  make_wire -100 -100 -60 -100
  make_wire 110 -140 120 -140
  make_wire 60 -100 -60 -100
  make_wire 60 -100 210 -100
  make_wire 120 -60 120 -40
  make_wire 110 -40 120 -40
  make_text -origin {-180 -220} -text {2 Input OR}
  make_text -origin {-180 -200} -text {C Size}
  make_text -origin {-180 -240} -text MMI_OR2C -size large
}

proc ICON_MMI_OR2C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_OR2 icon body
  if {$DeMorgan} {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_arc 40 -10 60 10 -start 0 -extent 359
    icon_arc -60 10 -40 30 -start 0 -extent 359
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_line -40 -20 -60 -20
    icon_line -40 20 -60 20
    icon_line 40 0 60 0
  }
  # properties
  icon_property -origin {-37 -22} -size small -label F
  icon_property -origin {0 0} -size large -anchor center -label $size
  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_OR2C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


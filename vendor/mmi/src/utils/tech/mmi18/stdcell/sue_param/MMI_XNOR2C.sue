# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_XNOR2C {} {
  make MMI_XNOR2C -origin {770 90}
  make output -name out -origin {730 490}
  make input -name in1 -origin {220 380}
  make input -name in0 -origin {220 340}
  make MMI_NAND2B -origin {640 360}
  make MMI_OAI21C -origin {600 490}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 01/19/00 -origin {340 750}
  make LayGen -routing_tracks_below_center 0 -routing_tracks_above_center 0 -preroute_outer no -origin {90 620}
  make_wire 700 490 730 490
  make_wire 280 490 500 490
  make_wire 250 530 500 530
  make_wire 220 340 250 340
  make_wire 250 340 580 340
  make_wire 250 340 250 530
  make_wire 220 380 280 380
  make_wire 280 380 580 380
  make_wire 280 380 280 490
  make_wire 490 420 700 420
  make_wire 490 420 490 460
  make_wire 490 460 500 460
  make_wire 700 360 700 420
  make_text -origin {0 100} -text {Exclusive NOR}
  make_text -origin {0 120} -text {C Size}
  make_text -origin {0 80} -text MMI_XNOR2C -size large
}

proc ICON_MMI_XNOR2C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_XNOR2 icon body
  icon_arc -60 -30 50 110 -start 35 -extent 50
  icon_arc -48 -30 -28 30 -start 270 -extent 180
  icon_line -38 -30 0 -30
  icon_line -38 30 0 30
  icon_arc -60 -110 50 30 -start 275 -extent 50
  icon_arc -58 -30 -38 30 -start 270 -extent 180
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-27 -20} -size small -label F
  if {$DeMorgan} {
    icon_line 40 0 60 0
    icon_line -60 20 -40 20
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_arc 40 -10 60 10 -start 0 -extent 359
    icon_line -60 20 -40 20
    icon_line -60 -20 -40 -20
  }
  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_XNOR2C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


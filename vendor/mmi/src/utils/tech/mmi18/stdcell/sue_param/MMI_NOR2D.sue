# SUE version MMI_SUE4.1.7

proc SCHEMATIC_MMI_NOR2D {} {
  make global -name gnd -origin {0 140}
  make global -orient RY -name vdd -origin {0 -140}
  make output -name out -origin {450 50}
  make global -name gnd -origin {380 140}
  make nmos -W '8*WNA' -origin {380 100}
  make nmos -W '8*WNA' -origin {0 100}
  make pmos -W '16*WNA' -origin {150 -100}
  make pmos -W '16*WNA' -origin {140 0}
  make pmos -W '16*WNA' -origin {0 -100}
  make pmos -W '16*WNA' -origin {0 0}
  make input -name in1 -origin {-100 -100}
  make input -name in0 -origin {-100 0}
  make MMI_NOR2D -origin {570 -210}
  make LayGen -routing_tracks_above_center 0 -preroute_outer metal -origin {-100 240}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 02/09/00 -origin {200 370}
  make_wire 0 60 0 50
  make_wire 0 40 0 50
  make_wire 0 -40 0 -60
  make_wire 380 60 380 50
  make_wire 0 -140 150 -140
  make_wire 380 50 450 50
  make_wire -60 -100 90 -100
  make_wire -100 0 -60 0
  make_wire -60 0 80 0
  make_wire 140 40 140 50
  make_wire 140 50 0 50
  make_wire 140 50 380 50
  make_wire 140 -60 140 -40
  make_wire 140 -60 150 -60
  make_wire -80 100 -80 -100
  make_wire -80 -100 -60 -100
  make_wire -80 -100 -100 -100
  make_wire -60 100 -50 100
  make_wire -60 100 -80 100
  make_wire 320 100 320 0
  make_wire 320 0 80 0
  make_text -origin {-180 -200} -text {2 Input NOR}
  make_text -origin {-180 -180} -text {D Size}
  make_text -origin {-180 -220} -text MMI_NOR2D -size large
}

proc ICON_MMI_NOR2D args {
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1
  icon_term -type output -origin {60 0} -name out
  icon_arc -60 -30 50 110 -start 35 -extent 50
  icon_arc -60 -110 50 30 -start 275 -extent 50
  icon_arc -58 -30 -38 30 -start 270 -extent 180
  icon_line -48 -30 0 -30
  icon_line -48 30 0 30
  icon_line -40 -20 -60 -20
  icon_line -40 20 -60 20
  icon_arc 40 -10 60 10 -start 0 -extent 359
  icon_property -origin {-37 -22} -size small -label F
  icon_property -origin {0 0} -size large -anchor center -label D
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  icon_property -origin {-40 360} -type auto -name verilog -text {MMI_NOR2D [unique_name "" $name MMI_NOR2D]
(.in0($in0), .in1($in1), .out($out))\;}
}


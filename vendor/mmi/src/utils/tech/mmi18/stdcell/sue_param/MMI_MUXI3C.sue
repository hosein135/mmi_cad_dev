# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_MUXI3C {} {
  make MMI_MUXI3C -origin {1790 -550}
  make output -name out -origin {1880 -190}
  make input -name in2 -origin {1180 60}
  make input -name sel1 -origin {1320 250}
  generate name_net_s name_net -cell name_net
  make name_net -name sel1_L -origin {1610 250}
  make name_net -name in2_L -origin {1500 60}
  make name_net -name N1 -origin {1490 -270}
  make name_net -name N2 -origin {1710 -270}
  make xgate -orient RY -WP '4*WNA' -WN '2*WNA' -origin {1610 -270}
  make xgate -orient RY -WP '4*WNA' -WN '2*WNA' -origin {1610 60}
  make inverter -WP '2*WNA' -WN '1*WNA' -origin {1480 250}
  make xgate -WP '4*WNA' -WN '2*WNA' -origin {1210 -370}
  make xgate -WP '4*WNA' -WN '2*WNA' -origin {1210 -160}
  make inverter -WP '2*WNA' -WN '1*WNA' -origin {960 -40}
  make input -name in0 -origin {840 -370}
  make input -name sel0 -origin {850 -260}
  make input -name in1 -origin {840 -160}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {1800 -190}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {1400 -270}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {1400 60}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {1060 -160}
  make inverter -WP '8*WNA' -WN '4*WNA' -origin {1060 -370}
  make inverter -WP '4*WNA' -WN '2*WNA' -origin {1280 60}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/09/99 -origin {1190 400}
  make_wire 1850 -190 1880 -190
  make_wire 1610 -340 1610 -310
  make_wire 1720 -190 1770 -190
  make_wire 1640 60 1720 60
  make_wire 1610 120 1610 90
  make_wire 1550 120 1610 120
  make_wire 1430 120 1550 120
  make_wire 1430 120 1430 250
  make_wire 1610 250 1530 250
  make_wire 1610 250 1670 250
  make_wire 1500 60 1450 60
  make_wire 1500 60 1580 60
  make_wire 1710 -270 1640 -270
  make_wire 1710 -270 1720 -270
  make_wire 1610 -240 1610 -130
  make_wire 1610 -130 1610 20
  make_wire 1720 -270 1720 -190
  make_wire 1720 -190 1720 60
  make_wire 1550 -340 1550 120
  make_wire 1550 -340 1610 -340
  make_wire 1670 -130 1670 250
  make_wire 1610 -130 1670 -130
  make_wire 1110 -370 1180 -370
  make_wire 1240 -370 1320 -370
  make_wire 1030 -370 840 -370
  make_wire 1110 -160 1180 -160
  make_wire 1240 -160 1320 -160
  make_wire 1030 -160 840 -160
  make_wire 1210 -260 1210 -330
  make_wire 1210 -260 1210 -190
  make_wire 890 -260 890 -40
  make_wire 890 -40 930 -40
  make_wire 890 -260 850 -260
  make_wire 890 -260 1210 -260
  make_wire 1210 -40 1210 -120
  make_wire 1150 -420 1210 -420
  make_wire 1150 -40 1010 -40
  make_wire 1150 -40 1210 -40
  make_wire 1150 -420 1150 -40
  make_wire 1210 -420 1210 -400
  make_wire 1580 -270 1490 -270
  make_wire 1320 250 1430 250
  make_wire 1430 250 1450 250
  make_wire 1450 -270 1490 -270
  make_wire 1370 -270 1320 -270
  make_wire 1320 -270 1320 -160
  make_wire 1320 -270 1320 -370
  make_wire 1180 60 1250 60
  make_wire 1330 60 1370 60
  make_text -origin {770 -560} -text {Inverting 3:1 Mux }
  make_text -origin {770 -540} -text {C Size}
  make_text -origin {770 -580} -text MMI_MUXI3C -size large
}

proc ICON_MMI_MUXI3C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_MUXI3 icon body
  icon_line -40 -100 -40 100 40 60 40 -60 -40 -100
  if {$DeMorgan} {
    icon_arc -60 -50 -40 -70 -start 0 -extent 359
    icon_arc -60 -10 -40 10 -start 0 -extent 359
    icon_arc -60 50 -40 70 -start 0 -extent 359
    icon_line 60 0 40 0
  } else {
    icon_line -60 -60 -40 -60
    icon_line -60 0 -40 0
    icon_line -60 60 -40 60
    icon_arc 60 -10 40 10 -start 0 -extent 359
  }
  # properties
  icon_property -origin {-37 -60} -size small -label 0
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-20 82} -size small -label 0 -anchor center
  # inputs
  icon_term -type input -origin {-60 -60} -name in0
  icon_term -type input -origin {-60 0} -name in1
  icon_term -type input -origin {-60 60} -name in2
  icon_term -type input -origin {-20 90} -orient R270 -name sel0
  icon_term -type input -origin {20 70} -orient R270 -name sel1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_MUXI3C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .sel0(\$\{sel0\}), .sel1(\$\{sel1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


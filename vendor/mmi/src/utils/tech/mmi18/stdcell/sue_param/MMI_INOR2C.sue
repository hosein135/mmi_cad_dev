# SUE version MMI_SUE4.1.7

proc SCHEMATIC_MMI_INOR2C {} {
  make input -name in1 -origin {0 10}
  make input -name in0 -origin {0 -90}
  generate name_net_s name_net -cell name_net
  make name_net -name in1_L -origin {210 10}
  make global -name gnd -origin {420 150}
  make global -name gnd -origin {350 210}
  make global -orient RY -name vdd -origin {350 -130}
  make output -name out -origin {740 60}
  make global -orient RY -name vdd -origin {490 -130}
  make global -orient RY -name vdd -origin {430 -130}
  make global -orient RY -name vdd -origin {580 -130}
  make MMI_INOR2C -origin {790 -300}
  make nmos -W '4*WNA' -origin {420 110}
  make nmos -W '4*WNA' -origin {350 170}
  make pmos -W '4*WNA' -origin {350 10}
  make pmos -W '4*WNA' -origin {420 10}
  make pmos -W '4*WNA' -origin {500 10}
  make pmos -W '4*WNA' -origin {570 10}
  make pmos -W '4*WNA' -origin {580 -90}
  make pmos -W '4*WNA' -origin {490 -90}
  make pmos -W '4*WNA' -origin {430 -90}
  make pmos -W '4*WNA' -origin {350 -90}
  make inverter -WP '4*WNA' -WN '2*WNA' -origin {70 10}
  make LayGen -routing_tracks_above_center 0 -origin {0 290}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 02/10/00 -origin {280 380}
  make_wire 0 10 40 10
  make_wire 120 10 210 10
  make_wire 350 50 350 60
  make_wire 350 -30 350 -50
  make_wire 360 10 290 10
  make_wire 210 10 280 10
  make_wire 280 10 290 10
  make_wire 420 50 420 60
  make_wire 420 60 420 70
  make_wire 280 110 360 110
  make_wire 280 10 280 110
  make_wire 350 60 350 130
  make_wire 350 60 420 60
  make_wire 290 170 250 170
  make_wire 250 170 250 -90
  make_wire 250 -90 0 -90
  make_wire 250 -90 290 -90
  make_wire 430 -50 430 -30
  make_wire 420 -30 430 -30
  make_wire 370 -90 290 -90
  make_wire 500 -50 500 -30
  make_wire 490 -50 500 -50
  make_wire 500 50 500 60
  make_wire 500 60 420 60
  make_wire 360 10 440 10
  make_wire 440 10 510 10
  make_wire 570 50 570 60
  make_wire 570 60 500 60
  make_wire 570 60 740 60
  make_wire 370 -90 430 -90
  make_wire 430 -90 520 -90
  make_wire 580 -50 580 -30
  make_wire 570 -30 580 -30
  make_text -origin {-50 -270} -text {2 Input NOR with one inverted input}
  make_text -origin {-50 -250} -text {C Size}
  make_text -origin {-50 -290} -text MMI_INOR2C -size large
}

proc ICON_MMI_INOR2C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_INOR2 icon body
  if {$DeMorgan} {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line -60 20 -40 20
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
    icon_line 40 0 60 0
  } else {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_arc -60 30 -40 10 -start 0 -extent 359
    icon_line -40 -20 -60 -20
    icon_arc 40 -10 60 10 -start 0 -extent 359
  }
  # properties
  icon_property -origin {-37 -22} -size small -label F
  icon_property -origin {0 0} -size large -anchor center -label $size
  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_INOR2C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


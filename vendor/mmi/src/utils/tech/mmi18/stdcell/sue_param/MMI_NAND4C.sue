# SUE version MMI_SUE4.1.5

proc SCHEMATIC_MMI_NAND4C {} {
  make global -orient RY -name vdd -origin {-90 -140}
  make input -name in0 -origin {-190 0}
  make global -orient RY -name vdd -origin {260 -140}
  make input -name in1 -origin {-190 100}
  make global -orient RY -name vdd -origin {420 -140}
  make input -name in2 -origin {-190 200}
  make global -orient RY -name vdd -origin {580 -140}
  make input -name in3 -origin {-190 300}
  make global -name gnd -origin {-90 340}
  make output -name out -origin {650 -50}
  make global -name gnd -origin {0 340}
  make global -orient RY -name vdd -origin {-30 -140}
  make global -orient RY -name vdd -origin {320 -140}
  make global -orient RY -name vdd -origin {470 -140}
  make global -orient RY -name vdd -origin {630 -140}
  make global -name gnd -origin {70 340}
  make global -name gnd -origin {160 340}
  make MMI_NAND4C -origin {710 -270}
  make pmos -W '4*WNA' -origin {-90 -100}
  make pmos -W '4*WNA' -origin {-30 -100}
  make pmos -W '4*WNA' -origin {260 -100}
  make pmos -W '4*WNA' -origin {320 -100}
  make pmos -W '4*WNA' -origin {420 -100}
  make pmos -W '4*WNA' -origin {470 -100}
  make pmos -W '4*WNA' -origin {580 -100}
  make pmos -W '4*WNA' -origin {630 -100}
  make nmos -W '4*WNA' -origin {160 0}
  make nmos -W '4*WNA' -origin {-90 0}
  make nmos -W '4*WNA' -origin {0 0}
  make nmos -W '4*WNA' -origin {80 0}
  make nmos -W '4*WNA' -origin {-90 100}
  make nmos -W '4*WNA' -origin {-90 200}
  make nmos -W '4*WNA' -origin {-90 300}
  make nmos -W '4*WNA' -origin {0 300}
  make nmos -W '4*WNA' -origin {0 200}
  make nmos -W '4*WNA' -origin {0 100}
  make nmos -W '4*WNA' -origin {80 100}
  make nmos -W '4*WNA' -origin {160 100}
  make nmos -W '4*WNA' -origin {80 200}
  make nmos -W '4*WNA' -origin {160 200}
  make nmos -W '4*WNA' -origin {80 300}
  make nmos -W '4*WNA' -origin {160 300}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {210 540}
  make_wire 20 0 100 0
  make_wire -90 40 -90 60
  make_wire -90 140 -90 160
  make_wire -90 240 -90 260
  make_wire -150 -100 -150 0
  make_wire -30 -60 -30 -50
  make_wire 260 -60 260 -50
  make_wire 420 -60 420 -50
  make_wire 580 -60 580 -50
  make_wire -150 -100 -90 -100
  make_wire 320 -60 320 -50
  make_wire 470 -60 470 -50
  make_wire 630 -50 580 -50
  make_wire 630 -50 650 -50
  make_wire 630 -60 630 -50
  make_wire -90 -60 -90 -50
  make_wire -90 -50 -90 -40
  make_wire 0 -50 0 -40
  make_wire -190 0 -150 0
  make_wire -150 0 -60 0
  make_wire 0 40 0 60
  make_wire 0 140 0 160
  make_wire 0 240 0 260
  make_wire 160 140 160 160
  make_wire 160 240 160 260
  make_wire -190 200 -150 200
  make_wire -150 200 -60 200
  make_wire -190 100 -150 100
  make_wire -150 100 -60 100
  make_wire -190 300 -150 300
  make_wire -150 300 -60 300
  make_wire 360 -100 360 200
  make_wire -90 -50 -30 -50
  make_wire -30 -50 0 -50
  make_wire 520 -100 520 300
  make_wire 200 -100 200 100
  make_wire 320 -50 420 -50
  make_wire 470 -50 420 -50
  make_wire 580 -50 470 -50
  make_wire 200 -100 260 -100
  make_wire 100 100 200 100
  make_wire 70 340 80 340
  make_wire 20 300 -60 300
  make_wire 80 240 80 260
  make_wire 80 140 80 160
  make_wire 20 200 -60 200
  make_wire 20 100 -60 100
  make_wire 20 100 100 100
  make_wire 260 -50 320 -50
  make_wire 80 -50 0 -50
  make_wire 80 40 80 60
  make_wire 80 -50 80 -40
  make_wire 160 -50 80 -50
  make_wire 160 -50 260 -50
  make_wire 160 40 160 60
  make_wire -60 0 20 0
  make_wire 160 -50 160 -40
  make_wire 20 300 100 300
  make_wire 100 300 520 300
  make_wire 520 -100 570 -100
  make_wire 360 -100 410 -100
  make_wire 20 200 100 200
  make_wire 100 200 360 200
  make_text -origin {-250 -240} -text {4 Input NAND}
  make_text -origin {-250 -220} -text {C Size}
  make_text -origin {-250 -260} -text MMI_NAND4C -size large
}

proc ICON_MMI_NAND4C args {
  set size C
  set DeMorgan 0
  # check for acceptable response on Size
  if {($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }
  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}
  # MMI_NAND4 icon body
  if {$DeMorgan} {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_line 40 0 60 0
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc -60 0 -40 20 -start 0 -extent 359
    icon_arc -60 -20 -40 0 -start 0 -extent 359
    icon_arc -60 -40 -40 -20 -start 0 -extent 359
  } else {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line -40 -30 -60 -30
    icon_line -40 -10 -60 -10
    icon_line -40 10 -60 10
    icon_line -40 30 -60 30
    icon_arc 40 -10 60 10 -start 0 -extent 359
  }
  # properties
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-37 -22} -size small -label F
  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 -10} -name in1
  icon_term -type input -origin {-60 10} -name in2
  icon_term -type input -origin {-60 30} -name in3
  # outputs
  icon_term -type output -origin {60 0} -name out
  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc
  # verilog property
  if {!$DeMorgan} {
    set fname MMI_NAND4C
    set vprop [format "%s \[unique_name \"\" \$name %s\] (.in0(\$\{in0\}), .in1(\$\{in1\}), .in2(\$\{in2\}), .in3(\$\{in3\}), .out(\$\{out\}))\\;" $fname $fname]
    icon_property -origin {-40 360} -type auto -name verilog -text $vprop
  }
}


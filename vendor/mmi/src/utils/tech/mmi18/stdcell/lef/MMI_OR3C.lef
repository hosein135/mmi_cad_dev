	OBS
		LAYER M1 ;
		RECT 1.76 4.41 2.1 5.96 ;
		LAYER M1 ;
		RECT 1.76 4.18 2.75 4.41 ;
		LAYER M1 ;
		RECT 2.52 3.445 2.75 4.18 ;
		LAYER M1 ;

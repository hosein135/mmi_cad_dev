			RECT 0.885 2.81 1.335 2.815 ;
			LAYER M1 ;
			RECT 0.64 2.47 1.335 2.81 ;
			LAYER M1 ;
			RECT 0.885 2.365 1.335 2.47 ;
		END
		AntennaGateArea 0.3312 ;
	END in0
	OBS
		LAYER M1 ;
		RECT 0.9 1.88 2.68 2.11 ;
		LAYER M1 ;
		RECT 0.9 1.27 1.24 1.88 ;
		LAYER M1 ;
		RECT 2.34 1.27 2.68 1.88 ;
	END
END MMI_OAI21A

			LAYER M1 ;
			RECT 1.625 3.9 2.445 4.24 ;
			LAYER M1 ;
			RECT 1.625 3.845 2.075 3.9 ;
		END
		AntennaGateArea 2.6496 ;
	END in0
	OBS
	END
END MMI_NAND2D

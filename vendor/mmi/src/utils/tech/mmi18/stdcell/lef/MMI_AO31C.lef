	END in0
	OBS
		LAYER M1 ;
		RECT 0.18 4.18 0.52 6.58 ;
		LAYER M1 ;
		RECT 0.9 4.41 1.24 6.58 ;
		LAYER M1 ;
		RECT 2.34 4.41 2.68 6.58 ;
		LAYER M1 ;
		RECT 0.9 4.18 2.68 4.41 ;
		LAYER M1 ;
		RECT 0.235 2.775 0.465 4.18 ;
		LAYER M1 ;
		RECT 3.86 2.78 4.2 3.12 ;
		LAYER M1 ;
		RECT 3.86 2.775 4.09 2.78 ;
		LAYER M1 ;
		RECT 0.235 2.545 4.09 2.775 ;
		LAYER M1 ;
		RECT 1.6 0.73 1.94 2.545 ;
	END
END MMI_AO31C

		LAYER M1 ;
		RECT 1.7 4.115 2.795 4.345 ;
		LAYER M1 ;
		RECT 1.7 3.5 1.93 4.115 ;
		LAYER M1 ;
		RECT 1.365 3.16 1.93 3.5 ;
		LAYER M1 ;
		RECT 1.7 2.4 1.93 3.16 ;
		LAYER M1 ;
		RECT 2.53 2.64 4.09 2.87 ;
		LAYER M1 ;
		RECT 2.53 2.4 2.76 2.64 ;
		LAYER M1 ;
		RECT 3.86 2.4 4.09 2.64 ;
		LAYER M1 ;
		RECT 1.7 1.24 2.04 2.4 ;
		LAYER M1 ;
		RECT 2.42 1.24 2.76 2.4 ;
		LAYER M1 ;

			LAYER M1 ;
			RECT 1 0.5 1.34 2.85 ;
			LAYER M1 ;
			RECT 3.14 0.5 3.48 2.4 ;
			LAYER M1 ;
			RECT 0 -0.5 4.44 0.5 ;
		END
	END GND
	PIN in2

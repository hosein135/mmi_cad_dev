			RECT 1.91 4.02 2.14 4.26 ;
			LAYER M1 ;
			RECT 0.145 3.79 2.14 4.02 ;
			LAYER M1 ;
			RECT 0.18 1.335 0.52 3.79 ;
			LAYER M1 ;
			RECT 1.62 1.335 1.96 2.385 ;
			LAYER M1 ;
			RECT 0.18 1.105 1.96 1.335 ;
		END
		AntennaDiffArea 4.8576 ;
	END out
	PIN in1
		DIRECTION input ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 3.105 3.445 3.555 3.555 ;
			LAYER M1 ;
			RECT 3.105 3.105 3.66 3.445 ;
		END
		AntennaGateArea 1.656 ;
	END in1
	PIN GND
		DIRECTION inout ;
		USE GROUND ;
		PORT
			LAYER M1 ;
			RECT 5.22 0.5 5.56 2.385 ;
			LAYER M1 ;
			RECT 6.66 0.5 7 2.865 ;
			LAYER M1 ;
			RECT 0 -0.5 7.4 0.5 ;
		END
	END GND
	PIN in2
		DIRECTION input ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 5.325 3.445 5.775 3.555 ;
			LAYER M1 ;
			RECT 5.11 3.105 5.775 3.445 ;
		END
		AntennaGateArea 1.656 ;
	END in2
	PIN VDD
		DIRECTION inout ;
		USE POWER ;
		PORT
			LAYER M1 ;
			RECT 0 6.9 7.4 7.9 ;
			LAYER M1 ;
			RECT 1.19 4.26 1.53 6.9 ;
			LAYER M1 ;
			RECT 2.63 4.74 2.97 6.9 ;
			LAYER M1 ;
			RECT 4.07 4.74 4.41 6.9 ;
			LAYER M1 ;
			RECT 5.51 4.26 5.85 6.9 ;
		END

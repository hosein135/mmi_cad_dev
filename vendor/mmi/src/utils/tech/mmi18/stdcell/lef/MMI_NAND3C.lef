MACRO MMI_NAND3C
	CLASS CORE ;
	FOREIGN MMI_NAND3C 0 0 ;
	SIZE 7.4 BY 7.4 ;
	SYMMETRY X Y ;
	SITE CORE1 ;
	PIN out
		DIRECTION output ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 1.91 4.49 2.25 6.02 ;
			LAYER M1 ;
			RECT 3.35 4.49 3.69 6.02 ;
			LAYER M1 ;
			RECT 4.79 4.49 5.13 6.02 ;

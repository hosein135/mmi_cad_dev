	END in0
	OBS
		LAYER M1 ;
		RECT 0.9 2.635 2.68 2.865 ;
		LAYER M1 ;
		RECT 0.9 1.585 1.24 2.635 ;
		LAYER M1 ;
		RECT 2.34 1.335 2.68 2.635 ;
		LAYER M1 ;
		RECT 3.06 2.635 6.28 2.865 ;
		LAYER M1 ;
		RECT 3.06 1.585 3.4 2.635 ;
		LAYER M1 ;
		RECT 3.78 1.335 4.12 2.385 ;
		LAYER M1 ;
		RECT 2.34 1.105 4.12 1.335 ;
		LAYER M1 ;
		RECT 4.5 1.105 4.84 2.635 ;
		LAYER M1 ;
		RECT 5.94 1.105 6.28 2.635 ;
	END
END MMI_NAND3C

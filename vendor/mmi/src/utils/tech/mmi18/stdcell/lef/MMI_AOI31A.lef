			RECT 0.825 3.105 1.335 3.555 ;
			LAYER M1 ;
			RECT 0.94 2.54 1.17 3.105 ;
			LAYER M1 ;
			RECT 0.94 1.24 1.28 2.54 ;
		END
		AntennaDiffArea 1.5916 ;
	END out
	PIN in1
		DIRECTION input ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 1.625 4.19 2.075 4.295 ;
			LAYER M1 ;
			RECT 1.285 3.85 2.075 4.19 ;

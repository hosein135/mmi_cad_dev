MACRO MMI_AOI31A
	CLASS CORE ;
	FOREIGN MMI_AOI31A 0 0 ;
	SIZE 3.7 BY 7.4 ;
	SYMMETRY X Y ;
	SITE CORE1 ;
	PIN out
		DIRECTION output ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 0.18 4.545 0.52 6.305 ;
			LAYER M1 ;
			RECT 0.29 4.135 0.52 4.545 ;
			LAYER M1 ;
			RECT 0.29 3.905 1.055 4.135 ;

			LAYER M1 ;
			RECT 0.18 0.5 0.52 2.54 ;
			LAYER M1 ;
			RECT 2.52 0.5 2.86 2.54 ;
			LAYER M1 ;
			RECT 0 -0.5 3.7 0.5 ;
		END
	END GND
	PIN in2
		DIRECTION input ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 1.625 3.105 2.075 3.555 ;
		END
		AntennaGateArea 0.5796 ;
	END in2
	PIN VDD
		DIRECTION inout ;
		USE POWER ;
		PORT
			LAYER M1 ;
			RECT 0 6.9 3.7 7.9 ;
			LAYER M1 ;
			RECT 1.62 5.025 1.96 6.9 ;
			LAYER M1 ;
			RECT 3.06 4.545 3.4 6.9 ;

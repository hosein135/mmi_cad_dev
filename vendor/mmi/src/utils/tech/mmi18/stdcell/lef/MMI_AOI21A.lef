			LAYER M1 ;
			RECT 0.18 0.5 0.52 2.41 ;
			LAYER M1 ;
			RECT 2.09 0.5 2.43 2.41 ;
			LAYER M1 ;
			RECT 0 -0.5 2.96 0.5 ;
		END
	END GND
	PIN in2
		DIRECTION input ;
		USE SIGNAL ;

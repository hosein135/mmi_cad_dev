			RECT 0.94 2.41 1.17 2.64 ;
			LAYER M1 ;
			RECT 0.94 1.57 1.28 2.41 ;
		END
		AntennaDiffArea 1.3708 ;
	END out
	PIN in1
		DIRECTION input ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 0.885 3.5 1.335 3.555 ;
			LAYER M1 ;
			RECT 0.885 3.445 1.52 3.5 ;
			LAYER M1 ;
			RECT 0.885 3.215 1.585 3.445 ;

MACRO MMI_AOI21A
	CLASS CORE ;
	FOREIGN MMI_AOI21A 0 0 ;
	SIZE 2.96 BY 7.4 ;
	SYMMETRY X Y ;
	SITE CORE1 ;
	PIN out
		DIRECTION output ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 0.18 4.525 0.52 6.285 ;
			LAYER M1 ;
			RECT 0.18 3.555 0.41 4.525 ;
			LAYER M1 ;
			RECT 0.145 3.105 0.595 3.555 ;

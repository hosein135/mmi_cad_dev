			LAYER M1 ;
			RECT 1.97 4.195 2.815 4.295 ;
			LAYER M1 ;
			RECT 1.86 3.855 2.815 4.195 ;
			LAYER M1 ;
			RECT 1.97 3.845 2.815 3.855 ;
		END
		AntennaGateArea 0.4968 ;
	END in2

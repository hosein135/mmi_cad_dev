		AntennaDiffArea 0.4032 ;
	END in
	OBS
		LAYER M1 ;
		RECT 0.27 4.175 0.61 4.22 ;
		LAYER M1 ;
		RECT 0.93 4.175 1.27 4.46 ;
		LAYER M1 ;
		RECT 0.27 4.12 1.27 4.175 ;
		LAYER M1 ;
		RECT 0.27 3.945 1.165 4.12 ;
		LAYER M1 ;
		RECT 0.27 3.88 0.61 3.945 ;
		LAYER M1 ;
		RECT 0.935 3.07 1.165 3.945 ;
		LAYER M1 ;

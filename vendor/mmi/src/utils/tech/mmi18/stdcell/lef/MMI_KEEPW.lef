MACRO MMI_KEEPW
	CLASS CORE ;
	FOREIGN MMI_KEEPW 0 0 ;
	SIZE 2.22 BY 7.4 ;
	SYMMETRY X Y ;
	SITE CORE1 ;
	PIN GND
		DIRECTION inout ;
		USE GROUND ;
		PORT
			LAYER M1 ;
			RECT 0.93 2.06 1.27 2.17 ;
			LAYER M1 ;
			RECT 0.395 1.83 1.27 2.06 ;
			LAYER M1 ;
			RECT 0.395 0.5 0.625 1.83 ;
			LAYER M1 ;
			RECT 0 -0.5 2.22 0.5 ;
		END
	END GND
	PIN VDD
		DIRECTION inout ;
		USE POWER ;
		PORT
			LAYER M1 ;
			RECT 0 6.9 2.22 7.9 ;

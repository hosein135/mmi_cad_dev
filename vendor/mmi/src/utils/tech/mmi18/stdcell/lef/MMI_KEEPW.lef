			LAYER M1 ;
			RECT 0.93 5.79 1.27 5.9 ;
			LAYER M1 ;
			RECT 0.93 5.56 1.855 5.79 ;
			LAYER M1 ;
			RECT 1.625 3.555 1.855 5.56 ;
			LAYER M1 ;

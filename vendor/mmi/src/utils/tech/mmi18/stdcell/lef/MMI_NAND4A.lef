	END in3
	PIN in0
		DIRECTION input ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 0.145 4.24 0.595 4.295 ;
			LAYER M1 ;
			RECT 0.145 4.185 0.76 4.24 ;
			LAYER M1 ;
			RECT 0.145 3.955 0.825 4.185 ;

		PORT
			LAYER M1 ;
			RECT 0.885 4.93 1.335 5.035 ;
			LAYER M1 ;
			RECT 0.885 4.59 1.43 4.93 ;
			LAYER M1 ;
			RECT 0.885 4.585 1.335 4.59 ;
		END

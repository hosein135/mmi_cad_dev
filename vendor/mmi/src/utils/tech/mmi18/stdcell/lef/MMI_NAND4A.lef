			LAYER M1 ;
			RECT 0.9 5.52 1.24 6.13 ;
			LAYER M1 ;
			RECT 2.34 5.52 2.68 6.13 ;
			LAYER M1 ;
			RECT 0.9 5.29 2.68 5.52 ;
			LAYER M1 ;
			RECT 1.66 4.295 1.89 5.29 ;

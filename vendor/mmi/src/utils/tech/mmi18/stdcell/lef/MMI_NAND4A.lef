			LAYER M1 ;
			RECT 2.19 0.5 2.53 2.49 ;
			LAYER M1 ;
			RECT 0 -0.5 3.7 0.5 ;
		END
	END GND
	PIN in2
		DIRECTION input ;
		USE SIGNAL ;
		PORT
			LAYER M1 ;
			RECT 1.625 3.55 2.075 3.555 ;
			LAYER M1 ;
			RECT 1.57 3.21 2.075 3.55 ;
			LAYER M1 ;
			RECT 1.625 3.105 2.075 3.21 ;
		END

comment Scan Flip Flop with asynchronous clear and tristate enable generator

set hold -0.1
set clear clrb

function q = IQ

# Special synopsys header for a flip-flop
header
       test_cell() {
            ff(IQ,IQN) {
                next_state : "d" ;
                clocked_on : "clk" ;
                clear : "!clrb" ;
            }
            pin(d) {
                direction : input ;
            }
            pin(s_in) {
                direction : input ;
                signal_type : "test_scan_in" ;
            }
            pin(s_en) {
                direction : input ;
                signal_type : "test_scan_enable" ;
            }
            pin(clk) {
                direction : input ;
            }
            pin(clrb) {
                direction : input ;
            }
            pin(en) {
                direction : input ;
                function : "IQ" ;
            }
            pin(enb) {
                direction : input ;
                function : "IQN" ;
            }
            pin(s_out) {
                direction : output ;
                function : "IQ" ;
                signal_type : "test_scan_out" ;
                test_output_only : true ;
            }
        }
	ff (IQ,IQN){
		clocked_on : "clk";
                next_state : "((!s_en&d)|(s_en&s_in))";
		clear : "!clrb";
	}
end
# Special verilog code, too complicated to auto-generate
verilog
	reg	q;

	always @(posedge clk or negedge clrb) begin
		if (clrb == 0)
			q <= #1 1'b0;
                        en <= #1 1'b0;
                        enb <= #1 1'b1;
		else
			q <= #1 d;
        		en = (q&!s_en);
        		enb = ~en;
        end

step {clk ^v} {d 1} {clrb 1} {s_in 0} {s_en 0}
measure {en v} with {d 0} {clk ^v} 
measure {en ^} with {d 1} {clk ^v} 
measure {enb ^} with {d 0} {clk ^v} 
measure {enb v} with {d 1} {clk ^v} 
measure {enb ^} with {clrb v}
step {clk ^v} {d 1} {clrb 1}
measure {en v} with {clrb v}

measure {s_out ^} with {s_in 1} {s_en 1} {clrb 1} {clk ^v}
measure {s_out v} with {s_in 0} {s_en 1} {clrb 1} {clk ^v}


# measure the input capacitance of wen when clk is low
cap clk with {d 0} {clrb 1} {s_en 0}
cap d with {clk 0} {s_en 0}
cap clrb with  {s_en 0}
cap s_in with {s_en 1}
cap s_en with

# measure setup/hold times
setup {d ^} to {en ^} with {clk ^v} {clrb 1} {s_in 0} {s_en 0}
setup {d v} to {en v} with {clk ^v} {clrb 1} {s_in 0} {s_en 0}
setup {s_in ^} to {s_out ^} with {clk ^v} {d 0} {s_en 1} {clrb 1}
setup {s_in v} to {s_out v} with {clk ^v} {d 0} {s_en 1} {clrb 1}
setup {s_en ^} to {s_out ^} with {clk ^v} {d 0} {s_in 1} {clrb 1}
setup {s_en v} to {s_out v} with {clk ^v} {d 0} {s_in 1} {clrb 1}

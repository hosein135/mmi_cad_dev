comment Scan Flip Flop with asynchronous clear

set clear clrb

function q = IQ
# Special synopsys header for a flip-flop
header
	ff (IQ,IQN){
		clocked_on : "clk";
		next_state : "d";
		clear : "!clrb";
	}
end
# Special verilog code, too complicated to auto-generate
verilog
	reg	q;

	always @(posedge clk or negedge clrb)
		if (clrb == 0)
			q <= #1 1'b0;
		else
			q <= #1 d;
end

step {clk ^v} {d 1} {clrb 1} {s_in 0} {s_en 0}
measure {q v} with {d 0} {clk ^v} 
measure {q ^} with {d 1} {clk ^v} 
measure {q v} with {clrb v}

# measure the input capacitance of when when clk is low
cap clk with {d 0} {clrb 1} {s_en 0}
cap d with {clk 0}
cap clrb with 
cap s_in with {s_en 1}
cap s_en with

# measure setup/hold times
setup {d ^} to {q ^} with {clk ^v} {clrb 1} {s_in 0} {s_en 0}
setup {d v} to {q v} with {clk ^v} {clrb 1} {s_in 0} {s_en 0}
setup {s_in ^} to {q ^} with {clk ^v}  {d 0} {s_en 1} {clrb 1}
setup {s_in v} to {q v} with {clk ^v}  {d 0} {s_en 1} {clrb 1}
setup {s_en ^} to {q ^} with {clk ^v}  {d 0} {s_in 1} {clrb 1}
setup {s_en v} to {q v} with {clk ^v}  {d 0} {s_in 1} {clrb 1}
hold {d ^} to {q v} with {clk ^v} {clrb 1} {s_in 0} {s_en 0}
hold {d v} to {q ^} with {clk ^v} {clrb 1} {s_in 0} {s_en 0}
hold {s_in ^} to {q v} with {clk ^v} {d 0} {s_en 1} {clrb 1}
hold {s_in v} to {q ^} with {clk ^v} {d 0} {s_en 1} {clrb 1}
hold {s_en ^} to {q v} with {clk ^v} {d 0} {s_in 1} {clrb 1}
hold {s_en v} to {q ^} with {clk ^v} {d 0} {s_in 1} {clrb 1}


# Created using mapper from:
#"MMI_NAND2 {A {MMI_NAND2A {in0 in0} {in1 in1} {out out}} {MMI_NAND2A_ {in0 in0} {in1 in1} {out out}}} {B {MMI_NAND2B {in0 in0} {in1 in1} {out out}} {MMI_NAND2B_ {in0 in0} {in1 in1} {out out}}} {C {MMI_NAND2C {in0 in0} {in1 in1} {out out}} {MMI_NAND2C_ {in0 in0} {in1 in1} {out out}}} {D {MMI_NAND2D {in0 in0} {in1 in1} {out out}} {MMI_NAND2D_ {in0 in0} {in1 in1} {out out}}} "

proc SCHEMATIC_MMI_NAND2 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    A {
      if {!$DeMorgan} {

  make global -orient RY -name vdd -origin {0 -140}
  make input -name in0 -origin {-100 0}
  make global -orient RY -name vdd -origin {160 -140}
  make input -name in1 -origin {-100 100}
  make global -name gnd -origin {0 140}
  make output -name out -origin {320 -50}
  make nmos -W .92 -origin {0 100}
  make nmos -W .92 -origin {0 0}
  make pmos -W .92 -origin {160 -100}
  make pmos -W .92 -origin {0 -100}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 12/02/99 -origin {100 280}
  make_wire 0 -60 0 -50
  make_wire 0 -40 0 -50
  make_wire -60 -100 -60 0
  make_wire 0 -50 160 -50
  make_wire -100 0 -60 0
  make_wire 160 -60 160 -50
  make_wire -60 100 100 100
  make_wire 0 40 0 60
  make_wire 100 -100 100 100
  make_wire 160 -50 320 -50
  make_wire -100 100 -60 100
  make_text -origin {-140 -230} -text {2 Input NAND}
  make_text -origin {-140 -210} -text {A Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_NAND2 MMI_NAND2A -Size A -DeMorgan 0
        make MMI_NAND2A -origin "$urx $ury"
      } else {
        generate MMI_NAND2 MMI_NAND2A -Size A -DeMorgan 0
        make MMI_NAND2A -origin {0 0}
        set terms [api_terminal_data MMI_NAND2A]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_NAND2A"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_NAND2 MMI_NAND2A_ -Size A -DeMorgan 1
        make MMI_NAND2A_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    B {
      if {!$DeMorgan} {

  make global -orient RY -name vdd -origin {0 -140}
  make input -name in0 -origin {-100 0}
  make global -orient RY -name vdd -origin {160 -140}
  make input -name in1 -origin {-100 100}
  make global -name gnd -origin {0 140}
  make output -name out -origin {320 -50}
  make nmos -W 1.84 -origin {0 100}
  make nmos -W 1.84 -origin {0 0}
  make pmos -W 1.84 -origin {160 -100}
  make pmos -W 1.84 -origin {0 -100}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {20 320}
  make_wire 0 -60 0 -50
  make_wire 0 -40 0 -50
  make_wire -60 -100 -60 0
  make_wire 0 -50 160 -50
  make_wire -100 0 -60 0
  make_wire 160 -60 160 -50
  make_wire -60 100 100 100
  make_wire 0 40 0 60
  make_wire 100 -100 100 100
  make_wire 160 -50 320 -50
  make_wire -100 100 -60 100
  make_text -origin {-140 -220} -text {2 Input NAND}
  make_text -origin {-140 -200} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_NAND2 MMI_NAND2B -Size B -DeMorgan 0
        make MMI_NAND2B -origin "$urx $ury"
      } else {
        generate MMI_NAND2 MMI_NAND2B -Size B -DeMorgan 0
        make MMI_NAND2B -origin {0 0}
        set terms [api_terminal_data MMI_NAND2B]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_NAND2B"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_NAND2 MMI_NAND2B_ -Size B -DeMorgan 1
        make MMI_NAND2B_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    C {
      if {!$DeMorgan} {

  make global -orient RY -name vdd -origin {0 -140}
  make input -name in0 -origin {-100 0}
  make global -orient RY -name vdd -origin {250 -140}
  make input -name in1 -origin {-100 100}
  make global -name gnd -origin {0 140}
  make output -name out -origin {320 -50}
  make global -name gnd -origin {110 140}
  make nmos -W 1.84 -origin {0 0}
  make nmos -W 1.84 -origin {110 0}
  make nmos -W 1.84 -origin {110 100}
  make nmos -W 1.84 -origin {0 100}
  make pmos -W 3.68 -origin {0 -100}
  make pmos -W 3.68 -origin {250 -100}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {50 340}
  make_wire 0 -60 0 -50
  make_wire 0 -40 0 -50
  make_wire -60 -100 -60 0
  make_wire -100 0 -60 0
  make_wire 250 -60 250 -50
  make_wire 0 40 0 60
  make_wire 190 -100 190 100
  make_wire -100 100 -60 100
  make_wire 250 -50 320 -50
  make_wire 110 -40 110 -50
  make_wire 110 40 110 60
  make_wire 50 100 -60 100
  make_wire 50 100 190 100
  make_wire 110 -50 0 -50
  make_wire 110 -50 250 -50
  make_wire 50 0 -60 0
  make_text -origin {-140 -230} -text {2 Input NAND}
  make_text -origin {-140 -210} -text {C Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_NAND2 MMI_NAND2C -Size C -DeMorgan 0
        make MMI_NAND2C -origin "$urx $ury"
      } else {
        generate MMI_NAND2 MMI_NAND2C -Size C -DeMorgan 0
        make MMI_NAND2C -origin {0 0}
        set terms [api_terminal_data MMI_NAND2C]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_NAND2C"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_NAND2 MMI_NAND2C_ -Size C -DeMorgan 1
        make MMI_NAND2C_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    D {
      if {!$DeMorgan} {

  make global -orient RY -name vdd -origin {0 -140}
  make input -name in0 -origin {-100 0}
  make global -orient RY -name vdd -origin {390 -140}
  make input -name in1 -origin {-100 100}
  make global -name gnd -origin {0 140}
  make output -name out -origin {460 -50}
  make global -name gnd -origin {110 140}
  make global -orient RY -name vdd -origin {80 -140}
  make global -orient RY -name vdd -origin {450 -140}
  make global -name gnd -origin {200 140}
  make global -name gnd -origin {290 140}
  make pmos -W 3.68 -origin {0 -100}
  make pmos -W 3.68 -origin {80 -100}
  make pmos -W 3.68 -origin {390 -100}
  make pmos -W 3.68 -origin {450 -100}
  make nmos -W 1.84 -origin {0 0}
  make nmos -W 1.84 -origin {110 0}
  make nmos -W 1.84 -origin {0 100}
  make nmos -W 1.84 -origin {110 100}
  make nmos -W 1.84 -origin {200 0}
  make nmos -W 1.84 -origin {290 0}
  make nmos -W 1.84 -origin {200 100}
  make nmos -W 1.84 -origin {290 100}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {120 380}
  make_wire 0 -60 0 -50
  make_wire 0 -40 0 -50
  make_wire -60 -100 -60 0
  make_wire -100 0 -60 0
  make_wire 390 -60 390 -50
  make_wire 0 40 0 60
  make_wire 330 -100 330 100
  make_wire -100 100 -60 100
  make_wire 110 -40 110 -50
  make_wire 110 40 110 60
  make_wire 80 -50 0 -50
  make_wire -60 -100 20 -100
  make_wire 450 -50 460 -50
  make_wire 450 -60 450 -50
  make_wire 330 -100 390 -100
  make_wire -60 100 50 100
  make_wire 110 -50 80 -50
  make_wire 80 -60 80 -50
  make_wire 200 -40 200 -50
  make_wire 200 40 200 60
  make_wire 290 -40 290 -50
  make_wire 290 40 290 60
  make_wire 230 100 330 100
  make_wire 390 -50 450 -50
  make_wire -60 0 50 0
  make_wire 290 -50 390 -50
  make_wire 140 100 50 100
  make_wire 140 100 230 100
  make_wire 140 0 50 0
  make_wire 140 0 230 0
  make_wire 200 -50 110 -50
  make_wire 200 -50 290 -50
  make_text -origin {-140 -230} -text {2 Input NAND}
  make_text -origin {-140 -210} -text {D Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_NAND2 MMI_NAND2D -Size D -DeMorgan 0
        make MMI_NAND2D -origin "$urx $ury"
      } else {
        generate MMI_NAND2 MMI_NAND2D -Size D -DeMorgan 0
        make MMI_NAND2D -origin {0 0}
        set terms [api_terminal_data MMI_NAND2D]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_NAND2D"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_NAND2 MMI_NAND2D_ -Size D -DeMorgan 1
        make MMI_NAND2D_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

  }
}


proc NAME_MMI_NAND2 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set nom MMI_NAND2[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_NAND2 args {
  icon_generator $args {{Size "A" {radio A B C D}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "A") && ($size != "B") && ($size != "C") && ($size != "D")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_NAND2 icon body
  if {$DeMorgan} {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_line 40 0 60 0
    icon_arc -60 10 -40 30 -start 0 -extent 359
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line -40 -20 -60 -20
    icon_line -40 20 -60 20
    icon_arc 40 -10 60 10 -start 0 -extent 359
  }

  # properties
  icon_property -origin {-37 -22} -size small -label F
  icon_property -origin {0 0} -size large -anchor center -label $size

  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1

  # outputs
  icon_term -type output -origin {60 0} -name out



  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_NAND2 -Size $Size]
  set nname [NAME_MMI_NAND2 -Size $Size -DeMorgan $DeMorgan]
  if {!$DeMorgan} {
  switch $size {
    A {
    set pnames ".in0(\$in0), .in1(\$in1), .out(\$out)"
    }
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .out(\$out)"
    }
    C {
    set pnames ".in0(\$in0), .in1(\$in1), .out(\$out)"
    }
    D {
    set pnames ".in0(\$in0), .in1(\$in1), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

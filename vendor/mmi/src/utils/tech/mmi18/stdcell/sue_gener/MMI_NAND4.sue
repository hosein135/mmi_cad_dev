# Created using mapper from:
#"MMI_NAND4 {A {MMI_NAND4A {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_NAND4A_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} {B {MMI_NAND4B {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_NAND4B_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} {C {MMI_NAND4C {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}} {MMI_NAND4C_ {in0 in0} {in1 in1} {in2 in2} {in3 in3} {out out}}} "

proc SCHEMATIC_MMI_NAND4 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    A {
      if {!$DeMorgan} {

  make global -orient RY -name vdd -origin {-90 -140}
  make input -name in0 -origin {-190 0}
  make global -orient RY -name vdd -origin {70 -140}
  make input -name in1 -origin {-190 100}
  make global -orient RY -name vdd -origin {230 -140}
  make input -name in2 -origin {-190 200}
  make global -orient RY -name vdd -origin {390 -140}
  make input -name in3 -origin {-190 300}
  make global -name gnd -origin {-90 340}
  make output -name out -origin {440 -50}
  make pmos -W .92 -origin {-90 -100}
  make pmos -W .92 -origin {70 -100}
  make pmos -W .92 -origin {230 -100}
  make pmos -W .92 -origin {390 -100}
  make nmos -W 1.84 -origin {-90 0}
  make nmos -W 1.84 -origin {-90 100}
  make nmos -W 1.84 -origin {-90 200}
  make nmos -W 1.84 -origin {-90 300}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.2 -date 12/02/99 -origin {30 550}
  make_wire -90 -60 -90 -50
  make_wire -90 -40 -90 -50
  make_wire -150 -100 -150 0
  make_wire -190 0 -150 0
  make_wire 70 -60 70 -50
  make_wire -90 40 -90 60
  make_wire 230 -60 230 -50
  make_wire -90 140 -90 160
  make_wire 390 -60 390 -50
  make_wire -90 240 -90 260
  make_wire 170 -100 170 200
  make_wire 330 -100 330 300
  make_wire 10 -100 10 100
  make_wire 230 -50 390 -50
  make_wire 390 -50 440 -50
  make_wire -190 200 -150 200
  make_wire -150 200 170 200
  make_wire -190 300 -150 300
  make_wire -150 300 330 300
  make_wire -190 100 -150 100
  make_wire -150 100 10 100
  make_wire -90 -50 70 -50
  make_wire 230 -50 70 -50
  make_text -origin {-250 -240} -text {4 Input NAND}
  make_text -origin {-250 -220} -text {A Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_NAND4 MMI_NAND4A -Size A -DeMorgan 0
        make MMI_NAND4A -origin "$urx $ury"
      } else {
        generate MMI_NAND4 MMI_NAND4A -Size A -DeMorgan 0
        make MMI_NAND4A -origin {0 0}
        set terms [api_terminal_data MMI_NAND4A]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_NAND4A"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {in2} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in2} -orient $orient
        } else {
          make $type -origin $origin -name {in2}
        }
        set data [get_assoc {in3} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in3} -orient $orient
        } else {
          make $type -origin $origin -name {in3}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_NAND4 MMI_NAND4A_ -Size A -DeMorgan 1
        make MMI_NAND4A_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    B {
      if {!$DeMorgan} {

  make global -orient RY -name vdd -origin {-90 -140}
  make input -name in0 -origin {-190 0}
  make global -orient RY -name vdd -origin {160 -140}
  make input -name in1 -origin {-190 100}
  make global -orient RY -name vdd -origin {320 -140}
  make input -name in2 -origin {-190 200}
  make global -orient RY -name vdd -origin {480 -140}
  make input -name in3 -origin {-190 300}
  make global -name gnd -origin {-90 340}
  make output -name out -origin {530 -50}
  make pmos -W 1.84 -origin {-90 -100}
  make pmos -W 1.84 -origin {160 -100}
  make pmos -W 1.84 -origin {320 -100}
  make pmos -W 1.84 -origin {480 -100}
  make nmos -W 3.68 -origin {-90 0}
  make nmos -W 3.68 -origin {-90 100}
  make nmos -W 3.68 -origin {-90 200}
  make nmos -W 3.68 -origin {-90 300}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 02/18/00 -origin {90 530}
  make_wire -90 -60 -90 -50
  make_wire -90 -40 -90 -50
  make_wire -150 -100 -150 0
  make_wire -190 0 -150 0
  make_wire 160 -60 160 -50
  make_wire -90 40 -90 60
  make_wire 320 -60 320 -50
  make_wire -90 140 -90 160
  make_wire 480 -60 480 -50
  make_wire -90 240 -90 260
  make_wire -190 200 -150 200
  make_wire 260 -100 260 200
  make_wire 160 -50 320 -50
  make_wire -190 300 -150 300
  make_wire 420 -100 420 300
  make_wire -190 100 -150 100
  make_wire 100 -100 100 100
  make_wire 320 -50 480 -50
  make_wire 480 -50 530 -50
  make_wire 420 300 -150 300
  make_wire 160 -50 -90 -50
  make_wire 260 200 -150 200
  make_wire 100 100 -150 100
  make_text -origin {-250 -240} -text {4 Input NAND}
  make_text -origin {-250 -220} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_NAND4 MMI_NAND4B -Size B -DeMorgan 0
        make MMI_NAND4B -origin "$urx $ury"
      } else {
        generate MMI_NAND4 MMI_NAND4B -Size B -DeMorgan 0
        make MMI_NAND4B -origin {0 0}
        set terms [api_terminal_data MMI_NAND4B]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_NAND4B"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {in2} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in2} -orient $orient
        } else {
          make $type -origin $origin -name {in2}
        }
        set data [get_assoc {in3} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in3} -orient $orient
        } else {
          make $type -origin $origin -name {in3}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_NAND4 MMI_NAND4B_ -Size B -DeMorgan 1
        make MMI_NAND4B_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    C {
      if {!$DeMorgan} {

  make global -orient RY -name vdd -origin {-90 -140}
  make input -name in0 -origin {-190 0}
  make global -orient RY -name vdd -origin {260 -140}
  make input -name in1 -origin {-190 100}
  make global -orient RY -name vdd -origin {420 -140}
  make input -name in2 -origin {-190 200}
  make global -orient RY -name vdd -origin {580 -140}
  make input -name in3 -origin {-190 300}
  make global -name gnd -origin {-90 340}
  make output -name out -origin {650 -50}
  make global -orient RY -name vdd -origin {10 -140}
  make global -orient RY -name vdd -origin {320 -140}
  make global -orient RY -name vdd -origin {470 -140}
  make global -orient RY -name vdd -origin {630 -140}
  make pmos -W 1.84 -origin {-90 -100}
  make pmos -W 1.84 -origin {10 -100}
  make pmos -W 1.84 -origin {260 -100}
  make pmos -W 1.84 -origin {320 -100}
  make pmos -W 1.84 -origin {420 -100}
  make pmos -W 1.84 -origin {470 -100}
  make pmos -W 1.84 -origin {580 -100}
  make pmos -W 1.84 -origin {630 -100}
  make nmos -W 7.36 -origin {-90 300}
  make nmos -W 7.36 -origin {-90 200}
  make nmos -W 7.36 -origin {-90 100}
  make nmos -W 7.36 -origin {-90 0}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.3 -date 02/18/00 -origin {210 540}
  make_wire -90 40 -90 60
  make_wire -90 140 -90 160
  make_wire -90 240 -90 260
  make_wire -150 -100 -150 0
  make_wire 260 -60 260 -50
  make_wire 420 -60 420 -50
  make_wire 580 -60 580 -50
  make_wire 320 -60 320 -50
  make_wire 470 -60 470 -50
  make_wire 630 -50 580 -50
  make_wire 630 -50 650 -50
  make_wire 630 -60 630 -50
  make_wire -90 -60 -90 -50
  make_wire -90 -50 -90 -40
  make_wire -190 0 -150 0
  make_wire -190 200 -150 200
  make_wire -190 100 -150 100
  make_wire -190 300 -150 300
  make_wire 360 -100 360 200
  make_wire 520 -100 520 300
  make_wire 200 -100 200 100
  make_wire 320 -50 420 -50
  make_wire 470 -50 420 -50
  make_wire 580 -50 470 -50
  make_wire 200 -100 260 -100
  make_wire 260 -50 320 -50
  make_wire 520 -100 570 -100
  make_wire 360 -100 410 -100
  make_wire -150 300 520 300
  make_wire -150 200 360 200
  make_wire -150 100 200 100
  make_wire 10 -60 10 -50
  make_wire 10 -50 260 -50
  make_wire 10 -50 -90 -50
  make_wire -150 -100 -50 -100
  make_text -origin {-250 -240} -text {4 Input NAND}
  make_text -origin {-250 -220} -text {C Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_NAND4 MMI_NAND4C -Size C -DeMorgan 0
        make MMI_NAND4C -origin "$urx $ury"
      } else {
        generate MMI_NAND4 MMI_NAND4C -Size C -DeMorgan 0
        make MMI_NAND4C -origin {0 0}
        set terms [api_terminal_data MMI_NAND4C]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_NAND4C"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {in2} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in2} -orient $orient
        } else {
          make $type -origin $origin -name {in2}
        }
        set data [get_assoc {in3} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in3} -orient $orient
        } else {
          make $type -origin $origin -name {in3}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_NAND4 MMI_NAND4C_ -Size C -DeMorgan 1
        make MMI_NAND4C_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

  }
}


proc NAME_MMI_NAND4 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set nom MMI_NAND4[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_NAND4 args {
  icon_generator $args {{Size "A" {radio A B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "A") && ($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_NAND4 icon body
  if {$DeMorgan} {
    icon_arc -60 -30 50 110 -start 35 -extent 50
    icon_arc -60 -110 50 30 -start 275 -extent 50
    icon_arc -58 -30 -38 30 -start 270 -extent 180
    icon_line -48 -30 0 -30
    icon_line -48 30 0 30
    icon_line 40 0 60 0
    icon_arc -60 20 -40 40 -start 0 -extent 359
    icon_arc -60 0 -40 20 -start 0 -extent 359
    icon_arc -60 -20 -40 0 -start 0 -extent 359
    icon_arc -60 -40 -40 -20 -start 0 -extent 359
  } else {
    icon_arc -30 -30 40 30 -start 277 -extent 166
    icon_line 10 -30 -40 -30 -40 30 10 30
    icon_line -40 -30 -60 -30
    icon_line -40 -10 -60 -10
    icon_line -40 10 -60 10
    icon_line -40 30 -60 30
    icon_arc 40 -10 60 10 -start 0 -extent 359
  }

  # properties
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-37 -22} -size small -label F

  # inputs
  icon_term -type input -origin {-60 -30} -name in0
  icon_term -type input -origin {-60 -10} -name in1
  icon_term -type input -origin {-60 10} -name in2
  icon_term -type input -origin {-60 30} -name in3

  # outputs
  icon_term -type output -origin {60 0} -name out


  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_NAND4 -Size $Size]
  set nname [NAME_MMI_NAND4 -Size $Size -DeMorgan $DeMorgan]
  if {!$DeMorgan} {
  switch $size {
    A {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .in3(\$in3), .out(\$out)"
    }
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .in3(\$in3), .out(\$out)"
    }
    C {
    set pnames ".in0(\$in0), .in1(\$in1), .in2(\$in2), .in3(\$in3), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

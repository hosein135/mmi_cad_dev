# Created using mapper from:
#"MMI_42AD {D {MMI_42ADD {In1_H In1_H} {In2_H In2_H} {In3_H In3_H} {In4_H In4_H} {Cin_L Cin_L} {Sum_H Sum_H} {Carry_H Carry_H} {Cout_L Cout_L}}} "

proc SCHEMATIC_MMI_42AD args {
  call_use_keyword $args {{Size "D"}}

  set size [string toupper $Size]

  switch $size {
    D {

  make input -orient R90 -name In1_H -origin {520 -150}

# Created using mapper from:
#"MMI_XNOR2 {A {MMI_XNOR2A {in0 in0} {in1 in1} {out out}} {MMI_XNOR2A_ {in0 in0} {in1 in1} {out out}}} {B {MMI_XNOR2B {in0 in0} {in1 in1} {out out}} {MMI_XNOR2B_ {in0 in0} {in1 in1} {out out}}} {C {MMI_XNOR2C {in0 in0} {in1 in1} {out out}} {MMI_XNOR2C_ {in0 in0} {in1 in1} {out out}}} "

proc SCHEMATIC_MMI_XNOR2 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set size [string toupper $Size]

  switch $size {
    A {
      if {!$DeMorgan} {

  make output -name out -origin {750 430}
  make input -name in1 -origin {240 370}
  make input -name in0 -origin {240 330}
  make MMI_NAND2A -origin {390 350}
  make MMI_OAI21A -origin {620 430}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 12/09/99 -origin {380 760}
  make_wire 720 430 750 430
  make_wire 450 350 520 350
  make_wire 520 350 520 400
  make_wire 300 370 300 430
  make_wire 300 430 520 430
  make_wire 300 370 240 370
  make_wire 300 370 330 370
  make_wire 270 330 270 470
  make_wire 270 470 520 470
  make_wire 270 330 240 330
  make_wire 270 330 330 330
  make_text -origin {20 120} -text {Exclusive NOR}
  make_text -origin {20 140} -text {A Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_XNOR2 MMI_XNOR2A -Size A -DeMorgan 0
        make MMI_XNOR2A -origin "$urx $ury"
      } else {
        generate MMI_XNOR2 MMI_XNOR2A -Size A -DeMorgan 0
        make MMI_XNOR2A -origin {0 0}
        set terms [api_terminal_data MMI_XNOR2A]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_XNOR2A"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_XNOR2 MMI_XNOR2A_ -Size A -DeMorgan 1
        make MMI_XNOR2A_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    B {
      if {!$DeMorgan} {

  make output -name out -origin {710 440}
  make input -name in1 -origin {200 380}
  make input -name in0 -origin {200 340}
  make MMI_NAND2A -origin {350 360}
  make MMI_OAI21B -origin {580 440}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 12/06/99 -origin {330 740}
  make_wire 680 440 710 440
  make_wire 410 360 480 360
  make_wire 480 360 480 410
  make_wire 260 380 260 440
  make_wire 260 440 480 440
  make_wire 260 380 200 380
  make_wire 260 380 290 380
  make_wire 230 340 230 480
  make_wire 230 480 480 480
  make_wire 230 340 200 340
  make_wire 230 340 290 340
  make_text -origin {-10 110} -text {Exclusive NOR}
  make_text -origin {-10 130} -text {B Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_XNOR2 MMI_XNOR2B -Size B -DeMorgan 0
        make MMI_XNOR2B -origin "$urx $ury"
      } else {
        generate MMI_XNOR2 MMI_XNOR2B -Size B -DeMorgan 0
        make MMI_XNOR2B -origin {0 0}
        set terms [api_terminal_data MMI_XNOR2B]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_XNOR2B"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_XNOR2 MMI_XNOR2B_ -Size B -DeMorgan 1
        make MMI_XNOR2B_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

    C {
      if {!$DeMorgan} {

  make output -name out -origin {730 440}
  make input -name in1 -origin {220 380}
  make input -name in0 -origin {220 340}
  make MMI_NAND2B -origin {370 360}
  make MMI_OAI21C -origin {600 440}
  generate title_bar sccs_title_bar -cell sccs_title_bar
  make sccs_title_bar -owner MMI -version 1.4 -date 12/06/99 -origin {340 750}
  make_wire 700 440 730 440
  make_wire 430 360 500 360
  make_wire 500 360 500 410
  make_wire 280 380 280 440
  make_wire 280 440 500 440
  make_wire 280 380 220 380
  make_wire 280 380 310 380
  make_wire 250 340 250 480
  make_wire 250 480 500 480
  make_wire 250 340 220 340
  make_wire 250 340 310 340
  make_text -origin {0 100} -text {Exclusive NOR}
  make_text -origin {0 120} -text {C Size}

        set bbx [api_bbox]
        set urx [lindex $bbx 2]
        set ury [lindex $bbx 1]
        generate MMI_XNOR2 MMI_XNOR2C -Size C -DeMorgan 0
        make MMI_XNOR2C -origin "$urx $ury"
      } else {
        generate MMI_XNOR2 MMI_XNOR2C -Size C -DeMorgan 0
        make MMI_XNOR2C -origin {0 0}
        set terms [api_terminal_data MMI_XNOR2C]
        if {$terms == ""} {
          error "ERROR: No pin info found for icon MMI_XNOR2C"
        }
        set data [get_assoc {in0} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in0} -orient $orient
        } else {
          make $type -origin $origin -name {in0}
        }
        set data [get_assoc {in1} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {in1} -orient $orient
        } else {
          make $type -origin $origin -name {in1}
        }
        set data [get_assoc {out} $terms]
        set type [get_assoc type $data]
        set origin [get_assoc origin $data]
        set orient [get_assoc orient $data]
        if {$orient != ""} {
          make $type -origin $origin -name {out} -orient $orient
        } else {
          make $type -origin $origin -name {out}
        }
        generate MMI_XNOR2 MMI_XNOR2C_ -Size C -DeMorgan 1
        make MMI_XNOR2C_ -origin {300 200}
  make sccs_title_bar -origin {0 400} -owner MMI -version 0 -date 0
      }
    }

  }
}


proc NAME_MMI_XNOR2 args {
  call_use_keyword $args {{Size "A"} {DeMorgan 0}}

  set nom MMI_XNOR2[string toupper $Size]

  if {$DeMorgan} {
    set nom ${nom}_
  }

  return $nom
}


proc ICON_MMI_XNOR2 args {
  icon_generator $args {{Size "A" {radio A B C}}  {DeMorgan 0 binary}}

  set size [string toupper $Size]

  # check for acceptable response on Size
  if {($size != "A") && ($size != "B") && ($size != "C")} {
    error "ERROR: Size ($size) not supported"
  }

  # check for acceptable response on DeMorgan
  if {($DeMorgan != 0) && ($DeMorgan != 1)} {
    error "ERROR: DeMorgan property ($DeMorgan) must be 0 or 1"
  }

  icon_setup $args {{origin {0 0}} {orient R0} {name {}} {M {}} {dpc {}}}


  # MMI_XNOR2 icon body
  icon_arc -60 -30 50 110 -start 35 -extent 50
  icon_arc -48 -30 -28 30 -start 270 -extent 180
  icon_line -38 -30 0 -30
  icon_line -38 30 0 30
  icon_arc -60 -110 50 30 -start 275 -extent 50
  icon_arc -58 -30 -38 30 -start 270 -extent 180
  icon_property -origin {0 0} -size large -anchor center -label $size
  icon_property -origin {-27 -20} -size small -label F

  if {$DeMorgan} {
    icon_line 40 0 60 0
    icon_line -60 20 -40 20
    icon_arc -60 -30 -40 -10 -start 0 -extent 359
  } else {
    icon_arc 40 -10 60 10 -start 0 -extent 359
    icon_line -60 20 -40 20
    icon_line -60 -20 -40 -20
  }

  # inputs
  icon_term -type input -origin {-60 -20} -name in0
  icon_term -type input -origin {-60 20} -name in1

  # outputs
  icon_term -type output -origin {60 0} -name out




  # properties
  icon_property -origin {-40 280} -type user -name name
  icon_property -origin {-40 300} -type user -name M
  icon_property -origin {-40 320} -type user -name dpc

  # verilog property
  set fname [NAME_MMI_XNOR2 -Size $Size]
  set nname [NAME_MMI_XNOR2 -Size $Size -DeMorgan $DeMorgan]
  if {!$DeMorgan} {
  switch $size {
    A {
    set pnames ".in0(\$in0), .in1(\$in1), .out(\$out)"
    }
    B {
    set pnames ".in0(\$in0), .in1(\$in1), .out(\$out)"
    }
    C {
    set pnames ".in0(\$in0), .in1(\$in1), .out(\$out)"
    }
  }

  set vprop "$fname \[unique_name \"\" \$name $nname\] ($pnames)\\;"
  icon_property -origin {-40 360} -type fixed -name verilog -text $vprop
  }

}

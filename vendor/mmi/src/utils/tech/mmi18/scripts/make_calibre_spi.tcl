#!/bin/csh -f

# The next line will be skipped in TCL because of the backslash \
mmi_wish -f $0 $* ; exit

# Script to turn a hierarchical spice, w/header netlist (generated by sue)
# into the format that calibre lvs wants.
#
# 3.  Remove comments on * .SUBCKT, * .ENDS
# 4.  Remove ad=*, pd=*, as=*, ps=*
# 5.  Remove capacitors if any
#### 6.  Replace 'gnd' with 'GND'
#### 7.  Replace 'vdd' with 'VDD'


proc make_calibre_spi {{file ""}} {

  if {$file == ""} {
    puts stderr "\nUsage:"
    puts stderr "  make_calibre_spi <spice_filename> > <new_spice_filename>\n"
    exit
  }

  puts stderr "Munging $file ..."

  # open the file
  if {[catch "open $file r" FILE_ID]} {
    # problem
    puts stderr "Aborting, error while reading file \"$file\": $FILE_ID"
    exit
  }

  # NOTE: don't need to worry about continuation lines

  while {[gets $FILE_ID line] >= 0} {

    if {[string toupper [string index $line 0]] == "C"} {
      # toss caps
      continue
    }

    # remove ad, pd, as, ps stuff
    regsub {ad=[^ ]+} $line "" line
    regsub {pd=[^ ]+} $line "" line
    regsub {as=[^ ]+} $line "" line
    regsub {ps=[^ ]+} $line "" line

    if {[string trim $line] == "+"} {
      # remove unneeded
      continue
    }

    # remove comments
    regsub {^\* .SUBCKT} $line .SUBCKT line
    regsub {^\*.SUBCKT} $line .SUBCKT line
    regsub {^\* .ENDS} $line .ENDS line
    regsub {^\*.ENDS} $line .ENDS line

    # convert gnd to GND, vdd to VDD
#    regsub -all { gnd } $line { GND } line
#    regsub -all { vdd } $line { VDD } line

    # write it
    puts $line
  }

  # done
  close $FILE_ID

  puts stderr "done"
}


# do it

eval make_calibre_spi $argv

exit


.LIB MOS
***************************************************************
*                                                             *
*               1.8V NMOS DEVICES MODEL                       *
*                                                             *
***************************************************************
*
*
.MODEL  n.1 NMOS (       LEVEL    = 49             
+NLEV     = 3              AF       = 0.8265         KF       = 8.10E-24       
+CALCACM  = 1              SFVTFLAG = 0              VFBFLAG  = 1  
+VERSION  = 3.1            LMIN     = '1.2E-06-dxl'  LMAX     = 2.1E-05   
+WMIN     = '1.005E-05-dxw' WMAX    = 0.000101       XL       = '-2E-8+dxl'    
+XW       = '0+dxw'        TNOM     = 25             TOX      = toxn           
+XJ       = 1.6E-07        NCH      = 2.2205E+17     LLN      = 1              
+LWN      = 1              WLN      = 1              WWN      = 1              
+LINT     = 1.2E-08        WINT     = 1.28E-08       MOBMOD   = 1              
+BINUNIT  = 2              DWG      = 0              DWB      = 0              
+VTH0     = 'dvthn+0.4711666' LVTH0 = 2.868195E-08   WVTH0    = -1.401452E-07  
+PVTH0    = 1.529926E-13   K1       = 0.4948         K2       = 0.0226958      
+LK2      = 4.144976E-11   K3       = 0              DVT0     = 0              
+DVT1     = 0              DVT2     = 0              DVT0W    = 0              
+DVT1W    = 0              DVT2W    = 0              NLX      = 0              
+W0       = 0              K3B      = 0              VSAT     = 101255.4       
+LVSAT    = 0.007412993    WVSAT    = 0.007463923    PVSAT    = -7.431081E-08  
+UA       = -5.7392E-10    LUA      = 1.684519E-16   UB       = 1.717466E-18   
+LUB      = -1.87125E-25   WUB      = -6.86186E-27   PUB      = -1.79512E-30   
+UC       = 6.428935E-11   LUC      = 2.798281E-17   WUC      = 2.606813E-17   
+PUC      = -2.59534E-22   RDSW     = 209.99998      PRWB     = 0              
+PRWG     = 0              WR       = 1              U0       = 0.0351436      
+LU0      = -1.416888E-09  WU0      = 8.213916E-10   PU0      = 2.91415E-15    
+A0       = 0.6950982      LA0      = 8.600854E-08   KETA     = 0.0101545      
+LKETA    = -9.702174E-09  WKETA    = -8.53815E-10   PKETA    = 8.500572E-15   
+A1       = 0              A2       = 0.99           AGS      = 0              
+B0       = 0              B1       = 0              VOFF     = -0.1414        
+NFACTOR  = 2.108815       CIT      = 0.0001790491   CDSC     = 0              
+CDSCB    = 0              CDSCD    = 0              ETA0     = 0.00016        
+ETAB     = -3.4846E-05    LETAB    = 4.028197E-11   DSUB     = 0              
+PCLM     = 0.2392907      LPCLM    = 4.252146E-07   WPCLM    = -8.885609E-08  
+PPCLM    = 8.846502E-13   PDIBLC1  = 0              PDIBLC2  = 0.0002297747   
+LPDIBLC2 = 3.7457E-09     PDIBLCB  = 0.1624892      DROUT    = 0              
+PSCBE1   = 6.91E+08       PSCBE2   = 1E-20          PVAG     = 0              
+DELTA    = 0.01           ALPHA0   = 3.49E-08       BETA0    = 10.5909        

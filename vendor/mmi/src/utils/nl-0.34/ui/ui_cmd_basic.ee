#(defcommand get_cell_or_port_pins
   ("Return the pins of the specified cell or port.  By default, all pins are"
    "returned.  This behavior can be modified with any combination of the"
    "switches.")
   (-inputs boolean "get only input pins")
   (-outputs boolean "get only output pins")
   (-inouts boolean "get only inout pins")
   (cell_or_port cell_port_icell_or_iport "get the pins of this cell or port"))
{
  nl_kind kind = nl_object_kind (cell_or_port);

  if ( !inputs && !outputs && !inouts ) {
    inputs = 1;
    outputs = 1;
    inouts = 1;
  }
  
  if ( kind == nl_kind_port || kind == nl_kind_iport ) {
    nl_port port;
    nl_idesign idesign = NULL;
    nl_direction direction;
    nl_pin result = NULL;

    if ( kind == nl_kind_port ) {
      port = (nl_port) cell_or_port;
    }
    else {
      nl_iport iport = (nl_iport) cell_or_port;
      port = nl_iport_port (iport);
      idesign = nl_iport_idesign (iport);
    }

    direction = nl_port_direction (port);

    switch (direction) {
    case nl_direction_in:
      if ( outputs )
	result = nl_port_pin (port);
      break;
    case nl_direction_out:
      if ( inputs )
	result = nl_port_pin (port);
      break;
    case nl_direction_inout:
    case nl_direction_unknown:
      if ( inouts )
	result = nl_port_pin (port);
      break;
    default:
      ASSERT (0);
    }

    if ( kind == nl_kind_port ) {
      ui_cmd_object_result (interp, (nl_object) result, NULL);
    }
    else {
      nl_ipin ipin = nl_idesign_get_ipin (idesign, result);
      ui_cmd_object_result (interp, (nl_object) ipin, NULL);
    }
  }
  else {
    nl_cell cell;
    nl_idesign idesign;

    if ( kind == nl_kind_cell ) {
      cell = (nl_cell) cell_or_port;
      idesign = NULL;
    }
    else {
      nl_icell icell = (nl_icell) cell_or_port;
      cell = nl_icell_cell (icell);
      idesign = nl_icell_idesign (icell);
    }
    
    if ( inputs ) {
      nl_cell_for_all_inputs (cell, pin) {
	if ( kind == nl_kind_cell ) {
	  ui_cmd_append_result_walker ((nl_object) pin, interp);
	}
	else {
	  nl_ipin ipin = nl_idesign_get_ipin (idesign, pin);
	  ui_cmd_append_result_walker ((nl_object) ipin, interp);
	}
      } nl_end_for;
    }

    if ( outputs ) {
      nl_cell_for_all_outputs (cell, pin) {
	if ( kind == nl_kind_cell ) {
	  ui_cmd_append_result_walker ((nl_object) pin, interp);
	}
	else {
	  nl_ipin ipin = nl_idesign_get_ipin (idesign, pin);
	  ui_cmd_append_result_walker ((nl_object) ipin, interp);
	}
      } nl_end_for;
    }

    if ( inouts ) {
      nl_cell_for_all_inouts (cell, pin) {
	if ( kind == nl_kind_cell ) {
	  ui_cmd_append_result_walker ((nl_object) pin, interp);
	}
	else {
	  nl_ipin ipin = nl_idesign_get_ipin (idesign, pin);
	  ui_cmd_append_result_walker ((nl_object) ipin, interp);
	}
      } nl_end_for;
    }
  }

  return TCL_OK;
}


#(defcommand get_reference_cells
   "Return a list of all cells (instances) of a given reference."
   (reference reference "return the cells of this reference"))
{
  Tcl_Obj *result = Tcl_NewListObj (0, NULL);

  nl_reference_for_all_instances (reference, cell) {
    ui_cmd_append_object_list (interp, result, (nl_object) cell,
			       reference_path);
  } nl_end_for;

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}


#(defcommand remove_design
   "Remove the specified designs from memory."
   (-all boolean "remove all designs")
   (-silent boolean "don't print a message when removing a design")
   &optional
   (design design "design to remove"))
{
  if ( all ) {
    nl_context_for_all_designs (context, des) {
      char *name = nl_design_name (des);
      if ( !silent ) {
	printf ("Removing design \"%s\"\n", name);
      }
      nl_context_remove_design (context, des);
    } nl_end_for;
  }
  else {
    char *name;

    if ( design == NULL ) {
      error ("a design must be specified unless the -all option is used.");
    }

    name = nl_design_name (design);
    if ( !silent ) {
      printf ("Removing design \"%s\"\n", name);
    }
    nl_context_remove_design (context, design);
  }

  return TCL_OK;
}


static
void
ui_cmd_free_attribute (void *ptr)
{
  Tcl_Obj *obj = *(Tcl_Obj **)ptr;

  if ( obj != NULL ) {
    Tcl_DecrRefCount (obj);
  }
}


#(defcommand remove_attribute 
  "Remove the specified attribute."
  (name string "name of the attribute to remove")
  &optional
  (design current_design "remove the attribute from this design"))
{
  nl_attr attr = nl_design_get_attr_by_name (design, name);

  if ( attr == NULL ) {
    error ("design %s does not contain an attribute named %s",
	   nl_design_name (design), name);
  }
  else {
    nl_design_remove_attr (design, attr);
  }

  return TCL_OK;
}


#(defcommand attribute_kind
   "Return the kind of object that the specified attribute applies to."
   (attr attr "get the object kind of this attribute"))
{
  nl_kind kind = nl_attr_attr_of (attr);
  char *kind_str = (char *) nl_kind_to_string (kind);
  Tcl_Obj *kind_obj = Tcl_NewStringObj (kind_str, -1);

  Tcl_SetObjResult (interp, kind_obj);

  return TCL_OK;
}


#(defcommand create_design_attribute
   "Create and return a new design attribute."
   (name string "name of the attribute to create")
   &optional
   (design current_design "create the attribute on this design"))
{
  nl_design_attr result
    = nl_design_attr_create (name, design, nl_density_sparse,
			     sizeof (Tcl_Obj *), NULL,
			     ui_cmd_free_attribute);

  Tcl_Obj *obj = ui_obj_create ((nl_object) result, NULL);

  Tcl_SetObjResult (interp, obj);

  return TCL_OK;
}


#(defcommand query_design_attribute
  "Return 1 if the specified design has the specified attribute, 0 otherwise."
  (attr_name string "name of the attribute to get")
  &optional
  (design current_design "get the attribute for this design"))
{
  Tcl_Obj *obj;
  Tcl_Obj *result;
  nl_attr attr = nl_design_get_attr_by_name (design, attr_name);

  if ( attr == NULL || nl_attr_attr_of (attr) != nl_kind_design ) {
    result = Tcl_NewIntObj (0);
  }
  else {
    nl_design_attr_get ((nl_design_attr) attr, design, &obj);

    result = Tcl_NewIntObj (obj != NULL);
  }

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}



#(defcommand get_cell_line
   ("Get the file name and line number on which the specified cell was"
    "instantiated.")
   (cell cell "get the file and line of this cell"))
{
  char *file = nl_cell_file (cell);

  if ( file != NULL ) {
    int line = nl_cell_line (cell);
    Tcl_Obj *file_obj = Tcl_NewStringObj (file, -1);
    Tcl_Obj *line_obj = Tcl_NewIntObj (line);
    Tcl_Obj *objv[2];
    Tcl_Obj *result;

    objv[0] = file_obj;
    objv[1] = line_obj;

    result = Tcl_NewListObj (2, objv);

    Tcl_SetObjResult (interp, result);
  }

  return TCL_OK;
}



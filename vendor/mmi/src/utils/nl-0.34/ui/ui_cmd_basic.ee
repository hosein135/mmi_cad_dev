#(defcommand get_cell_pin
   "Return the pin of the specified cell with the specified name."
   (cell_or_icell cell_or_icell "get the pin of this cell")
   (name string "get the pin with this name"))
{
  nl_kind kind = nl_object_kind (cell_or_icell);
  nl_cell cell;

  if ( kind == nl_kind_cell ) {
    cell = (nl_cell) cell_or_icell;
  }
  else {
    cell = nl_icell_cell ((nl_icell) cell_or_icell);
  }

  {
    nl_reference reference = nl_cell_reference (cell);
    nl_object refpin = nl_reference_get_refpin_by_name (reference, name);

    if ( refpin == NULL ) {
      error ("cell %s has no pin named %s.", nl_cell_name (cell), name);
    }
    else if ( nl_object_kind (refpin) == nl_kind_bus ) {
      error ("pin %s of cell %s is a bus.", name, nl_cell_name (cell));
    }
    else {

      if ( kind == nl_kind_cell ) {
	nl_pin pin = nl_cell_get_pin_by_refpin (cell, (nl_refpin) refpin);

	ui_cmd_object_result (interp, (nl_object) pin, cell_or_icell_path);
      }
      else {
	nl_icell icell = (nl_icell) cell_or_icell;
	nl_ipin ipin
	  = nl_icell_get_ipin_by_refpin (icell, (nl_refpin) refpin);
	
	ui_cmd_object_result (interp, (nl_object) ipin, NULL);
      }
    }

    return TCL_OK;
  }
}



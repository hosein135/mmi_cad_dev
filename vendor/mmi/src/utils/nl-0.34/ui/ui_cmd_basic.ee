#(defcommand get_bus_members
   ("Return a list of the members of the specified bus."
    "By default, the members are ordered from LSB to MSB"
    "(i.e. the 0th element is the LSB).")
   (-reverse boolean "return the members in the order MSB to LSB")
   (bus bus "get the members of this bus"))
{
  if ( reverse ) {
    nl_bus_for_all_members_reverse (bus, member) {
      ui_cmd_append_result_walker (member, interp);
    } nl_end_for;
  }
  else {
    ar members = nl_bus_members (bus);

    ui_cmd_object_list_result (interp, members, NULL);
  }

  return TCL_OK;
}



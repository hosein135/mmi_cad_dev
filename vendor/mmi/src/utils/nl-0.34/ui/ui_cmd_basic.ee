/* -*-C-*- */

#(progn
  (setq embedded-elisp-output-file
	(concat (file-name-sans-extension embedded-elisp-source-file) ".c"))
  (load (expand-file-name "ui_cmd.el") nil t)
  (warning-message))

#include "port.h"
#include "error.h"
#include "mem.h"
#include "ar.h"
#include "hashtab.h"
#include "str.h"
#include "nl.h"
#include "pnl.h"
#include "ast2g.h"
#include "hier.h"
#include "tcl.h"
#include "ui.h"
#include "ui_int.h"


#(defcommand create_design
   "Create an empty design."
   (name string "name of design to create"))
{
  nl_design design = nl_design_create (name, context);

  if ( design == NULL ) {
    error ("a design named %s could not be created.", name);
  }
  else {
    ui_cmd_object_result (interp, (nl_object) design, NULL);

    return TCL_OK;
  }
}


static char *ui_create_idesign_attr;


static
int
ui_create_idesign_predicate (nl_design design)
{
  Tcl_Obj *flag_obj = NULL;
  
  nl_design_attr_get_by_name (ui_create_idesign_attr, design, &flag_obj);

  if ( flag_obj == NULL ) {
    return 0;
  }
  else {
    int len;

    Tcl_GetStringFromObj (flag_obj, &len);

    return len != 0;
  }
}


#(defcommand create_idesign
   "Create an idesign based on the specified design."
   (-stop_attribute string "do not descend into designs that have this attribute")
   &optional
   (design current_design "top level design of the idesign"))
{
  nl_idesign idesign;
  nl_predicate pred = NULL;

  if ( stop_attribute != NULL ) {
    ui_create_idesign_attr = stop_attribute;
    pred = (nl_predicate) ui_create_idesign_predicate;
  }

  idesign = nl_idesign_create (design, NULL, pred);

  if ( idesign == NULL ) {
    error ("an idesign for %s could not be created.",
	   nl_design_name (design));
  }
  else {
    ui_cmd_object_result (interp, (nl_object) idesign, NULL);

    return TCL_OK;
  }
}


#(defcommand remove_idesigns
   "Remove all idesigns associated witht he specified design."
   &optional
   (design current_design "remove the idesigns associated with this design"))
{
  nl_design_for_all_idesigns (design, idesign) {
    nl_idesign_free_tree (idesign);
  } nl_end_for;

  return TCL_OK;
}


#(defcommand get_idesign_root
   "Return the top level of the current idesign tree."
   &optional
   (design current_design "return the root of the tree for this design"))
{
  int num_idesigns = nl_design_num_idesigns (design);

  if ( num_idesigns == 0 ) {
    error ("there are no idesigns for the specified design.");
  }

  {
    nl_idesign idesign = nl_design_first_idesign (design);
    nl_icell icell = nl_idesign_icell (idesign);
    nl_design top_design;

    while ( icell != NULL ) {
      idesign = nl_icell_idesign (icell);
      icell = nl_idesign_icell (idesign);
    }

    top_design = nl_idesign_design (idesign);

    ui_cmd_object_result (interp, (nl_object) top_design, NULL);
  }

  return TCL_OK;
}


#(defcommand create_reference
   "Create a reference in the specified design."
   (name string "name of reference to create")
   &optional
   (design current_design "design in which to create the reference"))
{
  nl_reference reference = nl_reference_create (name, design, NULL);

  if ( reference == NULL ) {
    error ("a reference named %s could not be created.", name);
  }
  else {
    ui_cmd_object_result (interp, (nl_object) reference, NULL);

    return TCL_OK;
  }
}


#(defcommand add_reference_parameter
   "Add a parameter value to the specified reference."
   (reference reference "add the parameter to this reference")
   (value integer "value of parameter to add"))
{
  nl_reference_add_parameter (reference, value);

  return TCL_OK;
}


#(defcommand create_refpin
   "Create a refpin on the specified reference."
   (name string "name of the refpin to create")
   (reference reference "reference on which to create the refpin"))
{
  nl_refpin refpin = nl_refpin_create (name, NULL, reference);

  if ( refpin == NULL ) {
    error ("a refpin named %s could not be created.", name);
  }
  else {
    ui_cmd_object_result (interp, (nl_object) refpin, NULL);

    return TCL_OK;
  }
}


#(defcommand get_reference_refpins
  "Return a list of all the refpins on the specified reference."
   (-inputs boolean "return only input pins")
   (-outputs boolean "return only output pins")
   (-inouts boolean "return only inout pins")
   (reference reference "get the refpins of this reference"))
{
  if ( !inputs && !outputs && !inouts ) {
    inputs = outputs = inouts = 1;
  }

  nl_reference_for_all_refpins (reference, refpin) {
    nl_direction direction = nl_refpin_direction (refpin);

    switch (direction) {
    case nl_direction_in:
      if ( inputs )
	ui_cmd_append_result_walker ((nl_object) refpin, interp);
      break;

    case nl_direction_out:
      if ( outputs )
	ui_cmd_append_result_walker ((nl_object) refpin, interp);
      break;

    case nl_direction_inout:
    case nl_direction_unknown:
      if ( inouts )
	ui_cmd_append_result_walker ((nl_object) refpin, interp);
      break;

    default:
      ASSERT (0);
    }
  } nl_end_for;

  return TCL_OK;
}



#(defcommand copy_reference
  "Make a copy of the specified reference in the specified design."
  (reference reference "copy this reference")
  (design design "into this design"))
{
  nl_design ref_design = nl_reference_design (reference);
  nl_reference new_ref;

  if ( ref_design == design ) {
    error ("attempt to copy a reference (%s) into its own design (%s)",
	   nl_reference_name (reference), nl_design_name (design));
  }

  new_ref = hier_copy_reference (reference, design, NULL);

  ui_cmd_object_result (interp, (nl_object) new_ref, NULL);

  return TCL_OK;
}


#(defcommand create_cell
   "Create a cell (instance) of the specified reference."
   (name string "name of the cell to create")
   (reference reference "create an instance of this reference"))
{
  nl_cell cell = nl_cell_create (name, reference);

  if ( cell == NULL ) {
    error ("a cell named %s could not be created.", name);
  }
  else {
    ui_cmd_object_result (interp, (nl_object) cell, NULL);

    return TCL_OK;
  }
}


#(defcommand create_bus
   "Create a bus with specified type and members."
   (name string "the name of the bus")
   (left integer "the left bound of the bus")
   (right integer "the right bound of the bus")
   (members tcl_object "a list of the members of the bus, in order"))
{
  int objc;
  Tcl_Obj **objv;

  Tcl_ListObjGetElements (interp, members, &objc, &objv);

  if ( objc < 1 ) {
    error ("list of members must have a length of at least one.");
  }

  {
    nl_object first = ui_obj_get_nl_object (objv[0]);
    nl_kind member_kind = nl_object_kind (first);
    nl_object owner;
    nl_object type_owner;

    switch (member_kind) {
    case nl_kind_port:
    case nl_kind_net:
    case nl_kind_cell: {
      nl_design_object des_obj = (nl_design_object) first;
      owner = (nl_object) nl_design_object_design (des_obj);
      type_owner = owner;
      break;
    }
    case nl_kind_refpin: {
      nl_refpin refpin = (nl_refpin) first;
      owner = (nl_object) nl_refpin_reference (refpin);
      type_owner = (nl_object) nl_reference_design ((nl_reference) owner);
      break;
    }
    case nl_kind_libpin: {
      nl_libpin libpin = (nl_libpin) first;
      owner = (nl_object) nl_libpin_libcell (libpin);
      type_owner = (nl_object) nl_libcell_library ((nl_libcell) owner);
      break;
    }
    default:
      error ("first element of the list of members is not of an appropriate type.");
    }

    {
      int i;

      for ( i = 1; i < objc; i++ ) {
	nl_object member = ui_obj_get_nl_object (objv[i]);
	nl_kind kind = nl_object_kind (member);

	if ( kind != member_kind ) {
	  error ("all elements of the list of member must have the same type.  "
		 "Found one that was %s instead of %s.", nl_kind_to_string (kind),
		 nl_kind_to_string (member_kind));
	}
      }
    }

    {
      nl_type scalar = nl_type_get_scalar (type_owner);
      nl_type type = nl_type_get_array (scalar, left, right);
      nl_bus bus = nl_bus_create (name, type, member_kind, owner);
      int i;

      for ( i = 0; i < objc; i++ ) {
	nl_object member = ui_obj_get_nl_object (objv[i]);
	nl_kind kind = nl_object_kind (member);

	switch (kind) {
	case nl_kind_cell: {
	  nl_cell cell = (nl_cell) member;
	  nl_design design = nl_cell_design (cell);

	  if ( owner != (nl_object) design ) {
	    error ("cell member %s (in design %s) does not belong to the same design "
		   "as the other bus members (in design %s)", nl_cell_name (cell),
		   nl_design_name (nl_cell_design (cell)),
		   nl_design_name ((nl_design) nl_type_owner (type)));
	  }
	  nl_bus_add_cell (bus, cell);
	  break;
	}
	case nl_kind_net: {
	  nl_net net = (nl_net) member;
	  nl_bus_add_net (bus, net);
	  break;
	}
	case nl_kind_port: {
	  nl_port port = (nl_port) member;
	  nl_bus_add_port (bus, port);
	  break;
	}
	case nl_kind_refpin: {
	  nl_refpin refpin = (nl_refpin) member;
	  nl_bus_add_refpin (bus, refpin);
	  break;
	}
	case nl_kind_libpin: {
	  nl_libpin libpin = (nl_libpin) member;
	  nl_bus_add_libpin (bus, libpin);
	  break;
	}
	default:
	  ASSERT (0);
	}
      }
      
      ui_cmd_object_result (interp, (nl_object) bus, NULL);
    }
  }

  return TCL_OK;
}


#(defcommand create_library
  "Create an empty library with the specified name."
  (name string "name of library to create"))
{
  nl_library library = nl_library_create (name, context);

  ui_cmd_object_result (interp, (nl_object) library, NULL);

  return TCL_OK;
}


#(defcommand list_libraries
  "List all of the libraries.")
{
  nl_context_for_all_libraries (context, library) {
    ui_cmd_append_result_walker ((nl_object) library, interp);
  } nl_end_for;

  return TCL_OK;
}


#(defcommand remove_library
   "Remove the specified libraries from memory."
   (-all boolean "remove all libraries")
   (-silent boolean "don't print a message when removing a library")
   &optional
   (library library "library to remove"))
{
  if ( all ) {
    nl_context_for_all_libraries (context, des) {
      char *name = nl_library_name (des);

      if ( !silent ) {
	printf ("Removing library \"%s\"\n", name);
      }
      nl_context_remove_library (context, des);
    } nl_end_for;
  }
  else {
    char *name;

    if ( library == NULL ) {
      error ("a library must be specified unless the -all option is used.");
    }

    name = nl_library_name (library);

    if ( !silent ) {
      printf ("Removing library \"%s\"\n", name);
    }

    nl_context_remove_library (context, library);
  }

  return TCL_OK;
}


#(defcommand create_libcell
  "Create a libcell within the specified library."
  (name string "name of libcell to create")
  (library library "create the libcell in this library"))
{
  nl_libcell result = nl_libcell_create (name, library);
  pnl_library plibrary = NULL;
  nl_library_attr_get_by_name ("pnl library", library, &plibrary);

  if ( plibrary != NULL ) {
    pnl_libcell_create (result, plibrary);
  }

  ui_cmd_object_result (interp, (nl_object) result, NULL);

  return TCL_OK;
}


#(defcommand list_libcells
  "List all of the libcells in the specified library."
  (library library "list the libcells in this library"))
{
  nl_library_for_all_libcells (library, libcell) {
    ui_cmd_append_result_walker ((nl_object) libcell, interp);
  } nl_end_for;
  
  return TCL_OK;
}


#(defcommand get_libcell_name
  "Return the name of the specified libcell."
  (libcell libcell "get the name of this libcell"))
{
  char *name = nl_libcell_name (libcell);

  Tcl_SetResult (interp, name, TCL_VOLATILE);

  return TCL_OK;
}


#(defcommand get_libpin_name
  "Return the name of the specified libpin."
  (libpin libpin "get the name of this libpin"))
{
  char *name = nl_libpin_name (libpin);

  Tcl_SetResult (interp, name, TCL_VOLATILE);

  return TCL_OK;
}


#(defcommand get_libcell_library
  "Return the library to which the specified libcell belongs."
  (libcell libcell "get the library of this libcell"))
{
  nl_library library = nl_libcell_library (libcell);

  ui_cmd_object_result (interp, (nl_object) library, NULL);

  return TCL_OK;
}


#(defcommand get_libcell_pins
  "Return a list of the pins of the specified libcell."
  (-nosupply boolean "do not list supply (POWER, GROUND, or ANALOG) pins")
  (libcell libcell "get the pins of this libcell"))
{
  nl_libcell_for_all_libpins (libcell, libpin) {
    nl_use use = nl_libpin_use (libpin);

    if ( !nosupply || ( use != nl_use_power && use != nl_use_ground ) ) {
      ui_cmd_append_result_walker ((nl_object) libpin, interp);
    }
  } nl_end_for;

  return TCL_OK;
}


#(defcommand get_libpin_cell
   "Return the libcell to which the specified libpin belongs."
   (libpin libpin "get the libcell of this libpin"))
{
  nl_libcell libcell = nl_libpin_libcell (libpin);

  ui_cmd_object_result (interp, (nl_object) libcell, NULL);

  return TCL_OK;
}

  
#(defcommand get_libpin_direction
   ("Return the direction (in, out, or inout) of the specified libpin")
   (libpin libpin "get the direction of this libpin"))
{
  nl_direction direction = nl_libpin_direction (libpin);
  const char *result = nl_direction_to_string (direction);

  Tcl_SetResult (interp, (char *) result, TCL_STATIC);

  return TCL_OK;
}


#(defcommand get_libpin_use
   ("Return the use (signal, power, ground, clock, or analog) of the"
    "specified libpin")
   (libpin libpin "get the use of this libpin"))
{
  nl_use use = nl_libpin_use (libpin);
  const char *result = nl_use_to_string (use);

  Tcl_SetResult (interp, (char *) result, TCL_STATIC);

  return TCL_OK;
}


#(defcommand create_libpin
  "Create a libpin on the specified libcell."
  (name string "name of libpin to create")
  (dir string "the direction of the libpin (in, out, or inout)")
  (libcell libcell "create the libpin on this libcell"))
{
  nl_direction direction = nl_string_to_direction (dir);

  if ( direction == nl_direction_null ) {
    error ("could not convert %s to a direction, "
	   "must be either in, out, or inout", dir);
  }
  else {
    nl_libpin result = nl_libpin_create (name, direction, libcell);
    nl_library library = nl_libcell_library (libcell);
    pnl_library plibrary = NULL;

    nl_library_attr_get_by_name ("pnl library", library, &plibrary);

    if ( plibrary != NULL ) {
      pnl_libcell plibcell = pnl_library_get_libcell (plibrary, libcell);

      pnl_libpin_create (result, plibcell);
    }
    
    ui_cmd_object_result (interp, (nl_object) result, NULL);

    return TCL_OK;
  }
}


#(defcommand create_libpin_bus
   "Create a bus of libpins with specified type."
   (name string "the name of the bus")
   (dir string "the direction of the libpin bus to create (in, out, or inout)")
   (left integer "the left bound of the bus")
   (right integer "the right bound of the bus")
   (libcell libcell "create the libpin bus in this libcell"))
{
  nl_direction direction = nl_string_to_direction (dir);

  if ( direction == nl_direction_null ) {
    error ("invalid direction, \"%s\", must be "
	   "\"in\", \"out\", or \"inout\".", dir);
  }
  else {
    nl_library library = nl_libcell_library (libcell);
    pnl_library plibrary = NULL;
    pnl_libcell plibcell = NULL;
    nl_type scalar = nl_type_get_scalar ((nl_object) library);
    nl_type type = nl_type_get_array (scalar, left, right);
    nl_bus libpin_bus = nl_bus_create (name, type, nl_kind_libpin,
				       (nl_object) libcell);
    int name_len = strlen (name);
    int style_len = strlen (ui_bus_naming_style);
    char *name_buf = alloca (name_len + style_len + 16);

    nl_library_attr_get_by_name ("pnl library", library, &plibrary);

    if ( plibrary != NULL ) {
      plibcell = pnl_library_get_libcell (plibrary, libcell);
    }

    nl_type_for_all_indexes (type, index) {
      nl_libpin libpin;

      sprintf (name_buf, ui_bus_naming_style, name, index);
      libpin = nl_libpin_create (name_buf, direction, libcell);

      nl_bus_add_libpin (libpin_bus, libpin);

      if ( plibcell != NULL ) {
	pnl_libpin_create (libpin, plibcell);
      }
    } nl_end_for;

    ui_cmd_object_result (interp, (nl_object) libpin_bus, NULL);

    return TCL_OK;
  }
}


#(defcommand remove_cell
    "Remove the specified cell (instance)."
    (cell cell "cell to be removed"))
{
  nl_design design = nl_cell_design (cell);

  nl_design_remove_cell (design, cell);

  return TCL_OK;
}


#(defcommand remove_reference
    "Remove the specified reference."
    (reference reference "reference to be removed"))
{
  ar cells = nl_reference_instances (reference);
  int num_inst = ar_size (cells);

  if ( num_inst > 0 ) {
    error ("reference %s has %d instances; it cannot be removed",
	   nl_reference_name (reference), num_inst);
  }
  else {
    nl_design design = nl_reference_design (reference);

    nl_design_remove_reference (design, reference);

    return TCL_OK;
  }
}


#(defcommand remove_port
   "Remove the specified port from the design."
   (port port "port to remove"))
{
  nl_design design = nl_port_design (port);
  char *design_name = nl_design_name (design);
  char *port_name = STRDUPA (nl_port_name (port));

  /* First figure out if removing this port will break connections elsewhere. */

  nl_context_for_all_designs (context, des) {
    nl_reference ref = nl_design_get_reference_by_name (des, design_name);

    if ( ref != NULL ) {
      nl_object down_obj = nl_reference_down_design (ref);

      if ( down_obj == (nl_object) design ) {
	nl_object obj = nl_reference_get_refpin_by_name (ref, port_name);

	if ( obj != NULL ) {
	  nl_refpin refpin = (nl_refpin) obj;

	  nl_reference_for_all_instances (ref, cell) {
	    nl_pin pin = nl_cell_get_pin_by_refpin (cell, refpin);
	    nl_net net = nl_pin_net (pin);

	    if ( net != NULL ) {
	      error ("cell %s in design %s has a connection to pin %s",
		     nl_cell_name (cell), nl_design_name (des), port_name);
	    }
	  } nl_end_for;
	}
      }
    }
  } nl_end_for;

  nl_design_remove_port (design, port);

  nl_context_for_all_designs (context, des) {
    nl_reference ref = nl_design_get_reference_by_name (des, design_name);

    if ( ref != NULL ) {
      nl_object down_obj = nl_reference_down_design (ref);

      if ( down_obj == (nl_object) design ) {
	nl_object obj = nl_reference_get_refpin_by_name (ref, port_name);

	if ( obj != NULL ) {
	  nl_refpin refpin = (nl_refpin) obj;

	  nl_reference_remove_refpin (ref, refpin);
	}
      }
    }
  } nl_end_for;

  return TCL_OK;
}


#(defcommand create_net
   "Create a net in the specified design."
   (name string "name of the net to create")
   (class string "class of net to create (wire, tri, wand, wor, reg, trireg, supply0, or supply1)")
   &optional
   (design current_design "create the net in this design"))
{
  nl_wireclass wireclass = nl_string_to_wireclass (class);

  if ( wireclass == nl_wireclass_null ) {
    error ("invalid class, \"%s\", must be one of wire, tri, wand, wor, reg, "
	   "trireg, supply0, or supply1.", class);
  }
  else {
    nl_net net = nl_net_create (name, wireclass, design);

    if ( net == NULL ) {
      error ("a net named %s could not be created.", name);
    }
    else {
      if ( wireclass == nl_wireclass_supply0 ) {
	nl_design_add_supply0 (design, (nl_object) net);
      }
      else if ( wireclass == nl_wireclass_supply1 ) {
	nl_design_add_supply1 (design, (nl_object) net);
      }

      ui_cmd_object_result (interp, (nl_object) net, NULL);

      return TCL_OK;
    }
  }
}


#(defcommand remove_net
    "Remove the specified net (instance)."
    (net net "net to be removed"))
{
  nl_bus bus = nl_net_bus (net);

  if ( bus != NULL ) {
    error ("net %s can't be removed because it is a member of bus %s.",
	   nl_net_name (net), nl_bus_name (bus));
  }
  else {
    nl_design design = nl_net_design (net);

    nl_design_remove_net (design, net);
  }

  return TCL_OK;
}


#(defcommand create_port
  "Create a port in the specified design."
  (-nonet boolean "do not create a net to go with the port")
  (name string "name of the port to create")
  (dir string "the direction of the port to create (in, out, or inout)")
  &optional
  (design current_design "create a port on this design"))
{
  nl_direction direction = nl_string_to_direction (dir);

  if ( direction == nl_direction_null ) {
    error ("invalid direction, \"%s\", must be "
	   "\"in\", \"out\", or \"inout\".", dir);
  }
  else {
    nl_port port = nl_port_create (name, design, direction);

    if ( port == NULL ) {
      error ("a port named %s could not be created.", name);
    }
    else {
      if ( !nonet ) {
	nl_net net = nl_net_create (name, nl_wireclass_wire, design);
	nl_pin pin = nl_port_pin (port);

	nl_pin_connect_net (pin, net);
      }

      {
	char *design_name = nl_design_name (design);

	nl_context_for_all_designs (context, des) {
	  nl_reference ref
	    = nl_design_get_reference_by_name (des, design_name);

	  if ( ref != NULL ) {
	    nl_object down_design = nl_reference_down_design (ref);

	    if ( (nl_object) design == down_design ) {
	      nl_refpin_create (name, (nl_object) port, ref);
	    }
	  }
	} nl_end_for;
      }
      
      ui_cmd_object_result (interp, (nl_object) port, NULL);

      return TCL_OK;
    }
  }
}


#(defcommand get_scalar_type
   "Return the scalar type."
   &optional
   (design current_design "return the scalar type for this design"))
{
  nl_type result = nl_type_get_scalar ((nl_object) design);

  ui_cmd_object_result (interp, (nl_object) result, NULL);

  return TCL_OK;
}


#(defcommand get_integer_type
   "Return the integer type."
   &optional
   (design current_design "return the scalar type for this design"))
{
  nl_type result = nl_type_get_integer ((nl_object) design);

  ui_cmd_object_result (interp, (nl_object) result, NULL);

  return TCL_OK;
}


#(defcommand get_array_type
   "Create a type with the specified parameters."
   (left integer "left bound of the array")
   (right integer "right bound of the array")
   (base type "the type of the array members"))
{
  nl_type result = nl_type_get_array (base, left, right);

  ui_cmd_object_result (interp, (nl_object) result, NULL);

  return TCL_OK;
}


#(defcommand create_net_bus
   "Create a bus of nets with specified type."
   (name string "the name of the bus")
   (class string "class of nets to create (wire, tri, wand, wor, reg, trireg, supply0, or supply1)")
   (left integer "the left bound of the bus")
   (right integer "the right bound of the bus")
   &optional
   (design current_design "create the port bus in this design"))
{
  nl_wireclass wireclass = nl_string_to_wireclass (class);

  if ( wireclass == nl_wireclass_null ) {
    error ("invalid class, \"%s\", must be one of wire, tri, wand, wor, reg, "
	   "trireg, supply0, or supply1.", class);
  }
  else {
    int name_len = strlen (name);
    int style_len = strlen (ui_bus_naming_style);
    char *name_buf = alloca (name_len + style_len + 16);
    nl_type scalar = nl_type_get_scalar ((nl_object) design);
    nl_type type = nl_type_get_array (scalar, left, right);
    nl_bus net_bus
      = nl_bus_create (name, type, nl_kind_net, (nl_object) design);

    nl_type_for_all_indexes (type, index) {
      nl_net net;

      sprintf (name_buf, ui_bus_naming_style, name, index);
      net = nl_net_create (name_buf, wireclass, design);
      nl_bus_add_net (net_bus, net);
    } nl_end_for;

    ui_cmd_object_result (interp, (nl_object) net_bus, NULL);

    return TCL_OK;
  }
}


#(defcommand create_port_bus
   "Create a bus of ports with specified type."
   (name string "the name of the bus")
   (dir string "the direction of the port bus to create (in, out, or inout)")
   (left integer "the left bound of the bus")
   (right integer "the right bound of the bus")
   &optional
   (design current_design "create the port bus in this design"))
{
  nl_direction direction = nl_string_to_direction (dir);

  if ( direction == nl_direction_null ) {
    error ("invalid direction, \"%s\", must be "
	   "\"in\", \"out\", or \"inout\".", dir);
  }
  else {
    int name_len = strlen (name);
    int style_len = strlen (ui_bus_naming_style);
    char *name_buf = alloca (name_len + style_len + 16);
    nl_type scalar = nl_type_get_scalar ((nl_object) design);
    nl_type type = nl_type_get_array (scalar, left, right);
    nl_bus port_bus
      = nl_bus_create (name, type, nl_kind_port, (nl_object) design);
    nl_bus net_bus
      = nl_bus_create (name, type, nl_kind_net, (nl_object) design);

    nl_type_for_all_indexes (type, index) {
      nl_port port;
      nl_net net;
      nl_pin pin;

      sprintf (name_buf, ui_bus_naming_style, name, index);
      port = nl_port_create (name_buf, design, direction);
      nl_bus_add_port (port_bus, port);
      net = nl_net_create (name_buf, nl_wireclass_wire, design);
      nl_bus_add_net (net_bus, net);

      pin = nl_port_pin (port);
      nl_pin_connect_net (pin, net);
    } nl_end_for;

    ui_cmd_object_result (interp, (nl_object) port_bus, NULL);

    return TCL_OK;
  }
}


#(defcommand create_refpin_bus
   "Create a bus of refpins with specified type."
   (name string "the name of the bus")
   (left integer "the left bound of the bus")
   (right integer "the right bound of the bus")
   (reference reference "create the refpin bus in this design"))
{
  int name_len = strlen (name);
  int style_len = strlen (ui_bus_naming_style);
  char *name_buf = alloca (name_len + style_len + 16);
  nl_design design = nl_reference_design (reference);
  nl_type scalar = nl_type_get_scalar ((nl_object) design);
  nl_type type = nl_type_get_array (scalar, left, right);
  nl_bus refpin_bus
    = nl_bus_create (name, type, nl_kind_refpin, (nl_object) reference);

  nl_type_for_all_indexes (type, index) {
    nl_refpin refpin;

    sprintf (name_buf, ui_bus_naming_style, name, index);
    refpin = nl_refpin_create (name_buf, NULL, reference);
    nl_bus_add_refpin (refpin_bus, refpin);
  } nl_end_for;

  ui_cmd_object_result (interp, (nl_object) refpin_bus, NULL);

  return TCL_OK;
}



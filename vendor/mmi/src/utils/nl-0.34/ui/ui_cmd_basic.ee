static
void
get_net_and_idesign (nl_object net_or_inet, ar path, nl_context context,
		     int hier, nl_idesign *idesign_p, nl_net *net_p)
{
  nl_kind kind = nl_object_kind (net_or_inet);
  nl_idesign idesign;
  nl_net net;

  if ( kind == nl_kind_net ) {
    net = (nl_net) net_or_inet;

    if ( hier ) {
      if ( path == NULL || ar_size (path) == 0 ) {
	nl_design design = nl_net_design (net);
	int num_idesigns = nl_design_num_idesigns (design);

	if ( num_idesigns > 1 ) {
	  error ("net %s is instantiated more than once in the current "
		 "instance tree.\n"
		 "    Please specify a unique instance of this net.",
		 nl_net_name (net));
	}
	else if ( num_idesigns == 0 ) {
	  error ("no instance tree has been created or\n"
		 "    net %s is not instantiated in the current tree.",
		 nl_net_name (net));
	}
	else {
	  idesign = nl_idesign_get_or_create (design, NULL);
	}
      }
      else {
	idesign = ui_get_idesign_for_path (path, context);
      }
    }
    else {
      idesign = NULL;
    }
  }
  else {
    nl_inet inet = (nl_inet) net_or_inet;

    net = nl_inet_net (inet);
    idesign = nl_inet_idesign (inet);
  }

  *net_p = net;
  *idesign_p = idesign;
}


#(defcommand get_net_pins
  ("Return a list of all the pins connected to the specified net.  Any"
   "combination of the switches may be used to get only certain pins.  If no"
   "switches are specified, all pins are returned.")
  (-drivers boolean "return only the drivers of the net")
  (-loads boolean "return only the loads of the net")
  (-fanios boolean "return only the inout pins connected to the net")
  (-hierarchy boolean "cross hierarchy boundaries")
  (-recursive boolean "same as -hierarchy")   
  (-noassign boolean "cross assignment buffers")
  (net_or_inet net_or_inet "get the pins connected to this net"))
{
  int do_hier = (hierarchy || recursive);
  nl_idesign idesign;
  nl_net net;

  if ( !drivers && !loads && !fanios ) {
    drivers = 1;
    loads = 1;
    fanios = 1;
  }

  get_net_and_idesign (net_or_inet, net_or_inet_path, context, do_hier,
		       &idesign, &net);

  nl_walk_connected_pins (net, idesign, noassign, do_hier, drivers, loads,
			  fanios, ui_cmd_append_result_walker, interp);

  return TCL_OK;
}


#(defcommand get_net_nets
   "Return a list of all nets that are connected to the specified net."
   (-hierarchy boolean "return nets that are connected through the hierarchy")
   (-noassign boolean "return nets that are connected through assignments")
   (net_or_inet net_or_inet "get the nets connected to this net"))
{
  nl_net net;
  nl_idesign idesign;

  get_net_and_idesign (net_or_inet, net_or_inet_path, context, hierarchy,
		       &idesign, &net);

  nl_walk_connected_nets (net, idesign, noassign, hierarchy, 1, 1, 1,
			  (nl_walk_fun) ui_cmd_append_result_walker, interp);

  return TCL_OK;
}


#(defcommand get_cell_pins
   ("Return a list of all the pins on the specified cell.  Any combination of"
    "the switches may be used to get only certain pins.  If no switches are"
    "specified, all pins are returned.")
   (-inputs boolean "return only input pins")
   (-outputs boolean "return only output pins")
   (-inouts boolean "return only inout pins")
   (cell_or_icell cell_or_icell "get the pins of this cell"))
{
  nl_kind kind = nl_object_kind (cell_or_icell);

  if ( !inputs && !outputs && !inouts ) {
    inputs = 1;
    outputs = 1;
    inouts = 1;
  }

  if ( kind == nl_kind_cell ) {
    nl_cell cell = (nl_cell) cell_or_icell;

    if ( inputs ) {
      nl_cell_for_all_inputs (cell, pin) {
	ui_cmd_append_result_walker ((nl_object) pin, interp);
      } nl_end_for;
    }
    
    if ( outputs ) {
      nl_cell_for_all_outputs (cell, pin) {
	ui_cmd_append_result_walker ((nl_object) pin, interp);
      } nl_end_for;
    }
    
    if ( inouts ) {
      nl_cell_for_all_inouts (cell, pin) {
	ui_cmd_append_result_walker ((nl_object) pin, interp);
      } nl_end_for;
    }
  }
  else {
    nl_icell icell = (nl_icell) cell_or_icell;

    if ( inputs ) {
      nl_icell_for_all_inputs (icell, ipin) {
	ui_cmd_append_result_walker ((nl_object) ipin, interp);
      } nl_end_for;
    }
    
    if ( outputs ) {
      nl_icell_for_all_outputs (icell, ipin) {
	ui_cmd_append_result_walker ((nl_object) ipin, interp);
      } nl_end_for;
    }
    
    if ( inouts ) {
      nl_icell_for_all_inouts (icell, ipin) {
	ui_cmd_append_result_walker ((nl_object) ipin, interp);
      } nl_end_for;
    }
  }

  return TCL_OK;
}



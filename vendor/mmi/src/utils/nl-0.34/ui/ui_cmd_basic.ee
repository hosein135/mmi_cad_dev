  if ( kind == nl_kind_pin ) {
    nl_pin pin = (nl_pin) pin_or_ipin;
    nl_net net = nl_pin_net (pin);

    if ( net != NULL ) {
      ui_cmd_object_result (interp, (nl_object) net, NULL);
    }
  }
  else {
    nl_ipin ipin = (nl_ipin) pin_or_ipin;
    nl_inet inet = nl_ipin_inet (ipin);

    if ( inet != NULL ) {
      ui_cmd_object_result (interp, (nl_object) inet, NULL);
    }
  }

  return TCL_OK;
}



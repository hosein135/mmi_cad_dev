#(defcommand connect_pin
   "Connect the specified pin to the specified net."
   (pin pin "pin to connect")
   (net net "connect the pin to this net"))
{
  if ( nl_pin_net (pin) != NULL ) {
    nl_net pin_net = nl_pin_net (pin);
    nl_refpin refpin = nl_pin_refpin (pin);
    char *pin_name;

    if ( refpin == NULL ) {
      nl_port port = (nl_port) nl_pin_owner (pin);
      pin_name = nl_port_name (port);
    }
    else {
      pin_name = nl_refpin_name (refpin);
    }

    error ("pin %s already has a connection (to net %s).",
	   pin_name, nl_net_name (pin_net));
  }
  
  nl_pin_connect_net (pin, net);

  return TCL_OK;
}



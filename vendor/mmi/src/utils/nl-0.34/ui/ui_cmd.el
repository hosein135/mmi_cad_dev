		      (cons (format "\\\n    \"-%s\"," name)
			    result)))
	    (setq opts nil)))))
    
    (apply 'concat (nreverse result))))
	  

(defun declare-argument-table (options)
  (let (opt
	(opts options)
	(result nil)
	(optional "required"))
    (while opts
      (setq opt (car opts)
	    opts (cdr opts))
      (if (eq opt '&optional)
	  (setq optional "optional")
	(let* ((type (nth 1 opt))
	       (type-info (assoc type option-type-assoc))
	       (name (symbol-name (car opt)))
	       (doc (apply 'concat (nthcdr 2 opt)))
	       var)

	  (if (null type)
	      (error "%s:%d: invalid argument type specifier -> %s"
		     embedded-elisp-source-file
		     embedded-elisp-following-line
		     (nth 1 opt)))

	  (if (and (eq type 'current_design)
		   (not (string= optional "optional")))
	      (error (concat "%s:%d: current_design argtype must be associated"
			     " with an optional parameter")
		     embedded-elisp-source-file
		     embedded-elisp-following-line))

	  (if (= ?- (aref name 0))
	      nil
	    (setq result (cons (format
				"\\\n    { ui_%s, NULL, NULL, ui_%s, \"%s\" },"
				type optional doc)
			       result))))))
    
    (apply 'concat (nreverse result))))


(defun initialize-option-table (options)
  (let (opt
	(count 1)
	(opts options)
	(result nil))
    (while opts
      (setq opt (car opts)
	    opts (cdr opts))
      (if (eq opt '&optional)
	  (setq opts nil)
	(let* ((type (nth 1 opt))
	       (name (symbol-name (car opt)))
	       (doc (apply 'concat (nthcdr 2 opt)))
	       var)

	  (if (null type)
	      (error "%s:%d: invalid argument type specifier -> %s"
		     embedded-elisp-source-file
		     embedded-elisp-following-line
		     (nth 1 opt)))

	  (if (= ?- (aref name 0)) 
	      (let ((name (substring name 1 nil)))
		(setq result (cons (format "\\\n  __opts[%d].variable = &%s;" count name)
				   result)
		      count (1+ count)))
		      
	    (setq opts nil)))))
    
    (apply 'concat (nreverse result))))
	  

(defun initialize-argument-table (options)
  (let (opt
	(count 0)
	(opts options)
	(result nil)
	(optional "required"))
    (while opts
      (setq opt (car opts)
	    opts (cdr opts))
      (if (eq opt '&optional)
	  (setq optional "optional")
	(let* ((type (nth 1 opt))
	       (type-info (assoc type option-type-assoc))
	       (name (symbol-name (car opt)))
	       (doc (apply 'concat (nthcdr 2 opt)))
	       var)

	  (if (null type)
	      (error "%s:%d: invalid argument type specifier -> %s"
		     embedded-elisp-source-file
		     embedded-elisp-following-line
		     (nth 1 opt)))

	  (if (and (eq type 'current_design)
		   (not (string= optional "optional")))
	      (error (concat "%s:%d: current_design argtype must be associated"
			     " with an optional parameter")
		     embedded-elisp-source-file
		     embedded-elisp-following-line))

	  (if (= ?- (aref name 0))
	      nil
	    (setq path_name (if (nth 3 type-info) (format "&%s_path" name) "NULL")
		  result (cons (format "\\\n  __args[%d].variable = &%s;" count name)
			       (cons (format "\\\n  __args[%d].path_variable = %s;"
					     count path_name)
				     result))
		  count (1+ count))))))
    
    (apply 'concat (nreverse result))))


(defun free-paths (options)
  (let (opt
	(opts options)
	(result nil))

    (while opts
      (setq opt (car opts)
	    opts (cdr opts))

      (if (not (eq opt '&optional))
	  (let* ((type-info (assoc (nth 1 opt) option-type-assoc))
		 (name (symbol-name (car opt)))
		 (var (if (= ?- (aref name 0)) 
			  (substring name 1 nil)
			name)))

	    (if type-info
		(if (nth 3 type-info)
		    (setq result (cons
				  (concat 
				   (format "\\\n    if ( %s_path != NULL ) " var)
				   (format "ar_free (%s_path);" var))
				  result)))

	      (error "%s:%d: invalid argument type specifier -> %s"
		     embedded-elisp-source-file
		     embedded-elisp-following-line
		     (nth 1 opt))))))
    
    (apply 'concat (nreverse result))))


(defun format-doc (doc)
  (concat "\""
	  (if (stringp doc)
	      doc
	    (mapconcat 'identity doc "\\n"))
	  "\""))


(defmacro defcommand (command doc &rest args)
  `(do-defcommand ,(symbol-name command) (quote ,doc) (quote ,args)))


(defun do-defcommand (name doc args)
  (let ((cmd-name (concat "ui_cmd_" name))
	(wrap-name (concat "ui_cmd_" name "_wrap")))

    (setq commands (cons name commands))

    (concat
     "#define UI_CMD_NAME_STRING \"" "nl_" name "\"\n"
     "#define UI_CMD_FUNCTION "       cmd-name "\n"
     "#define UI_CMD_WRAPPER "        wrap-name "\n"
     "#define UI_CMD_VAR_DECLS "      (declare-vars args) "\n"
     "#define UI_CMD_OPTIONS "        (declare-option-table args) "\n"
     "#define UI_CMD_SWITCHES "       (declare-switch-table args) "\n"
     "#define UI_CMD_ARGUMENTS "      (declare-argument-table args) "\n"
     "#define UI_CMD_INIT_OPTIONS "   (initialize-option-table args) "\n"
     "#define UI_CMD_INIT_ARGUMENTS " (initialize-argument-table args) "\n"
     "#define UI_CMD_DOC "            (format-doc doc) "\n"
     "#define UI_CMD_PARAMETERS "     (pass-vars args) "\n"
     "#define UI_CMD_PROTO "          (proto-vars args) "\n"
     "#define UI_CMD_CLEANUP "        (free-paths args) "\n"
     "\n"
     "#include \"ui_cmd.h\"\n"
     "\n"
     "#undef UI_CMD_NAME_STRING\n"
     "#undef UI_CMD_FUNCTION\n"
     "#undef UI_CMD_WRAPPER\n"
     "#undef UI_CMD_VAR_DECLS\n"
     "#undef UI_CMD_OPTIONS\n"
     "#undef UI_CMD_SWITCHES\n"
     "#undef UI_CMD_ARGUMENTS\n"
     "#undef UI_CMD_INIT_OPTIONS\n"
     "#undef UI_CMD_INIT_ARGUMENTS\n"
     "#undef UI_CMD_DOC\n"
     "#undef UI_CMD_PARAMETERS\n"
     "#undef UI_CMD_PROTO\n"
     "#undef UI_CMD_CLEANUP\n"
     (line-directive)
     )))
	  

(defun register-all-commands ()
  (let ((result nil))
    (while commands
      (setq result 
	    (cons (format (concat "  ui_cmd_register (interp, \"%s\", "
				  "prefix, ui_cmd_%s_wrap, context);\n")
			  (car commands) (car commands))
		  result))
      (setq commands (cdr commands)))
    (apply 'concat result)))

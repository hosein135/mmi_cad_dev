(defun line-directive ()
  (format "#line %d \"%s\""
	  (1+ embedded-elisp-following-line)
	  embedded-elisp-source-file))


(defun warning-message ()
  (concat "/" "* DO NOT EDIT THIS FILE *" "/\n"
	  "/" "* This file is generated from "
	  embedded-elisp-source-file ". *" "/\n\n"
	  (line-directive)))


(defun declare-vars (options)
  (let (opt
	(opts options)
	(result nil))
    (while opts
      (setq opt (car opts)
	    opts (cdr opts))
      (if (not (eq opt '&optional))
	  (let* ((type-info (assoc (nth 1 opt) option-type-assoc))
		 (name (symbol-name (car opt)))
		 (var (if (= ?- (aref name 0)) 
			  (substring name 1 nil)
			name)))

	    (if type-info
		(progn
		  (if (nth 3 type-info)
		      (setq result (cons (format "ar %s_path = NULL;" var)
					 result)))
		  (setq result (cons (format "%s %s = %s;"
					     (nth 1 type-info) var
					     (nth 2 type-info))
				     result)))

	      (error "%s:%d: invalid argument type specifier -> %s"
		     embedded-elisp-source-file
		     embedded-elisp-following-line
		     (nth 1 opt))))))

    (mapconcat 'identity (cons "" (nreverse result)) "\\\n    ")))


(defun proto-vars (options)
  (let (opt
	(opts options)
	(result nil))
    (while opts
      (setq opt (car opts)
	    opts (cdr opts))
      (if (not (eq opt '&optional))
	  (let* ((type-info (assoc (nth 1 opt) option-type-assoc))
		 (name (symbol-name (car opt)))
		 (var (if (= ?- (aref name 0)) 
			  (substring name 1 nil)
			name)))

	    (if type-info
		(progn
		  (if (nth 3 type-info)
		      (setq result (cons (format "ar %s_path" var)
					 result)))
		  (setq result (cons (format "%s %s" (nth 1 type-info) var)
				     result)))
		       

	      (error "%s:%d: invalid argument type specifier -> %s"
		     embedded-elisp-source-file
		     embedded-elisp-following-line
		     (nth 1 opt))))))
    
    (mapconcat 'identity (cons "" (nreverse result)) ", ")))


(defun pass-vars (options)
  (let (opt
	(opts options)
	(result nil))
    (while opts
      (setq opt (car opts)
	    opts (cdr opts))
      (if (not (eq opt '&optional))
	  (let* ((type-info (assoc (nth 1 opt) option-type-assoc))
		 (name (symbol-name (car opt)))
		 (var (if (= ?- (aref name 0)) 
			  (substring name 1 nil)
			name)))

	    (if type-info
		(progn
		  (if (nth 3 type-info)
		      (setq result (cons (concat var "_path") result)))
		  (setq result (cons var result)))

	      (error "%s:%d: invalid argument type specifier -> %s"
		     embedded-elisp-source-file
		     embedded-elisp-following-line
		     (nth 1 opt))))))
    
    (mapconcat 'identity (cons "" (nreverse result)) ", ")))


(defun declare-option-table (options)
  (let (opt
	(opts options)
	(result nil))
    (while opts
      (setq opt (car opts)
	    opts (cdr opts))
      (if (eq opt '&optional)
	  (setq opts nil)
	(let* ((type (nth 1 opt))
	       (name (symbol-name (car opt)))
	       (doc (apply 'concat (nthcdr 2 opt)))
	       var)

	  (if (null type)
	      (error "%s:%d: invalid argument type specifier -> %s"
		     embedded-elisp-source-file
		     embedded-elisp-following-line
		     (nth 1 opt)))

	  (if (= ?- (aref name 0)) 
	      (let ((name (substring name 1 nil)))
		(setq result 
		      (cons (format "\\\n    { \"-%s\", ui_%s, NULL, \"%s\" },"
				    name type doc)
			    result)))
	    (setq opts nil)))))
    
    (apply 'concat (nreverse result))))
	  


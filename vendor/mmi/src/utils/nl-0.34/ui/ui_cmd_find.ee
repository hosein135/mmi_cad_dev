static
ui_find_mode
ui_find_mode_encode (int exact, int regexp)
{
  if ( exact && regexp ) {
    return ui_find_mode_regexp;
  }
  else if ( exact ) {
    return ui_find_mode_exact;
  }
  else if ( regexp ) {
    return ui_find_mode_subregexp;
  }
  else {
    return ui_find_mode_glob;
  }
}


struct ui_cmd_find_data {
  Tcl_Interp *interp;
  nl_context context;
  ar path;
  nl_kind kind;
  nl_kind subkind;
  ui_find_mode mode;
  ar result;
  ar paths;
  int status;
};


static
nl_walk_status
ui_cmd_find_walker (nl_object object, void *ptr)
{
  struct ui_cmd_find_data *data = (struct ui_cmd_find_data *) ptr;
  nl_design design = (nl_design) object;
  int status = ui_find_object_path (data->interp, data->context, data->path,
				    data->kind, data->subkind, design,
				    data->mode, data->result, data->paths);

  data->status = status;

  if ( status == TCL_OK ) {
    return nl_walk_status_continue;
  }
  else {
    return nl_walk_status_stop;
  }
}


static
int
ui_cmd_find_object_common (Tcl_Interp *interp, nl_context context, int exact,
			   int regexp, int recursive, char *pattern,
			   nl_design design, nl_kind kind, nl_kind subkind)
{
  char *str;
  ar path = ui_tokenize_hierarchy_path (pattern, &str, ui_hierarchy_separator);
  ui_find_mode mode = ui_find_mode_encode (exact, regexp);
  ar result = ar_alloc (8, sizeof (nl_reference));
  ar paths = NULL; /* ar_alloc (8, sizeof (ar)); */
  struct ui_cmd_find_data data;
  volatile int status;

  data.interp = interp;
  data.context = context;
  data.path = path;
  data.kind = kind;
  data.subkind = subkind;
  data.mode = mode;
  data.result = result;
  data.paths = paths;
  data.status = TCL_OK;

  error_unwind_protect {
    if ( recursive ) {
      nl_walk_hierarchy (design, 0, ui_cmd_find_walker, &data);
    }
    else {
      ui_cmd_find_walker ((nl_object) design, &data);
    }

    status = data.status;

    if ( status == TCL_OK ) {
      ui_cmd_object_list_result (interp, result, paths);
    }
  }
  error_on_exit {
    FREE (str);
    ar_free (path);

    ar_free (result);

    /*
    ar_for_all (paths, ar, path) {
      if ( path != NULL )
	ar_free (path);
    } ar_end_for;

    ar_free (paths);
    */
  }
  error_end;

  return status;
}  


#(progn

  (defmacro defcommand-find (name singular plural need-recursive need-current-design)
    `(defcommand 
       ,(intern (format "find_%s" name))
       (,(format "Return the list of %s whose name matches the specified pattern." plural)
	"By default the pattern is matched according to the rules of string_match,"
	"which allows wildcards like '*', '?', and '[]'.")
       (-exact boolean 
	       ,(concat (format "the pattern is the name of the %s (i.e. no wildcards allowed), "
				singular)
			"with -regexp this option means the pattern must match the entire name"))
       (-regexp boolean "the pattern is a TCL regular expression")
       ,@(and need-recursive
	      `((-recursive boolean ,(format "find the %s anywhere in the hierarchy" plural))))
       (pattern string "pattern to match")
       ,@(and need-current-design
	      `(&optional 
		(design current_design ,(format "design in which to find the %s" plural))))))

  "")

   
#(defcommand-find designs "design" "designs" nil nil)
{
  int status = ui_cmd_find_object_common (interp, context, exact, regexp, 0,
					  pattern, NULL, nl_kind_design, nl_kind_null);

  return status;
}  



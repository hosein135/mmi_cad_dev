#(defcommand list_designs
   "Return a list of all designs in memory."
   (-library boolean "list only library designs (i.e. library cells).")
   (-hierarchy boolean "list only hierarchical (i.e. non-library) designs."))
{
  Tcl_Obj *result = Tcl_NewListObj (0, NULL);

  if ( ! library && ! hierarchy ) {
    library = 1;
    hierarchy = 1;
  }

  nl_context_for_all_designs (context, design) {
    int libcell = nl_design_libcell (design);

    if ( (library && libcell) || (hierarchy && !libcell) ) {
      ui_cmd_append_object_list (interp, result, (nl_object) design, NULL);
    }
  } nl_end_for;

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}


struct ui_cmd_loop_data {
  char *loop_name;
  Tcl_Interp *interp;
  Tcl_Obj *var_obj;
  Tcl_Obj *body;
  int result;
};


static
nl_walk_status
ui_cmd_loop_body_walker (nl_object obj, void *data)
{
  struct ui_cmd_loop_data *loop_data = data;
  Tcl_Interp *interp = loop_data->interp;
  Tcl_Obj *body = loop_data->body;
  Tcl_Obj *obj_obj = ui_obj_create (obj, NULL);
  int result;

  Tcl_ObjSetVar2 (loop_data->interp, loop_data->var_obj, NULL, obj_obj, 0);

  result = Tcl_EvalObj (interp, body);

  if ( result == TCL_OK ) {
    return nl_walk_status_continue;
  }
  else if ( result == TCL_CONTINUE ) {
    return nl_walk_status_continue;
  }
  else if ( result == TCL_BREAK ) {
    return nl_walk_status_stop;
  }
  else if ( result == TCL_ERROR ) {
    char msg[100];

    sprintf (msg, "\n    (\"%s\" body line %d)",
	     loop_data->loop_name, interp->errorLine);
    Tcl_AddObjErrorInfo (interp, msg, -1);
    loop_data->result = TCL_ERROR;

    return nl_walk_status_stop;
  }
  else {
    loop_data->result = result;
    return nl_walk_status_stop;
  }
}


#(defcommand foreach_design_cell
   "Loop over all the cells in the specified design."
   (-hierarchy boolean "loop over only hierarchy cells")
   (-library   boolean "loop over only instances of library cells")
   (-unlinked  boolean "loop over only unlinked cells")
   (-recursive boolean "recursively loop over all cells in the hierarchy")
   (-noassign  boolean "don't include assignment buffers")
   (-from      idesign "start at this point in the hierarchy, requires -recursive")
   (var        string  "name of variable to which cells are bound")
   (design     design  "loop over the cells in this design")
   (body       tcl_object "loop body"))
{
  nl_idesign idesign;
  struct ui_cmd_loop_data loop_data;

  if ( from == NULL ) {
    if ( recursive ) {
      idesign = nl_idesign_get_or_create (design, NULL);
    }
    else {
      idesign = NULL;
    }
  }
  else {
    idesign = from;
    design = nl_idesign_design (from);
  }

  if ( !hierarchy && !library && !unlinked ) {
    hierarchy = 1;
    library = 1;
    unlinked = 1;
  }

  loop_data.loop_name = "foreach_design_cell";
  loop_data.interp = interp;
  loop_data.var_obj = Tcl_NewStringObj (var, -1);
  loop_data.body = body;
  loop_data.result = TCL_OK;

  Tcl_IncrRefCount (loop_data.var_obj);

  nl_walk_cells (design, idesign, noassign, recursive, library, unlinked,
		 hierarchy, ui_cmd_loop_body_walker, &loop_data);

  Tcl_DecrRefCount (loop_data.var_obj);

  return loop_data.result;
}
  
  

#(defcommand list_cells
   ("Return a list of all the cells in the specified design."
    "By default, all cells in the current design are listed.")
   (-hierarchy boolean "list only hierarchy cells")
   (-library   boolean "list only instances of library cells")
   (-unlinked  boolean "list only unlinked cells")
   (-recursive boolean "recursively list all cells in the hierarchy")
   (-noassign  boolean "don't include assignment buffers")
   (-from      idesign "start at this point in the hierarchy, requires -recursive")
   &optional
   (design current_design "list the cells for this design"))
{
  nl_idesign idesign;

  if ( from == NULL ) {
    if ( recursive ) {
      idesign = nl_idesign_get_or_create (design, NULL);
    }
    else {
      idesign = NULL;
    }
  }
  else {
    idesign = from;
    design = nl_idesign_design (from);
  }

  if ( !hierarchy && !library && !unlinked ) {
    hierarchy = 1;
    library = 1;
    unlinked = 1;
  }

  nl_walk_cells (design, idesign, noassign, recursive, library, unlinked,
		 hierarchy, ui_cmd_append_result_walker, interp);

  return TCL_OK;
}


#(defcommand foreach_design_net
   "Loop over all the nets in the specified design."
   (-hierarchy boolean "loop over all unique hierarchial nets")
   (-recursive boolean "same as -hierarchy")
   (-noassign  boolean "treat nets connected by assignment buffers as equivalent")
   (-noconstant boolean "do not loop over constant nets")
   (-noempty boolean "do not loop over nets that have no pins")
   (-onlyconstant boolean "loop over only constant nets")
   (var string "name of variable to which nets are bound")
   (design design "loop over the nets in this design")
   (body tcl_object "loop body"))
{
  int do_hierarchy = (hierarchy || recursive);
  nl_idesign idesign;
  struct ui_cmd_loop_data loop_data;

  if ( do_hierarchy ) {
    idesign = nl_idesign_get_or_create (design, NULL);
  }
  else {
    idesign = NULL;
  }

  loop_data.loop_name = "foreach_design_net";
  loop_data.interp = interp;
  loop_data.var_obj = Tcl_NewStringObj (var, -1);
  loop_data.body = body;
  loop_data.result = TCL_OK;

  Tcl_IncrRefCount (loop_data.var_obj);

  nl_walk_nets (design, idesign, noassign, do_hierarchy, noconstant, noempty,
		onlyconstant, ui_cmd_loop_body_walker, &loop_data);

  Tcl_DecrRefCount (loop_data.var_obj);

  return TCL_OK;
}


#(defcommand list_nets
   "Return a list of all the nets in the specified design."
   (-hierarchy boolean "list all unique hierarchial nets")
   (-recursive boolean "same as -hierarchy")
   (-noassign  boolean "treat nets connected by assignment buffers as equivalent")
   (-noconstant boolean "do not include constant nets")
   (-noempty boolean "do not include nets that have no pins")
   (-onlyconstant boolean "list only constant nets")
   &optional
   (design current_design "list the nets for this design"))
{
  int do_hierarchy = (hierarchy || recursive);
  nl_idesign idesign;

  if ( do_hierarchy ) {
    idesign = nl_idesign_get_or_create (design, NULL);
  }
  else {
    idesign = NULL;
  }

  nl_walk_nets (design, idesign, noassign, do_hierarchy, noconstant, noempty,
		onlyconstant, ui_cmd_append_result_walker, interp);

  return TCL_OK;
}


#(defcommand list_references
   "Return a list of all the references in the specified design."
   &optional
   (design current_design "list the references for this design"))
{
  Tcl_Obj *result = Tcl_NewListObj (0, NULL);

  nl_design_for_all_references (design, reference) {
    ui_cmd_append_object_list (interp, result, (nl_object) reference,
			       design_path);
  } nl_end_for;

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}


#(defcommand foreach_design_port
   "Loop over all the ports in the specified design."
   (-inputs boolean "loop over the input ports")
   (-outputs boolean "list the output ports")
   (-inouts boolean "list the inout ports")
   (var string "name of variable to which to bind ports")
   (design design "loop over the ports of this design")
   (body tcl_object "loop body"))
{
  struct ui_cmd_loop_data loop_data;

  if ( !inputs && !outputs && !inouts ) {
    inputs = 1;
    outputs = 1;
    inouts = 1;
  }

  loop_data.loop_name = "foreach_design_cell";
  loop_data.interp = interp;
  loop_data.var_obj = Tcl_NewStringObj (var, -1);
  loop_data.body = body;
  loop_data.result = TCL_OK;

  Tcl_IncrRefCount (loop_data.var_obj);

  nl_design_for_all_ports (design, port) {
    nl_direction direction = nl_port_direction (port);

    if ( (inputs  && (direction == nl_direction_in)) ||
	 (outputs && (direction == nl_direction_out)) ||
	 (inouts  && ((direction == nl_direction_inout) ||
		      (direction == nl_direction_unknown))) ) {
      ui_cmd_loop_body_walker ((nl_object) port, &loop_data);
    }
  } nl_end_for;

  Tcl_DecrRefCount (loop_data.var_obj);

  return TCL_OK;
}


#(defcommand list_ports
   "Return a list of all the ports in the specified design."
   (-inputs boolean "list the input ports")
   (-outputs boolean "list the output ports")
   (-inouts boolean "list the inout ports")
   &optional
   (design current_design "list the ports for this design"))
{
  Tcl_Obj *result = Tcl_NewListObj (0, NULL);

  if ( !inputs && !outputs && !inouts ) {
    inputs = 1;
    outputs = 1;
    inouts = 1;
  }

  nl_design_for_all_ports (design, port) {
    nl_direction direction = nl_port_direction (port);

    if ( (inputs  && (direction == nl_direction_in)) ||
	 (outputs && (direction == nl_direction_out)) ||
	 (inouts  && ((direction == nl_direction_inout) ||
		      (direction == nl_direction_unknown))) ) {
      ui_cmd_append_object_list (interp, result, (nl_object) port, design_path);
    }
  } nl_end_for;

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}



struct ui_cmd_find_iobject_data {
  Tcl_Interp *interp;
  ar path;
  nl_kind kind;
  ui_find_mode mode;
  ar result;
  int status;
};


static
nl_walk_status
ui_cmd_find_iobject_walker (nl_object obj, void *ptr)
{
  nl_idesign idesign = (nl_idesign) obj;
  struct ui_cmd_find_iobject_data *data
    = (struct ui_cmd_find_iobject_data *) ptr;

  int status = ui_find_iobject_path (data->interp, data->path, data->kind,
				     idesign, data->mode, data->result);

  data->status = status;

  if ( status == TCL_OK ) {
    return nl_walk_status_continue;
  }
  else {
    return nl_walk_status_stop;
  }
}  


static
int
ui_cmd_find_iobject_common (Tcl_Interp *interp, int exact, int regexp,
			    int recursive, char *pattern, nl_idesign idesign,
			    nl_kind kind)
{
  char *str;
  ar path = ui_tokenize_hierarchy_path (pattern, &str, ui_hierarchy_separator);
  ui_find_mode mode = ui_find_mode_encode (exact, regexp);
  ar result = ar_alloc (8, sizeof (nl_port));
  struct ui_cmd_find_iobject_data data;
  volatile int status;

  data.interp = interp;
  data.path = path;
  data.kind = kind;
  data.mode = mode;
  data.result = result;

  error_unwind_protect {
    if ( recursive ) {
      nl_walk_idesigns (idesign, 0, ui_cmd_find_iobject_walker, &data);

      status = data.status;
    }
    else {
      status = ui_find_iobject_path (interp, path, kind, idesign, mode,
				     result);
    }
  
    if ( status == TCL_OK ) {
      ui_cmd_object_list_result (interp, result, NULL);
    }
  }
  error_on_exit {
    ar_free (result);
    FREE (str);
    ar_free (path);
  }
  error_end;

  return status;
}  


#(defcommand find_icells
  ("Return the list of cells whose name matches the specified pattern."
   "By default the pattern is matched according to the rules of string_match.")
  (-exact boolean "the cell name should exactly match the pattern")
  (-regexp boolean "the cell name should match the pattern")
  (-recursive boolean "find the pattern anywhere in the hierarchy")
  (pattern string "pattern to match")
  &optional
  (idesign current_idesign "design in which to find the cells"))
{
  int status = ui_cmd_find_iobject_common (interp, exact, regexp, recursive,
					   pattern, idesign, nl_kind_icell);

  return status;
}  



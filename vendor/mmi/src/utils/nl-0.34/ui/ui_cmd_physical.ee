#(defcommand get_def_history
   "Get a list of all the strings in the DEF history for the specified design."
   &optional
   (pdesign current_pdesign "get the DEF history for this design"))
{
  ar history = pnl_design_history (pdesign);

  if ( history != NULL ) {
    Tcl_Obj *result = Tcl_NewListObj (0, NULL);

    ar_for_all (history, char *, str) {
      Tcl_Obj *str_obj = Tcl_NewStringObj (str, -1);

      Tcl_ListObjAppendElement (interp, result, str_obj);
    } ar_end_for;

    Tcl_SetObjResult (interp, result);
  }

  return TCL_OK;
}



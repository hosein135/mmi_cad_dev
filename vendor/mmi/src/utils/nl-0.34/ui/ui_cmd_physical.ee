   "Set the orientation of the specified port."
   (port port "set the orientation of this port")
   (orient string "set the orientation to this (N, S, E, W, FN, FS, FE, or FW)"))
{
  pnl_port pport = ui_cmd_get_pport_for_port (port);
  pnl_orientation orientation = pnl_any_string_to_orientation (orient);


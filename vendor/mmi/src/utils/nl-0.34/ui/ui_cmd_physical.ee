#(defcommand set_net_use
   "Set the DEF USE clause of the specified net."
   (inet inet "set the USE of this net")
   (str string "set the USE clause to this (SIGNAL, POWER, GROUND, CLOCK, "
    "TIEOFF, or ANALOG)"))
{
  pnl_inet pinet = ui_cmd_get_pinet_for_inet (inet);
  pnl_use use = pnl_string_to_use (str);

  if ( use == pnl_use_null ) {
    error ("invalid use value (%s), must be either SIGNAL, POWER, GROUND, "
	   "CLOCK, TIEOFF, or ANALOG", str);
  }
  else {
    pnl_inet_set_use (pinet, use);
  }
    
  return TCL_OK;
}



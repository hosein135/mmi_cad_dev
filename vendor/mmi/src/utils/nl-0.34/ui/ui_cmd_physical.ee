#(defcommand clear_row_sites
   "Remove all the row sites from the specified design."
   &optional
   (pdesign current_pdesign "remove the row sites from this design"))
{
  pnl_design_free_row_sites (pdesign);

  return TCL_OK;
}


#(defcommand add_row_site
   "Add a row site to the specified design."
   (name string "the name of the row")
   (core string "the name of the core site")
   (x0 integer "the x coordinate of the lower left corner of the row")
   (y0 integer "the y coordinate of the lower left corner of the row")
   (orient string "the orientation of the row")
   (count integer "the number of sites in the row")
   (step integer "the width of the sites")
   (height integer "the height of the sites")
   &optional
   (pdesign current_pdesign "add the row site to this design"))
{
  pnl_orientation orientation = pnl_string_to_orientation (orient);

  if ( orientation == pnl_orientation_null ) {
    error ("could not convert %s to an orientation, "
	   "must be either N, S, E, W, FN, FS, FE, or FW.", orient);
  }

  pnl_design_add_row_site (pdesign, name, core, x0, y0, orientation,
			   count, step, height);

  return TCL_OK;
}


#(defcommand list_row_sites 
   ("Return a list of the row sites, each in the following form:"
    "{name core x0 y0 orientation count width height}")
   &optional
   (pdesign current_pdesign "return the row sites for this design"))
{
  Tcl_Obj *result = Tcl_NewListObj (0, NULL);
  ar row_sites = pnl_design_row_sites (pdesign);

  if ( row_sites == NULL ) {
    return TCL_OK;
  }

  ar_for_all (row_sites, pnl_row_site, site) {
    char *name = pnl_row_site_name (site);
    char *core = pnl_row_site_core (site);
    int x0 = pnl_row_site_x0 (site);
    int y0 = pnl_row_site_y0 (site);
    pnl_orientation orientation = pnl_row_site_orientation (site);
    const char *orient_str = pnl_orientation_to_string (orientation);
    int count = pnl_row_site_count (site);
    int step = pnl_row_site_step (site);
    int height = pnl_row_site_height (site);
    Tcl_Obj *name_obj = Tcl_NewStringObj (name, -1);
    Tcl_Obj *core_obj = Tcl_NewStringObj (core, -1);
    Tcl_Obj *x0_obj = Tcl_NewIntObj (x0);
    Tcl_Obj *y0_obj = Tcl_NewIntObj (y0);
    Tcl_Obj *orient_obj = Tcl_NewStringObj ((char *) orient_str, -1);
    Tcl_Obj *count_obj = Tcl_NewIntObj (count);
    Tcl_Obj *step_obj = Tcl_NewIntObj (step);
    Tcl_Obj *height_obj = Tcl_NewIntObj (height);
    Tcl_Obj *objv[8];
    Tcl_Obj *element;

    objv[0] = name_obj;
    objv[1] = core_obj;
    objv[2] = x0_obj;
    objv[3] = y0_obj;
    objv[4] = orient_obj;
    objv[5] = count_obj;
    objv[6] = step_obj;
    objv[7] = height_obj;

    element = Tcl_NewListObj (8, objv);

    Tcl_ListObjAppendElement (interp, result, element);
  } ar_end_for;

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}


#(defcommand get_cell_location
   ("Return the location of the specified cell.  By default this location is"
    "that of the lower-left corner.")
   (-origin boolean "return the location of the origin of the cell (not LL corener)")
   (-grids boolean "return the location in grid units")
   (cell_or_icell cell_or_icell "return the location of this cell"))
{
  pnl_object pobj = ui_cmd_get_pnl_for_cell_or_icell (cell_or_icell);
  pnl_kind pkind = pnl_object_kind (pobj);
  int has_loc;

  if ( pkind == pnl_kind_cell ) {
    has_loc = pnl_cell_has_location ((pnl_cell) pobj);
  }
  else if ( pkind == pnl_kind_icell ) {
    has_loc = pnl_icell_has_location ((pnl_icell) pobj);
  }
  else {
    ASSERT (0);
  }

  if ( has_loc ) {
    int x;
    int y;

    if ( pkind == pnl_kind_cell ) {
      pnl_cell pcell = (pnl_cell) pobj;

      pnl_cell_get_location (pcell, origin, &x, &y);
    }
    else if ( pkind == pnl_kind_icell ) {
      pnl_icell picell = (pnl_icell) pobj;

      pnl_icell_get_location (picell, origin, &x, &y);
    }
    else {
      ASSERT (0);
    }

    if ( grids ) {
      x = ui_convert_to_x_grids (x);
      y = ui_convert_to_y_grids (y);
    }

    {
      Tcl_Obj *x_obj = Tcl_NewIntObj (x);
      Tcl_Obj *y_obj = Tcl_NewIntObj (y);
      Tcl_Obj *xy_obj[2];
      Tcl_Obj *result;

      xy_obj[0] = x_obj;
      xy_obj[1] = y_obj;

      result = Tcl_NewListObj (2, xy_obj);

      Tcl_SetObjResult (interp, result);
    }
  }
  
  return TCL_OK;
}


#(defcommand set_cell_location
   ("Set the location of the specified cell.  By default, this location is"
    "that of the lower-left corner.")
   (-origin boolean "the location is the origin of the cell (not LL corner)")
   (-type string "the type of the location: PLACED (default), FIXED, or COVER.")
   (-grids boolean "set the location in grid units")
   (cell_or_icell cell_or_icell "return the location of this cell")
   (x_coord integer "x coordinate of the location")
   (y_coord integer "y coordinate of the location"))
{
  pnl_object pobj = ui_cmd_get_pnl_for_cell_or_icell (cell_or_icell);
  pnl_loctype loctype;

  if ( type == NULL ) {
    loctype = pnl_loctype_PLACED;
  }
  else {
    loctype = pnl_string_to_loctype (type);

    if ( loctype == pnl_loctype_null || loctype == pnl_loctype_UNPLACED ) {
      error ("%s is not a valid location type.  Should be "
	     "PLACED, FIXED, or COVER.", type);
    }
  }

  if ( grids ) {
    x_coord = ui_convert_from_x_grids (x_coord);
    y_coord = ui_convert_from_y_grids (y_coord);
  }

  if ( pnl_object_kind (pobj) == pnl_kind_cell ) {
    pnl_cell pcell = (pnl_cell) pobj;

    pnl_cell_set_location (pcell, origin, x_coord, y_coord);
    pnl_cell_set_loctype (pcell, loctype);
  }
  else if ( pnl_object_kind (pobj) == pnl_kind_icell ) {
    pnl_icell picell = (pnl_icell) pobj;

    pnl_icell_set_location (picell, origin, x_coord, y_coord);
    pnl_icell_set_loctype (picell, loctype);
  }

  return TCL_OK;
}


#(defcommand get_pin_location
   "Return the location of the specified pin."
   (-grids boolean "return the location in grid units")
   (pin_or_ipin pin_or_ipin "get the location of this pin"))
{
  nl_kind kind = nl_object_kind (pin_or_ipin);
  nl_object owner;
  int x;
  int y;
  nl_kind owner_kind;
  nl_pin pin;

  if ( kind == nl_kind_pin ) {
    pin = (nl_pin) pin_or_ipin;

    owner = (nl_object) nl_pin_owner (pin);
  }
  else if ( kind == nl_kind_ipin ) {
    nl_ipin ipin = (nl_ipin) pin_or_ipin;

    pin = nl_ipin_pin (ipin);
    owner = (nl_object) nl_ipin_owner (ipin);

    if ( nl_object_kind (owner) == nl_kind_iport ) {
      nl_iport iport = (nl_iport) owner;

      owner = (nl_object) nl_iport_port (iport);
    }
  }
  else {
    ASSERT (0);
  }

  owner_kind = nl_object_kind (owner);

  if ( owner_kind == nl_kind_port ) {
    nl_port port = (nl_port) owner;
    pnl_port pport = ui_cmd_get_pport_for_port (port);

    pnl_port_get_location (pport, &x, &y);
  }
  else if ( owner_kind == nl_kind_cell || owner_kind == nl_kind_icell ) {
    pnl_object powner = ui_cmd_get_pnl_for_cell_or_icell (owner);
    pnl_kind powner_kind = pnl_object_kind (powner);

    if ( powner_kind == pnl_kind_icell ) {
      pnl_icell picell = (pnl_icell) powner;
      
      pnl_icell_get_pin_location (picell, pin, &x, &y);
    }
    else if ( powner_kind == pnl_kind_cell ) {
      nl_pin pin = (nl_pin) pin_or_ipin;
      pnl_cell pcell = (pnl_cell) powner;
      
      pnl_cell_get_pin_location (pcell, pin, &x, &y);
    }
    else {
      ASSERT (0);
    }
  }
  else {
    ASSERT (0);
  }

  if ( grids ) {
    x = ui_convert_to_x_grids (x);
    y = ui_convert_to_y_grids (y);
  }

  {
    Tcl_Obj *x_obj = Tcl_NewIntObj (x);
    Tcl_Obj *y_obj = Tcl_NewIntObj (y);
    Tcl_Obj *objv[2];
    Tcl_Obj *result;

    objv[0] = x_obj;
    objv[1] = y_obj;

    result = Tcl_NewListObj (2, objv);

    Tcl_SetObjResult (interp, result);

    return TCL_OK;
  }
}


#(defcommand get_port_location
   "Return the location of the specified port."
   (-grids boolean "return the location in grid units")
   (port port "return the location of this port"))
{
  pnl_port pport = ui_cmd_get_pport_for_port (port);
  pnl_loctype loctype = pnl_port_loctype (pport);

  if ( loctype == pnl_loctype_null || loctype == pnl_loctype_UNPLACED ) {
    return TCL_OK;
  }
  else {
    int x;
    int y;

    pnl_port_get_location (pport, &x, &y);

    if ( grids ) {
      x = ui_convert_to_x_grids (x);
      y = ui_convert_to_y_grids (y);
    }

    {
      Tcl_Obj *x_obj = Tcl_NewIntObj (x);
      Tcl_Obj *y_obj = Tcl_NewIntObj (y);
      Tcl_Obj *xy_obj[2];
      Tcl_Obj *result;

      xy_obj[0] = x_obj;
      xy_obj[1] = y_obj;
      result = Tcl_NewListObj (2, xy_obj);

      Tcl_SetObjResult (interp, result);

      return TCL_OK;
    }
  }
}


#(defcommand set_port_location
   "Return the location of the specified port."
   (-fixed boolean "mark the location as FIXED (otherwise it is PLACED)")
   (-grids boolean "set the location in grid units")
   (port port "set the location of this port")
   (x_coord integer "x coordinate of the location")
   (y_coord integer "y coordinate of the location"))
{
  pnl_port pport = ui_cmd_get_pport_for_port (port);


  if ( grids ) {
    x_coord = ui_convert_from_x_grids (x_coord);
    y_coord = ui_convert_from_y_grids (y_coord);
  }
  
  pnl_port_set_location (pport, x_coord, y_coord);

  if ( fixed ) {
    pnl_port_set_loctype (pport, pnl_loctype_FIXED);
  }
  else {
    pnl_port_set_loctype (pport, pnl_loctype_PLACED);
  }

  Tcl_SetResult (interp, "", TCL_STATIC);

  return TCL_OK;
}


#(defcommand get_port_geometry
   "Return the geometry of the specified port as a list: {layer x0 y0 x1 y1}"
   (port port "get the geometry of this port"))
{
  pnl_port pport = ui_cmd_get_pport_for_port (port);
  char *layer;
  int x0;
  int y0;
  int x1;
  int y1;
  int flag = pnl_port_get_geometry (pport, &layer, &x0, &y0, &x1, &y1);
  Tcl_Obj *result;

  if ( flag ) {
    Tcl_Obj *objv1[2];
    Tcl_Obj *objv2[4];

    objv2[0] = Tcl_NewIntObj (x0);
    objv2[1] = Tcl_NewIntObj (y0);
    objv2[2] = Tcl_NewIntObj (x1);
    objv2[3] = Tcl_NewIntObj (y1);

    objv1[0] = Tcl_NewStringObj (layer, -1);
    objv1[1] = Tcl_NewListObj (4, objv2);

    result = Tcl_NewListObj (2, objv1);
  }
  else {
    result = Tcl_NewListObj (0, NULL);
  }

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}


#(defcommand set_port_geometry
   "Set the geometry of the specified port as a list."
   (port port "set the geometry of this port")
   (layer string "the layer of the port")
   (list integer_list "a list of the form {x0, y0, x1, y1}"))
{
  pnl_port pport = ui_cmd_get_pport_for_port (port);
  int size = ar_size (list);

  if ( size == 0 ) {
    pnl_port_clear_geometry (pport);
  }
  else if ( size == 4 ) {
    int x0 = AR_REF (list, int, 0);
    int y0 = AR_REF (list, int, 1);
    int x1 = AR_REF (list, int, 2);
    int y1 = AR_REF (list, int, 3);

    pnl_port_set_geometry (pport, layer, x0, y0, x1, y1);
  }
  else {
    error ("list argument has %d element%s, it should have either "
	   "zero or four elements.", size, (size == 1) ? "" : "s");
  }

  return TCL_OK;
}


#(defcommand get_cell_orientation
   "Return the orientation (in DEF format) of the specified cell."
   (-max boolean "return the orientation in MAX format")
   (-sue boolean "return the orientation in SUE format")
   (cell_or_icell cell_or_icell "get the orientation of this cell"))
{
  pnl_object pobj = ui_cmd_get_pnl_for_cell_or_icell (cell_or_icell);
  pnl_kind pkind = pnl_object_kind (pobj);
  pnl_orientation orient;
  const char *result;

  if ( sue && max ) {
    error ("only one of -sue and -max may be specified");
  }

  if ( pkind == pnl_kind_cell ) {
    orient = pnl_cell_orientation ((pnl_cell) pobj);
  }
  else if ( pkind == pnl_kind_icell ) {
    orient = pnl_icell_orientation ((pnl_icell) pobj);
  }
  else {
    ASSERT (0);
  }

  if ( max )
    result = pnl_orientation_to_max_string (orient);
  else if ( sue )
    result = pnl_orientation_to_sue_string (orient);
  else 
    result = pnl_orientation_to_string (orient);

  Tcl_SetResult (interp, (char *) result, TCL_STATIC);

  return TCL_OK;
}


#(defcommand get_port_orientation
   "Return the orientation (in DEF format) of the specified port."
   (-max boolean "return the orientation in MAX format")
   (-sue boolean "return the orientation in SUE format")
   (port port "get the orientation of this port"))
{
  pnl_port pport = ui_cmd_get_pport_for_port (port);
  pnl_orientation orient = pnl_port_orientation (pport);
  const char *result;

  if ( sue && max ) {
    error ("only one of -sue and -max may be specified");
  }

  if ( max )
    result = pnl_orientation_to_max_string (orient);
  else if ( sue )
    result = pnl_orientation_to_sue_string (orient);
  else 
    result = pnl_orientation_to_string (orient);

  Tcl_SetResult (interp, (char *) result, TCL_STATIC);

  return TCL_OK;
}


#(defcommand set_cell_orientation
   "Set the orientation of the specified cell."
   (cell_or_icell cell_or_icell "set the orientation of this cell")
   (orient string "set the orientation to this (N, S, E, W, FN, FS, FE, or FW)"))
{
  pnl_object pobj = ui_cmd_get_pnl_for_cell_or_icell (cell_or_icell);
  pnl_orientation orientation = pnl_any_string_to_orientation (orient);

  if ( orientation == pnl_orientation_null ) {
    error ("invalid orientation (%s), must be either "
	   "N, S, E, W, FN, FS, FE, or FW", orient);
  }
  else {
    pnl_kind pkind = pnl_object_kind (pobj);

    if ( pkind == pnl_kind_cell ) {
      pnl_cell_set_orientation ((pnl_cell) pobj, orientation);
    }
    else if ( pkind == pnl_kind_icell ) {
      pnl_icell_set_orientation ((pnl_icell) pobj, orientation);
    }
    else {
      ASSERT (0);
    }
  }
    
  return TCL_OK;
}



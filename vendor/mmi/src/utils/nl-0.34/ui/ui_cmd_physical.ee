/* -*-C-*- */

#(progn
  (setq embedded-elisp-output-file
	(concat (file-name-sans-extension embedded-elisp-source-file) ".c"))
  (load (expand-file-name "ui_cmd.el") nil t)
  (warning-message))

#include "port.h"
#include "error.h"
#include "mem.h"
#include "ar.h"
#include "hashtab.h"
#include "str.h"
#include "skip-list.h"
#include "nl.h"
#include "pnl.h"
#include "tcl.h"
#include "tsp.h"
#include "pl.h"
#include "ui.h"
#include "ui_int.h"
     

int ui_x_grid_size;
int ui_y_grid_size;


static
int
ui_convert_to_x_grids (int x)
{
  if ( x < 0 ) {
    return (x - (ui_x_grid_size + 1) / 2 + 1) / ui_x_grid_size;
  }
  else {
    return (x + ui_x_grid_size / 2) / ui_x_grid_size;
  }
}
     

static
int
ui_convert_to_y_grids (int y)
{
  if ( y < 0 ) {
    return (y - (ui_y_grid_size + 1) / 2 + 1) / ui_y_grid_size;
  }
  else {
    return (y + ui_y_grid_size / 2) / ui_y_grid_size;
  }
}
     

static
int
ui_convert_from_x_grids (int x)
{
  return x * ui_x_grid_size;
}
     

static
int
ui_convert_from_y_grids (int y)
{
  return y * ui_y_grid_size;
}
     

static
pnl_design
ui_cmd_get_pdesign_for_design (nl_design design)
{
  pnl_design pdesign = NULL;

  nl_design_attr_get_by_name ("pnl design", design, &pdesign);

  if ( pdesign == NULL ) {
    error ("Design %s does not have any physical information.",
	   nl_design_name (design));
  }

  return pdesign;
}


static
pnl_idesign
ui_cmd_get_pidesign_or_null (nl_design design)
{
  int num_idesigns = nl_design_num_idesigns (design);

  if ( num_idesigns == 0 ) {
    return NULL;
  }
  else {
    nl_dll_head idesign_head = nl_design_idesigns (design);
    nl_idesign idesign = (nl_idesign) nl_dll_gen_first (idesign_head);
    pnl_idesign pidesign = NULL;

    ASSERT (idesign != NULL);

    nl_idesign_attr_get_by_name ("pnl idesign", idesign, &pidesign);

    return pidesign;
  }
}


static
pnl_icell
ui_cmd_get_picell_for_icell (nl_icell icell)
{
  pnl_idesign pidesign = NULL;
  nl_idesign idesign = nl_icell_idesign (icell);

  nl_idesign_attr_get_by_name ("pnl idesign", idesign, &pidesign);

  if ( pidesign == NULL ) {
    error ("Cell %s does not have any physical information.",
	   nl_icell_name (icell));
  }
  else {
    pnl_icell picell = pnl_idesign_get_icell (pidesign, icell);

    return picell;
  }
}


static pnl_cell ui_cmd_get_pcell_for_cell (nl_cell) UNUSED;

static
pnl_cell
ui_cmd_get_pcell_for_cell (nl_cell cell)
{
  pnl_design pdesign = NULL;
  nl_design design = nl_cell_design (cell);

  nl_design_attr_get_by_name ("pnl design", design, &pdesign);

  if ( pdesign == NULL ) {
    error ("Cell %s does not have any physical information.",
	   nl_cell_name (cell));
  }
  else {
    pnl_cell pcell = pnl_design_get_cell (pdesign, cell);

    return pcell;
  }
}


static
pnl_object
ui_cmd_get_pnl_for_cell_or_icell (nl_object cell_or_icell)
{
  nl_kind kind = nl_object_kind (cell_or_icell);
  pnl_object result;

  if ( kind == nl_kind_icell ) {
    nl_icell icell = (nl_icell) cell_or_icell;

    result = (pnl_object) ui_cmd_get_picell_for_icell (icell);
  }
  else if ( kind == nl_kind_cell ) {
    nl_cell cell = (nl_cell) cell_or_icell;
    nl_design design = nl_cell_design (cell);
    pnl_idesign pidesign = ui_cmd_get_pidesign_or_null (design);

    if ( pidesign == NULL ) {
      pnl_design pdesign = ui_cmd_get_pdesign_for_design (design);

      result = (pnl_object) pnl_design_get_cell (pdesign, cell);
    }
    else {
      nl_idesign idesign = pnl_idesign_nl_rep (pidesign);
      nl_icell icell = nl_idesign_get_icell (idesign, cell);

      result = (pnl_object) pnl_idesign_get_icell (pidesign, icell);
    }
  }
  else {
    ASSERT (0);
  }

  return result;
}


static
pnl_inet
ui_cmd_get_pinet_for_inet (nl_inet inet)
{
  pnl_idesign pidesign = NULL;
  nl_idesign idesign = nl_inet_idesign (inet);

  nl_idesign_attr_get_by_name ("pnl idesign", idesign, &pidesign);

  if ( pidesign == NULL ) {
    error ("Net %s does not have any physical information.",
	   nl_inet_name (inet));
  }
  else {
    pnl_inet pinet = pnl_idesign_get_inet (pidesign, inet);

    return pinet;
  }
}


static
pnl_port
ui_cmd_get_pport_for_port (nl_port port)
{
  pnl_design pdesign = NULL;
  nl_design design = nl_port_design (port);

  nl_design_attr_get_by_name ("pnl design", design, &pdesign);

  if ( pdesign == NULL ) {
    error ("Port %s does not have any physical information.",
	   nl_port_name (port));
  }
  else {
    pnl_port pport = pnl_design_get_port (pdesign, port);

    return pport;
  }
}


static
pnl_libcell
ui_cmd_get_plibcell_for_libcell (nl_libcell libcell)
{
  nl_library library = nl_libcell_library (libcell);
  pnl_library plibrary;
  pnl_libcell plibcell;

  nl_library_attr_get_by_name ("pnl library", library, &plibrary);

  if ( plibrary == NULL ) {
    error ("library %s does not contain any physical information",
	   nl_library_name (library));
  }
  
  plibcell = pnl_library_get_libcell (plibrary, libcell);

  return plibcell;
}


static
pnl_libpin
ui_cmd_get_plibpin_for_libpin (nl_libpin libpin)
{
  nl_libcell libcell = nl_libpin_libcell (libpin);
  nl_library library = nl_libcell_library (libcell);
  pnl_library plibrary;
  pnl_libpin plibpin;

  nl_library_attr_get_by_name ("pnl library", library, &plibrary);

  if ( plibrary == NULL ) {
    error ("library %s does not contain any physical information",
	   nl_library_name (library));
  }
  
  plibpin = pnl_library_get_libpin (plibrary, libpin);

  return plibpin;
}


#(defcommand create_pdesign
   "Create a pdesign based on the specified design."
   (-nohierarchy boolean "do not create a hierarchical pdesign")
   &optional
   (design current_design "top level design of the pdesign"))
{
  pnl_design pdesign = NULL;

  nl_design_attr_get_by_name ("pnl design", design, &pdesign);

  if ( pdesign == NULL ) {
    pnl_design_create (design);
  }

  if ( !nohierarchy ) {
    nl_idesign idesign = nl_idesign_get_or_create (design, NULL);

    if ( idesign == NULL ) {
      error ("an idesign for %s could not be created.",
	     nl_design_name (design));
    }

    pnl_idesign_fill (idesign);
  }

  return TCL_OK;
}


#(defcommand update_cell_locations
   "Update the flat cell locations based on hierarchical cell locations."
   &optional
   (design current_design "top level design of the pdesign"))
{
  pnl_idesign pidesign = NULL;
  nl_idesign idesign = nl_idesign_get_or_create (design, NULL);

  nl_idesign_attr_get_by_name ("pnl idesign", idesign, &pidesign);

  if ( pidesign == NULL ) {
    pidesign = pnl_idesign_create (idesign);
  }

  pnl_idesign_update_locations (idesign, 0, 0, pnl_orientation_N,
				pnl_loctype_null);

  return TCL_OK;
}


#(defcommand create_plibrary
   "Create a physical library (plibrary) based on the specified library."
   (library library "create a plibrary for this library"))
{
  pnl_library_create (library);

  return TCL_OK;
}


#(defcommand get_die_area
   "Return the die area, xmin, ymin, xmax, and ymax, as a list."
   (-grids boolean "return the result in grid units")
   &optional
   (pdesign current_pdesign "return the die area of this design"))
{
  int x0;
  int y0;
  int x1;
  int y1;
  Tcl_Obj *result;
  int flag = pnl_design_get_die_area (pdesign, &x0, &y0, &x1, &y1);

  if ( grids ) {
    x0 = ui_convert_to_x_grids (x0);
    y0 = ui_convert_to_y_grids (y0);
    x1 = ui_convert_to_x_grids (x1);
    y1 = ui_convert_to_y_grids (y1);
  }

  if ( flag ) {
    Tcl_Obj *objv[4];

    objv[0] = Tcl_NewIntObj (x0);
    objv[1] = Tcl_NewIntObj (y0);
    objv[2] = Tcl_NewIntObj (x1);
    objv[3] = Tcl_NewIntObj (y1);

    result = Tcl_NewListObj (4, objv);
  }
  else {
    result = Tcl_NewListObj (0, NULL);
  }

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}


#(defcommand set_die_area
    "Set the die area to the specified values."
    (-grids boolean "set the die area in grid units")
    (list integer_list "a list of the form {xmin, ymin, xmax, ymax} or {}")
    &optional
    (pdesign current_pdesign "return the die area of this design"))
{
  int size = ar_size (list);

  if ( pdesign == NULL ) {
    error ("there is no pdesign for the specified design (or current design)");
  }

  if ( size == 0 ) {
    pnl_design_clear_die_area (pdesign);
  }
  else if ( size == 4 ) {
    int x0 = AR_REF (list, int, 0);
    int y0 = AR_REF (list, int, 1);
    int x1 = AR_REF (list, int, 2);
    int y1 = AR_REF (list, int, 3);

    if ( grids ) {
      x0 = ui_convert_from_x_grids (x0);
      y0 = ui_convert_from_y_grids (y0);
      x1 = ui_convert_from_x_grids (x1);
      y1 = ui_convert_from_y_grids (y1);
    }

    pnl_design_set_die_area (pdesign, x0, y0, x1, y1);
  }
  else {
    error ("list argument has %d element%s, it should have either "
	   "zero or four elements.", size, (size == 1) ? "" : "s");
  }
  
  return TCL_OK;
}


#(defcommand set_distance_units
   "Set the DEF distance units for the current design."
   (unit_name string "name of the distance unit (e.g. MICRONS)")
   (number integer "number of design units in the distance unit")
   &optional
   (pdesign current_pdesign "set the distance units for this design"))
{
  pnl_design_set_distance_units (pdesign, unit_name, number);

  return TCL_OK;
}


#(defcommand get_distance_units
   "Get the distance units for the current design as a list: {unit_name number}"
   &optional
   (pdesign current_pdesign "get the distance units for this design"))
{
  char *str;
  int number;

  pnl_design_get_distance_units (pdesign, &str, &number);

  if ( str != NULL ) {
    Tcl_Obj *str_obj = Tcl_NewStringObj (str, -1);
    Tcl_Obj *num_obj = Tcl_NewIntObj (number);
    Tcl_Obj *objv[2];
    Tcl_Obj *result;

    objv[0] = str_obj;
    objv[1] = num_obj;

    result = Tcl_NewListObj (2, objv);

    Tcl_SetObjResult (interp, result);
  }

  return TCL_OK;
}


static
Tcl_Obj *
ui_cmd_tracks_obj (Tcl_Interp *interp, pnl_tracks tracks)
{
  int start = pnl_tracks_start (tracks);
  int count = pnl_tracks_count (tracks);
  int step = pnl_tracks_step (tracks);
  ar layers = pnl_tracks_layers (tracks);
  Tcl_Obj *start_obj = Tcl_NewIntObj (start);
  Tcl_Obj *count_obj = Tcl_NewIntObj (count);
  Tcl_Obj *step_obj = Tcl_NewIntObj (step);
  Tcl_Obj *layers_obj = Tcl_NewListObj (0, NULL);

  ar_for_all_indexed (layers, char *, layer_name, index) {
    Tcl_Obj *elt = Tcl_NewStringObj (layer_name, -1);

    Tcl_ListObjAppendElement (interp, layers_obj, elt);
  } ar_end_for;

  {
    Tcl_Obj *objv[4];
    Tcl_Obj *result;

    objv[0] = start_obj;
    objv[1] = count_obj;
    objv[2] = step_obj;
    objv[3] = layers_obj;

    result = Tcl_NewListObj (4, objv);

    return result;
  }
}


#(defcommand get_x_tracks
    "Return the X tracks as a list: start, number, step, and layers."
    &optional
    (pdesign current_pdesign "return the X tracks of this design"))
{
  Tcl_Obj *result = Tcl_NewListObj (0, NULL);

  pnl_design_for_all_x_tracks (pdesign, tracks) {
    Tcl_Obj *tracks_obj = ui_cmd_tracks_obj (interp, tracks);

    Tcl_ListObjAppendElement (interp, result, tracks_obj);
  } pnl_end_for;

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}


#(defcommand get_y_tracks
    "Return the Y tracks as a list: start, number, step, and layers."
    &optional
    (pdesign current_pdesign "return the Y tracks of this design"))
{
  Tcl_Obj *result = Tcl_NewListObj (0, NULL);

  pnl_design_for_all_y_tracks (pdesign, tracks) {
    Tcl_Obj *tracks_obj = ui_cmd_tracks_obj (interp, tracks);

    Tcl_ListObjAppendElement (interp, result, tracks_obj);
  } pnl_end_for;

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}


#(defcommand add_x_tracks
   "Set the X tracks of the specified design."
   (start integer "starting coordinate of the tracks")
   (number integer "the number of tracks")
   (step integer "the track separation")
   (layers string_list "the layers involved")
   &optional
   (pdesign current_pdesign "set the X tracks for this design"))
{
  pnl_design_add_x_tracks (pdesign, start, number, step, layers);

  return TCL_OK;
}


#(defcommand clear_x_tracks 
   "Remove all X tracks from the specified design."
   &optional
   (pdesign current_pdesign "clear the X tracks of this design"))
{

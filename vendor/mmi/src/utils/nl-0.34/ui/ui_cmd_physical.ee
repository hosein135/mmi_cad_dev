static
int
ui_cmd_picell_distance (void *ptr1, void *ptr2)
{
  pnl_icell picell1 = (pnl_icell) ptr1;
  pnl_icell picell2 = (pnl_icell) ptr2;
  int x1, y1;
  int x2, y2;

  pnl_icell_get_location (picell1, 0, &x1, &y1);
  pnl_icell_get_location (picell2, 0, &x2, &y2);

  return abs (x1 - x2) + abs (y1 - y2);
}

  
static
int
ui_cmd_picell_distance_sq (void *ptr1, void *ptr2)
{
  pnl_icell picell1 = (pnl_icell) ptr1;
  pnl_icell picell2 = (pnl_icell) ptr2;
  int x1, y1;
  int x2, y2;

  pnl_icell_get_location (picell1, 0, &x1, &y1);
  pnl_icell_get_location (picell2, 0, &x2, &y2);

  {
    float dx = abs (x1 - x2) / 1000.0;
    float dy = abs (y1 - y2) / 1000.0;
    float cost = (dx + dy) * (dx + dy);
    int icost = cost;

    ASSERT (icost >= 0);

    return icost;
  }
}

  
#(defcommand order_scan_chain
   ("Return a list of the specified cells that are ordered so as to"
    "minimize a scan chain running through them.")
   (-limit integer "limit on the nuber of TSP solver iterations")
   (-silent boolean "don't print status messages as the chain is being optimized")
   (-sumsq boolean "minimize the sum-of-squares rather than the linear sum")
   (icells icell_list "list of cells to order"))
{
  int size = ar_size (icells);
  ar tour = ar_alloc (size, sizeof (pnl_icell));
  tsp_problem prob = tsp_problem_create (sumsq ? ui_cmd_picell_distance_sq : ui_cmd_picell_distance);
  int cost;

  ar_for_all (icells, nl_icell, icell) {
    pnl_icell picell = ui_cmd_get_picell_for_icell (icell);

    tsp_problem_add_point (prob, (void *) picell);
  } ar_end_for;

  cost = tsp_solve (prob, limit, silent, tour);

  tsp_problem_free (prob);

  ar_for_all (tour, pnl_icell, picell) {
    nl_icell icell = pnl_icell_nl_rep (picell);
    
    ui_cmd_append_result_walker ((nl_object) icell, (void *) interp);
  } ar_end_for;

  ar_free (tour);

  return TCL_OK;
}


#(defcommand place_design
  "Place the specified design."
  (-randomly boolean "place the cells randomly")
  (-wire_weight double "weight for wire length objective")
  (-overlap_weight double "weight for overlap objective")
  (-boundary_weight double "weight for boundary objective")
  (-row_weight double "weight for row objective")
  (-distribution_weight double "weight for distribution objective")
  (-constant_weight double "weight for constant force objective")
  (-iterations integer "iteration limit")
  (-displacement_limit double "displacement limit for terminating optimizer")
  (-cell_bloat double "cell bloat factor (1.0 == no cell bloat)")
  &optional
  (pdesign current_pdesign "place this design"))
{
  if ( wire_weight == 0.0 &&
       overlap_weight == 0.0 &&
       boundary_weight == 0.0 &&
       row_weight == 0.0 &&
       distribution_weight == 0.0 &&
       constant_weight == 0.0 ) {
    wire_weight = 1.0;
    overlap_weight = 1.0;
    boundary_weight = 1.0;
    row_weight = 1.0;
    distribution_weight = 1.0;
    constant_weight = 1.0;
  }

  if ( cell_bloat == 0.0 ) {
    cell_bloat = 1.0;
  }

  if ( iterations == 0 ) {
    iterations = 1000;
  }
      
  if ( randomly ) {
    pl_randomize_placement (pdesign);
  }
  else {
    pl_place_design (pdesign, iterations, wire_weight, overlap_weight,
		     boundary_weight, row_weight, distribution_weight,
		     constant_weight, displacement_limit, cell_bloat);
  }

  return TCL_OK;
}


#(defcommand get_cell_overlaps
   ""
  (-brute boolean "use brute force method")
  &optional
  (pdesign current_pdesign "do it for this design"))
{
  ar overlaps = pl_get_overlaps (pdesign, brute);
  Tcl_Obj *pair = NULL;
  Tcl_Obj *result = Tcl_NewListObj (0, NULL);

  ar_for_all_indexed (overlaps, nl_cell, cell, i) {
    Tcl_Obj *obj = ui_obj_create ((nl_object) cell, NULL);
      
    if ( i % 2 == 0 ) {
      pair = Tcl_NewListObj (0, NULL);

      Tcl_ListObjAppendElement (interp, pair, obj);
    }
    else {
      Tcl_ListObjAppendElement (interp, pair, obj);
      Tcl_ListObjAppendElement (interp, result, pair);
      pair = NULL;
    }
  } ar_end_for;

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}


#(defcommand compute_objective_and_gradient
   ""
   (-delta double "compute a numeric gradient and use this as the delta")
   (-wire_weight double "weight for wire length objective")
   (-overlap_weight double "weight for overlap objective")
   (-boundary_weight double "weight for boundary objective")
   (-row_weight double "weight for row objective")
   (-distribution_weight double "weight for distribution objective")
   (-constant_weight double "weight for constant force objective")
   (-cell_bloat double "cell bloat factor (1.0 == no cell bloat)")
   &optional
   (pdesign current_pdesign "do it for this design"))
{
  ar array;

  if ( wire_weight == 0.0 &&
       overlap_weight == 0.0 &&
       boundary_weight == 0.0 &&
       row_weight == 0.0 &&
       distribution_weight == 0.0 &&
       constant_weight == 0.0 ) {
    wire_weight = 1.0;
    overlap_weight = 1.0;
    boundary_weight = 1.0;
    row_weight = 1.0;
    distribution_weight = 1.0;
    constant_weight = 1.0;
  }

  if ( cell_bloat == 0.0 ) {
    cell_bloat = 1.0;
  }
      
  array = pl_compute_objective_and_gradient (pdesign, delta, wire_weight,
					     overlap_weight, boundary_weight,
					     row_weight, distribution_weight,
					     constant_weight, cell_bloat);

  {
    int first = 1;
    Tcl_Obj *result = Tcl_NewListObj (0, NULL);
    Tcl_Obj *grad = Tcl_NewListObj (0, NULL);
    
    ar_for_all (array, double, x) {
      Tcl_Obj *obj = Tcl_NewDoubleObj (x);

      if ( first ) {
	Tcl_ListObjAppendElement (interp, result, obj);
	first = 0;
      }
      else {
	Tcl_ListObjAppendElement (interp, grad, obj);
      }
    } ar_end_for;

    Tcl_ListObjAppendElement (interp, result, grad);

    Tcl_SetObjResult (interp, result);

    return TCL_OK;
  }
}


#(defcommand place_get_index
  "Debugging command."
  (cell cell "get the index of this cell")
  &optional
  (pdesign current_pdesign "do it for this design"))
{
  int result = pl_get_index_of_cell (pdesign, cell);
  Tcl_Obj *result_obj = Tcl_NewIntObj (result);

  Tcl_SetObjResult (interp, result_obj);

  return TCL_OK;
}



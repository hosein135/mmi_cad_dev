#(defcommand get_libcell_size
  "Return the size of the specified libcell."
  (-grids boolean "return the size in grid units")
  (libcell libcell "return the size of this libcell"))
{
  pnl_library plibrary;
  nl_library library = nl_libcell_library (libcell);
  pnl_libcell plibcell;
  
  nl_library_attr_get_by_name ("pnl library", library, &plibrary);

  plibcell = pnl_library_get_libcell (plibrary, libcell);

  if ( plibcell != NULL ) {
    int x = pnl_libcell_sizex (plibcell);
    int y = pnl_libcell_sizey (plibcell);

    if ( grids ) {
      x = ui_convert_to_x_grids (x);
      y = ui_convert_to_y_grids (y);
    }

    {
      Tcl_Obj *x_obj = Tcl_NewIntObj (x);
      Tcl_Obj *y_obj = Tcl_NewIntObj (y);
      Tcl_Obj *objv[2];
      Tcl_Obj *result;

      objv[0] = x_obj;
      objv[1] = y_obj;
      result = Tcl_NewListObj (2, objv);

      Tcl_SetObjResult (interp, result);
    }
  }

  return TCL_OK;
}



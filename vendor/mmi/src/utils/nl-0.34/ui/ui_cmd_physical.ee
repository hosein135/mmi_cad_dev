}


#(defcommand get_net_routes
   "Return a list of all the routes for the specified net."
   (-special boolean "only get special (non-minimum-width) routes")
   (-nonspecial boolean "only get non-special routes")
   (inet inet "get the routes for this net."))
{
  pnl_inet pinet = ui_cmd_get_pinet_for_inet (inet);
  Tcl_Obj *result = Tcl_NewListObj (0, NULL);

  if ( !special && !nonspecial ) {
    special = nonspecial = 1;
  }

  pnl_inet_for_all_routes (pinet, route) {
    Tcl_Obj *route_obj = NULL;
    pnl_routekind routekind = pnl_route_kind (route);
    const char *routekind_str = pnl_routekind_to_string (routekind);
    int first = 1;

    pnl_route_for_all_branches (route, branch) {
      int width = pnl_branch_width (branch);

      if ( (!special && width >= 0) ||
	   (!nonspecial && width < 0) ) {
	continue;
      }
      else {
	Tcl_Obj *branch_obj = Tcl_NewListObj (0, NULL);
	char *layer = pnl_branch_layer (branch);
	Tcl_Obj *layer_obj = Tcl_NewStringObj (layer, -1);
	int x0 = pnl_branch_x0 (branch);
	Tcl_Obj *x0_obj = Tcl_NewIntObj (x0);
	int y0 = pnl_branch_y0 (branch);
	Tcl_Obj *y0_obj = Tcl_NewIntObj (y0);
	Tcl_Obj *width_obj = Tcl_NewIntObj (width);
	Tcl_Obj *xy_objv[3];
	Tcl_Obj *point0_obj;
	
	xy_objv[0] = x0_obj;
	xy_objv[1] = y0_obj;
	xy_objv[2] = width_obj;

	point0_obj = Tcl_NewListObj (3, xy_objv);

	Tcl_ListObjAppendElement (interp, branch_obj, layer_obj);
	Tcl_ListObjAppendElement (interp, branch_obj, point0_obj);

	pnl_branch_for_all_segments (branch, segment) {
	  pnl_segmentkind kind = pnl_segment_kind (segment);

	  switch ( kind ) {
	  case pnl_segmentkind_x: {
	    pnl_x_segment x_seg = (pnl_x_segment) segment;
	    int x = pnl_x_segment_x (x_seg);
	    Tcl_Obj *star_obj = Tcl_NewStringObj ("*", -1);
	    Tcl_Obj *x_obj = Tcl_NewIntObj (x);
	    Tcl_Obj *objv[2];
	    Tcl_Obj *point_obj;

	    objv[0] = x_obj;
	    objv[1] = star_obj;
	    point_obj = Tcl_NewListObj (2, objv);

	    Tcl_ListObjAppendElement (interp, branch_obj, point_obj);
	    
	    break;
	  }

	  case pnl_segmentkind_y: {
	    pnl_y_segment y_seg = (pnl_y_segment) segment;
	    int y = pnl_y_segment_y (y_seg);
	    Tcl_Obj *star_obj = Tcl_NewStringObj ("*", -1);
	    Tcl_Obj *y_obj = Tcl_NewIntObj (y);
	    Tcl_Obj *objv[2];
	    Tcl_Obj *point_obj;

	    objv[0] = star_obj;
	    objv[1] = y_obj;

	    point_obj = Tcl_NewListObj (2, objv);

	    Tcl_ListObjAppendElement (interp, branch_obj, point_obj);

	    break;
	  }

	  case pnl_segmentkind_via: {
	    pnl_via via = (pnl_via) segment;
	    char *via_name = pnl_via_name (via);
	    Tcl_Obj *via_obj = Tcl_NewStringObj (via_name, -1);

	    Tcl_ListObjAppendElement (interp, branch_obj, via_obj);

	    break;
	  }
	  default:
	    error ("internal error: got a funky segmentkind.");
	  }
	} pnl_end_for;

	if ( first ) {
	  route_obj = Tcl_NewListObj (0, NULL);

	  {
	    Tcl_Obj *routekind_obj
	      = Tcl_NewStringObj ((char *) routekind_str, -1);
	    Tcl_ListObjAppendElement (interp, route_obj, routekind_obj);
	  }
	  first = 0;
	}

	ASSERT (route_obj != NULL);

	Tcl_ListObjAppendElement (interp, route_obj, branch_obj);
      }
    } pnl_end_for;

    if ( first == 0 ) {
      Tcl_ListObjAppendElement (interp, result, route_obj);
    }
  } pnl_end_for;

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}


#(defcommand add_net_route
   "Add a route to the specified net.  The default route type is ROUTED."
   (-type string "the type of the route: ROUTED (default), FIXED, or COVER.")
   (inet inet "add the route to this net")
   (list tcl_object "route to add"))
{
  pnl_inet pinet = ui_cmd_get_pinet_for_inet (inet);
  pnl_routekind routekind;

  if ( type == NULL ) {
    routekind = pnl_routekind_ROUTED;
  }
  else {
    routekind = pnl_string_to_routekind (type);

    if ( routekind == pnl_routekind_null ) {
      error ("%s is not a valid route type.  Should be "
	     "ROUTED, FIXED, or COVER.", type);
    }
  }

  {
    volatile pnl_route route = pnl_route_create (routekind);
    volatile pnl_branch branch = NULL;
    volatile pnl_segment segment = NULL;

    error_unwind_protect {
      int list_len;
      Tcl_Obj **list_elts;
      int status = Tcl_ListObjGetElements (interp, list,
					   &list_len, &list_elts);

      if ( status != TCL_OK ) {
	error ("cannot convert second argument to a list.");
      }
      else {
	int i;

	for ( i = 0; i < list_len; i++ ) {
	  Tcl_Obj *branch_obj = list_elts[i];
	  int branch_len;
	  Tcl_Obj **branch_elts;

	  status = Tcl_ListObjGetElements (interp, branch_obj,
					   &branch_len, &branch_elts);

	  if ( status != TCL_OK ) {
	    error ("cannot convert the %dth element of the "
		   "second argument to a list.", i);
	  }
	  else {
	    Tcl_Obj *layer_obj = branch_elts[0];
	    Tcl_Obj *first_pt = branch_elts[1];
	    char *layer = Tcl_GetStringFromObj (layer_obj, NULL);
	    int x0;
	    int y0;
	    int j;

	    {
	      int pt_len;
	      Tcl_Obj **pt_elts;

	      status = Tcl_ListObjGetElements (interp, first_pt,
					       &pt_len, &pt_elts);

	      if ( status != TCL_OK ) {
		error ("could not convert the first point of the %dth branch "
		       "to a list.", i);
	      }

	      status = Tcl_GetIntFromObj (interp, pt_elts[0], &x0);

	      if ( status != TCL_OK ) {
		error ("could not convert the x coord of the first point "
		       "of the %dth branch to a list.", i);
	      }

	      status = Tcl_GetIntFromObj (interp, pt_elts[1], &y0);

	      if ( status != TCL_OK ) {
		error ("could not convert the y coord of the first point "
		       "of the %dth branch to a list.", i);
	      }
	    }

	    branch = pnl_branch_create (layer, x0, y0, -1);

	    for ( j = 2; j < branch_len; j++ ) {
	      Tcl_Obj *seg_obj = branch_elts[j];
	      int seg_len;
	      Tcl_Obj **seg_elts;
	      int status = Tcl_ListObjGetElements (interp, seg_obj,
						   &seg_len, &seg_elts);
	      pnl_segment segment;

	      if ( status != TCL_OK ) {
		error ("could not convert the %dth element of the %dth "
		       "element of the second arg to a list.", j, i);
	      }

	      if ( seg_len == 1 ) {
		/* Must be a via. */
		char *via_name = Tcl_GetStringFromObj (seg_elts[0], NULL);
		segment = pnl_segment_create_via (via_name);
	      }
	      else if ( seg_len == 2 ) {
		/* Must be a point. */
		char *x_str = Tcl_GetStringFromObj (seg_elts[0], NULL);
		char *y_str = Tcl_GetStringFromObj (seg_elts[1], NULL);

		if ( strcmp (x_str, "*") == 0 &&
		     strcmp (y_str, "*") != 0 ) {
		  int y;
		  status = Tcl_GetIntFromObj (interp, seg_elts[1], &y);

		  if ( status != TCL_OK ) {
		    error ("cannot convert the second elt of the %dth segment "
			   "of the %dth branch to an integer.", j, i);
		  }

		  segment = pnl_segment_create_y_segment (y);
		}
		else if ( strcmp (x_str, "*") != 0 &&
			  strcmp (y_str, "*") == 0 ) {
		  int x;
		  status = Tcl_GetIntFromObj (interp, seg_elts[0], &x);

		  if ( status != TCL_OK ) {
		    error ("cannot convert the first elt of the %dth segment "
			   "of the %dth branch to an integer.", j, i);
		  }

		  segment = pnl_segment_create_x_segment (x);
		}
		else {
		  char *str = Tcl_GetStringFromObj (seg_obj, NULL);
		  error ("segment point must have exactly one star (*), "
			 "not this -> \"%s\"", str);
		}
	      }
	      else {
		error ("the %dth segment of the %dth branch is no good.",
		       j-2, i);
	      }

	      pnl_branch_add_segment (branch, segment);
	      segment = NULL;
	    }
	  }

	  pnl_route_add_branch (route, branch);
	  branch = NULL;
	}
      }
    }
    error_on_error {
      pnl_route_free (route);

      if ( branch != NULL ) {
	pnl_branch_free (branch);
      }

      if ( segment != NULL ) {
	pnl_segment_free (segment);
      }
    }
    error_end;

    pnl_inet_add_route (pinet, route);

    return TCL_OK;
  }
}


#(defcommand set_port_use
   "Set the DEF USE clause of the specified port."
   (port port "set the USE of this port")
   (str string "set the USE clause to this (SIGNAL, POWER, GROUND, CLOCK, "
    "TIEOFF, or ANALOG)"))

static
void
ui_cmd_geometry_list_result (Tcl_Interp *interp, ar geometries)
{
  Tcl_Obj *result_obj = Tcl_NewListObj (0, NULL);

  if ( geometries != NULL ) {
    ar_for_all (geometries, pnl_geometry, geom) {
      pnl_geometryclass class = pnl_geometry_class (geom);
      char *layer = pnl_geometry_name (geom);
      Tcl_Obj *layer_obj = Tcl_NewStringObj (layer, -1);
      Tcl_Obj *objv[1];
      Tcl_Obj *geom_obj;
      ar points = pnl_geometry_points (geom);
      Tcl_Obj *points_obj = NULL;
      int num_points;

      objv[0] = layer_obj;
      geom_obj = Tcl_NewListObj (1, objv);

      if ( class == pnl_geometryclass_layer ) {
	num_points = 0;
      }
      else if ( class == pnl_geometryclass_via ) {
	num_points = 2;
      }
      else {
	ASSERT (0);
      }

      ar_for_all (points, int, elt) {
	if ( num_points == 0 ) {
	  num_points = elt;
	}
	else {
	  Tcl_Obj *xy_obj = Tcl_NewIntObj (elt);

	  if ( points_obj == NULL ) 
	    points_obj = Tcl_NewListObj (0, NULL);

	  Tcl_ListObjAppendElement (interp, points_obj, xy_obj);
	  num_points--;

	  if ( num_points == 0 ) {
	    Tcl_ListObjAppendElement (interp, geom_obj, points_obj);
	    points_obj = NULL;
	  }
	}
      } ar_end_for;

      ASSERT (num_points == 0);

      Tcl_ListObjAppendElement (interp, result_obj, geom_obj);
    } ar_end_for;

    Tcl_SetObjResult (interp, result_obj);
  }
}


#(defcommand get_libcell_obstructions
   "Return the LEF OBS (obstructions) for the specified libcell."
   (libcell libcell "get the obstructions for this libcell"))
{
  pnl_libcell plibcell = ui_cmd_get_plibcell_for_libcell (libcell);
  ar obs = pnl_libcell_obstructions (plibcell);

  ui_cmd_geometry_list_result (interp, obs);

  return TCL_OK;
}


#(defcommand get_libcell_symmetry
   "Return the LEF SYMMETRY for the spefied libcell."
   (libcell libcell "get the symmetry of this libcell"))
{
  pnl_libcell plibcell = ui_cmd_get_plibcell_for_libcell (libcell);
  int x_sym   = pnl_libcell_get_symmetry (plibcell, pnl_symmetry_X);
  int y_sym   = pnl_libcell_get_symmetry (plibcell, pnl_symmetry_Y);
  int r90_sym = pnl_libcell_get_symmetry (plibcell, pnl_symmetry_R90);
  Tcl_Obj *result = Tcl_NewListObj (0, NULL);

  if ( x_sym ) {
    Tcl_Obj *x_obj = Tcl_NewStringObj ("X", -1);
    Tcl_ListObjAppendElement (interp, result, x_obj);
  }
  
  if ( y_sym ) {
    Tcl_Obj *y_obj = Tcl_NewStringObj ("Y", -1);
    Tcl_ListObjAppendElement (interp, result, y_obj);
  }

  if ( r90_sym ) {
    Tcl_Obj *r90_obj = Tcl_NewStringObj ("R90", -1);
    Tcl_ListObjAppendElement (interp, result, r90_obj);
  }

  Tcl_SetObjResult (interp, result);

  return TCL_OK;
}



#(progn "-*-emacs-lisp-*-"

   (setq embedded-elisp-output-file
	 (concat (file-name-sans-extension embedded-elisp-source-file) ".c"))

   (load (expand-file-name "../lisp/nl_rewrite_fns.el") nil t)

   (concat "/" "* DO NOT EDIT THIS FILE *" "/\n"
	   "/" "* This file is generated from "
	   embedded-elisp-source-file ". *" "/"))


#include "stdpccts.h"


#(define-rewrite ref_to_lref :static
   (replace
    (REF =ref)
    [LREF $ref.object]))


#(define-rewrite v2nl_lhs_ref_to_lref :preorder :skip_children
   ((BLOCK_ASSIGN NONBLOCK_ASSIGN)
    * 
    (call-rewrite ref_to_lref)
    &rest))


#(define-rewrite v2nl_rewrite_var_shift
   (or
    (let "int amount;"
      (replace (SHL $lhs $rhs)
	       (if "v2nl_eval_expr ($rhs, &amount)"
		   (SHL $lhs [NUMBER "amount"])
		 (VARSHL $lhs $rhs))))

    (let "int amount;"
      (replace (SHR $lhs $rhs)
	       (if "v2nl_eval_expr ($rhs, &amount)"
		   (SHR $lhs [NUMBER "amount"])
		 (VARSHR $lhs $rhs))))))


#(define-rewrite v2nl_if_to_case
   (replace (IF $test_expr $then_stmt &optional $else_stmt)
	    (CASE (OR_REDUCE $test_expr) (LIST PARALLEL_CASE) 
		  (CASE_ITEM (LIST (BIN 1 [VNUM "1"])) $then_stmt)
		  (if "$else_stmt != NULL"
		      (DEFAULT $else_stmt)))))



(define-node ((bin oct dec hex) width bits))
(define-node (always sens_list body)
(define-node (begin &rest stmt_list))
(define-node ((posedge negedge) arg))
(define-node (if test then &optional else))
(define-node (while test body))
(define-node ((shr shl)) arg count)
(define-node (cond test then else))
(define-node ((bitnot lognot and_reduce nand_reduce or_reduce
		      nor_reduce xor_reduce xnor_reduce)
	      arg))
(define-node ((and or xor xnor andand oror add sub mul div mod gt geq
		   lt leq eq2 eq3 neq neq2)
	      arg1 arg2))
(define-node (concat &rest arg_list))
(define-node (repeat_concat count arg))
(define-node (ref id))
(define-node ((bit varbit) var index))
(define-node (slice var left right))
(define-node (list &rest elements))
(define-node ((block_assign nonblock_assign) rhs lhs &optional delay))

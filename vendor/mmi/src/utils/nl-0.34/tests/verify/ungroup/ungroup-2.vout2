// VERILOG netlist for "m" (generated by nl_shell)


module m (a, y, z);
  input [3:0] a;
  output [3:0] y;
  output z;


  /* inputs: a[3] a[2] a[1] a[0] */
  /* outputs: y[3] y[2] y[1] y[0] */
  /* inouts: */
  always @( a)
      y = ~ a;

  /* inputs: a[2] a[1] a[0] */
  /* outputs: z */
  /* inouts: */
  always @( a[2:0])
      z = & a[2:0];

endmodule

// VERILOG netlist for "m" (generated by nl_shell)


module m (a, z);
  input [0:3] a;
  input [10:7] z;

  wire [2:5] x;
  reg [7:4] \sub/s ;

  wire \sub/r ;

  assign x[5] = a[3];
  assign x[4] = a[2];
  assign x[3] = a[1];
  assign x[2] = a[0];
  assign \sub/r  = a[0];

  /* inputs: sub/r a[0] a[1] a[2] a[3] sub/s[7] sub/s[6] sub/s[5] sub/s[4]
      z[10] z[9] z[8] z[7] */
  /* outputs: sub/s[7] sub/s[6] sub/s[5] sub/s[4] z[10] z[9] z[8] z[7] */
  /* inouts: */
  always @(\sub/r  or  a) begin
    case (\sub/r )
      1'b0:
          \sub/s  = ~ a;
      1'b1:
          \sub/s  =  a;
    endcase
      z =  z ^  \sub/s ;
    end

endmodule

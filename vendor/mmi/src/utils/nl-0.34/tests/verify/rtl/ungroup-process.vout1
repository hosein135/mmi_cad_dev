// VERILOG netlist for "m" (generated by nl_shell)


module sub (p, q);
  input [3:0] p;
  output [1:4] q;
  reg [1:4] q;

  reg [7:4] s;

  wire r;

  assign r = p[3];

  /* inputs: r p[3] p[2] p[1] p[0] s[7] s[6] s[5] s[4] q[1] q[2] q[3] q[4]
      */
  /* outputs: s[7] s[6] s[5] s[4] q[1] q[2] q[3] q[4] */
  /* inouts: */
  always @(r or  p) begin
    case (r)
      1'b0:
          s = ~ p;
      1'b1:
          s =  p;
    endcase
      q =  q ^  s;
    end

endmodule

module m (a, z);
  input [0:3] a;
  input [10:7] z;

  wire [2:5] x;

  assign x[5] = a[3];
  assign x[4] = a[2];
  assign x[3] = a[1];
  assign x[2] = a[0];
  sub sub (.p(a), .q(z));

endmodule

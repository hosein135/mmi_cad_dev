// VERILOG netlist for "m" (generated by nl_shell)


module m (a, b, z);
  input [2:0] a;
  input [3:0] b;
  output [3:0] z;
  reg [3:0] z;


  /* inputs: a[2] a[1] a[0] b[3] b[2] b[1] b[0] */
  /* outputs: z[3] z[2] z[1] z[0] */
  /* inouts: */
  always @( a or b)
    casex ( a)
        3'b00x:
            z =  b + 4'h0;
        3'b01x:
            z =  b + 4'h1;
        3'b1?0:
            z =  b + 4'h2;
        3'b1?1:
            z =  b + 4'h3;
    endcase

endmodule

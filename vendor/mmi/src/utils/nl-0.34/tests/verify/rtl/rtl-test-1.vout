// VERILOG netlist for "m" (generated by nl_shell)


module sub (d, q, clk, r);
  input [3:0] d;
  output [3:0] q;
  reg [3:0] q;
  input clk, r;


  /* inputs: clk r d[3] d[2] d[1] d[0] q[3] q[2] q[1] q[0] */
  /* outputs: q[3] q[2] q[1] q[0] */
  /* inouts: */
  always @(posedge clk)
    case (r) /* synopsys parallel_case */
      1'b1:
          q =  d;
    endcase

endmodule

module m (clk, r, d, q);
  input clk, r;
  input [3:0] d;
  output [3:0] q;

  sub sub (.d(d), .q(q), .clk(clk), .r(r));

endmodule

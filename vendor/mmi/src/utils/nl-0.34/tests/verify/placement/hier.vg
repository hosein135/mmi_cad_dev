module sub1 (a, b, y);
  input [3:0] a, b;
  output [3:0] y;

  MMI_NAND2A u1 (.in0(a[0]), .in1(b[0]), .out(y[0]));
  MMI_NAND2A u2 (.in0(a[1]), .in1(b[1]), .out(y[1]));
  MMI_NAND2A u3 (.in0(a[2]), .in1(b[2]), .out(y[2]));
  MMI_NAND2A u4 (.in0(a[3]), .in1(b[3]), .out(y[3]));

endmodule

module sub2 (a, b, y);
  input [3:0] a, b;
  output [3:0] y;

  MMI_NOR2A u5 (.in0(a[0]), .in1(b[0]), .out(y[0]));
  MMI_NOR2A u6 (.in0(a[1]), .in1(b[1]), .out(y[1]));
  MMI_NOR2A u7 (.in0(a[2]), .in1(b[2]), .out(y[2]));
  MMI_NOR2A u8 (.in0(a[3]), .in1(b[3]), .out(y[3]));

endmodule

module top (a, b, z);
  input [0:23] a, b;
  output [0:23] z;

  sub1 s1 (.a(a[ 0: 3]), .b(b[ 0: 3]), .y(z[ 0: 3]));
  sub1 s2 (.a(a[ 4: 7]), .b(b[ 4: 7]), .y(z[ 4: 7]));
  sub1 s3 (.a(a[ 8:11]), .b(b[ 8:11]), .y(z[ 8:11]));
  sub2 s4 (.a(a[12:15]), .b(b[12:15]), .y(z[12:15]));
  sub2 s5 (.a(a[16:19]), .b(b[16:19]), .y(z[16:19]));
  sub2 s6 (.a(a[20:23]), .b(b[20:23]), .y(z[20:23]));

endmodule

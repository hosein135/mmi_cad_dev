// VERILOG netlist for "nt" (generated by MMI_SUE4.3.0)

module nt_sub (xxx, yyy, zzz);
  output xxx, zzz;
  input yyy;

  MMI_INVB u1 (.in(yyy), .out(yyy));
  MMI_BUFB u2 (.in(xxx), .out(zzz));
endmodule

module nt (ack, xxx, yyy, zzz);
	input		ack;
	input		xxx;
	input		yyy;
	output		zzz;
 
	wire		net_2;
	wire		net_3;
	wire		net_1;
 
	nt_sub nt_sub(.xxx(net_1), .zzz(net_3), .yyy(ack));
	MMI_AND2B MMI_AND2B (.in0(net_2), .in1(net_3), .out(zzz));
	MMI_BUFB MMI_BUFB (.in(xxx), .out(net_1));
	MMI_AND2C MMI_AND2C (.in0(yyy), .in1(net_1), .out(net_2));

endmodule		// nt

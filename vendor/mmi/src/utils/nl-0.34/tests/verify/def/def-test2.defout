HISTORY INPUT VERILOG FILENAME "/homes/jka/psyn/se/mmi25.v def-test2.v" LIB
        "lib" DESIGN "lib.m:hdl" ;


PROPERTYDEFINITIONS
DESIGN  VERILOGDESIGNNAME  STRING  "lib.m:hdl"  ;

END PROPERTYDEFINITIONS
DIEAREA ( 0 0 ) ( 0 0 ) ;


VIAS 4 ;
- VIA12 + RECT M2 ( -280 -280 ) ( 280 280 ) + RECT VIA1 ( -180 -180 )
  ( 180 180 ) + RECT M1 ( -280 -280 ) ( 280 280 ) ;
- VIA23 + RECT M3 ( -280 -280 ) ( 280 280 ) + RECT VIA2 ( -180 -180 )
  ( 180 180 ) + RECT M2 ( -280 -280 ) ( 280 280 ) ;
- VIA34 + RECT M4 ( -280 -280 ) ( 280 280 ) + RECT VIA3 ( -180 -180 )
  ( 180 180 ) + RECT M3 ( -280 -280 ) ( 280 280 ) ;
- VIA45 + RECT M5 ( -270 -270 ) ( 270 270 ) + RECT VIA4 ( -180 -180 )
  ( 180 180 ) + RECT M4 ( -270 -270 ) ( 270 270 ) ;
END VIAS

COMPONENTS 1 ;
- u1 MMI_INVA ;
END COMPONENTS

PINS 4 ;
- gnd! + NET gnd! + DIRECTION INPUT + USE GROUND ;
- vdd! + NET vdd! + DIRECTION INPUT + USE POWER ;
- z + NET z + DIRECTION OUTPUT + USE SIGNAL + LAYER M1 ( -300 0 ) ( 300 600 ) ;
- a + NET a + DIRECTION INPUT + USE SIGNAL + LAYER M1 ( -300 0 ) ( 300 600 ) ;
END PINS

SPECIALNETS 2 ;
- gnd! ( u1 GND ) + USE GROUND ;
- vdd! ( u1 VDD ) + USE POWER ;
END SPECIALNETS

NETS 2 ;
- z ( PIN z ) ( u1 out ) ;
- a ( PIN a ) ( u1 in ) ;
END NETS

END DESIGN

#token SETUP_FALLING		"setup_falling"
#token SETUP_RISING		"setup_rising"
#token SIGNAL_TYPE		"signal_type"
#token SLOPE			"slope"
#token SLOPE_FALL		"slope_fall"
#token SLOPE_RISE		"slope_rise"
#token SLOWER_FACTOR		"slower_factor"
#token TABLE			"table"
#token TABLE_LOOKUP		"table_lookup"
#token TEMPERATURE		"temperature"
#token TIME_UNIT		"time_unit"
#token TIMING			"timing"
#token TIMING_RANGE		"timing_range"
#token TIMING_SENSE		"timing_sense"
#token TIMING_TYPE		"timing_type"
#token TOTAL_OUTPUT_NET_CAPACITANCE "total_output_net_capacitance"
#token TREE_TYPE		"tree_type"
#token LIB_TRUE			"true"
#token UF			"uf"
#token VALUES			"values"
#token VARIABLE_1		"variable_1"
#token VARIABLE_2		"variable_2"
#token VIH			"vih"
#token VIL			"vil"
#token VIMAX			"vimax"
#token VIMIN			"vimin"
#token VOH			"voh"
#token VOL			"vol"
#token VOLTAGE			"voltage"
#token VOLTAGE_UNIT		"voltage_unit"
#token VOMAX			"vomax"
#token VOMIN			"vomin"

#token LIST


#lexclass GET_ID

#token LIB_ID	"~[,\)\"\ \t\n]+"	<< zzmode (START); >>
#token		"[\ \t]+"		<< zzskip (); >>
#token		"\n"			<< zzskip ();
					   zzline++;
					>>
#token		"\""			<< zzmode (GET_STRING); >>


#lexclass LOG_STRING

#token		"[\ \t]+"	<< zzskip (); >>
#token		"\n"		<< zzskip ();
				   zzline++;
				>>
#token		"\""		<< zzskip ();
				   zzmode (LOG_EXPR);
				>>


#lexclass LOG_EXPR

#token		"[\ \t]+"	<< zzskip (); >>
#token		"\n"		<< zzskip ();
				   zzline++;
				>>
#token 		"\""		<< zzskip ();
				   zzmode (START);
				>>

#token LOGID			"[A-Za-z_][A-Za-z0-9_]*"
#token LOGADD			"\+"
#token LOGSUB			"\-"
#token LOGMUL			"\*"
#token LOGDIV			"/"
#token LOGAND			"&"
#token LOGOR			"\|"
#token LOGXOR			"^"
#token LOGNEG			"'"
#token LOGNOT			"!"
#token LOGOPEN			"\("
#token LOGCLOSE			"\)"


#lexclass GET_COMMENT

#token		"~[\*\n]+"	<< zzskip (); >>
#token		"\n"		<< zzskip ();
				   zzline++;
				>>
#token		"\*~[/\n]"	<< zzskip (); >>
#token		"\*[\n]"	<< zzskip ();	
				   zzline++;
				>>
#token		"\*/"		<< zzskip ();
				   zzmode (START);
				>>


#lexclass GET_STRING

#token			"~[\\\"\n]+"	<< zzmore (); >>
#token			"\\~[\n]"	<< zzmore (); >>
#token			"\\\n"		<< zzmore ();
					   zzline++;
					>>
#token			"\n"		<< zzerr (zztext); >>
#token STRING		"\""		<< zzmode (START); >>


#lexclass START

library	: LIBRARY^ identifier
	  "\{"!
	  ( library_statement )*
	  "\}"!
	;

library_statement
	: CAPACITIVE_LOAD_UNIT^ duple semi
	| CELL^ cell
	| COMMENT^ ":"! STRING semi
	| CURRENT_UNIT^ ":"! STRING semi
	| DEFAULT_CELL_LEAKAGE_POWER^ ":"! FLOAT semi
	| DEFAULT_FANOUT_LOAD^ ":"! FLOAT semi
	| DEFAULT_INOUT_PIN_CAP^ ":"! FLOAT semi
	| DEFAULT_INOUT_PIN_FALL_RES^ ":"! FLOAT semi
	| DEFAULT_INOUT_PIN_RISE_RES^ ":"! FLOAT semi
	| DEFAULT_INPUT_PIN_CAP^ ":"! FLOAT semi
	| DEFAULT_INTRINSIC_FALL^ ":"! FLOAT semi
	| DEFAULT_INTRINSIC_RISE^ ":"! FLOAT semi
	| DEFAULT_MAX_CAPACITANCE^ ":"! FLOAT semi
	| DEFAULT_MAX_FANOUT^ ":"! FLOAT semi
	| DEFAULT_MAX_TRANSITION^ ":"! FLOAT semi
	| DEFAULT_OUTPUT_PIN_CAP^ ":"! FLOAT semi
	| DEFAULT_OUTPUT_PIN_FALL_RES^ ":"! FLOAT semi
	| DEFAULT_OUTPUT_PIN_RISE_RES^ ":"! FLOAT semi
	| DEFAULT_SLOPE_FALL^ ":"! FLOAT semi
	| DEFAULT_SLOPE_RISE^ ":"! FLOAT semi
	| DELAY_MODEL^ ":"! ( TABLE_LOOKUP ) semi
	| input_voltage
	| IN_PLACE_SWAP_MODE^ ":"! ( MATCH_FOOTPRINT ) semi
	| K_PROCESS_DRIVE_FALL^ ":"! FLOAT semi
	| K_PROCESS_DRIVE_RISE^ ":"! FLOAT semi
	| K_PROCESS_INTRINSIC_FALL^ ":"! FLOAT semi
	| K_PROCESS_INTRINSIC_RISE^ ":"! FLOAT semi
	| K_PROCESS_PIN_CAP^ ":"! FLOAT semi
	| K_PROCESS_SLOPE_FALL^ ":"! FLOAT semi
	| K_PROCESS_SLOPE_RISE^ ":"! FLOAT semi
	| K_PROCESS_WIRE_CAP^ ":"! FLOAT semi
	| K_PROCESS_WIRE_RES^ ":"! FLOAT semi
	| K_TEMP_DRIVE_FALL^ ":"! FLOAT semi
	| K_TEMP_DRIVE_RISE^ ":"! FLOAT semi
	| K_TEMP_INTRINSIC_FALL^ ":"! FLOAT semi
	| K_TEMP_INTRINSIC_RISE^ ":"! FLOAT semi
	| K_TEMP_PIN_CAP^ ":"! FLOAT semi
	| K_TEMP_SLOPE_FALL^ ":"! FLOAT semi
	| K_TEMP_SLOPE_RISE^ ":"! FLOAT semi
	| K_TEMP_WIRE_CAP^ ":"! FLOAT semi
	| K_TEMP_WIRE_RES^ ":"! FLOAT semi
	| K_VOLT_DRIVE_FALL^ ":"! FLOAT semi
	| K_VOLT_DRIVE_RISE^ ":"! FLOAT semi
	| K_VOLT_INTRINSIC_FALL^ ":"! FLOAT semi
	| K_VOLT_INTRINSIC_RISE^ ":"! FLOAT semi
	| K_VOLT_PIN_CAP^ ":"! FLOAT semi
	| K_VOLT_SLOPE_FALL^ ":"! FLOAT semi
	| K_VOLT_SLOPE_RISE^ ":"! FLOAT semi
	| K_VOLT_WIRE_CAP^ ":"! FLOAT semi
	| K_VOLT_WIRE_RES^ ":"! FLOAT semi
	| lu_table_template
	| NOM_PROCESS^ ":"! FLOAT semi
	| NOM_TEMPERATURE^ ":"! FLOAT semi
	| NOM_VOLTAGE^ ":"! FLOAT semi
	| operating_conditions
	| output_voltage
	| PULLING_RESISTANCE_UNIT^ ":"! STRING semi
	| TIME_UNIT^ ":"! STRING semi
	| timing_range
	| VOLTAGE_UNIT^ ":"! STRING semi
	;

input_voltage
	: INPUT_VOLTAGE^ identifier
	  "\{"!
	  ( input_voltage_statement )*
	  "\}"!
	;

output_voltage
	: OUTPUT_VOLTAGE^ identifier
	  "\{"!
	  ( output_voltage_statement )*
	  "\}"!
	;

input_voltage_statement
	: VIL^ ":"! FLOAT semi
	| VIH^ ":"! FLOAT semi
	| VIMIN^ ":"! FLOAT semi
	| VIMAX^ ":"! expr semi
	;

output_voltage_statement
	: VOL^ ":"! FLOAT semi
	| VOH^ ":"! FLOAT semi
	| VOMIN^ ":"! FLOAT semi
	| VOMAX^ ":"! expr semi
	;

lu_table_template
	: LU_TABLE_TEMPLATE^ identifier
	  "\{"!
	  ( lu_table_template_statement )*
	  "\}"!
	;

lu_table_template_statement
	: ( VARIABLE_1^ | VARIABLE_2^ ) ":"!
	  ( TOTAL_OUTPUT_NET_CAPACITANCE
          | INPUT_NET_TRANSITION
	  | RELATED_PIN_TRANSITION
	  | CONSTRAINED_PIN_TRANSITION
	  )
	  semi
	| ( INDEX_1^ | INDEX_2^ )
	  "\("! STRING "\)"!
	  semi
	;

timing_range
	: TIMING_RANGE^ identifier
	  "\{"!
	  ( timing_range_statement )*
	  "\}"!
	;

timing_range_statement
	: FASTER_FACTOR^ ":"! FLOAT semi
	| SLOWER_FACTOR^ ":"! FLOAT semi
	;

operating_conditions
	: OPERATING_CONDITIONS "\("! STRING "\)"!
	  "\{"!
	  ( operating_condition_statement )*
	  "\}"!
	;

operating_condition_statement
	: PROCESS^ ":"! FLOAT semi
	| TEMPERATURE^ ":"! FLOAT semi
	| TREE_TYPE^ ":"! STRING semi
	| VOLTAGE^ ":"! FLOAT semi
	;

wire_load
	: "\("! STRING "\)"!
	  "\{"!
	  ( wire_load_statement )*
	  "\}"!
	;

wire_load_statement
	: AREA^ ":"! FLOAT semi
	| CAPACITANCE^ ":"! FLOAT semi
	| FANOUT_LENGTH^ ":"! duple semi
	| RESISTANCE^ ":"! FLOAT semi
	| SLOPE^ ":"! FLOAT semi
	;

cell
	: identifier
	  "\{"!
	  ( cell_statement )*
	  "\}"!
	;

cell_statement
	: AREA^ ":"! FLOAT semi
	| ff
	| latch
	| pin
	;

ff	: FF^ identifier_list
	  "\{"!
	  ( ff_statement )*
	  "\}"!
	;

ff_statement
	: CLEAR^ ":"! << zzmode (LOG_STRING); >> logexpr semi
	| CLEAR_PRESET_VAR1^ ":"! ( LIB_L | LIB_H ) semi
	| CLEAR_PRESET_VAR2^ ":"! ( LIB_L | LIB_H ) semi
	| CLOCKED_ON^ ":"! STRING semi
	| NEXT_STATE^ ":"! STRING semi
	| PRESET^ ":"! << zzmode (LOG_STRING); >> logexpr semi
	;

latch	: LATCH^ identifier_list
	  "\{"!
	  ( latch_statement )*
	  "\}"!
	;

latch_statement
	: CLEAR^ ":"! STRING semi
	| DATA_IN^ ":"! STRING semi
	| ENABLE^ ":"! STRING semi
	;

pin	: PIN^ identifier 
	  "\{"!
	  ( pin_statement )*
	  "\}"!
	;

pin_statement
	: CAPACITANCE^ ":"! FLOAT semi
	| CLOCK^ ":"! ( LIB_TRUE | LIB_FALSE ) semi
	| DIRECTION^ ":"! ( INPUT | OUTPUT | INOUT ) semi
	| FANOUT_LOAD^ ":"! FLOAT semi
	| FUNCTION^ ":"! << zzmode (LOG_STRING); >> logexpr semi
	| MAX_CAPACITANCE^ ":"! FLOAT semi
	| MAX_TRANSITION^ ":"! FLOAT semi
	| MAX_FANOUT^ ":"! FLOAT semi
	| SIGNAL_TYPE^ ":"! STRING semi
	| TIMING^ timing
	;

test_cell
	: "\("! "\)"!
	  "\{"!
	  ( cell_statement )*
	  "\}"!
	;

statetable
	: "\("! STRING "\)"!
	  "\{"!
	  ( statetable_statement )*
	  "\}"!
	;

statetable_statement
	: TABLE^ ":"! STRING semi
	;

timing	: "\("! "\)"!
	  "\{"!
	  ( timing_statement )*
	  "\}"!
	;

timing_statement
	: CAPACITANCE^ ":"! FLOAT semi
	| cell_rise_fall
	| rise_fall_transition
	| rise_fall_constraint
	| FALL_RESISTANCE^ ":"! FLOAT semi
	| FANOUT_LOAD^ ":"! FLOAT semi
	| INTRINSIC_FALL^ ":"! FLOAT semi
	| INTRINSIC_RISE^ ":"! FLOAT semi
	| RELATED_PIN^ ":"! STRING semi
	| RISE_RESISTANCE^ ":"! FLOAT semi
	| SLOPE_FALL^ ":"! FLOAT semi
	| SLOPE_RISE^ ":"! FLOAT semi
	| TIMING_SENSE^ ":"! ( POSITIVE_UNATE | NEGATIVE_UNATE ) semi
	| timing_type
	;

cell_rise_fall
	: ( CELL_RISE^ | CELL_FALL^ ) identifier
	  "\{"!
	  ( lu_table_statement )*
	  "\}"!
	;

rise_fall_transition
	: ( RISE_TRANSITION^ | FALL_TRANSITION^ ) identifier
	  "\{"!
	  ( lu_table_statement )*
	  "\}"!
	;

rise_fall_constraint
	: ( RISE_CONSTRAINT^ | FALL_CONSTRAINT^ ) identifier
	  "\{"!
	  ( lu_table_statement )*
	  "\}"!
	;

lu_table_statement
	: INDEX_1^ "\("! STRING "\)"! semi
	| INDEX_2^ "\("! STRING "\)"! semi
	| VALUES^ "\("! STRING ( ","! STRING )* "\)"! semi
	;

timing_type
	: TIMING_TYPE^ ":"!
	  ( RISING_EDGE
	  | FALLING_EDGE
	  | SETUP_RISING
	  | SETUP_FALLING
	  | HOLD_RISING
	  | HOLD_FALLING
	  | CLEAR
	  | PRESET
	  )
	  semi
	;

identifier
	: "\("! << zzmode (GET_ID); >> id_or_string "\)"!
	;

identifier_list
	: "\("! << zzmode (GET_ID); >> head:id_or_string
	    ( ","! << zzmode (GET_ID); >> id_or_string )*
	  "\)"!
		<< #0 = #(#[LIST, "list"], #head); >>
	;

id_or_string
	: LIB_ID
	| STRING
	;

expr	: ( VDD | GND | FLOAT )
	  { ( ADD^ | SUB^ | MUL^ | DIV^ )
	    ( VDD | GND | FLOAT ) }
	;

string_list
	: STRING ( ","! STRING )*
	;

duple	: "\("! FLOAT^ ","! ( FF | PF | UF ) "\)"!
	;

semi	: ";"!
	| /* empty */
	;

logexpr	: e:logexpr1 { 	( LOGADD!	<< #0 = #(#[LOGOR, "|"], #e); >>
			| LOGOR^
			| LOGXOR^
			)
			logexpr
		     }
	;

logexpr1: e:logexpr2 { 	( LOGAND^ 
			| LOGMUL!	<< #0 = #(#[LOGAND, "&"], #e); >>
			| /* empty */	<< #0 = #(#[LOGAND, "&"], #e); >>
			)
		  	logexpr1
		     }
	;

logexpr2: e:logexpr3 { LOGNEG!		<< #0 = #(#[LOGNOT, "!"], #e); >>
		     }
	| LOGNOT^ logexpr3
	;

logexpr3: LOGID
	| LOGOPEN! logexpr LOGCLOSE!
	;
@

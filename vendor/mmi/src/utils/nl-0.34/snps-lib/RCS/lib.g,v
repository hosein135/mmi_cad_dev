#token K_PROCESS_SLOPE_FALL	"k_process_slope_fall"
#token K_PROCESS_SLOPE_RISE	"k_process_slope_rise"
#token K_PROCESS_WIRE_CAP	"k_process_wire_cap"
#token K_PROCESS_WIRE_RES	"k_process_wire_res"

#token K_TEMP_DRIVE_RISE	"k_temp_drive_rise"
#token K_TEMP_INTRINSIC_FALL	"k_temp_intrinsic_fall"
#token K_TEMP_INTRINSIC_RISE	"k_temp_intrinsic_rise"
#token K_TEMP_PIN_CAP		"k_temp_pin_cap"
#token K_TEMP_SLOPE_FALL	"k_temp_slope_fall"
#token K_TEMP_SLOPE_RISE	"k_temp_slope_rise"
#token K_TEMP_WIRE_CAP		"k_temp_wire_cap"
#token K_TEMP_WIRE_RES		"k_temp_wire_res"
#token K_VOLT_DRIVE_FALL	"k_volt_drive_fall"
#token K_VOLT_DRIVE_RISE	"k_volt_drive_rise"
#token K_VOLT_INTRINSIC_FALL	"k_volt_intrinsic_fall"
#token K_VOLT_INTRINSIC_RISE	"k_volt_intrinsic_rise"
#token K_VOLT_PIN_CAP		"k_volt_pin_cap"
#token K_VOLT_SLOPE_FALL	"k_volt_slope_fall"
#token K_VOLT_SLOPE_RISE	"k_volt_slope_rise"
#token K_VOLT_WIRE_CAP		"k_volt_wire_cap"
#token K_VOLT_WIRE_RES		"k_volt_wire_res"
#token LATCH			"latch"
#token LIBRARY			"library"
#token LU_TABLE_TEMPLATE	"lu_table_template"
#token MAX_CAPACITANCE		"max_capacitance"
#token MAX_FANOUT		"max_fanout"
#token MAX_TRANSITION		"max_transition"
#token NEGATIVE_UNATE		"negative_unate"
#token NEXT_STATE		"next_state"
#token NOM_PROCESS		"nom_process"
#token NOM_TEMPERATURE		"nom_temperature"
#token NOM_VOLTAGE		"nom_voltage"
#token OPERATING_CONDITIONS	"operating_conditions"
#token OUTPUT			"output"
#token OUTPUT_VOLTAGE		"output_voltage"
#token PF			"pf"
#token PIN			"pin"
#token POSITIVE_UNATE		"positive_unate"
#token PRESET			"preset"
#token PROCESS			"process"
#token PULLING_RESISTANCE_UNIT	"pulling_resistance_unit"
#token RELATED_PIN		"related_pin"
#token RELATED_PIN_TRANSITION	"related_pin_transition"
#token RESISTANCE		"resistance"

#(progn "-*-emacs-lisp-*-"

   (setq embedded-elisp-output-file
	 (concat (file-name-sans-extension embedded-elisp-source-file) ".c"))

   (load (expand-file-name "../lisp/nl_rewrite_fns.el") nil t)

   (concat "/" "* DO NOT EDIT THIS FILE *" "/\n"
	   "/" "* This file is generated from "
	   embedded-elisp-source-file ". *" "/"))


#include "port.h"
#include "error.h"
#include "mem.h"
#include "ar.h"
#include "str.h"
#include "hashtab.h"
#include "nl.h"
#include "str.h"
#include "ssa.h"
#include "ast2g.h"
#include "ast2g_int.h"


#(define-rewrite ast2g_eliminate_logical_ops
   (or
    (replace (ANDAND $arg1 $arg2)
	     (AND (OR_REDUCE $arg1) (OR_REDUCE $arg2)))

    (replace (OROR $arg1 $arg2)
	     (OR (OR_REDUCE $arg1) (OR_REDUCE $arg2)))

    (replace (LOGNOT $arg)
	     (BITNOT (OR_REDUCE $arg)))))


#(define-rewrite ast2g_simplify_reduce_ops
   (or
    (replace (and ((OR_REDUCE AND_REDUCE XOR_REDUCE) $arg)
		  (test "$arg.width == 1"))
	     $arg)

    (replace (and (XNOR_REDUCE $arg)
		  (test "$arg.width == 1"))
	     (BITNOT $arg))

    (replace (and (OR_REDUCE (CONCAT $arg1 $arg2))
		  (test "$arg1.width == 1 && $arg2.width == 1"))
	     (OR $arg1 $arg2))

    (replace (and (AND_REDUCE (CONCAT $arg1 $arg2))
		  (test "$arg1.width == 1 && $arg2.width == 1"))
	     (AND $arg1 $arg2))

    (replace (and (XOR_REDUCE (CONCAT $arg1 $arg2))
		  (test "$arg1.width == 1 && $arg2.width == 1"))
	     (XOR $arg1 $arg2))

    (replace (and (XNOR_REDUCE (CONCAT $arg1 $arg2))
		  (test "$arg1.width == 1 && $arg2.width == 1"))
	     (XNOR $arg1 $arg2))))


#(define-rewrite ast2g_explicit_case :preorder
   (CASE (replace (or (IN =in)
		      (REF =ref))
		  (BIN 1 [VNUM "1"]))
	 * ;; matches the pragmas
	 (repeat
	  (CASE_ITEM
	   (replace (LIST (repeat
			   (replace $expr
				    (EQ2 $expr 
					 (if "$ref != NULL" 
					     [REF $ref.object]
					   [IN $in.in_index]))))
			  =tests)
		    (LIST (if "$tests.sibling == NULL"
			      ;; only one test
			      $tests
			    ;; multiple tests
			    (OR_REDUCE (CONCAT $tests)))))
	   * ;; matches the body of the CASE_ITEM
	   ))
	 &optional
	 * ;; matches the default branch, if any
	 ))


#(define-rewrite ast2g_rewrite_clocks 
   (replace (ALWAYS (LIST $clk_edge)
		    $body)
	    (ALWAYS (LIST) 
		    (CASE $clk_edge (LIST)
			  (CASE_ITEM (LIST (BIN 1 [VNUM "1"]))
				     $body)))))


#(define-rewrite ast2g_flip_cases
   (replace (CASE (BITNOT $expr) (LIST &rest) =pragmas
		  (CASE_ITEM (LIST (BIN 1 [VNUM "1"]))
			     $body)
		  &optional
		  (DEFAULT &rest) =default)
		  
	    (CASE $expr $pragmas
		  (CASE_ITEM (LIST (BIN 1 [VNUM "0"]))
			     $body)
		  $default)))


#(define-rewrite ast2g_flatten_concats
   (or
    (replace (CONCAT $arg)
	     $arg)

    (replace (REPEAT_CONCAT 1 $arg)
	     $arg)

    (CONCAT (repeat
	     (or
	      (replace (CONCAT &rest =args)
		       $args)
	      *)))))


#(define-rewrite ast2g_infer_inverting_ops
   (or
    (replace (BITNOT (AND &rest =args))
	     (NAND $args))

    (replace (BITNOT (OR &rest =args))
	     (NOR $args))))


#(define-rewrite ast2g_flatten_logic_trees
   (or
    ((AND NAND) (repeat
		 (or
		  (replace (AND &rest =args)
			   $args)
		  *)))

    ((OR NOR) (repeat
	       (or 
		(replace (OR &rest =args)
			 $args)
		*)))

    ((XOR XNOR) (repeat
		 (or
		  (replace (XOR &rest =args)
			   $args)
		  *)))))

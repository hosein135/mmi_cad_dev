#(progn "-*-emacs-lisp-*-"

   (setq embedded-elisp-output-file
	 (concat (file-name-sans-extension embedded-elisp-source-file) ".c"))

   (load (expand-file-name "../lisp/nl_rewrite_fns.el") nil t)

   (concat "/" "* DO NOT EDIT THIS FILE *" "/\n"
	   "/" "* This file is generated from "
	   embedded-elisp-source-file ". *" "/"))


#include "port.h"
#include "error.h"
#include "mem.h"
#include "ar.h"
#include "str.h"
#include "hashtab.h"
#include "nl.h"
#include "str.h"
#include "ssa.h"
#include "ast2g.h"
#include "ast2g_int.h"


#(define-predicate ast2g_is_constant :static
   (or (NUMBER &rest)
       ((BIN HEX OCT DEC) &rest)
       (CONCAT 
	(repeat
	 (call-predicate ast2g_is_constant)))))


#(define-rewrite ast2g_infer_X__ :preorder
   (replace
    (ALWAYS
     (LIST ((POSEDGE NEGEDGE) =clk_sense $clk))
     ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
      $rhs
      $lhs))

    (ALWAYS (LIST)
     (BLOCK_ASSIGN
      (FUNCALL (if "$clk_sense.token == nl_token_posedge"
		   '*SEQGEN_Rxx*
		 '*SEQGEN_Fxx*)
	       $clk $rhs)
      $lhs))))


#(define-rewrite ast2g_infer_XL_ :preorder
   (replace
    (ALWAYS
     (LIST ((POSEDGE NEGEDGE) =clk_sense $clk))
	       
     (IF (and (or (LOGNOT $reset)
		  (BITNOT $reset)
		  (and (EQ2 $reset (NUMBER) =num)
		       (test "$num.value == 0"))
		  (and (EQ2 $reset (BIN * (VNUM &rest) =vnum))
		       (test "strcmp ($vnum.bits, \"0\") == 0")))
	      (test "$reset.width == 1"))

	 ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
	  (call-predicate ast2g_is_constant) =const
	  (OUT &rest) =lhs &rest)

	 ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
	  $data
	  (and (OUT &rest)
	       (test 
		"nl_out_ast_index ((nl_out_ast) __tree) == $lhs.out_index")))))

    (ALWAYS (LIST)
     (BLOCK_ASSIGN 
      (FUNCALL (if "$clk_sense.token == nl_token_posedge"
		     '*SEQGEN_RLx*
		 '*SEQGEN_FLx*)
	       $clk $reset $const $rhs)
      $lhs))))


#(define-rewrite ast2g_infer_XH_ :preorder
   (replace
    (ALWAYS
     (LIST ((POSEDGE NEGEDGE) =clk_sense $clk))
     (IF $reset

	 ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
	  (call-predicate ast2g_is_constant) =const
	  (OUT &rest) =lhs &rest)

	 ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
	  $data
	  (and (OUT &rest)
	       (test 
		"nl_out_ast_index ((nl_out_ast) __tree) == $lhs.out_index")))))

    (ALWAYS (LIST)
     (BLOCK_ASSIGN 
      (FUNCALL (if "$clk_sense.token == nl_token_posedge"
		   '*SEQGEN_RHx*
		 '*SEQGEN_FHx*)
	       $clk $reset $const $rhs)
      $lhs))))


#(define-rewrite ast2g_infer_XF_ :preorder
   (replace
    (ALWAYS
     (LIST ((POSEDGE NEGEDGE) =clk_sense $clk)
	   (NEGEDGE (REF (IN &rest) =rst_in) =reset))
	       
     (IF (and (or (LOGNOT $reset)
		  (BITNOT $reset)
		  (and (EQ2 $reset (NUMBER) =num)
		       (test "$num.value == 0"))
		  (and (EQ2 $reset (BIN * (VNUM &rest) =vnum))
		       (test "strcmp ($vnum.bits, \"0\") == 0")))
	      (test "$reset.width == 1"))

	 ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
	  (call-predicate ast2g_is_constant) =const
	  (OUT &rest) =lhs &rest)

	 ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
	  $data
	  (and (OUT &rest)
	       (test 
		"nl_out_ast_index ((nl_out_ast) __tree) == $lhs.out_index")))))

    (ALWAYS (LIST)
     (BLOCK_ASSIGN 
      (FUNCALL (if "$clk_sense.token == nl_token_posedge"
		     '*SEQGEN_RLx*
		 '*SEQGEN_FLx*)
	       $clk $reset $const $rhs)
      $lhs))))


#(define-rewrite ast2g_infer_XR_ :preorder
   (replace
    (ALWAYS
     (LIST ((POSEDGE NEGEDGE) =clk_sense $clk)
	   (POSEDGE (REF (IN &rest) =rst_in)))
     (IF (and (REF (IN &rest) =test_in)
	      (test "$test_in.value == $rst_in.value"))

	 ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
	  (call-predicate ast2g_is_constant) =const
	  (OUT &rest) =lhs &rest)

	 ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
	  $data
	  (and (OUT &rest)
	       (test 
		"nl_out_ast_index ((nl_out_ast) __tree) == $lhs.out_index")))))

    (ALWAYS (LIST)
     (BLOCK_ASSIGN 
      (FUNCALL (if "$clk_sense.token == nl_token_posedge"
		   '*SEQGEN_RRx*
		 '*SEQGEN_FRx*)
	       $clk $reset $const $rhs)
      $lhs))))


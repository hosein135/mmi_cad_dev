#(define-rewrite ast2g_infer_XX_ :preorder
   (replace
    (ALWAYS
     (LIST ((POSEDGE NEGEDGE) =clk_sense $clk)
	   ((POSEDGE NEGEDGE) =rst_sense $clk))
     
     (IF $reset

	 ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
	  (call-predicate ast2g_is_constant) =const
	  (OUT &rest) =lhs &rest)

	 ((NONBLOCK_ASSIGN BLOCK_ASSIGN)
	  $data
	  (and (OUT &rest)
	       (test 
		"nl_out_ast_index ((nl_out_ast) __tree) == $lhs.out_index")))))

    (ALWAYS (LIST)
     (BLOCK_ASSIGN 
      (FUNCALL (if "$clk_sense.token == nl_token_posedge"
		   '*SEQGEN_RHx*
		 '*SEQGEN_FHx*)
	       $clk $reset $const $rhs)
      $lhs))))


PCCTS=/homes/jka/tools/pccts
INCLUDE=-I $(PCCTS)/h -I $(PCCTS)/sorcerer/h -I $(PCCTS)/sorcerer/lib
ANTLR=$(PCCTS)/bin/antlr
AFLAGS=-gt -gh
SOR=$(PCCTS)/bin/sor
SFLAGS=-prefix def2pnl_
DLG=$(PCCTS)/bin/dlg
OBJS=def.o parser.o err.o main.o def2pnl3.o
CFLAGS=-g $(INCLUDE)
CC=gcc

main: $(OBJS)
	gcc -g -o def $(OBJS)

%.c:	%.g
	$(ANTLR) $(AFLAGS) $<

%.c:	%.dlg
	$(DLG) $< > $@

%.c:	%.sor
	$(SOR) $(SFLAGS) $<

def.c:		def.g

def.o:		mode.h

mode.h:		parser.c

parser.c:	parser.dlg

parser.dlg:	def.g

def2pnl3.c:	def2pnl3.sor

def2pnl.c:	def2pnl.sor

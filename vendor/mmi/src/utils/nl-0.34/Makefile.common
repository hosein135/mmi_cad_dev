# -*-Makefile-*-

include ../Makefile.mmi


OBJ_VARIANT	= debug
OBJDIR		= obj-$(OBJ_VARIANT).$(TARGET)
LIBDIR		= ../lib-$(OBJ_VARIANT).$(TARGET)

OBJS		= $(patsubst %.c,$(OBJDIR)/%.o,$(SRCS))
EE_GEN		= $(patsubst %.ee,%.c,$(EE_SRC))
SOR_GEN		= $(patsubst %.sor,%.c,$(SOR_SRC))
GENERATED_SRC	= $(SCHEMA_GEN) $(PROTO_GEN) $(EE_GEN) $(SOR_GEN)

LIB		= $(LIBDIR)/$(LIBNAME)
DEBUG		= -g
OPT_FLAG	= -O
WARNINGS	= $(filter-out $(DONT_WARN_$*), -Wall) $(WARNINGS_$*)
WERROR		= -Werror
OPT		= 
FPIC		= -fPIC
CFLAGS		= $(WARNINGS) $(WERROR) $(DEBUG) $(OPT) $(FPIC) -shared -I../include $(INCLUDE) \
		  $(CONFIG_CFLAGS) $(CONFIG_INCLUDES) $(CONFIG_DEFINES)
EMACS		= emacs
YACC		= bison
LEX		= flex

PCCTS_DIR	= $(MMI_UTILS)/pccts
PCCTS_BIN	= $(PCCTS_DIR)/bin
PCCTS_INCLUDE	= $(PCCTS_DIR)/h
PCCTS_SOR_INC	= $(PCCTS_DIR)/sorcerer/h
PCCTS_SOR_LIB	= $(PCCTS_DIR)/sorcerer/lib
ANTLR		= $(PCCTS_BIN)/antlr
DLG		= $(PCCTS_BIN)/dlg
SOR		= $(PCCTS_BIN)/sor

LISP_DIR	= ../lisp
FLAMBDA		= $(LISP_DIR)/flambda.el
DEFSTRUCT	= $(LISP_DIR)/defstruct.el
SETL		= $(LISP_DIR)/setl.el
SCHEMA		= $(LISP_DIR)/schema.el
PROTOGEN	= $(LISP_DIR)/protogen.el
EMBEDDED_ELISP	= $(LISP_DIR)/embedded-elisp.el
REWRITE		= $(LISP_DIR)/rewrite.el

lib:	$(LIB)

lib-debug:
	@$(MAKE) OBJ_VARIANT=debug lib

lib-opt:
	@$(MAKE) OBJ_VARIANT=opt OPT=$(OPT_FLAG) lib

$(LIB): $(OBJS)
	@mkdir -p $(LIBDIR)
	ar r $@ $?
	@ranlib $@


$(OBJDIR)/%.o:	%.c
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -c $< -o $@


%.c:	%.sor
	$(SOR) -prefix $(SOR_PREFIX) -proto-file $*.h $<
	@cat $*.h | sed "s,typedef .*,/* & */," > $*.tmp.h
	@mv $*.tmp.h $*.h


%.c:	%.ee
	$(EMACS) -batch -l $(EMBEDDED_ELISP) -l $(SETL) -l $(FLAMBDA) \
		-l $(REWRITE) -f embedded-elisp-do-batch $<


%.i:	%.c
	$(CC) $(CFLAGS) -E -c $< > $@

clean-common:
	rm -fr *~
	rm -fr ../lib-*/$(LIBNAME)
	rm -fr obj-*

clean:	clean-common

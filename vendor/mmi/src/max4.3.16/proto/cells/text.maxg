# This procedure draws simple scalable text

variable _CHARACTERS_

proc gcell_make_text {properties} -desc {
  gcell procedure to draw scalable text
} {

  variable _CHARACTERS_

  # get values out of properties list
  foreach prop "text layer scale spacing" {
    set $prop [get_assoc $prop $properties]
  }

  if {[string trim $text] == ""} {
    # no empty strings allowed
    error "Aborting, blank text not allowed."
  }

  set x 0

  set scale [expr 1.0 * $scale]

  set strlen [string length $text]
  for {set i 0} {$i < $strlen} {incr i} {
    set char [string index $text $i]

    if {$char == "\{"} {
      # possibly special case
      set special [string range $text $i [expr $i + 2]]
      if {$special == "{M}" || $special == "{C}"} {
	set char $special
	incr i 2
      } elseif {$special == "{X}"} {
	set char !
	incr i 2
      }
    }

    if {$char != " "} {

      # first try character, then upper case character.  If neither, use "_".
      set data [use_first _CHARACTERS_($char) \
		    _CHARACTERS_([string toupper $char]) _CHARACTERS_(_)]

      foreach datum $data {
	switch [lindex $datum 0] {
	  paint {
	    setl {tmp x1 y1 x2 y2} $datum
	    gcell_paint $layer [expr $scale * $x1 + $x] [expr $scale * $y1] \
		[expr $scale * $x2 + $x] [expr $scale * $y2]
	  } 

	  polygon {
	    set coords [lrange $datum 1 end]
	    set len [llength $coords]

	    set new_coords ""
	    for {set j 0} {$j < $len} {incr j 2} {
	      lappend new_coords [expr $scale * [lindex $coords $j] + $x] \
		  [expr $scale * [lindex $coords [expr $j + 1]]]
	    }

	    eval gcell_polygon $layer $new_coords
	  }
	}
      }
    }

    set x [uusnap [expr $x + (6 + $spacing) * $scale]]
  }

  return "scale=$scale/spacing=$spacing"
}


# Fix up the props used to make a text gcell.  
# Allow text to scale when stretching.

proc gcell_make_props_text {prop_list} {

  if {[set bbox [get_assoc _BBOX_  $prop_list]] != ""} {
    # compute new scale from bbox
    set prop_list [rm_assoc _BBOX_ $prop_list]

    foreach prop "text scale spacing" {
      set $prop [get_assoc $prop $prop_list]
    }

    setl {x1 y1 x2 y2} $bbox

    # height is 11 for scale of 1.
    set new_scale [expr ($y2 - $y1) / 11.0]

    # width is 
    set len [string length $text]
    set new_scale2 [expr ($x2 - $x1) / [expr (6 + $spacing) * $len - 6]]

    set new_scale [max $new_scale $new_scale2]

    # don't let it be too fine or screws up rounding
    set new_scale [expr round($new_scale * 10) / 10.0]

    # replace with new
    set prop_list [rm_assoc scale $prop_list]
    lappend prop_list [list scale $new_scale]
  }

  return $prop_list
}



# now define it and give default arguments

proc gcell_init_text {} {

  lappend properties [list text "" -entry -help {\
						     text to draw.  NOTE: unrecognized characters are replaced by _.  To get an ! you need to use {X}.  Also, you can use {C} and {M} for circles around the C and M (you need to put spaces after {C} and {M}, also).}]

  set layers [techinfo layer_order]
  lappend properties [list layer [lindex $layers 0] -choice $layers -help {\
	layer to place text on.}]

  lappend properties [list scale 1 -number -incr 0.1 -help {\
	scale factor the text.}]

  lappend properties [list spacing 2 -number -incr 0.1 -help {\
	letter spacing before scaling.}]

  define_gcell text $properties
}

# Do it now
gcell_init_text



### For building characters

proc _extract_characters {{filename alphabet}} -desc {
  creates the character set from a max file of drawn characters
} {
  
  variable _CHARACTERS_

  :load $filename

  set chars ""

  foreach label [split [db_search labels] \n] {

    set char [lindex $label 6]

    if {[info exists processed($char)]} {
      # already got this
      continue
    }
    set processed($char) 1

    sel_labels -text $char
    set labels [sel_what_labels]
    sel_clear
    foreach _label $labels {
      setl {layer x y} $_label
      sel_net -more -point $x $y $layer
    }

    if {$char == "{FS}"} {
      set char /
    }
    if {$char == "{PC}"} {
      set char %
    }
    lappend chars $char

    set _CHARACTERS_($char) ""

    # get the origin
    setl {x1 y1 x2 y2} [db_bbox -cell __SELECT__]
    # round to nearest 5
    set xo [expr round($x1 / 5.0) * 5]
    set yo [expr round($y1 / 5.0) * 5]


    if {[lsearch "g j p q y" $char] != -1} {
      # fix for descenders
      set yo [expr $yo + 5]
    }

    foreach paint [sel_what_paint] {
      setl {tmp x1 y1 x2 y2} $paint

      lappend _CHARACTERS_($char) [list paint \
				       [expr $x1 - $xo] [expr $y1 - $yo] \
				       [expr $x2 - $xo] [expr $y2 - $yo]]
    }

    foreach polygon [sel_what_polygons] {
      set coords [lindex $polygon 2]
      set len [llength $coords]

      set new_coords "polygon"
      for {set i 0} {$i < $len} {incr i 2} {
	lappend new_coords [expr [lindex $coords $i] - $xo] \
	    [expr [lindex $coords [expr $i + 1]] - $yo]

      }

      lappend _CHARACTERS_($char) $new_coords
    }
  }

  foreach char [array names _CHARACTERS_] {
    puts "\nset _CHARACTERS_($char) \{"
    foreach list $_CHARACTERS_($char) {
      puts "  \{$list\}"
    }
    puts "\}"
  }

  sel_clear
  puts "\n\#Parsed: $chars"
}


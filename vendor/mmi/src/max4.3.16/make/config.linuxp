# Linux Max configuration for profiling with gprof

# ------------------------------------------------------------------------
#       Include shared config
#       (should come first so that sets below override/modify)
# ------------------------------------------------------------------------
-include $(MMI_UTILS)/config/main.config

# ------------------------------------------------------------------------
#       Configuration Ids
# ------------------------------------------------------------------------
CONFIG := linuxp

# ------------------------------------------------------------------------
#       Libraries
# ------------------------------------------------------------------------
# -lmcheck causes heap consistency checking by malloc
# when compiling for gprof, may need to add:  -lgmon 
CONFIG_LIBS := $(CONFIG_LIBS)

# ------------------------------------------------------------------------
#       Defines for conditional compilation.
# ------------------------------------------------------------------------
# when compiling for gprof add:  -DGMON
# to turn off sanity checks, compile with -DNDEBUG
# MHA's "notes" -DMHA
# -DPARANOID to do extra assertions.
CONFIG_DEFINES :=  $(CONFIG_DEFINES) -DGMON

# ------------------------------------------------------------------------
#       Other compiler flags
# ------------------------------------------------------------------------
# -ggdb for debug
# -pg for gprof
# -save-temps to look at intermediate files
# -O3 creates slower code than -O2 on pcs
CONFIG_DEFINES_PERMISSIVE := $(CONFIG_DEFINES) -pg
CONFIG_DEFINES := $(CONFIG_DEFINES_PERMISSIVE) -Wreturn-type -Werror

# ------------------------------------------------------------------------
#       Strip program for final executable (echo) for noop
# ------------------------------------------------------------------------
CONFIG_STRIP = echo


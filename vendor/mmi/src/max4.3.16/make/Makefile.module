# Default Makefile for a module.

#include appropriate config file 
MAKE_DIR := ../../make
include $(MAKE_DIR)/config
	

MODULE := $(notdir $(shell pwd))
OBJ_DIR := ../../o/${CONFIG}/${MODULE}

HDRS :=	$(wildcard *.h)
SRCS :=	$(wildcard *.c)
# The sort removes duplicates from MODULE_EXTRA_OBJS that also match the wildcard *.c
OBJS0 :=  $(sort $(addsuffix .o,$(basename ${SRCS})) $(MODULE_EXTRA_OBJS))
OBJS := $(addprefix ${OBJ_DIR}/,${OBJS0})
DEPS0 :=  $(sort $(addsuffix .d,$(basename ${SRCS})))
DEPS := $(addprefix ${OBJ_DIR}/,${DEPS0})

COMPILE_FLAGS := $(MODULE_EXTRA_CFLAGS) $(CONFIG_CFLAGS)  -I. -I../../i $(CONFIG_INCLUDES) 
ifdef PERMISSIVE_COMPILE
	COMPILE_FLAGS := $(COMPILE_FLAGS) $(CONFIG_DEFINES_PERMISSIVE)
else
	COMPILE_FLAGS := $(COMPILE_FLAGS) $(CONFIG_DEFINES)
endif	

# This rule just lets you run "make" in a module development dir.
%.o: %.c
	-mkdir -p $(OBJ_DIR)
	-rm -f $@
	${CC} ${COMPILE_FLAGS} -c $< -o $(OBJ_DIR)/$*.o

# This rule just lets you run "make" cpp output in a module development dir.
%.E: %.c
	-mkdir -p $(OBJ_DIR)
	-rm -f $@
	${CC} ${COMPILE_FLAGS} -c -E $< > $*.E

$(OBJ_DIR)/%.o: %.c 
	-mkdir -p $(OBJ_DIR)
	-rm -f $@
	${CC} ${COMPILE_FLAGS} -c $< -o $(OBJ_DIR)/$*.o

$(OBJ_DIR)/%.d: %.c 
	-mkdir -p $(OBJ_DIR)
	-rm -f $(OBJ_DIR)/$*.d
	${CC} -MM ${COMPILE_FLAGS} $< > $(OBJ_DIR)/$*.d

$(OBJ_DIR)/$(MODULE).o: ${OBJS} 
	rm -f ${OBJ_DIR}/${MODULE}.o
	ld ${CONFIG_LINK_FLAGS} -r ${OBJS} -o ${OBJ_DIR}/${MODULE}.o

$(OBJ_DIR)/depend: $(DEPS)
	cat $(OBJ_DIR)/*.d | sed \/\^\[\^\ \]\/s=\^=$(OBJ_DIR)/= > $(OBJ_DIR)/depend
include $(OBJ_DIR)/depend

.PHONY: clean
clean:	
	cd ${OBJ_DIR}; rm -f *.o *.d depend

.PHONY: debug
debug: 
	echo module: ${MODULE}
	echo h: ${H}
	echo lib: ${LIB}
	echo hdrs: ${HDRS}
	echo src: ${SRCS}
	echo objs: ${OBJS}
	echo cflags: ${COMPILE_FLAGS}

.PHONY: protoize
protoize: 
	protoize -c -aux-info "${COMPILE_FLAGS}" *.c >& protoize.out

# -aux-info creates .X files for protoize

# get latest and greatest
.PHONY: update
update:
	-rm -f Makefile 
	co $(MMI_CAD)/src/max/m/${MODULE}/RCS/Makefile,v
	-rm -f  *.h 
	co $(MMI_CAD)/src/max/m/${MODULE}/RCS/*.h,v
	-rm -f  *.c 
	co $(MMI_CAD)/src/max/m/${MODULE}/RCS/*.c,v
# antlr parser source (used in def module)
	-rm -f  *.g 
	-co $(MMI_CAD)/src/max/m/${MODULE}/RCS/*.g,v
# some files are (re)generated by antlr (in the case of def), so need to be writable.
	chmod +w *
	make 



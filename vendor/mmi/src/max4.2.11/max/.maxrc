proc ww {} {
	setl {num_malloc num_free bytes waste} [utls_malloc_stats]
	puts "mallocs: $num_malloc  net: [expr $num_malloc - $num_free]  waste/bytes = [expr ($waste + 0.0)/$bytes]"
}

proc outnl {} {
	puts ""
	}

proc outi {name value} {
	global MEM
	set out [format "$name %d" $value]
	puts $out
}

proc outf {name value} {
	global MEM
	set out [format "$name %f" $value]
	puts $out
}

proc outm {name value} {
	global MEM
	set percent [expr 100.0 * $value / $MEM(total)]
	set value [expr $value / 1024.0]
	set out [format "$name %#6.1f Kbytes (%f %%)" $value $percent]
	puts $out
}

# return list of cell buffers
proc mem_cells {} {
  set list {}
  foreach cell [split [db_cells -user] \n] {
	set name [lindex $cell 0]
        lappend list $name 
  }

  return $list
} 

proc mem_coarse {} {
	global MEM

	set memTot 0
	set numTot 0
	set spaceTot 0

	set planes 0
	
	foreach cell [mem_cells] {
	setl {head mem num space} [lay_stat_coarse -cell $cell]
	if {$head == ""} continue
	incr memTot $mem
	incr numTot $num
	incr spaceTot $space
	}

	outi coarse_num_tiles $numTot
	if { $numTot == 0 } {
		set numTot 1
	}
	outf coarse_percent_space [expr 100.0 * $spaceTot / $numTot ]
	outi coarse_bytes_per_tile [expr $memTot / $numTot]
	outm coarse_memory $memTot

	set MEM(coarse) $memTot
}

proc mem_paint {} {
	global MEM

	set memTot 0
	set numTot 0
	set spaceTot 0

	set planes 0
	
	foreach cell [mem_cells] {
	setl {head mem num space} [db_stat_paint -cell $cell]
	incr memTot $mem
	incr numTot $num
	incr spaceTot $space
	}

	outi num_tiles $numTot
	if { $numTot == 0 } {
		set numTot 1
	}
	outf percent_space [expr 100.0 * $spaceTot / $numTot ]
	outi bytes_per_tile [expr $memTot / $numTot]
	outm paint_memory $memTot

	set MEM(paint) $memTot
}


proc mem_labels {} {
	global MEM

	set memTot 0
	set numTot 0
	
	foreach cell [mem_cells] {
	setl {head mem num} [db_stat_labels -cell $cell]
	incr memTot $mem
	incr numTot $num
	}

	outi num_labels $numTot
	if { $numTot == 0 } {
		set numTot 1
	}
	outi bytes_per_label [expr $memTot / $numTot]
	outm label_memory $memTot

	set MEM(labels) $memTot
}


proc mem_instances {} {
	global MEM

	set memTot 0
	set numTot 0

	foreach cell [mem_cells] {
	setl {head mem num} [db_stat_instances -cell $cell]
	incr memTot $mem
	incr numTot $num
	}

	outi num_instances $numTot
	if { $numTot == 0 } {
		set numTot 1
	}
	outi bytes_per_instance [expr $memTot / $numTot]
	outm instance_memory $memTot

	set MEM(instances) $memTot
}

proc mem_malloc {} {
	global MEM
	
	setl { mallocs frees bytes align} [utls_malloc_stats]
	set net [expr $mallocs - $frees] 
	set link [expr ($net * 8)]

	outi num_mallocs $mallocs
	outi num_frees   $frees
	outi net_mallocs $net
	outm malloc_align_overhead $align
	outm malloc_link_overhead $link
	outm malloc_total_overhead [expr $align + $link]
	
	set MEM(malloc) [expr $align + $link]
}

proc mem_stats {} {
	global MEM
	puts "MEMORY USE SUMMARY"

	# total dynamic memory
	set MEM(total) [utls_stat_memory]
	outm total_dynamic_memory $MEM(total)

	outnl

	mem_instances
	outnl

	mem_paint
	outnl

	mem_coarse
	outnl

	mem_labels
	outnl

	mem_malloc
	outnl

	puts "SUMMARY"
	outm total_dynamic_memory $MEM(total)
	outm instances $MEM(instances)
	outm paint $MEM(paint)
	outm coarse $MEM(coarse)
	outm labels $MEM(labels)
	outm malloc_overhead $MEM(malloc)

	set all [expr $MEM(instances) + $MEM(paint) + $MEM(coarse) + $MEM(labels) + $MEM(malloc)]

	set other [expr $MEM(total) - $all]
	outm other $other
}

proc s {n l} {
	setl {x y x2 y2} [lay_box]
	sel_net -point $x $y -limit $n $l	
}
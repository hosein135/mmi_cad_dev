#puts "overlaying _pal_set_zoom_state"
proc _pal_set_zoom_state_HIDE {zoomed_out} -desc {
  setup for zoomed in or zoomed out redisplay
} {
    global PAL
    
    puts "zoomed_out = $zoomed_out\n"
    flush stdout
			
    set PAL(zoomed_out) $zoomed_out
    if { $zoomed_out == 1 } {
	set zoom zo
    } else {
	set zoom zi
    }

    foreach entry [use_first PAL(special_entrys)] {
	_pal_special_set_state $entry $PAL(${zoom}_state.$entry)
    }
}

proc wp {fileName} {
	set db [gds_info $fileName]
	set defs [get_assoc cell_defs $db]
	puts $defs
}

#g 1 3 4 4 12 looks good to me (mha)
proc g {fine coarse origin fpitch cpitch} {
	global LAY_GRID_POINT_DIAMETER_FINE
	global LAY_GRID_POINT_DIAMETER_COARSE
	global LAY_GRID_MIN_PIXEL_PITCH_FINE
	global LAY_GRID_MIN_PIXEL_PITCH_COARSE
	global LAY_GRID_ORIGIN_RADIUS

	set LAY_GRID_POINT_DIAMETER_FINE $fine
	set LAY_GRID_POINT_DIAMETER_COARSE $coarse
	set LAY_GRID_MIN_PIXEL_PITCH_FINE $fpitch
	set LAY_GRID_MIN_PIXEL_PITCH_COARSE $cpitch
	set LAY_GRID_ORIGIN_RADIUS $origin

	lay_style 173 077 077 0 solid 0 
	lay_style 174 077 077 0 solid 0 
	lay_style 175 077 077 0 solid 0 
}


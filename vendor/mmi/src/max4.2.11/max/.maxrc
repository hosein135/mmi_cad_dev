proc mkchunk {n} {
	for {set row 1} {$row <= $n} {set row [expr $row + 1]} {
	db_paint m1 [expr 0 - $row] $row $row [expr $row + 1]
	}
}


proc mklabs {n} {
	db_paint m1 0 0 [expr $n + 1] [expr $n + 1]   
	lay_box 0 0 [expr $n + 1] [expr $n + 1]   
	for {set row 1} {$row <= $n} {set row [expr $row + 1]} {
		for {set col 1} {$col <= $n} {set col [expr $col + 1]} {
			db_label m1 "${col}x${row}" $col $row
	}
}  
}


proc mkpaint {n} {
	for {set row 1} {$row <= $n} {set row [expr $row + 1]} {
		for {set col 1} {$col <= $n} {set col [expr $col + 1]} {
			db_label m1 "${col}x${row}" $col $row
	}
}  
}


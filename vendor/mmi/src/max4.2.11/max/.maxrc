 bpa 0 1 30 30     c3
}


proc bx {x0 y0 x1 y1 id} {
	global BP
	set x0 [expr $x0 / 1000.0]
	set y0 [expr $y0 / 1000.0]
	set x1 [expr $x1 / 1000.0]
	set y1 [expr $y1 / 1000.0]
	bp_search $BP $x0 $y0 $x1 $y1
	bp_add -text $id $BP $x0 $y0 $x1 $y1
} 


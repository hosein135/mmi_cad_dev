# stop gap proc for clearing temporary paint and labels generated
# by netlister (will be moved to C).
proc ntlt_clear {} {
	undo_disable
	set saveGroup [db_group]
	db_group _ntl
	# Myron need all layers in list below
	# I'll get the right way to generate this list from Pat.
	eval sel_area -group -layers m1,m2,m3,m4 [lay_bbox] 
	:delete
	undo_enable
}

proc ne {args} {
	eval db_next_edge $args
}

proc ma {size} {
	set space 3
	set x 0
	while { $x<$size } {
		set y 0
		while {$y<$size} {
			db_instance m [expr $x*$space] [expr $y*$space]
			incr y
		}	  	
		incr x
	}
}

proc ma2 {size} {
	set space 3
	set x 0
	while { $x<$size } {
		set y 0
		while {$y<$size} {
			set xbot [expr $x*$space]
			set xtop [expr $xbot + 1]
			set ybot [expr $y*$space]
			set ytop [expr $ybot + 1]
			db_paint m2 $xbot $ybot $xtop $ytop
			incr y
		}	  	
		incr x
	}
}

proc m {} {
	db_instance  m 0 0
}

proc boom {}	{
	db_instance m1 0 0
	db_instance -dup_ok m1 0 0
	sel_cell m1_0
	sel_move 0 0
}
	
proc aext {args} {
	eval :*extract $args
}

proc l {name} {
	lay_layer_styles $name
}


proc bpn {} {
	global BP
	set BP [bp_new_plane]
}
bpn;

proc bpa {x0 y0 x1 y1 {text ""}} {
	global BP
	bp_add -text $text $BP $x0 $y0 $x1 $y1
} 

proc bpd {x0 y0 x1 y1} {
	global BP
	bp_delete $BP $x0 $y0 $x1 $y1
} 

proc bpr {x0 y0 x1 y1} {
	global BP
	bp_search $BP $x0 $y0 $x1 $y1
} 

proc bps {} {
	global BP
	bp_search $BP -10000 -10000 10000 10000
} 

# box based search
proc bpt {} {
	global BP
	setl {x0 y0 x1 y1} [lay_box]
	bp_search $BP $x0 $y0 $x1 $y1
} 


proc bpx {} {
	global BP
	bp_dump $BP
} 

proc bpz {} {
	global BP
	bp_stat $BP
} 

proc bpl {} {
  foreach l [db_search_l labels] {
	setl {layer x0 y0 x1 y1 pos text} $l
	bpa $x0 $y0 $x1 $y1 $text
  }	
}

proc b {x0 y0 x1 y1} {
	lay_box $x0 $y0 $x1 $y1
}

proc bbox {x0 y0 x1 y1} {
	lay_box $x0 $y0 $x1 $y1
}

proc area {x0 y0 x1 y1} {
	lay_box $x0 $y0 $x1 $y1
}

proc l {text} {
  	:paint m1
	:label $text
}	

# populate
proc bpp {} {
 bpa 0 0 1 1       a1
 bpa 1 1 2 2       a2
 bpa 4 4 5 5       a3
 bpa 10 10 11 11   a4
 bpa 5 0 6 1       a5
 bpa 30 30 31 31   a6

 bpa 0 0 10 10     b1
 bpa 1 1 11 11     b2
 bpa 0 1 10 10     b3
 bpa 1 0 10 10     b4
 bpa 1 1 9 9       b5
 bpa 16 16 26 26   b6


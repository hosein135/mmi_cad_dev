* text=auto eol=lf
*.sh text eol=lf
*.tcl text eol=lf
*.nix text eol=lf
*.awk text eol=lf
*.py text eol=lf
*.md text eol=lf

# Do not let text=auto rewrite vendor blobs (changes the Nix source hash).
*.a binary
*.so binary
*.o binary
*.exe binary
*.bin binary
*.gif binary
*.jpg binary
*.jpeg binary
*.png binary
*.pcf binary
*.pdf binary
*.gz binary
*.tgz binary
*.zip binary
*.tar binary

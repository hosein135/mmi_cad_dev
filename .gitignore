# Local / generated
data/home/*
!data/home/.gitkeep
data/pdks/*
!data/pdks/.gitkeep
data/workspace/*
!data/workspace/.gitkeep
/result
/result-*
.tmp-*

# Nix store symlink from `nix build -o vendor/result`
vendor/result
vendor/result-*

# Do not commit the original archive if it is dropped here again
vendor/*.tar.gz
vendor/*.tar
mmi_pd_*.tar.gz
mmi_pd_*.tar
